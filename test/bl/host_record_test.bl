; host_record_test.bl — the pinned `BeamLisp.Record` ABI, diffed against the
; live module.
;
; `priv/host/record.bl` is ONE pinned source that
; `BeamLisp.AOT/compile_host_file` compiles at an exact atom with NO compile
; options (functions-only — a record is a synthesized struct MODULE, a deftype
; a tagged tuple; neither is a declared struct on THIS beam):
;
;     :module <atom>   :output_dir <dir>   :file priv/host/record.bl
;     :source_hash <sha256>   :load? false
;
; The running `Elixir.BeamLisp.Record` (still `lib/beam_lisp/record.ex`) is the
; ground truth, so the suite is DIFFERENTIAL: one corpus of observations runs
; through a probe compiled from the pinned source and through the live module,
; and the two answer sets must be equal — values, exception CLASSES, MESSAGES
; and `data`.
;
; The observation is normalized on two axes only:
;   * the module a `defrecord`/`deftype` is created AT (`norm/1`): the pinned
;     file reads its own atom from a fun literal, so a probe compile scopes its
;     record modules as `BeamLisp.RecordProbe.<Ns>.<Name>` where the live
;     module scopes them `BeamLisp.Record.<Ns>.<Name>`. That is the PROPERTY
;     being ported and is asserted separately (`record-module-name-tracks-the-beam`);
;   * the Elixir-compiler ARTEFACT name of the anonymous fn inside the live
;     `generated_struct/3`, whose clause failure reads `… in anonymous fn/2 in
;     BeamLisp.Record.generated_struct/3` — an inlining detail of the compiler
;     that built `record.ex`, not an ABI. The pinned file makes the same refusal
;     (class, `data`, and a pair of any other shape rejected) with the plain
;     anonymous message; the two are folded to one.
; Everything else compares raw.
;
; What the corpus pins:
;   * `define/3` / `define_type/3` — the returned module, the registry entry
;     (`info/1`), `fields_of/1` and the three predicates;
;   * `create_module/3` — the synthesized Elixir struct ABI: `__struct__/0,1`,
;     `__info__(:struct)` (fields, defaults, order), `__info__(:functions)`,
;     `__info__(:exports_md5)`, and the `__bl_deftype__/0` deftype marker;
;   * `positional_ctor/1` (`->Name`), `map_ctor/1` (`map->Name`),
;     `map_construct/2`, `struct_map/2`, `generated_struct/2,3`,
;     `construct_list/2`, `build_type/2` — including the arity/length
;     refunds and the `KeyError` on an undeclared `__struct__/1` key;
;   * wrong types — a record where a deftype is expected, a struct where a
;     plain map is expected, a non-list where a list is expected, and the
;     `{:bl_reify, …}` tagged tuple `deftype_field/2` must REFUSE;
;   * `literal/3` — the no-such-record refusal, the does-not-name-a-record
;     refusal, and the success path through `BeamLisp.Env`;
;   * dynamic module hygiene — redefining a name replaces its struct module in
;     place: `__info__(:struct)` and `exports_md5` move, `__struct__/0,1`
;     answers the NEW field set, and the old field is gone;
;   * the pinned beam STANDING IN at the production atom, exercised, then the
;     live beam RESTORED.
;
; Run: bin/bl test test/bl/host_record_test.bl

(ns host.record.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_record_" (erlang/unique_integer (list :positive))))

(defn- src [] (Path/join (BeamLisp/cwd) "priv/host/record.bl"))

(def ^:private probe :Elixir.BeamLisp.RecordProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Record)
(def ^:private live :Elixir.BeamLisp.Record)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- seed-opts
  "The EXACT option list the seed's `host-opts` builds for a functions-only host
   entry: `:module`/`:output_dir`/`:file`/`:source_hash`/`:load? false`."
  [mod dir]
  (list (t2 :module mod)
        (t2 :output_dir dir)
        (t2 :file (src))
        (t2 :source_hash (crypto/hash :sha256 (File/read! (src))))
        (t2 :load? false)))

(defn- compile-at
  "Compile the pinned source at exact atom `mod`, then publish ONLY the pinned
   beam: the compile's own load (and the namespace shim it built beside it) is
   dropped first."
  [mod dir]
  (let [res (BeamLisp.AOT/compile_host_file (src) (seed-opts mod dir))
        path (elem res 1)]
    (drop! mod)
    (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    mod))

; ── normalization: the beam a record module was scoped under, and refs ────

(defn- norm-binary
  "Two by-design text differences are erased here:

     * the beam a created record module is scoped under: the pinned file reads
       its own atom from a fun literal, so a probe compile scopes its record
       modules `BeamLisp.RecordProbe.<Ns>.<Name>` where the live module scopes
       them `BeamLisp.Record.<Ns>.<Name>`. That is the PROPERTY being ported
       (asserted in `record-module-name-tracks-the-beam`);
     * the Elixir-compiler ARTEFACT name of the anonymous fn inside the live
       `generated_struct/3` (its clause failure reads `… in anonymous fn/2 in
       BeamLisp.Record.generated_struct/3`, an inlining detail of the compiler
       that built `record.ex`, not ABI). The pinned file raises the anonymous
       `FunctionClauseError` — the same class and `data`, the same rejection —
       so the two messages are folded to one here."
  [s]
  (String/replace
    (String/replace s "BeamLisp.RecordProbe" "BeamLisp.Record")
    "no function clause matching in anonymous fn/2 in BeamLisp.Record.generated_struct/3"
    "no function clause matches"))

(defn- norm
  "The observation with the by-design text differences erased. Maps are rebuilt
   key by key, so a normalized struct keeps its `:__struct__` tag."
  [v]
  (cond
    (erlang/is_atom v) (String/to_atom (norm-binary (Atom/to_string v)))
    (erlang/is_binary v) (norm-binary v)
    (erlang/is_list v) (Enum/map v (fn [y] (norm y)))
    (erlang/is_tuple v) (erlang/list_to_tuple (Enum/map (erlang/tuple_to_list v) (fn [y] (norm y))))
    (erlang/is_map v) (lists/foldl
                        (fn [pair acc]
                          (Map/put acc (norm (erlang/element 1 pair)) (norm (erlang/element 2 pair))))
                        (Map/new)
                        (maps/to_list v))
    :else v))

(defn- struct-tag [x]
  (if (and (erlang/is_map x) (erlang/is_map_key :__struct__ x))
    (erlang/map_get :__struct__ x)
    nil))

(defn- ex-data-of [e]
  (if (and (erlang/is_map e) (erlang/is_map_key :data e)) (erlang/map_get :data e) nil))

(defn- obs
  "`[:ok value]` or `[:raise class message data]`, normalized. The class, the
   message and the `data` are all part of the ABI a caller's
   `catch`/`ex-message`/`ex-data` reads."
  [thunk]
  (try (list :ok (norm (thunk)))
       (catch e (list :raise (norm (struct-tag e)) (norm (ex-message e)) (norm (ex-data-of e))))))

(defn- answer [pair]
  (list (first pair) (obs (second pair))))

(defn- answers [corpus]
  (Enum/map corpus (fn [p] (answer p))))

; ── the differential corpus ───────────────────────────────────────────────

(defn- cases
  "Every public-ABI observation, as `[label thunk]` pairs so a failure names the
   operation. The corpus is built PER MODULE — the record modules the pinned
   beam creates are scoped under the beam's own atom — and each thunk is
   self-contained enough that the two runs cannot share mutable state."
  [mod ns]
  (let [pt (erlang/apply mod :define (list ns "Point" (list "x" "y")))
        ln (erlang/apply mod :define_type (list ns "Line" (list "a" "b")))
        mv (erlang/apply mod :define (list ns "Mover" (list "x" "y")))
        em (erlang/apply mod :define (list ns "Empty" (list)))
        inner (erlang/apply mod :define (list (str ns ".sub") "Inner" (list "v")))
        z (erlang/apply pt :__struct__ (list))
        pc (erlang/apply mod :positional_ctor (list pt))
        lc (erlang/apply mod :positional_ctor (list ln))
        mc (erlang/apply mod :map_ctor (list pt))
        ty (erlang/apply mod :build_type (list ln (list 1 2)))]
    (list
      ; ── define / registry / predicates ─────────────────────────────
      (list "define returns the module" (fn [] pt))
      (list "info(point)" (fn [] (erlang/apply mod :info (list pt))))
      (list "info(deftype)" (fn [] (erlang/apply mod :info (list ln))))
      (list "info(unknown)" (fn [] (erlang/apply mod :info (list :nope))))
      (list "info(non-atom)" (fn [] (erlang/apply mod :info (list "str"))))
      (list "fields_of(point)" (fn [] (erlang/apply mod :fields_of (list pt))))
      (list "fields_of(deftype)" (fn [] (erlang/apply mod :fields_of (list ln))))
      (list "fields_of(unknown)" (fn [] (erlang/apply mod :fields_of (list :nope))))
      (list "record_module?(point)" (fn [] (erlang/apply mod :record_module? (list pt))))
      (list "record_module?(deftype)" (fn [] (erlang/apply mod :record_module? (list ln))))
      (list "record_module?(non-atom)" (fn [] (erlang/apply mod :record_module? (list 5))))
      (list "deftype_module?(point)" (fn [] (erlang/apply mod :deftype_module? (list pt))))
      (list "deftype_module?(deftype)" (fn [] (erlang/apply mod :deftype_module? (list ln))))
      (list "record?(struct)" (fn [] (erlang/apply mod :record? (list z))))
      (list "record?(deftype)" (fn [] (erlang/apply mod :record? (list ty))))
      (list "record?(plain map)" (fn [] (erlang/apply mod :record? (list {:x 1}))))
      (list "record?(non-atom-tag map)" (fn [] (erlang/apply mod :record? (list {:__struct__ "s"}))))
      (list "record?(int)" (fn [] (erlang/apply mod :record? (list 5))))
      (list "record?(nil)" (fn [] (erlang/apply mod :record? (list nil))))
      (list "record?(vector struct)" (fn [] (erlang/apply mod :record? (list (BeamLisp.Vector/new (list 1 2))))))
      (list "define rejects __struct__" (fn [] (erlang/apply mod :define (list ns "Bad" (list "__struct__")))))
      (list "define duplicate key warns and keeps" (fn [] (erlang/apply mod :define (list ns "Dup" (list "x" "x")))))
      (list "define_type empty" (fn [] (erlang/apply mod :define_type (list ns "EmptyT" (list)))))
      (list "define_type empty info" (fn [] (erlang/apply mod :info (list (erlang/apply mod :define_type (list ns "EmptyT2" (list)))))))

      ; ── the synthesized struct ABI ────────────────────────────────
      (list "__info__(:module)" (fn [] (erlang/apply pt :__info__ (list :module))))
      (list "__info__(:functions)" (fn [] (erlang/apply pt :__info__ (list :functions))))
      (list "__info__(:macros)" (fn [] (erlang/apply pt :__info__ (list :macros))))
      (list "__info__(:deprecated)" (fn [] (erlang/apply pt :__info__ (list :deprecated))))
      (list "__info__(:struct)" (fn [] (erlang/apply pt :__info__ (list :struct))))
      (list "__info__(:md5) is a binary" (fn [] (erlang/is_binary (erlang/apply pt :__info__ (list :md5)))))
      (list "__struct__/0" (fn [] (erlang/apply pt :__struct__ (list))))
      (list "__struct__/1 one key" (fn [] (erlang/apply pt :__struct__ (list (list (tuple :x 9))))))
      (list "__struct__/1 both keys" (fn [] (erlang/apply pt :__struct__ (list (list (tuple :x 9) (tuple :y 8))))))
      (list "__struct__/1 unknown key" (fn [] (erlang/apply pt :__struct__ (list (list (tuple :x 9) (tuple :z 3))))))
      (list "__struct__/0 exported" (fn [] (erlang/function_exported pt :__struct__ 0)))
      (list "__struct__/1 exported" (fn [] (erlang/function_exported pt :__struct__ 1)))
      (list "deftype has no __struct__/0" (fn [] (erlang/function_exported ln :__struct__ 0)))
      (list "deftype __bl_deftype__/0" (fn [] (erlang/apply ln :__bl_deftype__ (list))))

      ; ── positional_ctor / map_ctor ────────────────────────────────
      (list "->Point 1 2" (fn [] (BeamLisp.Ns.Rt/invoke pc (list 1 2))))
      (list "->Line 1 2" (fn [] (BeamLisp.Ns.Rt/invoke lc (list 1 2))))
      (list "->Point arity 1" (fn [] (BeamLisp.Ns.Rt/invoke pc (list 1))))
      (list "->Point arity 3" (fn [] (BeamLisp.Ns.Rt/invoke pc (list 1 2 3))))
      (list "->Point arity 0" (fn [] (BeamLisp.Ns.Rt/invoke pc (list))))
      (list "->Line arity 1" (fn [] (BeamLisp.Ns.Rt/invoke lc (list 1))))
      (list "positional_ctor(unknown)" (fn [] (erlang/apply mod :positional_ctor (list :nope))))
      (list "map->Point drops extras" (fn [] (BeamLisp.Ns.Rt/invoke mc (list {:x 1 :y 2 :z 3}))))
      (list "map->Point fills nils" (fn [] (BeamLisp.Ns.Rt/invoke mc (list {:x 1}))))
      (list "map->Point empty" (fn [] (BeamLisp.Ns.Rt/invoke mc (list {}))))
      (list "map->Point struct source" (fn [] (BeamLisp.Ns.Rt/invoke mc (list {:x 1 :__struct__ :Nope}))))

      ; ── map_construct / struct_map / generated_struct ─────────────
      (list "map_construct drops extras" (fn [] (erlang/apply mod :map_construct (list pt {:x 1 :y 2 :z 3}))))
      (list "map_construct partial" (fn [] (erlang/apply mod :map_construct (list pt {:x 1}))))
      (list "map_construct empty" (fn [] (erlang/apply mod :map_construct (list pt {}))))
      (list "map_construct struct source" (fn [] (erlang/apply mod :map_construct (list pt z))))
      (list "map_construct int" (fn [] (erlang/apply mod :map_construct (list pt 5))))
      (list "map_construct list" (fn [] (erlang/apply mod :map_construct (list pt (list 1 2)))))
      (list "map_construct tuple" (fn [] (erlang/apply mod :map_construct (list pt (tuple :x 1)))))
      (list "struct_map pairs" (fn [] (erlang/apply mod :struct_map (list pt (list (tuple :x 1) (tuple :y 2))))))
      (list "struct_map empty" (fn [] (erlang/apply mod :struct_map (list pt (list)))))
      (list "generated_struct/2" (fn [] (erlang/apply mod :generated_struct (list pt (list :x :y)))))
      (list "generated_struct/3 one" (fn [] (erlang/apply mod :generated_struct (list pt (list :x :y) (list (tuple :x 5))))))
      (list "generated_struct/3 both" (fn [] (erlang/apply mod :generated_struct (list pt (list :x :y) (list (tuple :x 5) (tuple :y 6))))))
      (list "generated_struct/3 unknown key" (fn [] (erlang/apply mod :generated_struct (list pt (list :x :y) (list (tuple :x 5) (tuple :bogus 6))))))
      (list "generated_struct/3 3-tuple pair" (fn [] (erlang/apply mod :generated_struct (list pt (list :x :y) (list (tuple :x 5 6))))))
      (list "generated_struct/3 non-tuple pair" (fn [] (erlang/apply mod :generated_struct (list pt (list :x :y) (list :x)))))
      (list "empty record module" (fn [] em))
      (list "empty record fields_of" (fn [] (erlang/apply mod :fields_of (list em))))
      (list "empty record __struct__/0" (fn [] (erlang/apply em :__struct__ (list))))
      (list "empty record __info__(:struct)" (fn [] (erlang/apply em :__info__ (list :struct))))
      (list "dotted ns module" (fn [] inner))
      (list "dotted ns fields_of" (fn [] (erlang/apply mod :fields_of (list inner))))

      ; ── construct_list / build_type ───────────────────────────────
      (list "construct_list 1 2" (fn [] (erlang/apply mod :construct_list (list pt (list 1 2)))))
      (list "construct_list short" (fn [] (erlang/apply mod :construct_list (list pt (list 1)))))
      (list "construct_list long" (fn [] (erlang/apply mod :construct_list (list pt (list 1 2 3)))))
      (list "construct_list non-list" (fn [] (erlang/apply mod :construct_list (list pt 5))))
      (list "build_type 1 2" (fn [] (erlang/apply mod :build_type (list ln (list 1 2)))))
      (list "build_type empty" (fn [] (erlang/apply mod :build_type (list ln (list)))))
      (list "build_type non-list" (fn [] (erlang/apply mod :build_type (list ln 5))))

      ; ── deftype_field ─────────────────────────────────────────────
      (list ".-a of ->Line" (fn [] (erlang/apply mod :deftype_field (list ty :a))))
      (list ".-b of ->Line" (fn [] (erlang/apply mod :deftype_field (list ty :b))))
      (list ".-c of ->Line" (fn [] (erlang/apply mod :deftype_field (list ty :c))))
      (list "deftype_field on int" (fn [] (erlang/apply mod :deftype_field (list 5 :a))))
      (list "deftype_field on binary" (fn [] (erlang/apply mod :deftype_field (list "s" :a))))
      (list "deftype_field on map" (fn [] (erlang/apply mod :deftype_field (list {:a 1} :a))))
      (list "deftype_field on record" (fn [] (erlang/apply mod :deftype_field (list z :x))))
      (list "deftype_field on reify" (fn [] (erlang/apply mod :deftype_field (list (tuple :bl_reify :tag {}) :a))))
      (list "deftype_field on forged deftype" (fn [] (erlang/apply mod :deftype_field (list (tuple :bl_deftype ln (tuple 1 2)) :a))))
      (list "deftype_field on unregistered type" (fn [] (erlang/apply mod :deftype_field (list (tuple :bl_deftype :NotARecord (tuple 1)) :a))))

      ; ── literal (through BeamLisp.Env) ────────────────────────────
      (list "literal no such record" (fn [] (erlang/apply mod :literal (list ns "Nope" {}))))
      (list "literal success" (fn [] (do (BeamLisp.Env/intern ns "Point" pt)
                                         (erlang/apply mod :literal (list ns "Point" {:x 1 :y 2 :z 3})))))
      (list "literal names a deftype" (fn [] (do (BeamLisp.Env/intern ns "Line" ln)
                                                 (erlang/apply mod :literal (list ns "Line" {:a 1})))))
      (list "literal names a non-record" (fn [] (do (BeamLisp.Env/intern ns "Fake" 42)
                                                    (erlang/apply mod :literal (list ns "Fake" {:x 1})))))

      ; ── dynamic module hygiene: redefine in place ─────────────────
      (list "Mover struct before" (fn [] (erlang/apply mv :__info__ (list :struct))))
      (list "Mover md5 before" (fn [] (erlang/apply mv :__info__ (list :exports_md5))))
      (list "Mover redefine to x z" (fn [] (erlang/apply mod :define (list ns "Mover" (list "x" "z")))))
      (list "Mover struct after" (fn [] (erlang/apply mv :__info__ (list :struct))))
      (list "Mover md5 after" (fn [] (erlang/apply mv :__info__ (list :exports_md5))))
      (list "Mover __struct__/0 after" (fn [] (erlang/apply mv :__struct__ (list))))
      (list "Mover __struct__/1 z after" (fn [] (erlang/apply mv :__struct__ (list (list (tuple :z 7))))))
      (list "Mover fields_of after" (fn [] (erlang/apply mod :fields_of (list mv)))))))

; ── the differential: probe answers == live answers ──────────────────────

(deftest record-pinned-matches-the-live-module
  (testing "the pinned source answers exactly as the live module does"
    (let [ns "hostrecordprobe"
          dir (tmp-dir)]
      (compile-at probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))
      ; the pinned beam is FUNCTIONS-ONLY: no synthesized struct surface.
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__info__ 1)))
      (let [l (answers (cases live ns))
            p (answers (cases probe ns))]
        (is (= (count l) (count p)))
        (is (< 50 (count l)) "the corpus is big enough to mean something")
        (is (< 30 (count (Enum/filter l (fn [row] (erlang/== :ok (first (second row)))))))
            "the corpus observes VALUES, not only refusals")
        (doseq [i (range (count l))]
          (is (= (nth l i) (nth p i))
              (str "observation " i " " (first (nth l i))
                   "\n  live  = " (Kernel/inspect (second (nth l i)))
                   "\n  probe = " (Kernel/inspect (second (nth p i)))))))
      ; PINNED ANSWERS next — the ABI itself, not merely probe == live.
      (let [m (erlang/apply probe :define (list "recordabsolute" "P" (list "x" "y")))
            s (erlang/apply m :__struct__ (list))]
        (is (= (list :x :y) (erlang/apply probe :fields_of (list m))))
        (is (= (list :x :y) (Enum/map (erlang/apply m :__info__ (list :struct))
                                      (fn [fm] (erlang/map_get :field fm)))))
        (is (= m (erlang/map_get :__struct__ s)))
        (is (erlang/== nil (erlang/map_get :x s)))
        (is (= 5 (erlang/map_get :x (erlang/apply m :__struct__ (list (list (tuple :x 5)))))))
        (is (erlang/apply probe :record_module? (list m)))
        (is (erlang/apply probe :record? (list s)))
        (is (= (tuple :bl_deftype m (tuple 1)) (erlang/apply probe :build_type (list m (list 1)))))
        (is (= 1 (erlang/apply probe :deftype_field
                               (list (erlang/apply probe :build_type (list m (list 1))) :x))))
        (is (= "wrong number of args (1) for P constructor, expected 2"
               (try (BeamLisp.Ns.Rt/invoke (erlang/apply probe :positional_ctor (list m)) (list 1))
                    (catch e (ex-message e))))))
      (File/rm_rf! dir))))

; ── the pinned surface: the live ABI plus this file's helpers ─────────────

(deftest record-pinned-export-surface
  (testing "the pinned beam covers every live export, plus its named helpers"
    (let [dir (tmp-dir)]
      (compile-at probe dir)
      (is (erlang/function_exported live :define 3) "the production record module is loaded")
      (is (every? (fn [e] (or (erlang/== :__info__ (erlang/element 1 e))
                              (erlang/function_exported probe (erlang/element 1 e) (erlang/element 2 e))))
                  (erlang/apply live :module_info (list :exports)))
          "the pinned ABI covers every live export")
      ; the pinned emitter exports `defn-` helpers too (the family shape).
      (is (erlang/function_exported probe :"self-mod" 0))
      (is (erlang/function_exported probe :"struct-like?" 1))
      (is (erlang/function_exported probe :"bl-map?" 1))
      (is (erlang/function_exported probe :"clause-error" 2))
      (is (erlang/function_exported probe :"argument-error" 1))
      (is (erlang/function_exported probe :"registry-key" 0))
      (is (erlang/function_exported probe :"register" 5))
      (is (erlang/function_exported probe :"module_name" 2))
      (is (erlang/function_exported probe :"create_module" 3))
      (is (erlang/function_exported probe :"validate_struct_fields!" 1))
      (is (erlang/function_exported probe :"struct_info_clauses" 2))
      ; REPRODUCIBLE: a rebuild of the same source is the same bytes.
      (let [dir2 (tmp-dir)
            a (erlang/element 2 (BeamLisp.AOT/compile_host_file (src) (seed-opts probe dir2)))
            b (erlang/element 2 (BeamLisp.AOT/compile_host_file (src) (seed-opts probe dir)))]
        (is (= (File/read! a) (File/read! b))))
      ; the explicit seed option contract
      (let [opts (seed-opts probe dir)]
        (is (= probe (Keyword/fetch! opts :module)))
        (is (= (src) (Keyword/fetch! opts :file)))
        (is (= false (Keyword/fetch! opts :load?)))
        (is (erlang/is_binary (Keyword/fetch! opts :source_hash))))
      (File/rm_rf! dir))))

; ── the created module tracks the beam that created it ───────────────────

(deftest record-module-name-tracks-the-beam
  (testing "`self-mod` scopes the record modules this beam creates"
    (let [dir (tmp-dir)
          ns "recordscopeprobe"]
      (compile-at probe dir)
      (let [p (erlang/apply probe :define (list ns "Point" (list "x")))]
        (is (= (erlang/binary_to_atom "Elixir.BeamLisp.RecordProbe.Recordscopeprobe.Point") p))
        (is (= (erlang/binary_to_atom "Elixir.BeamLisp.Record.Recordscopeprobe.Point")
               (erlang/apply live :define (list ns "Point" (list "x")))))
        ; the registry is scoped the same way: two independent tables.
        (is (= (erlang/apply probe :info (list p)) (tuple :record ns "Point" (list :x))))
        (is (erlang/== nil (erlang/apply live :info (list p)))))
      (File/rm_rf! dir))))

; ── redefinition replaces the struct ABI in place ────────────────────────

(deftest record-redefinition-updates-the-struct-abi
  (testing "redefining a name updates its module in place; the old fields go"
    (let [dir (tmp-dir)
          ns "recordredefprobe"]
      (compile-at probe dir)
      (let [m (erlang/apply probe :define (list ns "M" (list "x" "y")))
            before-struct (erlang/apply m :__info__ (list :struct))
            before-md5 (erlang/apply m :__info__ (list :exports_md5))
            _ (erlang/apply probe :define (list ns "M" (list "x" "z")))
            after-struct (erlang/apply m :__info__ (list :struct))
            after-md5 (erlang/apply m :__info__ (list :exports_md5))]
        (is (= (list :x :y) (Enum/map before-struct (fn [fm] (erlang/map_get :field fm)))))
        (is (= (list :x :z) (Enum/map after-struct (fn [fm] (erlang/map_get :field fm)))))
        (is (not= before-md5 after-md5) "the exports digest tracks the new field set")
        (is (= (erlang/map_get :__struct__ (erlang/apply m :__struct__ (list))) m))
        (is (= (list :__struct__ :x :z)
               (Enum/sort (Enum/map (maps/to_list (erlang/apply m :__struct__ (list)))
                                    (fn [kv] (erlang/element 1 kv)))))
            "the zero struct answers the NEW field set"))
      (File/rm_rf! dir))))

; ── the pinned beam AT the production atom, saved and restored ───────────

(deftest record-pinned-beam-stands-in-at-the-production-atom
  (testing "the production atom serves the pinned beam, then the live beam returns"
    (let [ns "recordstandin"
          dir (tmp-dir)
          out (str dir "/prod")
          beam (Path/join out (str live ".beam"))
          orig-path (erlang/apply :code :which (list live))
          orig-bin (File/read! (erlang/list_to_binary orig-path))
          before (answers (cases live ns))]
      (is (not= :non_existing orig-path) "precondition: the live beam is a readable file")
      (BeamLisp.AOT/compile_host_file (src) (seed-opts live out))
      (is (File/exists? beam))
      (try
        (drop! live)
        (code/load_binary live (erlang/binary_to_list beam) (File/read! beam))
        ; the pinned beam answers EXACTLY as the live one did at this atom.
        (is (= before (answers (cases live ns))))
        ; THE LANGUAGE's own `defrecord`/`deftype` path drives the pinned beam:
        ; `compile-defrecord` emits `Record.define`/`positional_ctor`/`map_ctor`,
        ; and the reader's `#ns/Name{…}` literal reaches `Record.literal/3` — so
        ; an evaluated form is the real consumer, not just a direct call.
        ;
        ; The evaluation is done in the `user` namespace and BOTH the namespace
        ; and the definition are restored/reported, so this block leaks nothing
        ; into whatever else runs in this VM.
        (let [prev-ns (BeamLisp.Env/current_ns)]
          (try
            (BeamLisp.Env/in_ns "user")
            (let [m (BeamLisp/eval "(defrecord RecStandIn [a b])")
                  r0 (BeamLisp/eval "(->RecStandIn 1 2)")
                  r1 (BeamLisp/eval "(map->RecStandIn {:a 1 :z 9})")
                  r2 (BeamLisp/eval "#user/RecStandIn{:a 1 :b 2}")]
              ; a bare symbol in a beam-lisp MAP LITERAL reads as a symbol, not
              ; a variable, so every field is read out instead of written in.
              (is (= (erlang/binary_to_atom "Elixir.BeamLisp.Record.User.RecStandIn") m))
              (is (= m (BeamLisp/eval "RecStandIn")))
              (is (= m (erlang/map_get :__struct__ r0)))
              (is (= 1 (erlang/map_get :a r0)))
              (is (= 2 (erlang/map_get :b r0)))
              (is (= m (erlang/map_get :__struct__ r1)))
              (is (= 1 (erlang/map_get :a r1)))
              (is (erlang/== nil (erlang/map_get :b r1)) "an undeclared map key is dropped")
              (is (= m (erlang/map_get :__struct__ r2)) "the reader's #ns/Name{…} literal built the record")
              (is (= 2 (erlang/map_get :b r2)))
              (is (= 1 (BeamLisp/eval "(:a (->RecStandIn 1 2))")))
              (is (= 2 (BeamLisp/eval "(count (->RecStandIn 1 2))")))
              (is (= true (BeamLisp/eval "(map? (->RecStandIn 1 2))")))
              (let [s (BeamLisp/eval "(pr-str (->RecStandIn 1 2))")]
                (is (String/starts_with? s "#user/RecStandIn{"))
                (is (String/contains? s ":a 1"))
                (is (String/contains? s ":b 2"))))
            (let [t (BeamLisp/eval "(deftype RecStandType [p q])")]
              (is (= (erlang/binary_to_atom "Elixir.BeamLisp.Record.User.RecStandType") t))
              (is (= t (BeamLisp/eval "RecStandType")))
              (is (= 1 (BeamLisp/eval "(.-p (->RecStandType 1 2))")))
              (is (= 2 (BeamLisp/eval "(.q (->RecStandType 1 2))"))))
            (finally (BeamLisp.Env/in_ns prev-ns))))
        (finally
          (drop! live)
          (code/load_binary live orig-path orig-bin)))
      ; RESTORED: the live beam owns the atom and answers again.
      (is (= orig-path (erlang/apply :code :which (list live))))
      (is (= before (answers (cases live ns))) "the restored live beam answers as before")
      (File/rm_rf! dir))))
