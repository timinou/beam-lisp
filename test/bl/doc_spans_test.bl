; test/bl/doc_spans_test.bl — the one partition every livebook reader shares.
;
; bl.doc (the runner), the loader's minimal extractor, and the editor (via
; bl.doc.spans, compiled to JS) must agree on WHICH lines are cells and WHAT
; each cell is called. These tests pin that on fixtures and on every
; .bl.org / .bl.md document in the repository.

(ns bl.doc.spans.test
  (:require [bl.doc :as doc]
            [bl.doc.spans :as sp]))

(defn- lines-of [s] (vec (split s "\n")))

(defn- total? [lines spans]
  (and (= 0 (:from (first spans)))
       (= (count lines) (:to (last spans)))
       (every? (fn [x] (= true x)) (map (fn [a b] (= (:to a) (:from b))) spans (rest spans)))))

(deftest partition-is-total-and-ordered
  (let [ls (lines-of "* H\ntext\n#+begin_src beam-lisp :id a\n(def a 1)\n#+end_src\n#+RESULTS: a\n: 1\n\n#+BEGIN_QUOTE\nq\n#+END_QUOTE\nend")]
    (is (total? ls (sp/spans ls :org)))
    (is (total? ls (sp/spans ls :org {:headings? true})))
    (is (= [:prose :cell :result :block :prose] (mapv :kind (sp/spans ls :org))))
    (is (= [:heading :prose :cell :result :block :prose] (mapv :kind (sp/spans ls :org {:headings? true}))))))

(deftest open-blocks-run-to-the-end
  (let [ls ["text" "#+begin_src beam-lisp" "(x"]
        s (last (sp/spans ls :org))]
    (is (= :cell (:kind s)))
    (is (= true (:open? s)))
    (is (= 3 (:to s)))
    (is (contains? (doc/slice-text (join "\n" ls) :org) :error))))

(deftest ids-follow-one-rule
  (let [ls (lines-of "#+begin_src beam-lisp\n(defn f [x] x)\n#+end_src\n#+begin_src beam-lisp\n(+ 1 2)\n#+end_src\n#+begin_src beam-lisp :id f\n1\n#+end_src")]
    (is (= ["f" "cell1" "f-2"] (mapv :id (filter (fn [s] (= :cell (:kind s))) (sp/assign-ids ls (sp/spans ls :org))))))))

(deftest uppercase-src-is-a-block-not-a-cell
  ; the loader's extractor only loads lowercase `#+begin_src beam-lisp`
  (let [ls ["#+BEGIN_SRC beam-lisp" "(boom)" "#+END_SRC"]]
    (is (= [:prose-code] (mapv :kind (sp/spans ls :org))))
    (is (= "" (BeamLisp.Loader/doc_source (join "\n" ls) :org)))))

(deftest markdown-fences
  (let [ls (lines-of "x\n```beam-lisp id=g frozen\n(def g 1)\n```\n```bl-result g\n1\n```\n```sh\nls\n```")]
    (is (= [:prose :cell :result :prose-code] (mapv :kind (sp/spans ls :md))))
    (is (= {:explicit-id "g" :frozen? true} (select-keys (second (sp/spans ls :md)) [:explicit-id :frozen?])))))

(defn- docs []
  (filter (fn [p] (or (ends-with? p ".bl.org") (ends-with? p ".bl.md")))
          (map str (Path/wildcard "{docs,examples,priv}/**/*.bl.{org,md}"))))

(deftest every-repo-document-agrees
  (let [ps (docs)]
    (is (> (count ps) 20))
    (doseq [p ps]
      (let [text (File/read! p) fmt (doc/format-of p) ls (lines-of text)
            parts (sp/assign-ids ls (sp/spans ls fmt {:headings? (= fmt :org)}))
            r (doc/slice-text text fmt)]
        (is (total? ls parts) p)
        (when (contains? r :ok)
          ; the editor's cells (headings? on) are bl.doc's cells, same ids
          (is (= (mapv :id (doc/cells (:ok r)))
                 (mapv :id (filter (fn [s] (= :cell (:kind s))) parts))) p)
          ; and the runner's program is the loader's program
          (is (= (doc/doc-source text fmt) (BeamLisp.Loader/doc_source text fmt)) p)
          (is (= text (doc/render-doc (:ok r))) p))))))
