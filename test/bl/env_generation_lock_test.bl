(ns env.generation-lock-test)

(defn row-for [key]
 (ets/lookup :beam_lisp_vars (tuple :bl_generation_lock :Elixir.BeamLisp.Env key)))
(defn await-tag [tag]
 (receive [:generation-lock-result observed value] :when (= tag observed) value
          (after 5000 :timeout)))
(defn start-waiter [key tag]
 (let [parent (erlang/self)]
  (erlang/spawn (fn []
    (erlang/send parent [:generation-lock-ready tag])
    (let [value (BeamLisp.Env/with_generation_lock key (fn [] :entered))]
     (erlang/send parent [:generation-lock-result tag value]))))))

(deftest generation-lock-nesting-and-exceptions-preserve-outer-ownership
 (let [key (erlang/make_ref)]
  (BeamLisp.Env/with_generation_lock key
   (fn []
    (let [outer (row-for key)]
     (is (= 1 (count outer)))
     (is (= :nested (BeamLisp.Env/with_generation_lock key (fn [] :nested))))
     (is (= :caught (try (BeamLisp.Env/with_generation_lock key (fn [] (throw :probe)))
                         (catch _ :caught))))
     (is (= outer (row-for key)) "nested release and exception cannot erase the outer ticket"))))
  (is (empty? (row-for key)))
  (is (= :caught (try (BeamLisp.Env/with_generation_lock key (fn [] (throw :probe)))
                       (catch _ :caught))))
  (is (= :recovered (BeamLisp.Env/with_generation_lock key (fn [] :recovered))))
  (is (empty? (row-for key)))))

(deftest contended-generation-lock-excludes-waiter-and-preserves-mailbox
 (let [key (erlang/make_ref) tag (erlang/make_ref) worker (atom nil)]
  (erlang/send (erlang/self) [:unrelated-generation-message tag])
  (try
   (BeamLisp.Env/with_generation_lock key
    (fn []
     (reset! worker (start-waiter key tag))
     (is (= :ready (receive [:generation-lock-ready observed] :when (= observed tag) :ready
                            (after 5000 :timeout))))
     (is (= :excluded (receive [:generation-lock-result observed _] :when (= observed tag) :entered
                               (after 20 :excluded))))
     (let [other (erlang/make_ref) independent (start-waiter (erlang/make_ref) other)]
      (try
       (is (= :entered (await-tag other)) "a different key progresses in another process")
       (is (= :ready (receive [:generation-lock-ready observed] :when (= observed other) :ready
                              (after 0 :missing))))
       (finally (when (Process/alive? independent) (erlang/exit independent :kill)))))))
   (is (= :entered (await-tag tag)))
   (is (= tag (receive [:unrelated-generation-message observed] observed (after 0 nil))))
   (is (empty? (row-for key)))
   (finally (when (and @worker (Process/alive? @worker)) (erlang/exit @worker :kill))))))

(deftest killed-generation-lock-holder-is-reclaimed-without-manual-cleanup
 (let [key (erlang/make_ref) parent (erlang/self)
       holder (erlang/spawn (fn []
                 (BeamLisp.Env/with_generation_lock key
                  (fn [] (erlang/send parent [:generation-lock-held (erlang/self)])
                         (receive :never :ok)))))
       monitor (erlang/monitor :process holder)]
  (is (= holder (receive [:generation-lock-held pid] pid (after 5000 nil))))
  (let [ticket (first (row-for key)) tag (erlang/make_ref) waiter (start-waiter key tag)]
   (try
    (is (= holder (elem ticket 1)))
    (is (= :ready (receive [:generation-lock-ready observed] :when (= observed tag) :ready
                           (after 5000 :timeout))))
    (is (= :excluded (receive [:generation-lock-result observed _] :when (= observed tag) :entered
                              (after 20 :excluded))))
    (erlang/exit holder :kill)
    (is (= :killed (receive [:DOWN ref :process pid why] :when (and (= ref monitor) (= pid holder)) why
                            (after 5000 :timeout))))
    (is (= :entered (await-tag tag)) "an already waiting contender recovers the dead holder")
    (is (empty? (row-for key)))
    (finally
     (when (Process/alive? holder) (erlang/exit holder :kill))
     (when (Process/alive? waiter) (erlang/exit waiter :kill))
     (erlang/demonitor monitor (list :flush)))))))

(deftest captured-context-cannot-convey-generation-lock-ownership
 (let [key (erlang/make_ref) parent (erlang/self) tag (erlang/make_ref) worker (atom nil)]
  (try
   (BeamLisp.Env/with_generation_lock key
    (fn []
     (let [context (BeamLisp.Env/capture)]
      (reset! worker (erlang/spawn (fn []
        (BeamLisp.Env/bind context)
        (erlang/send parent [:generation-lock-ready tag])
        (let [value (BeamLisp.Env/with_generation_lock key (fn [] :entered))]
         (erlang/send parent [:generation-lock-result tag value])))))
      (is (= :ready (receive [:generation-lock-ready observed] :when (= observed tag) :ready
                             (after 5000 :timeout))))
      (is (= :excluded (receive [:generation-lock-result observed _] :when (= observed tag) :entered
                                (after 20 :excluded)))))))
   (is (= :entered (await-tag tag)))
   (finally (when (and @worker (Process/alive? @worker)) (erlang/exit @worker :kill))))))
