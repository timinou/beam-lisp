; test/bl/decimal_codec_port_test.bl — the order-preserving index key for
; `:db.type/decimal`, ported from `test/beam_lisp/decimal_codec_test.exs`.
;
; The contract, from the AVET index's point of view: the BYTE order of a
; decimal's key equals its NUMERIC order, across decimals AND against the ints
; and floats that share the number tag — and two decimals of equal numeric
; value (`1.0M`, `1.00M`) produce the SAME key, as Datomic/datahike AVET does.
;
; The assertions run directly on `BeamLisp.Decimal/codec_key_parts`, reassembled
; into the full `TAG-NUM || F(q) || rel || suffix` key the codec emits, so a
; regression in the delicate side/exact math fails here, loudly, rather than as
; a silently wrong range scan deep in a query. `codec_key_parts` answers the key
; BODY `{q, rel, suffix}`; `dec-key` below rebuilds the `TAG-NUM || F(q)` prefix
; with the same IEEE-754 transform `codec.bl`'s `encode-float` applies (verbatim:
; set the high bit for positives, invert every bit for negatives), read from the
; float's `term_to_binary` envelope — the portable way to reach the bits the
; reader offers no literal for. `num-key` builds the sibling a plain number gets
; (`TAG-NUM || F(v) || 1`), which is what an integral decimal must collide with.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 5 ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order:
;   byte order of decimal keys equals numeric order (16-value corpus);
;   scale variants of one value produce one key (AVET collision);
;   an integral decimal collides with the equal integer's key;
;   decimals interleave with ints and floats by magnitude;
;   distinct decimals that share a float prefix still order by true value.
;
; Adaptations, and why:
;   * `D.parse!` / `D.of` / `D.compare` / `D.to_float` / `D.to_plain_string`
;     become direct `BeamLisp.Decimal/…` calls — the module atom is the one the
;     original aliased.
;   * `Enum.sort(list, fn a, b -> a <= b end)` is a BOOLEAN comparator; BL's
;     `sort/2` takes Clojure's three-way comparator (negative/zero/positive), so
;     the numeric sort passes `BeamLisp.Decimal/compare` straight through. The
;     sort over reassembled KEYS (`sort-by`) compares binaries, byte for byte —
;     exactly the index's own comparison.
;   * `Bitwise.bor`/`bxor` become `erlang/bor`/`erlang/bxor`; the 64-bit key
;     body is assembled byte by byte, because `codec.bl` itself avoids bitstring
;     literals (the reader offers none) — this port keeps that shape.
;
; Run: bin/bl test test/bl/decimal_codec_port_test.bl

(ns decimal.codec.port.test)

; ── the key codec's float transform, rebuilt here ───────────────────────────

(defn- float-bits
  "The raw IEEE-754 double bits of `f` as an unsigned 64-bit integer — the
   `term_to_binary` envelope's eight payload bytes, big-endian."
  [f]
  (lists/foldl
    (fn [b acc] (erlang/+ (erlang/* acc 256) b))
    0
    (lists/nthtail 2 (erlang/binary_to_list (erlang/term_to_binary f)))))

(defn- encode-uint64
  "An unsigned 64-bit integer as 8 big-endian bytes."
  [n]
  (erlang/list_to_binary
    (to-list (mapv (fn [i] (rem (erlang/bsr n (* 8 (- 7 i))) 256)) [0 1 2 3 4 5 6 7]))))

(defn- one-byte
  "A one-byte binary holding `n` (`n` is a byte-sized tag or `rel`)."
  [n]
  (erlang/list_to_binary (to-list [(rem n 256)])))

(defn- order-preserving-bits
  "`F(v)` — the order-preserving 64-bit transform: set the high bit for
   positives (IEEE order already matches numeric order), invert every bit for
   negatives (whose IEEE pattern runs backwards)."
  [f]
  (let [bits (float-bits f)]
    (if (>= f 0.0)
      (erlang/bor bits 9223372036854775808)
      (erlang/bxor bits 18446744073709551615))))

(defn- dec-key
  "The exact key `codec.bl` produces for a decimal: the shared TAG-NUM float
   prefix (same IEEE transform as `encode-float`) + rel + suffix."
  [d]
  (let [[q rel suffix] (erlang/tuple_to_list (BeamLisp.Decimal/codec_key_parts d))]
    (erlang/iolist_to_binary
      (list (one-byte 48) (encode-uint64 (order-preserving-bits q)) (one-byte rel) suffix))))

(defn- num-key
  "The key `codec.bl` produces for a plain integer/float ≤ 2^53:
   `TAG-NUM || F(v) || 1`."
  [v]
  (let [f (* v 1.0)]
    (erlang/iolist_to_binary
      (list (one-byte 48) (encode-uint64 (order-preserving-bits f)) (one-byte 1)))))

(defn- parse [s] (BeamLisp.Decimal/parse! s))

; ── the five contracts ─────────────────────────────────────────────────────

(deftest byte-order-of-decimal-keys-equals-numeric-order
  (let [decs (mapv parse ["-1000.5" "-3.20" "-3.2" "-0.01" "0" "0.01" "1.0"
                          "1.00" "1.5" "2" "2.0" "3.14159" "99.99" "100.05"
                          "100.50" "1000000.01"])
        by-key (mapv BeamLisp.Decimal/to_plain_string (sort-by dec-key decs))
        by-num (mapv BeamLisp.Decimal/to_plain_string
                     (sort (fn [a b] (BeamLisp.Decimal/compare a b)) decs))]
    (is (= by-key by-num))))

(deftest scale-variants-of-one-value-produce-one-key
  (is (= (dec-key (parse "1.0")) (dec-key (parse "1.00"))))
  (is (= (dec-key (parse "1.0")) (dec-key (parse "1.000000"))))
  (is (= (dec-key (parse "-3.2")) (dec-key (parse "-3.20"))))
  (is (= (dec-key (parse "0")) (dec-key (parse "0.00")))))

(deftest an-integral-decimal-collides-with-the-equal-integers-key
  ; 2M and 2 are the same number; AVET indexes by value, so same key.
  (is (= (dec-key (parse "2")) (num-key 2)))
  (is (= (dec-key (parse "-5")) (num-key -5)))
  (is (= (dec-key (parse "0")) (num-key 0))))

(deftest decimals-interleave-with-ints-and-floats-by-magnitude
  ; a mixed column: the decimal 1.5M must sort between int 1 and int 2, and
  ; 3.14159M just above float 3.14.
  (let [keyed (list (list (num-key 1) "1")
                    (list (dec-key (parse "1.5")) "1.5M")
                    (list (num-key 2) "2")
                    (list (num-key 3.14) "3.14")
                    (list (dec-key (parse "3.14159")) "3.14159M")
                    (list (num-key 4) "4"))
        order (mapv (fn [p] (second p)) (sort-by (fn [p] (first p)) keyed))]
    (is (= order ["1" "1.5M" "2" "3.14" "3.14159M" "4"]))))

(deftest distinct-decimals-that-share-a-float-prefix-still-order-by-true-value
  ; Two decimals whose to_float collapses to the same double must be separated
  ; by the exact suffix. Construct a pair 2^53-scale apart: ...993 and ...992
  ; both round to ...992.0.
  (let [a (BeamLisp.Decimal/of 9007199254740992 0)
        b (BeamLisp.Decimal/of 9007199254740993 0)]
    (is (= (BeamLisp.Decimal/to_float a) (BeamLisp.Decimal/to_float b))
        "precondition: same rounded float")
    (is (< (dec-key a) (dec-key b))
        "exact suffix must break the float tie by true value")))
