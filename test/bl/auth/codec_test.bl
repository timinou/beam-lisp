; test/bl/auth/codec_test.bl — Biscuit protobuf wire codec.
; Run: mix beam_lisp.test test/bl/auth/codec_test.bl
;
; Two properties matter here, and both are checked against REAL corpus
; bytes, not synthetic ones:
;
;   1. round-trip fidelity — (encode (decode b)) = b, byte for byte. A
;      codec that cannot reproduce what it read cannot be trusted to
;      produce bytes a verifier elsewhere will accept. This is the
;      canonical-serialization guarantee the signatures depend on.
;
;   2. composition with crypto — a decoded token verifies under the
;      published root key. This proves the codec hands the crypto chain
;      the bytes it actually signed, closing the loop between the two
;      lowest layers before Wave 3 runs the whole corpus through them.

(ns auth.biscuit.codec-test
  (:require [auth.biscuit.codec :as codec]
            [auth.biscuit.crypto :as c]))

(defn- read-bytes [path]
  (elem (File/read path) 1))

(defn- hex->bytes [s]
  (Base/decode16! (String/upcase s)))

(def ROOT-PUB
  (Base/decode16! (String/upcase
    "1055c750b1a1505937af1537c626ba3263995c33a64758aaafb1275b0312e284")))

(defn- sample [name]
  (read-bytes (str "test/fixtures/biscuit-samples/" name)))

;; ── round-trip fidelity ─────────────────────────────────────────────

(deftest roundtrip-basic
  (let [raw (sample "test001_basic.bc")
        tok (codec/decode raw)]
    ;; structure decoded as expected
    (is (= 61 (erlang/byte_size (:data (:authority tok)))))
    (is (= 1 (count (:blocks tok))))
    (is (contains? (:proof tok) :secret))
    ;; byte-identical re-encoding
    (is (= raw (codec/encode tok)))))

(deftest roundtrip-many-samples
  ;; A spread of tokens with different block counts, key layouts, and
  ;; proof kinds. Each must re-encode to the exact bytes it decoded from.
  (let [names ["test001_basic.bc"
               "test002_different_root_key.bc"
               "test007_scoped_rules.bc"
               "test016_caveat_head_name.bc"
               "test017_expressions.bc"]]
    (doseq [n names]
      (let [raw (sample n)
            tok (codec/decode raw)]
        (is (= raw (codec/encode tok))
            (str "round-trip must be byte-identical for " n))))))

;; ── composition with the crypto chain ───────────────────────────────

(deftest decoded-basic-token-verifies
  ;; test001 is signed by the real root; decoding then verifying must
  ;; succeed, proving codec and crypto agree on the signed bytes.
  (let [tok (codec/decode (sample "test001_basic.bc"))]
    (is (c/verify-chain ROOT-PUB tok))
    (is (c/verify ROOT-PUB tok))))

(deftest decoded-wrong-root-fails
  ;; test002 is the SAME datalog signed by a DIFFERENT root; verifying it
  ;; against the published root key must fail at the signature (corpus
  ;; expects InvalidSignature). This is the codec+crypto pair reproducing
  ;; a reference failure mode.
  (let [tok (codec/decode (sample "test002_different_root_key.bc"))]
    (is (not (c/verify-chain ROOT-PUB tok)))))

;; ── revocation identifiers ──────────────────────────────────────────

(deftest revocation-ids-are-block-signatures
  ;; Per spec, a block's revocation id is its signature bytes. test001 has
  ;; two blocks, so two revocation ids, each 64 bytes, matching the
  ;; published values in samples.json.
  (let [tok (codec/decode (sample "test001_basic.bc"))
        ids (codec/revocation-ids tok)]
    (is (= 2 (count ids)))
    (is (every? (fn [id] (= 64 (erlang/byte_size id))) ids))
    ;; the first revocation id, from samples.json test001:
    (is (= (hex->bytes
             (str "7595a112a1eb5b81a6e398852e6118b7f5b8cbbff452778e655100e5fb4faa8d"
                  "3a2af52fe2c4f9524879605675fae26adbc4783e0cafc43522fa82385f396c03"))
           (first ids)))))
