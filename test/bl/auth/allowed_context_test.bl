(ns auth.allowed-context-test
  (:require [auth.rls :as rls] [datom] [datom.db :as dbv]))

(def schema [{:db/ident :doc/title :db/valueType :db.type/string}])

(deftest same-basis-stores-and-temporal-views-stay-distinct
  (let [a (datom/connect schema) b (datom/connect schema)
        _ (datom/transact! a [{:db/id -1 :doc/title "a"}])
        _ (datom/transact! b [{:db/id -1 :doc/title "b"}])
        da (datom/db a) db (datom/db b) calls (atom 0)
        f (rls/memo-allowed (fn [_ d] (swap! calls inc)
                             (set (datom/q '[:find ?v :where [?e :doc/title ?v]] d))))]
    (is (= (datom/basis-t da) (datom/basis-t db)))
    (is (not= (dbv/view-key da) (dbv/view-key db)))
    (is (= #{["a"]} (f "p" da)))
    (is (= #{["b"]} (f "p" db)))
    (is (= #{["b"]} (f "p" db)))
    (is (= 2 @calls))
    (is (not= (dbv/view-key da) (dbv/view-key (assoc da :valid-at 10))))
    (is (not= (dbv/view-key da) (dbv/view-key (assoc da :filter-mode :history))))
    (is (not= (dbv/view-key da) (dbv/view-key (assoc da :since-t 1))))))

(deftest external-policy-revocation-and-expiry
  (let [d (datom/db (datom/connect schema)) calls (atom 0)
        time (atom 10) policy (atom {:generation 1 :expires-at 20})
        f (rls/memo-allowed (fn [_ _] (swap! calls inc) #{(:generation @policy)})
                           {:context (fn [_ _] @policy) :now (fn [] @time)})]
    (is (= #{1} (f "p" d)))
    (is (= #{1} (f "p" d)))
    (is (= 1 @calls))
    (swap! policy assoc :generation 2)
    (is (= #{2} (f "p" d)))
    (is (= 2 @calls))
    (reset! time 20)
    (f "p" d) (f "p" d)
    (is (= 4 @calls))))

(deftest racing-and-unknown-policy-contexts-are-not-retained
  (let [d (datom/db (datom/connect schema)) generation (atom 0) calls (atom 0)
        f (rls/memo-allowed (fn [_ _] (swap! calls inc) (swap! generation inc) #{:ok})
                           {:context (fn [_ _] {:generation @generation})})
        unknown (rls/memo-allowed (fn [_ _] (swap! calls inc) #{:ok})
                                 {:context (fn [_ _] nil)})]
    (f "p" d) (f "p" d) (unknown "p" d) (unknown "p" d)
    (is (= 4 @calls))))

(deftest definition-publication-revokes-a-memo-without-caller-flags
  (let [d (datom/db (datom/connect schema)) calls (atom 0)]
    (BeamLisp.Env/intern "allowed.policy.fixture" "grants" #{"document"})
    (let [read (rls/memo-allowed
                 (fn [_ _] (swap! calls inc)
                   (BeamLisp.Env/fetch! "allowed.policy.fixture" "grants")))]
      (is (= #{"document"} (read "alice" d)))
      (is (= #{"document"} (read "alice" d)))
      (is (= 1 @calls))
      (BeamLisp.Env/intern "allowed.policy.fixture" "grants" #{})
      (is (= #{} (read "alice" d)))
      (is (= 2 @calls)))))

(deftest retained-grants-recheck-expiry-after-lookup
  (let [d (datom/db (datom/connect schema)) calls (atom 0) ticks (atom 0)
        armed (atom false) time (atom 10)
        f (rls/memo-allowed
            (fn [_ _] (swap! calls inc) (if (< @time 20) #{:allowed} #{}))
            {:context (fn [_ _] {:expires-at 20})
             :now (fn [] (when @armed (reset! time (if (= 1 (swap! ticks inc)) 10 20))) @time)})]
    (is (= #{:allowed} (f "p" d)))
    (is (= #{:allowed} (f "p" d)))
    (is (= 1 @calls))
    (reset! armed true)
    (is (= #{} (f "p" d)))
    (is (= 2 @calls))))

(deftest retained-grants-recheck-external-policy-after-lookup
  (let [d (datom/db (datom/connect schema)) calls (atom 0) reads (atom 0)
        armed (atom false) policy (atom 1)
        f (rls/memo-allowed
            (fn [_ _] (swap! calls inc) #{@policy})
            {:context (fn [_ _]
                        (when (and @armed (= 2 (swap! reads inc))) (reset! policy 2))
                        {:generation @policy})})]
    (is (= #{1} (f "p" d)))
    (is (= #{1} (f "p" d)))
    (is (= 1 @calls))
    (reset! armed true)
    (is (= #{2} (f "p" d)))
    (is (= 2 @calls))))

(deftest retained-grants-recheck-code-published-during-context-evaluation
  (let [d (datom/db (datom/connect schema)) calls (atom 0) armed (atom false)]
    (BeamLisp.Env/intern "allowed.racing.fixture" "grants" #{:old})
    (let [f (rls/memo-allowed
              (fn [_ _] (swap! calls inc) (BeamLisp.Env/fetch! "allowed.racing.fixture" "grants"))
              {:context (fn [_ _] {:expires-at 200})
               :now (fn [] (when @armed
                             (reset! armed false)
                             (BeamLisp.Env/intern "allowed.racing.fixture" "grants" #{:new})) 100)})]
      (is (= #{:old} (f "p" d)))
      (is (= #{:old} (f "p" d)))
      (is (= 1 @calls))
      (reset! armed true)
      (is (= #{:new} (f "p" d)))
      (is (= 2 @calls)))))
