; test/bl/auth/conformance_test.bl — the Biscuit compatibility proof.
; Run: mix beam_lisp.test test/bl/auth/conformance_test.bl
;
; ── What "fully compatible" means, operationally ─────────────────────
;
; The entire build-vs-wrap argument (PLAN-041 §3) rests on one claim:
; compatibility is a checkable property against the reference corpus, not
; a matter of borrowing the reference code. This file is that check, at
; the layers built so far — the protobuf codec and the Ed25519 signature
; chain.
;
; The corpus splits into layers, and this test judges only the layers it
; can (the rest is Wave 4's datalog engine):
;
;   crypto layer (judged here in full):
;     - every Ed25519 token must DECODE and round-trip byte-identically
;     - the 5 "Format/Signature" cases must FAIL signature verification
;       (wrong root, tampered/random block, invalid sig, reordered blocks)
;     - every other Ed25519 token must PASS signature verification — its
;       expected failure, if any, is LOGICAL (a check that doesn't hold),
;       which is authorization, not cryptography, and belongs to Wave 4
;
;   datalog layer (NOT judged here):
;     - whether a cryptographically-valid token is AUTHORIZED. The corpus
;       marks 21 tokens Ok and 11 as FailedLogic; distinguishing those is
;       the authorizer's job, tested once Wave 4 lands.
;
;   secp256r1 (explicitly deferred):
;     - test036/test037 use P-256, not Ed25519. The plan defers P-256, so
;       they are listed as known-skips here rather than silently failing;
;       when P-256 lands they move into the verified set.
;
; Driving the test from samples.json (rather than a hand-list) means a
; re-vendor of the corpus updates the oracle automatically.

(ns auth.biscuit.conformance-test
  (:require [auth.biscuit.codec :as codec]
            [auth.biscuit.crypto :as c]))

(defn- read-bytes [path]
  (elem (File/read path) 1))

(defn- hex->bytes [s]
  (Base/decode16! (String/upcase s)))

(def SAMPLE-DIR "test/fixtures/biscuit-samples/")

(def manifest
  (json/decode (elem (File/read (str SAMPLE-DIR "samples.json")) 1)))

(def ROOT-PUB (hex->bytes (get manifest "root_public_key")))

;; Tokens whose FIRST validation expects a Format/Signature or
;; deserialization error — these must fail the crypto layer.
(def SIGNATURE-FAILURES
  #{"test002_different_root_key.bc"
    "test003_invalid_signature_format.bc"
    "test004_random_block.bc"
    "test005_invalid_signature.bc"
    "test006_reordered_blocks.bc"})

;; secp256r1 tokens — deferred until P-256 lands.
(def P256-SKIP
  #{"test036_secp256r1.bc"
    "test037_secp256r1_third_party.bc"})

;; Third-party tokens carry blocks signed by an EXTERNAL keypair (field 4,
;; ExternalSignature). Verifying them needs the v1 external-signature
;; payload plus a trust check against the third-party public key — the
;; `trusting {public_key}` scope machinery. PLAN-041 defers this to a
;; Wave-4 sub-wave; until it lands these are known-skips at the crypto
;; layer. They still DECODE and round-trip (asserted below), which is what
;; the codec must guarantee regardless of the external-sig feature.
(def THIRD-PARTY-SKIP
  #{"test024_third_party.bc"
    "test026_public_keys_interning.bc"})

(defn- crypto-skip? [n]
  (or (contains? P256-SKIP n) (contains? THIRD-PARTY-SKIP n)))

(defn- filename [tc] (get tc "filename"))

(defn- testcases [] (get manifest "testcases"))

;; ── every token decodes and round-trips ─────────────────────────────

(deftest all-samples-decode-and-roundtrip
  (doseq [tc (testcases)]
    (let [n (filename tc)]
      (when (not (contains? P256-SKIP n))
        (let [raw (read-bytes (str SAMPLE-DIR n))
              tok (try (codec/decode raw) (catch e {:decode-error e}))]
          ;; test003 is a deliberately malformed signature; it may fail to
          ;; decode cleanly, which is itself the expected behaviour. Every
          ;; OTHER token must decode and re-encode to the same bytes.
          (if (contains? tok :decode-error)
            (is (= "test003_invalid_signature_format.bc" n)
                (str n " unexpectedly failed to decode"))
            (is (= raw (codec/encode tok))
                (str n " must round-trip byte-identically"))))))))

;; ── the signature-failure cases fail the crypto layer ───────────────

(deftest signature-failures-are-rejected
  (doseq [n SIGNATURE-FAILURES]
    (let [raw (read-bytes (str SAMPLE-DIR n))
          tok (try (codec/decode raw) (catch e {:decode-error e}))]
      (if (contains? tok :decode-error)
        ;; a malformed token that won't even decode is correctly rejected
        (is true)
        (is (not (c/verify ROOT-PUB tok))
            (str n " must fail signature verification"))))))

;; ── every other Ed25519 token passes the crypto layer ───────────────
;;
;; This is the strong half: 31 tokens whose failures (if any) are LOGICAL
;; must nonetheless be cryptographically SOUND. A false here would mean the
;; codec or chain corrupts a valid token — the worst kind of bug, because
;; it would reject legitimate tokens in production.

(deftest valid-tokens-pass-signature-verification
  (doseq [tc (testcases)]
    (let [n (filename tc)]
      (when (and (not (contains? SIGNATURE-FAILURES n))
                 (not (crypto-skip? n)))
        (let [raw (read-bytes (str SAMPLE-DIR n))
              tok (try (codec/decode raw) (catch e {:decode-error e}))]
          (when (not (contains? tok :decode-error))
            (is (c/verify-chain ROOT-PUB tok)
                (str n " is a valid Ed25519 token; its signature chain must verify"))))))))

;; ── coverage sanity: we actually exercised the corpus ───────────────

(deftest corpus-coverage
  ;; guards against a silently-empty run (e.g. a bad path). The vendored
  ;; corpus has 38 testcases; assert we see them all.
  (is (= 38 (count (testcases))))
  (is (= 5 (count SIGNATURE-FAILURES))))
