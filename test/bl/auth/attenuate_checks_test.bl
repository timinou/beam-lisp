; test/bl/auth/attenuate_checks_test.bl — checks IN the block (PLAN-047 W4).
; Run: mix beam_lisp.test test/bl/auth/attenuate_checks_test.bl
;
; The expression/rule/check wire encoder, proven two ways:
;
;   1. ROUND-TRIP: decode a corpus block carrying a check, re-encode it,
;      get the SAME BYTES back. Signed blocks make byte-equality the only
;      honest gate — a semantically-equal-but-differently-encoded block
;      would break the signature chain.
;   2. TTL USE CASE: attenuate a token with `check if time($t), $t < T`
;      and watch authorization flip from allow to deny as the cutoff
;      passes — the sandbox that outlives its window, by never.

(ns auth.attenuate-checks-test
  (:require [auth]
            [auth.biscuit.codec :as codec]
            [auth.biscuit.datalog :as dl]
            [auth.engine.expr :as expr]))

;; ── round-trip: decode → encode → same bytes ────────────────────────

(def corpus-fixtures
  ; fixture -> number of blocks the decoder reads today. The count is
  ; asserted: a decoder regression must turn this gate RED, never let it
  ; pass vacuously by decoding fewer blocks.
  [["test001_basic.bc" 2]
   ; test008's third block exercises a scope construct the decoder itself
   ; rejects today — a pre-existing decoder gap, outside this wave
   ["test008_scoped_checks.bc" 2]
   ["test025_check_all.bc" 1]
   ["test017_expressions.bc" 1]])

(defn- decode-blocks [f]
  ; -> [[raw-bytes decoded-block] ...] for every block the decoder reads
  (let [t (codec/decode (elem (File/read (str "test/fixtures/biscuit-samples/" f)) 1))
        blocks (cons (:authority t) (:blocks t))]
    (filter (fn [pair] (some? (second pair)))
            (mapv (fn [b] [(:data b) (try (dl/decode-block (:data b)) (catch e nil))])
                  blocks))))

(deftest corpus-check-blocks-roundtrip-byte-exact
  (doseq [pair corpus-fixtures]
    (let [f (first pair)
          decoded (decode-blocks f)]
      (is (= (second pair) (count decoded)))
      (doseq [blk decoded]
        (let [raw (first blk)
              d (second blk)]
          (is (= raw (dl/encode-block* {:facts (mapv dl/predicate->tuple (:facts d))
                                        :rules (:rules d)
                                        :checks (:checks d)
                                        :context (:context d)
                                        :symbols (:symbols d)
                                        :version (:version d)}))))))))

(deftest corpus-expressions-roundtrip-byte-exact
  ; One level deeper than the block gate: every EXPRESSION inside every
  ; decodable block decodes to ops and re-encodes to the same bytes —
  ; this is what proves encode-op's kind tables against biscuit-rust's
  ; real expression encodings (41 expressions across the corpus).
  (doseq [pair corpus-fixtures]
    (doseq [blk (decode-blocks (first pair))]
      (doseq [c (:checks (second blk))]
        (doseq [q (:queries c)]
          (doseq [e (:exprs q)]
            ; decoded value ops carry raw TERM bytes; numeric var slots
            ; pass through the resolver untouched
            (is (= e (second (dl/encode-expression {:symbols []} (fn [v] v)
                                                   (expr/decode-expression e)))))))))))

;; ── TTL: the check rides the token ──────────────────────────────────

(def root (auth/keypair))
(def root-pub (auth/public root))

(def PAST 1000000000)     ; 2001 — long gone
(def FUTURE 4102444800)   ; 2100 — not soon

(defn- time-ctx [now]
  (auth/context {:facts [["time" {:date now}]]
                 :policies [(auth/allow [])]}))

(deftest ttl-attenuation-expires-the-token
  (let [token (auth/issue root [["right" "Elixir.String" "call"]])
        fresh (auth/attenuate token {:checks [(auth/ttl-check "t" {:date FUTURE})]})
        stale (auth/attenuate token {:checks [(auth/ttl-check "t" {:date PAST})]})]
    ; within the window: allow
    (is (= :allow (:verdict (auth/authorize root-pub fresh (time-ctx 1700000000)))))
    ; past the cutoff: deny, and the reason SAYS it was the check
    (let [v (auth/authorize root-pub stale (time-ctx 1700000000))]
      (is (= :deny (:verdict v)))
      (is (= :failed-check (:reason v))))))

(deftest ttl-sandbox-fork-respects-the-window
  ; The full loop: a token inside its window forks a sandbox; past it,
  ; sandbox-fork refuses.
  (let [token (auth/issue root [["right" "Elixir.String" "call"]])
        fresh (auth/attenuate token {:checks [(auth/ttl-check "t" {:date FUTURE})]})
        stale (auth/attenuate token {:checks [(auth/ttl-check "t" {:date PAST})]})
        ok-r (auth/sandbox-fork root-pub fresh (time-ctx 1700000000) :global)
        no-r (auth/sandbox-fork root-pub stale (time-ctx 1700000000) :global)]
    (is (contains? ok-r :ok))
    (is (contains? no-r :error))
    (is (= :failed-check (:reason (:error no-r))))))
