; test/bl/auth/rls_test.bl — row-level security by clause injection.
; Run: mix beam_lisp.test test/bl/auth/rls_test.bl
;
; Wave 6: the query side of the "one datalog" thesis. The app writes one
; RLS-innocent query; auth injects `:where` clauses so it returns only the
; principal's rows. Proven against a real datom database — the same query,
; guarded for two different principals, returns disjoint results; forbidden
; rows are ABSENT, never an error (enumeration-safe).

(ns auth.rls-test
  (:require [auth.rls :as rls]
            [datom]
            [datom.query.parse :as parse]))

;; ── a small owned-documents database ────────────────────────────────

(def conn
  (datom/connect
    [{:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/owner :db/valueType :db.type/string}]))

(datom/transact! conn
  [{:db/id -1 :doc/title "Alice One"   :doc/owner "alice"}
   {:db/id -2 :doc/title "Alice Two"   :doc/owner "alice"}
   {:db/id -3 :doc/title "Bob One"     :doc/owner "bob"}])

(def db (datom/db conn))

;; the app's own query — no notion of who is asking.
(def all-docs
  '[:find ?title :where [?doc :doc/title ?title]])

;; ── injection shape ─────────────────────────────────────────────────

(deftest inject-appends-where-clauses
  ;; the result is the map form with the extra clause appended, caller's
  ;; clauses kept first.
  (let [guarded (rls/inject all-docs [['?doc :doc/owner "alice"]])]
    (is (= 1 (count (:find guarded))))
    (is (= 2 (count (:where guarded))))
    ;; the injected clause is last
    (is (= ['?doc :doc/owner "alice"] (last (:where guarded))))))

(deftest inject-accepts-map-form
  ;; a query already in map form round-trips.
  (let [q {:find ['?title] :where [['?doc :doc/title '?title]]}
        guarded (rls/inject q [['?doc :doc/owner "bob"]])]
    (is (= 2 (count (:where guarded))))))

;; ── the security property, against a real db ────────────────────────

(deftest guarded-query-returns-only-principal-rows
  ;; the SAME query, guarded for alice, returns only alice's docs.
  (let [alice-q (rls/guarded all-docs [(rls/owner-filter '?doc :doc/owner "alice")])
        bob-q   (rls/guarded all-docs [(rls/owner-filter '?doc :doc/owner "bob")])
        alice-rows (set (datom/q alice-q db))
        bob-rows   (set (datom/q bob-q db))]
    ;; alice sees her two docs, not bob's
    (is (= #{["Alice One"] ["Alice Two"]} alice-rows))
    ;; bob sees only his
    (is (= #{["Bob One"]} bob-rows))
    ;; disjoint — no leakage
    (is (empty? (filterv (fn [x] (contains? bob-rows x)) (Enum/to_list alice-rows))))))

(deftest unguarded-query-sees-everything
  ;; sanity: without RLS the same query returns all rows, proving the
  ;; guard is what restricts, not the data.
  (is (= 3 (count (datom/q all-docs db)))))

(deftest forbidden-rows-are-absent-not-errors
  ;; a principal with no docs gets an EMPTY result, never an error — the
  ;; enumeration-safe property. Querying for "carol" (who owns nothing)
  ;; simply returns nothing.
  (let [carol-q (rls/guarded all-docs [(rls/owner-filter '?doc :doc/owner "carol")])]
    (is (empty? (datom/q carol-q db)))))

;; ── composition with time-travel ────────────────────────────────────

(deftest guard-composes-with-as-of
  ;; the injected clauses carry no basis; they filter whatever db value the
  ;; caller holds. Guarding a query and running it against the current db
  ;; works identically to running the app query — the guard is basis-blind.
  (let [alice-q (rls/guarded all-docs [(rls/owner-filter '?doc :doc/owner "alice")])
        ;; current basis
        now-rows (set (datom/q alice-q db))]
    (is (= #{["Alice One"] ["Alice Two"]} now-rows))))

