; test/bl/auth/register_test.bl — creating a credential, as a value.
; Run: bl test test/bl/auth/register_test.bl
;
; Registration is the mirror of login: login turns a stored secret + a
; presented one into a verified principal; register turns a CHOSEN password
; into the stored secret and the facts to mint from. Each property below is a
; way that is wrong in a real app if the protocol is not written once — a
; password stored in the clear, an unenforced minimum, a verifier that accepts
; its own plaintext back.

(ns auth.register-test
  (:require [auth]))

;; ── the happy path: what comes back is storable, and verifiable ──────

(deftest register-returns-a-stored-secret-and-facts
  (let [r (auth/register {:identity "ada@x.com" :password "correct-horse"})]
    (is (contains? r :ok))
    (let [{:keys [identity verifier facts]} (:ok r)]
      (is (= "ada@x.com" identity))
      ; the verifier is the self-describing PBKDF2 string — never the plaintext
      (is (string? verifier))
      (is (not= "correct-horse" verifier))
      (is (= "pbkdf2$sha256$" (String/slice verifier 0 14)))
      ; the facts are exactly what a login strategy emits → one seam to `issue`
      (is (= [["user" "ada@x.com"]] facts)))))

(deftest the-returned-verifier-verifies-and-nothing-else-does
  (let [{:keys [verifier]} (:ok (auth/register {:identity "ada@x.com" :password "correct-horse"}))]
    (is (auth/verify-password "correct-horse" verifier))
    (is (not (auth/verify-password "correct-hors" verifier)))
    (is (not (auth/verify-password "" verifier)))))

(deftest two-registrations-of-one-password-differ
  ; a fresh salt per credential: identical passwords must not share a verifier,
  ; or one rainbow table breaks every account with that password.
  (let [a (:ok (auth/register {:identity "a@x.com" :password "correct-horse"}))
        b (:ok (auth/register {:identity "b@x.com" :password "correct-horse"}))]
    (is (not= (:verifier a) (:verifier b)))))

;; ── the policy: the failures that are one line each ──────────────────

(deftest the-default-policy-refuses-weak-credentials
  (is (= {:error :password-empty}    (auth/register {:identity "a@x.com" :password ""})))
  (is (= {:error :password-empty}    (auth/register {:identity "a@x.com" :password nil})))
  (is (= {:error :password-too-short} (auth/register {:identity "a@x.com" :password "short"})))
  (is (= {:error :identity-empty}    (auth/register {:identity "" :password "correct-horse"})))
  (is (= {:error :identity-empty}    (auth/register {:identity nil :password "correct-horse"})))
  ; a password equal to the identity is the first guess anyone makes
  (is (= {:error :password-equals-identity}
         (auth/register {:identity "correct-horse" :password "correct-horse"}))))

(deftest a-caller-supplied-policy-wins
  ; a 12-character floor: the same password the default accepts is refused
  (let [strict {:min-length 12 :max-length 100}]
    (is (= {:error :password-too-short}
           (auth/register {:identity "a@x.com" :password "short-horse"} strict)))
    (is (contains? (auth/register {:identity "a@x.com" :password "correct-horse"} strict) :ok))
    ; and the floor is DATA an app can inspect before it accepts a form
    (is (= 12 (:min-length strict)))))

(deftest check-is-a-value-not-a-throw
  ; the reason is enumerable, so a form can render it; nothing raises
  (is (nil? (auth/check-password-policy "a@x.com" "correct-horse")))
  (is (= {:error :password-too-short} (auth/check-password-policy "a@x.com" "sh"))))

;; ── what was never stored cannot leak ────────────────────────────────

(deftest an-unreadable-verifier-authenticates-no-one
  (is (not (auth/verify-password "correct-horse" nil)))
  (is (not (auth/verify-password "correct-horse" "not-a-verifier")))
  (is (not (auth/verify-password "correct-horse" "pbkdf2$sha256$oops"))))

;; ── the seam: a registered identity mints a token like a logged-in one ──

(deftest registration-facts-mint-a-verifiable-token
  (let [root (auth/keypair)
        {:keys [facts]} (:ok (auth/register {:identity "ada@x.com" :password "correct-horse"}))
        token (auth/issue root facts)]
    (is (auth/verify (auth/public root) token))
    (is (= "ada@x.com" (auth/principal (auth/public root) token)))))
