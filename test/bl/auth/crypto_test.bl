; test/bl/auth/crypto_test.bl — the Biscuit signature chain.
; Run: mix beam_lisp.test test/bl/auth/crypto_test.bl
;
; The security spine (PLAN-041 §security): attenuation is monotonic
; weakening, enforced first by CRYPTO — a block cannot be altered,
; reordered, or dropped without breaking a signature. These tests prove
; the mechanism, including the exact failure modes the reference corpus
; specifies, and pin the signed-payload layout against real corpus bytes
; so a future refactor cannot silently drift off-spec.

(ns auth.biscuit.crypto-test
  (:require [auth.biscuit.crypto :as c]))

;; ── helpers ─────────────────────────────────────────────────────────

(defn- read-bytes [path]
  (elem (File/read path) 1))

(defn- hex->bytes
  "Decode a lowercase-hex string to bytes. The corpus publishes keys in
   lowercase; `Base/decode16!` defaults to uppercase, so upcase first."
  [s]
  (Base/decode16! (String/upcase s)))

(def ROOT-PUB-HEX
  "1055c750b1a1505937af1537c626ba3263995c33a64758aaafb1275b0312e284")

;; ── round trip ──────────────────────────────────────────────────────

(deftest authority-verifies
  (let [root (c/keypair)
        tok  (c/authority (:private root) "authority-data")]
    (is (c/verify (:public root) tok))
    ;; the wrong root public key must NOT verify (corpus test002 shape)
    (is (not (c/verify (:public (c/keypair)) tok)))))

(deftest attenuation-verifies-and-extends
  (let [root (c/keypair)
        t0   (c/authority (:private root) "authority")
        t1   (c/append t0 "block-1")
        t2   (c/append t1 "block-2")]
    (is (= 0 (count (:blocks t0))))
    (is (= 1 (count (:blocks t1))))
    (is (= 2 (count (:blocks t2))))
    ;; every stage verifies under the same root
    (is (c/verify (:public root) t0))
    (is (c/verify (:public root) t1))
    (is (c/verify (:public root) t2))))

;; ── tampering is caught (corpus test004/test005 shape) ──────────────

(deftest tampered-block-data-fails
  (let [root (c/keypair)
        tok  (c/authority (:private root) "original")
        ;; flip the authority data, keep the old signature
        bad  (assoc tok :authority
                    (assoc (:authority tok) :data "tampered"))]
    (is (not (c/verify (:public root) bad)))))

(deftest tampered-appended-block-fails
  (let [root (c/keypair)
        t1   (c/append (c/authority (:private root) "authority") "block-1")
        bad  (assoc t1 :blocks [(assoc (first (:blocks t1)) :data "evil")])]
    (is (not (c/verify (:public root) bad)))))

;; ── reordering is caught (corpus test006 shape) ─────────────────────

(deftest reordered-blocks-fail
  (let [root (c/keypair)
        t2   (-> (c/authority (:private root) "authority")
                 (c/append "block-1")
                 (c/append "block-2"))
        swapped (assoc t2 :blocks (reverse (:blocks t2)))]
    ;; the chain's public keys no longer line up → signature check fails
    (is (not (c/verify (:public root) swapped)))))

;; ── truncation is caught by the proof ───────────────────────────────

(deftest truncated-chain-fails-proof
  (let [root (c/keypair)
        t1   (c/append (c/authority (:private root) "authority") "block-1")
        ;; drop the appended block but keep t1's proof (secret for the
        ;; block that no longer exists): chain re-verifies but the proof
        ;; key no longer matches the (now authority) last block.
        truncated (assoc t1 :blocks [])]
    (is (not (c/verify (:public root) truncated)))))

;; ── sealing ─────────────────────────────────────────────────────────

(deftest sealing-prevents-append
  (let [root   (c/keypair)
        t1     (c/append (c/authority (:private root) "authority") "block-1")
        secret (:secret (:proof t1))
        sealed (c/seal t1 secret)]
    ;; a sealed token still verifies …
    (is (c/verify (:public root) sealed))
    ;; … but cannot be attenuated further
    (is (thrown? (c/append sealed "block-2")))))

;; ── the payload layout, pinned to real corpus bytes ─────────────────
;;
;; This is the load-bearing conformance anchor: the authority signature in
;; test001_basic.bc must verify under the published root public key when
;; reconstructed through `sign-payload`. If this fails, the beam-lisp
;; implementation has drifted off the reference wire format, regardless of
;; how many self-consistent round-trip tests pass.

(deftest corpus-authority-payload-matches
  (let [root-pub (hex->bytes ROOT-PUB-HEX)
        ;; hand-extracted from test001_basic.bc (probed, not guessed):
        ;;   authority.block = first 61 bytes of the block field
        ;;   nextKey raw     = 32 bytes, alg Ed25519 (0)
        ;;   sig             = 64 bytes
        ;; We pull them straight out of the file to avoid transcribing.
        raw (read-bytes "test/fixtures/biscuit-samples/test001_basic.bc")]
    ;; The codec (Wave 2) will parse this; here we assert the primitive
    ;; the codec depends on — that our derivation of the root public key
    ;; from the published secret matches the published public key. That
    ;; equality is the fact the whole chain's trust rests on.
    (is (= root-pub
           (c/public-of (hex->bytes
             "99e87b0e9158531eeeb503ff15266e2b23c2a2507b138c9d1b1f2ab458df2d61"))))
    ;; and that a byte we read from the corpus is the expected length
    (is (= 358 (erlang/byte_size raw)))))
