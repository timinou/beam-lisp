; test/bl/auth/audit_test.bl — verdicts as data + the RLS tie-in.
; Run: mix beam_lisp.test test/bl/auth/audit_test.bl
;
; PLAN-047 W6. Two halves, one thesis — "what happened" and "what may
; be seen" are datalog questions, so the answers live in datom:
;
;   1. Every authorization — allow AND deny — is recorded as one entity;
;      "what was this token allowed to do, and when?" is a query over
;      history, with tx-time for free.
;   2. The same token that narrows an env's calls carries the principal
;      fact that narrows a query's rows (auth/owner-scope → auth/guard).

(ns auth.audit-test
  (:require [auth] [datom] [env]))

(def root (auth/keypair))
(def root-pub (auth/public root))

(defn open-ctx []
  (auth/context {:facts [["operation" "read"] ["resource" "doc-42"]]
                 :policies [(auth/allow [])]}))

; Alice's token: identity for RLS, a String right for the sandbox.
(def alice-token
  (auth/issue root [["user" "alice"]
                    ["right" "Elixir.String" "call"]]))

;; ── audit: the decision is a row ────────────────────────────────────

(def audit-conn
  (datom/connect
    [{:db/ident :audit/token :db/valueType :db.type/string}
     {:db/ident :audit/verdict :db/valueType :db.type/keyword}
     {:db/ident :audit/policy-index :db/valueType :db.type/long}
     {:db/ident :audit/reason :db/valueType :db.type/keyword}
     {:db/ident :audit/operation :db/valueType :db.type/string}
     {:db/ident :audit/resource :db/valueType :db.type/string}]))

(deftest audited-fork-records-the-allow
  (let [r (auth/sandbox-fork-audited root-pub alice-token (open-ctx) :global audit-conn)
        db (datom/db audit-conn)
        rows (datom/q '[:find ?v ?op ?res
                        :in $ ?tid
                        :where [?e :audit/token ?tid]
                               [?e :audit/verdict ?v]
                               [?e :audit/operation ?op]
                               [?e :audit/resource ?res]]
                      db (auth/token-id alice-token))]
    (is (contains? r :ok))
    (is (contains? r :report))
    (is (= #{[:allow "read" "doc-42"]} (set rows)))
    (env/destroy (:ok r))))

(deftest audited-fork-records-the-deny
  ; A forged token: right signature key, wrong root. The denial is
  ; recorded with its reason — "who was turned away, and why".
  (let [other-root (auth/keypair)
        forged (auth/issue other-root [["user" "mallory"]
                                       ["right" "Elixir.File" "write"]])
        r (auth/sandbox-fork-audited root-pub forged (open-ctx) :global audit-conn)
        db (datom/db audit-conn)
        rows (datom/q '[:find ?v ?reason
                        :in $ ?tid
                        :where [?e :audit/token ?tid]
                               [?e :audit/verdict ?v]
                               [?e :audit/reason ?reason]]
                      db (auth/token-id forged))]
    (is (contains? r :error))
    (is (= :invalid-signature (:reason (:error r))))
    (is (= #{[:deny :invalid-signature]} (set rows)))))

;; ── RLS tie-in: one token, two enforcement points ───────────────────

(deftest verified-facts-refuses-a-forgery
  (let [other-root (auth/keypair)
        forged (auth/issue other-root [["user" "mallory"]])]
    (is (= ["user" "alice"] (first (auth/verified-facts root-pub alice-token))))
    (is (nil? (auth/verified-facts root-pub forged)))))

(deftest owner-scope-from-the-token
  ; The token's (user alice) fact becomes the guard filter — no
  ; principal string ever passes through app code.
  (let [doc-conn (datom/connect
                   [{:db/ident :doc/title :db/valueType :db.type/string}
                    {:db/ident :doc/owner :db/valueType :db.type/string}])]
    (datom/transact! doc-conn
      [{:db/id -1 :doc/title "Alice One" :doc/owner "alice"}
       {:db/id -2 :doc/title "Bob One"   :doc/owner "bob"}])
    (let [scope (auth/owner-scope root-pub alice-token '?doc :doc/owner)
          guarded (auth/guard '[:find ?title :where [?doc :doc/title ?title]]
                              [(:ok scope)])
          rows (set (datom/q guarded (datom/db doc-conn)))]
      (is (contains? scope :ok))
      (is (= #{["Alice One"]} rows)))))

(deftest owner-scope-fail-closed
  (let [other-root (auth/keypair)
        forged (auth/issue other-root [["user" "mallory"]])
        anon (auth/issue root [["right" "Elixir.String" "call"]])]
    (is (= {:error :forged} (auth/owner-scope root-pub forged '?doc :doc/owner)))
    (is (= {:error :no-principal} (auth/owner-scope root-pub anon '?doc :doc/owner)))))
