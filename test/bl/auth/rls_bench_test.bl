; rls_bench_test.bl — scoping cost: unscoped vs :in-set vs relation vs post-filter.
; Sized by N-CHUNKS (default small so CI is fast); for the 20k/2k/1k numbers
; set the constants below to 20000/2000/1000 and run it by hand.

(ns auth.rls-bench-test
  (:require [auth.rls :as rls] [datom]))

(def N-CHUNKS 2000)
(def N-SRC 200)
(def N-ITEMS 100)

(def conn
  (datom/connect
    [{:db/ident :src/origin :db/valueType :db.type/string}
     {:db/ident :chunk/src :db/valueType :db.type/ref}
     {:db/ident :chunk/text :db/valueType :db.type/string}
     {:db/ident :grant/who :db/valueType :db.type/string}
     {:db/ident :grant/key :db/valueType :db.type/string}]))

(def item-key (fn [i] (str "item-" i)))
(def allowed-keys (into #{} (map item-key (filter even? (range N-ITEMS)))))

(def seeded
  (do
    (datom/transact! conn
      (into (mapv (fn [s] {:db/id (- (+ s 1)) :src/origin (item-key (mod s N-ITEMS))}) (range N-SRC))
            (concat
              (mapv (fn [c] {:db/id (- (+ N-SRC c 1)) :chunk/src (- (+ 1 (mod c N-SRC))) :chunk/text (str "t" c)})
                    (range N-CHUNKS))
              (map-indexed (fn [i k] {:db/id (- (+ N-SRC N-CHUNKS i 1)) :grant/who "alice" :grant/key k})
                           allowed-keys))))
    true))

(def db (datom/db conn))
(def q '[:find ?t :where [?c :chunk/text ?t]])
(def ms (fn [] (System/monotonic_time :millisecond)))
(defn- timed [f] (let [t0 (ms) r (f)] [(- (ms) t0) r]))

(def via [:chunk/src :src/origin])
(def run-set (fn [] (let [s (rls/scope q {:var '?c :via via :allow {:set allowed-keys}})]
                      (set (apply datom/q (:query s) db (:inputs s))))))
(def run-rel (fn [] (let [s (rls/scope q {:var '?c :via via
                                          :allow {:clauses [['?g :grant/who "alice"] ['?g :grant/key '?key]]}})]
                      (set (apply datom/q (:query s) db (:inputs s))))))
; :mode :collection is O(rows x set) in this engine (23.5s at 2000 chunks) — not benchmarked.
(def run-coll (fn [] (let [s (rls/scope q {:var '?c :via via :allow {:set allowed-keys} :mode :collection})]
                       (set (apply datom/q (:query s) db (:inputs s))))))
(def run-post (fn [] (set (filter (fn [[c k]] (contains? allowed-keys k))
                                  (datom/q '[:find ?t ?k :where [?c :chunk/text ?t] [?c :chunk/src ?s] [?s :src/origin ?k]] db)))))

(deftest bench-scoping-strategies
  (let [[t-un un] (timed (fn [] (set (datom/q q db))))
        [t-set a] (timed run-set)
        [t-rel b] (timed run-rel)
        [t-post p] (timed run-post)]
    (println (str "BENCH chunks=" N-CHUNKS " unscoped=" t-un "ms in-set=" t-set "ms relation=" t-rel
                  "ms post-filter=" t-post "ms rows=" (count un) "/" (count a)))
    (is (= a b))
    (is (= (count a) (count p)))
    (is (= (quot N-CHUNKS 2) (count a)))))
