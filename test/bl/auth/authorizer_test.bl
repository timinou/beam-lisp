; test/bl/auth/authorizer_test.bl — the one authorization function.
; Run: mix beam_lisp.test test/bl/auth/authorizer_test.bl
;
; Wave 5: the full Biscuit decision procedure — signature, then checks,
; then policies — composed into a pure function and proven against the
; reference corpus's authorization outcomes.
;
; The key corpus anchor is test001: its authorizer is `resource("file1");
; allow if true;`, and the reference result is Unauthorized, because the
; token's block-1 check also requires operation("read"), which the
; authorizer does not provide. Reproducing that exact outcome — deny by
; failed check, not by signature and not by policy — proves the whole
; pipeline agrees with the reference at the logic layer.

(ns auth.authorizer-test
  (:require [auth.biscuit.codec :as codec]
            [auth.biscuit.crypto :as crypto]
            [auth.authorizer :as az]))

(defn- hex->bytes [s] (Base/decode16! (String/upcase s)))

(def ROOT-PUB
  (hex->bytes "1055c750b1a1505937af1537c626ba3263995c33a64758aaafb1275b0312e284"))

(defn- token [n]
  (codec/decode (elem (File/read (str "test/fixtures/biscuit-samples/" n)) 1)))

;; an `allow if true` policy: an empty-body query trivially matches.
(def ALLOW-TRUE
  {:kind :allow :query {:head {:name "q" :terms []} :body [] :exprs [] :symbols []}})
(def DENY-TRUE
  {:kind :deny :query {:head {:name "q" :terms []} :body [] :exprs [] :symbols []}})

(defn- authorizer [facts policies]
  {:facts facts :rules [] :checks [] :policies policies})

;; ── the corpus anchor: test001 ──────────────────────────────────────

(deftest test001-unauthorized-without-operation
  ;; the reference authorizer: resource("file1"); allow if true;
  ;; → Unauthorized, because block-1's check needs operation("read").
  (let [d (az/authorize ROOT-PUB (token "test001_basic.bc")
                        (authorizer [["resource" "file1"]] [ALLOW-TRUE]))]
    (is (= :deny (:verdict d)))
    (is (= :failed-check (:reason d)))))

(deftest test001-authorized-with-operation
  ;; add operation("read"); the block-1 check's join now succeeds and the
  ;; allow policy fires.
  (let [d (az/authorize ROOT-PUB (token "test001_basic.bc")
                        (authorizer [["resource" "file1"] ["operation" "read"]]
                                    [ALLOW-TRUE]))]
    (is (= :allow (:verdict d)))
    (is (= 0 (:policy d)))))

;; ── ordering: signature is checked first ────────────────────────────

(deftest wrong-root-denies-before-logic
  ;; test002 is signed by a different root; even a permissive authorizer
  ;; must deny at the signature, never reaching the logic.
  (let [d (az/authorize ROOT-PUB (token "test002_different_root_key.bc")
                        (authorizer [["resource" "file1"] ["operation" "read"]]
                                    [ALLOW-TRUE]))]
    (is (= :deny (:verdict d)))
    (is (= :invalid-signature (:reason d)))))

;; ── policy semantics ────────────────────────────────────────────────

(deftest no-policy-denies
  ;; all checks pass but no policy matches → deny (the spec's default).
  ;; Use a token whose checks are satisfiable with operation+resource, but
  ;; supply NO policy.
  (let [d (az/authorize ROOT-PUB (token "test001_basic.bc")
                        (authorizer [["resource" "file1"] ["operation" "read"]]
                                    []))]
    (is (= :deny (:verdict d)))
    (is (= :no-matching-policy (:reason d)))))

(deftest deny-overrides-when-first
  ;; a deny policy placed before an allow takes precedence (deny-overrides).
  ;; checks pass, but the first matching policy is a deny.
  (let [d (az/authorize ROOT-PUB (token "test001_basic.bc")
                        (authorizer [["resource" "file1"] ["operation" "read"]]
                                    [DENY-TRUE ALLOW-TRUE]))]
    (is (= :deny (:verdict d)))
    (is (= :deny-policy (:reason d)))))

(deftest allow-when-first
  ;; allow before deny → allow (order decides).
  (let [d (az/authorize ROOT-PUB (token "test001_basic.bc")
                        (authorizer [["resource" "file1"] ["operation" "read"]]
                                    [ALLOW-TRUE DENY-TRUE]))]
    (is (= :allow (:verdict d)))))

;; ── purity ──────────────────────────────────────────────────────────

(deftest authorize-is-referentially-transparent
  ;; same inputs → same decision, every time. The property that makes an
  ;; authorization reproducible and testable against a literal fact set.
  (let [tok (token "test001_basic.bc")
        az1 (authorizer [["resource" "file1"] ["operation" "read"]] [ALLOW-TRUE])
        d1 (az/authorize ROOT-PUB tok az1)
        d2 (az/authorize ROOT-PUB tok az1)]
    (is (= d1 d2))
    (is (= :allow (:verdict d1)))))
