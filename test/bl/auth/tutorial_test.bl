; test/bl/auth/tutorial_test.bl — the downstream experience, proven.
; Run: mix beam_lisp.test test/bl/auth/tutorial_test.bl
;
; Wave 8, and the acceptance test for the whole vision. Every scenario in
; the design doc's §9 ("the downstream experience") is exercised here
; THROUGH THE FACADE — the single `(:require [auth])` an app author writes.
; If these pass, the promise of the design is real: authorization is a
; value, a pure function, and a query rewrite, and turning it on is a
; handful of forms over data.

(ns auth.tutorial-test
  (:require [auth]
            [datom]))

;; ── §9.1 issue · §9.3 authorize ─────────────────────────────────────

(deftest issue-and-authorize
  ;; a root mints a token of authority facts; a service authorizes a
  ;; request against it knowing only the root PUBLIC key.
  (let [root (auth/keypair)
        token (auth/issue root [["user" "alice"]
                                ["right" "doc-42" "read"]
                                ["right" "doc-42" "write"]])
        ;; the verifier's context: the request names a resource+operation,
        ;; a check ties them to a right, and an allow policy fires.
        ctx (auth/context
              {:facts [["resource" "doc-42"] ["operation" "read"]]
               :checks [{:queries [{:head {:name "q" :terms []}
                                    :body [{:name "resource" :terms [{:var 1}]}
                                           {:name "right" :terms [{:var 1} "read"]}]
                                    :exprs [] :symbols []}]
                         :kind 0}]
               :policies [(auth/allow [])]})
        d (auth/authorize (auth/public root) token ctx)]
    (is (= :allow (:verdict d)))))

(deftest wrong-signature-denies
  ;; a token verified against the WRONG root public key is denied at the
  ;; signature — the offline verification guarantee.
  (let [root (auth/keypair)
        other (auth/keypair)
        token (auth/issue root [["user" "alice"]])
        d (auth/authorize (auth/public other) token
                          (auth/context {:policies [(auth/allow [])]}))]
    (is (= :deny (:verdict d)))
    (is (= :invalid-signature (:reason d)))))

;; ── §9.1 wire round-trip ────────────────────────────────────────────

(deftest token-is-a-portable-value
  ;; encode to bytes and base64, decode back, still verifies — a token
  ;; travels anywhere and remains verifiable offline.
  (let [root (auth/keypair)
        token (auth/issue root [["user" "alice"] ["right" "doc" "read"]])
        wire (auth/encode token)
        b64 (auth/encode-base64 token)]
    (is (auth/verify (auth/public root) (auth/decode wire)))
    (is (auth/verify (auth/public root) (auth/decode-base64 b64)))))

;; ── §9.2 attenuation only ever narrows ──────────────────────────────

(deftest attenuation-narrows-and-verifies
  ;; the bearer attenuates offline, adding a block; the result still
  ;; verifies under the same root, and the chain grew by one.
  (let [root (auth/keypair)
        token (auth/issue root [["user" "alice"] ["right" "doc" "read"]])
        narrowed (auth/attenuate token [["scope" "read-only"]])]
    (is (auth/verify (auth/public root) narrowed))
    (is (= 1 (count (:blocks narrowed))))
    ;; the original had no extra blocks
    (is (= 0 (count (:blocks token))))))

;; ── §9.4 policy is data ─────────────────────────────────────────────

(deftest policy-is-a-value
  ;; a policy is a plain map you can build, inspect, and store — not a
  ;; macro expansion. deny-overrides: a deny before an allow wins.
  (let [root (auth/keypair)
        token (auth/issue root [["user" "alice"]])
        ctx (auth/context {:policies [(auth/deny []) (auth/allow [])]})
        d (auth/authorize (auth/public root) token ctx)]
    (is (= :deny (:verdict d)))
    (is (= :deny-policy (:reason d)))
    ;; and the policy really is just data
    (is (= :deny (:kind (auth/deny []))))
    (is (= :allow (:kind (auth/allow []))))))

;; ── §9.5 RLS: guard a query for a principal ─────────────────────────

(def rls-conn
  (datom/connect
    [{:db/ident :doc/title :db/valueType :db.type/string}
     {:db/ident :doc/owner :db/valueType :db.type/string}]))

(datom/transact! rls-conn
  [{:db/id -1 :doc/title "Alice One" :doc/owner "alice"}
   {:db/id -2 :doc/title "Bob One"   :doc/owner "bob"}])

(deftest guarded-query-scopes-to-principal
  (let [db (datom/db rls-conn)
        base '[:find ?title :where [?doc :doc/title ?title]]
        alice-q (auth/guard base [(auth/owner-filter '?doc :doc/owner "alice")])]
    ;; alice sees only her row; the unguarded query sees both
    (is (= #{["Alice One"]} (set (datom/q alice-q db))))
    (is (= 2 (count (datom/q base db))))))

;; ── §9.6 strategies · §9.8 the gateway, one screen ──────────────────

(deftest gateway-login-to-authorized-view
  ;; the whole downstream flow: a strategy turns credentials into facts, a
  ;; token is minted from them, and a request is authorized — all through
  ;; the facade, as one small program.
  (let [root (auth/keypair)
        ;; 1. strategies: password login → authority facts
        reg (-> (auth/strategies)
                (auth/register-strategy :password
                  (auth/password-strategy :email :password
                    (fn [_email pw] (= pw "s3cret")))))
        ;; 2. login mints a capability
        facts (auth/run-strategy reg :password {:email "ada@x.com" :password "s3cret"})
        token (auth/issue root (conj facts ["right" "report" "read"]))
        ;; 3. a request is authorized
        ctx (auth/context
              {:facts [["resource" "report"] ["operation" "read"]]
               :checks [{:queries [{:head {:name "q" :terms []}
                                    :body [{:name "right" :terms ["report" "read"]}]
                                    :exprs [] :symbols []}]
                         :kind 0}]
               :policies [(auth/allow [])]})
        d (auth/authorize (auth/public root) token ctx)]
    (is (= [["user" "ada@x.com"]] facts))
    (is (= :allow (:verdict d)))))

;; ── §9.7 revocation: the deployment picks the stance ────────────────

(deftest revocation-offline-and-online
  (let [root (auth/keypair)
        token (auth/issue root [["user" "alice"] ["right" "doc" "read"]])
        allow-ctx {:facts [] :rules [] :checks [] :policies [(auth/allow [])]}]
    ;; offline (no oracle): authorized
    (is (= :allow (:verdict (auth/authorize (auth/public root) token
                             (auth/context allow-ctx)))))
    ;; online: revoke the token's block id → denied
    (let [oracle (auth/revocation-set (auth/revocation-ids token))
          d (auth/authorize (auth/public root) token
              (auth/context (assoc allow-ctx :revocation oracle)))]
      (is (= :deny (:verdict d)))
      (is (= :revoked (:reason d))))))
