(ns auth.query-context-test
  (:require [auth] [datom] [datom.db :as dbv] [datom.profile :as profile]
            [data.bounded-cache :as cache]))

(def schema [{:db/ident :doc/title :db/valueType :db.type/string}
             {:db/ident :doc/owner :db/valueType :db.type/string}
             {:db/ident :doc/order :db/valueType :db.type/long :db/index true}])
(def query '[:find ?title ?order :where [?e :doc/title ?title] [?e :doc/order ?order]])

(deftest policy-declared-once-scopes-ordinary-queries-and-pages
  (let [c (datom/connect schema)
        _ (datom/transact! c [{:db/id -1 :doc/title "alice" :doc/order 1 :doc/owner "alice"}
                              {:db/id -2 :doc/title "bob" :doc/order 2 :doc/owner "bob"}])
        page-query '[:find ?e ?title ?order :where [?e :doc/title ?title] [?e :doc/order ?order]]
        owner (atom "alice")
        ctx (auth/query-context (datom/db c)
              (fn [_] {:attrs {:doc/title {:path []}}
                        :allow {:clauses [['?key :doc/owner @owner]]}}))]
    (is (= #{["alice" 1]} (datom/q query ctx)))
    (is (= [["alice" 1]] (mapv (fn [row] (subvec row 1))
                            (:rows (datom/q-page page-query ctx {:order-by ['?order :desc] :limit 5})))))
    (reset! owner "bob")
    (is (= #{["bob" 2]} (datom/q query ctx)))
    (is (= [["bob" 2]] (mapv (fn [row] (subvec row 1))
                          (:rows (datom/q-page page-query ctx {:order-by ['?order :desc] :limit 5})))))))

(deftest query-context-cleans-up-on-success-failure-and-refusal
  (let [d (datom/db (datom/connect schema)) releases (atom 0)
        ctx (datom/query-context d (fn [q] {:query q :inputs [] :release (fn [] (swap! releases inc))}))
        refusal (datom/query-context d (fn [_] {:refused :unscopable :why ["test"]
                                               :release (fn [] (swap! releases inc))}))]
    (is (= #{} (datom/q query ctx)))
    (is (= 1 @releases))
    (is (try (datom/q query ctx "wrong-input") false (catch _ true)))
    (is (= 2 @releases))
    (is (try (datom/q query refusal) false (catch _ true)))
    (is (= 3 @releases))))

(deftest injected-user-policy-selects-compound-access-without-query-annotations
  (let [c (datom/connect (conj schema {:db/ident :doc/owner-order :db/valueType :db.type/tuple
                                       :db/tupleAttrs [:doc/owner :doc/order] :db/index true}))
        owner (atom "alice")
        q '[:find ?e ?title ?order :where [?e :doc/title ?title] [?e :doc/order ?order]]]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :doc/title (str i)
                                     :doc/owner "alice" :doc/order i}) (range 10)))
    (let [watch (profile/watch (dbv/store-of (datom/db c)))
          run (fn [after]
                (cache/clear! :datom.query.pages)
                (profile/reset! watch)
                (let [ctx (auth/query-context (assoc (datom/db c) :store watch)
                            (fn [_] {:attrs {:doc/title {:path []}}
                                     :allow {:clauses [['?key :doc/owner @owner]]}}))
                      r (datom/q-page q ctx {:order-by ['?order :desc] :limit 3 :after after})]
                  {:page r :work (profile/counters watch)}))]
      (datom/transact! c (mapv (fn [i] {:db/id (- -1000 i) :doc/title "foreign"
                                       :doc/owner "bob" :doc/order (+ 100 i)}) (range 32)))
      (run nil)
      (let [a (run nil)]
        (datom/transact! c (mapv (fn [i] {:db/id (- -2000 i) :doc/title "foreign"
                                         :doc/owner "bob" :doc/order (+ 1000 i)}) (range 288)))
        (let [b (run nil)]
          (is (= :exact (get-in b [:page :status])))
          (is (= (get-in a [:page :rows]) (get-in b [:page :rows])))
          (is (= (:rows (:work a)) (:rows (:work b))))
          (is (< (:rows (:work b)) 20))
          (reset! owner "bob")
          (is (= :invalid-cursor (get-in (run (get-in b [:page :after])) [:page :reason])))
          (is (= ["foreign" "foreign" "foreign"]
                 (mapv second (get-in (run nil) [:page :rows]))))
          (println "automatic-user-compound-work" {:foreign-before 32 :foreign-after 320
                                                    :before (:work a) :after (:work b)}))))))
