; test/bl/seed_struct_abi_test.bl — test.seed-struct-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-struct-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-sorted-struct-types-publish-a-struct-surface-without-struct-fields
  ;; `SortedMap`/`SortedSet` are bare `defstruct [:tree]` types whose
  ;; `__struct__/0,1` and `__info__/1` the pinned source writes BY HAND:
  ;; `compile_host_file` refuses a source with no top-level `defn`, and the
  ;; `:struct_fields` opt REFUSES a module that already spells the surface out.
  ;; So the mapping is FUNCTIONS-ONLY — and the beam the floor PUBLISHES must
  ;; still be a struct module. Judged from the beam's own export chunk, not from
  ;; the mapping's options: this is the fact the options cannot state.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "struct-out")
        real {"Elixir.BeamLisp.Sorted.SortedMap" (Path/join root "priv/host/sorted_map.bl")
              "Elixir.BeamLisp.Sorted.SortedSet" (Path/join root "priv/host/sorted_set.bl")}
        hd (s/host-scratch "struct-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (doseq [m ["Elixir.BeamLisp.Sorted.SortedMap" "Elixir.BeamLisp.Sorted.SortedSet"]]
      (let [beam (Path/join out (str m ".beam"))
            exports (s/beam-exports beam)]
        (is (File/exists? beam) (str m " is COMPILED into the floor"))
        (is (s/has? exports (tuple :__struct__ 0)) (str m " exposes __struct__/0"))
        (is (s/has? exports (tuple :__struct__ 1)) (str m " exposes __struct__/1"))
        (is (s/has? exports (tuple :__info__ 1)) (str m " exposes __info__/1"))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-refs-struct-types-publish-their-constructor-surface
  ;; `Atom`, `Volatile`, `Reduced`, `Promise` and `Future` are the five bare
  ;; struct TYPES `lib/beam_lisp/refs.ex` declares beside `BeamLisp.Refs`; ONE
  ;; source (`refs_structs.bl`) is compiled at all five exact atoms, each entry
  ;; carrying only the `:struct-fields` that name ITS shape. The mapping maps
  ;; ENTRIES, not sources, so the floor publishes five DIFFERENT beams from the
  ;; same file — a source-path dedupe would drop four of them. Judged on the
  ;; PUBLISHED beams, from the real sources: every type must be a struct module
  ;; (`__struct__/0,1` and `__info__/1`) with the source's one `new/1`
  ;; constructor beside it, and `__info__(:struct)` must be the LIVE module's,
  ;; datum for datum — the fact the table's options cannot state. `Refs`, from
  ;; `refs.bl`, is functions-only and publishes no struct surface; its `deref`
  ;; reads all five types by their public tag, so it needs no type beam loaded.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "refs-out")
        structs (Path/join root "priv/host/refs_structs.bl")
        real {"Elixir.BeamLisp.Atom" structs
              "Elixir.BeamLisp.Volatile" structs
              "Elixir.BeamLisp.Reduced" structs
              "Elixir.BeamLisp.Promise" structs
              "Elixir.BeamLisp.Future" structs
              "Elixir.BeamLisp.Refs" (Path/join root "priv/host/refs.bl")}
        hd (s/host-scratch "refs-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (doseq [m ["Elixir.BeamLisp.Atom" "Elixir.BeamLisp.Volatile" "Elixir.BeamLisp.Reduced"
               "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Future"]]
      (let [mod (String/to_atom m)
            beam (Path/join out (str m ".beam"))
            exports (s/beam-exports beam)
            live (erlang/apply mod :__info__ (list :struct))]
        (is (File/exists? beam) (str m " is COMPILED into the floor"))
        (is (s/has? exports (tuple :__struct__ 0)) (str m " exposes __struct__/0"))
        (is (s/has? exports (tuple :__struct__ 1)) (str m " exposes __struct__/1"))
        (is (s/has? exports (tuple :__info__ 1)) (str m " exposes __info__/1"))
        (is (s/has? exports (tuple :new 1)) (str m " exposes the shared source's new/1"))
        (is (= live
               (s/with-swapped-module mod beam
                 (fn [mm] (erlang/apply mm :__info__ (list :struct)))))
            (str m "'s published __info__(:struct) is the live module's, datum for datum"))))
    (let [refs-beam (Path/join out "Elixir.BeamLisp.Refs.beam")
          exports (s/beam-exports refs-beam)]
      (is (File/exists? refs-beam) "Refs is COMPILED into the floor")
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "Refs is functions-only: the published beam carries no struct surface")
      (is (s/has? exports (tuple :deref 1)) "Refs exposes deref/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
