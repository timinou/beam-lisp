; emit_test.bl — pinned host-module parity for `Elixir.BeamLisp.Emit`.
;
; `priv/host/emit.bl` is compiled by `BeamLisp.AOT/compile_host_file` into ONE
; exact-named beam whose top-level `defn`s are the exported ABI every caller
; already names at `Elixir.BeamLisp.Emit`. This suite pins the two properties
; that make the pinned beam a REPLACEMENT rather than a copy:
;
;   1. SHAPE AND CLASS. A deterministic corpus is asked of the freshly
;      compiled PROBE and of the LIVE module, and the answers are compared with
;      `=:=` — exact term equality, so a bl vector where the Elixir source had a
;      list (`:clauses [{…}]` vs `:clauses ({…})`) is a FAILURE, not a
;      coincidence a looser `=` would hide. Exception CLASSES are part of the
;      answer, and the messages of the errors the ABI names itself are compared
;      verbatim.
;
;   2. EMITTED BYTES. The same deterministic fixtures are built through each
;      module's own constructors, lowered through the shared Core backend, and
;      the resulting beams are compared byte for byte. Byte parity is the whole
;      point of the port: a pinned host leaf that emitted a different beam from
;      the module it stands in for would be a silent behaviour change.
;
; Nothing here replaces the live module. The probe is compiled under its own
; atom; the deployment claim (the probe IS the committed floor) is the seed's
; question, judged on `bl_source_hash` by `bl seed --check`.
;
; Run: bin/bl test test/bl/emit_test.bl

(ns emit.test)

(defn- t2 [a b] (erlang/list_to_tuple (list a b)))
(defn- t3 [a b c] (erlang/list_to_tuple (list a b c)))
(defn- t4 [a b c d] (erlang/list_to_tuple (list a b c d)))
(defn- t5 [a b c d e] (erlang/list_to_tuple (list a b c d e)))

(defn- probe-source []
  (Path/join (BeamLisp/cwd) "priv/host/emit.bl"))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_emit_probe_" (erlang/unique_integer (list :positive))))

(defn- compile-probe*
  "Compile `priv/host/emit.bl` at the probe atom and load it; returns
   `{probe-atom, beam-path}`."
  []
  (BeamLisp.AOT/compile_host_file (probe-source)
    (list (t2 :module :Elixir.BeamLisp.HostEmitProbe)
          (t2 :output_dir (str (tmp-dir) "/out"))
          (t2 :load? true))))

(defn- compile-probe []
  (elem (compile-probe*) 0))

(def ^:private live :Elixir.BeamLisp.Emit)

(defn- answer
  "`mod` applied to `name`/`args` as a value: `{:value v}` or
   `{:raise Class message}` — so a question that raises is comparable too."
  [mod name args]
  (try (tuple :value (erlang/apply mod name args))
       (catch e (tuple :raise (type e) (ex-message e)))))

(defn- raise-class [mod name args]
  (let [a (answer mod name args)]
    (when (= :raise (elem a 0)) (elem a 1))))

(defn- pvar-named [n] {:pop :pvar :name n})

; ── fixtures, built through each module's OWN constructors ───────────────────

(defn- add-clause
  "A clause for `(defn add [a b] (+ a b))` built through `m`'s ABI."
  [m]
  (let [a0 (erlang/apply m :var (list "arg0"))
        a1 (erlang/apply m :var (list "arg1"))
        body (erlang/apply m :remote (list :erlang :+ (list a0 a1)))]
    (erlang/apply m :function_clause
      (list :add body (list (pvar-named "arg0") (pvar-named "arg1"))))))

(defn- zero-clause
  "A clause for `(defn zero [] 0)` built through `m`'s ABI."
  [m]
  (erlang/apply m :function_clause
    (list :zero (erlang/apply m :lit (list 0)))))

(defn- descriptor-of
  "The descriptor for `:Elixir.EmitParity.Beam` with an `add/2` and a `zero/0`,
   built through `m`'s constructors."
  [m]
  (erlang/apply m :descriptor_for
    (list :Elixir.EmitParity.Beam (list (add-clause m) (zero-clause m)))))

(defn- fixture-ns-defs
  "The five-field def tuples the compiler interns, for one var with an `add/2`."
  [m]
  (let [clause (add-clause m)]
    (maps/from_list
      (list (t2 "add" (list (t5 :fixed 2 :add clause :Elixir.Body.Vec)))))))

; ── the exported ABI ─────────────────────────────────────────────────────────

(deftest every-exported-entry-point-has-the-arity-the-callers-use
  (let [p (compile-probe)
        exported? (fn [m f a] (erlang/apply :erlang :function_exported (list m f a)))]
    (doseq [m (list p live)]
      (is (exported? m :module_for 1))
      (is (exported? m :fresh_body_module 0))
      (is (exported? m :attach_body_module 2))
      (is (exported? m :fixed_variadic 1))
      (is (exported? m :body_modules 1))
      (is (exported? m :shim_clauses 1))
      (is (exported? m :descriptor 3))
      (is (exported? m :descriptor 4))
      (is (exported? m :descriptor 5))
      (is (exported? m :descriptor_for 2))
      (is (exported? m :descriptor_for 3))
      (is (exported? m :descriptor_for 4))
      (is (exported? m :compile_descriptor 1))
      (is (exported? m :load_binary! 1))
      (is (exported? m :load_binary! 2))
      (is (exported? m :fn_value 3))
      (is (exported? m :lit 1))
      (is (exported? m :var 1))
      (is (exported? m :remote 3))
      (is (exported? m :sequence 1))
      (is (exported? m :closure 1))
      (is (exported? m :function_clause 2))
      (is (exported? m :function_clause 3)))))

(deftest the-pinned-constructors-answer-the-pinned-shapes
  (let [p (compile-probe)
        lit1 {:op :lit :val 1 :ann {}}]
    (is (erlang/=:= (erlang/apply p :lit (list 42))
                    {:op :lit :val 42 :ann {}})
        "lit threads an empty annotation map")
    (is (erlang/=:= (erlang/apply p :var (list "x"))
                    {:op :var :name "x" :ann {}})
        "var/1 is exported even though `var` is also a compiler special form")
    (is (erlang/=:= (erlang/apply p :remote (list :erlang :+ (list)))
                    {:op :remote :mod :erlang :fun :+ :args (list) :ann {}})
        "an empty argument list is an Erlang list, never a vector")
    (is (erlang/=:= (erlang/apply p :sequence (list (list 1 2)))
                    {:op :do :stmts (list 1 2) :ann {}}))
    (is (erlang/=:= (erlang/apply p :closure (list lit1))
                    {:op :fn
                     :clauses (list {:pats (list) :guard nil :body lit1})
                     :ann {}})
        "`pats` and `clauses` are LISTs, not bl vectors — the term the ANF
         validator and the Core backend read")
    (is (erlang/=:= (erlang/apply p :function_clause (list :f lit1))
                    {:op :"defn-clause" :fname :f :params (list) :guard nil
                     :body lit1 :ann {}})
        "the 2-arity defaults `params` to the empty LIST")))

(deftest module-naming-and-def-bookkeeping-match-the-source
  (let [p (compile-probe)]
    (is (erlang/=:= (erlang/apply p :module_for (list "foo.bar")) :Elixir.BeamLisp.Ns.Foo.Bar))
    (is (erlang/=:= (erlang/apply p :module_for (list "reader-node")) :Elixir.BeamLisp.Ns.Reader-node))
    (let [fm (erlang/apply p :fresh_body_module (list))
          fm2 (erlang/apply p :fresh_body_module (list))
          str_of (fn [a] (erlang/atom_to_binary a :utf8))]
      (is (String/starts_with? (str_of fm) "Elixir.BeamLisp.Ns.Fn.M")
          "a fresh body module is Ns.Fn.M<n>")
      (is (not= fm fm2) "each call names a different immutable body module"))
    (let [clause (add-clause p)
          attached (erlang/apply p :attach_body_module
                     (list (list (t4 :fixed 2 :add clause)) :Elixir.Body.Vec))]
      (is (erlang/=:= attached (list (t5 :fixed 2 :add clause :Elixir.Body.Vec)))
          "the body module is appended as the fifth field"))
    (is (erlang/=:= (erlang/apply p :fixed_variadic
                       (list (list (t4 :fixed 1 "f" :x)
                                   (t4 :variadic 2 "g" :x)
                                   :junk)))
                    (tuple (list (t2 1 "f")) (t2 2 "g")))
        "only four-field def tuples contribute, in source order")))

(deftest body-module-grouping-and-shim-clauses-match-the-source
  (let [p (compile-probe)
        ns_defs (fixture-ns-defs p)
        shims (erlang/apply p :shim_clauses (list ns_defs))
        first-shim (first shims)]
    (is (erlang/=:= (erlang/apply p :body_modules (list ns_defs))
                    (BeamLisp.Emit/body_modules ns_defs)))
    (is (erlang/=:= shims (BeamLisp.Emit/shim_clauses ns_defs))
        "shim clauses are the same list of forwarding clauses the live module builds")
    (is (= 1 (count shims)))
    (is (erlang/=:= (:fname first-shim) :add))
    (is (= 2 (count (:params first-shim))))
    (is (erlang/=:= (get-in first-shim [:body :mod]) :Elixir.Body.Vec)
        "the shim forwards into the body module the def tuple names")))

; ── differential: probe vs the live module ──────────────────────────────────

(deftest the-pinned-abi-answers-the-live-module-question-for-question
  (let [p (compile-probe)
        zero-clause-p (zero-clause p)
        corpus
        (list
          (list :module_for (list "foo.bar-baz"))
          (list :module_for (list "a"))
          (list :attach_body_module
                (list (list (t4 :fixed 1 "f" :x)) :Elixir.Body))
          (list :fixed_variadic
                (list (list (t4 :fixed 1 "f" :x)
                            (t4 :variadic 2 "g" :x))))
          (list :lit (list 42))
          (list :lit (list nil))
          (list :var (list "x"))
          (list :remote (list :erlang :+ (list)))
          (list :sequence (list (list 1 2)))
          (list :closure (list {:op :lit :val 1 :ann {}}))
          (list :function_clause (list :f {:op :lit :val 1 :ann {}}))
          (list :function_clause (list :f {:op :lit :val 1 :ann {}} (list (pvar-named "a"))))
          (list :descriptor (list :Elixir.W (list zero-clause-p) (list (t2 :zero 0)) (list) {}))
          (list :descriptor (list :Elixir.W (list zero-clause-p) (list (t2 :zero 0))))
          (list :descriptor (list :Elixir.W (list zero-clause-p) (list (t2 :zero 0)) (list)))
          (list :descriptor (list :Elixir.W (list zero-clause-p) (list (list :zero 0)) (list) {}))
          (list :descriptor
                (list :Elixir.W (list zero-clause-p)
                      (list (BeamLisp.Vector/new (list :zero 0))) (list) {}))
          (list :descriptor_for (list :Elixir.Y (list (add-clause p))))
          (list :descriptor_for (list :Elixir.Y (list (add-clause p)) (list)))
          (list :descriptor_for (list :Elixir.Y (list (add-clause p)) (list) {}))
          (list :descriptor_for (list :Elixir.Y (list (add-clause p) (add-clause p))))
          (list :fn_value (list :erlang (list (t2 1 :length)) nil))
          (list :fn_value (list :erlang (list (t2 1 :length) (t2 2 :max)) (t2 3 :max)))
          (list :fn_value (list :erlang (list) nil)))]
    (doseq [q corpus]
      (is (erlang/=:= (answer p (first q) (second q))
                      (answer live (first q) (second q)))
          (str "same answer for " (first q) " " (pr-str (second q)))))))

(deftest refusals-carry-the-same-class-and-message
  (let [p (compile-probe)]
    ; The ABI names these errors itself, so the message is part of the contract.
    (is (erlang/=:= (answer p :descriptor (list :Elixir.W (list) (list (list :f 9)) (list) {}))
                    (answer live :descriptor (list :Elixir.W (list) (list (list :f 9)) (list) {})))
        "an export with no matching clause refuses identically")
    (is (erlang/=:= (answer p :compile_descriptor (list :not-a-descriptor))
                    (answer live :compile_descriptor (list :not-a-descriptor)))
        "the Core backend's own refusal is not swallowed")
    (is (erlang/=:= (answer p :load_binary! (list (t2 :Elixir.NoSuch 0)))
                    (answer live :load_binary! (list (t2 :Elixir.NoSuch 0))))
        "a beam that is not a binary refuses with the same class and message")
    ; `clause_arity` is reached through `shim_clauses`; the Class is named by
    ; the ABI, the message printed with limit 4.
    (let [bad (maps/from_list
                (list (t2 "f" (list (t5 :fixed 1 :f :not-a-clause :Elixir.Body)))))]
      (is (= (raise-class p :shim_clauses (list bad)) :Elixir.ArgumentError))
      (is (erlang/=:= (answer p :shim_clauses (list bad))
                      (answer live :shim_clauses (list bad)))
          "the ArgumentError message (limit 4) is identical"))
    ; A shape `canonical_pair/1` does not accept is a FunctionClauseError on
    ; BOTH sides; the message names the private helper's module, so the CLASS
    ; is the contract here.
    (let [bad-export (t3 1 2 3)]
      (is (= (raise-class p :descriptor (list :Elixir.W (list) (list bad-export) (list) {}))
             :Elixir.FunctionClauseError))
      (is (= (raise-class live :descriptor (list :Elixir.W (list) (list bad-export) (list) {}))
             :Elixir.FunctionClauseError)))
    ; Def-list noise that is not a four-field tuple is SKIPPED by both sides,
    ; not an error — the Elixir comprehension filtered it out, so the port must.
    (is (erlang/=:= (answer p :fixed_variadic (list (list 5)))
                    (answer live :fixed_variadic (list (list 5))))
        "a non-tuple def entry is skipped identically")
    ; `Emit.module_for/1` hands a non-binary to `String.split/3`; the class is
    ; the same on both sides.
    (is (= (raise-class p :module_for (list 5)) :Elixir.FunctionClauseError))))

; ── differential: emitted bytes ──────────────────────────────────────────────

(deftest the-pinned-emitter-produces-the-same-descriptor-and-beams
  (let [p (compile-probe)
        pd (descriptor-of p)
        ld (descriptor-of live)]
    (is (erlang/=:= pd ld)
        "the two modules build the SAME descriptor term from the same fixture")
    (let [pb (erlang/apply p :compile_descriptor (list pd))
          lb (erlang/apply live :compile_descriptor (list ld))]
      (is (erlang/=:= (elem pb 0) (elem lb 0)) "the same module name")
      (is (erlang/=:= (elem pb 1) (elem lb 1))
          "byte-identical beams — the parity proof, not a re-encode")
      (is (erlang/is_binary (elem pb 1)))
      (is (erlang/=:= (erlang/apply p :load_binary! (list pb))
                      (erlang/apply live :load_binary! (list lb)))
          "the 1-arity default filename publishes the same module"))))

(deftest literal-bodies-and-attributes-emit-the-same-bytes
  ; The real emitter passes attributes and an `:ann` file, and a body can hold
  ; any Core literal — a bl vector, a raw map, an Erlang tuple. None of them may
  ; diverge on the way to Core.
  (let [p (compile-probe)
        data-clause (fn [m]
                      (erlang/apply m :function_clause
                        (list :data
                              (erlang/apply m :sequence
                                (list
                                  (list (erlang/apply m :lit (list (BeamLisp.Vector/new (list 1 2))))
                                        (erlang/apply m :lit (list {:a 1}))
                                        (erlang/apply m :lit (list (t2 :ok 1)))))))))
        build (fn [m]
                (erlang/apply m :descriptor_for
                  (list :Elixir.EmitParity.Full
                        (list (add-clause m) (data-clause m))
                        (list (t2 :bl_source_hash "deadbeef")
                              (t2 :bl_compiler_key "cafef00d"))
                        {:file "fixture.bl"})))
        pd (build p)
        ld (build live)]
    (is (erlang/=:= pd ld) "attributes and :ann survive identically")
    (let [pb (erlang/apply p :compile_descriptor (list pd))
          lb (erlang/apply live :compile_descriptor (list ld))]
      (is (erlang/=:= (elem pb 1) (elem lb 1))
          "literal bodies and attributes do not perturb a single byte"))))

(deftest emitted-bytes-are-deterministic
  (let [p (compile-probe)
        b1 (erlang/apply p :compile_descriptor (list (descriptor-of p)))
        b2 (erlang/apply p :compile_descriptor (list (descriptor-of p)))]
    (is (erlang/=:= b1 b2)
        "the differential above is only meaningful because emission is a
         function of the descriptor alone")))

(deftest the-pinned-abi-emits-and-loads-a-working-module
  (let [p (compile-probe)
        beam (erlang/apply p :compile_descriptor (list (descriptor-of p)))
        mod (erlang/apply p :load_binary! (list beam))]
    (is (erlang/=:= mod :Elixir.EmitParity.Beam))
    (is (= 5 (erlang/apply mod :add (list 2 3)))
        "the pinned ABI drove a module end to end: descriptor → Core → beam → code")
    (is (zero? (erlang/apply mod :zero (list))))))

; ── the pinned beam stands alone, and drives a real shim/body split ─────────

(deftest the-pinned-beam-does-not-lean-on-the-namespace-shim
  (let [res (compile-probe*)
        mod (elem res 0)
        path (elem res 1)]
    ; Drop the namespace shim the compiler built beside the pinned beam AND the
    ; in-memory probe, then load the PINNED BEAM alone. A sibling call only
    ; resolves if the compiler's link was re-pointed at the pinned atom, AND a
    ; sibling passed as a VALUE would not — which is why none is.
    (code/purge :Elixir.BeamLisp.Ns.Host.Emit)
    (code/delete :Elixir.BeamLisp.Ns.Host.Emit)
    (code/purge mod)
    (code/delete mod)
    (is (= :module (elem (code/load_binary mod (erlang/binary_to_list path) (File/read! path)) 0)))
    (let [lit1 (erlang/apply mod :lit (list 1))
          clause (erlang/apply mod :function_clause
                   (list :add
                         (erlang/apply mod :remote
                           (list :erlang :+
                                 (list (erlang/apply mod :var (list "arg0"))
                                       (erlang/apply mod :var (list "arg1")))))
                         (list (pvar-named "arg0") (pvar-named "arg1"))))
          ns_defs (maps/from_list
                    (list (t2 "add" (list (t5 :fixed 2 :add clause :Elixir.EmitSolo.Body)))))
          beam (erlang/apply mod :compile_descriptor
                 (list (erlang/apply mod :descriptor_for (list :Elixir.EmitSolo.Beam (list clause)))))
          solo (erlang/apply mod :load_binary! (list beam))]
      (is (= 7 (erlang/apply solo :add (list 3 4)))
          "sibling calls resolve inside the pinned beam with no Ns shim loaded")
      ; EVERY other entry point must also answer with no shim present.
      (is (erlang/=:= (erlang/apply mod :module_for (list "a.b")) :Elixir.BeamLisp.Ns.A.B))
      (is (erlang/=:= (elem (erlang/apply mod :fixed_variadic
                            (list (list (t4 :fixed 2 :add clause))))
                         0)
                      (list (t2 2 :add))))
      (is (erlang/=:= (count (erlang/apply mod :shim_clauses (list ns_defs))) 1))
      (is (erlang/=:= (count (erlang/apply mod :body_modules (list ns_defs))) 1))
      (is (erlang/=:= (erlang/apply mod :closure (list lit1))
                      {:op :fn :clauses (list {:pats (list) :guard nil :body lit1}) :ann {}}))
      (is (erlang/=:= (count (erlang/apply mod :attach_body_module
                            (list (list (t4 :fixed 1 :f lit1)) :Elixir.BeamLisp.Body))) 1))
      (is (erlang/=:= (erlang/apply mod :sequence (list (list lit1)))
                      {:op :do :stmts (list lit1) :ann {}}))
      (is (erlang/is_function
            (erlang/apply mod :fn_value (list :Elixir.EmitSolo.Beam (list (t2 2 :add)) nil))))
      (is (erlang/is_atom (erlang/apply mod :fresh_body_module (list)))))))

(deftest the-pinned-abi-drives-a-real-shim-and-body-split
  (let [p (compile-probe)
        clause (add-clause p)
        body-mod :Elixir.EmitSplit.Body
        shim-mod :Elixir.EmitSplit.Shim
        new_defs (list (t4 :fixed 2 :add clause))
        ns_defs (maps/from_list
                  (list (t2 "add" (erlang/apply p :attach_body_module (list new_defs body-mod)))))
        body-descs (erlang/apply p :body_modules (list ns_defs))
        shim-clauses (erlang/apply p :shim_clauses (list ns_defs))]
    (is (erlang/=:= (count body-descs) 1))
    (is (contains? body-descs body-mod))
    (let [body-beam (erlang/apply p :compile_descriptor
                      (list (erlang/apply p :descriptor_for
                              (list body-mod (get body-descs body-mod)))))
          shim-beam (erlang/apply p :compile_descriptor
                      (list (erlang/apply p :descriptor_for (list shim-mod shim-clauses))))]
      (erlang/apply p :load_binary! (list body-beam "emit_split"))
      (erlang/apply p :load_binary! (list shim-beam "emit_split"))
      (is (= 5 (erlang/apply shim-mod :add (list 2 3)))
          "the shim clause forwards into the immutable body module")
      ; `fixed_variadic`/`fn_value` over the same defs give the interned value
      ; Link.defvar installs: a bare capture when there is one fixed arity.
      (let [fv (erlang/apply p :fixed_variadic (list new_defs))
            value (erlang/apply p :fn_value (list shim-mod (elem fv 0) (elem fv 1)))]
        (is (= 9 (erlang/apply value (list 4 5)))
            "fn_value captures the shim's arity as a callable")))))


(deftest once-seeded-the-live-module-is-the-floor-beam
  ; Post-integration guard. While `priv/bootstrap/seed/Elixir.BeamLisp.Emit.beam`
  ; is absent the port is still a candidate and the differential above is the
  ; gate. Once the floor carries it, the live module MUST be those bytes — not a
  ; leftover `lib/*.ex` artifact — and the probe compiled from `priv/host/emit.bl`
  ; is then compared against the committed beam in every test above.
  (let [seed (Path/join (BeamLisp/cwd) "priv/bootstrap/seed/Elixir.BeamLisp.Emit.beam")]
    (if (File/exists? seed)
      (let [installed (unicode/characters_to_binary (code/which live))]
        (is (some? installed) "the module is loaded from a beam")
        (is (= (File/read! seed) (File/read! installed))
            "the live module's bytes ARE the committed seed's bytes"))
      (is true "the emit floor is not seeded yet"))))

(deftest the-pinned-source-compiles-reproducibly
  (let [b1 (File/read! (elem (compile-probe*) 1))
        b2 (File/read! (elem (compile-probe*) 1))]
    (is (erlang/=:= b1 b2)
        "the same source is the same beam, so the floor's `bl_source_hash` can
         judge what it carries")))
