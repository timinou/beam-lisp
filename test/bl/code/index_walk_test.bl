; test/bl/code/index_walk_test.bl — the tree walk survives a file it cannot read.
; Run: bl test test/bl/code/index_walk_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
; 1. A tree with ONE unreadable file still indexes every other source, and the
;    index says which file it left out AND why. A read failure is a fact about
;    one FILE, not a verdict on the tree: before this, `key-of` read every
;    source to hash it, so one permission bit took down `bl search`, `bl ask`
;    and the MCP mount for the whole checkout.
; 2. The skip reaches the frames the pane renders — the `:ready` frame's
;    `:stats :skipped` — so the pane shows it without re-deriving it.
; 3. The corpus key names the READABLE corpus, so the unreadable file is not a
;    new corpus on every run.
;
; A skipped file is a WARNING, not an ERROR (see `code.index/ensure-tree`):
; these assert `:phase :ready`, never `:error`.

(ns code.index-walk.test
  (:require [code.index] [code.semantic] [codebase]))

;; A cache test owns its cache: without this the suite writes its stores into
;; whatever store the CHECKOUT has, sharing state with the developer's own runs.
(def store-root
  (str (System/tmp_dir!) "/index_walk_" (erlang/unique_integer (list :positive))))
(System/put_env "BLANALYSIS_DIR" store-root)

(def tree (str store-root "/tree"))
(File/mkdir_p! tree)
(File/write! (str tree "/env.bl") "{:name \"walk\" :paths [\".\"]}\n")
(File/write! (str tree "/good.bl") "(ns walk.good)\n(defn defserver-here [x] (+ x 1))\n")
(File/write! (str tree "/second.bl") "(ns walk.second)\n(defn other [x] (* x 2))\n")

(def bad (str tree "/unreadable.bl"))
(File/write! bad "(ns walk.bad)\n(defn nope [x] x)\n")
(File/chmod bad 0)

(defn- skips [idx] (to-list (:skipped (:stats idx))))

(defn- ready-frame
  "The last `:ready` frame a build reported — what the pane renders."
  [frames]
  (last (filterv (fn [f] (= :ready (:phase f))) (to-list frames))))

(deftest a-tree-with-an-unreadable-file-indexes-the-rest
  (let [frames (atom [])
        idx (code.index/ensure-tree tree
                                    {:workers 1
                                     :on-progress (fn [m] (swap! frames conj m))})]
    (is (some? idx) "the tree still indexes")
    (let [s (:stats idx)]
      (is (= 1 (count (skips idx))) "exactly one file was left out")
      (is (includes? (first (skips idx)) bad) "the skip names the PATH")
      (is (includes? (first (skips idx)) "permission") "and the reason the read failed")
      (is (pos? (:files s)) "the readable corpus is indexed")
      (is (pos? (:functions s)) "with its functions"))
    (is (some (fn [r] (and (= (str tree "/good.bl") (:file r)) (pos? (:functions r))))
              (to-list (:per-source idx)))
        "the readable source's facts are in the index, not lost with the bad one")
    (let [ready (ready-frame @frames)]
      (is (some? ready) "the build reported a ready frame, not an error")
      (is (= :ready (:phase ready)) "a skipped file is a WARNING, never a failed build")
      (is (includes? (first (to-list (:skipped (:stats ready)))) bad)
          "and the frame's stats carry the skipped path — what the pane reads"))))

(deftest a-skip-says-why-the-file-could-not-be-read
  ; Three ways a source is not there: a permission bit, a path that moved, and a
  ; directory where a file was expected. The reason must separate them — "skipped
  ; a file" with no why is not something a reader can act on.
  (let [dir (str store-root "/kinds")
        _ (File/mkdir_p! (str dir "/adir.bl"))
        good (str dir "/good.bl")
        _ (File/write! good "(ns kinds.good)\n(defn ok [x] x)\n")
        denied (str dir "/denied.bl")
        _ (File/write! denied "(ns kinds.denied)\n(defn d [x] x)\n")
        _ (File/chmod denied 0)
        idx (code.index/ensure code.index/sigs
                               [["kinds.good" good]
                                ["kinds.gone" (str dir "/gone.bl")]
                                ["kinds.dir" (str dir "/adir.bl")]
                                ["kinds.denied" denied]]
                               {:root dir :workers 1})
        skips (to-list (:skipped (:stats idx)))]
    (is (= 3 (count skips)) "every unreadable file is reported")
    (is (some (fn [s] (includes? s "no such file")) skips) "a moved path says so")
    (is (some (fn [s] (includes? s "directory")) skips) "a directory says so")
    (is (some (fn [s] (includes? s "permission")) skips) "a permission bit says so")))

(deftest the-key-names-the-readable-corpus
  (let [first-run (code.index/ensure-tree tree {:workers 1})
        second-run (code.index/ensure-tree tree {:workers 1})]
    (is (= (:key first-run) (:key second-run)) "the same readable corpus, the same key")
    (is (= (:sources first-run) (:sources second-run)) "and the same sources")
    (is (not (some (fn [e] (includes? (str (get e 1)) "unreadable")) (:sources first-run)))
        "the unreadable file is not a source the index names")))
