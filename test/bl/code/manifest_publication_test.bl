(ns code.manifest-publication-test (:require [codebase :as cache]))

(deftest manifest-publication-creates-its-directory-and-cleans-failed-writes
 (let [directory (Path/join (System/tmp_dir!) (str "bl-manifest-publish-" (erlang/unique_integer (list :positive))))
       before (System/get_env "BL_CACHE_DIR")]
  (try
   (System/put_env "BL_CACHE_DIR" directory)
   (is (not (File/exists? directory)))
   (let [value {:complete [1 2 3]} published (cache/write-manifest! nil "fresh" value)]
    (is (= {:ok (cache/manifest-path nil "fresh")} published))
    (is (= {:value value} (cache/read-manifest nil "fresh"))))
   (let [destination (cache/manifest-path nil "blocked")]
    (File/mkdir! destination)
    (is (string? (:error (cache/write-manifest! nil "blocked" {:complete true}))))
    (is (File/dir? destination))
    (is (= [] (vec (Path/wildcard (str directory "/*.tmp-*"))))))
   (finally
    (if before (System/put_env "BL_CACHE_DIR" before) (System/delete_env "BL_CACHE_DIR"))
    (File/rm_rf! directory)))))
