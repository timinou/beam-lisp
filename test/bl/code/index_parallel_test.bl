; test/bl/code/index_parallel_test.bl — indexing a corpus with several workers.
; Run: mix bl test test/bl/code/index_parallel_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
; 1. N workers produce the SAME index as one. The point is speed; if the facts,
;    the counts, the reporting or the ORDER differ, it is a different index
;    rather than a faster one — and two runs over one corpus must agree, which
;    is what makes them comparable at all.
; 2. The worker count is BOUNDED: never more than the files, never fewer than
;    one, never more than the ceiling. An unbounded fan-out over a thousand
;    files is a fork bomb with good intentions.
; 3. A file that cannot be read is REPORTED as skipped under either topology.
;    Resiliance is not a property of the serial path.
;
; The store is this run's own (a fresh `BLANALYSIS_DIR`), so a HIT is about
; THIS suite rather than about whoever ran it last.

(ns code.index-parallel.test
  (:require [code.semantic] [datom]))

(def store-root
  (str (System/tmp_dir!) "/index_parallel_" (erlang/unique_integer (list :positive))))
(System/put_env "BLANALYSIS_DIR" store-root)

(def src-dir (str store-root "/src"))
(File/mkdir_p src-dir)

; Five files of different sizes and function counts: a pool that got the right
; answer by accident of every file being the same size would still be wrong
; here, and the band each file lands in has to survive the reordering.
(defn- write-src! [name body] (File/write! (str src-dir "/" name) body))

(write-src! "a.bl" "(ns fix.a)\n(defn alpha [x] (beta x))\n(defn beta [y] (* y y))\n")
(write-src! "b.bl" (str "(ns fix.b)\n"
                       "(defn gamma [x] (delta x))\n"
                       "(defn delta [y] (+ y 1))\n"
                       "(defn epsilon [] 7)\n"))
(write-src! "c.bl" "(ns fix.c)\n(defn zeta [s] (count s))\n")
(write-src! "d.bl" (str "(ns fix.d)\n"
                       "(defn eta [n] (theta n))\n"
                       "(defn theta [n] (iota n))\n"
                       "(defn iota [n] (* n 3))\n"))
(write-src! "e.bl" "(ns fix.e)\n(defn kappa [] :ok)\n")

(def pairs
  (mapv (fn [p] [(code.semantic/ns-of-file p) p])
        (sort (to-list (Path/wildcard (str src-dir "/**/*.bl"))))))

(defn- stored-count [conn]
  (count (into [] (datom/q '[:find ?e ?a ?v :where [?e ?a ?v]] (datom/db conn)))))

(deftest the-worker-count-is-bounded
  (is (= 1 (code.semantic/workers-for 1 {})))
  (is (= 4 (code.semantic/workers-for 100 {}))
      "the default is a ceiling, not one worker per file")
  (is (= 3 (code.semantic/workers-for 100 {:workers 3})) "an explicit ask is honoured")
  (is (= 1 (code.semantic/workers-for 100 {:workers 0}))
      "a nonsense ask is serial, never zero workers — zero would index nothing")
  (is (= 5 (code.semantic/workers-for 5 {:workers 9})) "never more workers than files")
  (is (= 1 (code.semantic/workers-for 0 {})) "and no files is still one worker"))
(deftest four-workers-index-the-same-thing-as-one
  (let [serial-conn (code.semantic/connect)
        parallel-conn (code.semantic/connect)
        serial (code.semantic/index! serial-conn pairs {:root src-dir :workers 1})
        parallel (code.semantic/index! parallel-conn pairs {:root src-dir :workers 4})]
    (is (= (count pairs) (count serial)) "every source gets a result")
    (is (= serial parallel)
        "the same files, in the same order, with the same counts")
    (is (= (mapv (fn [r] (:file r)) serial) (mapv (fn [r] (:file r)) parallel))
        "results come back in input order, so an index is reproducible")
    (is (= (stored-count serial-conn) (stored-count parallel-conn))
        "and the same facts land in the conn: no band duplicated, none lost")
    (is (pos? (stored-count parallel-conn)) "with facts in it at all")))

(deftest an-unreadable-file-is-skipped-under-either-topology
  (let [missing (str src-dir "/gone.bl")
        broken (into pairs [["fix.gone" missing]])
        serial (code.semantic/index! (code.semantic/connect) broken {:root src-dir :workers 1})
        parallel (code.semantic/index! (code.semantic/connect) broken {:root src-dir :workers 4})]
    (is (= serial parallel) "the skipped file does not depend on who noticed it")
    (is (= 1 (count (filterv (fn [r] (:skipped r)) parallel))))
    (is (= missing (:file (first (filterv (fn [r] (:skipped r)) parallel)))))
    (is (= (inc (count pairs)) (count parallel)) "every source still gets a result")
    (is (every? (fn [r] (pos? (:functions r)))
                (filterv (fn [r] (not (:skipped r))) parallel))
        "and the readable ones are indexed, not abandoned with the unreadable one")))
