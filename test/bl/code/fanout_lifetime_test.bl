(ns code.fanout-lifetime-test (:require [code.semantic]))
(deftest worker-death-is-a-result-and-does-not-strand-the-next-file
 (let [fan-out (BeamLisp.Env/fetch_exact! "code.semantic" "fan-out")
       marker (erlang/make_ref) before (System/monotonic_time :millisecond)]
  (erlang/send (erlang/self) [:unrelated marker])
  (let [results (fan-out 2 (fn [value]
                            (if (= (first value) :broken) (erlang/exit :worker-broken) {:value value}))
                         [[:broken "broken.bl"] [:good "good.bl"] [:later "later.bl"]])]
   (is (= 3 (count results)))
   (is (String/contains? (:skipped (first results)) "worker-broken"))
   (is (= {:value [:good "good.bl"]} (nth results 1)))
   (is (= {:value [:later "later.bl"]} (nth results 2)))
   (is (< (- (System/monotonic_time :millisecond) before) 10000)))
  (is (= marker (receive [:unrelated value] value (after 100 :missing))))))
