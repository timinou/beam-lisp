; columns_test.bl — the column matrix: a derivation remembered in a store.
;
; Each test pins ONE invariant over `codebase/analyze-cached`'s columns
; (`{:ident :schema :version :fill}`), which is how every derived fact in this
; tree is remembered: the embedding column (code.semantic), and the reference
; sites a rename reads (FUP-089).
;
; The axis these tests exist for is REPETITION. Every one of them runs the same
; call TWO or THREE times and asserts what each run reported, because the
; failure mode of a remembered derivation is not a wrong answer — it is the
; SAME answer reached by redoing the work, forever, invisibly.
;
; `:fill` counts its own invocations, so "it was cached" is an observable
; (0 fills) and not a timing impression. Same discipline as
; `build_plan_test.bl` ("every srchash is asked exactly once").

(ns code.columns.test
  (:require [codebase] [datom]))

(def SCHEMA
  [{:db/ident :probe/n :db/valueType :db.type/string :db/index true}])

; how many times the fill actually ran, across one case
(def fills (atom 0))

(defn- fill [db src]
  (swap! fills inc)
  [{:db/id 800000 :probe/n "x"}])

(defn- cols [version]
  [{:ident :probe/x :schema SCHEMA :version version :fill fill}])

(def SRC "(ns fresh.one)\n(defn f [x] x)\n")

(defn- fresh-root
  "A root per case, so no case can be answered by another's store."
  []
  (let [d (str "/tmp/bl-coltest-" (erlang/unique_integer (to-list [:positive])))]
    (File/mkdir_p! d)
    d))

(defn- on-conn
  "One call against `root`, returning ONLY observables: did it hit a store,
   and what did each column report."
  [root src version]
  (reset! fills 0)
  (let [r (codebase/analyze-cached {} "fresh.one" src {:columns (cols version) :root root})]
    {:hit (:hit r) :cols (:columns r) :fills (deref fills)}))

; ── invariant: a cold store fills every column once, then is served ─────────

(deftest a-cold-store-fills-once-and-then-serves
  (let [root (fresh-root)
        a (on-conn root SRC "v1")
        b (on-conn root SRC "v1")
        c (on-conn root SRC "v1")]
    (is (= false (:hit a)))
    (is (= :filled (get (:cols a) :probe/x)))
    (is (= 1 (:fills a)) "the fill runs once, on the miss")
    (is (= {:hit true :cols {:probe/x :cached} :fills 0} b)
        "the second run reopens the store and derives NOTHING")
    (is (= b c))))

; ── invariant: a column ADDED to a store that already exists is still
;    remembered. This is the normal way a column arrives — every column added
;    to a codebase that already has stores takes this path — and a fill here
;    that is not made durable re-runs on every subsequent call, forever. ────

(deftest a-fill-on-the-hit-path-survives-the-next-run
  (let [root (fresh-root)
        _ (on-conn root SRC "v0")            ; miss: creates the store, marker v0
        b (on-conn root SRC "v1")            ; hit: marker v0 != v1 -> FILL HERE
        c (on-conn root SRC "v1")]           ; hit: the marker must already be v1
    (is (= true (:hit b)))
    (is (= :filled (get (:cols b) :probe/x)) "a new version fills")
    (is (= 1 (:fills b)))
    (is (= {:hit true :cols {:probe/x :cached} :fills 0} c)
        "and the fill it just did must be DURABLE — not repeated on the next run")))

; ── invariant: a version bump refills once, then is cached ─────────────────

(deftest a-version-bump-refills-once-then-is-cached
  (let [root (fresh-root)
        _ (on-conn root SRC "v1")
        b (on-conn root SRC "v2")
        c (on-conn root SRC "v2")]
    (is (= :filled (get (:cols b) :probe/x)))
    (is (= {:hit true :cols {:probe/x :cached} :fills 0} c))))

; ── invariant: a fill that RAISES must not cost the facts ──────────────────
;    (the analysis is durable before the column is attempted, so a run without
;     a model still caches what it indexed)

(deftest a-raising-fill-still-leaves-the-facts-durable
  (let [root (fresh-root)
        boom (fn [db src] (throw (ex-info "no model" {})))]
    (try
      (codebase/analyze-cached {} "fresh.one" SRC
                               {:columns [{:ident :probe/y :schema SCHEMA
                                           :version "v1" :fill boom}]
                                :root root})
      (catch e nil))
    (let [r (codebase/analyze-cached {} "fresh.one" SRC
                                     {:columns [{:ident :probe/x :schema SCHEMA
                                                 :version "v1" :fill fill}]
                                      :root root})]
      (is (= true (:hit r))
          "the facts written by the first run are reusable even though its column raised"))))
