; test/bl/code/index_manifest_test.bl — the corpus memo: ONE artifact per
; (corpus, model), so a warm run opens no store at all.
; Run: bl test test/bl/code/index_manifest_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
; 1. A cold index leaves ONE memo for the corpus, named by content — and a
;    second run over the same bytes TAKES it: every result says so, and the
;    facts that land in the conn are identical. A memo is the analysis, not a
;    summary of it, which is the only reason it may answer a query.
; 2. An edit is a miss. The key covers every source's hash, the model, and the
;    ORDER (the band of source `i` is `(offset-for i)`), so a changed corpus
;    cannot reach a memo of the old one — and the run writes the new one.
; 3. A memo that cannot be read is a MISS WITH A NAME, never a crash and never
;    a silent wrong answer: the stores answer as they always did, and the
;    reader tells absent from corrupt rather than merging the two.
;
; A warm run's cost is OPENS, not work: one fjall directory per file, ~0.9 s
; each over a 101-file corpus, while all the facts together are 36 MB. That is
; the cost a memo removes, and the reason it exists rather than a faster loop.

(ns code.index-manifest.test
  (:require [code.embed] [code.semantic] [codebase] [datom]))

(def store-root
  (str (System/tmp_dir!) "/index_manifest_" (erlang/unique_integer (list :positive))))
(System/put_env "BLANALYSIS_DIR" store-root)

(def src-dir (str store-root "/src"))
(File/mkdir_p src-dir)

(defn- write-src! [name body] (File/write! (str src-dir "/" name) body))

(write-src! "a.bl" "(ns memo.a)\n(defn alpha [x] (beta x))\n(defn beta [y] (* y y))\n")
(write-src! "b.bl" "(ns memo.b)\n(defn gamma [x] (delta x))\n(defn delta [y] (+ y 1))\n")
(write-src! "c.bl" "(ns memo.c)\n(defn zeta [s] (count s))\n")

(def pairs
  (mapv (fn [p] [(code.semantic/ns-of-file p) p])
        (sort (to-list (Path/wildcard (str src-dir "/**/*.bl"))))))

(defn- memos [] (into [] (to-list (Path/wildcard (str store-root "/manifest.*.term")))))

(defn- stored [conn]
  ; FACTS, not transaction metadata: the two paths commit in a different NUMBER
  ; of transactions (a memo lands in one), and `:db/txInstant` is a clock value
  ; per transaction. What must be identical is the index, not the bookkeeping.
  (into #{} (filterv (fn [row] (not= :db/txInstant (get row 1)))
                     (to-list (datom/q '[:find ?e ?a ?v :where [?e ?a ?v]] (datom/db conn))))))

(defn- index-now! [opts] (code.semantic/index! (code.semantic/connect) pairs opts))

(deftest a-cold-run-leaves-one-memo-and-a-warm-run-takes-it
  (let [cold-conn (code.semantic/connect)
        cold (code.semantic/index! cold-conn pairs {:root src-dir :workers 1})]
    (is (every? (fn [r] (= :indexed (:analysis r))) cold)
        "cold: analyzed, not reopened")
    (is (= 1 (count (memos))) "and the corpus is memorized as ONE artifact")
    (let [memo (first (memos))
          before (File/stat! memo)
          warm-conn (code.semantic/connect)
          warm (code.semantic/index! warm-conn pairs {:root src-dir :workers 4})]
      (is (every? (fn [r] (= :manifest (:analysis r))) warm)
          "the second run takes the memo instead of opening a store per file")
      (is (= (stored cold-conn) (stored warm-conn))
          "and lands the SAME facts: a memo is the analysis, not a summary of it")
      (is (= before (File/stat! memo)) "which it does not rewrite"))))

(deftest an-edited-file-misses-and-rewrites-the-memo
  (let [n (count (memos))]
    (write-src! "c.bl" "(ns memo.c)\n(defn zeta [s] (count s))\n(defn eta [] 3)\n")
    (let [results (index-now! {:root src-dir :workers 4})]
      (is (empty? (filterv (fn [r] (= :manifest (:analysis r))) results))
          "no result may come from the memo of a corpus that no longer exists")
      (is (every? (fn [r] (pos? (:functions r))) results) "every source is still indexed")
      (is (= (inc n) (count (memos))) "and the new corpus gets its own memo"))))

(deftest a-corrupt-memo-falls-back-to-the-stores-not-to-nothing
  (doseq [m (memos)] (File/write! m "not a term at all"))
  (let [conn (code.semantic/connect)
        results (code.semantic/index! conn pairs {:root src-dir :workers 4})]
    (is (empty? (filterv (fn [r] (= :manifest (:analysis r))) results))
        "an unreadable memo is not used")
    (is (every? (fn [r] (pos? (:functions r))) results) "every source still indexed")
    (is (seq (stored conn)) "and the conn has the facts, not an empty index")))

(deftest the-memo-reader-tells-absent-from-corrupt
  (is (= {:absent true} (codebase/read-manifest src-dir "no_such_key"))
      "not there yet is the normal cold path")
  (let [p (codebase/manifest-path src-dir "probe_key")]
    (File/write! p (erlang/term_to_binary {:hello "world"}))
    (is (= {:value {:hello "world"}} (codebase/read-manifest src-dir "probe_key")))
    (File/write! p "not a term")
    (is (some? (:corrupt (codebase/read-manifest src-dir "probe_key")))
        "a file that is there and unreadable says so — the run has to report it,
         not pay for it again in silence")))
