(ns aot-generated-class-inventory-test)

(defn- scratch []
 (str (System/get_env "HOME") "/tmp/bl-class-inventory-" (erlang/unique_integer (list :positive))))
(defn- attribute [attrs key]
 (let [value (Keyword/get attrs key)]
  (if (and (erlang/is_list value) (= 1 (count value))) (first value) value)))
(defn- original [action]
 (try (action) :unexpected-success (catch error (BeamLisp.ExInfo/ex_original error))))

(deftest staged-class-source-emits-exact-schema-without-initializing-a-runtime-class
 (let [dir (scratch) ns "stage.class.inventory.fixture"
       source "(ns stage.class.inventory.fixture) (defrecord Row [id title]) (deftype Cell [id payload])"
       file (str dir "/class.bl") out (str dir "/ebin") token (BeamLisp.Env/capture)
       row (BeamLisp.Record/module_name ns "Row") cell (BeamLisp.Record/module_name ns "Cell")]
  (try
   (File/mkdir_p! dir) (File/write! file source)
   (let [beams (BeamLisp.AOT/compile_source source
                (list (tuple :file file) (tuple :output_dir out) (tuple :stage-sdk? true)))
         rows (filter #(or (= row (elem % 0)) (= cell (elem % 0))) beams)]
    (is (= 2 (count rows)))
    (is (= nil (BeamLisp.Record/info row)))
    (is (= nil (BeamLisp.Record/info cell)))
    (is (= :error (BeamLisp.Env/lookup (tuple ns "->Row"))))
    (is (= false (BeamLisp.Env/loaded_ns? ns)))
    (doseq [entry rows]
     (let [mod (elem entry 0) bytes (File/read! (elem entry 1))
           attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
           metadata (attribute attrs :bl_generated_class)]
      (is (= :generated-class (attribute attrs :bl_aot_artifact_role)))
      (is (= 1 (attribute attrs :bl_generated_class_version)))
      (is (= (crypto/hash :sha256 source) (attribute attrs :bl_unit_source_digest)))
      (is (= (if (= mod row) (tuple 1 ns "Row" :record (list "id" "title"))
                                  (tuple 1 ns "Cell" :deftype (list "id" "payload"))) metadata))))
    (let [inventory (str dir "/sdk-code.term")]
     (is (= (count beams) (BeamLisp.AOT/write_sdk_inventory!
                            dir {file {:modules (mapv #(elem % 0) beams)}} out inventory)))
     (let [entries (:modules (erlang/binary_to_term (File/read! inventory) (list :safe)))]
      (is (= :generated-class (:role (get entries (Atom/to_string row)))))
      (is (= (tuple ns "Row") (:declaration-owner (get entries (Atom/to_string row))))))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf dir)))))

(deftest canonical-class-shaped-literals-never-become-generated-class-artifacts
 (let [dir (scratch) ns "stage.class.literal.fixture" token (BeamLisp.Env/capture)
       source "(ns stage.class.literal.fixture) (def value {:op :module :name :not-a-class :attrs {:bl_generated_class [1]}})"]
  (try
   (let [beams (BeamLisp.AOT/compile_source source (list (tuple :output_dir dir) (tuple :stage-sdk? true)))
         roles (map (fn [entry]
                      (attribute (Keyword/get (elem (elem (beam_lib/chunks (File/read! (elem entry 1))
                                                    (list :attributes)) 1) 1) :attributes)
                                 :bl_aot_artifact_role)) beams)]
    (is (= false (boolean (some #{:generated-class :actor} roles)))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf dir)))))

(deftest builtin-protocol-declarations-and-extensions-remain-deferred-during-staging
 (let [ns "stage.protocol.inventory.fixture"
       source "(ns stage.protocol.inventory.fixture) (defprotocol Display (show [value])) (extend-type :integer Display (show [value] (erlang/error :ran-extension)))"
       unit (BeamLisp.Loader/without_initialization
              (BeamLisp.Env/as_thunk #(BeamLisp.AOT/stage-sdk-unit! source (list))))]
  (is (= 2 (count (Map/get (elem unit 1) ns))))
  (is (= :error (BeamLisp.Env/lookup (tuple ns "Display"))))
  (is (= :error (BeamLisp.Env/lookup (tuple ns "show"))))
  (is (= false (BeamLisp.Env/loaded_ns? ns)))))
