; test/bl/native_test.bl — W8's native stage: keyed by content, claimed, installed.
;
; The stage is bl code, so it is exercised from bl: the same call the build makes
; (`(build/build-native root log)`), on a crate small enough to compile in a
; second and real enough to be a cdylib.
;
; ── what is verified here ──────────────────────────────────────────────────
;
; 1. the key is content-addressed: it moves when a source moves, and it does NOT
;    move when cargo writes `Cargo.lock` into the crate — measured, and the bug
;    this file found. `Cargo.lock` sat in the key's input set unconditionally, so
;    the first build hashed a set WITHOUT it and every later run hashed a set WITH
;    it: two key directories under the store and an unchanged crate rebuilt
;    (`:built 1 :cached 0`, observed). A lock naming only the crate is a function
;    of the manifest and carries nothing, so it is no longer an input.
; 2. a crate is built by cargo under a CLAIM, and its cdylib is installed at
;    `priv/native/<crate>.so` — the path `BeamLisp.Native` loads from.
; 3. an unchanged crate is NOT rebuilt: the second and third runs find it.
;
; Run: bl test test/bl/native_test.bl

(ns test.native
  (:require [build :as b] [store :as st] [vm.native :as n]))

(def root "/tmp/beam_lisp_native_stage")
(def crate (str root "/native/tiny"))

(defn setup! []
  (File/rm_rf! root)
  ; The native store is CONTENT-addressed and shared, so a previous run's crate
  ; would make this one a cache hit — which is the behaviour, not a bug, and
  ; exactly what a test must control for. (Learned by running it twice.)
  (File/rm_rf! (str (Path/dirname (st/root)) "/native"))
  (File/mkdir_p! (str crate "/src"))
  (File/write! (str crate "/Cargo.toml")
               (str "[package]\nname = \"tiny\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
                    "\n[lib]\ncrate-type = [\"cdylib\"]\n"))
  (File/write! (str crate "/src/lib.rs")
               ; `#[no_mangle] extern "C"` so the symbol REACHES the cdylib.
               ; A plain `pub fn` in a cdylib crate is mangled and dropped, so
               ; the linker emits identical bytes whatever the body says —
               ; measured: two different sources, one md5. Tests that change the
               ; source to provoke a rebuild depend on this actually working.
               "#[no_mangle]\npub extern \"C\" fn tiny_answer() -> i32 { 42 }\n"))

(defn- cargo? [] (some? (System/find_executable "cargo")))

(deftest the-key-is-content
  (setup!)
  (let [k1 (b/native-key crate)]
    (is (= 32 (count k1)))
    (is (= k1 (b/native-key crate)) "the same inputs name the same key")
    (File/write! (str crate "/src/lib.rs") "// a different source\n")
    (is (not= k1 (b/native-key crate))
        "a changed source is a different key: a stale native cache is worse than none")))

(deftest a-generated-lock-does-not-move-the-key
  (setup!)
  (if (cargo?)
    (let [before (b/native-key crate)]
      (is (not (File/regular? (str crate "/Cargo.lock"))) "no lock to begin with")
      (b/build-native root nil)
      (is (File/regular? (str crate "/Cargo.lock")) "cargo wrote one")
      (is (= before (b/native-key crate))
          "a lock naming only this crate decides nothing: the key must not move"))
    (is true "skipped: no cargo on this machine")))

(deftest the-stage-builds-once-then-finds-it
  (setup!)
  (if (cargo?)
    (let [r1 (b/build-native root println)]
      (is (empty? (:errors r1)))
      (is (= 1 (:built r1)) "the crate is built")
      (is (File/exists? (n/project-installed-path root "tiny"))
          "the artefact lands where BeamLisp.Native loads it from")
      (is (= (Path/basename (n/installed-path "tiny"))
             (Path/basename (n/project-installed-path root "tiny")))
          "the build installs the name the loader asks for — one spelling or none")
      (let [r2 (b/build-native root nil)]
        (is (= 0 (:built r2)) "an unchanged crate is not rebuilt")
        (is (= 1 (:cached r2)) "it is found by the key its inputs name"))
      (let [r3 (b/build-native root nil)]
        (is (= 1 (:cached r3)) "and found again — the key is a fixpoint, not a coin")))
    (is true "skipped: no cargo on this machine")))

; ── the contract across the build barrier ─────────────────────────────────
;
; A toolchain source may not require an ordinary one, so `build.bl` cannot
; reach `vm.native` — and the reverse edge is declined rather than forbidden:
; the runtime must not depend on the driver that produces it. One spelling per
; layer, and this is what holds the two together. BUG-070 is the failure it
; prevents: they disagreed in silence, `bl build` installed
; `priv/native/<crate>` while `BeamLisp.Native` asked for
; `priv/native/<crate>.so`, and so every crate was reported "built" and none
; was loadable, on any machine with no stale `.so` from an earlier naming to
; answer in its place.

(deftest the-installer-and-the-loader-agree-on-the-name
  (doseq [c ["tiny" "lazy_memo" "datom_fjall" "wry_webview"]]
    (is (= (b/nif-artifact-name c) (n/artifact-name c))
        (str "the build and the loader spell " c " the same")))
  (is (= (Path/basename (b/nif-artifact-name "tiny"))
         (Path/basename (n/installed-path "tiny")))
      "and the loader's own path ends in it"))


; ── the install invariant, across the barrier ────────────────────────────
;
; BUG-074 was not a wrong path; it was a wrong WRITE. `native-one` copied
; straight over an artefact the running VM had mmap'ed, the kernel dropped the
; mapped pages, the next read came from the NEW file, and a `.got` slot on disk
; is zero — so the next indirect call jumped to address 0.
;
; The rule is therefore behavioural, and it is the same rule in both layers:
; installing an artefact REPLACES the file, it never rewrites it in place. The
; two installers (`build/install-artifact!` and `vm.native/build!`) sit on
; opposite sides of the toolchain barrier and cannot share an implementation,
; so the rule is asserted as a behaviour.
;
; The observable is the inode, and it is a sound one — verified against `stat`
; before being relied on: `cp` over an existing file leaves the inode alone,
; `cp` to a temp then rename gives a new one. An in-place rewrite keeps the
; inode, which is exactly the thing that killed the VM.
;
; Coverage note: this exercises the BUILD's installer. The runtime's is the
; same two-step shape but installs into the live app's priv, which a test
; cannot retarget at a temp root — so it is asserted by inspection here, not
; by execution. Said plainly rather than implied by a green run.

(defn- inode-of
  "The inode of `path`, or nil. `:file.read_file_info` returns
   `{:ok, #file_info{}}`, and inode is element 11 of that record — read off a
   real file and matched against `stat`, not recited from the record layout."
  [path]
  (let [i (erlang/apply :file :read_file_info (list (erlang/binary_to_list path)))]
    (if (= :ok (elem i 0)) (elem (elem i 1) 11) nil)))

(deftest reinstalling-replaces-the-artefact-never-rewrites-it
  (setup!)
  (if (cargo?)
    (let [_ (b/build-native root nil)
          dest (n/project-installed-path root "tiny")
          before (inode-of dest)]
      (is (some? before) "the artefact is installed to begin with")
      ; Genuinely different bytes, not a bumped constant. `{ 42 }` -> `{ 43 }`
      ; compiled to a byte-identical cdylib until `setup!` started emitting the
      ; symbol with `#[no_mangle] extern "C"` — measured: two different sources,
      ; one md5. The installer's skip branch then fired — correctly — and the
      ; file was legitimately untouched. A test that mistook that for a rewrite
      ; would have been green on the wrong thing forever.
      (File/write! (str crate "/src/lib.rs")
                   "#[no_mangle]\npub extern \"C\" fn tiny_answer() -> i32 { 43 }\n")
      (let [r2 (b/build-native root nil)
            after (inode-of dest)]
        (is (some? after) "and still there after a changed crate is reinstalled")
        (is (not= before after)
            (str "a reinstall REPLACES the file (new inode). Inode " before
                 " survived, which means it was written in place — and writing "
                 "a file the VM has mapped is BUG-074."
                 " r2=" (pr-str (select-keys r2 [:built :cached :errors :artifacts]))))))
    (is true "skipped: no cargo on this machine")))

