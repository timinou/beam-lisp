; test/bl/js_macro_build_test.bl — `bl js build` expands a namespace's own
; `defmacro`s (local, imported, variadic, syntax-quote, helper defns).
;
; Fixtures are written to a scratch dir, built with the SAME build `bl js build`
; runs (bl.js/build!), and run under Node. Macros are never emitted as JS.
; Skipped (not failed) when node is not installed.
;
; SUPPORTED: defmacro (any arity, `& rest`, `~@`), local and imported (`:as`);
;   a macro body may call defn/defn- of ITS namespace (those the macros reach,
;   transitively, are defined on the BEAM at build time; no other top-level
;   form — def, side-effect expr — ever runs at build time).
; NOT SUPPORTED (named diagnostic, pinned below): an imported macro whose
;   template names ANOTHER macro of its ns unqualified (the bare name is
;   expanded in the CALLER's ns) — write `ns/base` in the template.
;   A macro helper must be a top-level defn/defn-; a `def`ed fn is not defined.

(ns bl.js.macro-build-test
  (:require [bl.js :as js]
            [bl.util :as u]))

(defn- tmp-dir []
  (let [d (str (or (System/get_env "TMPDIR") (System/tmp_dir!)) "/bl-jsmacro-" (System/unique_integer (u/to-list [:positive])))]
    (File/mkdir_p! d)
    d))

(defn- write-ns! [root ns src]
  (let [p (str root "/src/" (join "/" (split ns ".")) ".bl")]
    (File/mkdir_p! (Path/dirname p))
    (File/write! p src)))

(defn- build+run
  "Build `entry` from fixtures under `root`; node's stdout, or {:error msg}."
  [root entry]
  (try
    (BeamLisp.Env/add_search_path (str root "/src"))
    (js/build! entry {:paths (list (str root "/src")) :out (str root "/out")})
    (let [[o code] (u/to-list (erlang/tuple_to_list
                                (System/cmd "node" (u/to-list [(str root "/out/" entry ".mjs")]))))]
      (if (= 0 code) o {:error (str "node: " o)}))
    (catch e {:error (ex-message e)})))

(defn- node? [] (some? (System/find_executable "node")))

(deftest local-imported-and-variadic-macros
  (if-not (node?)
    (is true "node not installed: skipped")
    (let [root (tmp-dir)]
      (write-ns! root "mjm1.m" "(ns mjm1.m)\n(defmacro twice [x] `(do ~x ~x))\n(defmacro unless2 [c & body] `(if ~c nil (do ~@body)))\n")
      (write-ns! root "mjm1.main"
        "(ns mjm1.main (:require [mjm1.m :as m]))\n(defmacro dbl [x] `(* 2 ~x))\n(println (dbl 21))\n(m/twice (println \"hi\"))\n(println (m/unless2 false 1 2))\n")
      (is (= "42\nhi\nhi\n2\n" (build+run root "mjm1.main")))
      ; macros are compile-time only: no JS function for them
      (let [m (File/read! (str root "/out/mjm1.m.mjs"))]
        (is (not (contains? (set (split m " ")) "d_twice")) "macro not emitted"))
      (File/rm_rf! root))))

(deftest qualified-nested-macro-and-helper-defns
  (if-not (node?)
    (is true "node not installed: skipped")
    (let [root (tmp-dir)]
      (write-ns! root "mjm2.m"
        (str "(ns mjm2.m)\n"
             "(defn- wrap [x] (list 'inc (inner x)))\n"
             "(defn inner [x] x)\n"
             "(defmacro viahelper [x] (wrap x))\n"
             "(defmacro base [x] `(inc ~x))\n"
             "(defmacro nested [x] `(mjm2.m/base (mjm2.m/base ~x)))\n"))
      (write-ns! root "mjm2.main"
        "(ns mjm2.main (:require [mjm2.m :as m]))\n(println (m/viahelper 1))\n(println (m/nested 1))\n")
      (is (= "2\n3\n" (build+run root "mjm2.main")))
      (File/rm_rf! root))))

(deftest only-helper-defns-run-at-build-time
  (if-not (node?)
    (is true "node not installed: skipped")
    (let [root (tmp-dir)]
      ; a build-time `def` must NOT evaluate (its var stays the nil placeholder)
      (write-ns! root "mjm3.m"
        "(ns mjm3.m)\n(defn h [x] x)\n(def touched :ran)\n(defmacro m1 [x] (h x))\n")
      (write-ns! root "mjm3.main" "(ns mjm3.main (:require [mjm3.m :as m]))\n(println (m/m1 7))\n")
      (is (= "7\n" (build+run root "mjm3.main")))
      (is (nil? (BeamLisp.Env/fetch! "mjm3.m" "touched")) "top-level def not run by the build")
      (File/rm_rf! root))))

(deftest documented-limits-are-named-errors
  (if-not (node?)
    (is true "node not installed: skipped")
    (let [root (tmp-dir)]
      ; LIMIT 1: unqualified inner macro in an imported template
      (write-ns! root "mjm4.m" "(ns mjm4.m)\n(defmacro base [x] `(inc ~x))\n(defmacro nested [x] `(base (base ~x)))\n")
      (write-ns! root "mjm4.main" "(ns mjm4.main (:require [mjm4.m :as m]))\n(println (m/nested 1))\n")
      (let [r (build+run root "mjm4.main")]
        (is (map? r) (str r))
        (is (contains? (set (split (:error r) " ")) "mjm4.main/base") (str r)))
      ; LIMIT 2: a def'd fn is not a macro helper
      (write-ns! root "mjm5.m" "(ns mjm5.m)\n(def h (fn [x] x))\n(defmacro m1 [x] (h x))\n")
      (write-ns! root "mjm5.main" "(ns mjm5.main (:require [mjm5.m :as m]))\n(println (m/m1 7))\n")
      (is (map? (build+run root "mjm5.main")) "def helper rejected, not silently wrong")
      (File/rm_rf! root))))
