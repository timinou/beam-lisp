; test/bl/interop-test.bl — the Elixir-interop kit in priv/interop.bl.
; Run: mix beam_lisp.test test/bl/interop-test.bl
;
; interop is OPT-IN (unlike sugar), so this suite REQUIRES it — which also
; checks the require path works. Each assertion pins one of the three shape
; crossings the kit exists for: result tuples, keyword lists, the JSON vector
; hazard.

(ns interop.test
  (:require [interop :as x]))

;; ── result tuples ────────────────────────────────────────────────────────────

(deftest result-normalizes-elixir-tuples
  ; an Erlang {:ok, v} / {:error, e} two-tuple → a beam-lisp result map
  (is (= {:ok 42} (x/result (erlang/list_to_tuple (list :ok 42)))))
  (is (= {:error :enoent} (x/result (erlang/list_to_tuple (list :error :enoent)))))
  ; a value already a map passes through (a stub returning a map, unchanged)
  (is (= {:ok 1} (x/result {:ok 1})))
  ; a bare value is a success
  (is (= {:ok 7} (x/result 7))))

(deftest ok?-and-err?-branch-a-result
  (is (= true  (x/ok?  {:ok 1})))
  (is (= false (x/ok?  {:error 1})))
  (is (= true  (x/err? {:error 1})))
  (is (= false (x/err? {:ok 1})))
  ; the real use: guard an Elixir tuple through result first
  (let [r (x/result (erlang/list_to_tuple (list :ok "hi")))]
    (is (x/ok? r))
    (is (= "hi" (:ok r)))))

(deftest unwrap-and-unwrap-or
  (is (= 5 (x/unwrap {:ok 5})))
  (is (= :default (x/unwrap-or {:error :boom} :default)))
  (is (= 9 (x/unwrap-or {:ok 9} :default)))
  (is (thrown? (x/unwrap {:error :boom}))))

;; ── keyword lists ────────────────────────────────────────────────────────────

(deftest ->kwlist-produces-a-keyword-list-elixir-reads
  ; the proof: the output is a real keyword list a Keyword fn reads without
  ; raising (a bl map would raise here)
  (let [kw (x/->kwlist {:timeout 5000 :retries 3})]
    (is (= 5000 (Keyword/get kw :timeout)))
    (is (= 3 (Keyword/get kw :retries)))
    (is (erlang/is_list kw))))

(deftest kwlist->-is-the-inverse
  (let [m (x/kwlist-> (x/->kwlist {:a 1 :b 2}))]
    (is (= 1 (Map/get m :a)))
    (is (= 2 (Map/get m :b)))
    (is (map? m))))

;; ── JSON, and the vector hazard ──────────────────────────────────────────────

(deftest jsonable-makes-a-vector-holed-map-encodable
  ; a [...] literal is a %BeamLisp.Vector{} Jason cannot encode; jsonable
  ; deep-converts it to a list, so the round-trip succeeds
  (let [s (x/->json {"choices" [{"index" 0} {"index" 1}]})
        back (x/json-> s)]
    (is (= 2 (count (Map/get back "choices"))))
    (is (= 0 (get-in (first (Map/get back "choices")) ["index"])))))

(deftest ->json-handles-nested-and-scalars
  (is (= "{\"a\":1}" (x/->json {"a" 1})))
  (is (= "[1,2,3]" (x/->json [1 2 3])))
  ; keywords render as strings, the Jason convention
  (is (= "{\"k\":\"v\"}" (x/->json {"k" :v}))))

(deftest jsonable-passes-foreign-structs-through
  ; a struct with its own Jason.Encoder must reach Jason intact — a Date has
  ; one, so ->json encodes it rather than mangling it into a map
  (let [d (Date/new! 2026 1 15)]
    (is (= "\"2026-01-15\"" (x/->json d)))))

;; ── module atoms ─────────────────────────────────────────────────────────────

(deftest module-names-an-elixir-module-as-a-value
  (is (= :"Elixir.String" (x/module "Elixir.String")))
  ; usable where a module value is needed
  (is (= "HI" ((erlang/make_fun (x/module "Elixir.String") :upcase 1) "hi"))))
