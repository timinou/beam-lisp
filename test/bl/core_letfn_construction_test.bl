(ns core-letfn-construction-test)

; Frozen previous SDK macro body. Compile its inert initializer only, so the
; reference neither replaces Core's current binding nor gains SDK authority.
(def ^:private original-letfn-source "(defmacro letfn\n  \"Bind local functions, MUTUALLY RECURSIVE, then evaluate body:\n\n     (letfn [(even2? [n] (if (= n 0) true  (odd2? (dec n))))\n             (odd2?  [n] (if (= n 0) false (even2? (dec n))))]\n       (even2? 10))\n\n   Why not `let` + `fn`: a `let` binding cannot see its own name, let alone a\n   sibling declared later, so a recursive local written with `let` fails with\n   an unbound-var error at call time. Each fn is therefore bound to a\n   placeholder first and REBOUND to a closure that resolves its siblings\n   through the same scope \u2014 the standard letrec construction.\n\n   Implemented with an atom holding the function table: every body resolves a\n   sibling by NAME at call time, so declaration order does not matter and a\n   cycle of any length works.\"\n  [bindings & body]\n  (assert-macro-args\n    (vector? bindings) \"a vector of (name [args] body) forms\")\n  (let [specs (map (fn [spec]\n                     {:name (first spec)\n                      :argv (second spec)\n                      :body (rest (rest spec))})\n                   bindings)\n        tbl (gensym \"letfn-tbl\")]\n    `(let [~tbl (atom {})]\n       ;; each entry closes over the TABLE, not over its siblings directly,\n       ;; so a call resolves the current definition of any sibling.\n       ~@(map (fn [s]\n                `(swap! ~tbl assoc\n                        ~(keyword (str (get s :name)))\n                        (fn ~(get s :argv)\n                          ;; rebind every sibling name inside the body\n                          (let [~@(mapcat (fn [o]\n                                            [(get o :name)\n                                             `(get (deref ~tbl)\n                                                   ~(keyword (str (get o :name))))])\n                                          specs)]\n                            ~@(get s :body)))))\n              specs)\n       (let [~@(mapcat (fn [s]\n                         [(get s :name)\n                          `(get (deref ~tbl) ~(keyword (str (get s :name))))])\n                       specs)]\n         ~@body))))\n\n")
(defn- original-macro []
 (BeamLisp.Compiler/reset_fresh!) (BeamLisp.Ns.Lower/reset-fresh!)
 (let [form (first (BeamLisp.Reader/read_string original-letfn-source "letfn-reference"))
       compiled (BeamLisp.Compiler/compile form (BeamLisp.Compiler/new_env "core"))
       initializer (BeamLisp.AOT/constructor_initializer! compiled "core" "letfn")]
  (elem (BeamLisp.Ns.Lower/eval-anf :Elixir.BeamLisp.Test.LetfnReference initializer) 1)))
(defn- current-macro [] (elem (BeamLisp.Env/fetch_exact! "core" "letfn") 1))
(defn- form [text] (first (BeamLisp.Reader/read_string text "letfn-regression")))
(defn- expansion [macro form]
 (let [node (BeamLisp.AOT/unmeta form)
       args (erlang/++
             (list (BeamLisp.Ns.Compiler/datum form)
                   (BeamLisp.Ns.Compiler/macro-env (BeamLisp.Compiler/new_env "letfn.fixture")))
             (Enum/map (rest (elem node 1)) (fn [n] (BeamLisp.Ns.Compiler/datum n))))]
  (BeamLisp.Ns.Rt/invoke macro args)))
(defn- normalize-table [node table]
 ;; Rename only the exact table symbol freshly generated by this expansion.
 ;; Preserve every user symbol, collection shape, value and metadata field.
 (cond
  (erlang/=:= node table) (tuple :symbol "LETFN_REFERENCE_TABLE")
  (erlang/is_list node) (Enum/map node (fn [n] (normalize-table n table)))
  (erlang/is_tuple node) (erlang/list_to_tuple
                          (Enum/map (erlang/tuple_to_list node) (fn [n] (normalize-table n table))))
  (erlang/is_map node) (maps/from_list
                        (Enum/map (maps/to_list node)
                          (fn [pair] (tuple (normalize-table (elem pair 0) table)
                                            (normalize-table (elem pair 1) table)))))
  :else node))
(defn- canonical [expanded]
 (normalize-table expanded (BeamLisp.Vector/nth (second expanded) 0)))
(defn- compile-outcome [expanded]
 (try (BeamLisp.Compiler/compile (BeamLisp.Ns.Compiler/data->form expanded)
                                (BeamLisp.Compiler/new_env "letfn.fixture")) :compiled
  (catch error {:type (:__struct__ error) :message (ex-message error)})))

(deftest letfn-preserves-self-forward-and-mutual-recursion
 (is (= 120 (letfn [(fact [n] (if (= n 0) 1 (* n (fact (dec n)))))] (fact 5))))
 (is (= 42 (letfn [(a [n] (b n)) (b [n] (inc n))] (a 41))))
 (is (= true (letfn [(even-local [n] (if (= n 0) true (odd-local (dec n))))
                     (odd-local [n] (if (= n 0) false (even-local (dec n))))] (even-local 8))))
 (is (= false (letfn [(even-local [n] (if (= n 0) true (odd-local (dec n))))
                      (odd-local [n] (if (= n 0) false (even-local (dec n))))] (even-local 7))))
 (is (= 7 (letfn [(first-local [] (second-local)) (second-local [] 7)] (first-local)))))

(deftest letfn-preserves-variadic-shadowing-and-quoted-symbols
 (is (= 12 (letfn [(f [x & xs] (+ x (count xs)))] (f 10 1 2))))
 (is (= 10 (letfn [(f [x & xs] (+ x (count xs)))] (f 10))))
 (is (= 42 (let [f 99] (letfn [(f [x] (let [f x] f))] (f 42)))))
 (is (= '(f quoted) (letfn [(f [x] '(f quoted))] (f 1))))
 (is (= 9 (letfn [(f [x] x)] (let [f (fn [] 9)] (f))))))

(deftest compact-sibling-data-preserves-exact-generated-syntax
 (let [old (original-macro) current (current-macro)]
  (doseq [text ["(letfn [(f [n] (if (= n 0) 1 (* n (f (dec n)))))] (f 5))"
               "(letfn [(a [n] (b n)) (b [n] (inc n))] (a 41))"
               "(letfn [(f [x & xs] (+ x (count xs)))] (f 10 1 2))"
               "(letfn [(f [x] (let [f x] f))] (f 42))"
               "(letfn [(f [x] '(f quoted))] (f 1))"
               "(letfn [(f ([x] x) ([x y] (+ x y)))] (f 1 2))"]]
   (let [node (form text)]
    (is (erlang/=:= (canonical (expansion old node)) (canonical (expansion current node))))))))

(deftest multiple-clause-input-keeps-existing-compiler-outcome
 (let [node (form "(letfn [(f ([x] x) ([x y] (+ x y)))] (f 1 2))")]
  (is (= (compile-outcome (expansion (original-macro) node))
         (compile-outcome (expansion (current-macro) node))))))

(deftest padded-sibling-inputs-preserve-exact-native-expansion
 (let [old (original-macro) current (current-macro)]
  (doseq [size [2 4 6]]
   (let [specs (Enum/map_join (range size) " "
                 (fn [i] (str "(f" i " [x] (do "
                              (Enum/map_join (range 1 17) " " (fn [n] (str n))) " x))")))
         node (form (str "(letfn [" specs "] (f0 1))"))]
    (is (erlang/=:= (canonical (expansion old node)) (canonical (expansion current node))))))))

(deftest actual-sdk-collection-unit-stages-with-current-physical-core
 ;; This is the actual former startup producer, without an alternative macro
 ;; resolver, supplied unit receipt, private scope forgery or increased quota.
 (let [namespace "reload.collection-constructor" path (BeamLisp.Loader/source_path namespace)
       source (BeamLisp.Loader/read_source path)
       out (Path/join (or (System/get_env "TMPDIR") (str (System/get_env "HOME") "/tmp"))
                     (str "letfn-actual-sdk-stage-" (System/unique_integer (list :positive))))
       token (BeamLisp.Env/capture) ready (BeamLisp.Env/loaded_ns? namespace)
       core-md5 (BeamLisp.Ns.Core/module_info :md5)]
  (try
   (let [beams (BeamLisp.AOT/compile_source source
                 (list (tuple :file path) (tuple :output_dir out) (tuple :stage-sdk? true)))]
    (is (= 3 (count beams)))
    (is (BeamLisp.AOT/sdk_unit_compiled? namespace))
    (is (= token (BeamLisp.Env/capture)))
    (is (= ready (BeamLisp.Env/loaded_ns? namespace)))
    (is (= core-md5 (BeamLisp.Ns.Core/module_info :md5))))
   (finally (File/rm_rf out)))))
