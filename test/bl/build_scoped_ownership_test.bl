; build_scoped_ownership_test.bl — WHO a build run owns.
;
; `build/run`'s `:sources` means one of two things, and the difference is
; destructive (see "What a run OWNS" in priv/build/build.bl):
;
;   FULL (`:scope :full`, the default)  the list is the tree's WHOLE source
;                                       inventory, so a recorded path the list
;                                       does not name has been DELETED and its
;                                       facts and beams go with it;
;   SCOPED (`:scope :scoped`)           the list is a SUBSET this run is
;                                       rebuilding, so nothing outside it is
;                                       pruned.
;
; The boot self-heal is the caller that made scoped necessary: the launcher's
; child hands `build/run` `priv/boot/` plus the std prelude and compiles it into
; the SAME ebin the whole tree builds into. Under the old single meaning — every
; run authoritative — that boot-only list read as "every other recorded source
; is gone", so healing a stale tier dropped the library's records and deleted
; its beams.
;
; What this file pins, in the order a caller meets it:
;
;   scoped retains     a boot-only scope leaves the library's fact, manifest
;                      entry and beam exactly where they were;
;   full still prunes  the same boot-only list, authoritative, drops the
;                      library: fact, projection and beam all go;
;   empty is a scope   `[]` scoped retains everything (nothing was rebuilt);
;                      `[]` full replaces the inventory with nothing;
;   mixed state        a scoped rebuild of one source leaves another run's
;                      failure record alone;
;   a typo is not full an unreadable `:scope` is REPORTED and answered
;                      conservatively — it must not delete a build;
;   the launcher says  the boot child's `build_args` carries `:scope :scoped`
;                      and still hands over exactly the boot tier.
;
; The library line is also the "app resource projection" line: the modules an
; `.app` declares are read from the ebin, so a scoped run that deleted an
; unrelated beam would shrink the `.app` of a build it never touched.
;
; Run: bin/bl test test/bl/build_scoped_ownership_test.bl

(ns build-scoped-ownership.test
  (:require [build :as b] [build-log :as blog]))

; A scratch tree unique per file load: two files (or two runs) never share it,
; and a leftover from a killed run cannot be adopted.
(def root (str (System/tmp_dir!) "/bl_build_scope_test_"
               (erlang/unique_integer (list :positive))))
(def out (Path/join root "ebin"))
(def manifest (Path/join out "compile.beam_lisp"))
(def log (blog/path-for manifest))

; ── helpers ──────────────────────────────────────────────────────────────────

(defn- src [rel text]
  (let [p (Path/join root rel)]
    (File/mkdir_p! (Path/dirname p))
    (File/write! p text)
    p))

(defn- beam-of
  "The beam a namespace is emitted at, spelled the way the launcher's
   `tier_module` spells it: `BeamLisp.Ns.` + the camelized dot segments."
  [ns]
  (Path/join out (str "Elixir.BeamLisp.Ns." (Macro/camelize ns) ".beam")))

(defn- fresh!
  "A tree with ONE library source and ONE boot source. The names are unique to
   this file, so a compile cannot collide with another suite's."
  []
  (File/rm_rf! root)
  (File/mkdir_p! root)
  (System/put_env "BEAM_LISP_AOT_CACHE" "off")
  [(src "lib/scopelib.bl" "(ns scopelib)\n(defn f [x] (+ x 1))\n")
   (src "boot/scopeboot.bl" "(ns scopeboot)\n(defn g [] 1)\n")])

(defn- run-with!
  "`build/run` over `sources` into the shared ebin. `scope` is passed through
   as given, so nil is the DEFAULT (authoritative full) and a keyword is the
   caller's claim about the list. The shared AOT cache is OFF so every
   satisfied source is a real compile and two runs cannot be confused by a hit."
  [sources scope]
  (System/put_env "BEAM_LISP_AOT_CACHE" "off")
  (b/run {:sources sources :out out :manifest manifest :jobs 1 :scope scope}))

(defn- full-run! [sources] (run-with! sources nil))
(defn- scoped-run! [sources] (run-with! sources :scoped))

(defn- log-state [] (blog/replay (blog/read-facts log)))

(defn- recorded?
  "Is `path` still a source the log knows? (Built OR failed — either is an
   ownership record.)"
  [path]
  (contains? (set (keys (:sources (log-state)))) path))

(defn- projected?
  "Is `path` still in the manifest Mix reads?"
  [path]
  (contains? (set (keys (b/read-manifest manifest))) path))

(defn- log-text [] (File/read! log))

; ── scoped: the run keeps what it was not handed ─────────────────────────────

(deftest a-scoped-run-keeps-the-sources-it-was-not-handed
  (let [[lib boot] (fresh!)
        r1 (full-run! [lib boot])]
    (is (= 2 (:built r1)))
    (is (recorded? lib))
    (is (File/exists? (beam-of "scopelib")))
    ; The boot self-heal's shape: a boot-only child, same ebin.
    (let [r2 (scoped-run! [boot])]
      (is (= 0 (:built r2)) "both are fresh; a scoped run rebuilds nothing")
      (is (empty? (:errors r2)) (str "scoped errors: " (str (vec (:errors r2)))))
      (is (recorded? lib) "the library's fact is still in the log")
      (is (projected? lib) "…and still in the manifest Mix reads")
      (is (File/exists? (beam-of "scopelib")) "…and its beam still owns its module")
      (is (includes? (log-text) lib) "the log still names the library as its own"))))

; ── full: the same list, authoritative, still prunes ─────────────────────────

(deftest an-authoritative-run-still-drops-a-source-that-left
  (let [[lib boot] (fresh!)]
    (full-run! [lib boot])
    (let [r (full-run! [boot])]
      (is (= 0 (:built r)))
      (is (not (recorded? lib)) "the fact is gone: the log no longer claims it")
      (is (not (projected? lib)) "…and neither does the manifest")
      (is (not (File/exists? (beam-of "scopelib"))) "…and neither does the ebin")
      (is (not (includes? (log-text) lib))
          "the compacted log no longer names it, so the log and the ebin agree"))))

; ── the empty set is both a scope and an inventory ───────────────────────────

(deftest an-empty-source-set-is-a-scope-and-an-inventory
  (let [[lib boot] (fresh!)]
    (full-run! [lib boot])
    ; SCOPED with nothing means "I am rebuilding nothing", not "all is gone".
    (let [r (scoped-run! [])]
      (is (= 0 (:built r)))
      (is (recorded? lib))
      (is (recorded? boot))
      (is (File/exists? (beam-of "scopelib")))
      (is (File/exists? (beam-of "scopeboot")))
      (is (projected? lib)))
    ; FULL with nothing: the inventory is empty, so the build owns nothing.
    (let [r (full-run! [])]
      (is (= 0 (:built r)))
      (is (empty? (set (keys (:sources (log-state))))) "no source is recorded")
      (is (= {} (b/read-manifest manifest)) "and the projection is empty")
      (is (not (File/exists? (beam-of "scopelib"))))
      (is (not (File/exists? (beam-of "scopeboot")))))))

; ── mixed prior state: a failure is an ownership record too ──────────────────

(deftest a-scoped-rebuild-leaves-a-mixed-prior-state-intact
  (let [[lib boot] (fresh!)
        broken (src "lib/scopebroken.bl"
                    "(ns scopebroken (:require [nope.missing :as n]))\n(defn h [] (n/missing))\n")
        r1 (full-run! [lib boot broken])]
    (is (= 2 (:built r1)) "the library and the boot source build")
    (is (seq (:errors r1)) "the third source is a FAILURE")
    (is (includes? (log-text) "[:build/failed") "recorded as a fact, with its reason")
    (let [before (get (b/read-manifest manifest) lib)]
      (src "boot/scopeboot.bl" "(ns scopeboot)\n(defn g [] 2)\n")
      (let [r (scoped-run! [boot])]
        (is (= 1 (:built r)) "only the edited boot source is rebuilt")
        (is (recorded? lib) "the library keeps its record")
        (is (recorded? broken) "…and so does the failure this run did not own")
        (is (includes? (log-text) "[:build/failed") "…still as the log's word for it")
        (is (= before (get (b/read-manifest manifest) lib))
            "the library's manifest entry is byte-for-byte what it was")
        (is (File/exists? (beam-of "scopelib")))))))

; ── a typo must not delete a build ───────────────────────────────────────────

(deftest an-unreadable-scope-is-reported-and-prunes-nothing
  (let [[lib boot] (fresh!)]
    (full-run! [lib boot])
    (let [r (run-with! [boot] :scopedd)]
      (is (= 1 (count (:errors r))))
      (is (includes? (str (first (:errors r))) "unknown :scope"))
      (is (recorded? lib) "an unreadable scope is not an inventory: nothing was pruned")
      (is (projected? lib))
      (is (File/exists? (beam-of "scopelib"))))))

; ── the boot child's claim ───────────────────────────────────────────────────

; The pinned host module is compiled from CURRENT source at its own probe atom
; and loaded ALONE (the pattern `launcher_host_test.bl` uses): asserting against
; the committed seed would pin yesterday's source, not this tree's.
(def ^:private probe :Elixir.BeamLisp.BlScopeOwnershipProbe)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- attempt
  "`(f)`, or the error it raised as its message. A seam that breaks must NAME
   the step it broke at, not take the whole test down with an anonymous error."
  [f]
  (try [:ok (f)] (catch e [:err (str e)])))

(defn- ok-v
  "The value of a successful `attempt`, or nil with the failure REPORTED under
   `label`."
  [label r]
  (is (= :ok (first r)) (str label ": " (str r)))
  (if (= :ok (first r)) (second r) nil))

(deftest the-boot-child-hands-the-driver-a-scoped-inventory
  (let [dir (Path/join root "host")
        src (Path/join (BeamLisp/cwd) "priv/host/launcher.bl")]
    (File/rm_rf! root)
    (File/mkdir_p! dir)
    (let [compiled (ok-v "compile_host_file"
                     (attempt (fn [] (BeamLisp.AOT/compile_host_file src
                                      (list (erlang/list_to_tuple (list :module probe))
                                            (erlang/list_to_tuple (list :output_dir dir))
                                            (erlang/list_to_tuple (list :load? false)))))))
          loaded (if (nil? compiled) nil
                   (ok-v "load pinned beam"
                     (attempt (fn [] (let [b (elem compiled 1)]
                                       (drop! probe)
                                       (code/load_binary probe (erlang/binary_to_list b) (File/read! b))
                                       :ok)))))
          args (if (nil? loaded) nil
                 (ok-v "build_args"
                   (attempt (fn [] (erlang/apply probe :build_args
                                        (list (Path/join root "ebin") (BeamLisp/cwd)))))))]
      (if (nil? args)
        nil
        (do
          (is (= :scoped (get args :scope))
              "the boot self-heal owns a SUBSET and must say so")
          (is (seq (:sources args)) "the boot tier's sources are still handed over")
          (is (every? (fn [p] (or (includes? p "priv/boot") (includes? p "priv/std")))
                      (:sources args))
              "…and they are exactly the boot tier's")
          (is (= false (:force? args)) "and nothing else about the invocation changed"))))))
