; test/bl/lazy_scaling_test.bl — the gate that keeps O(n²) lazy producers out.
; Run: bl test test/bl/lazy_scaling_test.bl
;
; PLAN-151. A lazy producer whose per-element memo cell captures the rest of its
; input costs O(n²): each cell's price is proportional to what its thunk
; captured. The symptom is not a wrong answer but a slow one, which no
; equivalence test notices — so this file times every producer at n and 4n and
; fails when quadrupling the input costs more than 8x. Linear shows ~4 and
; quadratic ~16, so the bound sits a factor of 2 from each: a 2n comparison
; (linear 2, quadratic 4, bound 3) flipped on ordinary scheduler noise.
;
; Each side takes the best of five runs. A case too fast to time (< 4 ms at
; 4n) is linear by construction and passes.
; bench/lazy_scaling.bl prints the same cases as a table.
;
; RUNTIME/CAP: this file TIMES execution, so it wants a warm host and an idle
; scheduler — each side is the best of five runs and a failing case is measured
; twice more, which is what keeps ordinary scheduler noise from failing a case
; that is really linear. Memory is small: every case walks a vector of at most
; 4n = 8000 elements, and the closed-over `env` map holds 20,000 entries.

(ns lazy-scaling.test)

(def ^:private n 2000)

(defn- us [f]
  (let [t0 (erlang/monotonic_time :microsecond)]
    (f)
    (- (erlang/monotonic_time :microsecond) t0)))

(defn- best [f] (min (us f) (us f) (us f) (us f) (us f)))

(defn- measure [f]
  (let [small (vec (range n))
        large (vec (range (* 4 n)))
        a (best (fn [] (f small)))
        b (best (fn [] (f large)))]
    {:ok? (or (< b 4000) (<= b (* 8 (max a 1))))
     :n-us a :4n-us b}))

(defn- linear?
  "Whether `f` (given a vector of size k) scales linearly from n to 4n. Answers
   the measurement too, so a failure names its numbers.

   A single measurement can lose to a scheduler stall that lands on one side
   only (seen: `map` 1.6 ms -> 16 ms once, 1.4 -> 5.6 on every rerun). So a
   failing case is measured twice more and fails only when EVERY attempt does:
   a real O(n²) producer fails all three by a wide margin (distinct before
   this gate was tightened: 25 ms -> 422 ms), noise does not repeat."
  [f]
  (loop [k 0]
    (let [r (measure f)]
      (if (or (:ok? r) (= k 2)) r (recur (inc k))))))

(def ^:private env (into {} (map (fn [i] [i i]) (range 20000))))

(def cases
  [["map-indexed"   (fn [c] (count (map-indexed (fn [i x] [i x]) c)))]
   ["keep-indexed"  (fn [c] (count (keep-indexed (fn [i x] (when (even? i) x)) c)))]
   ["dedupe"        (fn [c] (count (dedupe c)))]
   ; distinct's seen set is ONE native set captured by handle — it used to be
   ; threaded through every chunk and copied with it (O(n²/32)).
   ["distinct"      (fn [c] (count (distinct c)))]
   ["distinct, many dups" (fn [c] (count (distinct (map (fn [x] (mod x 97)) c))))]
   ["keep"          (fn [c] (count (keep (fn [x] (when (odd? x) x)) c)))]
   ["partition-by"  (fn [c] (count (partition-by (fn [x] (quot x 7)) c)))]
   ["partition"     (fn [c] (count (partition 4 c)))]
   ["interpose"     (fn [c] (count (interpose 0 c)))]
   ["interleave"    (fn [c] (count (interleave c c)))]
   ["for"           (fn [c] (count (for [x c] x)))]
   ["for :when"     (fn [c] (count (for [x c :when (even? x)] x)))]
   ["map"           (fn [c] (count (map inc c)))]
   ["filter"        (fn [c] (count (filter odd? c)))]
   ["walk first/rest"
    (fn [c] (loop [s (map-indexed (fn [i x] [i x]) c) k 0] (if (seq s) (recur (rest s) (inc k)) k)))]
   ["reduce over map-indexed" (fn [c] (reduce (fn [a _] (inc a)) 0 (map-indexed (fn [i x] [i x]) c)))]
   ["mapv, f closes over a large map" (fn [c] (count (mapv (fn [x] (get env x)) c)))]
   ["for, body closes over a large map" (fn [c] (count (for [x c] (get env x))))]])

(deftest every-lazy-producer-is-linear
  (doseq [[nm f] cases]
    (let [r (linear? f)]
      (is (:ok? r) (str nm ": " (:n-us r) " us at n=" n ", " (:4n-us r) " us at 4n")))))

; A chunk is bounded by the INPUTS it walks, never by the outputs it emits. A
; producer that sealed a chunk only after 32 outputs walked forever when
; matches ran out: `(first (keep f (range)))` with 3 matches never returned.
; Each case must answer within its own deadline (a hang fails, not blocks).
(defn- within [ms f]
  (let [t (Task/async f)
        r (Task/yield t ms)]
    (when (nil? r) (Task/shutdown t :brutal_kill))
    (if (nil? r) ::timeout (second r))))

(deftest sparse-producers-over-infinite-input-terminate
  (doseq [[nm want f]
          [["distinct"     [1 2 3] #(vec (take 3 (distinct (cycle [1 2 3]))))]
           ["keep"         0       #(first (keep (fn [x] (when (< x 3) x)) (range)))]
           ["keep-indexed" 0       #(first (keep-indexed (fn [i x] (when (< i 2) x)) (range)))]
           ["filter"       0       #(first (filter (fn [x] (< x 3)) (range)))]
           ["remove"       0       #(first (remove (fn [x] (>= x 3)) (range)))]
           ["dedupe"       1       #(first (dedupe (cycle [1 1])))]
           ["for :when"    0       #(first (for [x (range) :when (< x 3)] x))]
           ["nested for :when" [0 0] #(first (for [x (range) y [0] :when (< x 2)] [x y]))]]]
    (is (= want (within 5000 f)) (str nm " over an infinite input"))))
