(ns sdk.retention-lock-test)

(deftest sdk-retention-does-not-block-the-private-owner-behind-a-fence-holder
 ;; Reproduce the real cycle: a native worker owns a module fence and needs
 ;; an Env reply; SDK retention must not occupy Env while waiting for it.
 (BeamLisp.Env/ensure_sdk_runtime!)
 (let [parent (erlang/self) tag (erlang/make_ref)
       env (erlang/whereis :Elixir.BeamLisp.Env)
       holder (erlang/spawn (fn []
         (BeamLisp.Env/with_module_locks (list :Elixir.BeamLisp.Env)
          (fn []
           (erlang/send parent [tag :held])
           (receive [seen :ask-owner] :when (= seen tag) :ok)
           (let [reply (Agent/get :Elixir.BeamLisp.Env (fn [_] :owner-alive) 10000)]
            (erlang/send parent [tag :owner reply]))))))
       retainer (atom nil)
       patterns [(tuple :Elixir.BeamLisp.Env :with_module_locks 2)
                 (tuple :Elixir.BeamLisp.Env :try_with_module_locks 2)]]
  (try
   (is (= :held (receive [seen value] :when (= seen tag) value (after 5000 :timeout))))
   ;; Arity-only tracing avoids copying SDK inventory/callback captures.
   (doseq [pattern patterns] (erlang/trace_pattern pattern true (list :local)))
   (erlang/trace env true (list :call :arity))
   (reset! retainer (erlang/spawn (fn []
     (let [result (BeamLisp.Env/ensure_sdk_runtime!)] (erlang/send parent [tag :retained result])))))
   (is (= :entered
     (receive [:trace pid :call [module function arity]]
      :when (and (= pid env) (= module :Elixir.BeamLisp.Env) (= arity 2)
                 (or (= function :with_module_locks) (= function :try_with_module_locks))) :entered
      (after 60000 :timeout))))
   (erlang/send holder [tag :ask-owner])
   (is (= :owner-alive
     (receive [seen :owner value] :when (= seen tag) value (after 15000 :timeout))))
   (is (= :sdk-runtime-retained
     (receive [seen :retained value] :when (= seen tag) value (after 60000 :timeout))))
   (is (= :owner-still-alive (Agent/get :Elixir.BeamLisp.Env (fn [_] :owner-still-alive) 10000)))
   (finally
    (erlang/trace env false (list :call))
    (doseq [pattern patterns] (erlang/trace_pattern pattern false (list :local)))
    (doseq [pid [holder @retainer]] (when (and pid (Process/alive? pid)) (erlang/exit pid :kill)))))))
