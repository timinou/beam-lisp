(ns sdk-lambda-origin-test)

(deftest lambda-origins-use-the-native-funt-row-index
 (let [directory (Path/join (System/tmp_dir!) (str "bl-lambda-origin-" (erlang/unique_integer (list :positive))))
       source (Path/join directory "fixture.bl")
       module (String/to_atom (str "Elixir.LambdaOriginFixture" (erlang/unique_integer (list :positive))))]
  (try
   (File/mkdir_p! directory)
   (File/write! source "(ns host.lambda-origin-fixture) (defn z [x] (fn [] x)) (defn a [x y] (fn [z] [x y z]))")
   (let [compiled (BeamLisp.AOT/compile_host_file source
                    (list (tuple :module module) (tuple :output_dir directory) (tuple :load? false)))
         bytes (File/read! (elem compiled 1)) routes (BeamLisp.AOT/sdk_lambda_routes! bytes)]
    (code/load_binary module (String/to_charlist (elem compiled 1)) bytes)
    (doseq [f [(erlang/apply module :z (list 7)) (erlang/apply module :a (list 1 2))]]
     (is (= (tuple (elem (erlang/fun_info f :name) 1) (elem (erlang/fun_info f :arity) 1)
                   (erlang/length (elem (erlang/fun_info f :env) 1)))
            (get routes (elem (erlang/fun_info f :new_index) 1))))))
   (finally (code/purge module) (code/delete module) (File/rm_rf! directory)))))
