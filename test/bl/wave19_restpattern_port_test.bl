; wave19_restpattern_port_test.bl — the rest-argument-as-pattern contract, ported
; verbatim from the ExUnit `test/beam_lisp/wave19_restpattern_test.exs`.
;
; The last real compiler gap: a rest argument that is itself a destructuring
; pattern. Clojure lets `&` hold any binding form, not just a bare symbol —
; jank's `for` relies on exactly this (`& [[_ next-expr] :as next-groups]`). The
; machinery is the same `destructure_steps/3` that fixed params use; the rest is
; bound to a temp var and destructured against it.
;
; LOAD-BEARING EDGE: an EXHAUSTED rest binds nil, not `()`. jank code recurses on
; `(when (seq more) …)`, and `()` is truthy, so binding `[]` would loop forever at
; the base case instead of terminating. A rest PATTERN therefore destructures nil
; leniently (every name nil) — never an error, exactly like destructuring a
; too-short collection.
;
; WHY eval-in AND NOT PLAIN EXPRESSIONS
;
; Every case here defines a fn whose PARAMETER LIST is the thing under test, so
; the interesting work happens at COMPILE time of that fn. A plain top-level
; `(defn f [& [a b]] …)` in this file would be compiled by the file loader and a
; malformed one would abort the whole file's load — uncatchable, and it would
; take the other tests down with it. The ExUnit suite drove the compiler through
; `eval_string` for precisely this reason: the two REFUSALS below must be
; catchable. `eval-in` reproduces that driver.
;
; Run: bin/bl test test/bl/wave19_restpattern_port_test.bl

(ns wave19.rest-pattern.test)

(defn- eval-in
  "Compile-and-eval `source` in a fresh env for `ns` — the driver the ExUnit
   `eval/2` used. Compile-time refusals surface here, catchable."
  [ns source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env ns)))

(defn- raised
  "The exception `source` raises when compiled+evaluated, or nil — the value the
   ExUnit `assert_raise` inspected."
  [ns source]
  (try (do (eval-in ns source) nil) (catch e e)))

; --- bare-symbol rest and fixed params --------------------------------------

(deftest bare-symbol-rest-still-works-and-keeps-empty
  (is (= (list (list) (list 1 2))
         (eval-in "w19bare" "(defn f [& rest] rest) (list (f) (f 1 2))"))))

(deftest fixed-params-before-a-pattern-rest-still-bind-normally
  (is (= (list (list 1 nil nil) (list 1 2 nil) (list 1 2 3) (list 1 2 3))
         (eval-in "w19fixed"
                  "(defn f [a & [b c]] (list a b c)) (list (f 1) (f 1 2) (f 1 2 3) (f 1 2 3 4))"))))

; --- a vector pattern in rest position --------------------------------------

(deftest vector-pattern-in-rest-position-destructures-the-trailing-args
  (is (= (list (list nil nil) (list 9 nil) (list 9 8) (list 9 8))
         (eval-in "w19vec"
                  "(defn f [& [a b]] (list a b)) (list (f) (f 9) (f 9 8) (f 9 8 7))"))))

(deftest empty-rest-binds-nil-for-every-name-not-()
  (is (= (list nil nil)
         (eval-in "w19empty" "(defn f [& [a b]] (list a b)) (f)")))
  (is (= (list true true)
         (eval-in "w19empty2" "(defn f [& [a b]] (list (nil? a) (nil? b))) (f)"))))

(deftest one-shorter-than-pattern-rest-binds-trailing-names-nil
  (is (= (list (list 1 nil nil) (list 1 2 nil))
         (eval-in "w19short" "(defn f [& [a b c]] (list a b c)) (list (f 1) (f 1 2))"))))

; --- :as in the rest pattern -------------------------------------------------

(deftest as-in-the-rest-pattern-binds-the-whole-rest
  (is (= (list (list 1 2 (list 1 2 3)) (list nil nil nil) (list 7 nil (list 7)))
         (eval-in "w19as"
                  "(defn f [& [a b :as all]] (list a b all)) (list (f 1 2 3) (f) (f 7))"))))

(deftest as-in-the-rest-pattern-binds-nil-when-the-rest-is-exhausted
  (is (= (list true nil)
         (eval-in "w19asnil" "(defn f [& [a :as all]] (list (nil? all) all)) (f)"))))

; --- nesting -----------------------------------------------------------------

(deftest nested-vector-pattern-in-rest-two-deep
  (is (= (list (list 1 2 3) (list nil nil nil) (list 1 2 nil))
         (eval-in "w19nested"
                  "(defn f [& [[a b] c]] (list a b c)) (list (f [1 2] 3) (f) (f [1 2]))"))))

(deftest rest-pattern-with-its-own-inner-&-rest-recursion-shape
  (is (= (list (list 1 2 (list 3 4)) (list 1 2 nil))
         (eval-in "w19inner"
                  "(defn f [& [a b & more]] (list a b more)) (list (f 1 2 3 4) (f 1 2))"))))

; --- the jank `for` emit-bind signature --------------------------------------
; `emit-bind` receives [[bind expr & mod-pairs] & [[_ next-expr] :as next-groups]].
; With a single group the rest is exhausted: next-expr and next-groups must both
; bind nil (jank's recursion terminates on exactly this). The non-empty case
; binds the leading next-group and the whole tail.
;
; NB the expected shape mirrors the ExUnit one exactly: `mod-pairs` is the seq
; `(3 4)` (a LIST), `next-groups` is the whole rest `([5 6] [7 8])` (a LIST of
; VECTORS), and an exhausted mod-pairs is nil — not `()`.

(deftest the-jank-for-emit-bind-signature-nested-rest-with-:as-empty-base-case
  (is (= (list (list 1 2 '(3 4) nil nil)
               (list 1 2 nil 6 (list [5 6] [7 8])))
         (eval-in "w19for"
                  (str "(defn emit-bind [[[bind expr & mod-pairs] & [[_ next-expr] :as next-groups]]]"
                       " (list bind expr mod-pairs next-expr next-groups))"
                       " (list (emit-bind [[1 2 3 4]]) (emit-bind [[1 2] [5 6] [7 8]]))")))))

; --- fn and let paths use the same machinery --------------------------------

(deftest fn-and-let-paths-use-the-same-rest-pattern-machinery
  (is (= (list (list 1 2) (list nil nil))
         (eval-in "w19fn" "(let [f (fn [& [a b]] (list a b))] (list (f 1 2) (f)))")))
  (is (= (list 1 2 3) (eval-in "w19let" "(let [[x & [y z]] [1 2 3]] (list x y z))")))
  (is (= (list 1 nil nil) (eval-in "w19let2" "(let [[x & [y z]] [1]] (list x y z))")))
  (is (= (list 1 2 3) (eval-in "w19let3" "(let [[x & [[a b]]] [1 [2 3]]] (list x a b))"))))

; --- refusals ---------------------------------------------------------------

(deftest a-map-pattern-in-rest-position-raises-a-clear-message-not-a-mis-bind
  ; The rest is always a positional seq; a map pattern there would silently bind
  ; every key to nil (a seq is not a map), which is a footgun. Refuse.
  (let [e (raised "w19map" "(defn f [& {:keys [x]}] x)")]
    (is (= :Elixir.RuntimeError (:__struct__ e)))
    (is (includes? (str (ex-message e)) "rest pattern cannot be a map"))))

(deftest ampersand-must-be-followed-by-exactly-one-parameter
  (let [e (raised "w19arity" "(defn f [& a b] a)")]
    (is (= :Elixir.RuntimeError (:__struct__ e)))
    (is (includes? (str (ex-message e)) "followed by exactly one parameter"))))
