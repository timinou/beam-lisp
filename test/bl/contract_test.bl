; test/bl/contract_test.bl — defcontract's BEAM half.
; Run: mix beam_lisp.test test/bl/contract_test.bl
;
; ── the acceptance test ──────────────────────────────────────────────────────
;
; `SpacetimeLvWeb.CounterLive` exists today and its Elixir DSL emits a contract
; whose SHA-256 is
;
;     2d5c38735e3b8e76d12c8fb2fa3de1ad35eac250884ddb417bf59fa7b9787dcf
;
; That is a known-good output nobody can argue with: the emitter here either
; reproduces those exact bytes from a beam-lisp term, or it does not. No
; judgement call, no "close enough" — which is exactly why this was chosen as
; the first milestone rather than something with a subjective bar.
;
; Byte equality matters because verse's src/analysis/liveview_contract.rs reads
; the same sidecar. Two toolchains that disagree about a contract's identity
; disagree about whether an app is broken.

(ns contract.test
  (:require [contract :refer [parse contract-json fingerprint module-name
                              contract-json-with-fingerprint]]
            [seam :refer [reply-tags handler-for events assigns pushes]]))

;; ── the fixture: CounterLive, as a beam-lisp term ───────────────────────────

(def counter
  (parse :counter-live
         {:bundle "/spacetime/counter/spacetime.js" :root ".counter"}
         (list
           (quote (assign @count :integer 0))
           (quote (push @flash {:message :string :kind :atom}))
           (quote (on :inc (set! @count (inc @count)) (ok @count)))
           (quote (on :dec (if (zero? @count)
                             (err "Count cannot go below zero")
                             (do (set! @count (dec @count)) (ok @count))))))))

(def counter-module "SpacetimeLvWeb.CounterLive")

;; ── THE acceptance test ─────────────────────────────────────────────────────

(deftest reproduces-the-elixir-contract-byte-for-byte
  (is (= (str "{\"module\":\"SpacetimeLvWeb.CounterLive\","
              "\"events\":[{\"name\":\"dec\"},{\"name\":\"inc\"}],"
              "\"assigns\":[{\"name\":\"count\",\"type\":\"integer\"}],"
              "\"pushes\":[{\"name\":\"flash\",\"fields\":{\"kind\":\"atom\",\"message\":\"string\"}}]}")
         (contract-json counter counter-module))))

(deftest reproduces-the-elixir-fingerprint
  ; the one assertion this entire milestone is judged on
  (is (= "2d5c38735e3b8e76d12c8fb2fa3de1ad35eac250884ddb417bf59fa7b9787dcf"
         (fingerprint counter counter-module))))

;; ── the properties that make the match non-accidental ───────────────────────
;; A hash matching once could be luck. These pin the RULES that produce it, so
;; a future refactor that breaks one fails here rather than at the hash.

(deftest entries-are-sorted-by-name
  ; Elixir's contract_entries/2 ends with Enum.sort_by(& &1.name). `dec` before
  ; `inc` although the term declares inc first — declaration order must NOT
  ; leak into the bytes, or the fingerprint stops being order-independent.
  (is (includes? (contract-json counter counter-module)
                 "[{\"name\":\"dec\"},{\"name\":\"inc\"}]")))

(deftest declaration-order-does-not-change-the-bytes
  (let [reordered (parse :counter-live
                         {:bundle "/spacetime/counter/spacetime.js" :root ".counter"}
                         (list
                           (quote (on :dec (if (zero? @count)
                                             (err "Count cannot go below zero")
                                             (do (set! @count (dec @count)) (ok @count)))))
                           (quote (push @flash {:message :string :kind :atom}))
                           (quote (on :inc (set! @count (inc @count)) (ok @count)))
                           (quote (assign @count :integer 0))))]
    (is (= (fingerprint counter counter-module)
           (fingerprint reordered counter-module)))))

(deftest empty-metadata-is-OMITTED-not-emitted-empty
  ; Elixir writes `%{name: n}` and only ADDS the metadata key when non-empty.
  ; Emitting "fields":{} instead would be valid JSON, structurally identical,
  ; and a different fingerprint.
  (let [c (parse :x {} (list (quote (on :ping (ok 1)))))]
    (is (= "{\"module\":\"M\",\"events\":[{\"name\":\"ping\"}],\"assigns\":[],\"pushes\":[]}"
           (contract-json c "M")))
    (is (not (includes? (contract-json c "M") "fields")))))

(deftest field-VALUES-are-not-silently-blank
  ; The first version sorted `(map name (keys m))` then looked values up with
  ; the resulting STRING, missing every keyword key. It emitted
  ; {"kind":"","message":""} — perfectly-shaped JSON, every value blank, and a
  ; fingerprint that differed. Structure alone would not have caught it.
  (let [j (contract-json counter counter-module)]
    (is (includes? j "\"kind\":\"atom\""))
    (is (includes? j "\"message\":\"string\""))
    (is (not (includes? j "\"\"")))))

(deftest field-keys-are-sorted
  ; declared as {:message … :kind …}; emitted kind-then-message
  (is (includes? (contract-json counter counter-module)
                 "{\"kind\":\"atom\",\"message\":\"string\"}")))

(deftest a-real-change-moves-the-fingerprint
  (let [added (parse :counter-live {}
                     (list (quote (assign @count :integer 0))
                           (quote (on :inc (ok 1)))
                           (quote (on :reset (ok 0)))))
        base (parse :counter-live {}
                    (list (quote (assign @count :integer 0))
                          (quote (on :inc (ok 1)))))]
    (is (not (= (fingerprint base "M") (fingerprint added "M"))))))

(deftest the-module-name-is-part-of-the-identity
  ; two apps with identical surfaces are still different contracts
  (is (not (= (fingerprint counter "SpacetimeLvWeb.CounterLive")
              (fingerprint counter "SpacetimeLvWeb.OtherLive")))))

;; ── parsing the surface ─────────────────────────────────────────────────────

(deftest parses-at-signs-and-bare-names-alike
  ; `@count` reads as (deref count); an author may also write a bare name. The
  ; emitter must not care which the reader produced.
  (let [a (parse :x {} (list (quote (assign @count :integer 0))))
        b (parse :x {} (list (quote (assign count :integer 0))))]
    (is (= (assigns a) (assigns b)))
    (is (= (list "count") (assigns a)))))

(deftest collects-every-declaration-kind
  (is (= (list "dec" "inc") (events counter)))
  (is (= (list "count") (assigns counter)))
  (is (= (list "flash") (pushes counter))))

(deftest an-unknown-clause-FAILS-rather-than-being-ignored
  ; a silently-dropped clause is a seam hole no later check can see
  (is (thrown? (parse :x {} (list (quote (subscribe @nope :string)))))))

(deftest multi-form-bodies-are-wrapped-in-do
  (let [c (parse :x {} (list (quote (on :multi (a) (b) (ok 1)))))
        body (handler-for c "multi")]
    (is (= (quote do) (first body)))
    ; and the tags still come out of the wrapped body
    (is (= (list "ok") (reply-tags body)))))

(deftest single-form-bodies-are-not-wrapped
  (let [c (parse :x {} (list (quote (on :one (ok 1)))))]
    (is (= (quote ok) (first (handler-for c "one"))))))

(deftest on-info-is-not-part-of-the-page-facing-surface
  ; a server-internal message (a provider streaming a token) must NOT change the
  ; contract the page is checked against
  (let [with-info (parse :x {}
                         (list (quote (on :inc (ok 1)))
                               (quote (on-info [:delta id chunk] (push! @token chunk)))))
        without (parse :x {} (list (quote (on :inc (ok 1)))))]
    (is (= (fingerprint without "M") (fingerprint with-info "M")))
    (is (= 1 (count (get with-info :infos))))))

;; ── module naming ───────────────────────────────────────────────────────────

(deftest module-name-follows-the-repo-convention
  (is (= "SpacetimeLvWeb.CounterLive" (module-name counter "SpacetimeLvWeb")))
  (is (= "App.ChatLive" (module-name (parse :chat-live {} (list)) "App")))
  ; a single-segment name still capitalises
  (is (= "App.Board" (module-name (parse :board {} (list)) "App"))))

;; ── the sidecar file ────────────────────────────────────────────────────────

(deftest sidecar-carries-the-fingerprint
  (let [s (contract-json-with-fingerprint counter counter-module)]
    (is (includes? s "\"fingerprint\":\"2d5c38735e3b8e76d12c8fb2fa3de1ad35eac250884ddb417bf59fa7b9787dcf\""))
    ; and the fingerprint is of the contract WITHOUT it, as Elixir does
    (is (starts-with? s "{\"module\":\"SpacetimeLvWeb.CounterLive\""))))
