; test/bl/direct_forms_test.bl — the DIRECT (non-normalised) forms, ported
; from test/beam_lisp/direct_forms_test.exs.
;
; Four contracts, each about a form that must behave as WRITTEN rather than be
; rewritten on the way in:
;
;   1. `Elixir.String/upcase` — an explicit `Elixir.` prefix must resolve to the
;      same host module a plain `String/upcase` does, and must still be gated by
;      the env's capability set (a fork with `:caps []` refuses it). The prefix
;      is a SPELLING of the same call, not a bypass of the gate.
;   2. `defserver` guarded callbacks — a `handle-call` with `:when` must dispatch
;      on the guard, and `(invariant [state] …)` must expose `__invariant__`.
;   3. direct `def`/`defn`/`defmacro` metadata — `^{…}` metadata must land in the
;      var's metadata as PLAIN DATA (nested quotes stay data), and the compiler
;      must not carry an Elixir-side `(a/normalise meta)` / `Macro/escape` shim.
;   4. `defserver` reload — redefining a server replaces its callbacks while
;      keeping the old module atom (clients keep working) and client defaults.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 4 ExUnit tests map one-to-one onto a same-named BL deftest, in order:
;   explicit Elixir prefixes resolve to the same host module
;     → explicit-elixir-prefixes-resolve-to-the-same-host-module
;   defserver preserves guarded callback dispatch
;     → defserver-preserves-guarded-callback-dispatch
;   direct definitions store rich metadata as plain data
;     → direct-definitions-store-rich-metadata-as-plain-data
;   defserver reload replaces callbacks and preserves client defaults
;     → defserver-reload-replaces-callbacks-and-preserves-client-defaults
;
; Adaptations, and why:
;   * `use ExUnit.Case, async: false` has no ward equivalent: `bl test` runs
;     each FILE in its own isolated fork and the tests inside one file in order.
;   * `assert_raise BeamLisp.CompileError` becomes `denied?`, a TYPED catch —
;     the type is the contract (same shape as `test/bl/caps_port_test.bl`).
;   * `BeamLisp.Env.fork(:global, caps: [])` goes through the `env` namespace's
;     `env/fork`, because BL keyword opts must reach the host as a real keyword
;     LIST; a raw `{:caps …}` map would arrive as a struct and be ignored.
;   * `%BeamLisp.Vector{items: {{:symbol, "x"}}}` is the runtime's vector for
;     `[x]`, written here as the vector literal `[(tuple :symbol "x")]`; the
;     reader produces tuples, and BL has no literal Erlang tuple. The list
;     wrappers around `\%BeamLisp.Vector{}` in the original are Erlang lists,
;     kept as `(list …)`.
;   * `mod.__invariant__(0)` on the module atom a `defserver` form evaluates to
;     is `(erlang/apply mod :__invariant__ (list 0))`.
;   * `source =~ "…"` is `(includes? source "…")`.
;
; Run: bin/bl test test/bl/direct_forms_test.bl

(ns direct-forms.test
  (:require [env]))

(defn- ev
  "The ExUnit `eval/2` verbatim: `BeamLisp.init/0`, then compile and run
   `(ns NS)\\n SOURCE` in a fresh env for NS."
  [ns source]
  (BeamLisp/init)
  (BeamLisp.Compiler/eval_string (str "(ns " ns ")\n" source) (BeamLisp.Compiler/new_env ns)))

(defn- denied?
  "True only when `f` raises `BeamLisp.CompileError` — a typed `assert_raise`."
  [f]
  (try
    (do (f) false)
    (catch BeamLisp.CompileError _e true)))

(defn- meta-of
  "The metadata map of var `nm` in namespace `ns` — the second element of the
   `{:ok, map}` the original destructured."
  [ns nm]
  (erlang/element 2 (BeamLisp.Env/meta ns nm)))

; ── 1. explicit `Elixir.` prefixes, under the capability gate ───────────────

(deftest explicit-elixir-prefixes-resolve-to-the-same-host-module
  (is (= "HELLO" (ev "qualifiedhost" "(Elixir.String/upcase \"hello\")")))
  (is (= "HELLO" (ev "qualifiedhost" "(let [f Elixir.String/upcase] (f \"hello\"))")))
  (let [child (env/fork :global {:caps []})]
    (try
      (is (denied?
            (fn [] (env/with-env child
                     (fn [] (ev "qualifiedhost" "(Elixir.String/upcase \"denied\")"))))))
      (finally (env/destroy child)))))

; ── 2. `defserver` guarded callback dispatch ────────────────────────────────

(deftest defserver-preserves-guarded-callback-dispatch
  (let [mod (ev "directserverinvariant" #|
(defserver bounded
  (invariant [state] (>= state 0))
  (init [x] (ok x))
  (handle-call :get [_from state] (reply state state)))
bounded|)]
    (is (erlang/apply mod :__invariant__ (list 0)))
    (is (not (erlang/apply mod :__invariant__ (list -1)))))

  (is (= (list :accepted :rejected 7)
         (ev "directserverguard" #|
(defserver bank
  (init [x] (ok x))
  (handle-call [:take n] :when (pos? n) [_from state]
    (reply :accepted (- state n)))
  (handle-call [:take _n] [_from state] (reply :rejected state))
  (handle-call :balance [_from state] (reply state state)))
(let [p (start-link bank 10)
      a (call p [:take 3])
      b (call p [:take -1])
      c (call p :balance)]
  (stop p)
  (list a b c))|))))

; ── 3. rich metadata, stored as plain data ──────────────────────────────────

(deftest direct-definitions-store-rich-metadata-as-plain-data
  (is (= (list 1 2 3 4)
         (ev "directmetadata" #|
(def ^{:doc "author" :tag String :custom {:nested '([x])}} value "explicit" 1)
(defn- ^{:private false :arglists '([x]) :tag Number :custom [:fn]} function [x] x)
(defmacro ^{:arglists '([form]) :tag MacroTag :custom [:macro]} identity-form [form] form)
(defmacro define-rich [name]
  `(defn ~(vary-meta name assoc
            :arglists (list 'quote (list '[x]))
            :tag 'MacroProvided
            :custom {:origin :macro})
     [x] x))
(define-rich generated)
(list value (function 2) (identity-form 3) (generated 4))|)))

  (let [value-meta (meta-of "directmetadata" "value")]
    (is (= "explicit" (get value-meta :doc)))
    (is (= (tuple :symbol "String") (get value-meta :tag)))
    ; Only an outer metadata quote is stripped; a nested quote stays data.
    (is (= {:nested (list (tuple :symbol "quote") (list [(tuple :symbol "x")]))}
           (get value-meta :custom)))
    (is (not (contains? value-meta :line)))
    (is (not (contains? value-meta :col)))
    (is (not (contains? value-meta :file))))

  (let [function-meta (meta-of "directmetadata" "function")]
    (is (get function-meta :private))
    (is (= (tuple :symbol "Number") (get function-meta :tag)))
    (is (= [:fn] (get function-meta :custom)))
    (is (= (list [(tuple :symbol "x")]) (get function-meta :arglists))))

  (let [macro-meta (meta-of "directmetadata" "identity-form")]
    (is (= (tuple :symbol "MacroTag") (get macro-meta :tag)))
    (is (= [:macro] (get macro-meta :custom))))

  (let [generated-meta (meta-of "directmetadata" "generated")]
    (is (= (tuple :symbol "MacroProvided") (get generated-meta :tag)))
    (is (= {:origin :macro} (get generated-meta :custom)))
    (is (= (list [(tuple :symbol "x")]) (get generated-meta :arglists))))

  (let [source (File/read! "priv/boot/compiler.bl")]
    (is (not (includes? source "(a/normalise meta)")))
    (is (not (includes? source "Macro/escape")))))

; ── 4. `defserver` reload ───────────────────────────────────────────────────

(deftest defserver-reload-replaces-callbacks-and-preserves-client-defaults
  (is (= (list true 3)
         (ev "directserverreload" #|
(defserver counter
  (init [x] (ok x))
  (handle-call :step [_from state] (reply (+ state 1) (+ state 1))))
(def old counter)
(defserver counter
  (init [x] (ok x))
  (handle-call :step [_from state] (reply (+ state 2) (+ state 2))))
(let [p (start counter 1)
      value (call p :step)]
  (stop p)
  (list (= old counter) value))|))))
