(ns compiler-positioned-macroexpand-test)

(defmacro inspect-call [value]
 (list 'quote {:form &form :locals &env :value value}))

(deftest positioned-nonmacro-forms-return-exact-reader-wrappers
 (doseq [source ["(if true :yes :no)" "(identity :value)" "'(inspect-call inert)" "[1 2]"]]
  (let [form (first (BeamLisp.Reader/read_string source "unchanged-reader-form.bl"))]
   (is (erlang/== form (BeamLisp.Compiler/macroexpand_1 form "compiler-positioned-macroexpand-test"))))))

(deftest positioned-expansion-preserves-author-location-and-live-lexical-environment
 (let [namespace "compiler-positioned-macroexpand-test"
       form (first (BeamLisp.Reader/read_string
                    "\n^{:author :retained} (inspect-call marker)" "positioned-macro-call.bl"))
       env (assoc (BeamLisp.Compiler/new_env namespace) :locals {"local" "compiled_local"})
       expanded (erlang/apply :Elixir.BeamLisp.Ns.Compiler :"macroexpand-1-env" (list form env))
       value (BeamLisp.Compiler/eval_form (elem expanded 1) (BeamLisp.Compiler/new_env namespace))]
  (is (= :meta (elem expanded 0)))
  (is (= (elem form 2) (elem expanded 2)))
  (is (= "positioned-macro-call.bl" (:file (elem expanded 2))))
  (is (= 2 (:line (elem expanded 2))))
  (is (= (list 'inspect-call 'marker) (:form value)))
  (is (= {'local "local"} (:locals value)))
  (is (= 'marker (:value value)))))

(deftest public-positioned-macro-entry-matches-actual-normal-compiler-result
 (let [namespace "compiler-positioned-macroexpand-test"
       form (first (BeamLisp.Reader/read_string "(inspect-call :value)" "macro-parity.bl"))
       expanded (BeamLisp.Compiler/macroexpand_1 form namespace)]
  (is (not (erlang/== form expanded)))
  (is (= (BeamLisp.Compiler/eval_form form (BeamLisp.Compiler/new_env namespace))
         (BeamLisp.Compiler/eval_form expanded (BeamLisp.Compiler/new_env namespace))))))
