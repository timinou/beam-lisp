; test/bl/repl_test.bl — the repl's form-completeness scanner (BUG-087).
; Run: bl test test/bl/repl_test.bl
;
; The scanner decides when the repl stops reading and evaluates. Its two
; text-vs-structure rules are what these tests pin down: brackets inside a
; string are text, and brackets inside a `;` comment are text. The second
; rule was inverted until BUG-087 (the comment state ended after one
; character), which is exactly the case the first deftest below covers.

(ns repl.test)

(BeamLisp.Loader/ensure_loaded "bl.repl")
(def balanced? (BeamLisp.Env/fetch! "bl.repl" "balanced?"))

(deftest comments-are-text-to-end-of-line
  ; BUG-087: each of these was judged INCOMPLETE (or complete for the wrong
  ; reason) when the comment state died after one character.
  (is (= true (balanced? "; )")))
  (is (= true (balanced? "(+ 1 2) ; see note (2)")))
  (is (= true (balanced? "; a ] b } c")))
  (is (= true (balanced? "(done) ;")))            ; empty comment
  (is (= true (balanced? "(;(\n)")))              ; bracket in comment, then a real closer
  (is (= false (balanced? "(+ 1 ; comment\n")))   ; the opener is real even with a comment after it
  (is (= true  (balanced? "(+ 1 ; comment\n)"))))

(deftest strings-are-text
  (is (= true (balanced? "(println \"(\")")))
  (is (= true (balanced? "(def s \"\\\"\")")))    ; escaped quote stays inside the string
  (is (= false (balanced? "\"unterminated")))     ; an open string reads another line
  (is (= true (balanced? "\"a\" \"b\""))))

(deftest structure-counts
  (is (= true (balanced? "(+ 1 2)")))
  (is (= false (balanced? "(+ 1")))
  (is (= false (balanced? "]")))
  (is (= false (balanced? "(a [b)")))             ; mismatched closer
  (is (= true (balanced? "(a [b {c}])")))
  (is (= true (balanced? "(map inc [1 2])\n(+ 1 2)")))
  (is (= true (balanced? "")))
  (is (= true (balanced? "  \n  "))))
