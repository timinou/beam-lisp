; test/bl/split/app_test.bl — a split app runs natively on BEAM, and agrees
; with its browser half.
;
; Run: bl test test/bl/split/app_test.bl
;
; Every research showcase is ONE file: `(ns app (:require [split]))`, pure
; defns, one `split/defapp`. This file loads each of them natively and checks
; the two things the browser half depends on:
;
;   • THE DIGEST. The contract a browser carries was hashed by the JS build
;     (research/js-actors/out/<app>.contract.json). The BEAM app value must
;     hash its own declaration to the SAME digest, or no browser could talk
;     to it.
;   • THE DECISIONS. The authority (split.core) answers a scripted run of
;     proposals exactly as the JS authority did: commit, stale, refused,
;     duplicate, outdated, malformed — for groceries, whose rules are simple
;     enough to state here.

(ns split.app-test
  (:require [split] [split.core :as core] [split.wire :as wire] [bl.json]))

(BeamLisp.Env/add_search_path "research/js-actors/apps")
(BeamLisp.Env/add_search_path "research/js-actors")

(def apps ["showcase" "outline" "groceries" "team" "triage" "ledger"])

(defn source-of [stem]
  (File/read! (if (= stem "showcase") "research/js-actors/showcase.bl"
                (str "research/js-actors/apps/" stem ".bl"))))

(defn app-value
  "Load app `stem` natively and answer its app value: the var the file's
   `(split/defapp NAME …)` defines."
  [stem]
  (BeamLisp.Loader/ensure_loaded stem)
  (let [src (source-of stem)
        at (erlang/element 1 (binary/match src "(split/defapp "))
        rest-src (erlang/binary_part src (+ at 14) 64)
        nm (first (String/split rest-src))]
    (BeamLisp.Compiler/eval_string (str stem "/" (String/trim nm)))))

(defn js-digest [stem]
  (get (bl.json/decode (File/read! (str "research/js-actors/out/" stem ".contract.json"))) "digest"))

(deftest every-app-hashes-to-the-browser-digest
  (doseq [stem apps]
    (testing stem
      (let [a (app-value stem)]
        (is (some? a))
        (is (= (js-digest stem) (:digest a)))))))

(defn run [a w proposal] (core/propose a w proposal))

(defn prop [a req rev nonce op args]
  {:request req :revision rev :digest (:digest a) :nonce nonce :actor nil :op op :args args})

(deftest the-authority-decides-on-beam
  (let [a (app-value "groceries")
        w0 (core/initial a)
        [w1 r1 s1 c1] (run a w0 (prop a 1 0 "tab00001:1" :tick-item {:id 1 :got true}))
        [w2 r2 _ _] (run a w1 (prop a 2 1 "tab00001:2" :add-item {:name "Eggs" :aisle :dairy}))
        [_ r3 _ _] (run a w2 (prop a 3 1 "tab00001:3" :remove-item {:id 1}))
        [_ r4 _ _] (run a w2 (prop a 4 2 "tab00001:4" :remove-item {:id 99}))
        [_ r5 s5 c5] (run a w2 (prop a 5 2 "tab00001:2" :add-item {:name "Eggs" :aisle :dairy}))
        [_ r6 _ _] (run a w2 (assoc (prop a 6 2 "tab00001:6" :clear-basket {}) :digest "nope"))
        [_ r7 _ _] (run a w2 (prop a 7 2 "tab00001:7" :tick-item {:id 1 :got "yes"}))
        [_ r8 _ _] (run a w2 (prop a 8 2 "tab00001:8" :fly {}))]
    (testing "a commit advances the revision, publishes, and hands the log a commit"
      (is (= [true 1] [(:ok r1) (:revision r1)]))
      (is (= 1 (:revision s1)))
      (is (= {:id 1 :got true} (:args c1))))
    (testing "an add commits and the board grows"
      (is (= [true 2 8] [(:ok r2) (:revision r2) (count (:items (:board r2)))])))
    (testing "every refusal is named, and nothing is published or logged"
      (is (= :stale-revision (:reason r3)))
      (is (= :no-such-item (:reason r4)))
      (is (= :client-outdated (:reason r6)))
      (is (= :malformed-args (:reason r7)))
      (is (= :unknown-intent (:reason r8))))
    (testing "a repeated nonce is answered once more, committing nothing"
      (is (= [true true 2] [(:ok r5) (:duplicate r5) (:revision r5)]))
      (is (nil? s5))
      (is (nil? c5)))))

(deftest the-wire-counts-codepoints
  (testing "an emoji is one character on both targets"
    (is (= 1 (wire/wire-text-length "🍌")))
    (is (= 2 (wire/wire-text-length "e\u0301")))
    (is (wire/wire-ok? {} [:text 1 1] "🍌"))
    (is (not (wire/wire-ok? {} [:text 1 1] "ab")))))

(deftest a-replayed-log-must-replay
  (let [a (app-value "groceries")
        ok (prop a 1 0 "tab00001:1" :tick-item {:id 1 :got true})
        pid (core/start a {:replay [ok]})]
    (testing "a good log is decided before anything is served"
      (is (= 1 (:revision (core/call pid [:current] :split/current 2000)))))
    (testing "a log line the authority refuses fails the start, naming the revision"
      (let [why (try (core/start a {:replay [ok (prop a 2 5 "tab00001:2" :remove-item {:id 1})]}) :started
                     (catch e (ex-data e)))]
        (is (= :stale-revision (:reason why)))))))

(deftest nothing-is-acknowledged-that-is-not-on-disk
  (let [a (app-value "groceries")
        logged (atom [])
        good (core/start a {:commit! (fn [c] (swap! logged conj (:revision (:entry c))))})
        broken (core/start a {:commit! (fn [_] (throw (ex-info "disk full" {})))})
        p (prop a 1 0 "tab00001:1" :tick-item {:id 1 :got true})]
    (testing "a commit reaches the log before its answer"
      (let [r (core/call good [:intent p] :split/result 2000)]
        (is (= [true 1] [(:ok r) (:revision r)]))
        (is (= [1] @logged))))
    (testing "a log that refuses: no answer is ever sent, and the authority is gone"
      (is (= :down (core/call broken [:intent p] :split/result 2000)))
      (is (= :down (core/call broken [:current] :split/current 500))))
    (testing "a refusal commits nothing and logs nothing"
      (let [r (core/call good [:intent (prop a 2 0 "tab00001:2" :tick-item {:id 1 :got true})]
                         :split/result 2000)]
        (is (= :stale-revision (:reason r)))
        (is (= [1] @logged))))))

(deftest an-old-answer-never-answers-a-new-question
  (let [a (app-value "groceries")
        pid (core/start a {})
        slow (erlang/make_ref)]
    ; a stale answer to an earlier call, still in this mailbox
    (erlang/send (erlang/self) [:split/current slow {:revision 999}])
    (testing "call accepts only the answer carrying its own fresh reference"
      (is (= 0 (:revision (core/call pid [:current] :split/current 2000)))))
    (testing "the stale message is still there, untouched"
      (is (= 999 (receive [:split/current r v] :when (= r slow) (:revision v) (after 100 :none)))))))
