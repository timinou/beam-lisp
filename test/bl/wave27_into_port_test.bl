; wave27_into_port_test.bl — `into` across every target kind, plus the transducer
; arities of map/filter and `merge`, ported from the ExUnit
; `test/beam_lisp/wave27_into_test.exs`.
;
; `into` was the last genuine failure in the 120-slice jank sample, and it failed
; for two unrelated reasons that both had to close before it could be promoted:
;
;   1. `BeamLisp.Transient.conj!/2` had clauses for vector and set transients
;      only, so `into`'s fast path exploded the moment the target was a map.
;   2. Core `map`/`filter` had no 1-arity transducer form, so
;      `(into [] (map inc) coll)` died at xform CONSTRUCTION — before `into`'s
;      body ran at all.
;
; WHY THIS PORT IS MOSTLY PLAIN EXPRESSIONS
;
; The ExUnit suite wrapped every expression in `eval/1`
; (`BeamLisp.Compiler.eval_string(code, new_env("user"))`) because the ExUnit
; process is not the language under test. A BL deftest IS the runtime, so each
; form is evaluated in place — the same compiler path, no eval round-trip (the
; idiom of wave27_for_port_test.bl). Two shapes still need a driver:
;   * the two REFUSALS — `is` records an exception raised INSIDE a form as an
;     ERROR, so a raising call is wrapped in a thunk and its struct inspected;
;   * `defrecord W27M` — declared through `eval-in`, exactly as the original did,
;     so the constructor exists before the merge is evaluated.
;
; THE ExUnit `assert_raise` TRANSLATION, PRECISELY
;   `assert_raise ArgumentError, fn -> eval(SRC) end`
;     → `(is (= :Elixir.ArgumentError (:__struct__ (caught (fn [] SRC')))))`
; The struct name is the contract the original pinned; asserting only "raises"
; would pass on the WRONG internal failure, which is exactly the corruption the
; wrong-shape-entry test exists to catch.
;
; ASSERTION MAP (ExUnit test → BL deftest), all 15 originals, none dropped:
;   into, across every target kind:
;     a vector target keeps vector-ness and order   → a-vector-target-keeps-vector-ness-and-order
;     a map target accepts both entry shapes        → a-map-target-accepts-both-entry-shapes
;     a set target dedupes                          → a-set-target-dedupes
;     an entry of the wrong shape fails loudly…     → an-entry-of-the-wrong-shape-fails-loudly-rather-than-mis-binding
;     the empty and identity arities upstream declares → the-empty-and-identity-arities-upstream-declares
;     nil punning follows Clojure                   → nil-punning-follows-clojure
;     a reference type is not a source…             → a-reference-type-is-not-a-source-the-wave-1-hole-stays-shut
;   transducer arities:
;     (map f) with no collection returns a transducer → map-with-no-collection-returns-a-transducer
;     (filter pred) with no collection returns a transducer → filter-pred-with-no-collection-returns-a-transducer
;     a transducer works into a map target too      → a-transducer-works-into-a-map-target-too
;     the collection arities are untouched…         → the-collection-arities-are-untouched-by-the-transducer-forms
;     laziness survives the rebinding               → laziness-survives-the-rebinding
;   merge:
;     later keys win and nils are skipped           → merge-later-keys-win-and-nils-are-skipped
;     merging nothing is nil, so (apply merge '()) works → merging-nothing-is-nil-so-apply-merge-works
;     a record merges as the map it is, yielding a plain map → a-record-merges-as-the-map-it-is-yielding-a-plain-map
;
; Run: bin/bl test test/bl/wave27_into_port_test.bl

(ns wave27.into.test)

(defn- caught
  "The exception `thunk` raises, or nil when it returns normally — the value the
   ExUnit `assert_raise` inspected."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

(defn- eval-in
  "Compile-and-eval `source` in a fresh `user` env — the driver the ExUnit
   `eval/1` used (needed for `defrecord`, which the original evaluated)."
  [source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "user")))

; --- into, across every target kind -----------------------------------------

(deftest a-vector-target-keeps-vector-ness-and-order
  (is (= [1 2 3] (into [] [1 2 3])))
  (is (= [0 1 2] (into [0] [1 2])))
  ; A list source reduces through the same path; `[] != ()` is a deliberate
  ; distinction in this language, so the RESULT must be the vector the target
  ; asked for, whatever the source was.
  (is (= [1 2] (into [] '(1 2)))))

(deftest a-map-target-accepts-both-entry-shapes
  ; `seq` over a map yields 2-element vectors, and a literal `[k v]` source
  ; reduces to the same shape — this is what `conj!` accepts.
  (is (= {:a 1 :b 2} (into {} [[:a 1] [:b 2]])))
  ; A quoted 2-element LIST is the other legal entry spelling.
  (is (= {:a 1} (into {} '((:a 1)))))
  ; Map into map, entries taken via seq.
  (is (= {:a 1} (into {} {:a 1})))
  ; A later duplicate key wins, as assoc would.
  (is (= {:a 9} (into {} [[:a 1] [:a 9]]))))

(deftest a-set-target-dedupes
  (is (= '(1 2) (sort (BeamLisp.Set/to_list (into (set []) [1 2 2]))))))

(deftest an-entry-of-the-wrong-shape-fails-loudly-rather-than-mis-binding
  ; Silently taking the first two elements of a 3-vector would corrupt the map
  ; with a plausible-looking result — the worst kind of failure.
  (is (= :Elixir.ArgumentError
         (:__struct__ (caught (fn [] (into {} [[:a 1 :extra]])))))))

(deftest the-empty-and-identity-arities-upstream-declares
  (is (= [] (into)))
  (is (= [9] (into [9])))
  (is (= [] (into [] [])))
  (is (= {} (into {} []))))

(deftest nil-punning-follows-clojure
  (is (= [] (into [] nil))))

(deftest a-reference-type-is-not-a-source-the-wave-1-hole-stays-shut
  ; Reference types are not collections. If `into` ever starts reading one, it
  ; is reading %Atom{}'s internal struct fields.
  (is (= :Elixir.ArgumentError
         (:__struct__ (caught (fn [] (into [] (atom 1))))))))

; --- transducer arities ------------------------------------------------------

(deftest map-with-no-collection-returns-a-transducer
  (is (= [2 3 4] (into [] (map inc) [1 2 3])))
  (is (= [] (into [] (map inc) []))))

(deftest filter-pred-with-no-collection-returns-a-transducer
  (is (= [1 3] (into [] (filter odd?) [1 2 3])))
  (is (= [] (into [] (filter odd?) [2 4]))))

(deftest a-transducer-works-into-a-map-target-too
  (is (= {:a 1} (into {} (map identity) [[:a 1]]))))

(deftest the-collection-arities-are-untouched-by-the-transducer-forms
  ; `map`/`filter` were REBOUND to add their 1-arity forms. The collection
  ; arities must still delegate to the original chunked-lazy primitives — a
  ; second, Lisp-level lazy implementation would be a parallel impl of something
  ; that already exists, and would drift.
  (is (= '(2 3) (doall (map inc [1 2]))))
  (is (= '(1 3) (doall (filter odd? [1 2 3]))))
  ; multi-collection map is part of that same primitive
  (is (= '(11 22) (doall (map + [1 2] [10 20])))))

(deftest laziness-survives-the-rebinding
  ; This is the PLAN-010 guarantee and the thing most at risk from redefining
  ; `map`: if the rebound map were eager, this would realize a million cells.
  ; Counting, not timing — timing proves speed, only a count proves laziness.
  (let [realized (atom 0)
        head (doall (take 3 (map (fn [x] (do (swap! realized inc) (inc x)))
                                 (range 1 1000000))))]
    (is (= '(2 3 4) head))
    ; Chunked at 32: one chunk, not a million.
    (is (= 32 (deref realized)))))

; --- merge -------------------------------------------------------------------

(deftest merge-later-keys-win-and-nils-are-skipped
  (is (= {:a 1 :b 2} (merge {:a 1} {:b 2})))
  (is (= {:a 9} (merge {:a 1} {:a 9})))
  (is (= {:a 1} (merge nil {:a 1})))
  (is (= {:a 1} (merge {:a 1} nil)))
  (is (= {:a 1 :b 2 :c 3} (merge {:a 1} {:b 2} {:c 3}))))

(deftest merging-nothing-is-nil-so-apply-merge-works
  ; Clojure returns nil rather than {} for the empty case, which is what makes
  ; `(apply merge maps)` safe on an empty seq.
  (is (nil? (merge)))
  (is (nil? (apply merge []))))

(deftest a-record-merges-as-the-map-it-is-yielding-a-plain-map
  (eval-in "(defrecord W27M [x y])")
  ; The result carries a key the record's type never declared, so it cannot
  ; remain that type.
  (is (= {:x 1 :y 2 :z 3} (eval-in "(merge (->W27M 1 2) {:z 3})"))))
