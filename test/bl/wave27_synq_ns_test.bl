; wave27_synq_ns_test.bl — syntax-quote resolves symbols in the namespace that
; WROTE the template, and emits them qualified — as Clojure does; ported from the
; ExUnit `test/beam_lisp/wave27_synq_ns_test.exs`.
;
; Without this, a macro could not call its own helper. Expanding `(helper x)` at
; a call site in another namespace produced a bare `helper`, which then resolved
; against the CALLER and failed with "undefined var: caller-ns/helper". That is
; the ordinary shape of every library macro, so the gap was reachable by anyone
; writing one — it was found by loading Specter's navigator stack across
; namespaces, but nothing about it is Specter-specific.
;
; The subtlety is what must NOT be qualified:
;
;   * a **macro** — the expander (`macro_for/2`) already searches the writing
;     namespace and core. Qualifying one sent it down the ordinary var path where
;     it was invoked as a function, which broke every vendored jank macro that
;     nests `when` or `let` inside its template.
;   * a **gensym** (`x#`) — already unique by construction.
;   * a name the template **introduces** (a `let` binding, a fn parameter, a var
;     defined later) — it has no meaning in the writing namespace and must
;     resolve at the expansion site.
;   * a **special form** — not a var at all.
;
; WHERE THE ExUnit `eval` WENT
;
; The ExUnit suite drove `BeamLisp.Compiler.eval_string(code, new_env(ns))` from
; a test process, one fresh namespace per call. A BL deftest IS the runtime, so
; `eval-in` runs the whole scenario — its `(ns …)` switches included — in one
; `env/eval`, inside an `env/isolated` fork. `eval_string` compiles each
; top-level form as its own unit (`eval_form` per form, re-reading the current ns
; between them), so the macro is still compiled in the LIBRARY namespace and the
; call in the APPLICATION namespace — the two-compilation-unit shape the original
; pinned. The fork contains every namespace a scenario defines, so no scenario's
; `lib`/`app` can shadow a sibling's or leak into the image.
;
; ASSERTION MAP (ExUnit test → BL deftest), all 6 originals, none dropped:
;   a macro can call its own helper from another namespace
;     → a-macro-can-call-its-own-helper-from-another-namespace          (== 500)
;   a helper defined AFTER the macro still resolves
;     → a-helper-defined-after-the-macro-still-resolves                 (== 8)
;   a template's own bindings are not qualified
;     → a-templates-own-bindings-are-not-qualified                      (== 42)
;   a macro nested in a template still expands
;     → a-macro-nested-in-a-template-still-expands                      (:positive then nil)
;   a core function used in a template resolves from the call site
;     → a-core-function-used-in-a-template-resolves-from-the-call-site   (== 8)
;   the caller's own binding of the same name does not capture the helper
;     → the-callers-own-binding-of-the-same-name-does-not-capture-the-helper (== 30)
;
; Run: bin/bl test test/bl/wave27_synq_ns_test.bl

(ns wave27.synq-ns.test
  (:require [env]))

(defn- eval-in
  "Run a whole scenario — its `(ns …)` switches included — inside an isolated
   fork, returning the last form's value. The direct equivalent of the ExUnit
   `eval(ns, code)` helper (`eval_string(code, new_env(ns))`): the same compiler
   path, with the fork containing everything the scenario defines."
  [src]
  (env/isolated (fn [] (env/eval src))))

(deftest a-macro-can-call-its-own-helper-from-another-namespace
  ; The whole point. Before the fix this raised "undefined var: synqapp/mult".
  (is (= 500
         (eval-in
           "(ns w27synq.lib1)
            (defn mult [x] (* x 100))
            (defmacro use-mult [v] `(mult ~v))
            (ns w27synq.app1)
            (w27synq.lib1/use-mult 5)"))))

(deftest a-helper-defined-after-the-macro-still-resolves
  ; Qualification is decided when the template is compiled, so a helper the
  ; library defines later must still be reachable. `declare` is the usual way to
  ; say so.
  (is (= 8
         (eval-in
           "(ns w27synq.lib2)
            (declare later-helper)
            (defmacro use-later [v] `(later-helper ~v))
            (defn later-helper [x] (+ x 7))
            (ns w27synq.app2)
            (w27synq.lib2/use-later 1)"))))

(deftest a-templates-own-bindings-are-not-qualified
  ; `t` is introduced by the template. Qualifying it would produce `lib/t`, which
  ; is not a binding at all. `t#` is a gensym — unique by construction.
  (is (= 42
         (eval-in
           "(ns w27synq.lib3)
            (defmacro twice [v] `(let [t# ~v] (+ t# t#)))
            (ns w27synq.app3)
            (w27synq.lib3/twice 21)"))))

(deftest a-macro-nested-in-a-template-still-expands
  ; This is the regression that the vendored jank macro slices caught: the
  ; template nests `when`, and qualifying it would invoke it as a function.
  (let [r (eval-in
            "(ns w27synq.lib4)
             (defmacro pos-only [v] `(when (> ~v 0) :positive))
             (ns w27synq.app4)
             [(w27synq.lib4/pos-only 5) (w27synq.lib4/pos-only -5)]")]
    (is (= :positive (nth r 0)))
    (is (= nil (nth r 1)))))

(deftest a-core-function-used-in-a-template-resolves-from-the-call-site
  (is (= 8
         (eval-in
           "(ns w27synq.lib5)
            (defmacro doubled [v] `(* 2 ~v))
            (ns w27synq.app5)
            (w27synq.lib5/doubled 4)"))))

(deftest the-callers-own-binding-of-the-same-name-does-not-capture-the-helper
  ; The real hygiene payoff: the caller has a LOCAL named `shadow`, and the
  ; macro's template refers to its own `shadow`. Unqualified, the expansion would
  ; silently pick up the caller's.
  (is (= 30
         (eval-in
           "(ns w27synq.lib6)
            (defn shadow [x] (* x 10))
            (defmacro use-shadow [v] `(shadow ~v))
            (ns w27synq.app6)
            (defn shadow [x] :WRONG)
            (w27synq.lib6/use-shadow 3)"))))
