; test/bl/wave28_engine_test.bl — the navigation algebra, ported from
; test/beam_lisp/wave28_engine_test.exs.
;
; NONE, comp-paths*, combine-two-navs and the two traversal entry points. The
; suite is about PROPERTIES rather than cases: the engine's correctness is a
; handful of invariants every navigator and every path must preserve, and the
; examples exist to demonstrate the invariants, not the other way round.
;
; WHERE THE ExUnit `eng` WENT
;
; The ExUnit suite drove `BeamLisp.Compiler.eval_string/2` once per test,
; building a throwaway namespace that required specter.engine and evaluating one
; body in it. That shape is kept — `eng` below is the same helper, called per
; assertion group. The reason is the one the original gives: an alias belongs to
; the `(ns …)` form that introduced it and does not survive into a later
; evaluation, and a protocol name (`RichNavigator`) is reached the same way,
; through the `:refer :all` a fresh `(ns …)` performs. `async: false` has no BL
; equivalent: `bl test` isolates every FILE in its own fork by default, which is
; strictly stronger than an `async: false` ExUnit case.
;
; ASSERTION MAP (ExUnit test → BL deftest), all 16 originals, none dropped:
;   NONE — the sentinel
;     is identity-stable however it is reached
;       → none-is-identity-stable-however-it-is-reached          (5 assertions)
;     survives a message send, which copies every other term
;       → none-survives-a-message-send-which-copies-every-other-term
;     is not confusable with a lookalike keyword
;       → none-is-not-confusable-with-a-lookalike-keyword        (5 assertions)
;     a structure may legitimately contain a keyword and stay data
;       → a-structure-may-legitimately-contain-a-keyword-and-stay-data
;   the navigator protocol
;     STAY* navigates to the structure itself
;       → stay-navigates-to-the-structure-itself                 (2 assertions)
;     rich-nav? distinguishes navigators from data
;       → rich-nav-distinguishes-navigators-from-data
;     coerce-object refuses a value nothing can coerce
;       → coerce-object-refuses-a-value-nothing-can-coerce        (typed: ExInfo)
;   composition
;     an empty path is the identity navigator
;       → an-empty-path-is-the-identity-navigator
;     a single-element path is that element, uncomposed
;       → a-single-element-path-is-that-element-uncomposed
;     an already-compiled navigator passes through unchanged
;       → an-already-compiled-navigator-passes-through-unchanged
;     composition nests continuations, left to right
;       → composition-nests-continuations-left-to-right
;     composes to arbitrary depth
;       → composes-to-arbitrary-depth
;     a nested path vector composes as its elements
;       → a-nested-path-vector-composes-as-its-elements
;   traversal
;     the terminal fn receives the bare structure when nothing collected
;       → the-terminal-fn-receives-the-bare-structure-when-nothing-collected
;     and collected values alongside it when something was
;       → and-collected-values-alongside-it-when-something-was
;     an empty vals is distinguished from having collected nothing
;       → an-empty-vals-is-distinguished-from-having-collected-nothing
;
; Adaptations, and why:
;   * `assert_raise BeamLisp.ExInfo, fn -> … end` becomes a typed `catch`
;     clause: the exception TYPE and the message ("Not a navigator") ARE the
;     contract, so both are asserted — never merely "it refused". A catch-all
;     would pass on the WRONG error, and a different exception type now
;     propagates out of the `try` and fails the test, which is the point.
;   * `BeamLisp.Vector.new(list)` disappears: on the BL side a vector literal
;     IS the vector, so `v([true …])` is written `[true …]`.
;   * Multi-line eval bodies are literal multi-line BL strings, not Elixir
;     heredocs — the same bytes the compiler sees, without `\n` escapes.
;   * `erlang/spawn` does not inherit the file's env. The runner gives every
;     FILE its own env fork, and a bare spawn resolves at `:global` — the
;     documented L2 contract, itself held by test/bl/env_isolation_test.bl. The
;     ExUnit test process carried NO env binding, so its spawned child DID see
;     the throwaway namespace; here the parent captures its env with
;     `BeamLisp.Env/capture` and the child `bind`s it. That difference is the
;     runner's env, not the engine's semantics, and the property under test —
;     an atom survives a message send that copies every other term — is
;     unchanged.
;
; Run: bin/bl test test/bl/wave28_engine_test.bl

(ns wave28.engine.test)

(BeamLisp/init)

; Each test compiles its own throwaway namespace requiring the engine. One eval
; per body, because an alias belongs to the `(ns …)` form that introduced it and
; does not survive into a later evaluation.
(defn- eng [body]
  (BeamLisp.Compiler/eval_string
    (str "(ns w28e." (erlang/unique_integer (list :positive))
         " (:require [specter.engine :refer :all]))\n" body)
    (BeamLisp.Compiler/new_env "user")))

; ── NONE — the sentinel ───────────────────────────────────────────────────

(deftest none-is-identity-stable-however-it-is-reached
  ; On the BEAM an atom is globally interned, so identity holds by construction
  ; rather than by a cache's good behaviour. This is the one place the BEAM is
  ; STRONGER than the JVM, and the engine's whole control flow rests on it.
  (is (= true (eng "(none? NONE)")))
  (is (= true (eng "(identical? NONE NONE)")))
  ; reached through a collection, a function return, and a rebinding
  (is (= true (eng "(none? (first [NONE]))")))
  (is (= true (eng "(none? ((fn [] NONE)))")))
  (is (= true (eng "(let [x NONE] (none? x))"))))

(deftest none-survives-a-message-send-which-copies-every-other-term
  ; The BEAM copies terms between processes. An atom is the exception: it is the
  ; same interned word on both sides. If that were not true, a navigator running
  ; in another process could not report NONE.
  ; A bare spawn resolves at :global (the documented L2 contract), and this file
  ; runs in the runner's own fork, so the child is handed the parent's env
  ; explicitly — see the header.
  (is (= true
         (eng "
           (let [me (erlang/self)
                 token (BeamLisp.Env/capture)]
             (erlang/spawn (fn [] (BeamLisp.Env/bind token) (erlang/send me NONE)))
             (receive x (none? x)))"))))

(deftest none-is-not-confusable-with-a-lookalike-keyword
  (is (= false (eng "(none? :other)")))
  (is (= false (eng "(none? :NONE)")))
  (is (= false (eng "(none? :specter.engine/none)")))
  (is (= false (eng "(none? nil)")))
  (is (= false (eng "(none? false)"))))

(deftest a-structure-may-legitimately-contain-a-keyword-and-stay-data
  ; The hazard a sentinel always carries: user data that looks like control
  ; flow. A keyword-valued map must survive selection unharmed.
  (is (= false (eng "(none? (get {:k :NONE} :k))"))))

; ── the navigator protocol ────────────────────────────────────────────────

(deftest stay-navigates-to-the-structure-itself
  (is (= true (eng "(rich-nav? STAY*)")))
  (is (= 42 (eng "(select* STAY* [] 42 (fn [vals s] s))"))))

(deftest rich-nav-distinguishes-navigators-from-data
  ; rich-nav? asks whether a value ALREADY implements the protocol, not whether
  ; it could be coerced into one — so 42 stays false even once specter/navs.bl
  ; has taught the coercer to accept it.
  (is (= [true false false false]
         (eng "[(rich-nav? STAY*) (rich-nav? 42) (rich-nav? :a) (rich-nav? [1])]"))))

(deftest coerce-object-refuses-a-value-nothing-can-coerce
  ; "Not a navigator" alone is the least useful message a path error could
  ; carry; the offending value and its type must be in it.
  ;
  ; The value has to be one NO ImplicitNav extension claims, and that set
  ; shrinks as navigators load: specter/navs.bl extends integers, keywords,
  ; strings and functions, and those registrations are global and outlive the
  ; file that made them. An earlier version of this test used 42 and passed only
  ; when it ran before navs.bl had ever loaded — a seed-dependent failure, which
  ; on this project means a leak rather than a flake. A boolean is coerced by
  ; nothing and is not plausibly a future shorthand.
  (is (try
        (do (eng "(coerce-object true)") false)
        (catch BeamLisp.ExInfo e
          (includes? (ex-message e) "Not a navigator")))))

; ── composition ───────────────────────────────────────────────────────────

(deftest an-empty-path-is-the-identity-navigator
  ; Navigating nowhere is still navigating: (select [] x) must yield x, not an
  ; error.
  (is (= true (eng "(identical? (comp-paths* []) STAY*)"))))

(deftest a-single-element-path-is-that-element-uncomposed
  ; No wrapper: composition of one thing is the thing. Checked observably, since
  ; the navigator is a reify with no name.
  (is (= [true true]
         (eng "
           (let [n (comp-paths* [STAY*])]
             [(rich-nav? n) (identical? n STAY*)])"))))

(deftest an-already-compiled-navigator-passes-through-unchanged
  (is (= true (eng "(identical? (comp-paths* STAY*) STAY*)"))))

(deftest composition-nests-continuations-left-to-right
  ; The heart of the engine. Two navigators that each record their name prove
  ; the ORDER: the leftmost is outermost.
  (is (= [:outer :inner]
         (eng "
           (let [trace (volatile! [])
                 mk (fn [nm] (reify RichNavigator
                               (select* [this vals s nf]
                                 (vswap! trace conj nm)
                                 (nf vals s))
                               (transform* [this vals s nf] (nf vals s))))
                 p (comp-paths* [(mk :outer) (mk :inner)])]
             (select* p [] :x (fn [vals s] s))
             @trace)"))))

(deftest composes-to-arbitrary-depth
  ; Five levels, each incrementing, so the answer proves every layer ran exactly
  ; once and in order.
  (is (= 5
         (eng "
           (let [bump (reify RichNavigator
                        (select* [this vals s nf] (nf vals (inc s)))
                        (transform* [this vals s nf] (nf vals (inc s))))
                 p (comp-paths* [bump bump bump bump bump])]
             (select* p [] 0 (fn [vals s] s)))"))))

(deftest a-nested-path-vector-composes-as-its-elements
  ; [[a b] c] and [a b c] must be the same navigator, because a sub-path is a
  ; path.
  (is (= [3 3]
         (eng "
           (let [bump (reify RichNavigator
                        (select* [this vals s nf] (nf vals (inc s)))
                        (transform* [this vals s nf] (nf vals (inc s))))
                 flat (comp-paths* [bump bump bump])
                 nested (comp-paths* [[bump bump] bump])]
             [(select* flat [] 0 (fn [v s] s))
              (select* nested [] 0 (fn [v s] s))])"))))

; ── traversal ─────────────────────────────────────────────────────────────

(deftest the-terminal-fn-receives-the-bare-structure-when-nothing-collected
  (is (= 42 (eng "(compiled-traverse* STAY* (fn [x] x) 42)"))))

(deftest and-collected-values-alongside-it-when-something-was
  ; A navigator that pushes onto vals makes the terminal fn receive a vector of
  ; [collected… structure] — the mechanism behind putval.
  (is (= [:c 42]
         (eng "
           (let [collect (reify RichNavigator
                           (select* [this vals s nf] (nf (conj vals :c) s))
                           (transform* [this vals s nf] (nf (conj vals :c) s)))]
             (compiled-traverse* collect (fn [x] x) 42))"))))

(deftest an-empty-vals-is-distinguished-from-having-collected-nothing
  ; Upstream checks this explicitly, and it matters: a navigator may collect on
  ; one branch and not another, so "vals is empty" cannot be conflated with
  ; "this traversal collects".
  (is (= 42 (eng "(compiled-traverse-with-vals* STAY* (fn [x] x) [] 42)")))
  (is (= [:a 42] (eng "(compiled-traverse-with-vals* STAY* (fn [x] x) [:a] 42)"))))
