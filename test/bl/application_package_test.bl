(ns application.package-test
 (:require [application.package :as package] [bl.loading :as loading]))
(defn refused? [action] (try (action) false (catch _ true)))
(deftest package-runtime-api-has-consistent-library-freshness-authority
 (let [path (BeamLisp.Loader/source_path "application.package")]
  (is (= :library (BeamLisp.Tiers/tier_of_ns "application.package")))
  (is (not (BeamLisp.Tiers/build_source? path)))
  (is (= (BeamLisp.AOTCache/key_for_source path)
         (BeamLisp.AOTCache/key_for_ns "application.package")))))
(deftest replay-admission-keeps-unknown-effects-on-source
 (is (package/replayable? "(ns package.simple) (defn f [x] (+ x 1)) (def value 4)"))
 (doseq [source ["(ns a) (File/write! \"somewhere\" \"effect\")"
                 "(ns a) (custom-defining-macro)" "(ns a) (ns b) (def x 1)"
                 "(println 1)" "(ns a) (unregistered-definer S [])"]]
  (is (not (package/replayable? source)))))
(deftest closure-refuses-invalid-and-recursive-entry-roots-before-source-lookup
 (doseq [root ["../outside" "a/b" "a\\b" "a..b" "" "package.entry"]]
  (is (refused? (fn [] (package/closure "(ns package.entry)" [root]))))))
(deftest package-policy-is-optional-and-validates-environment-name
 (is (nil? (:package-env (loading/validate nil))))
 (is (= "APP_PACKAGE" (:package-env (loading/validate {:package-env "APP_PACKAGE"}))))
 (doseq [value [true 1 ""]]
  (is (refused? (fn [] (loading/validate {:package-env value}))))))
(deftest immutable-package-validates-entry-runtime-and-every-byte
 (let [root (str (System/tmp_dir!) "/application-package-" (erlang/unique_integer (list :positive)))
       source (str root "/src") output (str root "/release") entry (str root "/main.bl")
       stale (str output ".building-1")
       program "(ns package.entry (:require [package.fixture]))"
       library "(ns package.fixture) (defn answer [] 42)"]
  (try
   (File/mkdir_p! (str source "/package"))
   (File/write! entry program)
   (File/mkdir_p! stale) (File/write! (str stale "/untrusted-leftover") "old")
   (File/write! (str source "/package/fixture.bl") library)
   (BeamLisp.Loader/with_search_dir source
    (fn []
     (let [built (package/build! entry output []) verified (package/verify! output)]
      (is (= ["package.fixture"] (:namespaces verified)))
      (is (= ["package.fixture"] (:artifacts verified)))
      (is (= [] (:source-fallback verified)))
      (is (not (contains? (:files verified) "untrusted-leftover")))
      (is (= "old" (File/read! (str stale "/untrusted-leftover"))))
      (is (> (:built built) 0))
      (is (refused? (fn [] (package/build! entry output []))))
      (is (refused? (fn [] (package/install! output (str program "\n(def changed 1)") []))))
      (is (refused? (fn [] (package/install! output program ["extra"]))))
      (File/write! (str source "/package/fixture.bl") (str library "\n(def drift 1)"))
      (is (refused? (fn [] (package/install! output program []))))
      (File/write! (str source "/package/fixture.bl") library)
      (File/write! (str output "/extra") "unlisted")
      (is (refused? (fn [] (package/verify! output))))
      (File/rm! (str output "/extra"))
      (File/write! (str output "/source/package/fixture.bl") (str library "\n"))
      (is (refused? (fn [] (package/verify! output)))))))
   (finally (File/rm_rf! root)))))

(deftest package-consumers-preserve-source-effects-across-fresh-vms
 (let [root (str (System/tmp_dir!) "/package-consumer-" (erlang/unique_integer (list :positive)))
       source (str root "/src") output (str root "/release") entry (str root "/main.bl")
       consumer (str root "/consumer.bl") marker (str root "/effect")
       program "(ns package.consumer-entry (:require [package.consumer-leaf]))"]
  (try
   (File/mkdir_p! (str source "/package"))
   (File/write! entry program)
   (File/write! (str source "/package/consumer-leaf.bl")
    "(ns package.consumer-leaf (:require [package.consumer-effect])) (defn answer [] 42)")
   (File/write! (str source "/package/consumer-effect.bl")
    (str "(ns package.consumer-effect) (File/write! " (pr-str marker) " \"ran\") (def ready true)"))
   (BeamLisp.Loader/with_search_dir source
    (fn []
     (let [built (package/build! entry output [])]
      (is (= ["package.consumer-effect"] (:source-fallback built)))
      (is (= ["package.consumer-leaf"] (:artifacts built))))))
   (File/write! consumer
    (str "(ns package.consume (:require [application.package])) "
     "(application.package/install! " (pr-str output) " " (pr-str program) " []) "
     "(BeamLisp.Loader/with_search_dir " (pr-str (str output "/source")) " (fn [] "
     "(BeamLisp.Loader/ensure_loaded \"package.consumer-leaf\") "
     "(assert (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! \"package.consumer-leaf\" \"answer\") (list)))) "
     "(assert (String/starts_with? (erlang/list_to_binary (code/which (BeamLisp.Emit/module_for \"package.consumer-leaf\"))) "
     (pr-str (str output "/ebin/")) ")) "
     "(assert (= \"ran\" (File/read! " (pr-str marker) "))) "
     "(println \"PACKAGE_CONSUMER_OK\")))"))
   ;; The second VM also has a warm disk cache. AOT replay must never erase
   ;; the source-only initializer, even when a producer previously loaded it.
   (doseq [_ (range 2)]
    (File/rm marker)
    (let [[text status] (System/cmd (Path/expand "bin/bl" (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))) (list "run" consumer)
                         (list (tuple :stderr_to_stdout true)
                               (tuple :env (list (tuple "BL_DAEMON" "off")))))]
     (is (= 0 status) text)
     (is (String/contains? text "PACKAGE_CONSUMER_OK") text)))
   (finally (File/rm_rf! root)))))
