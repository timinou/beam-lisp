; wave27_taggedlet_test.bl — `^Tag` metadata on binding targets is a no-op,
; ported from the ExUnit `test/beam_lisp/wave27_taggedlet_test.exs` (Wave 27).
;
; The Specter re-measurement landed on `(let [^com.rpl.specter.RichNavigator g
; v] ...)` failing with "unsupported binding pattern" — a compile-time error. In
; Clojure a type hint on a binding is an *optimization hint*: semantically inert,
; and ignoring it is completely faithful. Wave 25 taught the reader to parse
; `^Tag`, `^:kw` and `^{:map …}` in all three shorthands; this file pins the
; compiler's side — every binding position accepts a tagged symbol and binds the
; bare name, with the metadata never leaking into the runtime value.
;
; Binding positions covered: `let`/`let*`, `loop`, `fn`/`defn` params, `for`
; (which routes through `let`), and — by deliberate decision — tagged symbols
; INSIDE a destructuring pattern (`[^long a b]`, `{:keys [^long a]}`), because
; the leading peel clause recurses over nested patterns and Clojure likewise
; ignores the hint there.
;
; Wave-20 source-position contract: these are separate from
; wave20_reader_pos_test.exs, which must stay green untouched.
;
; WHERE THE ExUnit `eval` WENT
;
; The ExUnit suite drove `BeamLisp.Compiler.eval_string/2` from a test process
; (`eval(src)` → `new_env("w27t")`) because the ExUnit process is not the
; language under test. A BL deftest IS the runtime, so each form is written in
; place — the same compiler path with no eval round-trip (the idiom of
; wave27_destructure_port_test.bl). The only ExUnit helper that is gone is
; `to_list`: the originals normalized `%BeamLisp.Vector{}`/`%BeamLisp.LazySeq{}`
; to an Elixir list before asserting. In BL the literals ARE BL values, so the
; assertions compare BL vectors directly and realize a `for` seq with `doall`
; (`'(10 20)` where the original wrote `[10, 20]`).
;
; ASSERTION MAP (ExUnit test → BL deftest), all 16 originals, none dropped:
;   let: tagged symbol binds the bare name              → let-tagged-symbol-binds-the-bare-name
;   let: keyword metadata is equally a no-op            → let-keyword-metadata-is-equally-a-no-op
;   let: stacked metadata collapses to the bare binding → let-stacked-metadata-collapses-to-the-bare-binding
;   let: metadata never leaks into the runtime value    → let-metadata-never-leaks-into-the-runtime-value  (3 assertions)
;   let*: tagged binding works                          → let-star-tagged-binding-works
;   fn: tagged param binds the bare name                → fn-tagged-param-binds-the-bare-name
;   defn: tagged param binds the bare name              → defn-tagged-param-binds-the-bare-name
;   loop: tagged binding works and recurs               → loop-tagged-binding-works-and-recurs
;   for: tagged binding routes through the let destructurer → for-tagged-binding-routes-through-the-let-destructurer
;   tagged symbol inside a vector destructuring pattern → tagged-symbol-inside-a-vector-destructuring-pattern-is-accepted
;   tagged symbol inside a :keys destructuring pattern  → tagged-symbol-inside-a-keys-destructuring-pattern-is-accepted
;   tagged :as name in a map pattern                    → tagged-as-name-in-a-map-pattern-binds-the-whole-collection
;   tagged :as name in a vector pattern                 → tagged-as-name-in-a-vector-pattern-binds-the-whole-collection
;   tagged :or default key provides the fallback        → tagged-or-default-key-provides-the-fallback
;   tagged binding composes with a destructured fn param → tagged-binding-composes-with-a-destructured-fn-param
;   def/defn NAME metadata path is untouched            → def-defn-name-metadata-path-is-untouched
;
; Run: bin/bl test test/bl/wave27_taggedlet_test.bl

(ns wave27.taggedlet.test)

; The two `defn` shapes the originals evaluated in "w27t": a tagged param, and a
; `^:private` NAME (the def/defn metadata path Wave 25 owns). Declared at the
; suite's own top level — the same compiler path the ExUnit `eval` reached.
(defn tagged [^long n] (+ n 1))
(defn ^:private tagged2 [x] (* x x))

(deftest let-tagged-symbol-binds-the-bare-name
  (is (= 5 (let [^Tag x 5] x))))

(deftest let-keyword-metadata-is-equally-a-no-op
  (is (= 1 (let [^:private y 1] y))))

(deftest let-stacked-metadata-collapses-to-the-bare-binding
  (is (= 2 (let [^:foo ^Tag z 2] z))))

(deftest let-metadata-never-leaks-into-the-runtime-value
  ; The value bound is 5 itself, not a meta-wrapped 5.
  (is (= 5 (let [^Tag x 5] x)))
  (is (= 1 (let [^Tag m {:a 1}] (get m :a))))
  (is (= 2 (let [^Tag v [1 2]] (count v)))))

(deftest let-star-tagged-binding-works
  (is (= 7 (let* [^Tag a 3 ^Tag b 4] (+ a b)))))

(deftest fn-tagged-param-binds-the-bare-name
  (is (= 5 ((fn [^long x] x) 5))))

(deftest defn-tagged-param-binds-the-bare-name
  (is (= 42 (tagged 41))))

(deftest loop-tagged-binding-works-and-recurs
  (is (= 3 (loop [^Tag i 0] (if (< i 3) (recur (inc i)) i)))))

(deftest for-tagged-binding-routes-through-the-let-destructurer
  ; `for` is lazy; `doall` realizes it to a list so the assertion is on the
  ; produced seq, not on a cursor's identity.
  (is (= '(10 20) (doall (for [^Tag y [1 2]] (* y 10))))))

(deftest tagged-symbol-inside-a-vector-destructuring-pattern-is-accepted
  ; Deliberate decision: allow, matching Clojure's no-op hint semantics.
  (is (= [1 2] (let [[^long a b] [1 2]] [a b]))))

(deftest tagged-symbol-inside-a-keys-destructuring-pattern-is-accepted
  (is (= 7 (let [{:keys [^long k]} {:k 7}] k))))

(deftest tagged-as-name-in-a-map-pattern-binds-the-whole-collection
  (is (= [9 {:a 9}] (let [{:keys [a] :as ^Tag m} {:a 9}] [a m]))))

(deftest tagged-as-name-in-a-vector-pattern-binds-the-whole-collection
  (is (= [1 2] (let [[a b :as ^Tag w] [1 2]] w))))

(deftest tagged-or-default-key-provides-the-fallback
  (is (= 5 (let [{:keys [d] :or {^long d 5}} {}] d))))

(deftest tagged-binding-composes-with-a-destructured-fn-param
  (is (= 3 (let [^Tag f (fn [[^long a b]] (+ a b))] (f [1 2])))))

(deftest def-defn-name-metadata-path-is-untouched
  ; Wave-25 owns ^:private/^{:doc} on names; assert it still compiles and the
  ; tagged name still defines a working var.
  (is (= 36 (tagged2 6))))
