(ns aot-sdk-declaration-publication-test)

(deftest genuine-sdk-public-and-private-declarations-survive-unrelated-publication
 ;; Keep one shared regression program for the cold CLI and runtime-host check.
 ;; Its own assertions exercise the actual SDK producer, concurrent publisher,
 ;; public consumer compilation and private consumer refusal.
 (BeamLisp.Env/with_env :global
  (fn [] (BeamLisp/run_file "test/scripts/sdk-declaration-publication.bl")))
 (is true))

(deftest bootstrap-freshness-refuses-an-actual-live-sdk-lease
 ;; TestRT has retained the real SDK. Do not insert a flag or erase live state
 ;; to model this boundary: the native judge must refuse this genuine lifetime.
 (is (= true (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)))
 (is (= :native_recovery_has_live_custody
        (try (BeamLisp.Env/assert_fresh_native_recovery!) :unexpected-success
             (catch error (BeamLisp.ExInfo/ex_original error))))))
