; test/bl/compat/edn_test.bl — clojure.edn fidelity suite.
; Run: mix beam_lisp.test test/bl/compat/edn_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; The assertions encode the EDN specification (https://github.com/edn-format/edn)
; and clojure.edn/read-string's documented contract. Clojure's own edn tests
; (test/clojure/test_clojure/edn.clj) focus on printer/reader round-trips and
; tagged literals; the round-trip and data-type cases here mirror that intent,
; each `is` naming the contract it pins. The safety property (read-string does
; NOT evaluate) is the reason clojure.edn exists and is tested explicitly.

(ns compat.edn-test
  (:require [clojure.edn :as edn]))

(deftest scalars
  (is (= 42 (edn/read-string "42")))
  (is (= -7 (edn/read-string "-7")))
  (is (= 3.14 (edn/read-string "3.14")))
  (is (= "hello" (edn/read-string "\"hello\"")))
  (is (= :kw (edn/read-string ":kw")))
  (is (= :ns/kw (edn/read-string ":ns/kw")))
  (is (= true (edn/read-string "true")))
  (is (= false (edn/read-string "false")))
  (is (= nil (edn/read-string "nil"))))

(deftest symbols-are-data-not-resolved
  ; a symbol reads as a symbol VALUE — never resolved to a var, never called
  (is (= (symbol "foo") (edn/read-string "foo")))
  (is (= (symbol "my-fn") (edn/read-string "my-fn"))))

(deftest collections
  (is (= [1 2 3] (edn/read-string "[1 2 3]")))
  (is (vector? (edn/read-string "[1 2 3]")))
  (is (= (list 1 2 3) (edn/read-string "(1 2 3)")))
  (is (= {:a 1 :b 2} (edn/read-string "{:a 1 :b 2}")))
  (is (= #{1 2 3} (edn/read-string "#{1 2 3}")))
  (is (set? (edn/read-string "#{1 2 3}"))))

(deftest nested-structures
  (is (= [1 [2 3] {:x [4]}] (edn/read-string "[1 [2 3] {:x [4]}]")))
  (is (= {:name "Ada" :roles [:admin :user] :age 30}
         (edn/read-string "{:name \"Ada\" :roles [:admin :user] :age 30}")))
  (is (= {:a {:b {:c 1}}} (edn/read-string "{:a {:b {:c 1}}}"))))

(deftest empty-and-nil-input
  (is (= nil (edn/read-string "")))
  (is (= nil (edn/read-string nil)))
  (is (= [] (edn/read-string "[]")))
  (is (= {} (edn/read-string "{}")))
  (is (= #{} (edn/read-string "#{}"))))

(deftest opts-arity
  ; the (opts s) arity honors :eof for empty input
  (is (= :the-end (edn/read-string {:eof :the-end} "")))
  (is (= 5 (edn/read-string {:eof :the-end} "5"))))

(deftest read-all-forms
  (is (= [1 2 3] (edn/read-string-all "1 2 3")))
  (is (= [{:a 1} [2] :three] (edn/read-string-all "{:a 1} [2] :three")))
  (is (= [] (edn/read-string-all ""))))

(deftest safety-no-evaluation
  ; EDN is DATA. A list is a list of data, not a function call — reading it must
  ; NOT invoke anything. If read-string evaluated, `(inc 1)` would be 2; as EDN
  ; it is the two-element list (inc 1) with `inc` a bare symbol.
  (is (= (list (symbol "inc") 1) (edn/read-string "(inc 1)")))
  (is (= (symbol "inc") (first (edn/read-string "(inc 1)"))))
  ; a data structure that would be a side-effecting call if evaluated stays data
  (is (= (list (symbol "println") "hi") (edn/read-string "(println \"hi\")"))))

(deftest round-trip-through-pr-str
  ; pr-str then edn/read-string returns an equal value for pure data.
  ; NB: a BARE top-level string is intentionally omitted — beam-lisp's `pr-str`
  ; does not quote a bare string at the top level (it does quote strings NESTED
  ; in a collection, exercised by {:a 1 :b [2 3]} and the vector below). That is
  ; a `pr-str` quirk, not an edn/read-string one: reading `"a string"` (with
  ; quotes) yields the string correctly, proven in the `scalars` deftest.
  (are [v] (= v (edn/read-string (pr-str v)))
    42
    :keyword
    [1 2 3]
    ["a" "b"]
    {:a 1 :b [2 3]}
    #{:x :y}
    (list 1 2 3)))
