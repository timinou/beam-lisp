; test/bl/compat/io_test.bl — clojure.core IO (slurp/spit/line-seq) + argv.
; Run: mix beam_lisp.test test/bl/compat/io_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; The assertions encode clojure.core/slurp and clojure.core/spit's documented
; contracts (Clojure's own slurp/spit tests are IO-bound and JVM-reader shaped;
; the round-trip through a temp file is the portable equivalent). Each `is`
; names the contract it pins.

(ns compat.io-test
  (:require [clojure.io :as io]))

(def tmp "/tmp/bl_compat_io_test.txt")

(deftest spit-then-slurp-round-trips
  (io/spit tmp "hello world")
  (is (= "hello world" (slurp tmp))))

(deftest spit-replaces-by-default
  (io/spit tmp "first")
  (io/spit tmp "second")
  (is (= "second" (slurp tmp))))

(deftest spit-append-option
  (io/spit tmp "a")
  (io/spit tmp "b" :append true)
  (is (= "ab" (slurp tmp))))

(deftest spit-coerces-non-strings
  (io/spit tmp 42)
  (is (= "42" (slurp tmp)))
  (io/spit tmp [1 2 3])
  (is (= "[1 2 3]" (slurp tmp))))

(deftest read-lines-splits-on-newlines
  (io/spit tmp "one\ntwo\nthree")
  (is (= ["one" "two" "three"] (io/read-lines tmp)))
  (io/spit tmp "crlf\r\nline")
  (is (= ["crlf" "line"] (io/read-lines tmp))))

(deftest slurp-bare-resolves-unqualified
  ; slurp is clojure.core: it resolves with no namespace prefix
  (io/spit tmp "bare")
  (is (= "bare" (slurp tmp))))

(deftest command-line-args-is-bound-and-seqable
  ; *command-line-args* is bound (possibly empty) and is seqable; the exact
  ; contents depend on how the script/test was invoked, so we pin only that it
  ; is a sequential collection of strings, not its value.
  (is (sequential? (vec *command-line-args*)))
  (is (sequential? (vec (io/current-command-line-args)))))
