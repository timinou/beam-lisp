; Actual inherited adapters must check the caller before touching a file.
; Synthetic HOME-local fixtures only; no shell, network or private data.
(ns compat.io-capability-test
 (:require [env] [clojure.io :as io]))

(defn- refused [f]
 (try (f) false (catch e (= :env/capability-refused (:kind (ex-data e))))))

(defn- with-fixture [f]
 (let [root (str (System/get_env "HOME") "/tmp/io-capability-" (System/system_time :nanosecond))
       source (str root "/source.txt") sink (str root "/sink.txt")]
  (File/mkdir_p! root)
  (File/write! source "one\ntwo\n")
  (try (f source sink) (finally (File/rm_rf! root)))))

(deftest inherited-and-borrowed-io-refuse-before-effects
 (with-fixture
  (fn [source sink]
   (let [scope (env/fork (env/current) {:caps []})
         borrowed-read io/slurp borrowed-write io/spit]
    (try
     (env/with-env scope
      (fn []
       (is (refused #(io/slurp source)))
       (is (refused #(borrowed-read source)))
       (is (refused #(io/read-lines source)))
       (is (refused #(io/line-seq source)))
       (is (refused #(io/spit sink "bad")))
       (is (refused #(borrowed-write sink "bad")))
       (is (refused #(env/eval (str "(slurp " (pr-str source) ")"))))
       (is (refused #(env/eval (str "(spit " (pr-str sink) " \"bad\")"))))))
     (is (not (File/exists? sink)))
     (is (= "one\ntwo\n" (File/read! source)))
     (finally (env/destroy scope)))))))

(deftest read-and-write-grants-remain-independent
 (with-fixture
  (fn [source sink]
   (let [read-only (env/fork (env/current) {:caps [["Elixir.File" "read"]]})
         write-only (env/fork (env/current) {:caps [["Elixir.File" "write"]]})
         whole-module (env/fork (env/current) {:caps ["Elixir.File"]})]
    (try
     (env/with-env read-only
      (fn []
       (is (= "one\ntwo\n" (io/slurp source)))
       (is (= ["one" "two"] (io/read-lines source)))
       (is (= ["one" "two"] (vec (io/line-seq source))))
       (is (refused #(io/spit sink "bad")))))
     (is (not (File/exists? sink)))
     (env/with-env write-only
      (fn []
       (is (= nil (io/spit sink "ok")))
       (is (= nil (io/spit sink "+" :append true)))
       (is (refused #(io/slurp source)))))
     (is (= "ok+" (File/read! sink)))
     (env/with-env whole-module
      (fn []
       (is (= "one\ntwo\n" (io/slurp source)))
       (is (= nil (io/spit sink 42)))
       (is (= "42" (io/slurp sink)))))
     (finally
      (env/destroy read-only) (env/destroy write-only) (env/destroy whole-module)))))))

(deftest generic-check-fails-closed-on-unknown-or-malformed-names
 (is (= :granted (env/require-cap! "Elixir.File" "read")))
 (is (refused #(env/require-cap! "No.Such.Capability.Module" "read")))
 (is (refused #(env/require-cap! "Elixir.File" "nonexistent-cap-operation-839205")))
 (is (refused #(env/require-cap! nil "read")))
 (is (refused #(env/require-cap! "Elixir.File" nil))))
