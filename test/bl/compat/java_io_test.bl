; test/bl/compat/java_io_test.bl — clojure.java.io subset fidelity suite.
; Run: mix beam_lisp.test test/bl/compat/java_io_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; Assertions encode clojure.java.io's documented contracts for the path-oriented
; subset reproduced here (file / make-parents / delete-file / copy / as-file).
; The stream/URL/resource surface is intentionally not reproduced (no java.io on
; the BEAM) — recorded in the namespace header. Each `is` names its contract.

(ns compat.java-io-test
  (:require [clojure.java.io :as io]
            [clojure.io]
            [babashka.fs :as fs]))

(def root "/tmp/bl_compat_javaio_test")

(defn setup []
  (fs/delete-tree root)
  (fs/create-dirs root))

(deftest file-joins-segments
  (is (= "a/b/c" (io/file "a" "b" "c")))
  (is (= "solo" (io/file "solo"))))

(deftest make-parents-creates-dirs
  (setup)
  (let [deep (io/file root "x" "y" "z.txt")]
    (is (= true (io/make-parents deep)))
    (is (fs/directory? (io/file root "x" "y")))
    ; second call: parents already exist -> false
    (is (= false (io/make-parents deep)))))

(deftest delete-file-and-silently
  (setup)
  (let [f (io/file root "gone.txt")]
    (spit f "x")
    (is (fs/exists? f))
    (io/delete-file f)
    (is (not (fs/exists? f)))
    ; silently: deleting a missing file is not an error
    (is (= nil (io/delete-file (io/file root "never.txt") true)))))

(deftest copy-file-to-file
  (setup)
  (let [src (io/file root "s.txt")
        dst (io/file root "d.txt")]
    (spit src "data")
    (io/copy src dst)
    (is (= "data" (slurp dst)))))

(deftest reader-writer-round-trip
  (setup)
  (let [p (io/file root "rw.txt")]
    (spit p "content")
    ; io/reader here eagerly yields the contents string; slurp of it is identity
    (is (= "content" (io/reader p)))
    ; io/writer yields the path; spit targets it
    (spit (io/writer p) "rewritten")
    (is (= "rewritten" (slurp p)))))

(deftest as-file-coerces-to-string
  (is (= "path" (io/as-file "path"))))
