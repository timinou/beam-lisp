; test/bl/compat/string_test.bl — clojure.string fidelity suite.
; Run: mix beam_lisp.test test/bl/compat/string_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; Adapted from Clojure's own test suite:
;   https://github.com/clojure/clojure/blob/master/test/clojure/test_clojure/string.clj
; The ASSERTIONS (inputs and expected outputs) are upstream, verbatim. What is
; adapted — and why — is recorded per deftest below. The rule mirrors
; docs/jank-compat.md: a needed adaptation is a host difference recorded here,
; never a silent change of the expected value.
;
; ── Adaptations (host differences, not behavior changes) ─────────────────────
;   1. `#"re"` reader literals -> `(re-pattern "re")`. beam-lisp's reader has no
;      regex literal yet (a boot/reader change, gated separately); the compiled
;      pattern is identical, so every expected value is unchanged.
;   2. `(StringBuffer. s)` receivers -> plain strings. On the JVM these tests
;      also prove CharSequence acceptance; beam-lisp strings ARE the sequence,
;      so the same call on a plain string exercises the same code with the same
;      expected result.
;   3. `(thrown? NullPointerException …)` -> `(thrown? …)`. beam-lisp has no NPE
;      class; nil still raises. The contract "nil is an error" is preserved.
;   4. `\uXXXX` unicode whitespace escapes are written as the literal character
;      where the reader accepts it, else via (char N).

(ns compat.string-test
  (:require [clojure.string :as s]))

; A codepoint as a one-character STRING. Clojure writes `\u2002` (a Character,
; whose (str …) is the character); beam-lisp represents a character as its
; integer codepoint, so `(str (char 8194))` would render "8194". This helper
; builds the actual one-character string, the value `\u2002` denotes upstream.
(defn cp [n] (List/to_string (list n)))

(deftest t-split
  (is (= ["a" "b"] (s/split "a-b" (re-pattern "-"))))
  (is (= ["a" "b-c"] (s/split "a-b-c" (re-pattern "-") 2)))
  (is (vector? (s/split "abc" (re-pattern "-")))))

(deftest t-reverse
  (is (= "tab" (s/reverse "bat"))))

(deftest t-replace
  (is (= "faabar" (s/replace "foobar" \o \a)))
  (is (= "foobar" (s/replace "foobar" \z \a)))
  (is (= "barbarbar" (s/replace "foobarfoo" "foo" "bar")))
  (is (= "foobarfoo" (s/replace "foobarfoo" "baz" "bar")))
  (is (= "f$$d" (s/replace "food" "o" "$")))
  (is (= "f\\\\d" (s/replace "food" "o" "\\")))
  (is (= "barbarbar" (s/replace "foobarfoo" (re-pattern "foo") "bar")))
  (is (= "foobarfoo" (s/replace "foobarfoo" (re-pattern "baz") "bar")))
  (is (= "f$$d" (s/replace "food" (re-pattern "o") (s/re-quote-replacement "$"))))
  (is (= "f\\\\d" (s/replace "food" (re-pattern "o") (s/re-quote-replacement "\\"))))
  (is (= "FOObarFOO" (s/replace "foobarfoo" (re-pattern "foo") s/upper-case)))
  (is (= "foobarfoo" (s/replace "foobarfoo" (re-pattern "baz") s/upper-case)))
  (is (= "OObarOO" (s/replace "foobarfoo" (re-pattern "f(o+)") (fn [[m g1]] (s/upper-case g1)))))
  (is (= "baz\\bang\\" (s/replace "bazslashbangslash" (re-pattern "slash") (constantly "\\")))))

(deftest t-replace-first
  (is (= "faobar" (s/replace-first "foobar" \o \a)))
  (is (= "foobar" (s/replace-first "foobar" \z \a)))
  (is (= "z.ology" (s/replace-first "zoology" \o \.)))
  (is (= "barbarfoo" (s/replace-first "foobarfoo" "foo" "bar")))
  (is (= "foobarfoo" (s/replace-first "foobarfoo" "baz" "bar")))
  (is (= "f$od" (s/replace-first "food" "o" "$")))
  (is (= "f\\od" (s/replace-first "food" "o" "\\")))
  (is (= "barbarfoo" (s/replace-first "foobarfoo" (re-pattern "foo") "bar")))
  (is (= "foobarfoo" (s/replace-first "foobarfoo" (re-pattern "baz") "bar")))
  (is (= "f$od" (s/replace-first "food" (re-pattern "o") (s/re-quote-replacement "$"))))
  (is (= "f\\od" (s/replace-first "food" (re-pattern "o") (s/re-quote-replacement "\\"))))
  (is (= "FOObarfoo" (s/replace-first "foobarfoo" (re-pattern "foo") s/upper-case)))
  (is (= "foobarfoo" (s/replace-first "foobarfoo" (re-pattern "baz") s/upper-case)))
  (is (= "OObarfoo" (s/replace-first "foobarfoo" (re-pattern "f(o+)") (fn [[m g1]] (s/upper-case g1)))))
  (is (= "baz\\bangslash" (s/replace-first "bazslashbangslash" (re-pattern "slash") (constantly "\\")))))

(deftest t-join
  (are [x coll] (= x (s/join coll))
       "" nil
       "" []
       "1" [1]
       "12" [1 2])
  ; upstream uses the char literal `\,`; beam-lisp's reader rejects a bare
  ; punctuation char literal (a separate reader limitation), so the comma
  ; character is written `(char 44)` — the identical value.
  (are [x sep coll] (= x (s/join sep coll))
       "1,2,3" (char 44) [1 2 3]
       "" (char 44) []
       "1" (char 44) [1]
       "1 and-a 2 and-a 3" " and-a " [1 2 3]))

(deftest t-trim-newline
  (is (= "foo" (s/trim-newline "foo\n")))
  (is (= "foo" (s/trim-newline "foo\r\n")))
  (is (= "foo" (s/trim-newline "foo")))
  (is (= "" (s/trim-newline ""))))

(deftest t-capitalize
  (is (= "Foobar" (s/capitalize "foobar")))
  (is (= "Foobar" (s/capitalize "FOOBAR"))))

(deftest t-triml
  (is (= "foo " (s/triml " foo ")))
  (is (= "" (s/triml "   ")))
  ; \u2002 EN SPACE (decimal 8194) is whitespace; the leading run incl. tab is
  ; trimmed. Written (char 8194) because beam-lisp's reader has no 0x hex or
  ; \uXXXX literal — the codepoint is identical.
  (is (= "bar" (s/triml (str (cp 8194) " \tbar")))))

(deftest t-trimr
  (is (= " foo" (s/trimr " foo ")))
  (is (= "" (s/trimr "   ")))
  (is (= "bar" (s/trimr (str "bar\t " (cp 8194))))))

(deftest t-trim
  (is (= "foo" (s/trim "  foo  \r\n")))
  (is (= "bar" (s/trim (str (cp 8192) "bar\t " (cp 8194))))))

(deftest t-upper-case
  (is (= "FOOBAR" (s/upper-case "Foobar"))))

(deftest t-lower-case
  (is (= "foobar" (s/lower-case "FooBar"))))

(deftest nil-handling
  ; upstream: (thrown? NullPointerException …). beam-lisp has no NPE class;
  ; nil still raises. The contract preserved is "nil is not a valid string arg".
  (is (thrown? (s/reverse nil)))
  (is (thrown? (s/replace nil (re-pattern "foo") "bar")))
  (is (thrown? (s/capitalize nil)))
  (is (thrown? (s/upper-case nil)))
  (is (thrown? (s/lower-case nil)))
  (is (thrown? (s/trim nil)))
  (is (thrown? (s/triml nil)))
  (is (thrown? (s/trimr nil))))

(deftest t-escape
  (is (= "&lt;foo&amp;bar&gt;"
         (s/escape "<foo&bar>" {\& "&amp;" \< "&lt;" \> "&gt;"})))
  ; upstream keys this map with `\"` (char double-quote); beam-lisp's reader
  ; rejects the `\"` and `\\` char literals (a reader limitation), so the
  ; double-quote character is written `(char 34)` — the identical value.
  (is (= " \\\"foo\\\" "
         (s/escape " \"foo\" " {(char 34) "\\\""})))
  (is (= "faabor"
         (s/escape "foobar" {\a \o, \o \a}))))

(deftest t-blank
  (is (s/blank? nil))
  (is (s/blank? ""))
  (is (s/blank? " "))
  (is (s/blank? " \t \n  \r "))
  (is (not (s/blank? "  foo  "))))

(deftest t-split-lines
  (let [result (s/split-lines "one\ntwo\r\nthree")]
    (is (= ["one" "two" "three"] result))
    (is (vector? result)))
  (is (= ["foo"] (s/split-lines "foo"))))

(deftest t-index-of
  (let [sb "tacos"]
    (is (= 2  (s/index-of sb "c")))
    (is (= 2  (s/index-of sb \c)))
    (is (= 1  (s/index-of sb "ac")))
    (is (= 3  (s/index-of sb "o" 2)))
    (is (= 3  (s/index-of sb \o 2)))
    (is (= 3  (s/index-of sb "o" -100)))
    (is (= nil (s/index-of sb "z")))
    (is (= nil (s/index-of sb \z)))
    (is (= nil (s/index-of sb "z" 2)))
    (is (= nil (s/index-of sb \z 2)))
    (is (= nil (s/index-of sb "z" 100)))
    (is (= nil (s/index-of sb "z" -10)))))

(deftest t-last-index-of
  (let [sb "banana"]
    (is (= 4 (s/last-index-of sb "n")))
    (is (= 4 (s/last-index-of sb \n)))
    (is (= 3 (s/last-index-of sb "an")))
    (is (= 4 (s/last-index-of sb "n")))
    (is (= 4 (s/last-index-of sb "n" 5)))
    (is (= 4 (s/last-index-of sb \n 5)))
    (is (= 4 (s/last-index-of sb "n" 500)))
    (is (= nil (s/last-index-of sb "z")))
    (is (= nil (s/last-index-of sb "z" 1)))
    (is (= nil (s/last-index-of sb \z 1)))
    (is (= nil (s/last-index-of sb "z" 100)))
    (is (= nil (s/last-index-of sb "z" -10)))))

(deftest t-starts-with?
  (is (s/starts-with? "clojure west" "clojure"))
  (is (not (s/starts-with? "conj" "clojure"))))

(deftest t-ends-with?
  (is (s/ends-with? "Clojure West" "West"))
  (is (not (s/ends-with? "Conj" "West"))))

(deftest t-includes?
  (let [sb "Clojure Applied Book"]
    (is (s/includes? sb "Applied"))
    (is (not (s/includes? sb "Living")))))
