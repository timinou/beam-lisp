; test/bl/compat/fs_test.bl — babashka.fs subset fidelity suite.
; Run: mix beam_lisp.test test/bl/compat/fs_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; The assertions encode babashka.fs's documented contracts
; (https://github.com/babashka/fs). babashka.fs's own tests are JVM/nio bound;
; these round-trip against a temp directory, each `is` naming the contract it
; pins. Paths are strings (bb.fs uses java.nio.Path); the string forms are what
; scripts write and what every fn here accepts.

(ns compat.fs-test
  (:require [babashka.fs :as fs]))

(def root "/tmp/bl_compat_fs_test")

(defn setup []
  (fs/delete-tree root)
  (fs/create-dirs root))

(deftest predicates
  (setup)
  (is (fs/exists? root))
  (is (fs/directory? root))
  (fs/write-all-string (fs/path root "f.txt") "hi")
  (is (fs/exists? (fs/path root "f.txt")))
  (is (fs/regular-file? (fs/path root "f.txt")))
  (is (not (fs/directory? (fs/path root "f.txt"))))
  (is (not (fs/exists? (fs/path root "nope.txt")))))

(deftest path-manipulation
  (is (= "c.txt" (fs/file-name "/a/b/c.txt")))
  (is (= "/a/b" (fs/parent "/a/b/c.txt")))
  (is (= "txt" (fs/extension "/a/b/c.txt")))
  (is (= nil (fs/extension "/a/b/c")))
  (is (= "a/b/c" (fs/path "a" "b" "c"))))

(deftest listing-and-glob
  (setup)
  (fs/write-all-string (fs/path root "a.edn") "1")
  (fs/write-all-string (fs/path root "b.edn") "2")
  (fs/write-all-string (fs/path root "c.txt") "3")
  (is (= 3 (count (fs/list-dir root))))
  (is (= 2 (count (fs/glob root "*.edn"))))
  (is (= 1 (count (fs/glob root "*.txt")))))

(deftest create-and-delete
  (setup)
  (fs/create-dirs (fs/path root "deep/nested/dir"))
  (is (fs/directory? (fs/path root "deep/nested/dir")))
  (fs/write-all-string (fs/path root "gone.txt") "x")
  (is (fs/exists? (fs/path root "gone.txt")))
  (is (= true (fs/delete-if-exists (fs/path root "gone.txt"))))
  (is (not (fs/exists? (fs/path root "gone.txt"))))
  (is (= false (fs/delete-if-exists (fs/path root "never.txt")))))

(deftest copy-and-read-write
  (setup)
  (let [src (fs/path root "src.txt")
        dst (fs/path root "dst.txt")]
    (fs/write-all-string src "payload")
    (fs/copy src dst)
    (is (= "payload" (fs/read-all-string dst)))
    (is (fs/exists? src))))

(deftest cwd-and-home
  (is (string? (fs/cwd)))
  (is (string? (fs/home))))
