; test/bl/compat/re_test.bl — clojure.core regex surface (priv/compat/clojure/re.bl).
; Run: mix beam_lisp.test test/bl/compat/re_test.bl
;
; The assertions encode Clojure's documented contracts (clojure.core/re-find,
; re-matches, re-seq, re-matcher, re-groups, re-pattern, re-quote-replacement).
; They are not vendored from a single upstream file — Clojure's regex tests are
; spread across string.clj's suite and the reader — so each `is` names the exact
; contract it pins, the way a reader of clojure.core's docstrings would expect.

(ns compat.re-test
  (:require [clojure.re]))

;; ── re-pattern ───────────────────────────────────────────────────────────────

(deftest re-pattern-compiles-and-is-idempotent
  (is (regex? (re-pattern "\\d+")))
  ; idempotent on an already-compiled pattern
  (is (regex? (re-pattern (re-pattern "\\d+"))))
  (is (regex? #_"a literal-shaped string still compiles" (re-pattern "[a-z]+"))))

;; ── re-find: the whole-vs-vector contract ────────────────────────────────────

(deftest re-find-no-groups-returns-string
  (is (= "123" (re-find (re-pattern "\\d+") "a123b")))
  (is (= "abc" (re-find (re-pattern "[a-z]+") "abc123"))))

(deftest re-find-with-groups-returns-vector
  ; WITH capture groups the return is [whole g1 g2 …] — the contract people trip on
  (is (= ["foo" "oo"] (re-find (re-pattern "f(o+)") "food")))
  (is (= ["12" "1" "2"] (re-find (re-pattern "(\\d)(\\d)") "a12b"))))

(deftest re-find-no-match-is-nil
  (is (nil? (re-find (re-pattern "z") "abc")))
  (is (nil? (re-find (re-pattern "(\\d)") "abc"))))

;; ── re-matches: implicitly anchored ──────────────────────────────────────────

(deftest re-matches-must-match-entire-string
  (is (= "123" (re-matches (re-pattern "\\d+") "123")))
  ; a partial match is NOT a re-matches success (this is the whole point)
  (is (nil? (re-matches (re-pattern "\\d+") "a123")))
  (is (nil? (re-matches (re-pattern "\\d+") "123a"))))

(deftest re-matches-groups
  (is (= ["12" "1" "2"] (re-matches (re-pattern "(\\d)(\\d)") "12")))
  (is (= "abc" (re-matches (re-pattern "[a-z]+") "abc"))))

;; ── re-seq ───────────────────────────────────────────────────────────────────

(deftest re-seq-all-matches
  (is (= ["1" "22" "333"] (vec (re-seq (re-pattern "\\d+") "a1b22c333"))))
  (is (= ["a" "b" "c"] (vec (re-seq (re-pattern "[a-z]") "a1b2c")))))

(deftest re-seq-with-groups
  (is (= [["12" "1" "2"] ["34" "3" "4"]]
         (vec (re-seq (re-pattern "(\\d)(\\d)") "12 34")))))

(deftest re-seq-empty-on-no-match
  (is (= [] (vec (re-seq (re-pattern "z") "abc")))))

;; ── re-matcher / re-groups: the stateful pair ────────────────────────────────

(deftest re-matcher-advances
  (let [m (re-matcher (re-pattern "\\d+") "a1b22c333")]
    (is (= "1" (re-find m)))
    (is (= "22" (re-find m)))
    (is (= "333" (re-find m)))
    ; exhausted -> nil
    (is (nil? (re-find m)))))

(deftest re-groups-reads-last-match
  (let [m (re-matcher (re-pattern "(\\d)(\\d)") "12 34")]
    (re-find m)
    (is (= ["12" "1" "2"] (re-groups m)))
    (re-find m)
    (is (= ["34" "3" "4"] (re-groups m)))))

;; ── re-quote-replacement ─────────────────────────────────────────────────────

(deftest re-quote-replacement-escapes-dollar-and-backslash
  (is (= "\\$" (re-quote-replacement "$")))
  (is (= "\\\\" (re-quote-replacement "\\")))
  ; a literal replacement round-trips through replace unharmed (see string tests)
  (is (= "\\$1\\\\x" (re-quote-replacement "$1\\x"))))
