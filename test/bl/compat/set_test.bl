; test/bl/compat/set_test.bl — clojure.set fidelity suite.
; Run: mix beam_lisp.test test/bl/compat/set_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; Vendored from Clojure's own test suite:
;   https://github.com/clojure/clojure/blob/master/test/clojure/test_clojure/clojure_set.clj
; The assertions (inputs and expected outputs) are upstream, verbatim. clojure.set
; itself (priv/compat/clojure/set.bl) is byte-for-byte upstream too — this is the
; copy-paste tier, so both sides are the original Clojure.
;
; ── Adaptations (host differences, not behavior changes) ─────────────────────
;   1. (thrown? IllegalArgumentException …) -> (thrown? …). beam-lisp has no
;      Java exception classes; calling set/intersection with no args still fails
;      (no matching arity), which is the contract the test pins.
;   2. `hash-set` / `sorted-set` are clojure.core; `hash-set` ships via
;      clojure.core-ext (required below), `sorted-set` is already in the prelude.

(ns compat.set-test
  (:require [clojure.set :as set]
            [clojure.core-ext]))

(deftest test-union
  (are [x y] (= x y)
      (set/union) #{}
      (set/union #{}) #{}
      (set/union #{1}) #{1}
      (set/union #{1 2 3}) #{1 2 3}
      (set/union #{} #{}) #{}
      (set/union #{} #{1}) #{1}
      (set/union #{} #{1 2 3}) #{1 2 3}
      (set/union #{1} #{}) #{1}
      (set/union #{1 2 3} #{}) #{1 2 3}
      (set/union #{1} #{2}) #{1 2}
      (set/union #{1} #{1 2}) #{1 2}
      (set/union #{2} #{1 2}) #{1 2}
      (set/union #{1 2} #{3}) #{1 2 3}
      (set/union #{1 2} #{2 3}) #{1 2 3}
      (set/union #{} #{} #{}) #{}
      (set/union #{1} #{} #{}) #{1}
      (set/union #{} #{1} #{}) #{1}
      (set/union #{} #{} #{1}) #{1}
      (set/union #{1 2} #{2 3} #{}) #{1 2 3}
      (set/union #{1 2} #{3 4} #{5 6}) #{1 2 3 4 5 6}
      (set/union #{1 2} #{2 3} #{1 3 4}) #{1 2 3 4}
      (set/union (hash-set) (hash-set 1 2) (hash-set 2 3)) (hash-set 1 2 3)))

(deftest test-intersection
  ; upstream: (thrown? IllegalArgumentException (set/intersection)). beam-lisp
  ; has no such class; the zero-arity call still fails (no matching clause).
  (is (thrown? (set/intersection)))
  (are [x y] (= x y)
      (set/intersection #{}) #{}
      (set/intersection #{1}) #{1}
      (set/intersection #{1 2 3}) #{1 2 3}
      (set/intersection #{} #{}) #{}
      (set/intersection #{} #{1}) #{}
      (set/intersection #{} #{1 2 3}) #{}
      (set/intersection #{1} #{}) #{}
      (set/intersection #{1 2 3} #{}) #{}
      (set/intersection #{1 2} #{1 2}) #{1 2}
      (set/intersection #{1 2} #{3 4}) #{}
      (set/intersection #{1 2} #{1}) #{1}
      (set/intersection #{1 2} #{2}) #{2}
      (set/intersection #{1 2 4} #{2 3 4 5}) #{2 4}
      (set/intersection #{} #{} #{}) #{}
      (set/intersection #{1} #{} #{}) #{}
      (set/intersection #{1} #{1} #{}) #{}
      (set/intersection #{1} #{} #{1}) #{}
      (set/intersection #{1 2} #{2 3} #{}) #{}
      (set/intersection #{1 2} #{2 3} #{5 2}) #{2}
      (set/intersection #{1 2 3} #{1 3 4} #{1 3}) #{1 3}
      (set/intersection #{1 2 3} #{3 4 5} #{8 2 3}) #{3}))

(deftest test-difference
  (are [x y] (= x y)
      (set/difference #{}) #{}
      (set/difference #{1}) #{1}
      (set/difference #{1 2 3}) #{1 2 3}
      (set/difference #{1 2} #{1 2}) #{}
      (set/difference #{1 2} #{3 4}) #{1 2}
      (set/difference #{1 2} #{1}) #{2}
      (set/difference #{1 2} #{2}) #{1}
      (set/difference #{1 2 4} #{2 3 4 5}) #{1}
      (set/difference #{1 2} #{2 3} #{5 2}) #{1}
      (set/difference #{1 2 3} #{1 3 4} #{1 3}) #{2}
      (set/difference #{1 2 3} #{3 4 5} #{8 2 3}) #{1}))

(deftest test-select
  (are [x y] (= x y)
    (set/select integer? #{}) #{}
    (set/select integer? #{1 2}) #{1 2}
    (set/select integer? #{1 2 :a :b :c}) #{1 2}
    (set/select integer? #{:a :b :c}) #{}))

(def compositions
  #{{:name "Art of the Fugue" :composer "J. S. Bach"}
    {:name "Musical Offering" :composer "J. S. Bach"}
    {:name "Requiem" :composer "Giuseppe Verdi"}
    {:name "Requiem" :composer "W. A. Mozart"}})

(deftest test-project
  (are [x y] (= x y)
    (set/project compositions [:name]) #{{:name "Art of the Fugue"}
                                         {:name "Requiem"}
                                         {:name "Musical Offering"}}
    (set/project compositions [:composer]) #{{:composer "W. A. Mozart"}
                                             {:composer "Giuseppe Verdi"}
                                             {:composer "J. S. Bach"}}
    (set/project compositions [:year]) #{{}}
    (set/project #{{}} [:name]) #{{}}))

(deftest test-rename
  (are [x y] (= x y)
    (set/rename compositions {:name :title}) #{{:title "Art of the Fugue" :composer "J. S. Bach"}
                                               {:title "Musical Offering" :composer "J. S. Bach"}
                                               {:title "Requiem" :composer "Giuseppe Verdi"}
                                               {:title "Requiem" :composer "W. A. Mozart"}}
    (set/rename #{{}} {:year :decade}) #{{}}))

(deftest test-rename-keys
  (are [x y] (= x y)
       (set/rename-keys {:a "one" :b "two"} {:a :z}) {:z "one" :b "two"}
       (set/rename-keys {:a "one" :b "two"} {:a :z :c :y}) {:z "one" :b "two"}
       (set/rename-keys {:a "one" :b "two" :c "three"} {:a :b :b :a}) {:a "two" :b "one" :c "three"}))

(deftest test-index
  (are [x y] (= x y)
    (set/index #{{:c 2} {:b 1} {:a 1 :b 2}} [:b]) {{:b 2} #{{:a 1 :b 2}}, {:b 1} #{{:b 1}} {} #{{:c 2}}}))

(deftest test-join
  (are [x y] (= x y)
    (set/join compositions compositions) compositions
    (set/join compositions #{{:name "Art of the Fugue" :genre "Classical"}})
                           #{{:name "Art of the Fugue" :composer "J. S. Bach" :genre "Classical"}}))

(deftest test-map-invert
  (are [x y] (= x y)
       (set/map-invert {:a "one" :b "two"}) {"one" :a "two" :b}))

(deftest test-subset?
  (are [sub super] (set/subset? sub super)
       #{} #{}
       #{} #{1}
       #{1} #{1}
       #{1 2} #{1 2}
       #{1 2} #{1 2 42}
       #{false} #{false}
       #{nil} #{nil}
       #{nil} #{nil false}
       #{1 2 nil} #{1 2 nil 4})
  (are [notsub super] (not (set/subset? notsub super))
       #{1} #{}
       #{2} #{1}
       #{1 3} #{1}
       #{nil} #{false}
       #{false} #{nil}
       #{false nil} #{nil}
       #{1 2 nil} #{1 2}))

(deftest test-superset?
  (are [super sub] (set/superset? super sub)
       #{} #{}
       #{1} #{}
       #{1} #{1}
       #{1 2} #{1 2}
       #{1 2 42} #{1 2}
       #{false} #{false}
       #{nil} #{nil}
       #{false nil} #{false}
       #{1 2 4 nil false} #{1 2 nil})
  (are [notsuper sub] (not (set/superset? notsuper sub))
       #{} #{1}
       #{2} #{1}
       #{1} #{1 3}
       #{nil} #{false}
       #{false} #{nil}
       #{nil} #{false nil}
       #{nil 2 3} #{false nil 2 3}))
