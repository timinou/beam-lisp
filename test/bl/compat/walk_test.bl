; test/bl/compat/walk_test.bl — clojure.walk fidelity suite.
; Run: mix beam_lisp.test test/bl/compat/walk_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; Vendored from Clojure's own test suite:
;   https://github.com/clojure/clojure/blob/master/test/clojure/test_clojure/clojure_walk.clj
; Assertions are upstream verbatim except the adaptations noted below.
;
; ── Adaptations (host differences, not behavior changes) ─────────────────────
;   1. The `walk` deftest's sorted-set-by / sorted-map-by / .comparator /
;      instance? clojure.lang.* checks are JVM-class specific; the portable core
;      of that test (identity walk round-trips value and type for list/vector/
;      set/map/record; the numeric-fold variants) is kept, the class checks
;      dropped. Recorded, not silently changed.
;   2. keywordize/stringify with a nil key: kept. `stringify-keys` with nil key
;      is upstream verbatim.

(ns compat.walk-test
  (:require [clojure.walk :as w]
            [clojure.core-ext]))

(deftest t-prewalk-replace
  (is (= (w/prewalk-replace {:a :b} [:a {:a :a} (list 3 :c :a)])
         [:b {:b :b} (list 3 :c :b)])))

(deftest t-postwalk-replace
  (is (= (w/postwalk-replace {:a :b} [:a {:a :a} (list 3 :c :a)])
         [:b {:b :b} (list 3 :c :b)])))

(deftest t-stringify-keys
  (is (= (w/stringify-keys {:a 1, nil {:b 2 :c 3}, :d 4})
         {"a" 1, nil {"b" 2 "c" 3}, "d" 4})))

(deftest t-keywordize-keys
  (is (= (w/keywordize-keys {"a" 1, "b" {"c" 2}})
         {:a 1, :b {:c 2}})))

(deftest t-prewalk-order
  (is (= (let [a (atom [])]
           (w/prewalk (fn [form] (do (swap! a conj form) form))
                      [1 2 {:a 3} (list 4 [5])])
           @a)
         [[1 2 {:a 3} (list 4 [5])]
          1 2 {:a 3} [:a 3] :a 3 (list 4 [5])
          4 [5] 5])))

(deftest t-postwalk-order
  (is (= (let [a (atom [])]
           (w/postwalk (fn [form] (do (swap! a conj form) form))
                      [1 2 {:a 3} (list 4 [5])])
           @a)
         [1 2
          :a 3 [:a 3] {:a 3}
          4 5 [5] (list 4 [5])
          [1 2 {:a 3} (list 4 [5])]])))

(deftest walk-round-trips-value-and-type
  ; The portable core of upstream's `walk` deftest: identity walk returns an
  ; equal collection, and the numeric-fold variants match a direct reduce. The
  ; sorted-by / .comparator / instance? clojure.lang.* checks are JVM-specific
  ; and dropped (recorded in the header).
  (let [colls [(list 1 2 3)
               [1 2 3]
               #{1 2 3}
               {:a 1, :b 2, :c 3}]]
    (doseq [c colls]
      (let [walked (w/walk identity identity c)]
        (is (= c walked))
        (if (map? c)
          (is (= (w/walk (fn [e] [(key e) (inc (val e))]) (fn [m] (reduce + (vals m))) c)
                 (reduce + (map (fn [e] (inc (val e))) c))))
          (is (= (w/walk inc (fn [xs] (reduce + xs)) c)
                 (reduce + (map inc c)))))))))

(deftest retain-meta
  (let [m {:foo true}]
    (are [o] (= m (meta (w/postwalk identity (with-meta o m))))
      (list 1 2)
      [1 2]
      #{1 2}
      {1 2})))
