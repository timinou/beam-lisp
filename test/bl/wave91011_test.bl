; wave91011_test.bl — waves 9, 10 and 11, tested in beam-lisp itself.
; Run: bin/bl test test/bl/wave91011_test.bl
;
; Ported from three ExUnit suites, deleted on parity:
;   * test/beam_lisp/wave9_hygiene_test.exs  — prelude-macro hygiene: `and`/`or`/
;     `case` no longer capture user locals, syntax-quote auto-gensym, the gensym
;     prim.
;   * test/beam_lisp/wave10_lazy_test.exs    — prelude gaps (get/assoc/even?…
;     take/drop) and lazy sequences: chunked realization counts, infinite seqs,
;     Enumerable interop, bounded printing, 100k doall.
;   * test/beam_lisp/wave11_multi_test.exs   — defmulti/defmethod, hierarchies
;     (derive/isa?), protocols (defprotocol/extend-type/extend-protocol).
;
; Every ExUnit `assert` is here as an `is`, and every `assert_raise` as
; `raises-with?` — the exception CLASS and a message needle, which is exactly
; what `assert_raise RuntimeError` + a `=~` check asserted. The ExUnit `setup`
; ran `BeamLisp.init()` + `Env.in_ns("user")` before each test; `ev` mirrors the
; `BeamLisp.eval/1` seam and each deftest restores the `user` ns first.
;
; Why eval-strings and not direct forms: wave 9 defines macros at RUNTIME (a
; `defmacro` in a deftest body would be compiled, not run), and wave 11 switches
; namespaces mid-suite (`(ns w11.lib) … (:require …)`), which needs separate
; compilation units. Keeping the source strings keeps the compilation and
; namespace semantics identical to the ExUnit suite being replaced.
;
; Two cross-namespace tests call `BeamLisp.Env/mark_loaded` before the
; `:require`: ward runs each file in its own env fork, where the loader's server
; process does not see an eval-created namespace the way the ExUnit suite's
; top-level VM did. `mark_loaded` states the same precondition (a loaded ns) the
; top-level run had implicitly; the behavior under test — the `:require` alias
; resolving, and `lib/greet` dispatching into the other namespace's multimethod
; — is unchanged.

(ns wave91011.test)

(defn- ev [s] (BeamLisp/eval s))
(defn- in-user! [] (BeamLisp.Env/in_ns "user"))
(defn- raises-with? [klass needle f]
  (try (f) false
       (catch e (and (erlang/== klass (get e :__struct__))
                     (includes? (str (ex-message e)) needle)))))

; ═══════════════════════════════════════════════════════════════════════════
; wave 9 — hygiene
; ═══════════════════════════════════════════════════════════════════════════

(deftest and-ignores-a-user-local-named-and-tmp
  ; pre-fix this returned 1: the macro's own and-tmp (bound to the
  ; first arg, 1) shadowed the user's and-tmp (5).
  (in-user!)
  (is (= 5 (ev "(let [and-tmp 5] (and 1 and-tmp))"))))

(deftest or-ignores-a-user-local-named-or-tmp
  ; pre-fix this returned false: the macro's or-tmp shadowed the
  ; user's or-tmp, so the short-circuit returned the inner binding.
  (in-user!)
  (is (= 7 (ev "(let [or-tmp 7] (or false or-tmp))"))))

(deftest case-temp-does-not-capture-a-branch-value-named-case-val
  ; pre-fix this returned 9: the branch value `case-val` referred to
  ; the macro's generated binding (bound to the case expression, 9)
  ; instead of the user's local (100).
  (in-user!)
  (is (= 100 (ev "(let [case-val 100] (case 9 9 case-val :other))"))))

(deftest case-still-matches-on-the-expression-value
  (in-user!)
  (is (= :nine (ev "(let [case-val 9] (case case-val 9 :nine :other))")))
  (is (= :other (ev "(let [case-val 9] (case case-val 8 :eight :other))"))))

(deftest x-hash-twice-in-one-syntax-quote-expands-to-the-same-symbol
  (in-user!)
  (ev "(defmacro same-temp [] `(quote [x# x#]))")
  (in-user!)
  (is (= true (ev "(let [v (same-temp)] (= (first v) (second v)))")))
  ; and the generated name is the readable x__N__auto shape
  (let [name (elem (ev "(first (same-temp))") 1)]
    (is (Regex/match? (Regex/compile! "^x__\\d+__auto$") name))))

(deftest x-hash-in-two-separate-syntax-quotes-expands-to-different-symbols
  (in-user!)
  (ev "(defmacro temp-a [] `(quote x#))")
  (ev "(defmacro temp-b [] `(quote x#))")
  (in-user!)
  (is (= false (ev "(= (temp-a) (temp-b))"))))

(deftest unquoted-symbols-are-not-renamed
  (in-user!)
  (ev "(defmacro keep [s] `(quote ~s))")
  (in-user!)
  ; x# here is a raw macro argument, spliced via ~, so it stays x#
  (is (= (tuple :symbol "x#") (ev "(keep x#)"))))

(deftest nested-syntax-quotes-get-independent-gensym-maps
  (in-user!)
  (ev "(defmacro two-temps [] `(list `(quote x#) `(quote x#)))")
  (in-user!)
  (is (= false (ev "(= (first (two-temps)) (second (two-temps)))"))))

(deftest a-hash-in-the-middle-of-a-symbol-is-untouched
  (in-user!)
  (is (= (tuple :symbol "a#b") (ev "(quote a#b)"))))

(deftest gensym-and-gensym-p-produce-distinct-symbols
  (in-user!)
  (is (= false (ev "(= (gensym) (gensym))")))
  (is (= false (ev "(= (gensym \"p\") (gensym \"p\"))")))
  (let [name (elem (ev "(gensym \"zz\")") 1)]
    (is (Regex/match? (Regex/compile! "^zz__\\d+__auto$") name))))

(deftest gensym-yields-a-usable-macro-temporary
  (in-user!)
  (ev "(defmacro two-g [a b] (let [g (gensym \"t\")] `(let [~g ~a] [~g ~g ~b])))")
  (in-user!)
  (is (= [1 1 2] (ev "(two-g 1 2)"))))

; ═══════════════════════════════════════════════════════════════════════════
; wave 10 — prelude gaps
; ═══════════════════════════════════════════════════════════════════════════

(deftest get-works-at-both-arities
  (in-user!)
  (is (= 1 (ev "(get {:a 1} :a)")))
  (is (= nil (ev "(get {:a 1} :missing)")))
  (is (= :dflt (ev "(get {:a 1} :missing :dflt)")))
  (is (= 1 (ev "(get {:a 1} :a :dflt)"))))

(deftest assoc-is-polymorphic-over-maps-and-vectors-and-variadic
  (in-user!)
  (is (= {:a 1 :b 2} (ev "(assoc {:a 1} :b 2)")))
  (is (= {:a 1 :b 2} (ev "(assoc {} :a 1 :b 2)")))
  (is (= {:a 9} (ev "(assoc {:a 1} :a 9)")))
  (is (= {:a 1} (ev "(assoc nil :a 1)")))
  (is (= [10 99 30] (ev "(assoc [10 20 30] 1 99)"))))

(deftest numeric-collection-predicates-are-one-liners-in-core
  (in-user!)
  (is (= true (ev "(even? 4)")))
  (is (= false (ev "(even? 3)")))
  (is (= true (ev "(odd? 3)")))
  (is (= true (ev "(zero? 0)")))
  (is (= true (ev "(pos? 3)")))
  (is (= false (ev "(pos? 0)")))
  (is (= true (ev "(neg? -2)"))))

(deftest take-and-drop-are-clojure-ordered-n-first
  (in-user!)
  (is (= (list 1 2 3) (ev "(take 3 (list 1 2 3 4 5))")))
  (is (= (list 3 4) (ev "(drop 2 (list 1 2 3 4))")))
  (is (= (list 1 2) (ev "(drop 0 (list 1 2))")))
  (is (= () (ev "(drop 5 (list 1 2))"))))

; ═══════════════════════════════════════════════════════════════════════════
; wave 10 — lazy sequences
; ═══════════════════════════════════════════════════════════════════════════

(deftest infinite-range-plus-take-realize-only-what-they-need
  (in-user!)
  (is (= (list 1 2 3 4 5) (ev "(take 5 (map inc (range)))")))
  ; map over an infinite range must not realize the whole thing
  (is (= 10 (ev "(count (take 10 (range)))"))))

(deftest a-chunks-thunk-realizes-once-caching-its-whole-chunk
  ; map is chunked at 32: the first force realizes one chunk (32
  ; elements) and caches it, so re-forcing the same cells re-runs
  ; nothing. The counter is 32 (one chunk), not 1 (one element).
  (in-user!)
  (is (= 32 (ev "(let [n (atom 0)
                         s (map (fn [x] (swap! n inc) x) (range))]
                     (first s) (first s) (first s) (rest s) @n)"))))

(deftest lazy-seq-macro-memoizes-its-body-the-same-way
  (in-user!)
  (is (= 1 (ev "(let [n (atom 0)
                        s (lazy-seq (swap! n inc) (list 1 2 3))]
                    (first s) (first s) (first s) @n)"))))

(deftest forcing-a-finite-prefix-of-an-infinite-seq-realizes-exactly-one-chunk
  ; `take 5` forces one 32-element chunk (map is chunked), so the thunk
  ; runs 32 times — not all of an infinite range, and not just 5 either:
  ; the chunk boundary is the granularity of realization.
  (in-user!)
  (is (= 32 (ev "(let [n (atom 0)
                         s (map (fn [x] (swap! n inc) x) (range))]
                     (doall (take 5 s))
                     @n)"))))

(deftest iterate-take-while-drop-while-cycle-are-lazy-and-compose
  (in-user!)
  (is (= (list 1 2 4 8 16) (ev "(take 5 (iterate (fn [x] (* x 2)) 1))")))
  (is (= (list 0 1 2 3 4) (ev "(doall (take-while (fn [x] (< x 5)) (range)))")))
  (is (= (list 5 6 7) (ev "(take 3 (drop-while (fn [x] (< x 5)) (range)))")))
  (is (= (list 1 2 3 1) (ev "(take 4 (cycle (list 1 2 3)))")))
  (is (= (list 1 2 0 1) (ev "(take 4 (concat (list 1 2) (range)))")))
  (is (= 2 (ev "(first (filter even? (iterate inc 1)))"))))

(deftest repeat-is-infinite-and-lazy-repeat-n-is-a-realized-list
  (in-user!)
  (is (= (list :x :x :x :x) (ev "(take 4 (repeat :x))")))
  (is (= (list :x :x :x) (ev "(repeat 3 :x)")))
  (is (= () (ev "(repeat 0 :x)"))))

(deftest lazy-seqs-are-enumerable-for-elixir-interop
  (in-user!)
  (is (= (list 1 2 3 4 5) (ev "(Enum/take (map inc (range)) 5)")))
  (is (= (list 1 2 1 2) (ev "(Enum/to_list (take 4 (cycle (list 1 2))))")))
  (is (= 10 (ev "(Enum/sum (take 5 (range)))")))
  (is (= (list 0 1 4) (ev "(Enum/map (take 3 (range)) (fn [x] (* x x)))"))))

(deftest printing-an-infinite-seq-is-bounded-not-a-hang
  (in-user!)
  (let [pr (ev "(pr-str (map inc (range)))")]
    (is (erlang/is_binary pr))
    (is (includes? pr "(1 2 3"))
    (is (ends-with? pr "…)"))))

(deftest doall-100k-does-not-blow-the-stack
  (in-user!)
  (is (= 100000 (ev "(count (doall (take 100000 (map inc (range)))))"))))

(deftest seq-empty-first-rest-nth-dispatch-on-lazy-seqs
  (in-user!)
  (is (= false (ev "(nil? (seq (map inc (range))))")))
  (is (= true (ev "(nil? (seq (take 0 (range))))")))
  (is (= false (ev "(empty? (map inc (range)))")))
  (is (= true (ev "(empty? (take 0 (range)))")))
  (is (= 1 (ev "(first (map inc (range)))")))
  (is (= 5 (ev "(nth (map inc (range)) 4)")))
  (is (= 5 (ev "(count (take 5 (map inc (range))))")))
  (is (= true (ev "(= (take 4 (cycle (list 1 2))) (list 1 2 1 2))"))))

; ═══════════════════════════════════════════════════════════════════════════
; wave 11 — defmulti / defmethod
; ═══════════════════════════════════════════════════════════════════════════

(deftest dispatch-on-a-keyword-extracts-the-method-by-dispatch-value
  (in-user!)
  (ev "(defmulti area-m :shape)
       (defmethod area-m :circle [s] (* 3.14159 (:r s) (:r s)))
       (defmethod area-m :rect [s] (* (:w s) (:h s)))")
  (in-user!)
  (is (= (* 3.14159 4) (ev "(area-m {:shape :circle :r 2})")))
  (is (= 12 (ev "(area-m {:shape :rect :w 3 :h 4})"))))

(deftest the-dispatch-fn-receives-all-args-multi-arg-dispatch-works
  (in-user!)
  (ev "(defn kind-of [o] (:kind o))
       (defmulti speak-to (fn [speaker listener] (kind-of listener)))
       (defmethod speak-to :human [s l] (str \"hello \" (:name l)))
       (defmethod speak-to :robot [s l] \"beep boop\")")
  (in-user!)
  (is (= "hello alice"
         (ev "(speak-to {:kind :dog :name \"rex\"} {:kind :human :name \"alice\"})")))
  (is (= "beep boop" (ev "(speak-to {:kind :cat} {:kind :robot})"))))

(deftest a-vector-dispatch-value-keys-a-method
  (in-user!)
  (ev "(defn kind-of [o] (:kind o))
       (defmulti collide-m (fn [a b] [(kind-of a) (kind-of b)]))
       (defmethod collide-m [:asteroid :ship] [a b] :boom)
       (defmethod collide-m :default [& xs] :nothing)")
  (in-user!)
  (is (= :boom (ev "(collide-m {:kind :asteroid} {:kind :ship})")))
  ; A structurally-equal vector built at call time must still hit.
  (is (= :boom (ev "(collide-m {:kind :asteroid} {:kind :ship :extra 1})")))
  (is (= :nothing (ev "(collide-m {:kind :ship} {:kind :ship})"))))

(deftest default-is-the-fallback-for-any-unmatched-dispatch-value
  (in-user!)
  (ev "(defmulti f-default :tag)
       (defmethod f-default :a [x] :A)
       (defmethod f-default :default [x] :fallback)")
  (in-user!)
  (is (= :A (ev "(f-default {:tag :a})")))
  (is (= :fallback (ev "(f-default {:tag :zzz})"))))

(deftest missing-method-and-no-default-raises-a-clear-error
  (in-user!)
  (ev "(defmulti f-missing :tag) (defmethod f-missing :a [x] :A)")
  (in-user!)
  (is (raises-with? :Elixir.RuntimeError "user/f-missing"
                    (fn [] (ev "(f-missing {:tag :nope})"))))
  (is (raises-with? :Elixir.RuntimeError ":nope"
                    (fn [] (ev "(f-missing {:tag :nope})")))))

(deftest defmethod-adds-and-replaces-methods-without-touching-the-others
  (in-user!)
  (ev "(defmulti m-repl :id)
       (defmethod m-repl :a [x] :A)
       (defmethod m-repl :b [x] :B)
       (defmethod m-repl :b [x] :B2)
       (defmethod m-repl :c [x] :C)")
  (in-user!)
  (is (= :A (ev "(m-repl {:id :a})")))
  (is (= :B2 (ev "(m-repl {:id :b})")))
  (is (= :C (ev "(m-repl {:id :c})"))))

(deftest re-defining-defmulti-preserves-existing-methods-clj-1351
  (in-user!)
  (ev "(defmulti m-pres :id)
       (defmethod m-pres :a [x] :A)")
  (in-user!)
  ; Re-issue defmulti with the same dispatch fn: methods survive.
  (ev "(defmulti m-pres :id)")
  (in-user!)
  (is (= :A (ev "(m-pres {:id :a})")))
  ; Redefining with a *different* dispatch fn also keeps methods.
  (ev "(defmulti m-pres (fn [x] (:other x)))")
  (ev "(defmethod m-pres :z [x] :Z)")
  (in-user!)
  (is (= :Z (ev "(m-pres {:other :z})")))
  (is (= :A (ev "(m-pres {:other :a})"))))

(deftest variadic-method-bodies-work
  (in-user!)
  (ev "(defmulti total-v (fn [m & more] (:which m)))
       (defmethod total-v :all [cfg & xs] (reduce + 0 xs))
       (defmethod total-v :first [cfg x & more] x)")
  (in-user!)
  (is (= 10 (ev "(total-v {:which :all} 1 2 3 4)")))
  (is (= 7 (ev "(total-v {:which :first} 7 8 9)"))))

(deftest a-multimethod-defined-in-one-ns-is-callable-from-another-after-require
  (in-user!)
  (ev "(ns w11.lib)
       (defmulti greet :lang)
       (defmethod greet :en [m] (str \"hi \" (:name m)))
       (defmethod greet :es [m] (str \"hola \" (:name m)))")
  ; See the file header: under ward's env fork the require needs the ns marked
  ; loaded, which the ExUnit suite's top-level VM had implicitly.
  (BeamLisp.Env/mark_loaded "w11.lib")
  (ev "(ns w11.app (:require [w11.lib :as lib]))")
  (is (= "hi bob" (ev "(lib/greet {:lang :en :name \"bob\"})")))
  (is (= "hola bob" (ev "(lib/greet {:lang :es :name \"bob\"})"))))

(deftest defmethod-resolves-the-multi-through-an-alias
  (in-user!)
  (ev "(ns w11.lib2)
       (defmulti m :id)
       (defmethod m :a [x] :A)")
  (BeamLisp.Env/mark_loaded "w11.lib2")
  (ev "(ns w11.app2 (:require [w11.lib2 :as l]))
       (defmethod l/m :b [x] :B)")
  (is (= :B (ev "(l/m {:id :b})")))
  (is (= :A (ev "(l/m {:id :a})"))))

(deftest defmulti-supports-a-docstring-stored-as-var-metadata
  (in-user!)
  (ev "(defmulti m-doc \"docstring\" :id)")
  (ev "(defmethod m-doc :a [x] :A)")
  (in-user!)
  (is (= :A (ev "(m-doc {:id :a})")))
  (let [m (BeamLisp.Env/meta "user" "m-doc")]
    (is (= :ok (elem m 0)))
    (is (= "docstring" (get (elem m 1) :doc)))))

; ═══════════════════════════════════════════════════════════════════════════
; wave 11 — hierarchies (derive / isa?)
; ═══════════════════════════════════════════════════════════════════════════

(deftest derive-isa-walk-the-parent-chain
  (in-user!)
  (ev "(multi/derive :cat :animal)
       (multi/derive :animal :living)")
  (in-user!)
  (is (= true (ev "(multi/isa? :cat :animal)")))
  (is (= true (ev "(multi/isa? :cat :living)")))
  (is (= false (ev "(multi/isa? :animal :cat)")))
  (is (= true (ev "(multi/isa? :cat :cat)")))
  (is (= false (ev "(multi/underive :cat :animal)")))
  (in-user!)
  (is (= false (ev "(multi/isa? :cat :animal)"))))

(deftest a-dispatch-value-derived-from-a-method-key-still-hits-that-method
  (in-user!)
  (ev "(multi/derive :cat :animal)
       (defmulti h-speak :kind)
       (defmethod h-speak :animal [a] :generic)
       (defmethod h-speak :cat [a] :meow)")
  (in-user!)
  (is (= :meow (ev "(h-speak {:kind :cat})")))
  (is (= :generic (ev "(h-speak {:kind :animal})"))))

; ═══════════════════════════════════════════════════════════════════════════
; wave 11 — protocols (defprotocol / extend-type)
; ═══════════════════════════════════════════════════════════════════════════

(deftest methods-dispatch-on-the-type-tag-of-the-first-argument
  (in-user!)
  (ev "(defprotocol Greet (greet-p [this]) (describe-p [this]))
       (extend-type :vector Greet
         (greet-p [v] (str \"vector of \" (count v)))
         (describe-p [v] \"a vector\"))
       (extend-type :map Greet
         (greet-p [m] \"map\")
         (describe-p [m] \"a map\"))")
  (in-user!)
  (is (= "vector of 3" (ev "(greet-p [1 2 3])")))
  (is (= "a map" (ev "(describe-p {:a 1})"))))

(deftest extend-protocol-fills-several-types-at-once
  (in-user!)
  (ev "(defprotocol Prot (prot-fn [x]))
       (extend-protocol Prot
         :list (prot-fn [l] (str \"list \" (count l)))
         :integer (prot-fn [n] (str \"int \" n))
         :binary (prot-fn [s] (str \"str \" s)))")
  (in-user!)
  (is (= "list 2" (ev "(prot-fn '(1 2))")))
  (is (= "int 5" (ev "(prot-fn 5)")))
  (is (= "str hi" (ev "(prot-fn \"hi\")"))))

(deftest extending-a-type-after-the-fact-keeps-earlier-calls-working
  (in-user!)
  (ev "(defprotocol Area-p (area-p [x]))
       (extend-type :integer Area-p (area-p [n] (* n n)))")
  (in-user!)
  (is (= 9 (ev "(area-p 3)")))
  ; New type extended later; old calls unaffected.
  (ev "(extend-type :vector Area-p (area-p [v] (reduce + 0 v)))")
  (in-user!)
  (is (= 6 (ev "(area-p [1 2 3])")))
  (is (= 16 (ev "(area-p 4)"))))

(deftest a-protocol-method-with-no-implementation-for-a-type-raises-clearly
  (in-user!)
  (ev "(defprotocol Q-p (q-p [x]))
       (extend-type :vector Q-p (q-p [v] :vec))")
  (in-user!)
  (is (raises-with? :Elixir.RuntimeError "No implementation of method q-p"
                    (fn [] (ev "(q-p 5)")))))

(deftest the-protocol-descriptor-var-is-a-tagged-value
  (in-user!)
  (ev "(defprotocol D-p (d-p [x])) (extend-type :vector D-p (d-p [v] :ok))")
  (in-user!)
  (is (= :ok (ev "(d-p [1])"))))
