(ns aot-constructor-atom-test)

(defn- node [value]
 {:op :remote :mod :Elixir.String :fun :to_atom :args (list {:op :lit :val value})})
(defn- run [expression]
 (BeamLisp.AOT/interpret_constructor! expression {} {}))
(defn- detail [expression]
 (try (run expression) :accepted (catch e (:detail (ex-data e)))))
(defn- absent? [name]
 (try (String/to_existing_atom name) false (catch Elixir.ArgumentError _ true)))

(deftest exact-string-atom-route-matches-native-binary-semantics
 (doseq [name ["" "Elixir.BeamLisp.Atom" "Elixir.BeamLisp.Volatile"
               "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Future" "Elixir.BeamLisp.Reduced"
               "aot/atom-parity" "aot-λ"]]
  (is (= (String/to_atom name) (run (node name)))))
 (let [name (str "aot-fresh-atom-" (System/unique_integer (list :positive)))]
  (is (= true (absent? name)))
  (let [actual (run (node name))]
   (is (= (String/to_atom name) actual)))))

(deftest invalid-and-oversized-atoms-refuse-before-interning
 (doseq [value [nil :already-an-atom 17 (list "name")]]
  (is (= :atom-string-domain (detail (node value)))))
 (let [name (str (String/duplicate "x" 256) (System/unique_integer (list :positive)))]
  (is (= true (absent? name)))
  (is (= :atom-name-budget (detail (node name))))
  (is (= true (absent? name))))
 (let [invalid (erlang/list_to_binary (list 255))]
  (is (= :argument-error
         (try (String/to_atom invalid) :accepted (catch Elixir.ArgumentError _ :argument-error))))
  (is (= :argument-error
         (try (run (node invalid)) :accepted (catch Elixir.ArgumentError _ :argument-error))))))

(deftest direct-and-keyword-interning-share-one-frame-budget
 (let [prefix (str "aot-shared-atom-" (System/unique_integer (list :positive)) "-")
       names (Enum/map (Enum/to_list (Range/new 0 64)) (fn [n] (str prefix n)))
       calls (Enum/map (Enum/with_index names)
              (fn [row]
               (if (= 0 (rem (elem row 1) 2)) (node (elem row 0))
                {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :keyword
                 :args (list {:op :lit :val (elem row 0)})})))
       expression {:op :do :stmts calls}]
  (is (= :new-atom-budget (detail expression)))
  (is (= false (absent? (nth names 63))))
  (is (= true (absent? (nth names 64))))
  ;; Existing names do not consume the new-name allowance.
  (is (= :known (run {:op :do :stmts (Enum/map (Enum/to_list (Range/new 1 100))
                                     (fn [_] (node "known")))})))))

(deftest atom-route-does-not-admit-lookalikes-coercion-or-effects
 (let [path (str (System/get_env "HOME") "/tmp/aot-atom-never-written-"
                 (System/unique_integer (list :positive)))
       effect {:op :remote :mod :Elixir.File :fun :write!
               :args (list {:op :lit :val path} {:op :lit :val "unexpected"})}]
  (is (= false (File/exists? path)))
  (is (= {:remote [:Elixir.File :write! 2]} (detail effect)))
  (is (= false (File/exists? path)))
  (is (= {:remote [:Elixir.String :to_atom 0]}
         (detail {:op :remote :mod :Elixir.String :fun :to_atom :args (list)})))
  (is (= {:remote [:Elixir.String :to_atom 2]}
         (detail {:op :remote :mod :Elixir.String :fun :to_atom
                  :args (list {:op :lit :val "a"} {:op :lit :val "b"})})))
  (is (= {:remote [:Elixir.ConstructorAtomLookalike :to_atom 1]}
         (detail (assoc (node "name") :mod :Elixir.ConstructorAtomLookalike))))
  (is (= :unsafe-first-order-data
         (try (run (node (fn [] (File/write! path "unexpected")))) :accepted
              (catch e (:kind (ex-data e))))))
  (is (= false (File/exists? path)))))

(defn- in-scope [action]
 ;; Privileged native component harness only. Refuse existing application
 ;; authority rather than clearing it around a supplied callback.
 (let [previous (BeamLisp.Env/capture)
       prior-context (Process/get :bl_sdk_constructor_context)
       _ (when (or (:generation previous) (:application-identity previous))
           (erlang/error :component-harness-requires-kernel-context))
       path (BeamLisp.Loader/source_path "bl.util")
       source (BeamLisp.Loader/read_source path)
       input (BeamLisp.AOT/constructor_source_input! "bl.util" path source)
       scope (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Loader/without_initialization
    (fn []
     (BeamLisp.Env/with_env scope
      (fn []
       (Process/put :bl_sdk_constructor_context
        {:input input :compiler-env scope :units {} :compiled {} :compiling #{}
         :clauses {} :seen-macros #{} :kernel-modules #{} :kernel-leases (list)
         :macro-steps 16384 :new-atoms 128 :expanded 0})
       (BeamLisp.AOT/constructor_install_kernel!)
       (action)))))
   (finally
    (let [context (Process/get :bl_sdk_constructor_context)]
     (Enum/each (:kernel-leases context) (fn [handle] (BeamLisp.Env/release_code! handle))))
    (BeamLisp.Env/destroy scope)
    (if prior-context (Process/put :bl_sdk_constructor_context prior-context)
                      (Process/delete :bl_sdk_constructor_context))
    (BeamLisp.Env/bind previous)))))

(defn- actual-source-call [binding arguments]
 (run {:op :apply :fn {:op :global :ns "core" :name binding}
       :args (Enum/map arguments (fn [value] {:op :lit :val value}))}))

(deftest actual-physical-core-reference-and-dissoc-paths-remain-pure
 (in-scope
  (fn []
   (doseq [value [nil false true 17 "value" :key (list 1 2) [1 2] #{:a :b} {:a 1}]]
    (is (= (BeamLisp.Ns.Core/ref-type? value) (actual-source-call "ref-type?" (list value)))))
   (doseq [value [nil 17 (list 1 2) {:a 1 :b 2}]]
    (is (= (BeamLisp.Ns.Core/dissoc value :a)
           (actual-source-call "dissoc" (list value :a)))))
   (is (= {} (actual-source-call "dissoc" (list {:a 1 :b 2} :a :b))))
   (let [name (str "aot-unit-atom-" (System/unique_integer (list :positive)))]
    (BeamLisp.AOT/constructor_context_put! :new-atoms 0)
    (is (= :unit-new-atom-budget (detail (node name))))
    (is (= true (absent? name)))
    (is (= :known (run (node "known"))))))))

(deftest exact-classifiers-and-map-delete-retain-the-public-data-boundary
 (doseq [target [[:Elixir.BeamLisp.Multi :type_of] [:Elixir.BeamLisp.Ns.Rt :sorted_map?]
                 [:Elixir.BeamLisp.Record :record?]]]
  (doseq [value [nil false 1 "v" :key (list 1) [1] #{:a} {:a 1}]]
   (is (= (erlang/apply (first target) (second target) (list value))
          (run {:op :remote :mod (first target) :fun (second target)
                :args (list {:op :lit :val value})}))))
  (is (= :unsafe-first-order-data
         (try (run {:op :remote :mod (first target) :fun (second target)
                    :args (list {:op :lit :val {:__struct__ :Elixir.ConstructorAtomForeign}})})
              :accepted (catch e (:kind (ex-data e)))))))
 (is (= {:b 2}
        (run {:op :remote :mod :Elixir.Map :fun :delete
              :args (list {:op :lit :val {:a 1 :b 2}} {:op :lit :val :a})})))
 (is (= :plain-map-delete-domain
        (detail {:op :remote :mod :Elixir.Map :fun :delete
                 :args (list {:op :lit :val [1]} {:op :lit :val :meta})})))
 (let [path (str (System/get_env "HOME") "/tmp/aot-classifier-never-written-"
                 (System/unique_integer (list :positive)))
       callback {:op :fn :clauses (list {:pats (list) :guard nil
                         :body {:op :remote :mod :Elixir.File :fun :write!
                                :args (list {:op :lit :val path} {:op :lit :val "unexpected"})}})}
       capsule {:op :remote :mod :Elixir.BeamLisp.LazySeq :fun :new :args (list callback)}]
  (doseq [[value expected] [[callback :unsafe-first-order-data] [capsule :constructor-machine-refused]]]
   (is (= expected
          (try (run {:op :remote :mod :Elixir.BeamLisp.Multi :fun :type_of :args (list value)})
               :accepted (catch e (:kind (ex-data e)))))))
  (is (= false (File/exists? path)))))
