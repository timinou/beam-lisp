(ns aot-constructor-machine-test)

(defn- definitions [namespace]
 (let [root (System/get_env "BL_CONSTRUCTOR_METADATA_ROOT")]
  (if root
   (erlang/binary_to_term (File/read! (str root "/" namespace ".env-anf.term")) (list :safe))
   (do (BeamLisp.Loader/ensure_loaded namespace) (BeamLisp.Env/ns_defs namespace)))))
(defn- actual-lookup-owner [namespace binding]
 (loop [candidates (BeamLisp.Env/candidates namespace binding)]
  (when (seq candidates)
   (let [pair (first candidates) value (BeamLisp.Env/lookup pair)]
    (if (and (erlang/is_tuple value) (= :ok (elem value 0)))
     [(elem pair 0) (elem pair 1)]
     (recur (rest candidates)))))))
(deftest actual-compiler-namespace-definitions-preserve-clause-construction
 (let [defs {"proc.server" (definitions "proc.server")}
       form (BeamLisp.AOT/constructor_call! defs {} "proc.server" "clause-extension-form"
               [:constructor-probe 'transform])]
  (is (= 'def (first form)))
  (is (= 'proc.server/register-clause! (first (last form))))
  (is (= 'transform (last (last form))))
  (is (= true (BeamLisp.AOT/constructor_call! defs {} "proc.server" "native-clause?" ['init])))
  (is (= false (BeamLisp.AOT/constructor_call! defs {} "proc.server" "native-clause?" ['nonsense])))))

(deftest native-effects-opaque-input-and-runaway-recursion-refuse-without-execution
 (let [path (str (System/get_env "HOME") "/tmp/constructor-machine-never-written")
       effect {:op :remote :mod :Elixir.File :fun :write!
               :args [{:op :lit :val path} {:op :lit :val "unexpected"}]}]
  (is (= false (File/exists? path)))
  (is (= :constructor-machine-refused
         (try (BeamLisp.AOT/interpret_constructor! effect {} {}) nil (catch e (:kind (ex-data e))))))
  (is (= false (File/exists? path)))
  (is (= :unsafe-first-order-data
         (try (BeamLisp.AOT/interpret_constructor! {:op :lit :val (fn [] (File/write! path "unexpected"))} {} {})
              nil (catch e (:kind (ex-data e))))))
  (is (= false (File/exists? path)))))

(deftest interpreted-lambdas-and-patterns-use-the-actual-compiler-scaffold
 (let [node (BeamLisp.Compiler/compile
              (first (BeamLisp.Reader/read_string
                "((fn [[a b]] {:sum (+ a b) :items (map (fn [x] (+ x 1)) [a b])}) [10 20])"))
              (BeamLisp.Compiler/new_env "user"))]
  (is (= {:sum 30 :items (list 11 21)} (BeamLisp.AOT/interpret_constructor! node {} {})))))

(defn- actual-value-initializers [namespace]
 (let [path (BeamLisp.Loader/source_path namespace)
       forms (BeamLisp.Reader/read_string (File/read! path) path)
       values (reduce
                (fn [values form]
                 (let [node (BeamLisp.AOT/unmeta form)]
                  (if (and (erlang/is_tuple node) (= :list (elem node 0))
                           (= (tuple :symbol "def") (first (elem node 1))))
                   (BeamLisp.AOT/capture_value_def values form namespace) values))) {} forms)]
  (into {} (map (fn [entry]
                 [[namespace (elem entry 0)]
                  (BeamLisp.Loader/without_initialization
                   (BeamLisp.Env/as_thunk
                    #(BeamLisp.AOT/compile_initializer (elem entry 2) (BeamLisp.Compiler/new_env namespace))))])
               (get values namespace)))))

(deftest real-tick-contribution-interprets-actual-clause-and-private-helper-anf
 (BeamLisp.Loader/ensure_loaded "proc.tick")
 (let [defs {"proc.tick" (definitions "proc.tick")}
       values (actual-value-initializers "proc.tick")
       clause '(tick 10 :ms {:once true} [st] (noreply st))
       context {:name 'clock}
       resolved (actual-lookup-owner "proc.tick" "concat")
       _ (is (= ["core" "concat"] resolved))
       aliases {["proc.tick" "concat"] resolved}
       interpreted (BeamLisp.AOT/constructor_call! defs values aliases "proc.tick" "tick-clause" [clause context])
       reference (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "proc.tick" "tick-clause")
                    (list clause context))]
  (is (= reference interpreted))
  (is (= 'proc.tick/tick-arm (first (first (:prelude interpreted)))))
  (is (= 'handle-info (first (first (:clauses interpreted)))))))

(deftest recursive-actual-anf-control-is-depth-bounded
 (let [call {:op :remote :mod :constructor.recursive-probe :fun :forever :args (list)}
       metadata {:remotes {[:constructor.recursive-probe :forever 0]
                           {:clauses (list {:pats (list) :guard nil :body call})}}}]
  (is (= :depth-budget
         (try (BeamLisp.AOT/interpret_constructor! call {} metadata) nil (catch e (:detail (ex-data e))))))))

(deftest foreign-shadowed-global-never-becomes-a-core-primitive-by-name
 (is (= :constructor-machine-refused
        (try (BeamLisp.AOT/interpret_constructor! {:op :global :ns "foreign" :name "map"} {} {}) nil
             (catch e (:kind (ex-data e))))))
 (is (= "shadow"
        (BeamLisp.AOT/interpret_constructor! {:op :global :ns "foreign" :name "str"} {}
                      {:globals {["foreign" "str"] {:op :lit :val "shadow"}}}))))

(defn- refusal-detail [expression]
 (try (BeamLisp.AOT/interpret_constructor! expression {} {}) nil (catch e (:detail (ex-data e)))))
(defn- ir-list [nodes]
 (reduce (fn [tail head] {:op :cons :head head :tail tail}) {:op :enil} (reverse nodes)))

(deftest concatenation-refuses-combined-size-before-native-copying
 (let [big {:op :lit :val (to-list (range 1000))}
       args (ir-list (repeat 80 {:op :var :name "big"}))
       expression {:op :let :name "big" :init big
                   :body {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :concat__bl_v :args (list args)}}]
  (is (= :aggregate-node-budget (refusal-detail expression)))))

(deftest mapcat-refuses-an-excessive-prefix-before-retaining-or-flattening-it
 (let [function {:op :fn :clauses (list {:pats (list {:pop :pvar :name "item"})
                                        :guard nil :body {:op :var :name "big"}})}
       expression {:op :let :name "big" :init {:op :lit :val (to-list (range 1000))}
                   :body {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :mapcat__bl_v
                          :args (list function (ir-list (list {:op :lit :val (to-list (range 40))})))}}]
  (is (= :aggregate-node-budget (refusal-detail expression)))))

(deftest retained-closure-captures-consume-a-cumulative-byte-budget
 (let [next {:op :fn :clauses (list {:pats (list) :guard nil
                                    :body {:op :tuple :elems (list {:op :var :name "prior"}
                                                                  {:op :var :name "blob"})}})}
       step {:op :fn :clauses (list {:pats (list {:pop :pvar :name "prior"} {:pop :pvar :name "item"})
                                    :guard nil :body next})}
       expression {:op :let :name "blob" :init {:op :lit :val (String/duplicate "x" 600000)}
                   :body {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :reduce
                          :args (list step {:op :lit :val nil} {:op :lit :val (to-list (range 100))})}}]
  (is (= :allocation-byte-budget (refusal-detail expression)))))

(deftest interpreted-patterns-preserve-exact-erlang-literal-and-empty-list-matching
 (let [choose (fn [pattern value]
               (BeamLisp.AOT/interpret_constructor! {:op :case :subj {:op :lit :val value}
                              :clauses (list {:pats (list pattern) :guard nil :body {:op :lit :val :matched}}
                                             {:pats (list {:pop :pvar :name "otherwise"})
                                              :guard nil :body {:op :lit :val :different}})} {} {}))]
  (is (= :different (choose {:pop :plit :val 1} 1.0)))
  (is (= :different (choose {:pop :pnil} nil)))
  (is (= :matched (choose {:pop :pnil} (list))))))

(deftest repeated-pattern-variables-use-exact-erlang-equality
 (let [pattern {:pop :ptuple :elems (list {:pop :pvar :name "x"} {:pop :pvar :name "x"})}]
  ;; Generic input deliberately admits only source-domain tuples. Construct
  ;; the subject in ANF so this checks the Erlang pattern ABI directly.
  (is (= :different
         (BeamLisp.AOT/interpret_constructor! {:op :case :subj {:op :tuple :elems (list {:op :lit :val 1} {:op :lit :val 1.0})}
                        :clauses (list {:pats (list pattern) :guard nil :body {:op :lit :val :matched}}
                                       {:pats (list {:pop :pvar :name "other"})
                                        :guard nil :body {:op :lit :val :different}})} {} {})))))

(deftest join-proves-separator-expansion-before-native-allocation
 (let [expression {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :join
                   :args (list {:op :lit :val (String/duplicate "x" 100000)}
                               {:op :lit :val (to-list (repeat 20 ""))})}]
  (is (= :aggregate-byte-budget (refusal-detail expression)))
  (is (= "a--b--c"
         (BeamLisp.AOT/interpret_constructor! {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :join
                        :args (list {:op :lit :val "--"}
                                    {:op :lit :val (list "a" "b" "c")})} {} {})))))

(deftest dynamically-created-keywords-have-a-pre-intern-budget
 (let [prefix (str "constructor-probe-" (System/unique_integer (list :positive)) "-")
       names (to-list (map #(str prefix %) (range 65)))
       expression {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :map
                   :args (list {:op :fn :clauses (list {:pats (list {:pop :pvar :name "s"})
                                                       :guard nil
                                                       :body {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :keyword
                                                              :args (list {:op :var :name "s"})}})}
                               {:op :lit :val names})}]
  (is (= :new-atom-budget (refusal-detail expression)))
  (is (= true (erlang/is_atom (String/to_existing_atom (nth names 63)))))
  (is (= :absent (try (String/to_existing_atom (nth names 64)) :present
                       (catch Elixir.ArgumentError _ :absent))))
  (is (= :known
         (BeamLisp.AOT/interpret_constructor! {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :keyword
                        :args (list {:op :lit :val "known"})} {} {})))))

(deftest core-run-and-native-invoke-keep-their-real-abi-identities
 (let [identity {:op :fn :clauses (list {:pats (list {:pop :pvar :name "x"})
                                       :guard nil :body {:op :var :name "x"}})}]
  (is (= nil
         (BeamLisp.AOT/interpret_constructor!
          {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :run!
           :args (list identity {:op :lit :val (list 1 2 3)})} {} {})))
  (is (= 42
         (BeamLisp.AOT/interpret_constructor!
          {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :invoke
           :args (list identity {:op :lit :val (list 42)})} {} {})))))

(deftest constructed-foreign-structs-refuse-before-native-protocol-dispatch
 (doseq [[tag primitive] [[:Elixir.BeamLisp.LazySeq :count]
                          [:Elixir.BeamLisp.Delay :nth]
                          [:Elixir.ConstructorForeignProtocol :conj]]]
  (let [value {:op :map :pairs (list [{:op :lit :val :__struct__} {:op :lit :val tag}]
                                    [{:op :lit :val :thunk}
                                     {:op :fn :clauses (list {:pats (list) :guard nil
                                                             :body {:op :remote :mod :Elixir.File :fun :write!
                                                                    :args (list)}})}])}
        expression {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun primitive
                    :args (list value)}]
   (is (= :foreign-struct
          (try (BeamLisp.AOT/interpret_constructor! expression {} {}) nil
               (catch e (:reason (ex-data e))))))))
 (let [forged {:op :map :pairs (list [{:op :lit :val :__struct__} {:op :lit :val :Elixir.BeamLisp.Vector}]
                                    [{:op :lit :val :items} {:op :lit :val "not tuple storage"}]
                                    [{:op :lit :val :meta} {:op :lit :val nil}])}]
  (is (= :vector-storage
         (try (BeamLisp.AOT/interpret_constructor! forged {} {}) nil
              (catch e (:reason (ex-data e))))))))

(deftest pure-primitive-adapters-refuse-unsupported-arities-before-dispatch
 (doseq [[function arguments] [[:identity (list)] [:identity (list 1 2)]
                               [:count (list)] [:count (list (list) (list))]
                               [:nil? (list)] [:first (list (list) 1)]
                               [:map (list nil)] [:filter (list nil)]
                               [:take (list 1)] [:drop (list 1)] [:remove (list nil)]]]
  (let [expression {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun function
                    :args (mapv (fn [value] {:op :lit :val value}) arguments)}]
   (is (= {:unsupported-primitive-arity [(name function) (count arguments)]}
          (try (BeamLisp.AOT/interpret_constructor! expression {} {}) nil
               (catch e (:detail (ex-data e)))))))))

(deftest supported-nth-and-merge-adapters-preserve-native-results
 (let [run (fn [function arguments]
             (BeamLisp.AOT/interpret_constructor!
              {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun function
               :args (mapv (fn [value] {:op :lit :val value}) arguments)} {} {}))]
  (is (= (BeamLisp.Ns.Rt/nth [] 20) (run :nth (list [] 20))))
  (is (= (BeamLisp.Ns.Rt/nth [] 20 :default) (run :nth (list [] 20 :default))))
  (is (= (BeamLisp.Ns.Rt/nth [nil] 0 :default) (run :nth (list [nil] 0 :default))))
  (is (= nil (run :merge (list))))
  (is (= {:a 1 :b 2} (run :merge (list nil {:a 1} nil {:b 2}))))
  (is (= [] (run :into (list))))
  (is (= [:a] (run :into (list [:a]))))
  (is (= [:a :b] (run :into (list [:a] (list :b)))))))

(deftest admitted-sequence-type-predicate-matches-actual-runtime
 ;; Rt.seq? treats an empty list as false and never treats a Vector as a seq.
 ;; LazySeq is outside the machine's admitted first-order data domain.
 (doseq [value [nil (list) (list 1) [] [1] {} #{1}]]
  (is (= (BeamLisp.Ns.Rt/seq? value)
         (BeamLisp.AOT/interpret_constructor!
          {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :seq?
           :args (list {:op :lit :val value})} {} {})))))

(defn- sequence-result [action]
 (try {:ok (action)} (catch error {:error (:__struct__ error)})))
(defn- machine-sequence-call [module function arguments]
 (BeamLisp.AOT/interpret_constructor!
  {:op :remote :mod module :fun function
   :args (mapv (fn [value] {:op :lit :val value}) arguments)} {} {}))

(deftest eager-sequence-family-preserves-runtime-shapes-and-empty-results
 (doseq [value [nil (list) (list 1) (list 1 2) [] [1 2]
                {:a 1 :b 2} #{1 2} "é🙂"]
         function [:first :rest :next :seq :count :empty?]]
  ;; Exact Erlang equality also catches Vector->list coercion that Clojure's
  ;; sequential equality would hide, including seq's borrowed Vector identity.
  (is (erlang/=:=
       (sequence-result #(erlang/apply :Elixir.BeamLisp.Ns.Rt function (list value)))
       (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt function (list value))))))
 (doseq [value [nil (list) (list 1) (list 1 2) [] [1 2]
                {:a 1 :b 2} #{1 2} "é🙂"]
         function [:second :last]]
  (is (erlang/=:=
       (sequence-result #(erlang/apply :Elixir.BeamLisp.Ns.Core function (list value)))
       (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Core function (list value)))))))

(deftest eager-take-and-both-drop-abis-preserve-negative-zero-and-positive-counts
 (doseq [value [nil (list) (list 1 2) [] [1 2] {:a 1 :b 2} #{1 2} "é🙂"]
         n [-2 0 1 4]]
  (is (erlang/=:=
       (sequence-result #(BeamLisp.Ns.Rt/take n value))
       (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt :take (list n value)))))
  (if (and (map? value) (not (set? value)) (= 1 n))
   ;; Native map drop exposes Erlang entry tuples; the final public first-order
   ;; boundary must refuse these, rather than expand its admitted datum domain.
   (do
    (is (= :native-tuple
           (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :drop_clj (list n value)) nil
                (catch error (:reason (ex-data error))))))
    (is (= :native-tuple
           (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :drop (list value n)) nil
                (catch error (:reason (ex-data error))))))
    (is (erlang/is_tuple (first (BeamLisp.Ns.Rt/drop_clj n value)))))
   (do
    (is (erlang/=:=
         (sequence-result #(BeamLisp.Ns.Rt/drop_clj n value))
         (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt :drop_clj (list n value)))))
    (is (erlang/=:=
         (sequence-result #(BeamLisp.Ns.Rt/drop value n))
         (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt :drop (list value n)))))))))

(deftest eager-sequence-operations-refuse-deferred-structs-before-thunks-can-run
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-never-force-"
                   (System/unique_integer (list :positive)))
       thunk (fn [] (File/write! marker "forced") (list 1 2))]
  (try
   (doseq [tag [:Elixir.BeamLisp.LazySeq :Elixir.BeamLisp.Delay]
           function [:first :rest :next :seq]]
    (is (= :foreign-struct
           (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt function
                   (list {:__struct__ tag :thunk thunk})) nil
                (catch error (:reason (ex-data error))))))
    (is (= false (File/exists? marker))))
   (finally (File/rm marker)))))

(deftest eager-text-materialization-is-bounded-before-grapheme-allocation
 (doseq [function [:first :next]]
  (is (= :collection-budget
         (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt function
                 (list (String/duplicate "x" 16385))) nil
              (catch error (:detail (ex-data error))))))))


(deftest list-star-preserves-the-real-variadic-rest-argument-abi
 (doseq [head [nil (list 1 2) [1 2] {:a 1} #{1 2} "é🙂" 17]
         tail [(list) (list nil) (list (list 2 3)) (list [2 3]) (list :middle [2 3])]]
  (is (erlang/=:=
       (sequence-result #(BeamLisp.Ns.Rt/list_star head tail))
       (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt :list_star (list head tail))))))
 (is (= nil (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :list_star_0 (list)))))

(deftest form-metadata-adapters-preserve-exact-values-and-authored-metadata
 (doseq [form [nil 'item (list 'call 1) [1 2] {:a 1} #{1 2} "text" 17]]
  (is (erlang/=:= (BeamLisp.FormMeta/meta form)
         (machine-sequence-call :Elixir.BeamLisp.FormMeta :meta (list form))))
  (doseq [metadata [nil {:private true :tag 'item}]]
   (let [node {:op :remote :mod :Elixir.BeamLisp.FormMeta :fun :with_meta
               :args (list {:op :lit :val form} {:op :lit :val metadata})}
         reference (BeamLisp.FormMeta/with_meta form metadata)]
    (if (and (erlang/is_tuple reference) (= :meta (elem reference 0)))
     (is (= :native-tuple
            (try (BeamLisp.AOT/interpret_constructor! node {} {}) nil
                 (catch error (:reason (ex-data error))))))
     (is (erlang/=:= reference (BeamLisp.AOT/interpret_constructor! node {} {}))))
    ;; A metadata wrapper is generated inside the machine, never admitted as an
    ;; arbitrary native tuple at the first-order literal/input boundary.
    (is (erlang/=:= (BeamLisp.FormMeta/meta reference)
          (BeamLisp.AOT/interpret_constructor!
           {:op :remote :mod :Elixir.BeamLisp.FormMeta :fun :meta :args (list node)} {} {})))))))

(deftest vary-meta-invokes-only-the-interpreted-callback
 (doseq [form [[1 2] (list 'call 1) 17]]
  (let [callback {:op :fn :clauses
                  (list {:pats (list {:pop :pvar :name "prior"}) :guard nil
                         :body {:op :map :pairs (list (list {:op :lit :val :prior}
                                                           {:op :var :name "prior"}))}})}]
   (is (erlang/=:= (BeamLisp.FormMeta/meta
                    (BeamLisp.FormMeta/vary_meta form (fn [prior] {:prior prior})))
          (BeamLisp.AOT/interpret_constructor!
           {:op :remote :mod :Elixir.BeamLisp.FormMeta :fun :meta
            :args (list {:op :remote :mod :Elixir.BeamLisp.FormMeta :fun :vary_meta
                         :args (list {:op :lit :val form} callback)})} {} {}))))))

(deftest metadata-and-spread-refuse-deferred-structs-without-effects
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-no-metadata-effect-"
                   (System/unique_integer (list :positive)))
       thunk (fn [] (File/write! marker "ran") (list))]
  (try
   (doseq [tag [:Elixir.BeamLisp.LazySeq :Elixir.BeamLisp.Delay]
           operation [:meta :with_meta :list_star]]
    (let [foreign {:__struct__ tag :thunk thunk}
          module (if (= :list_star operation) :Elixir.BeamLisp.Ns.Rt :Elixir.BeamLisp.FormMeta)
          args (case operation :meta (list foreign) :with_meta (list foreign {:a 1})
                               :list_star (list :head (list foreign)))]
     (is (= :foreign-struct
            (try (machine-sequence-call module operation args) nil
                 (catch error (:reason (ex-data error))))))
     (is (= false (File/exists? marker)))))
   (finally (File/rm marker)))))

(deftest list-star-bounds-spread-materialization-before-runtime-allocation
 (doseq [args [(list (String/duplicate "x" 16385) (list))
               (list :head (list (String/duplicate "x" 16385)))]]
  (is (= :collection-budget
         (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :list_star args) nil
              (catch error (:detail (ex-data error))))))))

(deftest metadata-and-list-star-native-adapters-have-exact-arities
 (doseq [[module function args] [[:Elixir.BeamLisp.FormMeta :meta (list)]
                                 [:Elixir.BeamLisp.Ns.Rt :list_star (list :head)]]]
  (is (= :constructor-machine-refused
         (try (machine-sequence-call module function args) nil
              (catch error (:kind (ex-data error))))))))


(deftest closed-numeric-predicates-match-the-selected-native-runtime
 (doseq [function [:even? :odd? :zero? :pos? :neg? :number? :float?]
         value [-3 -2 0 1 2 1.5 nil "x" :keyword [] {}]]
  (is (erlang/=:=
       (sequence-result #(erlang/apply :Elixir.BeamLisp.Ns.Rt function (list value)))
       (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt function (list value)))))))

(defn- hygienic-symbol? [value prefix]
 (and (erlang/is_tuple value) (= 2 (erlang/tuple_size value)) (= :symbol (elem value 0))
      (string? (elem value 1)) (String/starts_with? (elem value 1) (str prefix "__"))
      (String/ends_with? (elem value 1) "__auto")
      (let [name (elem value 1) offset (+ 2 (String/length prefix))
            digits (String/slice name offset (- (String/length name) offset 6))
            parsed (Integer/parse digits)]
       (and (erlang/is_tuple parsed) (> (elem parsed 0) 0) (= "" (elem parsed 1))))))

(deftest gensym-retains-runtime-prefix-semantics-and-global-hygiene
 (doseq [prefix ["" "macro" :macro nil]]
  (let [text (if (string? prefix) prefix (erlang/atom_to_binary prefix :utf8))
        reference (BeamLisp.Ns.Rt/gensym prefix)
        actual (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :gensym (list prefix))]
   (is (hygienic-symbol? reference text))
   (is (hygienic-symbol? actual text))
   (is (not (erlang/=:= reference actual)))))
 (let [first (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :gensym (list))
       second (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :gensym (list))]
  (is (and (hygienic-symbol? first "G") (hygienic-symbol? second "G")))
  ;; Separate interpretation frames must not reset a local name counter.
  (is (not (erlang/=:= first second))))
 (doseq [prefix [17 [] {} 'item]]
  (is (erlang/=:=
       (sequence-result #(BeamLisp.Ns.Rt/gensym prefix))
       (sequence-result #(machine-sequence-call :Elixir.BeamLisp.Ns.Rt :gensym (list prefix)))))))

(deftest fresh-symbol-creation-has-a-per-interpretation-admission-bound
 (let [call {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :gensym :args (list)}]
  (is (= :fresh-symbol-budget
         (try (BeamLisp.AOT/interpret_constructor!
               {:op :tuple :elems (vec (repeat 4097 call))} {} {}) nil
              (catch error (:detail (ex-data error))))))))

(deftest numeric-predicate-adapters-refuse-wrong-arities
 (doseq [function [:even? :odd? :zero? :pos? :neg? :number? :float?]
         arguments [(list) (list 1 2)]]
  (is (= {:unsupported-primitive-arity [(name function) (count arguments)]}
         (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt function arguments) nil
              (catch error (:detail (ex-data error)))))))
 (is (= {:unsupported-primitive-arity ["gensym" 2]}
        (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt :gensym (list "a" "b")) nil
             (catch error (:detail (ex-data error)))))))

(deftest numeric-predicates-never-dispatch-on-foreign-structs
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-no-number-effect-"
                   (System/unique_integer (list :positive)))
       thunk (fn [] (File/write! marker "ran") 1)]
  (try
   (doseq [tag [:Elixir.Decimal :constructor.EffectfulNumber]
           function [:even? :odd? :zero? :pos? :neg? :number? :float?]]
    (is (= :foreign-struct
           (try (machine-sequence-call :Elixir.BeamLisp.Ns.Rt function
                  (list {:__struct__ tag :thunk thunk})) nil
                (catch error (:reason (ex-data error))))))
    (is (= false (File/exists? marker))))
   (finally (File/rm marker)))))


(deftest native-list-reversal-preserves-supported-arity-and-type-semantics
 (doseq [value [(list) (list 1 2) [1 2] nil {:a 1} "text" #{1 2}]]
  (is (erlang/=:= (sequence-result #(lists/reverse value))
         (sequence-result #(machine-sequence-call :lists :reverse (list value))))))
 (doseq [value [(list) (list 1) (list 1 2)] tail [(list) (list 3) (list 3 4)]]
  (is (erlang/=:= (lists/reverse value tail)
         (machine-sequence-call :lists :reverse (list value tail)))))
 (is (= :collection-budget
        (try (machine-sequence-call :lists :reverse (list (String/duplicate "x" 16385))) nil
             (catch error (:detail (ex-data error)))))))

(deftest native-list-reversal-refuses-deferred-thunks-before-any-effects
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-no-reversal-effect-"
                   (System/unique_integer (list :positive)))
       thunk (fn [] (File/write! marker "ran") (list))]
  (try
   (doseq [tag [:Elixir.BeamLisp.LazySeq :Elixir.BeamLisp.Delay]]
    (is (= :foreign-struct
           (try (machine-sequence-call :lists :reverse (list {:__struct__ tag :thunk thunk})) nil
                (catch error (:reason (ex-data error))))))
    (is (= false (File/exists? marker))))
   (finally (File/rm marker)))))

(defn- counter-frames []
 (set (keep (fn [pair]
              (let [key (elem pair 0)]
               (when (and (erlang/is_tuple key) (= 2 (erlang/tuple_size key))
                          (= :constructor-machine-frame (elem key 0))) key)))
            (erlang/get))))
(deftest private-process-counter-frame-is-disposed-on-success-refusal-and-native-error
 (let [before (counter-frames)]
  (is (= 1 (BeamLisp.AOT/interpret_constructor! {:op :lit :val 1} {} {})))
  (is (= before (counter-frames)))
  (is (= :constructor-machine-refused
         (try (BeamLisp.AOT/interpret_constructor! {:op :remote :mod :Elixir.File :fun :read!
                            :args (list {:op :lit :val "not-read"})} {} {}) nil
              (catch e (:kind (ex-data e))))))
  (is (= before (counter-frames)))
  (is (= :Elixir.ArgumentError
         (try (BeamLisp.AOT/interpret_constructor! {:op :remote :mod :erlang :fun :element
                            :args (list {:op :lit :val 0} {:op :lit :val 'symbol})} {} {}) nil
              (catch e (:__struct__ e)))))
  (is (= before (counter-frames)))))
