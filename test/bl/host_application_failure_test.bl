; Focused native failure cleanup; never swaps production modules or starts a
; child VM. The existing runtime supervisor and Env must remain unchanged.
(ns host.application-failure-test)
(def ^:private probe :Elixir.BeamLisp.HostApplicationFailureProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Application)
(def ^:private supervisor :Elixir.BeamLisp.Supervisor)
(defn- tmp-dir []
 (str (System/get_env "HOME") "/tmp/bl_host_application_failure_"
      (erlang/unique_integer (list :positive))))
(defn- app-source [] (Path/join (BeamLisp/cwd) "priv/host/application.bl"))
(defn- drop! [module] (code/purge module) (code/delete module) :ok)

(deftest failed-boot-preserves-kind-and-original-frame-after-own-tree-cleanup
 (let [dir (tmp-dir) helper :Elixir.BeamLisp.HostApplicationFailure
       name :bl_host_application_failure_supervisor
       running (Process/whereis supervisor) original-env (Process/whereis :Elixir.BeamLisp.Env)
       helper-file (str dir "/failure.bl") app-file (str dir "/application.bl")]
  (File/mkdir_p! dir)
  (try
   (File/write! helper-file
    "(ns host.application-failure)
     (defn fail [kind]
      (cond (erlang/== kind :throw) (erlang/throw :original-boot-failure)
            (erlang/== kind :exit) (erlang/exit :original-boot-failure)
            :else (erlang/error :original-boot-failure)))")
   (BeamLisp.AOT/compile_host_file helper-file
     (list (tuple :module helper) (tuple :output_dir dir) (tuple :load? true)))
   ;; Only setup is replaced: one empty temporary supervisor and a real native
   ;; failing boot callee. The production catch/cleanup/re-raise remains exact.
   (let [source (-> (File/read! (app-source))
                   (String/replace "(list :\"Elixir.BeamLisp.Env\" :\"Elixir.BeamLisp.Loader.Server\")" "(list)")
                   (String/replace "(tuple :name :\"Elixir.BeamLisp.Supervisor\")"
                                   "(tuple :name :bl_host_application_failure_supervisor)")
                   (String/replace "(BeamLisp/init)"
                                   "(erlang/apply :Elixir.BeamLisp.HostApplicationFailure :fail (list _args))"))]
    (File/write! app-file source))
   (BeamLisp.AOT/compile_host_file app-file
     (list (tuple :module probe) (tuple :output_dir dir) (tuple :load? true)))
   (doseq [kind [:error :throw :exit]]
    (let [failure (try (erlang/apply probe :start (list :normal kind)) :unexpected-success
                   (catch error {:kind __EXCEPTION_KIND__ :error error :stack __STACKTRACE__}))]
     (is (= kind (:kind failure)))
     (is (= helper (elem (first (:stack failure)) 0)))
     (is (= nil (Process/whereis name)))
     (is (= running (Process/whereis supervisor)))
     (is (= original-env (Process/whereis :Elixir.BeamLisp.Env)))))
   (finally
    (when (Process/whereis name) (Supervisor/stop name))
    (drop! probe) (drop! helper) (drop! shim) (File/rm_rf! dir)))))
