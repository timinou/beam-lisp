(ns build-workspace-custody.test (:require [build :as b] [claim :as claim]))

(deftest direct-build-and-clean-refuse-another-writer-before-reading-or-pruning
  (let [root (str (System/tmp_dir!) "/bl-workspace-custody-" (System/unique_integer (list :positive)))
        out (Path/join root "out") marker (Path/join out "owner")
        manifest (Path/join out "compile.beam_lisp") parent (erlang/self)]
    (File/mkdir_p! out) (File/write! marker "unchanged")
    (let [worker (spawn (fn []
                          (let [claimed (claim/acquire! out "other writer")]
                            (erlang/send parent (tuple :claimed claimed))
                            (receive :stop :ok))))]
      (try
        (is (:ok? (receive [:claimed r] r (after 5000 {}))))
        (let [r (b/run {:out out :sources []})]
          (is (= 0 (:built r)))
          (is (= 1 (count (:errors r)))))
        (is (= :build-workspace-held
               (try (b/clean out manifest) nil (catch e (:kind (ex-data e))))))
        (is (= "unchanged" (File/read! marker)))
        (is (not (File/exists? manifest)))
        (finally (erlang/exit worker :kill) (File/rm_rf! root))))))
