(ns bl.js.anf-cache-test (:require [js.build :as build] [js.cache :as cache]))
(defn- with-cache [f]
 (let [prior (System/get_env "BL_JS_CACHE")]
  (System/put_env "BL_JS_CACHE" "on")
  (try (f)
   (finally (if prior (System/put_env "BL_JS_CACHE" prior) (System/delete_env "BL_JS_CACHE"))))))
(defn- compiled [path]
 (BeamLisp.Env/isolated (fn [] (build/compile-ns path))))
(deftest finite-checked-anf-reuses-without-retaining-environments
 (with-cache (fn []
 (let [root (str (System/tmp_dir!) "/js-anf-cache-" (System/unique_integer (list :positive)))
       path (str root "/math.bl")
       source "(ns cache.math) (defn plus [x] (+ x 1))"]
  (File/mkdir_p! root) (File/write! path source)
  (try
   (cache/reset-stats!)
   (let [a (compiled path) b (compiled path)]
    (is (= :miss (:cache-status a)))
    (is (= :hit (:cache-status b)))
    (is (= (dissoc a :cache-status) (dissoc b :cache-status)))
    (is (= {:hits 1 :misses 1 :declined 0} (cache/stats))))
   (File/write! path "(ns cache.math) (defn plus [x] (+ x 2))")
   (is (= :miss (:cache-status (compiled path))))
   (File/write! path "(ns cache.math) (defn plus [x] (inc x))")
   (is (= :declined (:cache-status (compiled path))))
   (finally (File/rm_rf! root)))))))

(deftest own-ambient-bindings-and-custom-checkers-decline-reuse
 (with-cache (fn []
 (let [root (str (System/tmp_dir!) "/js-anf-ambient-" (System/unique_integer (list :positive)))
       path (str root "/math.bl")]
  (File/mkdir_p! root) (File/write! path "(ns cache.ambient) (defn plus [x] (+ x 1))")
  (try
   (BeamLisp.Env/isolated
    (fn []
     (BeamLisp.Env/intern "cache.ambient" "plus" (fn [x] x))
     (is (= :declined (:cache-status (build/compile-ns path))))))
   (BeamLisp.Env/isolated
    (fn []
     (is (= :declined (:cache-status (build/compile-prepared (build/prepare-ns path) {:check-node identity}))))))
   (finally (File/rm_rf! root)))))))

(deftest cache-key-binds-the-bytes-read-rather-than-a-later-file-version
 (with-cache (fn []
 (let [root (str (System/tmp_dir!) "/js-anf-read-" (System/unique_integer (list :positive))) path (str root "/math.bl")]
  (File/mkdir_p! root) (File/write! path "(ns cache.snapshot) (defn plus [x] (+ x 1))")
  (try
   (let [old (BeamLisp.Env/isolated
               (fn [] (let [prepared (build/prepare-ns path)]
                 (File/write! path "(ns cache.snapshot) (defn plus [x] (+ x 2))")
                 (build/compile-prepared prepared))))
         fresh (compiled path)]
    (is (not= (:source-sha256 old) (:source-sha256 fresh)))
    (is (not= (:cache-key old) (:cache-key fresh)))
    (is (= :miss (:cache-status fresh))))
   (finally (File/rm_rf! root)))))))

(deftest cache-never-serializes-live-references
 (let [key (str "unportable-" (System/unique_integer (list :positive)))]
  (cache/store! key {:ns "test" :defs [] :state (atom 0)})
  (is (nil? (cache/fetch key)))))

(deftest native-namespace-linking-accepts-canonical-and-current-realm-modules
 (BeamLisp.Env/isolated
  (fn []
   (BeamLisp.Env/put_key (tuple :realm_local "cache.helper") "RCacheProof")
   (let [missing (atom []) used (atom #{})
         context (build/link-ctx {:ns "cache.client" :requires []}
                   {"cache.client" #{} "cache.helper" #{"plus"}} #{} missing #{} #{} used)
         canonical (BeamLisp.Emit/base_module_for "cache.helper")
         realm (BeamLisp.Link/module_for "cache.helper")]
    (is (not= canonical realm))
    (is (= ((:remote context) canonical :plus 1) ((:remote context) realm :plus 1)))
    (is (empty? @missing))
    (is (contains? @used "cache.helper"))))))
