; test/bl/wave23_loader_test.bl — loader namespace honesty, ported from
; test/beam_lisp/wave23_loader_test.exs.
;
; A require resolves to the file whose declared `(ns …)` OWNS the requested
; name — never to the first same-basename file on the load path. Each test
; plants real `.bl` files in tmp dirs and drives the live loader through
; `BeamLisp.Loader/with_load_path`, so the resolution is the shipped one, not a
; re-implementation.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All seven ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order:
;   a same-basename file with a different ns does not hijack the require
;   a genuine same-ns project file still shadows a lower-priority one
;   a priv/ library loads when nothing on the load path shadows it
;   a same-named file with a different ns is skipped even against a real priv lib
;   a missing ns with a same-named wrong-ns file names both namespaces
;   a file with no (ns …) form is reported, not loaded
;   dotted namespaces still resolve to nested directories
;
; Every `assert`/`refute` crosses as one or more `is`; an `assert_raise Type,
; ~r/msg/` keeps BOTH halves — a typed `catch RuntimeError e` (any other class
; fails) plus the message fragment.
;
; `at-global` is the one structural adaptation: the require loader is served
; from the pinned `Loader.Server`, and `with_load_path` in a ward fork is
; PROCESS-LOCAL (`Env.push_load_path` writes `Process.get :bl_load_paths`) — so
; a path pushed in the fork is invisible to the load. The ExUnit suite ran in a
; process with NO env binding, where the push lands in the `:global` Agent and
; every load sees it; the port runs each test at `:global` to match. Ambient
; namespace is restored afterwards (Ward has no per-test setup).
;
; Run: bin/bl test test/bl/wave23_loader_test.bl

(ns wave23.loader.test)

(defn- at-global
  "Run `f` in the `:global` env, putting the ambient namespace back afterwards,
   and starting from `user` — what the ExUnit `setup` gave each test."
  [f]
  (BeamLisp.Env/with_env :global
    (fn []
      (let [prev (BeamLisp.Env/current_ns)]
        (BeamLisp.Env/in_ns "user")
        (try
          (f)
          (finally (BeamLisp.Env/in_ns prev)))))))

(defn- eval [source] (BeamLisp/eval source))

(defn- tmpdir [label]
  (let [path (str (System/tmp_dir!) "/bl_w23_" label "_" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! path)
    path))

; Nest `with_load_path` so `dirs` are searched in the given order, the FIRST
; the highest priority — mirroring how run_file puts the running file's
; directory at the front.
(defn- with-load-dirs [dirs fun]
  ((reduce (fn [f dir] (fn [] (BeamLisp.Loader/with_load_path dir f)))
           fun dirs)))

(deftest a-same-basename-file-with-a-different-ns-does-not-hijack-the-require
  (let [dir (tmpdir "hijack")
        wrong (Path/join dir "wrong")
        real (Path/join dir "real")]
    (File/mkdir_p! wrong)
    (File/mkdir_p! real)
    ; The shadowing file (higher priority) shares the name but declares a
    ; different ns — exactly the example-vs-library collision. It must be
    ; skipped, not loaded.
    (File/write! (Path/join wrong "w23lib.bl")
                 "(ns w23lib.other)\n(def hijack :should-not-load)\n")
    (File/write! (Path/join real "w23lib.bl")
                 "(ns w23lib)\n(def from-dir :real)\n")
    (at-global
      (fn []
        (with-load-dirs (list wrong real)
          (fn []
            (eval "(ns w23.hijackapp (:require [w23lib :as lib]))")
            (is (= :real (eval "lib/from-dir")))))
        ; The hijacking ns was never loaded; the real one was.
        (is (not (BeamLisp.Env/loaded_ns? "w23lib.other")))
        (is (BeamLisp.Env/loaded_ns? "w23lib"))))
    (File/rm_rf! dir)))

(deftest a-genuine-same-ns-project-file-still-shadows-a-lower-priority-one
  (let [dir (tmpdir "override")
        project (Path/join dir "project")
        lower (Path/join dir "lower")]
    (File/mkdir_p! project)
    (File/mkdir_p! lower)
    ; Both files declare the requested ns; the higher-priority project file
    ; owns it and wins, exactly as a user's optics.bl would shadow
    ; priv/std/optics.bl.
    (File/write! (Path/join project "w23ovr.bl")
                 "(ns w23ovr)\n(def origin :project)\n")
    (File/write! (Path/join lower "w23ovr.bl")
                 "(ns w23ovr)\n(def origin :lower)\n")
    (at-global
      (fn []
        (with-load-dirs (list project lower)
          (fn []
            (eval "(ns w23.ovrapp (:require [w23ovr]))")
            (is (= :project (eval "w23ovr/origin")))))))
    (File/rm_rf! dir)))

(deftest a-priv-library-loads-when-nothing-on-the-load-path-shadows-it
  ; An empty high-priority dir leaves the real priv/std/rewrite.bl as the only
  ; provider.
  (let [dir (tmpdir "priv")]
    (at-global
      (fn []
        (with-load-dirs (list dir)
          (fn []
            (eval "(ns w23.privapp (:require [rewrite]))")
            (is (= (list (tuple :symbol "a") (tuple :symbol "b"))
                   (eval "(rewrite/apply-rules (list) '(a b))")))
            (is (BeamLisp.Env/loaded_ns? "rewrite"))))))
    (File/rm_rf! dir)))

(deftest a-same-named-file-with-a-different-ns-is-skipped-even-against-a-real-priv-lib
  (let [dir (tmpdir "privskip")]
    (File/mkdir_p! dir)
    (File/write! (Path/join dir "optics.bl")
                 "(ns optics.different)\n(def decoy :nope)\n")
    (at-global
      (fn []
        (with-load-dirs (list dir)
          (fn []
            (eval "(ns w23.privskipapp (:require [optics]))")
            ; The real priv/std/optics.bl won the require past the decoy.
            (is (= 42 (eval "(optics/view (optics/in :a) {:a 42})")))
            (is (not (BeamLisp.Env/loaded_ns? "optics.different")))))))
    (File/rm_rf! dir)))

(deftest a-missing-ns-with-a-same-named-wrong-ns-file-names-both-namespaces
  (let [dir (tmpdir "err")]
    (File/mkdir_p! dir)
    (File/write! (Path/join dir "w23err.bl")
                 "(ns w23err.other)\n(def whatever 1)\n")
    (at-global
      (fn []
        (with-load-dirs (list dir)
          (fn []
            (let [e (try (eval "(ns w23.errapp (:require [w23err]))")
                         (catch RuntimeError ex ex))]
              (is (some? e) "a require of a wrong-ns file raises RuntimeError")
              (is (includes? (ex-message e) "namespace w23err"))
              (is (includes? (ex-message e) "w23err.bl"))
              (is (includes? (ex-message e) "declares (ns w23err.other), not w23err")))))))
    (File/rm_rf! dir)))

(deftest a-file-with-no-ns-form-is-reported-not-loaded
  (let [dir (tmpdir "nons")]
    (File/mkdir_p! dir)
    (File/write! (Path/join dir "w23none.bl") "(def orphan 1)\n")
    (at-global
      (fn []
        (with-load-dirs (list dir)
          (fn []
            (let [e (try (eval "(ns w23.noneapp (:require [w23none]))")
                         (catch RuntimeError ex ex))]
              (is (some? e) "a require of a ns-less file raises RuntimeError")
              (is (includes? (ex-message e) "namespace w23none"))
              (is (includes? (ex-message e) "w23none.bl"))
              (is (includes? (ex-message e) "declares no (ns …) form"))
              (is (not (BeamLisp.Env/loaded_ns? "w23none"))))))))
    (File/rm_rf! dir)))

(deftest dotted-namespaces-still-resolve-to-nested-directories
  (let [dir (tmpdir "dotted")
        nested (Path/join dir "a/b")]
    (File/mkdir_p! nested)
    (File/write! (Path/join nested "thing.bl")
                 "(ns a.b.thing)\n(def nested :yes)\n")
    (at-global
      (fn []
        (with-load-dirs (list dir)
          (fn []
            (eval "(ns w23.dottedapp (:require [a.b.thing :as t]))")
            (is (= :yes (eval "t/nested")))
            (is (BeamLisp.Env/loaded_ns? "a.b.thing"))))))
    (File/rm_rf! dir)))
