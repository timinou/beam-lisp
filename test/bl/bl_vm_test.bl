; bl_vm_test.bl — `bl vm` and `bl realm`: the verbs over the inventory.
;
; The rendering is pure (rows in, lines out), so the shape of the tree is tested
; without a machine. The wiring — registered where a verb lives, flags the shared
; argv table knows, the daemon session publishing and retracting — is what a verb
; most often gets wrong, so it is tested directly.

(ns bl-vm-test
  (:require [bl.vm :as v] [bl.cli :as cli] [vm.session :as session] [vm.registry :as registry]
            [vm.paths :as paths]))

(defn- includes? [s sub] (String/contains? s sub))
(defn- text [lines] (join "\n" (to-list lines)))

(def ROW {:id "aaaa1111-10" :role :warm :build "aaaa1111" :pid 10 :state :up :legacy false :self false
          :uptime-s 4000 :memory-kb 217088
          :realms [{:name "blueprint" :root "/p/blueprint"
                    :routes [{:name "ui" :url "http://blueprint.test/" :loopback "http://127.0.0.1:1/" :port 1 :root "/p/blueprint"}]}]
          :routes [{:name "ui" :url "http://blueprint.test/" :loopback "http://127.0.0.1:1/" :port 1 :root "/p/blueprint"}]})

;; ── formatting ──────────────────────────────────────────────────────────────

(deftest ages-use-the-two-coarsest-units-that-matter
  (is (= "45s" (v/human-age 45)))
  (is (= "12m" (v/human-age 720)))
  (is (= "4h" (v/human-age 14400)))
  (is (= "2d15h" (v/human-age (+ (* 2 86400) (* 15 3600)))))
  (is (= "3d" (v/human-age (* 3 86400))))
  (is (= "-" (v/human-age nil))))

(deftest sizes-are-short
  (is (= "512K" (v/human-kb 512)))
  (is (= "212M" (v/human-kb (* 212 1024))))
  (is (= "7.0G" (v/human-kb (* 7 1024 1024))))
  (is (= "-" (v/human-kb nil))))

;; ── the tree ────────────────────────────────────────────────────────────────

(deftest the-tree-nests-realms-and-routes-under-their-vm
  (let [out (text (v/render [ROW] []))
        lines (split out "\n")]
    (is (includes? (first lines) "VM"))
    (is (includes? (nth lines 1) "aaaa1111-10"))
    (is (includes? (nth lines 1) "212M"))
    (is (includes? (nth lines 2) "blueprint") "the realm is indented under its VM")
    (is (String/starts_with? (nth lines 2) "  "))
    (is (includes? (nth lines 2) "http://blueprint.test/"))))

(deftest an-empty-machine-names-the-command-that-fixes-it
  (let [out (text (v/render [] []))]
    (is (includes? out "nothing is running"))
    (is (includes? out "bl daemon start"))))

(deftest legacy-and-gone-vms-say-so
  (is (includes? (text (v/render [(assoc ROW :legacy true)] [])) "up (old)"))
  (is (includes? (text (v/render [(assoc ROW :state :dead)] [])) "gone"))
  (is (includes? (text (v/render [(assoc ROW :self true)] [])) "(this command)")))

(deftest attention-prints-a-fix-under-each-fact
  (let [out (text (v/render [ROW] [{:kind :dead-records :level :warn :text "2 stale files" :fix "bl vm prune"}]))]
    (is (includes? out "! 2 stale files"))
    (is (includes? out "→ bl vm prune"))))

;; ── registered where a verb lives ───────────────────────────────────────────

(deftest both-verbs-are-registered-everywhere-a-verb-must-be
  (testing "dispatcher, help, and usage: two of three is a verb that runs and cannot be found"
    (doseq [c ["vm" "realm"]]
      (is (contains? cli/commands c) (str c " must be dispatchable"))
      (is (some? (get cli/command-help c)) (str c " must have help"))
      (is (pos? (count (filterv (fn [x] (= x c)) (mapcat second cli/usage-groups))))
          (str "`bl` alone must list " c)))))

(deftest the-flags-belong-to-the-shared-argv-table
  (testing "a verb that parses its own flags is rejected as unknown before it runs"
    (is (= true (:all (cli/parse-argv ["vm" "--all"]))))
    (is (= true (:force (cli/parse-argv ["vm" "stop" "x" "--force"]))))
    (is (= true (:dry_run (cli/parse-argv ["vm" "prune" "--dry-run"]))))
    (is (= true (:json (cli/parse-argv ["vm" "--json"]))))
    (is (nil? (:error (cli/parse-argv ["vm" "stop" "--all" "--force"]))))))

(deftest a-bad-subcommand-says-what-the-verb-takes
  (is (= 2 (v/run ["frobnicate"] {})))
  (is (= 2 (v/run ["stop"] {})) "stop with nothing to stop names its usage")
  (is (= 2 (v/run ["show"] {}))))

;; ── the session joins the registry ──────────────────────────────────────────

(defn- with-runtime [f]
  (let [prev (System/get_env "XDG_RUNTIME_DIR")
        rt (str "/tmp/bl-vmverb-test-" (erlang/apply :erlang :unique_integer (list (to-list [:positive]))))]
    (File/mkdir_p! rt)
    (System/put_env "XDG_RUNTIME_DIR" rt)
    (try (f rt)
         (finally
           (if (nil? prev) (System/delete_env "XDG_RUNTIME_DIR") (System/put_env "XDG_RUNTIME_DIR" prev))
           (File/rm_rf! rt)))))

(deftest a-daemon-session-publishes-itself-and-leaves-cleanly
  (testing "start → one live :warm record naming the project; stop → none"
    (with-runtime
      (fn [rt]
        (let [root (str rt "/proj")]
          (File/mkdir_p! (str root "/priv/boot"))
          (File/write! (str root "/priv/boot/core.bl") "")
          (let [listener (:ok (session/start root))]
            (erlang/apply :timer :sleep (list 300))
            (let [recs (registry/all)]
              (is (= 1 (count recs)) "exactly one record for this VM")
              (is (= :warm (:role (first recs))))
              (is (= "proj" (:label (first recs))) "labelled with the project it was started for"))
            (session/stop listener)
            (is (empty? (registry/all)) "a clean stop leaves nothing for prune to find")))))))

(run-tests)
