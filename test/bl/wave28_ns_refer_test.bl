; wave28_ns_refer_test.bl — namespace existence, `:refer :all` precedence, and
; syntax-quote ownership, ported from ExUnit
; test/beam_lisp/wave28_ns_refer_test.exs.
;
; The ExUnit file's own lesson: four bugs, all found by laying Specter's
; fixtures out one namespace per upstream file, referring each other as
; Clojure code actually does — a scaffolding the co-load compat harness had
; been hiding. The tests pin:
;
;   * a namespace EXISTS from its `(ns …)` form, not from its first `def`
;     (`ns_exists?`), so an empty one is requirable;
;   * `:refer :all` is a SNAPSHOT taken when the `(ns …)` runs — functions and
;     macros alike, private vars excluded, combinable with `:as`;
;   * a LOCALLY defined name shadows a referred one (protocols included), and
;     `extend-type` resolves a referred protocol to its ORIGINAL home;
;   * syntax-quote qualifies a symbol to the namespace that OWNS the var, not
;     the referrer — so a macro expands to a name resolvable at the call site.
;
; PARITY MAPPING. One `deftest` per ExUnit `test`, same order, one `is` per
; `assert` (the ExUnit `assert_raise` blocks become a `raised` call plus a typed
; struct check — never a LOST assertion):
;
;   describe "a namespace exists from its (ns …) form, not its first def"
;     an empty namespace can be required                       1 test
;     a namespace can be required before its vars are defined  1 test
;     a namespace that exists nowhere still raises …           1 test
;     a real file on disk still wins over an in-memory one     1 test
;   describe ":refer :all"
;     refers every public var, functions and macros alike      1 test
;     does not refer private vars                              1 test
;     explicit :refer still refuses a private var …            1 test
;     combines with :as                                        1 test
;     is a snapshot: vars defined after the refer do not appear 1 test
;   describe "protocols resolve through refers"
;     extend-type finds a protocol that was referred in        1 test
;     a locally defined name still shadows a referred one      1 test
;   describe "syntax-quote qualifies to the namespace that OWNS the var"
;     a referred var expands to its home namespace …           1 test
;     a locally defined var still qualifies to the writing ns  1 test
;                                                              13 deftests
;
; ADAPTATIONS.
;   * The ExUnit `setup` per test becomes a fresh env built at the top of each
;     `deftest`; `def`s land in the namespace's global var table, so behaviour
;     is identical to a shared setup env.
;   * Every body runs bound at the `:global` env (`deftest-global`) — the binding
;     an ExUnit test process implicitly had. `Loader.Server` resolves a
;     `:require` in its OWN process, so a namespace declared in ward's private
;     per-file fork would be invisible to it.
;   * `assert_raise RuntimeError, ~r/…/` is split into the raised value's class
;     (`(:__struct__ e)` = `:Elixir.RuntimeError` / `:Elixir.BeamLisp.CompileError`)
;     and an `includes?` check on the SAME literal substring the regex matched
;     (each `~r/…/` here escapes only `.` and `/`, so the literal is exact).
;
; Run: bin/bl test test/bl/wave28_ns_refer_test.bl

(ns wave28.ns-refer.test)

(defmacro deftest-global
  "A `deftest` whose body runs bound at the `:global` env — the binding an ExUnit
   test process implicitly had. Ward runs a file in a private env fork, but
   `Loader.Server` resolves a `:require` in its OWN process, so a namespace
   declared in the fork is invisible to it; `:global` is the one env both share."
  [name & body]
  `(deftest ~name (BeamLisp.Env/with_env :global (fn [] ~@body))))

(defn- new-env
  "The ExUnit `env/1`: `BeamLisp.Compiler.new_env(ns)`."
  [ns]
  (BeamLisp.Compiler/new_env ns))

(defn- ev
  "The ExUnit `ev/2`: `BeamLisp.Compiler.eval_string(src, env)`."
  [src e]
  (BeamLisp.Compiler/eval_string src e))

(defn- raised
  "The exception `thunk` raised, or nil when it returned normally — the value
   `assert_raise` inspected."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

; ══ describe "a namespace exists from its (ns …) form, not its first def" ══

(deftest-global an-empty-namespace-can-be-required
  ; Existence used to be inferred by probing ETS for a var, so a namespace
  ; holding nothing yet simply did not exist and the require fell through to a
  ; disk search that could not find it.
  (let [e (new-env "user")]
    (ev "(ns w28.hollow)" e)
    (is (BeamLisp.Env/ns_exists? "w28.hollow"))
    (is (= :ok (ev "(ns w28.hollow.user (:require [w28.hollow :as h])) :ok" e)))))

(deftest-global a-namespace-can-be-required-before-its-vars-are-defined
  ; The REPL-shaped sequence, and the shape of any two namespaces that
  ; reference each other: declare, require, then populate.
  (let [e (new-env "user")]
    (ev "(ns w28.later)" e)
    (is (= :ok (ev "(ns w28.later.user (:require [w28.later :as l])) :ok" e)))
    (ev "(ns w28.later) (defn f [] 42)" e)
    (is (= 42 (ev "(ns w28.later.user) (l/f)" e)))))

(deftest-global a-namespace-that-exists-nowhere-still-raises-and-names-the-search-path
  ; The fix must not turn a genuine typo into silence.
  (let [e (new-env "user")
        err (raised (fn [] (ev "(ns w28.typo (:require [w28.no.such.ns :as n]))" e)))]
    (is (= :Elixir.RuntimeError (:__struct__ err)))
    (is (includes? (ex-message err) "namespace not found: w28.no.such.ns"))
    (is (includes? (ex-message err) "searched:"))))

(deftest-global a-real-file-on-disk-still-wins-over-an-in-memory-namespace-of-the-same-name
  ; Declaring a namespace must not shadow a requirable file — the loader
  ; consults the disk first and treats in-memory existence only as permission
  ; to skip the raise.
  (let [e (new-env "user")]
    (is (= :ok (ev "(ns w28.diskcheck (:require [optics :as o])) :ok" e)))
    ; Declaration is deferred; first use must initialize the real file rather
    ; than treating a same-named placeholder as already loaded.
    (ev "optics/compose-optic" e)
    (is (BeamLisp.Env/local_var? "optics" "compose-optic"))))

; ══ describe ":refer :all" ══════════════════════════════════════════════════

(defn- src-env
  "The ExUnit `setup` for this describe: a fresh `user` env with `w28.src`
   populated (a public fn, a public macro, a private fn)."
  []
  (let [e (new-env "user")]
    (ev "(ns w28.src)
         (defn pub [x] (* x 3))
         (defmacro twice [e] `(+ ~e ~e))
         (defn- hidden [] :nope)"
        e)
    e))

(deftest-global refer-all-refers-every-public-var-functions-and-macros-alike
  (let [e (src-env)]
    (ev "(ns w28.all (:require [w28.src :refer :all]))" e)
    (is (= 15 (ev "(ns w28.all) (pub 5)" e)))
    ; A macro has to survive the blanket refer too: it is expanded by a
    ; different path than an ordinary var, and referring only values would
    ; leave `(twice 4)` looking like an undefined call.
    (is (= 8 (ev "(ns w28.all) (twice 4)" e)))))

(deftest-global refer-all-does-not-refer-private-vars
  ; The blanket form must not be a way around privacy that the explicit form
  ; refuses.
  (let [e (src-env)]
    (ev "(ns w28.allpriv (:require [w28.src :refer :all]))" e)
    (let [err (raised (fn [] (ev "(ns w28.allpriv) (hidden)" e)))]
      (is (= :Elixir.RuntimeError (:__struct__ err)))
      (is (includes? (ex-message err) "undefined var: w28.allpriv/hidden")))))

(deftest-global explicit-refer-still-refuses-a-private-var-at-compile-time
  (let [e (src-env)
        err (raised (fn [] (ev "(ns w28.explicit (:require [w28.src :refer [hidden]]))" e)))]
    (is (= :Elixir.BeamLisp.CompileError (:__struct__ err)))
    (is (includes? (ex-message err) "var w28.src/hidden is not public"))))

(deftest-global refer-all-combines-with-as
  (let [e (src-env)]
    (is (= [3 3]
           (ev "(ns w28.both (:require [w28.src :as s :refer :all])) [(s/pub 1) (pub 1)]" e)))))

(deftest-global refer-all-is-a-snapshot-vars-defined-after-the-refer-do-not-appear
  ; Clojure's :refer :all is resolved when the ns form runs, not continuously.
  ; Pinning the behaviour so it cannot silently become a live view later.
  (let [e (src-env)]
    (ev "(ns w28.snap (:require [w28.src :refer :all]))" e)
    (ev "(ns w28.src) (defn added-later [] :late)" e)
    (let [err (raised (fn [] (ev "(ns w28.snap) (added-later)" e)))]
      (is (includes? (ex-message err) "undefined var")))))

; ══ describe "protocols resolve through refers" ════════════════════════════

(deftest-global extend-type-finds-a-protocol-that-was-referred-in
  ; This failed by INVENTING a second, empty protocol under the extending
  ; namespace's name. The extension registered against it happily, and the
  ; failure surfaced much later as "no implementation of method area" — far
  ; from the cause.
  (let [e (new-env "user")]
    (ev "(ns w28.proto) (defprotocol Shape (area [s]))" e)
    (ev "(ns w28.impl (:require [w28.proto :refer :all]))
         (defrecord Circle [r])
         (extend-type Circle Shape (area [s] (* 3 (:r s) (:r s))))"
        e)
    (is (= 12 (ev "(ns w28.impl) (area (->Circle 2))" e)))
    ; and the extension landed on the ORIGINAL protocol, so a caller in the
    ; defining namespace dispatches to it too
    (is (= 12 (ev "(ns w28.proto) (area (w28.impl/->Circle 2))" e)))))

(deftest-global a-locally-defined-name-still-shadows-a-referred-one
  ; The refer is consulted only when the name is not local, so defining your
  ; own protocol of the same name keeps working.
  (let [e (new-env "user")]
    (ev "(ns w28.p2) (defprotocol Sized (sized [s]))" e)
    (ev "(ns w28.p2user (:require [w28.p2 :refer :all]))
         (defprotocol Sized (sized [s]))
         (defrecord Box [n])
         (extend-type Box Sized (sized [s] (:n s)))"
        e)
    (is (= 7 (ev "(ns w28.p2user) (sized (->Box 7))" e)))))

; ══ describe "syntax-quote qualifies to the namespace that OWNS the var" ═══

(deftest-global a-referred-var-expands-to-its-home-namespace-not-the-referrer
  ; `(:require [p :refer :all])` then `` `Thing `` in a macro used to expand to
  ; `referrer/Thing`, a name that resolves nowhere. The var lives in p, and
  ; that is where the expansion site must look.
  (let [e (new-env "user")]
    (ev "(ns w28.home) (def marker :from-home)" e)
    (ev "(ns w28.writer (:require [w28.home :refer :all]))
         (defmacro get-marker [] `marker)"
        e)
    ; expanded and called from a THIRD namespace that never required w28.home
    ; — only correct qualification can make this resolve. A beam-lisp keyword
    ; keeps its hyphen as-is, so the value is :from-home.
    (is (= :from-home
           (ev "(ns w28.caller (:require [w28.writer :refer :all])) (get-marker)" e)))))

(deftest-global a-locally-defined-var-still-qualifies-to-the-writing-namespace
  (let [e (new-env "user")]
    (ev "(ns w28.local)
         (def own :mine)
         (defmacro get-own [] `own)"
        e)
    (is (= :mine
           (ev "(ns w28.lcaller (:require [w28.local :refer :all])) (get-own)" e)))))
