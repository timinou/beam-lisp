; test/bl/seed_drift_2_test.bl — test.seed-drift-2.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-drift-2
  (:require [seed] [test.bl.seed-support :as s]))

(deftest source-drift-marks-the-floor-stale-2
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "drift-2-out")
        hd (s/host-scratch "drift-2-src" "")
        hosts (seed/host-sources hd)
        chunk (take 23 (drop 24 hosts))
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (when-not (:ok? r)
      (throw (str "the floor is generated: " (pr-str (:errors r)))))
    ; SOURCE DRIFT: one leaf's source moves while its beam stays in the floor.
    ; Checked per leaf, because the whole point of the table is that each pinned
    ; source is judged on its OWN digest, not on the set's. This file carries
    ; hosts 24..46 of 71; the loop is split across three files because 71
    ; `seed/check` calls do not fit the runner's 300 s per-file bound.
    (doseq [e chunk]
      (File/write! (:source e) (s/host-fixture "(defn extra [x] x)\n"))
      (let [c (s/seed-check! {:root root :out out :host hd})]
        (is (not (:ok? c)) (str (:module e) " moved — the floor is STALE"))
        (is (s/has? (map (fn [r] (:ns r)) (:moved c)) (str (:module e))))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
