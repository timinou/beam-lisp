(ns mcp.challenge-test (:require [mcp.transport-http :as http]))
(deftest challenge-is-compatible-and-header-safe
  (is (= "Bearer realm=\"mcp\", resource_metadata=\"https://example.test/meta\""
         (http/www-authenticate "https://example.test/meta")))
  (is (String/ends_with? (http/www-authenticate "https://example.test/meta" {:error :invalid_token})
                        ", error=\"invalid_token\""))
  (is (thrown? (http/www-authenticate "url\r\nInjected: yes")))
  (is (thrown? (http/www-authenticate "url" {:error :private}))))
