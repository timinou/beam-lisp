(ns sdk-native-bootstrap-test (:require [vm.native :as native]))

(defn- bootstrap-receipt []
 (let [rows (ets/lookup :beam_lisp_vars :bl_sdk_native_bootstrap)]
  (when (seq rows) (elem (first rows) 1))))
(defn- original [action]
 (try (action) :unexpected-success (catch error (BeamLisp.ExInfo/ex_original error))))

(deftest sdk-native-hosts-are-published-before-the-kernel-lease-and-retained-with-exact-producer-evidence
 (let [bootstrap (bootstrap-receipt)
       rows (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_native_host :_) :_))]
  (is (some? bootstrap))
  (is (= :before-sdk-kernel-lease (:boundary bootstrap)))
  (is (= 0 (:provider-initializers bootstrap)))
  (is (< 0 (:count bootstrap)))
  (is (<= (:count bootstrap) 512))
  (is (<= 0 (:elapsed-us bootstrap)))
  (is (= (:count bootstrap) (count rows)))
  (doseq [entry rows]
   (let [mod (elem (elem entry 0) 1) row (elem entry 1)
         owner (:native-owner row) ns (elem owner 0)
         descriptor (native/host-descriptor ns (elem owner 1) (elem owner 2) (:selected-library row))
         beam (BeamLisp.Emit/compile_descriptor descriptor)]
    (is (= :native-host (:role row)))
    (is (= :fixed-vm (:runtime-boundary row)))
    (is (= nil (:historical-library-digest row)))
    (is (= mod (elem beam 0)))
    (is (= (:md5 row) (elem (elem (beam_lib/md5 (elem beam 1)) 1) 1)))
    (is (= (:md5 row) (erlang/apply mod :module_info (list :md5))))
    (is (= true (BeamLisp.Env/sdk_runtime_retained_modules? (list mod))))))))

(deftest an-ambient-project-native-path-refuses-before-publication
 (let [entry (first (ets/match_object :beam_lisp_vars (tuple (tuple :bl_sdk_native_host :_) :_)))
       mod (elem (elem entry 0) 1) row (elem entry 1) owner (:native-owner row)
       ns (elem owner 0) crate (elem owner 1) signatures (elem owner 2)
       wrong (str (System/get_env "HOME") "/tmp/not-the-sdk/" crate)
       descriptor (native/host-descriptor ns crate signatures wrong)
       beam (BeamLisp.Emit/compile_descriptor descriptor)]
  (is (= (tuple :sdk_native_library_outside_selected_sdk wrong)
        (original #(BeamLisp.AOT/prepare_native_host_emission! ns crate signatures wrong beam))))
  (is (= (:md5 row) (erlang/apply mod :module_info (list :md5))))))
