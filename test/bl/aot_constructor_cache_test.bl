(ns aot-constructor-cache-test)

(defn- in-scope [action]
 ;; Privileged native component harness only. Refuse existing application
 ;; authority rather than clearing it around a supplied callback.
 (let [previous (BeamLisp.Env/capture)
       prior-context (Process/get :bl_sdk_constructor_context)
       _ (when (or (:generation previous) (:application-identity previous))
           (erlang/error :component-harness-requires-kernel-context))
       path (BeamLisp.Loader/source_path "core")
       source (BeamLisp.Loader/read_source path)
       input (BeamLisp.AOT/constructor_source_input! "core" path source)
       scope (BeamLisp.Env/fork :global)]
  (try
   (BeamLisp.Loader/without_initialization
    (fn []
     (BeamLisp.Env/with_env scope
      (fn []
       (Process/put :bl_sdk_constructor_context
        {:input input :compiler-env scope :units {} :compiled {} :compiling #{}
         :clauses {} :seen-macros #{} :kernel-modules #{} :kernel-leases (list)
         :macro-steps 16384 :new-atoms 128 :expanded 0})
       (BeamLisp.AOT/constructor_install_kernel!)
       (action)))))
   (finally
    (let [context (Process/get :bl_sdk_constructor_context)]
     (Enum/each (:kernel-leases context) (fn [handle] (BeamLisp.Env/release_code! handle))))
    (BeamLisp.Env/destroy scope)
    (if prior-context (Process/put :bl_sdk_constructor_context prior-context)
                      (Process/delete :bl_sdk_constructor_context))
    (BeamLisp.Env/bind previous)))))

(defn- native-call-count [function arity action]
 (let [mfa (tuple :Elixir.BeamLisp.AOT function arity)]
  (erlang/trace_pattern mfa true (list :local :call_count))
  (try
   (let [timing (timer/tc (BeamLisp.Env/as_thunk action))
         counter (erlang/trace_info mfa :call_count)]
    {:microseconds (elem timing 0) :calls (elem counter 1) :result (elem timing 1)})
   (finally (erlang/trace_pattern mfa false (list :local :call_count))))))

(deftest authenticated-sdk-syntax-uses-the-larger-finite-data-domain
 (in-scope
  (fn []
   ;; This actual native SDK compiler scope, with its attested kernel, selects
   ;; syntax limits. Public metadata cannot select them (separate regression).
   (let [syntax (vec (range 20000))
         result (BeamLisp.AOT/interpret_constructor! {:op :lit :val syntax} {} {})]
    (is (= 20000 (count result)))
    (is (= 19999 (last result)))))))

(defn benchmark []
 (in-scope
  (fn []
   (let [key (tuple :constructor-machine-frame (erlang/make_ref))
         state {:counter-frame key :max-collection 16384}
         compiled {:entries (Map/get (BeamLisp.Ns.Core/__bl_ns_defs__) "identity")}]
    (erlang/put key {:remaining 1000000 :allocation-nodes 1000000 :allocation-bytes 16777216
                     :recipes {} :callables {} :recipe-serial 0 :recipe-depth 0 :depth 0})
    (try
     (let [cpp (native-call-count :seed_dependency! 1
                 (fn [] (Enum/each (lists/seq 1 16)
                          (fn [_] (BeamLisp.AOT/constructor_kernel_alias! "cpp" "jank.runtime.is_integer" state))) nil))
           metadata (native-call-count :constructor_metadata 2
                 (fn [] (Enum/each (lists/seq 1 100)
                          (fn [_] (BeamLisp.AOT/constructor_function_expression "core" "identity" compiled))) nil))]
      (IO/inspect {:cpp (dissoc cpp :result) :metadata (dissoc metadata :result)}
                  (list (tuple :label "CONSTRUCTOR_CACHE_BENCHMARK")))
      {:cpp-calls (:calls cpp) :metadata-calls (:calls metadata)})
     (finally (erlang/erase key)))))))

(deftest cached-and-uncached-source-routing-remain-owned-and-shadow-aware
 (in-scope
  (fn []
   (let [first-owner (BeamLisp.AOT/constructor_source_owner "core" "identity")
         again (BeamLisp.AOT/constructor_source_owner "core" "identity")]
    (is (= ["core" "identity"] (vec (take 2 first-owner))))
    (is (= first-owner again))
    (is (= nil (BeamLisp.AOT/constructor_source_owner "cpp" "jank.runtime.is_integer")))
    (is (= nil (BeamLisp.AOT/constructor_source_owner "cpp" "totally-unknown")))
    (is (= false (BeamLisp.AOT/constructor_core_owner? "core" "foreign/map" :exact)))
    (is (= false (BeamLisp.AOT/constructor_core_owner? "cpp" "map" :exact)))
    (let [before (BeamLisp.AOT/constructor_source_owner "core" "constructor-cache-shadow")
          definition (first (BeamLisp.Reader/read_string "(defn- constructor-cache-shadow [] :owned)"))]
     (is (= nil before))
     (BeamLisp.AOT/constructor_record_definition! definition "core")
     (is (= ["core" "constructor-cache-shadow"]
            (vec (take 2 (BeamLisp.AOT/constructor_source_owner "core" "constructor-cache-shadow"))))))))))

(defn- final-kind [change]
 ;; Faults modify only this private compiler receipt. Never edit SDK sources,
 ;; seed manifests, or live modules to simulate freshness failures.
 (let [context (Process/get :bl_sdk_constructor_context)]
  (try
   (Process/put :bl_sdk_constructor_context (change context))
   (BeamLisp.AOT/constructor_check_sources!)
   nil
   (catch error (:kind (ex-data error)))
   (finally (Process/put :bl_sdk_constructor_context context)))))

(deftest final-attestation-rechecks-cached-absence-and-present-path-selection
 (in-scope
  (fn []
   (let [core-path (:file (:input (Process/get :bl_sdk_constructor_context)))]
    ;; An absence receipt is not permission to ignore a newly selected path;
    ;; a presence receipt may not silently become absent either.
    (BeamLisp.AOT/constructor_source_owner "cpp" "totally-unknown")
    (BeamLisp.AOT/constructor_source_owner "core" "identity")
    (is (= :sdk-constructor-source-selection-changed
      (final-kind #(Map/put % :source-paths
                    (Map/put (:source-paths %) "cpp" core-path)))))
    (is (= :sdk-constructor-source-selection-changed
      (final-kind #(Map/put % :source-paths
                    (Map/put (:source-paths %) "core" nil)))))))))

(deftest final-attestation-rechecks-actual-source-bytes-and-current-tooling-key
 (in-scope
  (fn []
   (is (= :unattested-sdk-constructor-source
     (final-kind
      (fn [context]
       (Map/put context :units
        {"core" (Map/put (:input context) :source "(ns core)\n; stale receipt\n")})))))
   (is (= :sdk-constructor-compiler-changed
     (final-kind #(Map/put % :input
                    (Map/put (:input %) :compiler-key "stale-component-receipt"))))))))

(deftest final-kernel-proof-cannot-succeed-when-authoritative-entry-is-absent
 (in-scope
  (fn []
   ;; Initial acquisition refuses missing manifest evidence. Final revalidation
   ;; must enforce the same rule rather than treat nil as a successful proof.
   ;; Missing evidence is a precise refusal, never a successful nil proof.
   (is (= :unattested-compiler-kernel
     (final-kind #(Map/put % :kernel-modules
                    (conj (:kernel-modules %) :Elixir.ConstructorCache.MissingProof))))))))
