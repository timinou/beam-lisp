; profile_test.bl — bl.profile names time in Beam Lisp terms.
; Run: bl test test/bl/profile_test.bl
(ns bl.profile.test (:require [bl.profile :as profile]))

(deftest module-names-fold-to-namespaces
  (is (= {:ns "reception.ui.screens" :runtime? false}
         (profile/demangle-module :Elixir.BeamLisp.Ns.Body.Reception.Ui.Screens)))
  (is (= {:ns "reception.ui.screens" :runtime? false}
         (profile/demangle-module :Elixir.BeamLisp.Ns.Reception.Ui.Screens)))
  (is (= {:ns "proc.owner-registry" :runtime? false}
         (profile/demangle-module (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Init.Proc.Owner-registry"))))
  (is (= {:ns "LazyMemo" :runtime? true} (profile/demangle-module :Elixir.BeamLisp.LazyMemo)))
  (is (= {:ns "maps" :runtime? true} (profile/demangle-module :maps))))

(deftest closures-are-charged-to-their-enclosing-fn
  (is (= "work-row" (profile/demangle-fn (erlang/binary_to_atom "-work-row/3-anonymous-2-"))))
  (is (= "render" (profile/demangle-fn :render)))
  (is (= "k-reduce" (profile/demangle-fn (erlang/binary_to_atom "-k-reduce/5-fun-0-")))))

(deftest aggregate-sums-companions-and-closures
  (let [rows [[(tuple :Elixir.BeamLisp.Ns.Body.A.B :f 1) 10 100]
              [(tuple :Elixir.BeamLisp.Ns.A.B :f 1) 1 5]
              [(tuple :Elixir.BeamLisp.Ns.Body.A.B (erlang/binary_to_atom "-f/1-anonymous-0-") 1) 3 50]
              [(tuple :Elixir.BeamLisp.LazyMemo :deps_walk 6) 7 300]]
        out (profile/aggregate rows)]
    (is (= [{:ns "LazyMemo" :fn "deps_walk" :calls 7 :us 300 :runtime? true}
            {:ns "a.b" :fn "f" :calls 14 :us 155 :runtime? false}]
           out))))

(deftest call-time-profiles-or-degrades
  (let [r (profile/call-time (fn [] (reduce + (map inc (range 2000)))))]
    (is (= 2001000 (:value r)) "the value is returned unchanged")
    (is (integer? (:total-us r)))
    (when (:profiled? r)
      (is (seq (:rows r)) "profiled: rows are reported")
      (is (every? (fn [row] (and (string? (:ns row)) (string? (:fn row)))) (:rows r))))))
