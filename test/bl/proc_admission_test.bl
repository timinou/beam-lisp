(ns proc.admission-test (:require [proc.admission :as admission]))
(deftest expired-and-dead-work-never-start
 (let [ran (atom 0) action (fn [] (swap! ran inc))
       owner (erlang/spawn (fn [] (receive :stop :ok)))
       dead (admission/token owner 60000)]
  (erlang/exit owner :kill)
  (Process/sleep 5)
  (is (= :cancelled (admission/run dead action)))
  (is (= :cancelled (admission/run (admission/token (erlang/self) 0) action)))
  (is (= 0 @ran))))
(deftest accepted-action-drains-and-restores-context
 (let [request (admission/token (erlang/self) 60000)]
  (admission/with-request request
   (fn []
    (is (= :done (admission/run request (fn []
                      (is (nil? (Process/get :bl_admission))) :done))))
    (is (= request (Process/get :bl_admission)))))
  (is (nil? (Process/get :bl_admission)))))
(deftest loader-declines-expired-budget-before-effects
 (let [ran (atom 0)]
  (is (= :cancelled (admission/with-request (admission/token (erlang/self) 0)
                      (fn [] (BeamLisp.Loader.Server/run (fn [] (swap! ran inc)))))))
  (is (= 0 @ran))
  (is (= :done (admission/with-request (admission/token (erlang/self) 60000)
                 (fn [] (BeamLisp.Loader.Server/run
                           (fn [] (is (nil? (Process/get :bl_admission))) :done))))))))
(deftest failure-and-conveyance-restore-worker-request
 (let [request (admission/token (erlang/self) 60000)
       worker (Agent/start_link (fn [] nil)) pid (elem worker 1)]
  (try
   (admission/with-request request
    (fn []
     (is (= request (Agent/get pid (BeamLisp.Env/convey (fn [_] (Process/get :bl_admission))))))))
   (is (nil? (Agent/get pid (fn [_] (Process/get :bl_admission)))))
   (is (try (admission/with-request request (fn [] (throw :failed))) false (catch _ true)))
   (is (nil? (Process/get :bl_admission)))
   (finally (Agent/stop pid)))))

(deftest local-and-inherited-admission-are-both-required
 (let [local (admission/token (erlang/self) 60000)
       expired (admission/token (erlang/self) 0) ran (atom 0)]
  (is (= :cancelled (admission/run local expired (fn [] (swap! ran inc)))))
  (is (= :cancelled (admission/run expired local (fn [] (swap! ran inc)))))
  (is (= 0 @ran))
  (is (= :done (admission/run local local (fn []
                 (is (nil? (Process/get :bl_admission))) :done))))))
