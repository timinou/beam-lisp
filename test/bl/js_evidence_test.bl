(ns js.evidence-test (:require [js.evidence :as evidence] [js.actor :as actor]
 [system.suspension :as suspension] [system.footprint :as footprint]))
(defn definition [name source]
 {:name name :kind :fn :node (BeamLisp.Ns.Compiler/compile
   (BeamLisp.Ns.Reader/read_one source) (BeamLisp.Ns.Compiler/new_env "proof"))})
(deftest compiler-evidence-is-conservative-and-annotation-independent
 (let [defs [(definition "leaf" "(fn [x] (erlang/+ x 1))")
             (definition "caller" "(fn [x] (leaf x))")
             (definition "waiter" "(fn [] (receive x x))")
             (definition "indirect" "(fn [f] (f 1))")
             (definition "foreign" "(fn [] (unknown 1))")]
       report (evidence/analyze "proof" defs)]
  (is (:converged report))
  (is (= {"leaf" true "caller" true "waiter" false "indirect" false "foreign" false} (:proofs report)))
  (is (= (:proofs report) (:proofs (evidence/analyze "proof"
    (mapv (fn [d] (update d :node assoc :ann {:synchronous true :pure true})) defs)))))
  (is (= "unknown" (get-in (evidence/provenance {:path "proof.bl" :source-sha256 "digest" :defs defs} report)
                   [:definitions "leaf" :deadline])))))
(deftest observation-read-and-reader-control-have-distinct-effects
 (is (= :R (get footprint/op-mode [:Elixir.BeamLisp.Ns.Vm.Observation :query])))
 (is (= :W (get footprint/op-mode [:Elixir.BeamLisp.Ns.Vm.Observation :snapshot])))
 (is (not (footprint/conflict? :R :R)))
 (is (footprint/conflict? :R :W)))
