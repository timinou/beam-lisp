; compile_diagnostic_test.bl — the LIVE diagnostic contract, exercised directly
; in beam-lisp. Supersedes the removed Elixir surface
; (`lib/beam_lisp/compile_diagnostic.ex` + its ExUnit suite), whose only callers
; were its own test: it rendered Elixir compiler-exception shapes
; (`ArgumentError` "not a tuple", `FunctionClauseError`, Elixir stack frames)
; that no live code path produced. The behaviours that mattered there are
; properties of the live compiler and the diagnostic vocabulary, so they are
; pinned here against the real path — not an Elixir renderer.
;
;   bl test test/bl/compile_diagnostic_test.bl
;
; Two contracts, both live:
;
;   1. `(try body (finally cleanup))` with NO catch compiles and runs — the
;      empty-catches regression. The self-hosted compiler once built the catch
;      clause eagerly from `(first catches)`, so an empty catch list passed nil
;      into `node-items` and crashed with a bare `not a tuple`. This is valid,
;      common code (every with-target-style resource guard uses it).
;
;   2. A compile rejection NAMES the source — the line, the construct, and the
;      offending form (BeamLisp.CompileError via compiler.bl `compile-error`),
;      and a reader diagnostic renders through the ONE renderer (errors.bl).
;      A bare `badarg` that points at nothing is the failure mode this guards.

(ns compile-diagnostic.test
  (:require [diag] [errors]))

; ── try/finally without a catch (the empty-catches regression) ───────────────

(deftest a-finally-with-no-catch-runs-the-body-and-the-cleanup
  ; The finally must fire and the body's value must be returned. The cleanup
  ; adds 10 so its having run is distinguishable from the body's own effect.
  (let [a (atom 0)
        v (try :body (finally (swap! a (fn [n] (+ n 10)))))]
    (is (= :body v) "the body's value is returned")
    (is (= 10 (deref a)) "the cleanup ran")))

(deftest a-finally-still-runs-when-the-body-throws
  ; The body throws; the finally must still fire, then the throw propagates.
  ; The outer try catches it so the test can assert BOTH halves: the cleanup
  ; ran, and the throw was not swallowed by the finally.
  (let [a (atom 0)
        caught (try
                 (try (throw :boom)
                      (finally (swap! a (fn [n] (+ n 10)))))
                 (catch e :propagated))]
    (is (= :propagated caught) "the throw propagated past the finally")
    (is (= 10 (deref a)) "the cleanup ran before the throw propagated")))

(deftest a-catch-and-a-finally-work-together
  ; Both present: the catch handles the throw, the finally still runs.
  (let [a (atom 0)
        v (try (throw :handled)
               (catch e :caught)
               (finally (swap! a inc)))]
    (is (= :caught v) "the catch handles the throw")
    (is (= 1 (deref a)) "the cleanup still runs")))

(deftest a-bare-catch-without-a-finally-works
  (is (= :recovered (try (throw :x) (catch e :recovered)))))

; ── a compile rejection names the source ────────────────────────────────────

(deftest a-compile-rejection-is-a-located-diagnostic
  ; A rejection the compiler can READ needs no runtime: `(7 1)` is wrong before
  ; the program runs. It arrives as a BeamLisp.CompileError whose message names
  ; the line and the construct, and whose second line carries the offending
  ; form — file/line plus the form is exactly what the removed renderer tried
  ; to reconstruct for an opaque crash.
  (let [e (try
            (do (BeamLisp/eval "(ns compile-diagnostic-test.bad)\n(7 1)") nil)
            (catch BeamLisp.CompileError ex ex))]
    (is (some? e) "a compile rejection raises BeamLisp.CompileError")
    (let [lines (String/split (ex-message e) "\n")]
      (is (starts-with? (first lines) "line 2:")
          (str "the message names the source line: " (ex-message e)))
      (is (includes? (first lines) "cannot call 7")
          (str "the message names the construct: " (ex-message e)))
      (is (starts-with? (second lines) "  offending form: ")
          (str "the offending form rides on the second line: " (ex-message e))))))

; ── the ONE renderer draws a location and a caret ───────────────────────────

(deftest a-rendered-diagnostic-draws-the-location-and-a-caret
  ; errors.bl is the ONE renderer for the diagnostic vocabulary (diag.bl): it
  ; prints the location once and draws the offending source line with a caret
  ; under the form — the live shape of the removed renderer's snippet assertion.
  (let [src (str "(greet 42)" "\n")
        d (diag/error :type-mismatch "argument 1 provably wrong"
                      {:line 1 :col 8 :file "diag.bl"} nil)
        out (errors/render "diag.bl" src d)]
    (is (includes? out "diag.bl:1:8") "the location is named")
    (is (includes? out "^") "the caret is drawn")))
