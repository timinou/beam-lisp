; test/bl/lazy_producers_test.bl — the lazy producers' semantics and their
; chunked-engine contract, in beam-lisp itself.
; Run: bl test test/bl/lazy_producers_test.bl
;
; Two properties are pinned, and they are different properties.
;
; EQUIVALENCE — every producer matches an EAGER reference written with
; loop/recur over a list, at sizes 0, 1, 31, 32, 33, 100 and 1000. The sizes
; straddle the 32-element chunk boundary, which is the only place a chunking
; bug shows up: a lost or duplicated element at a chunk seam is invisible at
; n=4 and fatal at n=4000.
;
; LAZINESS — over an INFINITE input, taking a few elements forces at most one
; chunk. That is the property that makes these producers usable on `(range)`,
; and it is the property the chunked rewrite could most easily have broken;
; a counter sees it where a stopwatch cannot.
;
; The reference implementations are deliberately the naive strict ones — the
; point is that the lazy producer's VALUE is the value you would get without
; laziness at all.

(ns lazy-producers.test)

(def sizes [0 1 31 32 33 100 1000])

; ── eager references ────────────────────────────────────────────────────────

(defn- take-n
  "The first n of a list, as a list."
  [n xs]
  (loop [i n s xs acc ()]
    (cond
      (erlang/== i 0) (reverse acc)
      (empty? s) (reverse acc)
      :else (recur (erlang/- i 1) (rest s) (cons (first s) acc)))))

(defn- drop-n
  "A list without its first n elements."
  [n xs]
  (loop [i n s xs]
    (cond
      (erlang/== i 0) s
      (empty? s) s
      :else (recur (erlang/- i 1) (rest s)))))

(defn- ref-map-indexed [f coll]
  (loop [i 0 s (to-list coll) acc ()]
    (if (empty? s)
      (reverse acc)
      (recur (inc i) (rest s) (cons (f i (first s)) acc)))))

(defn- ref-keep-indexed [f coll]
  (loop [i 0 s (to-list coll) acc ()]
    (if (empty? s)
      (reverse acc)
      (let [x (f i (first s))]
        (recur (inc i) (rest s) (if (nil? x) acc (cons x acc)))))))

(defn- ref-keep [f coll]
  (loop [s (to-list coll) acc ()]
    (if (empty? s)
      (reverse acc)
      (let [x (f (first s))]
        (recur (rest s) (if (nil? x) acc (cons x acc)))))))

(defn- ref-distinct [keyfn coll]
  (loop [s (to-list coll) seen (set []) acc ()]
    (if (empty? s)
      (reverse acc)
      (let [x (first s) k (keyfn x)]
        (if (contains? seen k)
          (recur (rest s) seen acc)
          (recur (rest s) (conj seen k) (cons x acc)))))))

(defn- ref-dedupe [coll]
  (loop [s (to-list coll) prev () acc ()]
    (if (empty? s)
      (reverse acc)
      (let [x (first s)]
        (if (and (not (empty? prev)) (= (first prev) x))
          (recur (rest s) prev acc)
          (recur (rest s) (list x) (cons x acc)))))))

(defn- ref-interpose [sep coll]
  (loop [s (to-list coll) first? true acc ()]
    (if (empty? s)
      (reverse acc)
      (if first?
        (recur (rest s) false (cons (first s) acc))
        (recur (rest s) false (cons (first s) (cons sep acc)))))))

(defn- ref-partition [n step coll]
  (loop [s (to-list coll) acc ()]
    (let [p (take-n n s)]
      (if (erlang/== (count p) n)
        (recur (drop-n step s) (cons p acc))
        (reverse acc)))))

(defn- ref-partition-pad [n step pad coll]
  (loop [s (to-list coll) acc ()]
    (let [p (take-n n s) k (count p)]
      (cond
        (erlang/== k 0) (reverse acc)
        (erlang/== k n) (recur (drop-n step s) (cons p acc))
        :else (reverse (cons (take-n n (concat p (to-list pad))) acc))))))

(defn- ref-partition-by [f coll]
  (loop [s (to-list coll) acc ()]
    (if (empty? s)
      (reverse acc)
      (let [fv (f (first s))
            r (loop [s2 s run ()]
                (if (and (not (empty? s2)) (= (f (first s2)) fv))
                  (recur (rest s2) (cons (first s2) run))
                  (erlang/list_to_tuple (list (reverse run) s2))))
            run (erlang/element 1 r)
            s2 (erlang/element 2 r)]
        (recur s2 (cons run acc))))))

(defn- ref-interleave2 [a b]
  (loop [s (to-list a) t (to-list b) acc ()]
    (if (or (empty? s) (empty? t))
      (reverse acc)
      (recur (rest s) (rest t) (cons (first t) (cons (first s) acc))))))

(defn- ref-filter [pred coll]
  (loop [s (to-list coll) acc ()]
    (if (empty? s)
      (reverse acc)
      (recur (rest s) (if (pred (first s)) (cons (first s) acc) acc)))))

(defn- ref-for-nested [a b]
  (loop [s (to-list a) acc ()]
    (if (empty? s)
      (reverse acc)
      (let [x (first s)]
        (recur (rest s)
               (loop [t (to-list b) acc2 acc]
                 (if (empty? t)
                   acc2
                   (recur (rest t) (cons [x (first t)] acc2)))))))))

; ── equivalence across the chunk boundary ───────────────────────────────────

(deftest map-indexed-matches-eager
  (doseq [n sizes]
    (let [c (vec (range n))]
      (is (= (ref-map-indexed (fn [i x] [i x]) c)
             (doall (map-indexed (fn [i x] [i x]) c)))
          (str "map-indexed at n=" n)))))

(deftest keep-indexed-matches-eager
  (doseq [n sizes]
    (let [c (vec (range n))]
      (is (= (ref-keep-indexed (fn [i x] (when (odd? i) x)) c)
             (doall (keep-indexed (fn [i x] (when (odd? i) x)) c)))
          (str "keep-indexed at n=" n)))))

(deftest keep-matches-eager
  (doseq [n sizes]
    (let [c (vec (range n))]
      (is (= (ref-keep (fn [x] (when (odd? x) x)) c)
             (doall (keep (fn [x] (when (odd? x) x)) c)))
          (str "keep at n=" n)))))

(deftest distinct-matches-eager
  (doseq [n sizes]
    (let [c (vec (map (fn [i] (mod i 5)) (range n)))]
      (is (= (ref-distinct identity c) (doall (distinct c)))
          (str "distinct at n=" n))
      (is (= (ref-distinct (fn [x] (mod x 3)) c)
             (doall (distinct (fn [x] (mod x 3)) c)))
          (str "distinct/keyfn at n=" n)))))

(deftest dedupe-matches-eager
  (doseq [n sizes]
    (let [c (vec (map (fn [i] (mod i 3)) (range n)))]
      (is (= (ref-dedupe c) (doall (dedupe c)))
          (str "dedupe at n=" n)))))

(deftest interpose-matches-eager
  (doseq [n sizes]
    (let [c (vec (range n))]
      (is (= (ref-interpose :x c) (doall (interpose :x c)))
          (str "interpose at n=" n)))))

(deftest partition-matches-eager
  (doseq [n sizes]
    (let [c (vec (range n))]
      (is (= (ref-partition 4 4 c) (doall (partition 4 c)))
          (str "partition 4/4 at n=" n))
      (is (= (ref-partition 4 2 c) (doall (partition 4 2 c)))
          (str "partition 4/2 at n=" n))
      (is (= (ref-partition 2 5 c) (doall (partition 2 5 c)))
          (str "partition 2/5 at n=" n))
      (is (= (ref-partition-pad 4 4 [:p] c) (doall (partition 4 4 [:p] c)))
          (str "partition pad at n=" n))
      (is (= (ref-partition-pad 4 4 [] c) (doall (partition 4 4 [] c)))
          (str "partition empty pad at n=" n)))))

(deftest partition-pad-shorter-than-needed
  ; Not enough padding: the last partition is short, as the docstring says.
  (is (= '((1 2 3) (4 5 9)) (doall (partition 3 3 [9] [1 2 3 4 5]))))
  (is (= '((1 2 3) (4 9)) (doall (partition 3 3 [9] [1 2 3 4]))))
  ; An empty input yields nothing, padded or not.
  (is (= '() (doall (partition 3 3 [9] [])))))

(deftest partition-by-matches-eager
  (doseq [n sizes]
    (let [c (vec (map (fn [i] (mod i 4)) (range n)))]
      (is (= (ref-partition-by (fn [x] (quot x 2)) c)
             (doall (partition-by (fn [x] (quot x 2)) c)))
          (str "partition-by at n=" n)))))

(deftest partition-by-calls-f-once-per-element
  ; Clojure calls f once per element; the old take-while/drop-while shape
  ; called it twice per element. Count, don't time.
  (let [c (atom 0)]
    (doall (partition-by (fn [x] (swap! c inc) (quot x 3)) (vec (range 100))))
    (is (= 100 (deref c)))))

(deftest interleave-matches-eager
  (doseq [n sizes]
    (let [a (vec (range n)) b (vec (map (fn [i] (- i)) (range n)))]
      (is (= (ref-interleave2 a b) (doall (interleave a b)))
          (str "interleave 2-arity at n=" n)))
    ; The shortest input ends the seq, and the 3+-arity form (broken before
    ; this rewrite: it built its cursor list with a 3-arity `conj`) runs.
    (is (= '(1 :a "x") (doall (interleave [1 2] [:a] ["x" :y]))))
    (is (= '(1 :a) (doall (interleave [1 2 3] [:a])))
        "the shortest coll ends the seq")
    (is (= '() (doall (interleave)))
        "0-arity is empty")
    (is (= '(1 2 3) (doall (interleave [1 2 3]))))))

(deftest repeatedly-chunks
  (is (= '(7 7 7) (doall (take 3 (repeatedly (fn [] 7))))))
  (is (= '(0 1 2) (let [n (atom -1)] (doall (take 3 (repeatedly (fn [] (swap! n inc)))))))))
; ── non-list seqables ───────────────────────────────────────────────────────

(deftest producers-agree-with-seq-normalisation
  ; A map / set / string / short vector input must yield what the same
  ; producer yields over `(seq input)`: `lazy-input` normalises through `seq`
  ; before the chunk walk starts, so map entries stay VECTORS (destructuring
  ; still works) and a set iterates its members in order.
  (is (= (doall (map-indexed (fn [i x] [i x]) {:a 1 :b 2})) (doall (map-indexed (fn [i x] [i x]) (seq {:a 1 :b 2})))))
  (is (= (doall (distinct {:a 1 :b 2})) (doall (distinct (seq {:a 1 :b 2})))))
  (is (= (doall (keep-indexed (fn [i x] [i x]) (sorted-set-of [3 1 2]))) (doall (keep-indexed (fn [i x] [i x]) (seq (sorted-set-of [3 1 2]))))))
  (is (= (doall (interpose :x "abc")) (doall (interpose :x (seq "abc")))))
  ; a short vector (below the cursor threshold) and a long one walk the same
  (is (= (doall (dedupe [1 1 2 2])) (doall (dedupe (vec (concat (repeat 33 1) [2 2]))))) "short vs long input are the same producer")
  (is (= '(1 2) (doall (dedupe (vec (concat (repeat 33 1) [2 2])))))))

; ── nil / empty / false edges ──────────────────────────────────────────────

(deftest nil-and-false-edges
  (is (= '() (doall (distinct []))))
  (is (= '() (doall (dedupe []))))
  (is (= '() (doall (keep identity []))))
  (is (= '() (doall (partition-by identity []))))
  (is (= '() (doall (map-indexed identity []))))
  (is (= '() (doall (keep-indexed (fn [i x] x) []))))
  (is (= '() (doall (interpose :x []))))
  ; distinct treats nil as a value, once
  (is (= '(nil 1) (doall (distinct [nil nil 1 nil]))))
  ; dedupe collapses a run of nil but keeps a later run
  (is (= '(nil 1 nil) (doall (dedupe [nil nil 1 1 nil]))))
  ; keep drops nil, KEEPS false
  (is (= '(false 2 false 4) (doall (keep (fn [x] (if (odd? x) false x)) [1 2 3 4]))))
  (is (= '(1 3 false) (doall (keep (fn [x] (if (= 2 x) nil x)) [1 2 3 false]))))
  ; keep-indexed counts every element, including the rejected ones
  (is (= '(0 2 4) (doall (keep-indexed (fn [i x] (when (even? i) i)) [nil nil nil nil nil]))))
  ; dedupe's equality is by value, so nil == nil
  (is (= '(1 nil) (doall (dedupe [1 nil nil nil])))))

; ── laziness over an infinite input ────────────────────────────────────────

(deftest map-indexed-is-lazy
  (let [c (atom 0)]
    (is (= '(0 1 2) (doall (take 3 (map-indexed (fn [i x] (swap! c inc) x) (range))))))
    (is (<= (deref c) 32) "one chunk of over-realisation")))

(deftest distinct-is-lazy
  (let [c (atom 0)]
    (is (= '(0 1 2) (doall (take 3 (distinct (map (fn [x] (swap! c inc) x) (range)))))))
    (is (<= (deref c) 32))))

(deftest dedupe-is-lazy
  (let [c (atom 0)]
    (is (= '(0 1 2) (doall (take 3 (dedupe (map (fn [x] (swap! c inc) x) (range)))))))
    (is (<= (deref c) 32))))

(deftest interpose-is-lazy
  (let [c (atom 0)]
    (is (= '(0 :x 1 :x) (doall (take 4 (interpose :x (map (fn [x] (swap! c inc) x) (range)))))))
    (is (<= (deref c) 32))))

(deftest keep-is-lazy
  ; A filtering producer may consume up to two chunks of input per chunk of
  ; output — the honest bound when the emitted count is what is chunked.
  (let [c (atom 0)]
    (is (= '(0 1 2) (doall (take 3 (keep (fn [x] (swap! c inc) (when (< x 100) x)) (range))))))
    (is (<= (deref c) 34))))

(deftest keep-indexed-is-lazy
  (let [c (atom 0)]
    (is (= '(0 1 2) (doall (take 3 (keep-indexed (fn [i x] (swap! c inc) x) (range))))))
    (is (<= (deref c) 32))))

(deftest partition-is-lazy
  (let [c (atom 0)]
    (is (= '((0 1) (2 3)) (doall (take 2 (partition 2 (map (fn [x] (swap! c inc) x) (range)))))))
    (is (<= (deref c) 64) "one chunk of partitions is 64 inputs")))

(deftest partition-by-is-lazy
  (let [c (atom 0)]
    (is (= '((0 1 2) (3 4 5)) (doall (take 2 (partition-by (fn [x] (swap! c inc) (quot x 3)) (range))))))
    (is (<= (deref c) 97) "32 runs (96 elements) plus the probe that opens the next run")))

(deftest interleave-is-lazy
  (let [c (atom 0)]
    (is (= '(0 :a :b 1) (doall (take 4 (interleave (map (fn [x] (swap! c inc) x) (range)) (repeat :a) (repeat :b))))))
    (is (<= (deref c) 32))))

(deftest infinite-inputs-terminate
  ; The whole point: these must work on an unbounded source.
  (is (= '(0 1 2) (doall (take 3 (distinct (iterate inc 0))))))
  (is (= '(1 2 3) (doall (take 3 (dedupe (cycle [1 1 2 2 3 3]))))))
  (is (= '(0 :x 0 :x) (doall (take 4 (interpose :x (repeat 0))))))
  (is (= '((0) (1) (2)) (doall (take 3 (partition-by identity (iterate inc 0))))))
  (is (= '(1 2 3) (doall (take 3 (keep (fn [x] (when (pos? x) x)) (iterate inc 0))))))
  (is (= '(1 1 1) (doall (take 3 (keep (fn [x] (when (odd? x) 1)) (range))))))
  (is (= '(0 1 2) (doall (take 3 (map-indexed (fn [i x] i) (repeat :x))))))
  (is (= '(0 2 4) (doall (take 3 (keep-indexed (fn [i x] (when (even? i) i)) (repeat :x)))))))

; ── for ────────────────────────────────────────────────────────────────────

(deftest for-matches-eager
  (doseq [n sizes]
    (let [a (vec (range n)) b (vec (range 3))]
      (is (= (to-list a) (doall (for [x a] x))) (str "for plain at n=" n))
      (is (= (ref-filter even? a) (doall (for [x a :when (even? x)] x))) (str "for :when at n=" n))
      (is (= (ref-for-nested a b) (doall (for [x a y b] [x y]))) (str "for nested at n=" n)))))

(deftest for-three-deep
  ; Three nested groups, rightmost fastest.
  (is (= '([1 10 100] [1 10 101] [1 20 100] [1 20 101] [2 10 100] [2 10 101] [2 20 100] [2 20 101])
         (doall (for [x [1 2] y [10 20] z [100 101]] [x y z]))))
  ; a :while on an INNER group ends only that group; the outer keeps going
  (is (= '([1 0] [1 1] [2 0] [2 1]) (doall (for [x [1 2] y (range 3) :while (< y 2)] [x y]))))
  ; an inner group that yields nothing for some outer element is skipped
  (is (= '([1 0] [3 0] [3 1] [3 2]) (doall (for [x [1 2 3] y (range x) :when (odd? x)] [x y])))))

(deftest for-modifiers
  (is (= '([1 10] [2 20] [3 30]) (doall (for [x [1 2 3] :let [y (* x 10)]] [x y]))))
  (is (= '(0 2 4 6 8) (doall (for [x (range 10) :when (even? x)] x))))
  (is (= '() (doall (for [x [1 2 3] :when false] x))))
  (is (= '(0 1 2 3 4) (doall (for [x (range) :while (< x 5)] x))))
  (is (= '([1 10 100 1000 111]) (doall (for [a [1 2] b [10 20] :when (not= b 20) c [100] :let [s (+ a b c)] d [1000] :while (< a 2)] [a b c d s])))))

(deftest for-destructuring
  (is (= '(3 7) (doall (for [[a b] [[1 2] [3 4]]] (+ a b)))))
  ; A map's seq order is unspecified (OTP orders small-map atom keys by atom
  ; CREATION order, which differs between VMs): compare as a set.
  (is (= #{[:a 1] [:b 2]} (set (doall (for [[k v] {:a 1 :b 2}] [k v])))))
  (is (= '(1 2) (doall (for [{:keys [n]} [{:n 1} {:n 2}]] n)))))

(deftest for-is-lazy
  ; Bounds by a counter, not a stopwatch: taking 3 of an infinite `for`
  ; forces one chunk of the source, never the source.
  (let [c (atom 0)]
    (is (= '(0 2 4) (doall (take 3 (for [x (range)] (do (swap! c inc) (* x 2)))))))
    (is (<= (deref c) 32) "chunked"))
  (let [c (atom 0)]
    (is (= '(0 2 4) (doall (take 3 (for [x (range) :when (even? x)] (do (swap! c inc) x))))))
    (is (<= (deref c) 66) "a filter may read two chunks of input")))

(deftest for-body-runs-once-per-element
  (let [c (atom 0)]
    (doall (for [x [1 2 3] y [1 2]] (swap! c inc)))
    (is (= 6 (deref c)))))

(deftest for-hygiene
  (is (= '(5) (doall (for [x [1]] (let [iter 5] iter)))))
  (is (= '(7) (doall (for [x [1]] (let [s 7] s)))))
  (is (= '(9) (doall (for [x [1]] (let [n 9] n)))))
  (is (= '(11) (doall (for [x [1]] (let [acc 11] acc))))))

(deftest for-nested-infinite
  ; A nested `for` over an INFINITE source must terminate. The inner iterators
  ; of a chunk are concatenated in ONE flat `concat`: a nested
  ; `(concat y1 (concat y2 …))` was pulled 32 elements deep by rt's CHUNKED
  ; concat and, with a lazily generated tail, walked the whole chain into the
  ; lazy cache budget.
  (is (= '([0 0] [0 1] [0 2] [1 0]) (doall (take 4 (for [x (range) y [0 1 2]] [x y])))))
  (is (= '([0 0] [0 1] [0 2] [1 0]) (doall (take 4 (for [x (range) y (range 3)] [x y])))))
  (is (= '([0 0] [0 1] [0 2]) (doall (take 3 (for [x (range) y (range)] [x y])))))
  (is (= '([0 0 0] [0 0 1] [0 0 2]) (doall (take 3 (for [x (range) y (range) z (range)] [x y z])))))
  ; an empty inner contributes nothing — over a FINITE outer (an infinite one
  ; cannot be known to be empty, and neither can Clojure's)
  (is (= '() (doall (for [x (range 5) y []] [x y]))))
  (is (= 120 (count (doall (for [x (range 40) y (range 3)] [x y]))))))

(deftest for-over-chunked-seam
  ; 100 elements crosses three chunk boundaries (32/64/96); the join at the
  ; seam must not lose or duplicate a body run.
  (is (= (to-list (vec (range 100))) (doall (for [x (vec (range 100))] x))))
  (is (= 100 (count (doall (for [x (vec (range 100)) :when true] x))))))
