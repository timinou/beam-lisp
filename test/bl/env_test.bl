; env_test.bl — the project file's declared keys, pinned.
;
; `bl.env` normalizes an `env.bl` into the project value every command reads.
; W9 added four keys to it — `:app`, `:build`, `:release`, `:deps` — so a build
; stops guessing about itself: what this tree IS as an application, where its
; build sources and output live, what to assemble, and which libraries it
; requires. These tests pin the three properties that make the file trustworthy:
;
;   it stays DATA         the last form is a map, read without evaluation
;   errors are VALUES     every problem at once, each naming where it is
;   paths are absolute    against the file's own root, whatever the caller's cwd
;
; The first test reads THIS repository's own env.bl: the file is a live contract,
; not an example, and a key the format does not know would be an error here.
(ns test.env
  (:require [bl.env :as env]))

(def root "/tmp/bl_env_test")

(defn- write! [src]
  (File/mkdir_p! root)
  (let [p (str root "/env.bl")]
    (File/write! p src)
    p))

; NB: a keyword inside a MESSAGE renders without its colon (`unknown key wat`), while
; the literal text of the message keeps whatever colons it was written with
; (`:build :jobs must be a number`). Assertions here match what is printed.
(defn- says?
  "Whether some error mentions `needle` — asserted instead of a count, so adding
   an error to a case does not require re-counting the others."
  [errs needle]
  (some (fn [e] (>= (count (split e needle)) 2)) errs))

(deftest this-repository-declares-itself
  (let [p (env/project (BeamLisp/cwd))]
    (is (= [] (:errors p)) "no unknown keys, no shape problems")
    (is (some? (:app p)) "the tree says what application it is")
    (is (some? (:build p)) "and where its build sources live")
    (is (some? (:release p)) "and what to assemble")
    (is (vector? (:deps p)))))

(deftest what-this-repository-declares-exists
  ;; A declaration nothing can satisfy is a lie with good manners. Every path,
  ;; seed and native glob this repository's env.bl names must resolve to real
  ;; files, and its build roots must actually hold sources: `bl build` with no
  ;; PATH argument is now driven entirely by this list.
  (let [p (env/project (BeamLisp/cwd))
        b (:build p)]
    (is (not (empty? (:paths b))) "the tree names its build roots")
    (every? (fn [d] (is (File/dir? d) (str d " exists"))) (:paths b))
    (let [sources (mapcat (fn [d] (Path/wildcard (str d "/**/*.bl"))) (:paths b))]
      (is (>= (count (vec sources)) 14)
          "the declared root holds the driver tier, not an empty promise"))
    (is (File/dir? (:seed b)) "the codegen seed is a directory here")
    (is (string? (:name (:release p))) "the release is named")
    (is (= :inherit (:cookie (:release p)))
        "a self-build inherits the cookie: a fresh one per generation breaks the fixpoint")))

(deftest a-full-declaration-normalizes
  (write! (str "{:name \"demo\""
               " :app {:name \"demo\" :vsn \"1.2.3\" :applications [:kernel :elixir]"
               "       :mod {:name \"Demo.App\" :start [:normal []]}}"
               " :build {:paths [\"priv/build\"] :seed \"priv/boot\" :out \"build\""
               "         :jobs 4 :native [\"native/tiny\"] :ex {:root \"lib\" :exclude [\"mix\"]}}"
               " :release {:name \"demo\" :vsn \"1.2.3\" :output \"rel\""
               "           :permanent [:kernel] :cookie :inherit}"
               " :deps [{:name \"jason\" :vsn \"1.4.4\"}]}"))
  (let [p (env/project root)]
    (is (= [] (:errors p)))
    (is (= "demo" (:name p)))
    (is (= "1.2.3" (:vsn (:app p))))
    (is (= [:kernel :elixir] (:applications (:app p))))
    (is (= "Demo.App" (:name (:mod (:app p)))))
    (is (= [(str root "/priv/build")] (:paths (:build p))))
    (is (= (str root "/build") (:out (:build p))) "paths are absolute against the root")
    (is (= (str root "/priv/boot") (:seed (:build p))))
    (is (= 4 (:jobs (:build p))))
    (is (= [(str root "/native/tiny")] (:native (:build p))))
    (is (= ["mix"] (:exclude (:ex (:build p))))
        "excludes are names relative to :root, never expanded paths")
    (is (= (str root "/rel") (:output (:release p))))
    (is (= :inherit (:cookie (:release p))))
    (is (= [{:name "jason" :vsn "1.4.4"}] (:deps p)))))

(deftest every-problem-lands-and-names-itself
  (write! (str "{:name 42"
               " :build {:jobs \"many\" :wat 1}"
               " :release {:cookie :nope}"
               " :deps [{:name \"jason\"} {:name \"ok\" :vsn \"1.0.0\" :digest \"deadbeef\"}]"
               " :nonsense 1}"))
  (let [p  (env/project root)
        es (:errors p)]
    (is (says? es ":name must be a string"))
    (is (says? es ":build :jobs must be a number"))
    (is (says? es ":build has unknown key wat") "a typo inside a declared key is reported")
    (is (says? es ":release :cookie must be a string or :inherit"))
    (is (says? es "a dep needs :vsn, a string"))
    (is (says? es "a dep has unknown key digest")
        "a DIGEST is resolution's business: it belongs in bl.lock, not here")
    (is (says? es "unknown key nonsense"))
    (is (= [] (:deps p)) "a declaration with problems yields no half-built value")))

(deftest a-tree-with-no-project-file-is-not-an-error
  (let [p (env/project "/tmp")]
    (is (= [] (:errors p)))
    (is (nil? (:path p)))
    (is (nil? (:build p)))
    (is (= [] (:deps p)) "every accessor reads an empty project the same way")))

(deftest a-problem-does-not-stop-discovery
  (write! "{:name 42}")
  (let [p (env/project root)]
    (is (= (str root "/env.bl") (:path p)) "the file is still found and named")
    (is (= root (:root p)) "and its directory is still the root paths resolve against")
    (is (some? (:errors p)))))
