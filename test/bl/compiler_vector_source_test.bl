(ns compiler-vector-source.test)

(defn- compile-probe []
  (let [out (str (System/tmp_dir!) "/kn-compiler-vector-" (erlang/unique_integer (list :positive)))
        mod :Elixir.BeamLisp.NavigationCompilerVectorProbe
        path (erlang/element 2
               (BeamLisp.AOT/compile_host_file
                 (str (BeamLisp/cwd) "/priv/host/compiler_data.bl")
                 (list (tuple :module mod) (tuple :output_dir out) (tuple :load? false))))]
    (code/purge mod)
    (code/delete mod)
    (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
    mod))

(deftest eager-compiler-traversal-owns-values-not-vector-storage
  (let [probe (compile-probe)]
  (doseq [n [32 33 65 1025]]
    (let [v (reduce conj [] (range n))
          visits (atom [])
          mapped (erlang/apply probe :eager_map
                   (list (fn [x] (swap! visits conj x) (+ x 1)) v))]
      (is (= (into [] (range n)) @visits) "visit logical elements once in order")
      (is (= (into [] (range 1 (+ n 1))) (into [] mapped))) ))))
