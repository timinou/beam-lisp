(ns test.foundry-env (:require [bl.env :as env]))
(def declaration
  {:observability {:version 1 :transport :journald :schema "ops/schema.json"
                   :local-command "ops/traces.py" :window-lines 300 :max-record-bytes 8192
                   :domains [:upload :agent] :identity :keyed-handles :content :excluded}})
(deftest discovery-is-data-and-paths-resolve-against-project
  (let [p (env/normalize {:foundry declaration} "/home/user/example" nil)]
    (is (= [] (:errors p)))
    (is (= "/home/user/example/ops/schema.json" (get-in p [:foundry :observability :schema])))))
(deftest invalid-contracts-report-errors-without-authority
  (doseq [value ["not-map" {:observability "not-map"}
                (assoc-in declaration [:observability :schema] "../secret")
                (assoc-in declaration [:observability :window-lines] 501)
                (assoc-in declaration [:observability :content] :raw)
                (assoc-in declaration [:observability :hook] '(println "no evaluation"))]]
    (let [p (env/normalize {:foundry value} "/home/user/example" nil)]
      (is (seq (:errors p)))
      (is (nil? (:foundry p))))))

(def application
  {:version 1 :requirements ["datom" "example.core"]
   :entrypoints {:main "src/example/main.bl"} :data-version 1})
(deftest application-capabilities-are-independent-relocatable-data
  (let [p (env/normalize {:foundry {:application application}} "/home/user/example" nil)]
    (is (= [] (:errors p)))
    (is (= application (get-in p [:foundry :application]))))
  (let [p (env/normalize {:foundry (assoc declaration :application application)} "/home/user/example" nil)]
    (is (= [] (:errors p)))
    (is (= application (get-in p [:foundry :application])))
    (is (= "/home/user/example/ops/schema.json" (get-in p [:foundry :observability :schema])))))
(deftest application-discovery-refuses-unsupported-or-executable-inputs
  (doseq [a [nil "bad" (assoc application :version 2)
              (assoc application :data-version 0)
              (assoc application :requirements [1])
              (assoc application :entrypoints {:main "../secret.bl"})
              (assoc application :entrypoints {:main "/secret.bl"})
              (assoc application :entrypoints {:main '(println "not callable")})
              (assoc application :hook '(println "not callable"))]]
    (let [p (env/normalize {:foundry {:application a}} "/home/user/example" nil)]
      (is (seq (:errors p)))
      (is (nil? (:foundry p))))))
