;; Unknown top-level effects cannot be represented by definition-only AOT init.
(ns loader.replay-test)
(deftest whole-unit-replay-admission-is-conservative
 (is (BeamLisp.Loader/replayable_source? "(ns replay.simple) (defn answer [] 42)"))
 (doseq [source ["(ns replay.effect) (println :effect) (def value 1)"
                 "(ns replay.macro) (custom-definer x)"
                 "(ns replay.multi) (ns replay.other) (def value 1)"
                 "(def value 1)" "not valid ["]]
  (is (not (BeamLisp.Loader/replayable_source? source)))))
(deftest stale-aot-artifact-cannot-hide-source-initializer
 (let [root (str (System/tmp_dir!) "/loader-replay-" (erlang/unique_integer (list :positive)))
       source-root (str root "/src") ebin (str root "/stale")
       file (str source-root "/replay/effect.bl") marker (str root "/marker")
       consumer (str root "/consume.bl")
       source (str "(ns replay.effect) (File/write! " (pr-str marker)
                   " \"initialized\") (defn answer [] 42)")]
  (try
   (File/mkdir_p! (Path/dirname file)) (File/mkdir_p! ebin) (File/write! file source)
   ;; A missing proof is a boolean rejection, including for effectful sources.
   ;; Loader/load_route passes this result to Erlang's strict boolean not.
   (is (= false (BeamLisp.AOT/replayable_cached_source? "replay.effect" file)))
   (let [environment (BeamLisp.Env/fork)]
    (try
     (BeamLisp.Env/with_env environment
      (fn [] (BeamLisp.AOT/compile_source source
                (list (tuple :file file) (tuple :output_dir ebin) (tuple :load? false)))))
     (finally (BeamLisp.Env/destroy environment))))
   (is (seq (Path/wildcard (str ebin "/*.beam"))))
   (File/write! consumer
    (str "(ns replay.consume) (Code/prepend_path " (pr-str ebin) ") "
     "(BeamLisp.Loader/with_search_dir " (pr-str source-root) " (fn [] "
     "(BeamLisp.Loader/ensure_loaded \"replay.effect\") "
     "(assert (= \"initialized\" (File/read! " (pr-str marker) "))) "
     "(assert (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! \"replay.effect\" \"answer\") (list)))) "
     "(println \"SOURCE_EFFECT_RETAINED\")))"))
   (File/rm! marker)
   (let [[text status] (System/cmd "timeout" (list "-k" "15" "600" (Path/expand "bin/bl" (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))) "--cold" "run" consumer)
                        (list (tuple :stderr_to_stdout true)
                              (tuple :env (list (tuple "BL_DAEMON" "off")))))]
    (is (= 0 status) text)
    (is (String/contains? text "SOURCE_EFFECT_RETAINED") text))
   (finally (File/rm_rf! root)))))
