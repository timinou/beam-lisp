(ns aot-source-snapshot-context.test)

(deftest one-pass-keeps-distinct-ambient-fixed-and-pushed-source-roots
  (let [root (str (System/tmp_dir!) "/bl-source-context-" (System/unique_integer (list :positive)))
        a (Path/join root "a") b (Path/join root "b")
        ns (str "snapshot-context-" (System/unique_integer (list :positive)))
        prior (Process/get :bl_fixed_dirs)]
    (File/mkdir_p! a) (File/mkdir_p! b)
    (File/write! (Path/join a (str ns ".bl")) (str "(ns " ns ") (def value :a)"))
    (File/write! (Path/join b (str ns ".bl")) (str "(ns " ns ") (def value :b)"))
    (try
      (BeamLisp.AOT/with_source_snapshot
        (fn []
          (let [key (fn [dir]
                      (BeamLisp.Loader/with_ambient_dirs (list dir)
                        (fn [] (BeamLisp.AOT/ns_closure_hash ns))))
                ka (key a) kb (key b)]
            (is (string? ka)) (is (string? kb)) (is (not= ka kb))
            (is (= ka (key a)))
            (Process/put :bl_fixed_dirs (list a))
            (is (= ka (BeamLisp.AOT/ns_closure_hash ns)))
            (Process/put :bl_fixed_dirs (list b))
            (is (= kb (BeamLisp.AOT/ns_closure_hash ns)))
            (Process/delete :bl_fixed_dirs)
            (is (= ka (BeamLisp.Loader/with_load_path a (fn [] (BeamLisp.AOT/ns_closure_hash ns)))))
            (is (= kb (BeamLisp.Loader/with_load_path b (fn [] (BeamLisp.AOT/ns_closure_hash ns))))))))
      (is (nil? (Process/get :bl_source_graph_nodes)))
      (finally
        (if prior (Process/put :bl_fixed_dirs prior) (Process/delete :bl_fixed_dirs))
        (File/rm_rf! root)))))
