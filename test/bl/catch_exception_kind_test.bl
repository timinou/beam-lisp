; test/bl/catch_exception_kind_test.bl — the RAW catch class, by name.
;
; `priv/boot/compiler.bl::catch-handler-node` binds the raw Erlang catch kind —
; `:throw`, `:error` or `:exit` — into every catch handler's lexical scope as
; `__EXCEPTION_KIND__`, beside `__STACKTRACE__`. The FOLDED handler value `e` is
; unchanged: a `:throw` keeps its raw value, an `:error` is
; `Exception.normalize`d, an `:exit` becomes the 2-tuple `{:exit, v}`. The fold
; alone cannot tell a raw `:erlang.throw/1` of a struct from a raise of the SAME
; struct, nor a thrown `{:exit, v}` pair from a genuine exit — the kind is the
; only way, and it is what `priv/host/loader_server.bl` classifies on.
;
; THIS SUITE IS ALSO THE FRESHNESS PROOF. `__EXCEPTION_KIND__` is a compiler-
; injected local; the committed floor does NOT bind it, so under a stale compiler
; it compiles to a namespace-var fetch and the first deref fails. A green run
; therefore means the CHANGED compiler is the one loaded — run it from a scratch
; image built with `bl build --out DIR` and `BEAM_LISP_EBIN=DIR`.
;
; Run: bin/bl test test/bl/catch_exception_kind_test.bl

(ns catch.exception-kind.test)

(defn- exit-pair [v] (erlang/list_to_tuple (list :exit v)))

(deftest raw-kinds
  (testing "each raw class reports itself"
    (is (= :throw (try (erlang/throw :x) (catch e __EXCEPTION_KIND__))))
    (is (= :error (try (erlang/error :x) (catch e __EXCEPTION_KIND__))))
    (is (= :exit  (try (erlang/exit :x)  (catch e __EXCEPTION_KIND__))))))

(deftest same-normalized-value-different-kind
  (testing "a thrown struct and a raised struct fold to the SAME value; only the kind differs"
    (let [ex (Elixir.RuntimeError/exception "boom")
          thrown (try (erlang/throw ex) (catch e [__EXCEPTION_KIND__ e]))
          raised (try (erlang/error ex) (catch e [__EXCEPTION_KIND__ e]))]
      (is (= ex (second thrown)))
      (is (= ex (second raised)))
      (is (= (second thrown) (second raised)))
      (is (= :throw (first thrown)))
      (is (= :error (first raised)))))
  (testing "a thrown {:exit, v} pair and a real exit fold alike; only the kind differs"
    (let [thrown (try (erlang/throw (exit-pair 7)) (catch e [__EXCEPTION_KIND__ e]))
          exited (try (erlang/exit 7) (catch e [__EXCEPTION_KIND__ e]))]
      (is (= (exit-pair 7) (second thrown)))
      (is (= (exit-pair 7) (second exited)))
      (is (= (second thrown) (second exited)))
      (is (= :throw (first thrown)))
      (is (= :exit (first exited))))))

(deftest typed-catch
  (testing "a typed catch still matches the normalized struct and can read the kind"
    (let [r (try (throw {:boom 1})
              (catch BeamLisp.ExInfo e [__EXCEPTION_KIND__ (ex-data e)]))]
      (is (= :error (first r)))
      (is (= 1 (get (second r) :boom)))))
  (testing "a typed catch that matches nothing re-raises; the outer kind is the original"
    (is (= :error (try (try (erlang/error :plain)
                         (catch BeamLisp.ExInfo e :caught))
                    (catch outer __EXCEPTION_KIND__))))))

(deftest nested-scope
  (testing "an inner handler shadows the outer kind; the outer is restored after"
    (let [r (try (erlang/throw :outer)
              (catch e
                [(try (erlang/error :inner) (catch e2 __EXCEPTION_KIND__))
                 __EXCEPTION_KIND__]))]
      (is (= :error (first r)))
      (is (= :throw (second r))))))

(deftest finally-untouched
  (testing "finally runs, and the handler still reports the raw kind"
    (let [a (atom 0)
          k (try (erlang/error :x)
              (catch e __EXCEPTION_KIND__)
              (finally (swap! a inc)))]
      (is (= :error k))
      (is (= 1 (deref a)))))
  (testing "finally runs on the propagating path too, and the re-raised kind is intact"
    (let [a (atom 0)
          r (try (try (erlang/throw :t)
                   (catch BeamLisp.ExInfo e :caught)
                   (finally (swap! a inc)))
              (catch e __EXCEPTION_KIND__))]
      (is (= :throw r))
      (is (= 1 (deref a))))))

(deftest compiler-image
  (testing "the compiler that compiled this file is the one on the code path, built from the CURRENT source"
    (let [ebin (or (System/get_env "BL_EBIN") "")
          which (erlang/apply :code :which (list :"Elixir.BeamLisp.Ns.Compiler"))
          path (if (erlang/is_list which) (erlang/list_to_binary which) "")
          prov (BeamLisp.AOT/beam_provenance :"Elixir.BeamLisp.Ns.Compiler")
          live-hash (BeamLisp.AOT/ns_closure_hash "compiler")]
      ; an empty BL_EBIN would make the containment test vacuous, so require it
      (is (pos? (count ebin)))
      ; the loaded compiler beam IS the scratch image's, not the committed floor's
      (is (includes? path ebin))
      ; and it was EMITTED FROM THE CURRENT compiler.bl: its stamped source hash
      ; equals the live closure hash. The floor's beam carries the OLD source's
      ; hash, so this is exactly the assertion a stale compiler breaks.
      (is (some? prov))
      (is (some? live-hash))
      (is (= (erlang/element 1 prov) live-hash)))))

(run-tests)
