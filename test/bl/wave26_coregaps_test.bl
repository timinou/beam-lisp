; wave26_coregaps_test.bl — wave 26's small-prim backlog, in beam-lisp,
; replacing test/beam_lisp/wave26_coregaps_test.exs.
;
; The prims: transientable?, reduce-kv, rem, float?, bit-not, multi-coll map.
; Each is verified by RUNNING the vendored jank slice it unblocks (the same
; verbatim fixtures jank_compat_test checksum-guards), so a pass means upstream
; core.jank code executes, not that a beam-lisp reimplementation agrees with
; itself. mod (80), bit-not (78), double? (85) and take-nth (88) are slice-local
; defs; into (99), mapv (101), splitv-at (117), update-vals (118) and
; update-keys (119) resolve the prims — transientable?, reduce-kv, rem, float?,
; multi-coll map — from core. The sha256 guard locks the "no local edits" claim
; for the seven slices that were recorded FAILs in docs/jank-compat.md (all nine
; are checked; the guard is over every loaded fixture).
;
; PARITY MAPPING — one `deftest` per ExUnit `test`, same order; each `assert`
; becomes one `is`, so the assertion count is unchanged (54 across 13 deftests).
; The ExUnit `describe` groups are named in each deftest comment:
;
;   [no describe] "the seven recorded-FAIL slices are byte-for-byte upstream"
;                                              → recorded-fail-slices-are-byte-for-byte-upstream
;   describe "slice-local defs (mod, bit-not, double?, take-nth)"
;     "bit-not complements a two's-complement integer (slice 78)"
;                                              → bit-not-complements-a-twos-complement-integer
;     "mod differs from rem on negative operands (slice 80)"
;                                              → mod-differs-from-rem-on-negative-operands
;     "double? derives from float? (slice 85)"  → double-q-derives-from-float-q
;     "take-nth transducer 1-arity drives a transduce (slice 88)"
;                                              → take-nth-transducer-drives-a-transduce
;   describe "core-prim slices (into, mapv, splitv-at, update-vals, update-keys)"
;     "into respects transientable? and takes an xform (slice 99)"
;                                              → into-respects-transientable-and-takes-an-xform
;     "mapv maps across multiple colls via core's multi-coll map (slice 101)"
;                                              → mapv-maps-across-multiple-colls
;     "splitv-at uses (into [] (take n) coll) (slice 117)"
;                                              → splitv-at-uses-into-take
;     "update-vals folds with reduce-kv over a transient map (slice 118)"
;                                              → update-vals-folds-with-reduce-kv
;     "update-keys folds keys with reduce-kv (slice 119)"
;                                              → update-keys-folds-keys-with-reduce-kv
;   describe "the core prims themselves, cross-checked against slices"
;     "transientable? answers honestly for every beam-lisp collection type"
;                                              → transientable-answers-honestly
;     "reduce-kv runs over maps and vectors (indices as keys)"
;                                              → reduce-kv-runs-over-maps-and-vectors
;     "multi-coll map stops at the shortest input"
;                                              → multi-coll-map-stops-at-the-shortest-input
;
; ADAPTATIONS. The ExUnit `setup BeamLisp.init()` has no port: a BL test file
; already runs inside the initialized runtime. `fixture_code` strips `;` comment
; lines and joins with "\n" exactly as the ExUnit helper did, so the sha256 of
; the stripped text is byte-identical. `load_slice`/`eval_in` reproduce the
; ExUnit pair with the same `BeamLisp.Compiler/eval_string` + `new_env`. Elixir
; literals map to BL literals: `[a b]` is the vector (no `BeamLisp.Vector/new`
; needed), `%{a: 2}` is `{:a 2}`, `%{"a" => 1}` is `{"a" 1}`, and the escaped
; `\#{}` of the ExUnit string is the set literal `#{}` here. Structural `=`
; unifies the sequential family, so a list-typed expectation crosses unchanged.
;
; Run: bin/bl test test/bl/wave26_coregaps_test.bl

(ns wave26.coregaps-test)

; {fixture-basename, slice-ns, sha256-of-comment-stripped-source}. Each slice
; loads its own copy of its fn into a throwaway ns, mirroring the jank_compat
; harness.
(def ^:private slices
  [["slice_78_bit_ops" "w26.s78"
    "a3526cc4e40a6c1e6dbc20a7c930f703f58f11077dd4a9e332d407ea23c95b63"]
   ["slice_80_mod" "w26.s80"
    "a294d54fcce083c581eb597500ef49299fbef7f70f86b2dd94ba97840f3ce890"]
   ["slice_85_double_q" "w26.s85"
    "b6351689e09567917469b8711b06f3faf5f3bada7a113fa12bc25b03729661d7"]
   ["slice_88_take_nth" "w26.s88"
    "12bd2618c253513c0dbb1912e66a60f33963265ed21f2c2b4f30cb915c081ec0"]
   ["slice_99_into" "w26.s99"
    "137470a3955d15d86263db032b01f47bf55d7997062ff93f562705d62f028bb6"]
   ["slice_101_mapv" "w26.s101"
    "1df3d96917e8d546bb67e9788981942e216f8c22ed206a32127b79bf93742c43"]
   ["slice_117_splitv_at" "w26.s117"
    "7c0414717303e587b15b81ec2277bf99aa8ec4526900f90867b448a0dc74e117"]
   ["slice_118_update_vals" "w26.s118"
    "231c6303bbda1e3d4c5733c183405c2865007fa7222cb83760df5c88c52c39a2"]
   ["slice_119_update_keys" "w26.s119"
    "9cdffcd4664abbfc73d27002538ee30ccb82f9bb46434bed4abfa6dfcf5ee496"]])

; ── helpers ─────────────────────────────────────────────────────────────────

(defn- fixture-code
  "The slice text with `;` comment lines removed and joined with newlines —
   byte-for-byte the ExUnit `fixture_code/1`."
  [name]
  (let [raw (File/read! (str "test/fixtures/jank/" name ".bl"))]
    (join "\n" (filter (fn [l] (not (starts-with? l ";")))
                       (String/split raw "\n")))))

; Load a slice into its own ns so its fn resolves from that ns + core.
(defn- load-slice [name ns-str]
  (BeamLisp.Compiler/eval_string (str "(ns " ns-str ")\n" (fixture-code name))
                                 (BeamLisp.Compiler/new_env ns-str)))

(defn- eval-in [ns-str source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env ns-str)))

; ── the fidelity guard ──────────────────────────────────────────────────────

(deftest recorded-fail-slices-are-byte-for-byte-upstream
  ; The older fixture set carried the seven `FAIL` slices from docs/jank-compat;
  ; this guard locks "no local edits" — the claim is void if any drifts.
  (doseq [[name _ns expected] slices]
    (is (= expected (sha256-hex (fixture-code name)))
        (str name " drifts from upstream core.jank — fidelity claim void"))))

; ── slice-local defs (mod, bit-not, double?, take-nth) ──────────────────────

(deftest bit-not-complements-a-twos-complement-integer
  (load-slice "slice_78_bit_ops" "w26.s78")
  (is (= -6 (eval-in "w26.s78" "(bit-not 5)")))
  (is (= 5 (eval-in "w26.s78" "(bit-not -6)")))
  (is (= -1 (eval-in "w26.s78" "(bit-not 0)"))))

(deftest mod-differs-from-rem-on-negative-operands
  (load-slice "slice_80_mod" "w26.s80")
  ; rem keeps the dividend's sign: rem(-7, 3) is -1 …
  (is (= -1 (eval-in "w26.s80" "(rem -7 3)")))
  (is (= 1 (eval-in "w26.s80" "(rem 7 -3)")))
  ; … mod keeps the divisor's sign: mod(-7, 3) is 2, not -1
  (is (= 1 (eval-in "w26.s80" "(mod 7 3)")))
  (is (= 2 (eval-in "w26.s80" "(mod -7 3)")))
  (is (= -2 (eval-in "w26.s80" "(mod 7 -3)")))
  (is (= -1 (eval-in "w26.s80" "(mod -7 -3)")))
  (is (= 0 (eval-in "w26.s80" "(mod 0 3)")))
  ; the two agree on same-sign operands — the silent-wrong-answer trap
  (is (= true (eval-in "w26.s80" "(= (mod -7 -3) (rem -7 -3))")))
  (is (= true (eval-in "w26.s80" "(not= (mod -7 3) (rem -7 3))"))))

(deftest double-q-derives-from-float-q
  (load-slice "slice_85_double_q" "w26.s85")
  (is (= true (eval-in "w26.s85" "(double? 1.5)")))
  (is (= true (eval-in "w26.s85" "(float? 2.5)")))
  (is (= false (eval-in "w26.s85" "(double? 1)")))
  (is (= false (eval-in "w26.s85" "(double? \"a\")"))))

(deftest take-nth-transducer-drives-a-transduce
  (load-slice "slice_88_take_nth" "w26.s88")
  ; the coll arity
  (is (= '(1 3) (eval-in "w26.s88" "(doall (take-nth 2 [1 2 3 4]))")))
  (is (= '(0 3 6 9) (eval-in "w26.s88" "(doall (take-nth 3 (range 10)))")))
  ; the transducer 1-arity — blocked by `rem` before wave 26
  (is (= [1 3 5]
         (eval-in "w26.s88" "(transduce (take-nth 2) conj [] [1 2 3 4 5 6])"))))

; ── core-prim slices (into, mapv, splitv-at, update-vals, update-keys) ──────

(deftest into-respects-transientable-and-takes-an-xform
  (load-slice "slice_99_into" "w26.s99")
  (is (= [1 2 3] (eval-in "w26.s99" "(into [] [1 2 3])")))
  (is (= [0 1 2 3] (eval-in "w26.s99" "(into [0] [1 2 3])")))
  ; a list target is not transientable, so it conj's (prepends)
  (is (= '(3 2 1 9) (eval-in "w26.s99" "(into '(9) [1 2 3])")))
  ; 3-arity: xform through transduce + the transient conj! path
  (is (= [1 2] (eval-in "w26.s99" "(into [] (take 2) [1 2 3 4])"))))

(deftest mapv-maps-across-multiple-colls
  (load-slice "slice_101_mapv" "w26.s101")
  ; 1-coll: the transient-reduce path
  (is (= [2 3 4] (eval-in "w26.s101" "(mapv inc [1 2 3])")))
  ; 2/3-coll: (into [] (map f …)) over core's multi-coll map
  (is (= [11 22 33] (eval-in "w26.s101" "(mapv + [1 2 3] [10 20 30])")))
  (is (= [111 222 333]
         (eval-in "w26.s101" "(mapv + [1 2 3] [10 20 30] [100 200 300])"))))

(deftest splitv-at-uses-into-take
  (load-slice "slice_117_splitv_at" "w26.s117")
  (is (= [[1 2] [3 4]] (eval-in "w26.s117" "(splitv-at 2 [1 2 3 4])")))
  ; take past the end yields an empty first half, the full rest as the second
  (is (= [[] [1 2]] (eval-in "w26.s117" "(splitv-at 0 [1 2])"))))

(deftest update-vals-folds-with-reduce-kv
  (load-slice "slice_118_update_vals" "w26.s118")
  (is (= {:a 2 :b 3} (eval-in "w26.s118" "(update-vals {:a 1 :b 2} inc)")))
  (is (= {} (eval-in "w26.s118" "(update-vals {} inc)"))))

(deftest update-keys-folds-keys-with-reduce-kv
  (load-slice "slice_119_update_keys" "w26.s119")
  (is (= {"a" 1} (eval-in "w26.s119" "(update-keys {:a 1} name)")))
  (is (= {} (eval-in "w26.s119" "(update-keys {} str)"))))

; ── the core prims themselves, cross-checked against slices ─────────────────

(deftest transientable-answers-honestly
  (load-slice "slice_99_into" "w26.s99")
  ; vectors, maps, sets get a transient view; lists, lazy seqs, scalars don't
  (is (= true (eval-in "w26.s99" "(transientable? [])")))
  (is (= true (eval-in "w26.s99" "(transientable? {})")))
  (is (= true (eval-in "w26.s99" "(transientable? #{})")))
  (is (= false (eval-in "w26.s99" "(transientable? '(1 2))")))
  (is (= false (eval-in "w26.s99" "(transientable? (range 3))")))
  (is (= false (eval-in "w26.s99" "(transientable? nil)")))
  (is (= false (eval-in "w26.s99" "(transientable? 5)"))))

(deftest reduce-kv-runs-over-maps-and-vectors
  (load-slice "slice_118_update_vals" "w26.s118")
  (is (= 80 (eval-in "w26.s118"
                     "(reduce-kv (fn [acc k v] (+ acc (* k v))) 0 {2 10 3 20})")))
  ; vector keys are indices: 0*10 + 1*20 + 2*30 = 80
  (is (= 80 (eval-in "w26.s118"
                     "(reduce-kv (fn [acc i x] (+ acc (* i x))) 0 [10 20 30])"))))

(deftest multi-coll-map-stops-at-the-shortest-input
  (load-slice "slice_101_mapv" "w26.s101")
  (is (= '(11 22) (eval-in "w26.s101" "(doall (map + [1 2 3] [10 20]))")))
  (is (= '(11 22) (eval-in "w26.s101" "(doall (map + [1 2] [10 20 30]))")))
  ; one exhausted coll ends the map; the rest are ignored
  (is (= [] (eval-in "w26.s101" "(doall (map + [1 2 3] []))"))))
