; reader_parity_test.bl — the self-hosted reader (priv/reader.bl) measured
; against the live Elixir reader (BeamLisp.Reader) as the answer key.
;
; WHY THIS EXISTS
;
; The live reader is still Elixir (lib/beam_lisp/reader.ex): every read on the
; compile path goes through BeamLisp.Reader.read_all/read_string. priv/reader.bl
; is the SELF-HOSTED reader — the "can the language read itself" proof — but it
; is not yet the live one. Deleting reader.ex requires reader.bl to reach byte
; parity with it, then swapping the call sites.
;
; This suite is the parity gate. Each test reads the SAME source with both
; readers and asserts the trees are `=`. `reader.ex` is the ground truth (its
; read_all/1 deep-unwraps source positions, which reader.bl also omits — so the
; two are directly comparable, no position noise). A GREEN test = reader.bl
; matches the answer key on that input.
;
; STATUS: reader.bl now matches reader.ex on EVERY input this suite covers —
; scalars, collections, prefixes, anon-fn literals, discards, metadata, error
; parity, AND the four features that were gaps when the suite was first written:
;   * data-reader tags   #d[…] / #d{…} / #time"…"   (incl. the string payload,
;                                                     which used to SILENTLY
;                                                     mis-read into two forms)
;   * record literals    #Name{…} / #ns/Name{…}
;   * reader conditionals #?(…) branch select + #?@(…) collection splice
;   * two subtle tree bugs: stacked #_ #_ discards, and the %& lazy-seq param
;
; What this suite deliberately does NOT test (still real gaps before reader.ex
; can be deleted): SOURCE POSITIONS (reader.bl is position-free by design;
; read_all strips them so the two are comparable here) and the ATOM-SAFETY
; guard. Those are the remaining work, tracked separately.
;
; Run:  mix beam_lisp.test test/bl/reader_parity_test.bl

(ns reader-parity.test
  (:require [reader :as r]))

; --- the answer key -----------------------------------------------------------
;
; ex reads a source string with the LIVE Elixir reader. read_all/1 is the
; bare-shape entry: it deep-unwraps {:meta …} source positions, returning the
; same position-free trees reader.bl produces, so `=` compares like with like.

; read_all_elixir, not read_all: read_all follows the reader seam and becomes
; the .bl reader once this suite interns the `reader` ns (its :require above),
; which would degrade the answer key to a self-comparison. read_all_elixir is
; pinned to the genesis Elixir reading, so the comparison stays genesis-vs-.bl.
(defn- ex [src] (BeamLisp.Reader/read_all_elixir src))

; bl reads the same source with the self-hosted reader.
(defn- bl [src] (r/read-all src))

; --- GREEN: core forms reader.bl already matches exactly ----------------------
;
; Every assertion below was confirmed by running both readers: the trees are
; structurally identical. These are the parity reader.bl has already earned.

(deftest scalars-match
  (testing "integers, floats, negatives"
    (is (= (ex "42") (bl "42")))
    (is (= (ex "3.14") (bl "3.14")))
    (is (= (ex "-7") (bl "-7"))))
  (testing "booleans and nil"
    (is (= (ex "true false nil") (bl "true false nil"))))
  (testing "strings, with escapes and unicode"
    (is (= (ex "\"hi\"") (bl "\"hi\"")))
    (is (= (ex "\"a\\nb\\tc\"") (bl "\"a\\nb\\tc\"")))
    (is (= (ex "\"\\u0041\"") (bl "\"\\u0041\""))))
  (testing "character literals — named and bare"
    (is (= (ex "\\newline") (bl "\\newline")))
    (is (= (ex "\\space") (bl "\\space")))
    (is (= (ex "\\a") (bl "\\a")))))

(deftest symbols-and-keywords-match
  (testing "a plain symbol"
    (is (= (ex "foo") (bl "foo"))))
  (testing "a keyword"
    (is (= (ex ":bar") (bl ":bar"))))
  (testing "a quoted (string-form) keyword with a space"
    (is (= (ex ":\"weird key\"") (bl ":\"weird key\"")))))

(deftest collections-match
  (testing "list"
    (is (= (ex "(a b)") (bl "(a b)"))))
  (testing "vector"
    (is (= (ex "[1 2]") (bl "[1 2]"))))
  (testing "map"
    (is (= (ex "{:a 1}") (bl "{:a 1}"))))
  (testing "set"
    (is (= (ex "#{1 2}") (bl "#{1 2}"))))
  (testing "arbitrarily nested"
    (is (= (ex "(a [b {:c 1}])") (bl "(a [b {:c 1}])")))
    (is (= (ex "{:xs [1 [2 [3]]] :ys #{:a :b}}")
           (bl "{:xs [1 [2 [3]]] :ys #{:a :b}}")))))

(deftest multiple-top-level-forms-match
  (testing "read-all returns every top-level form, in order"
    (is (= (ex "1 2 3") (bl "1 2 3")))
    (is (= (ex "(def a 1) (def b 2)") (bl "(def a 1) (def b 2)")))))

(deftest reader-prefixes-match
  (testing "quote"
    (is (= (ex "'x") (bl "'x"))))
  (testing "deref"
    (is (= (ex "@x") (bl "@x"))))
  (testing "syntax-quote with unquote and unquote-splicing"
    (is (= (ex "`(a ~b ~@c)") (bl "`(a ~b ~@c)")))))

(deftest anon-fn-literal-matches
  (testing "positional %1 %2 desugar to p1__ p2__"
    (is (= (ex "#(+ %1 %2)") (bl "#(+ %1 %2)"))))
  (testing "bare % is p1__"
    (is (= (ex "#(+ % 1)") (bl "#(+ % 1)")))))

(deftest single-discard-matches
  (testing "#_ drops exactly the next form"
    (is (= (ex "[1 #_2 3]") (bl "[1 #_2 3]")))
    (is (= (ex "(a #_b c)") (bl "(a #_b c)")))))

(deftest metadata-is-dropped-by-both
  (testing "^:kw metadata: read_all drops it, reader.bl drops it — so they match"
    (is (= (ex "^:private x") (bl "^:private x"))))
  (testing "^{map} metadata"
    (is (= (ex "^{:doc \"hi\"} y") (bl "^{:doc \"hi\"} y")))))

(deftest error-parity-unterminated
  (testing "an unterminated string raises in both readers"
    (is (thrown? (ex "\"abc")))
    (is (thrown? (bl "\"abc"))))
  (testing "an unbalanced collection raises in both readers"
    (is (thrown? (ex "(a b")))
    (is (thrown? (bl "(a b")))))

; --- FIXED (were DIVERGENT): subtle tree bugs, now matching ------------------
;
; These were the subtle bugs — reader.bl read something, but not the same thing
; reader.ex read. Both are now fixed in priv/reader.bl; the assertions stay as
; regression guards naming the original defect.

(deftest stacked-discard-match
  (testing "REGRESSION GUARD: `#_ #_` drops the NEXT TWO forms"
    ; reader.ex "[1 #_ #_ 2 3 4]" -> [1 4]   (two stacked discards eat 2 and 3)
    ; reader.bl                    -> [1 3 4] (its read-until treats one #_ as
    ;                                          consuming a plain form, not a
    ;                                          discard-of-a-discard). A stacked
    ;                                          discard is a real Clojure idiom.
    (is (= (ex "[1 #_ #_ 2 3 4]") (bl "[1 #_ #_ 2 3 4]")))))

(deftest rest-arg-fn-literal-match
  (testing "REGRESSION GUARD: #(… %&) param vector is a realized list"
    ; reader.ex -> params vector [{:symbol \"&\"} {:symbol \"rest__\"}], a plain list.
    ; reader.bl -> the vector's items are a BeamLisp.LazySeq (an unforced
    ;              `concat` thunk from desugar-fn's `(concat positional …)`),
    ;              so the node is structurally NOT `=` to the answer key even
    ;              though the forced contents match. Fix: realize the concat.
    (is (= (ex "#(apply + %&)") (bl "#(apply + %&)")))))

; --- FIXED (were UNSUPPORTED): features now ported into reader.bl -------------
;
; Data-reader tags, record literals, and reader conditionals were stubbed out
; in reader.bl (it raised "not yet ported"). All three are now implemented, so
; these are straight parity `=` assertions against the Elixir answer key.

(deftest data-reader-collection-tags-match
  (testing "#d[…] reads as (datom/read-query […]) in both readers"
    (is (= (ex "#d[:find ?x]") (bl "#d[:find ?x]"))))
  (testing "#d{…} (a map payload after the tag) also matches"
    (is (= (ex "#d{:a 1}") (bl "#d{:a 1}")))))

(deftest data-reader-string-tag-match
  (testing "#time\"…\" reads as one (datom.time/read-iso8601 \"…\") call"
    ; The formerly SUBTLE bug: reader.bl once routed a tag to the data-reader
    ; path only when followed by `[`/`{`. A tag followed by a STRING fell
    ; through to `classify`, reading `#time` as a bare symbol and the string as
    ; a SEPARATE form — a silent misread into TWO forms. Now `read-tag` accepts
    ; a string payload too, so it matches the Elixir reader.
    (is (= (ex "#time\"2026-06-15\"") (bl "#time\"2026-06-15\"")))))

(deftest record-literals-match
  (testing "#Name{…} reads into a {:record …} node in both readers"
    (is (= (ex "#Point{:x 1}") (bl "#Point{:x 1}"))))
  (testing "a namespaced record name and multiple fields match too"
    (is (= (ex "#geo/Point{:x 1 :y 2}") (bl "#geo/Point{:x 1 :y 2}")))))

(deftest reader-conditionals-match
  (testing "#?(…) selects a branch by platform feature in both readers"
    ; beam-lisp answers to :clj, not :bl, so :bl is skipped and :default wins:
    ; #?(:bl 1 :default 2) -> 2 in both readers.
    (is (= (ex "#?(:bl 1 :default 2)") (bl "#?(:bl 1 :default 2)"))))
  (testing "#?(…) selecting the :clj branch (the platform feature)"
    (is (= (ex "#?(:clj 1 :cljs 2)") (bl "#?(:clj 1 :cljs 2)"))))
  (testing "#?@ splices the selected collection into its surrounding vector"
    (is (= (ex "[1 #?@(:clj [2 3] :default []) 4]")
           (bl "[1 #?@(:clj [2 3] :default []) 4]"))))
  (testing "#?@ taking :default when the platform branch is absent"
    (is (= (ex "[1 #?@(:cljs [9] :default [2 3]) 4]")
           (bl "[1 #?@(:cljs [9] :default [2 3]) 4]")))))
