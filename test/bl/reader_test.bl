; test/bl/reader_test.bl — the reader's core surface, ported from
; test/beam_lisp/reader_test.exs.
;
; The reader is where source text becomes data, so every case here is a
; contract about a SHAPE: what string/collection/symbol/keyword a given source
; reads to, and which source must be REFUSED rather than silently misread. Two
; of the cases are named regressions that shipped once and must not ship again:
;
;   * BUG-004 — a `:"..."` quoted keyword used to terminate at the `"`
;     delimiter, so `:"a b"` read as TWO forms (empty keyword + string) instead
;     of one keyword whose name is `a b`.
;   * BUG-020 — `\uXXXX` used to drop its backslash and keep the letter, so
;     `"\u2713"` read as the four characters `u2713`, silently, and only ever
;     looked wrong where the string was displayed. A malformed escape is now a
;     READ ERROR, because accepting the syntax and corrupting the value is
;     worse than refusing it.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 15 ExUnit cases map one-to-one onto a same-named BL deftest, in the
; original order (the six `describe "unicode escapes"` cases keep their order):
;   literals → literals
;   symbols and keywords → symbols-and-keywords
;   quoted keyword literals (BUG-004) → quoted-keyword-literals-bug-004
;   collections → collections
;   nesting → nesting
;   quote sugar → quote-sugar
;   comments and commas are whitespace → comments-and-commas-are-whitespace
;   multiple forms → multiple-forms
;   syntax errors → syntax-errors
;   four-digit escapes decode to one character → four-digit-escapes-decode-to-one-character
;   braced escapes reach above the BMP → braced-escapes-reach-above-the-bmp
;   escapes compose with surrounding text → escapes-compose-with-surrounding-text
;   the other escapes still work → the-other-escapes-still-work
;   a malformed escape is an ERROR, not a mangled string → a-malformed-escape-is-an-error-not-a-mangled-string
;   a surrogate half is rejected → a-surrogate-half-is-rejected
;
; Adaptations, and why:
;   * `use ExUnit.Case, async: true` has no ward equivalent: `bl test` already
;     runs each FILE in its own isolated fork, and the tests inside one file run
;     in order in that one env, so nothing is raced.
;   * The alias `BeamLisp.Reader` / `BeamLisp.Reader.SyntaxError` becomes direct
;     `BeamLisp.Reader/…` calls and a typed `catch BeamLisp.Reader.SyntaxError`,
;     which is exactly what `assert_raise SyntaxError` asserted (the reader's
;     boundary renders its diagnostic as that struct, so the type IS the
;     contract).
;   * Reader nodes are Erlang TUPLES whose children are Erlang LISTS: a list
;     node is `(tuple :list (list …))`, a map node is
;     `(tuple :map (list (tuple k v) …))`. `(:symbol "x")` in Elixir is
;     `(tuple :symbol "x")` here — the reader produces the tuple, and BL has no
;     literal Erlang tuple.
;   * Source text that must carry a BACKSLASH is written as a `#|…|` raw string
;     (no escapes at all), so `#|"\u2713"|` is byte-for-byte the seven
;     characters the ExUnit `~S` sigil produced and never a decoded `✓`.
;   * `String.length/1` is `count`.
;
; Run: bin/bl test test/bl/reader_test.bl

(ns reader.test)

(defn- read-one [src] (BeamLisp.Reader/read_one src))
(defn- read-all [src] (BeamLisp.Reader/read_all src))
(defn- read-string
  "The forms `src` reads to, named as the original's `Reader.read_string/1`
   (whose file argument defaults through `read_string/1`)."
  [src]
  (BeamLisp.Reader/read_string src "reader_test.bl"))

(defn- syntax-error?
  "True only when `f` raises the reader's own `SyntaxError`. Any OTHER raise
   propagates, exactly as `assert_raise SyntaxError` re-raised a mismatch."
  [f]
  (try
    (do (f) false)
    (catch BeamLisp.Reader.SyntaxError _e true)))

; ── leaves and containers ──────────────────────────────────────────────────

(deftest literals
  (is (= 42 (read-one "42")))
  (is (= -7 (read-one "-7")))
  (is (= 2.5 (read-one "2.5")))
  (is (= 1000.0 (read-one "1e3")))
  (is (= "hello" (read-one #|"hello"|)))
  (is (= "a\nb" (read-one #|"a\nb"|)))
  (is (= nil (read-one "nil")))
  (is (= true (read-one "true")))
  (is (= false (read-one "false"))))

(deftest symbols-and-keywords
  (is (= (tuple :symbol "foo") (read-one "foo")))
  (is (= (tuple :symbol "IO/puts") (read-one "IO/puts")))
  (is (= (tuple :symbol "+") (read-one "+")))
  (is (= (tuple :symbol "not=") (read-one "not=")))
  (is (= (tuple :keyword "ok") (read-one ":ok"))))

(deftest quoted-keyword-literals-bug-004
  ; A `:"..."` name may hold chars no bare symbol can. Before the fix the
  ; `:` terminated at the `"` and the input read as TWO forms — the empty
  ; keyword then a string.
  (is (= (tuple :keyword "a b") (read-one #|:"a b"|)))
  (is (= (tuple :keyword "$end_of_table") (read-one #|:"$end_of_table"|)))
  (is (= (tuple :keyword "Elixir.ReqLLM.Response")
         (read-one #|:"Elixir.ReqLLM.Response"|)))

  ; The precise regression: ONE form out, not two.
  (is (= 1 (count (read-string #|:"a b"|))))

  ; Escapes behave as in a normal string (shared string/3).
  (is (= (tuple :keyword (str "tab" "\t" "here"))
         (read-one (str ":\"tab" "\t" "here\""))))

  ; A quoted keyword is a map key like any other.
  (is (= (tuple :map (list (tuple (tuple :keyword "weird key") 1)))
         (read-one #|{:"weird key" 1}|))))

(deftest collections
  (is (= (tuple :list (list (tuple :symbol "+") 1 2)) (read-one "(+ 1 2)")))
  (is (= (tuple :vector (list 1 2 3)) (read-one "[1 2 3]")))
  (is (= (tuple :vector (list)) (read-one "[]")))
  (is (= (tuple :list (list)) (read-one "()")))
  (is (= (tuple :map (list (tuple (tuple :keyword "a") 1)
                           (tuple (tuple :keyword "b") 2)))
         (read-one "{:a 1 :b 2}"))))

(deftest nesting
  (is (= (tuple :list
                (list (tuple :symbol "f")
                      (tuple :vector (list 1 (tuple :list (list (tuple :symbol "g") 2))))
                      (tuple :map (list (tuple (tuple :keyword "k") 3)))))
         (read-one "(f [1 (g 2)] {:k 3})"))))

(deftest quote-sugar
  (is (= (tuple :list (list (tuple :symbol "quote") (tuple :symbol "foo")))
         (read-one "'foo")))
  (is (= (tuple :list (list (tuple :symbol "quote")
                            (tuple :list (list (tuple :symbol "a")
                                               (tuple :symbol "b")))))
         (read-one "'(a b)"))))

(deftest comments-and-commas-are-whitespace
  (is (= (list (tuple :list (list (tuple :symbol "+") 1 2)))
         (read-all (str "; nothing here" "\n" "(+ 1, 2) ; trailing")))))

(deftest multiple-forms
  (is (= (list (tuple :list (list (tuple :symbol "def") (tuple :symbol "x") 1))
               (tuple :list (list (tuple :symbol "+") (tuple :symbol "x") 2)))
         (read-all "(def x 1) (+ x 2)"))))

(deftest syntax-errors
  (is (syntax-error? (fn [] (read-one "(+ 1"))))
  (is (syntax-error? (fn [] (read-one ")"))))
  (is (syntax-error? (fn [] (read-one "{:a}"))))
  (is (syntax-error? (fn [] (read-one #|"open|)))))

; ── unicode escapes (BUG-020) ──────────────────────────────────────────────

(deftest four-digit-escapes-decode-to-one-character
  (is (= "\u2713" (read-one #|"\u2713"|)))
  (is (= "\u00e9" (read-one #|"\u00e9"|)))
  (is (= 1 (count (read-one #|"\u2713"|)))))

(deftest braced-escapes-reach-above-the-bmp
  ; Elixir's spelling, and the only way to write a codepoint past 0xFFFF
  ; without surrogate pairs.
  (is (= "\u{1D11E}" (read-one #|"\u{1D11E}"|)))
  (is (= "A" (read-one #|"\u{41}"|))))

(deftest escapes-compose-with-surrounding-text
  (is (= "a\u2713b" (read-one #|"a\u2713b"|)))
  (is (= "\u2713\u2713" (read-one #|"\u2713\u2713"|))))

(deftest the-other-escapes-still-work
  (is (= "a\nb" (read-one #|"a\nb"|)))
  (is (= "a\tb" (read-one #|"a\tb"|)))
  (is (= 3 (count (read-one #|"a\\b"|)))))

(deftest a-malformed-escape-is-an-error-not-a-mangled-string
  ; The whole point: accepting the syntax and corrupting it is worse than
  ; rejecting it, because the syntax looks supported. Raised, not returned:
  ; the reader's contract is that a syntax error stops the read rather than
  ; producing a value the caller has to inspect.
  (is (syntax-error? (fn [] (read-all #|"\u27"|))))
  (is (syntax-error? (fn [] (read-all #|"\uZZZZ"|))))
  (is (syntax-error? (fn [] (read-all #|"\u{}"|)))))

(deftest a-surrogate-half-is-rejected
  ; Not a codepoint. Encoding one yields invalid UTF-8 that fails much later,
  ; at whatever tries to print it.
  (is (syntax-error? (fn [] (read-all #|"\uD800"|)))))
