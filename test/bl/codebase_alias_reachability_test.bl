; codebase_alias_reachability_test.bl — a call across a namespace border joins
; the DEFINITION it names, and never claims more than the header can prove.
;
; The codebase index records a callee as the author SPELLED it (`data/format-row`),
; so a cross-namespace call names a string no source ever writes as a caller and
; the bare call graph stops at the border. `index-source` now also emits the
; namespace-qualified identity (`:fn/qualified`, `:call/caller-qualified`,
; `:call/callee-qualified`) resolved from the source's OWN `:require`/`:as`/
; `:refer` header, and `dependency-cone` walks it back with the resolution status
; of EVERY edge. These tests pin the two properties the eventual placement gate
; depends on: a resolvable border edge CHAINS into the callee's own calls, and an
; unresolvable one stays explicit evidence rather than vanishing into a false
; "complete" cone.
;
; Run: bl test test/bl/codebase_alias_reachability_test.bl
(ns codebase.alias-reachability.test
  (:require [codebase :as cb] [datom]))

(defn- db-with
  "A multi-source corpus db. Bands each source's entity ids by position — the
   same rule as code.index/band-of — because index-source numbers facts from a
   per-source base and a corpus joins them into one conn."
  [sources]
  (let [conn (cb/connect-codebase)
        shift (fn [i fs] (mapv (fn [f] (assoc f :db/id (+ (:db/id f) (* i 1000000)))) fs))]
    (doseq [[i [ns src]] (map-indexed (fn [i p] [i p]) sources)]
      (let [facts (cb/index-source {} ns src)]
        (datom/transact! conn (concat (shift i (:fn facts))
                                      (shift i (:calls facts))
                                      (shift i (:instr facts))
                                      (shift i (:requires facts))))))
    (datom/db conn)))

(defn- calls
  "Every call fact as a map, `:callee-qualified` present only when the indexer
   could name the target. `:call/caller` is the raw spelling; the qualified
   caller is read too, so a test can assert the identity that crosses the edge."
  [db]
  (let [rows (datom/q '[:find ?e ?caller ?callee ?line
                        :where [?e :call/caller ?caller]
                               [?e :call/callee ?callee]
                               [?e :call/line ?line]] db)
        cqs (reduce (fn [m r] (assoc m (get r 0) (get r 1)))
                    {} (datom/q '[:find ?e ?q :where [?e :call/callee-qualified ?q]] db))
        cqf (reduce (fn [m r] (assoc m (get r 0) (get r 1)))
                    {} (datom/q '[:find ?e ?q :where [?e :call/caller-qualified ?q]] db))]
    (mapv (fn [r]
            (let [e (get r 0)]
              {:caller (get r 1) :callee (get r 2) :line (get r 3)
               :caller-qualified (get cqf e)
               :callee-qualified (get cqs e)}))
          rows)))

(defn- call-of [db caller callee]
  (first (filter (fn [c] (and (= caller (:caller c)) (= callee (:callee c))))
                 (calls db))))

(defn- status-of [cone caller callee]
  (first (filter (fn [c] (and (= caller (:caller c)) (= callee (:callee c))))
                 (:calls cone))))

;; The two namespaces every test below starts from: `app.view` aliases `lib.data`
;; as `data` and calls across the border; `lib.data` calls its OWN fn, so a
;; correct cone must continue past the border, not stop at it.
(def view-src "(ns app.view (:require [lib.data :as data]))\n(defn render [x] (data/format-row x))\n")
(def data-src "(ns lib.data)\n(defn format-row [y] (label y))\n(defn label [z] z)\n")

;; ── 1. the border edge resolves to the DEFINITION it names ──────────

(deftest an-aliased-call-joins-the-definition-it-names
  (let [db (db-with {"app.view" view-src "lib.data" data-src})
        c (call-of db "render" "data/format-row")]
    (is (= "data/format-row" (:callee c))
        "the head is preserved AS WRITTEN — system.arity resolves that spelling")
    (is (= "lib.data/format-row" (:callee-qualified c))
        "and the canonical target is the fully-qualified defined entity")
    (is (= "app.view/render" (:caller-qualified c))
        "the caller is named in the same qualified space")
    (is (contains? (into #{} (map (fn [r] (get r 0)))
                           (datom/q '[:find ?q :where [?d :fn/qualified ?q]] db))
                   "lib.data/format-row")
        "which is the identity :fn/qualified mints for the definition")))

(deftest a-border-edge-chains-into-the-callees-own-calls
  (let [db (db-with {"app.view" view-src "lib.data" data-src})]
    (is (= ["lib.data/format-row" "lib.data/label"]
           (vec (cb/reachable-qualified db "app.view/render")))
        "render reaches format-row ACROSS the border and label past it — the
         bare graph stopped at format-row because no source calls it by name")))

;; ── 2. a fully resolved cone is COMPLETE ─────────────────────────────

(deftest a-fully-resolved-cone-is-complete
  (let [db (db-with {"app.view" view-src "lib.data" data-src})
        cone (cb/dependency-cone db "app.view/render")]
    (is (= true (:complete cone)))
    (is (= ["app.view/render" "lib.data/format-row" "lib.data/label"]
           (vec (:reached cone)))
        "the cone includes the root and both definitions")
    (is (every? (fn [c] (= :defined (:status c))) (:calls cone))
        "every edge resolved to an indexed definition")))

;; ── 3. a canonical target with no definition is EXPLICIT evidence ────

(deftest an-aliased-call-to-an-undefined-name-is-not-a-false-positive
  (let [db (db-with {"app.view" "(ns app.view (:require [lib.data :as data]))\n(defn render [x] (data/missing x))\n"
                     "lib.data" data-src})
        c (call-of db "render" "data/missing")
        cone (cb/dependency-cone db "app.view/render")
        row (status-of cone "app.view/render" "data/missing")]
    (is (= "lib.data/missing" (:callee-qualified c))
        "the target is canonicalized — the alias resolves, the NAME does not")
    (is (= :undefined (:status row))
        "so the edge is reported :undefined, never mistaken for a resolved call")
    (is (= false (:complete cone))
        "and the cone refuses to claim completeness")
    (is (some? row) "the unknown call is EVIDENCE in the cone, not dropped")))

;; ── 4. a prefix the header does not name stays UNRESOLVED ────────────

(deftest an-unknown-qualified-prefix-is-not-claimed
  (let [db (db-with {"app.view" "(ns app.view (:require [lib.data :as data]))\n(defn render [x] (ghost/thing x) (data/format-row x))\n"
                     "lib.data" data-src})
        ghost (call-of db "render" "ghost/thing")
        cone (cb/dependency-cone db "app.view/render")]
    (is (nil? (:callee-qualified ghost))
        "a prefix that is neither a require nor an alias is not attributed")
    (is (= :unresolved (:status (status-of cone "app.view/render" "ghost/thing")))
        "it is explicit unresolved evidence — interop, an unrequired ns, or a
         dynamic call; guessing would invent a definition")
    (is (= false (:complete cone)))))

;; ── 5. a `:refer`red name resolves only when NOT shadowed ────────────

(deftest a-referred-name-resolves-but-a-shadowed-one-does-not
  (let [db (db-with {"app.view" (str "(ns app.view (:require [lib.data :refer [format-row]]))\n"
                                     "(defn render [x] (format-row x))\n"
                                     "(defn apply-row [x] (let [format-row (fn [y] y)] (format-row x)))\n")
                     "lib.data" data-src})
        resolved (call-of db "render" "format-row")
        shadowed (call-of db "apply-row" "format-row")]
    (is (= "lib.data/format-row" (:callee-qualified resolved))
        "a :refer`red name resolves to the namespace it came from")
    (is (nil? (:callee-qualified shadowed))
        "the SAME spelling under a `let` binding is dynamic — left unattributed")
    (is (= :unresolved (:status (status-of (cb/dependency-cone db "app.view/apply-row")
                                           "app.view/apply-row" "format-row")))
        "and the cone carries it as unresolved evidence")))

;; ── 6. `:refer :all` attributes nothing (no name-level resolution) ───

(deftest refer-all-stays-opaque
  (let [db (db-with {"app.view" "(ns app.view (:require [lib.data :refer :all]))\n(defn render [x] (format-row x))\n"
                     "lib.data" data-src})
        c (call-of db "render" "format-row")
        cone (cb/dependency-cone db "app.view/render")]
    (is (nil? (:callee-qualified c))
        "a :refer :all import cannot be attributed to one namespace per name")
    (is (= :unresolved (:status (status-of cone "app.view/render" "format-row"))))
    (is (= ["app.view/render"] (vec (:reached cone)))
        "the cone is the root alone — no definition is invented for the bare name")))

;; ── 7. a name the corpus does not define (a core fn) is EVIDENCE too ─

(deftest a-core-call-is-not-assumed-defined
  (let [db (db-with {"app.view" "(ns app.view)\n(defn render [x] (str x))\n"})
        cone (cb/dependency-cone db "app.view/render")
        row (first (:calls cone))]
    (is (nil? (:callee-qualified row))
        "a bare core name has no corpus definition to point at")
    (is (= :unresolved (:status row)))
    (is (= false (:complete cone))
        "so a cone that calls core is not claimed complete — the placement gate
         must consult its own host/ABI knowledge, not the corpus alone")))

;; ── 8. a method parameter shadowing a `:refer` is dynamic too ────────

(deftest a-method-parameter-does-not-become-a-static-edge
  (let [db (db-with {"app.view" (str "(ns app.view (:require [lib.data :refer [format-row]]))\n"
                                     "(defn render [x] (format-row x))\n"
                                     "(extend-type Thing P (m [format-row] (format-row 1)))\n")
                     "lib.data" data-src})
        static (call-of db "render" "format-row")
        dynamic (call-of db "<top>" "format-row")]
    (is (= "lib.data/format-row" (:callee-qualified static))
        "an unshadowed `:refer` in a defn still resolves")
    (is (nil? (:callee-qualified dynamic))
        "a method parameter named like the `:refer` binds it — the call is
         dynamic, never a static edge to lib.data")))


;; ── 9. a computed call head is still an application ──────────────────

(deftest computed-head-application-is-unresolved
  (let [db (db-with {"demo" "(ns demo)\n(defn root [f] ((if true f f)))\n"})
        cone (cb/dependency-cone db "demo/root")]
    (is (= true (:root-defined cone)))
    (is (= false (:complete cone)))
    (is (some? (first (filter (fn [c] (and (= "<dynamic>" (:callee c))
                                            (= :unresolved (:status c))))
                              (:calls cone))))
        "the computed-head invocation cannot disappear from the cone")))

(deftest receive-pattern-shadows-a-defined-function
  (let [db (db-with {"demo" "(ns demo)\n(defn hook [] \"safe\")\n(defn root [] (receive hook (hook)))\n"})
        cone (cb/dependency-cone db "demo/root")
        row (status-of cone "demo/root" "hook")]
    (is (= false (:complete cone)))
    (is (= :unresolved (:status row)))
    (is (nil? (:callee-qualified row))
        "the hook pattern binds a local callable, not demo/hook")))

(deftest missing-root-cannot-have-a-complete-cone
  (let [db (db-with {"demo" "(ns demo)\n(def root (fn [] (File/read! \"/tmp/secret\")))\n"})
        cone (cb/dependency-cone db "demo/root")]
    (is (= false (:root-defined cone)))
    (is (= false (:complete cone))
        "def/fn is not an indexed defn and its body cannot be certified"))
  (let [db (db-with {"demo" "(ns demo)\n(defn good [] \"safe\")\n"})]
    (is (= true (:complete (cb/dependency-cone db "demo/good")))
        "a genuinely call-free defn remains complete")))

(deftest keyword-lookup-is-not-a-dynamic-call
  (let [db (db-with {"demo" "(ns demo)\n(defn helper [x] x)\n(defn root [m] (:done (helper m)))\n"})
        cone (cb/dependency-cone db "demo/root")]
    (is (= true (:complete cone))
        "(:k m) reads a literal key; it has no call target to leave unresolved")
    (is (= #{"demo/root" "demo/helper"} (set (:reached cone)))
        "the call INSIDE the lookup's argument is still an edge"))
  (let [db (db-with {"demo" "(ns demo)\n(defn root [m k] ((get m k) 1))\n"})
        cone (cb/dependency-cone db "demo/root")]
    (is (= false (:complete cone))
        "a computed head is still dynamic after the keyword exemption")))
