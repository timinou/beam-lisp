; build_test.bl — the build driver's contract, pinned.
;
; build.bl IS the build: `mix compile.beam_lisp` and `bl build` are shells
; over `build/run`. These tests run it on a throwaway tree with the shared
; cache OFF (so every "built" is a real compile) and pin what the driver
; promises:
;
;   a fresh tree builds everything, in one call, and writes a manifest
;   a second run is a no-op                 nothing to do, nothing rewritten
;   a body edit rebuilds ONE source         dependents are keyed on interface
;   an interface edit rebuilds the closure  the requirer follows
;   a literate document is a source         its cells are the program
;   a broken source is an ERROR, not a crash — the rest still builds
;   a deleted source loses its beams        stale modules are swept
;   a poisoned manifest is ignored          it is on-disk input, never trusted
;   the log is the memory                   the manifest is its projection
;   clean removes what the log names        and both files
(ns build.test
  (:require [build :as b] [build-log :as blog]))

(def root (str (System/tmp_dir!) "/bl_build_test_" (erlang/unique_integer (list :positive))))
(def out (str root "/ebin"))
(def manifest (str out "/compile.beam_lisp"))

(defn- src [name text]
  (let [p (str root "/" name)]
    (File/write! p text)
    p))

(defn- fresh-tree! []
  (File/rm_rf! root)
  (File/mkdir_p! root)
  [(src "a.bl" "(ns a)\n(defn f [x] (+ x 1))\n")
   (src "b.bl" "(ns b (:require [a]))\n(defn g [x] (a/f x))\n")
   (src "c.bl.md" "# c\n\n```beam-lisp\n(ns c (:require [b]))\n(defn h [x] (b/g x))\n```\n")])

(defn- run [sources]
  (System/put_env "BEAM_LISP_AOT_CACHE" "off")
  (b/run {:sources sources :out out :manifest manifest :jobs 2}))

(defn- beams [] (sort (filter (fn [f] (ends-with? f ".beam")) (File/ls! out))))

(deftest fresh-tree-then-no-op
  (let [srcs (fresh-tree!)
        r1 (run srcs)
        r2 (run srcs)]
    (is (= 3 (:built r1)))
    (is (= [] (:errors r1)))
    (is (= 3 (count (b/read-manifest manifest))))
    (is (every? (fn [e] (vector? (:modules e))) (vals (b/read-manifest manifest))))
    (is (= 0 (:built r2)))
    (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.C.beam"))))

(deftest body-edit-rebuilds-one
  (let [srcs (fresh-tree!)]
    (run srcs)
    (src "a.bl" "(ns a)\n(defn f [x] (+ x 2))\n")
    (is (= 1 (:built (run srcs))))))

(deftest interface-edit-rebuilds-closure
  (let [srcs (fresh-tree!)]
    (run srcs)
    (src "a.bl" "(ns a)\n(defn f [x] (+ x 1))\n(defn f2 [] 1)\n")
    ; a's interface is in the key of EVERY namespace whose closure holds a:
    ; b directly, c through b (a linked call from c may reach a's shims via
    ; b's macros). The whole closure follows; a body edit (above) does not.
    (is (= 3 (:built (run srcs))))))

(deftest broken-source-is-an-error-not-a-crash
  (let [srcs (fresh-tree!)]
    (src "b.bl" "(ns b (:require [a]))\n(defn g [x] (a/f x)\n")
    (let [r (run srcs)]
      ; b: the reader's error. c: its require of b fails. Both REPORTED;
      ; a, which needs neither, still builds.
      (is (= 2 (count (:errors r))))
      (is (includes? (first (:errors r)) "b.bl"))
      (is (= 1 (:built r)))
      (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.A.beam")))))

(deftest deleted-source-sweeps-its-beams
  (let [srcs (fresh-tree!)]
    (run srcs)
    (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.C.beam"))
    (run (vec (take 2 srcs)))
    (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.C.beam")))
    (is (= 2 (count (b/read-manifest manifest))))))

(deftest a-poisoned-manifest-costs-nothing
  (let [srcs (fresh-tree!)]
    (run srcs)
    (File/write! manifest "not a term")
    (is (= {} (b/read-manifest manifest)))
    ; The manifest is a PROJECTION, so a corrupt one costs nothing: the log is
    ; the memory, the beams are on disk, and the run REPAIRS the manifest
    ; instead of rebuilding the world. Before the log this case rebuilt all
    ; three sources — correct, but only because the memory had been destroyed.
    (is (= 0 (:built (run srcs))))
    (is (= 3 (count (b/read-manifest manifest))))
    ; A malformed ENTRY is dropped too: a lazy seq in :modules is not a
    ; well-formed entry, so the manifest reads as empty rather than trusting it.
    (File/write! manifest (erlang/term_to_binary {(first srcs) {:hash "h" :key "k" :modules (map identity [:A])}}))
    (is (= {} (b/read-manifest manifest)))))

(deftest the-log-is-the-memory
  (let [srcs (fresh-tree!)
        log (blog/path-for manifest)]
    (run srcs)
    ; One fact per source, as TEXT the language can read back — and the manifest
    ; on disk is exactly those facts' projection.
    (is (File/exists? log))
    (is (includes? (File/read! log) "[:build/built "))
    (let [facts (blog/read-facts log)
          state (blog/replay facts)]
      (is (= 3 (count (:sources state))))
      (is (= (b/read-manifest manifest) (blog/manifest state))))

    ; Remove the manifest: the build does not forget, because it never
    ; remembered anything there. This is what makes an interrupted build
    ; resumable — a single rewritten document cannot do it.
    (File/rm manifest)
    (is (= 0 (:built (run srcs))))
    (is (= 3 (count (b/read-manifest manifest))))))

(deftest clean-removes-the-log-too
  (let [srcs (fresh-tree!)
        log (blog/path-for manifest)]
    (run srcs)
    (is (File/exists? log))
    (b/clean out manifest)
    (is (not (File/exists? manifest)))
    ; A clean that removed the manifest but left the log would leave a log
    ; claiming beams that no longer exist.
    (is (not (File/exists? log)))
    (is (= [] (beams)))))
