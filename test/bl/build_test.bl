; build_test.bl — the build driver's contract, pinned.
;
; build.bl IS the build: `mix compile.beam_lisp` and `bl build` are shells
; over `build/run`. These tests run it on a throwaway tree with the shared
; cache OFF (so every "built" is a real compile) and pin what the driver
; promises:
;
;   a fresh tree builds everything, in one call, and writes a manifest
;   a second run is a no-op                 nothing to do, nothing rewritten
;   a body edit rebuilds ONE source         dependents are keyed on interface
;   an interface edit rebuilds the closure  the requirer follows
;   a literate document is a source         its cells are the program
;   a broken source is an ERROR, not a crash — the rest still builds
;   a deleted source loses its beams        stale modules are swept
;   a poisoned manifest is ignored          it is on-disk input, never trusted
;   the log is the memory                   the manifest is its projection
;   clean removes what the log names        and both files
;   an EXCLUDED source never evaluates      entry programs emit no beam (FUP-015)
(ns build.test
  (:require [build :as b] [build-log :as blog]))

(def root (str (System/tmp_dir!) "/bl_build_test_" (erlang/unique_integer (list :positive))))
(def out (str root "/ebin"))
(def manifest (str out "/compile.beam_lisp"))
(def ex-root (str root "/elixir"))

(defn- src [name text]
  (let [p (str root "/" name)]
    (File/write! p text)
    p))

(defn- fresh-tree! []
  (File/rm_rf! root)
  (File/mkdir_p! root)
  [(src "a.bl" "(ns a)\n(defn f [x] (+ x 1))\n")
   (src "b.bl" "(ns b (:require [a]))\n(defn g [x] (a/f x))\n")
   (src "c.bl.md" "# c\n\n```beam-lisp\n(ns c (:require [b]))\n(defn h [x] (b/g x))\n```\n")])

(defn- run* [opts]
  (let [previous (System/get_env "BEAM_LISP_AOT_CACHE")]
    (try
      (System/put_env "BEAM_LISP_AOT_CACHE" "off")
      (b/run (merge {:out out :manifest manifest :jobs 2} opts))
      (finally
        (if (nil? previous)
          (System/delete_env "BEAM_LISP_AOT_CACHE")
          (System/put_env "BEAM_LISP_AOT_CACHE" previous))))))

(defn- run [sources] (run* {:sources sources}))

(defn- beams [] (sort (filter (fn [f] (ends-with? f ".beam")) (File/ls! out))))

(deftest fresh-tree-then-no-op
  (let [srcs (fresh-tree!)
        r1 (run srcs)
        r2 (run srcs)]
    (is (= 3 (:built r1)))
    (is (= [] (:errors r1)))
    (is (= 3 (count (b/read-manifest manifest))))
    (is (every? (fn [e] (vector? (:modules e))) (vals (b/read-manifest manifest))))
    (is (= 0 (:built r2)))
    (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.C.beam"))))

(deftest body-edit-rebuilds-one
  (let [srcs (fresh-tree!)]
    (run srcs)
    (src "a.bl" "(ns a)\n(defn f [x] (+ x 2))\n")
    (is (= 1 (:built (run srcs))))))

(deftest interface-edit-rebuilds-closure
  (let [srcs (fresh-tree!)]
    (run srcs)
    (src "a.bl" "(ns a)\n(defn f [x] (+ x 1))\n(defn f2 [] 1)\n")
    ; a's interface is in the key of EVERY namespace whose closure holds a:
    ; b directly, c through b (a linked call from c may reach a's shims via
    ; b's macros). The whole closure follows; a body edit (above) does not.
    (is (= 3 (:built (run srcs))))))

(deftest broken-source-is-an-error-not-a-crash
  (let [srcs (fresh-tree!)]
    (src "b.bl" "(ns b (:require [a]))\n(defn g [x] (a/f x)\n")
    (let [r (run srcs)]
      ; b: the reader's error. c: its require of b fails. Both REPORTED;
      ; a, which needs neither, still builds.
      (is (= 2 (count (:errors r))))
      (is (includes? (first (:errors r)) "b.bl"))
      (is (= 1 (:built r)))
      (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.A.beam")))))

(deftest deleted-source-sweeps-its-beams
  (let [srcs (fresh-tree!)]
    (run srcs)
    (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.C.beam"))
    (run (vec (take 2 srcs)))
    (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.C.beam")))
    (is (= 2 (count (b/read-manifest manifest))))))

(deftest a-poisoned-manifest-costs-nothing
  (let [srcs (fresh-tree!)]
    (run srcs)
    (File/write! manifest "not a term")
    (is (= {} (b/read-manifest manifest)))
    ; The manifest is a PROJECTION, so a corrupt one costs nothing: the log is
    ; the memory, the beams are on disk, and the run REPAIRS the manifest
    ; instead of rebuilding the world. Before the log this case rebuilt all
    ; three sources — correct, but only because the memory had been destroyed.
    (is (= 0 (:built (run srcs))))
    (is (= 3 (count (b/read-manifest manifest))))
    ; A malformed ENTRY is dropped too: a lazy seq in :modules is not a
    ; well-formed entry, so the manifest reads as empty rather than trusting it.
    (File/write! manifest (erlang/term_to_binary {(first srcs) {:hash "h" :key "k" :modules (map identity [:A])}}))
    (is (= {} (b/read-manifest manifest)))))

(deftest the-log-is-the-memory
  (let [srcs (fresh-tree!)
        log (blog/path-for manifest)]
    (run srcs)
    ; One fact per source, as TEXT the language can read back — and the manifest
    ; on disk is exactly those facts' projection.
    (is (File/exists? log))
    (is (includes? (File/read! log) "[:build/built "))
    (let [facts (blog/read-facts log)
          state (blog/replay facts)]
      (is (= 3 (count (:sources state))))
      (is (= (b/read-manifest manifest) (blog/manifest state))))

    ; Remove the manifest: the build does not forget, because it never
    ; remembered anything there. This is what makes an interrupted build
    ; resumable — a single rewritten document cannot do it.
    (File/rm manifest)
    (is (= 0 (:built (run srcs))))
    (is (= 3 (count (b/read-manifest manifest))))))

(deftest the-substrate-stage-rides-the-same-log
  (let [srcs (fresh-tree!)]
    (File/mkdir_p! ex-root)
    (File/write! (str ex-root "/one.ex") "(defmodule Ex.One do\n  def v, do: 1\nend)\n")
    (let [opts {:sources srcs :out out :manifest manifest :jobs 2
                :ex {:root ex-root :exclude []}}
          r1 (run* opts)
          r2 (run* opts)]
      (is (= 1 (:ex-built r1)))
      (is (File/exists? (str out "/Elixir.Ex.One.beam")))
      ; and the second run compiles NOTHING: the substrate is fresh by content
      ; hash, in the same log as the .bl sources
      (is (= 0 (:ex-built r2)))
      (let [state (blog/replay (blog/read-facts (blog/path-for manifest)))]
        (is (= 1 (count (:ex state))) "the substrate's fact is in the SAME log")
        (is (includes? (File/read! (blog/path-for manifest)) "[:build/ex "))))))

(deftest a-require-cycle-is-a-named-fatal-error
  ; BUG-064's class, killed at build time: a cold AOT load of a require cycle
  ; is the silent cross-process deadlock, so the driver refuses to emit beams
  ; for one and says EXACTLY which edges close the loop.
  (let [_ (fresh-tree!)]
    (src "a.bl" "(ns a (:require [b]))\n(defn f [] 1)\n")
    (src "b.bl" "(ns b (:require [a]))\n(defn g [] 2)\n")
    (File/rm (str root "/c.bl.md"))
    (let [r (run [(str root "/a.bl") (str root "/b.bl")])]
      (is (= 1 (count (:errors r))))
      (is (includes? (first (:errors r)) "require cycle: a -> b -> a"))
      (is (= 0 (:built r)) "no beams for a graph with no satisfying order"))))

(deftest clean-removes-the-log-too
  (let [srcs (fresh-tree!)
        log (blog/path-for manifest)]
    (run srcs)
    (is (File/exists? log))
    (b/clean out manifest)
    (is (not (File/exists? manifest)))
    ; A clean that removed the manifest but left the log would leave a log
    ; claiming beams that no longer exist.
    (is (not (File/exists? log)))
    (is (= [] (beams)))))

; ── declared exclusions: entries that must never AOT-evaluate (FUP-015) ─────
;
; `:exclude` names sources a build must never compile. Selection happens
; against `:sources` BEFORE the graph is planned, so an excluded source is not
; evaluated and emits no beam — and a source the log recorded before it was
; excluded is retired with its beam, never left as a loadable old generation.

(deftest an-excluded-source-never-evaluates
  (let [srcs (fresh-tree!)
        marker (str root "/entry-ran")
        entry (src "entry.bl" (str "(ns entry)\n"
                                   "(File/write! \"" marker "\" \"ran\")\n"
                                   "(defn boom [] :ran)\n"))
        all (conj srcs entry)]
    ; CONTROL: with no exclusion the entry compiles and its top-level form
    ; runs — the very behaviour FUP-015 names.
    (run all)
    (is (File/exists? marker))
    (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.Entry.beam"))
    ; EXCLUDED: neither evaluates nor emits, and the library still builds.
    (File/rm marker)
    (let [r (run* {:sources all :exclude [entry] :force? true})]
      (is (= [] (:errors r)))
      (is (not (File/exists? marker)) "the excluded entry's top-level form never runs")
      (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.Entry.beam")))
      (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.A.beam")))))

(deftest an-exclusion-retires-prior-artifacts
  (let [srcs (fresh-tree!)
        entry (src "entry.bl" "(ns entry)\n(defn boom [] :ran)\n")
        all (conj srcs entry)
        log (blog/path-for manifest)]
    (run all)
    (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.Entry.beam"))
    (is (= 4 (count (b/read-manifest manifest))))
    (let [r (run* {:sources all :exclude [entry]})
          state (blog/replay (blog/read-facts log))]
      (is (= [] (:errors r)))
      (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.Entry.beam"))
          "the retired beam is gone, not a hidden stale generation")
      (is (= 3 (count (b/read-manifest manifest))))
      (is (not (contains? (:sources state) entry))
          "the log no longer records the excluded source"))))

(deftest exclusion-is-separator-bounded
  (let [srcs (fresh-tree!)
        dir (str root "/mods")
        _ (File/mkdir_p! dir)
        inside (src "mods/x.bl" "(ns x)\n(defn y [] 1)\n")
        sibling (src "mods2.bl" "(ns mods2)\n(defn z [] 2)\n")
        all (into srcs [inside sibling])]
    (let [r (run* {:sources all :exclude [dir]})]
      (is (= [] (:errors r)))
      (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.X.beam")))
      (is (contains? (set (beams)) "Elixir.BeamLisp.Ns.Mods2.beam")
          "a sibling whose name merely shares the prefix is NOT excluded"))))

(deftest a-required-excluded-dependency-is-refused
  (let [srcs (fresh-tree!)
        marker (str root "/dep-ran")
        entry (src "entry.bl" (str "(ns entry)\n"
                                   "(File/write! \"" marker "\" \"ran\")\n"
                                   "(defn boom [] :ran)\n"))
        dep (src "dep.bl" "(ns dep (:require [entry]))\n(defn d [] (entry/boom))\n")
        all (into srcs [entry dep])]
    (let [r (run* {:sources all :exclude [entry]})]
      (is (> (count (:errors r)) 0))
      (is (includes? (first (:errors r)) "requires entry"))
      (is (not (File/exists? marker))
          "the excluded entry is refused, not secretly evaluated")
      (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.Entry.beam")))
      (is (not (contains? (set (beams)) "Elixir.BeamLisp.Ns.Dep.beam"))
          "the requirer is not compiled either"))))

; ── the toolchain barrier is one-directional ────────────────────────────
;
; `partition-plan` iterates the TOOLCHAIN sources and asks whether each one
; requires something outside the toolchain. It never asks the reverse question,
; and that asymmetry is load-bearing for PLAN-128: it is why a cross-layer
; contract COULD be given a single definition (put it under `priv/build/` and
; let `priv/std/vm/native.bl` require it), and therefore why declining that is
; a design choice rather than a language limit.
;
; Pinned so the claim is OBSERVED rather than read off the source. If anyone
; ever makes the barrier symmetric, two docstrings and that plan's reasoning
; become false — and this test is what says so.
;
; The paths are real locations under the live priv root, because
; `toolchain_source?` decides by inode-beneath and so needs directories that
; exist: it is `boot_source? or build_source?`, not a string prefix match.

(deftest the-toolchain-barrier-is-one-directional
  (let [priv (BeamLisp.Tiers/priv_root)
        tc (str priv "/build/x.bl")
        ord (str priv "/std/y.bl")
        n (fn [path] {:path path})
        errs (fn [deps] (:errors (b/partition-plan {:order (list (n tc) (n ord))
                                                    :deps deps
                                                    :waves []})))]
    (is (seq (errs {tc (list ord)}))
        "a TOOLCHAIN source requiring an ordinary one is a barrier error")
    (is (empty? (errs {ord (list tc)}))
        "an ORDINARY source requiring a toolchain one is never checked")))


(deftest digest-valid-wrong-namespace-output-is-not-fresh
  (let [srcs (fresh-tree!)]
    (run srcs)
    (let [path (str out "/Elixir.BeamLisp.Ns.A.beam")
          text (str "defmodule BeamLisp.Ns.A do\n"
                    "Module.register_attribute(__MODULE__, :bl_source_hash, persist: true)\n"
                    "Module.register_attribute(__MODULE__, :bl_compiler_key, persist: true)\n"
                    "@bl_source_hash \"wrong-source\"\n@bl_compiler_key \"wrong-compiler\"\n"
                    "def __bl_ns_defs__, do: %{}\nend\n")
          compiled (first (Code/compile_string text))]
      ; Log keys and output existence still agree. Only semantic provenance
      ; distinguishes this valid BEAM from the planned source's artifact.
      (File/write! path (elem compiled 1))
      (let [r (run srcs)]
        (is (= [] (:errors r)))
        (is (= 1 (:built r)))
        (is (= 0 (:built (run srcs))))))))

(deftest action-only-namespace-reaches-a-no-op-build
  (File/rm_rf! root)
  (File/mkdir_p! root)
  (let [path (src "action.bl" "(ns build.action.only.fixture)\n(+ 1 2)\n")
        first-run (run [path])
        second-run (run [path])]
    (is (= [] (:errors first-run)))
    (is (= 1 (:built first-run)))
    (is (= [] (:errors second-run)))
    (is (= 0 (:built second-run)))))
