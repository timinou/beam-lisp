(ns constructor-data-limits-test)

(defn- refusal [action]
 (try (action) nil (catch error (select-keys (ex-data error) [:kind :reason]))))

(deftest sdk-syntax-limits-cannot-be-selected-by-public-constructor-metadata
 (let [large (vec (range 17000))
       metadata {:data-limits {:max-nodes 1000000 :max-bytes 16777216 :max-depth 128}}
       expected {:kind :unsafe-first-order-data :reason :node-limit}]
  (is (= expected (refusal #(BeamLisp.AOT/interpret_constructor!
                             {:op :lit :val large} {} metadata))))
  (is (= expected (refusal #(BeamLisp.AOT/interpret_constructor!
                             {:op :var :name "input"} {"input" large} metadata))))
  (is (= expected (refusal #(BeamLisp.AOT/constructor_call!
                             {} {} "user" "syntax" [large]))))))

(deftest repeated-reads-do-not-charge-an-existing-tree-as-new-allocation
 (let [read {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :empty?
             :args (list {:op :var :name "tree"})}
       program {:op :let :name "tree" :init {:op :lit :val (vec (range 1024))}
                :body {:op :do :stmts (to-list (repeat 600 read))}}]
  (is (= false (BeamLisp.AOT/interpret_constructor! program {} {})))))
