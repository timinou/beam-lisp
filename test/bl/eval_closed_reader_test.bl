(ns eval.closed-reader-test
 (:require [eval.closed :as closed] [reader] [reader-node :as rn]))

(defn- with-registry [key value action]
 (let [previous (BeamLisp.Env/lookup key)]
  (try
   (BeamLisp.Env/put_key key value)
   (action)
   (finally
    (if (= :error previous) (BeamLisp.Env/delete_key key)
     (BeamLisp.Env/put_key key (elem previous 1)))))))
(defn- call-name [source]
 (let [node (rn/node-form (first (reader/read-string source nil)))]
  (rn/node-name (rn/node-form (first (rn/node-items node))))))

(deftest registered-data-reader-tags-never-enter-the-closed-expression-vocabulary
 (let [effects (atom 0) opts {:operations {"host/tick" (fn [& _] (swap! effects inc) 42)}}]
  (with-registry (tuple :data_reader "closed_probe") (tuple :symbol "host/tick")
   (fn []
    ;; Positive control: this is a real ambient registration honored by the
    ;; ordinary reader, not an unregistered tag whose source already fails.
    (is (= "host/tick" (call-name "#closed_probe[1]")))
    (doseq [source ["#closed_probe[1]" "#closed_probe{:a 1}" "#closed_probe\"x\""
                   "#closed_probe|raw|" "'#closed_probe[1]"
                   "(host/tick) #closed_probe[1]" "#unknown_closed_tag[1]"]]
     (let [checked (closed/check source opts) run (closed/run source opts)]
      (is (= :refused (:status checked)) source)
      (is (= :reader-dispatch (:kind checked)) source)
      (is (= :refused (:status run)) source)))
    (is (= 0 @effects))
    (is (= 42 (:value (closed/run "(host/tick)" opts))))
    (is (= 1 @effects))))))

(deftest overridden-reader-macros-cannot-borrow-the-approved-host-operation-map
 (let [effects (atom 0) opts {:operations {"host/tick" (fn [& _] (swap! effects inc))}}]
  (with-registry (tuple :reader_macro "@") "host/tick"
   (fn []
    (is (= (tuple :ok "host/tick") (BeamLisp.Ns.Rt/reader_macro "@")))
    ;; The actual self-hosted reader has fixed prefix branches and does not
    ;; invoke or resolve the overridable reader-macro table.
    (is (= "deref" (call-name "@[]")))
    (is (= :refused (:status (closed/check "@[]" opts))))
    (is (= :refused (:status (closed/run "@[]" opts))))
    (is (= 0 @effects))))))

(deftest dispatch-guard-preserves-inert-hashes-and-supported-builtins
 (doseq [[source expected]
          [["\"#closed_probe[1]\"" "#closed_probe[1]"]
           ["; #closed_probe[1]\n(+ 20 22)" 42]
           ["\\#" 35]
           ["'name#suffix" (tuple :symbol "name#suffix")]
           ["(count #{1 2})" 2]
           ["(#(+ % 1) 41)" 42]
           ["(boolean (re-find #\"#closed_probe\\[\" \"#closed_probe[1]\"))" true]]]
  (let [r (closed/run source)]
   (is (= :ok (:status r)) (str source " " (pr-str r)))
   (is (= expected (:value r)) source)))
 (doseq [source ["#_42 7" "#?(:beam 42 :default 7)" "#|raw|" "#'inc"]]
  (is (= :reader-dispatch (:kind (closed/check source))))))

(defn- existing-token [name]
 (try (erlang/binary_to_existing_atom name :utf8) (catch _ :missing)))

(deftest metadata-cannot-intern-untrusted-keywords-before-preflight
 (let [prefix (str "closed-metadata-boundary-" (erlang/unique_integer (list :positive)))
       positive (str prefix "-ordinary-reader")]
  ;; Genuine positive control for the native atom frontier: the ordinary reader
  ;; interns author metadata keys, independently of compilation/evaluation.
  (is (= :missing (existing-token positive)))
  (reader/read-string (str "^:" positive " []") nil)
  (is (not= :missing (existing-token positive)))
  (closed/check "^:closed-metadata-warm []")
  (let [atoms (erlang/system_info :atom_count) modules (count (code/all_loaded))]
   (doseq [index (range 30)]
    (let [name (str prefix "-refused-" index)]
     (is (= :missing (existing-token name)))
     (doseq [source [(str "^:" name " []")
                     (str "^{:" name " true} 42")
                     (str "'^:" name " []")]]
      (is (= :reader-prefix (:kind (closed/check source))))
      (is (= :refused (:status (closed/run source)))))
     (is (= :missing (existing-token name)))))
   (is (= atoms (erlang/system_info :atom_count)))
   (is (= modules (count (code/all_loaded))))))
 (is (= 94 (:value (closed/run "\\^"))))
 (is (= (tuple :symbol "name^suffix") (:value (closed/run "'name^suffix"))))
 (is (= "^:inert" (:value (closed/run "\"^:inert\"")))))
