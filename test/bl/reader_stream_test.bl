; test/bl/reader_stream_test.bl — streaming source offsets count every consumed
; reader-prefix codepoint exactly once.
;
; BUG-114-streaming-reader-offsets-omit-consumed-q: `read-next-string` slices a
; form's own source text from the form's absolute `:offset`/`:end-offset`. The
; reader positioned a reader-prefix payload (`'x`, `~@x`, `@x`, `#'x`, …) at the
; PREFIX character's line/column — a documented reader.ex parity quirk — but
; never counted the consumed prefix characters in the payload's absolute offset.
; Every offset after a prefix was therefore one (or two) short, so a streamed
; slice silently dropped the form's final character: the corpus form
; `(= [1 2] '(1 2))` sliced to `(= [1 2] '(1 2)`.
;
; The fix keeps line/column parity (the quirk above is INTENTIONAL and pinned
; here) and advances the offset by the prefix width, so each prefix codepoint is
; counted exactly once. This suite pins both halves: the exact slice text and
; the exact start/end offsets, plus the retained column quirk.
;
; Every assertion is source-level — no process, no clock, no host state — so a
; failure names either a slice or an offset, never a flake.
;
; Run: bin/bl test test/bl/reader_stream_test.bl

(ns reader.stream.test)

(defn- stream [src] (BeamLisp.Ns.Reader/stream src "stream.bl"))
(defn- next-string [st] (BeamLisp.Ns.Reader/read-next-string st))
(defn- pos [form] (BeamLisp.FormMeta/meta form))

(defn- stream-forms
  "All `[form source-text]` pairs from `src`, in order, read once."
  [src]
  (loop [st (stream src) out []]
    (let [r (next-string st)]
      (if (= :ok (first r))
        (recur (nth r 3) (conj out [(second r) (nth r 2)]))
        out))))

(defn- form-of [pair] (first pair))
(defn- text-of [pair] (second pair))

(deftest each-prefix-counts-its-own-codepoints-exactly-once
  ; [source, expected slice, meta :offset, meta :end-offset]. `#'` starts at 2
  ; because its caller already advances the position through BOTH chars — the
  ; legacy parity behaviour — while the slice still runs from the `#`.
  (doseq [[src expected start end] [["'foo" "'foo" 0 4]
                                    ["`foo" "`foo" 0 4]
                                    ["~foo" "~foo" 0 4]
                                    ["~@foo" "~@foo" 0 5]
                                    ["@foo" "@foo" 0 4]
                                    ["#'foo" "#'foo" 2 5]]]
    (let [pair (first (stream-forms src))
          p (pos (form-of pair))]
      (is (= expected (text-of pair)) (str "slice of " src))
      (is (= start (get p :offset)) (str "start offset of " src))
      (is (= end (get p :end-offset)) (str "end offset of " src)))))

(deftest prefix-payload-keeps-the-legacy-column-quirk-while-offsets-are-exact
  ; `(a '(b))` — the quote is at col 4, the payload `(` at col 5. reader.ex
  ; attributes the payload to the PREFIX column (a documented quirk), and the
  ; offset must nonetheless point at the real `(` (codepoint 4).
  (let [pair (first (stream-forms "(a '(b))"))
        form (form-of pair)
        items (erlang/element 2 (erlang/element 2 form))
        quote-list (nth items 1)
        payload (second (erlang/element 2 (erlang/element 2 quote-list)))]
    (is (= "(a '(b))" (text-of pair)))
    (is (= 4 (get (pos quote-list) :col)))
    (is (= 4 (get (pos payload) :col)) "the `(` is col 5; the prefix column is the quirk")
    (is (= 3 (get (pos quote-list) :offset)))
    (is (= 7 (get (pos quote-list) :end-offset)))
    (is (= 4 (get (pos payload) :offset)) "the OFFSET is exact, unlike the column")
    (is (= 7 (get (pos payload) :end-offset)))
    (is (= 8 (get (pos form) :end-offset)))))

(deftest nested-prefixes-count-every-prefix
  (let [pair (first (stream-forms "''x"))
        form (form-of pair)
        inner (second (erlang/element 2 (erlang/element 2 form)))]
    (is (= "''x" (text-of pair)))
    (is (= 0 (get (pos form) :offset)))
    (is (= 3 (get (pos form) :end-offset)))
    (is (= 1 (get (pos inner) :offset)))
    (is (= 3 (get (pos inner) :end-offset)))))

(deftest a-prefix-then-deref-nests-without-double-counting
  (let [pair (first (stream-forms "'@x"))
        form (form-of pair)
        inner (second (erlang/element 2 (erlang/element 2 form)))]
    (is (= "'@x" (text-of pair)))
    (is (= 3 (get (pos form) :end-offset)))
    (is (= 1 (get (pos inner) :offset)))
    (is (= 3 (get (pos inner) :end-offset)))))

(deftest a-quote-inside-a-string-is-not-a-reader-prefix
  (let [pair (first (stream-forms "\"'abc\""))]
    (is (= "\"'abc\"" (text-of pair)))
    (is (= "'abc" (form-of pair)))))

(deftest a-prefix-inside-a-regex-body-stays-verbatim
  (let [pair (first (stream-forms "#\"'\\d\""))
        form (form-of pair)]
    (is (= "#\"'\\d\"" (text-of pair)))
    (is (= 0 (get (pos form) :offset)))
    (is (= 6 (get (pos form) :end-offset)))))

(deftest whitespace-between-a-prefix-and-its-form-is-in-the-slice
  (let [pair (first (stream-forms "'\n  foo"))
        form (form-of pair)]
    (is (= "'\n  foo" (text-of pair)))
    (is (= 0 (get (pos form) :offset)))
    (is (= 7 (get (pos form) :end-offset)))
    (is (= 1 (get (pos form) :line)))
    (is (= 1 (get (pos form) :col)))))

(deftest a-comment-between-a-prefix-and-its-form-is-in-the-slice
  (let [pair (first (stream-forms "' ; c\nfoo"))
        form (form-of pair)]
    (is (= "' ; c\nfoo" (text-of pair)))
    (is (= 0 (get (pos form) :offset)))
    (is (= 9 (get (pos form) :end-offset)))
    (is (= 1 (get (pos form) :line)))
    (is (= 1 (get (pos form) :col)))))

(deftest non-ascii-codepoints-advance-the-offset-by-one-each
  (let [pair (first (stream-forms "'λ"))
        form (form-of pair)]
    (is (= "'λ" (text-of pair)))
    (is (= 0 (get (pos form) :offset)))
    (is (= 2 (get (pos form) :end-offset)))))

(deftest a-form-after-a-non-ascii-prefix-form-slices-exact
  (let [forms (stream-forms "'λ x")]
    (is (= "'λ" (text-of (first forms))))
    (is (= "x" (text-of (second forms))))))

(deftest the-failing-corpus-quote-then-str-and-pr-str-slice-exact
  ; BUG-114's minimal regression: `(= [1 2] '(1 2))` (whose inner quote made the
  ; slice drop the final `)`), then `str` and `pr-str` siblings whose slices were
  ; shifted by the same undercount.
  (let [src "(= [1 2] '(1 2))\n(str \"a\" 1 :b nil)\n(pr-str [1 \"s\" :k 'sym {:a 1}])\n"
        forms (stream-forms src)]
    (is (= 3 (count forms)))
    (is (= "(= [1 2] '(1 2))" (text-of (nth forms 0))))
    (is (= "(str \"a\" 1 :b nil)" (text-of (nth forms 1))))
    (is (= "(pr-str [1 \"s\" :k 'sym {:a 1}])" (text-of (nth forms 2))))
    (let [form0 (form-of (nth forms 0))
          items (erlang/element 2 (erlang/element 2 form0))
          quote-list (nth items 2)]
      (is (= 0 (get (pos form0) :offset)))
      (is (= 16 (get (pos form0) :end-offset)) "the final `)` is inside the slice")
      (is (= 9 (get (pos quote-list) :offset)))
      (is (= 15 (get (pos quote-list) :end-offset))))))

(deftest the-stream-reports-eof-after-the-last-form
  (let [st (stream "(a) (b)")
        r1 (next-string st)
        r2 (next-string (nth r1 3))
        r3 (next-string (nth r2 3))]
    (is (= :ok (first r1)))
    (is (= "(a)" (nth r1 2)))
    (is (= :ok (first r2)))
    (is (= "(b)" (nth r2 2)))
    (is (= :eof (first r3)))
    (is (= :eof (first (BeamLisp.Ns.Reader/read-next (nth r3 1)))))))

(deftest read-next-advances-the-offset-so-a-later-slice-is-exact
  ; read-next returns a stream whose position must carry the corrected offset,
  ; or the NEXT read-next-string starts mid-form (the `'foo` undercount would
  ; make it re-read the tail `o` of `foo`, not `bar`).
  (let [r1 (BeamLisp.Ns.Reader/read-next (stream "'foo bar"))
        r2 (next-string (nth r1 2))]
    (is (= :ok (first r1)))
    (is (= :ok (first r2)))
    (is (= "bar" (nth r2 2)))))

(deftest read-next-yields-every-prefix-form-then-eof
  (doseq [src (list "'foo" "`foo" "~foo" "~@foo" "@foo" "#'foo")]
    (let [r (BeamLisp.Ns.Reader/read-next (stream src))]
      (is (= :ok (first r)) (str "read-next " src))
      (is (= :meta (erlang/element 1 (second r))) (str "prefixed form is a wrapped list " src))
      (is (= :eof (first (BeamLisp.Ns.Reader/read-next (nth r 2)))) (str "eof after " src)))))


(deftest metadata-prefixes-count-the-caret-without-shifting-later-slices
  (doseq [text ["^:m foo" "^Type foo" "^\"type\" foo" "^{:x true} foo" "^:a ^:b (foo)"]]
    (let [pairs (stream-forms (str text "\n(after)"))]
      (is (= text (text-of (first pairs))) (str "metadata slice: " text))
      (is (= "(after)" (text-of (second pairs)))))))

(deftest anonymous-function-prefix-counts-hash-and-opener
  (doseq [src ["#(+ % 1)" "(map #(* % %) [1 2])" "'#(identity %)" "#(vector 'x %)"]]
    (let [pairs (stream-forms (str src "\n(after)"))]
      (is (= src (text-of (first pairs))) (str "anonymous fn slice: " src))
      (is (= "(after)" (text-of (second pairs)))))))
