; legacy_wave1214_test.bl — one .bl suite replacing three ExUnit suites:
;
;   * test/beam_lisp/wave12_test_port_test.exs — the clojure.test runner
;     contract (run_suite totals/passed?, the FAIL/ERROR renderer, cli on a
;     green suite, deftest redefinition). The runner is exercised by calling
;     `BeamLisp.TestRT/run_suite` DIRECTLY, exactly as the ExUnit original did
;     (`compile_io` swapped for a StringIO group leader). run_suite forks :global
;     for each run, so the running suite's own registry is untouched — no child
;     VM is needed here.
;   * test/beam_lisp/wave14_reader_test.exs — reader-level `#()` fn literals,
;     char literals, `#_` discard, and their SyntaxError VALUES.
;   * test/beam_lisp/wave14_meta_test.exs — BeamLisp.Meta on lazy seqs and
;     value-typed values, var metadata (Env put_meta/meta/doc_string), metadata
;     on vectors, the `into` strategy, and two-element map entries.
;
; Mapping (original test → this file's deftest), one line per case:
;
;   wave12 "a passing suite returns green totals"        → runner-passing-suite-green
;   wave12 "a failing suite reports detail and red totals"→ runner-failing-suite-detail
;   wave12 "the mix task exits normally on a green suite" → runner-cli-green-suite
;   wave12 "redefining a test replaces it"               → runner-deftest-redefinition
;
;   w14r "#() fn literals — read form" (8 tests)         → reader-fn-literal-read-forms..%foo
;   w14r "#() fn literals — evaluation" (6 tests)        → reader-fn-literal-evaluates
;   w14r "char literals" (3 tests)                       → reader-char-literals
;   w14r "#_ discard" (2 tests)                          → reader-discard
;
;   w14m "reader locations do not become runtime metadata" (3) → meta-reader-locations
;   w14m "Meta on lazy seqs" (15 tests)                  → meta-lazy-seq-*
;   w14m "Meta on value-typed values" (3 tests)          → meta-value-typed-* / meta-raise
;   w14m "var metadata" (7 tests)                        → meta-var-*
;   w14m "metadata on vectors" (7 tests)                 → meta-vector-*
;   w14m "into" (3 tests)                                → meta-into-*
;   w14m "map entries" (2 tests)                         → meta-map-entries
;
; Run: bin/bl test test/bl/legacy_wave1214_test.bl

(ns legacy.wave1214.test)

; ── shared helpers ───────────────────────────────────────────────────────

(defn- ro [s] (BeamLisp.Reader/read_one s))
(defn- ra [s] (BeamLisp.Reader/read_all s))

; A reader SyntaxError's message, or :no-raise — the assert_raise ~r/…/ value.
(defn- syn-msg [s]
  (try
    (do (ro s) :no-raise)
    (catch BeamLisp.Reader.SyntaxError e (ex-message e))))

; eval in the "core" namespace, as wave14_reader's setup env did.
(defn- ev-core [s] (BeamLisp.Compiler/eval_string s (BeamLisp.Compiler/new_env "core")))
; eval in "user", standing in for `BeamLisp.eval` after the ExUnit `in_ns("user")`.
(defn- ev-user [s] (BeamLisp.Compiler/eval_string s (BeamLisp.Compiler/new_env "user")))

(defn- seq1 [] (BeamLisp.LazySeq/new (fn [] (list 1 2 3))))

; Capture everything `f` prints through a StringIO group leader (the ExUnit
; `capture_io`), returning (tuple result output).
(defn- cap [f]
  (let [io (erlang/element 2 (StringIO/open ""))
        prev (Process/group_leader)]
    (erlang/group_leader io (erlang/self))
    (try
      (let [r (f)] (tuple r (erlang/element 2 (StringIO/contents io))))
      (finally
        (do (erlang/group_leader prev (erlang/self))
            (StringIO/close io))))))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_legacy_wave1214_" (erlang/unique_integer (list :positive))))

(defn- write-fixture! [dir name content]
  (File/mkdir_p! dir)
  (let [p (Path/join dir name)]
    (File/write! p content)
    p))

; ── wave12: the runner contract ──────────────────────────────────────────
; (wave12_test_port_test.exs)

(deftest runner-passing-suite-green
  (let [dir (tmp-dir)
        path (write-fixture! dir "passing.bl"
               (str "(ns port.passing)\n\n"
                    "(deftest arithmetic\n"
                    "  (is (= (+ 1 2) 3))\n"
                    "  (is (= (* 6 7) 42)))\n\n"
                    "(deftest collections\n"
                    "  (testing \"map\"\n"
                    "    (is (= (map inc [1 2]) '(2 3))))\n"
                    "  (are [x y] (= x y) 1 1 2 2))\n"))
        res (cap (fn [] (BeamLisp.TestRT/run_suite (list path))))
        t (erlang/element 1 res)
        out (erlang/element 2 res)]
    (is (= 2 (:tests t)))
    (is (= 5 (:pass t)))
    (is (= 0 (:fail t)))
    (is (= 0 (:error t)))
    (is (BeamLisp.TestRT/passed? t))
    (is (includes? out "Testing port.passing"))
    (is (includes? out "Ran 2 tests containing 5 assertions."))
    (is (includes? out "0 failures, 0 errors."))
    (File/rm_rf! dir)))

(deftest runner-failing-suite-detail
  (let [dir (tmp-dir)
        path (write-fixture! dir "failing.bl"
               (str "(ns port.failing)\n\n"
                    "(deftest eq-mismatch\n"
                    "  (testing \"comparison\"\n"
                    "    (is (= 1 2))))\n\n"
                    "(deftest error-inside-is\n"
                    "  (is (= (throw (ex-info \"boom\" {:code 9})) nil)))\n"))
        res (cap (fn [] (BeamLisp.TestRT/run_suite (list path))))
        t (erlang/element 1 res)
        out (erlang/element 2 res)]
    (is (= 1 (:fail t)))
    (is (= 1 (:error t)))
    (is (= 0 (:pass t)))
    (is (not (BeamLisp.TestRT/passed? t)))
    ; the `=` special case reports the two sides separately
    (is (includes? out "FAIL in (port.failing)"))
    (is (includes? out "comparison"))
    (is (includes? out "expected: 1"))
    (is (includes? out "actual: 2"))
    (is (includes? out "ERROR in (port.failing)"))
    (is (includes? out "expected: (= (throw (ex-info \"boom\" {:code 9})) nil)"))
    (is (includes? out "actual: boom"))
    (is (includes? out "1 failures, 1 errors."))
    (File/rm_rf! dir)))

(deftest runner-cli-green-suite
  (let [dir (tmp-dir)
        path (write-fixture! dir "green.bl" "(ns port.green)\n(deftest ok (is (= 2 2)))\n")
        res (cap (fn [] (BeamLisp.TestRT/cli (list path))))]
    ; cli on a green suite does not halt and answers nil
    (is (= nil (erlang/element 1 res)))
    (is (includes? (erlang/element 2 res) "0 failures, 0 errors."))
    (File/rm_rf! dir)))

(deftest runner-deftest-redefinition
  (let [dir (tmp-dir)
        path (write-fixture! dir "redefine.bl"
               "(ns port.redefine)\n(deftest t (is (= 1 1)))\n(deftest t (is (= 2 2)))\n")
        res (cap (fn [] (BeamLisp.TestRT/run_suite (list path))))
        t (erlang/element 1 res)]
    ; one deftest of that name, redefined once: a single run, one pass
    (is (= 1 (:tests t)))
    (is (= 1 (:pass t)))
    (File/rm_rf! dir)))

; ── wave14 reader ────────────────────────────────────────────────────────
; (wave14_reader_test.exs)

(defn- reads-as? [short long] (erlang/== (ro short) (ro long)))

(deftest reader-fn-literal-read-forms
  (testing "% is the first positional"
    (is (reads-as? "#(+ % 1)" "(fn [p1__] (+ p1__ 1))"))
    (is (reads-as? "#(inc %)" "(fn [p1__] (inc p1__))")))
  (testing "%1 %2 … are positional, arity is the highest used"
    (is (reads-as? "#(+ %1 %2)" "(fn [p1__ p2__] (+ p1__ p2__))"))
    (is (reads-as? "#(vector %2 %1)" "(fn [p1__ p2__] (vector p2__ p1__))")))
  (testing "%& is the rest arg"
    (is (reads-as? "#(apply + %&)" "(fn [& rest__] (apply + rest__))")))
  (testing "no % gives a zero-arg fn"
    (is (reads-as? "#(do)" "(fn [] (do))"))
    (is (reads-as? "#(println :hi)" "(fn [] (println :hi))")))
  (testing "% inside a nested plain (fn …) still belongs to the literal"
    (is (reads-as? "#(fn [x] (+ x %))" "(fn [p1__] (fn [x] (+ x p1__)))")))
  (testing "replacement reaches inside vectors and maps"
    (is (reads-as? "#(vector [% %])" "(fn [p1__] (vector [p1__ p1__]))"))
    (is (reads-as? "#(assoc {% 1} % 2)" "(fn [p1__] (assoc {p1__ 1} p1__ 2))")))
  (testing "a symbol merely starting with % is left alone (not an arg)"
    (is (reads-as? "#(+ %foo 1)" "(fn [] (+ %foo 1))"))))

(deftest reader-fn-literal-nested-is-an-error
  (testing "nested #() is an error, not silent misbehaviour"
    (is (includes? (syn-msg "#(#(+ % 1) 2)") "nested"))))

(deftest reader-fn-literal-evaluates
  (testing "#() evaluates as the desugared fn"
    (is (= (list 2 4 6) (ev-core "(map #(* % 2) [1 2 3])")))
    (is (= (list 3 4) (ev-core "(filter #(> % 2) [1 2 3 4])")))
    (is (= 10 (ev-core "(reduce #(+ %1 %2) 0 [1 2 3 4])")))
    (is (= 6 (ev-core "(#(apply + %&) 1 2 3)")))
    (is (= 30 (ev-core "(#(+ %1 %2) 10 20)")))
    (is (= 15 (ev-core "((#(fn [x] (+ x %)) 10) 5)")))))

(deftest reader-char-literals
  (testing "named and escaped chars"
    (is (= 97 (ro "\\a")))
    (is (= 10 (ro "\\newline")))
    (is (= 32 (ro "\\space")))
    (is (= 9 (ro "\\tab")))
    (is (= 13 (ro "\\return")))
    (is (= 92 (ro "\\\\"))))
  (testing "unicode \\uNNNN"
    (is (= 65 (ro "\\u0041")))
    (is (= 233 (ro "\\u00e9"))))
  (testing "invalid char literals raise"
    (is (includes? (syn-msg "\\ab") "invalid character"))
    (is (includes? (syn-msg "\\u12") "invalid character"))
    (is (includes? (syn-msg "\\") "invalid character"))))

(deftest reader-discard
  (testing "skips the next form"
    (is (erlang/== (ro "(+ 1 #_2 3)") (ro "(+ 1 3)")))
    (is (erlang/== (ro "[1 #_2 3]") (ro "[1 3]")))
    (is (erlang/== (ra "(def x #_ignored 5)") (ra "(def x 5)"))))
  (testing "a trailing #_ with nothing to discard is an error"
    (is (not (erlang/== :no-raise (syn-msg "(+ 1 #_)"))))))

; ── wave14 metadata: reader locations ────────────────────────────────────
; (wave14_meta_test.exs — "reader locations do not become runtime metadata")

(deftest meta-reader-locations
  (testing "native calls receive ordinary lists despite source offsets"
    (let [forms (BeamLisp.Ns.Reader/read_string "(list 1 2)" "metadata-test.bl")
          position (erlang/element 3 (first forms))]
      (is (= 0 (erlang/map_get :offset position)))
      (is (= 10 (erlang/map_get :"end-offset" position))))
    (is (erlang/== (erlang/list_to_tuple (list "def" "value"))
                   (ev-user "(erlang/list_to_tuple (list \"def\" \"value\"))")))
    (is (= {"def" "value"}
           (ev-user "(maps/from_list (list (erlang/list_to_tuple (list \"def\" \"value\"))))"))))
  (testing "nested evaluated forms have no implicit source metadata"
    (is (= nil (ev-user "(meta (list (list 1 2) 3))")))
    (is (= nil (ev-user "(meta (first (list (list 1 2))))"))))
  (testing "explicit author metadata survives but source positions do not"
    (is (= {:audit true} (ev-user "(meta ^{:audit true} (list 1 2))")))))

; ── wave14 metadata: BeamLisp.Meta on lazy seqs ──────────────────────────

(deftest meta-lazy-seq-absent-is-nil
  (is (= nil (BeamLisp.Meta/meta (seq1)))))

(deftest meta-lazy-seq-attaches-and-reads-back
  (let [tagged (BeamLisp.Meta/with_meta (seq1) {:doc "three numbers"})]
    (is (= {:doc "three numbers"} (BeamLisp.Meta/meta tagged)))))

(deftest meta-lazy-seq-new-value-keeps-original
  (let [original (seq1)
        tagged (BeamLisp.Meta/with_meta original {:a 1})]
    ; Elixir's structural `!=` — the two structs are not term-identical …
    (is (not (erlang/== tagged original)))
    (is (= nil (BeamLisp.Meta/meta original)))
    (is (= {:a 1} (BeamLisp.Meta/meta tagged)))))

(deftest meta-lazy-seq-shared-pending-effect
  (let [runs (atom 0)
        original (BeamLisp.LazySeq/new (fn [] (swap! runs inc) (list :value)))
        tagged (BeamLisp.Meta/with_meta original {:a 1})]
    (is (erlang/== (erlang/map_get :resource tagged) (erlang/map_get :resource original)))
    (is (= (list :value) (BeamLisp.LazySeq/force tagged)))
    (is (= (list :value) (BeamLisp.LazySeq/force original)))
    (is (= 1 @runs))
    (is (= nil (BeamLisp.Meta/meta original)))
    (is (= {:a 1} (BeamLisp.Meta/meta tagged)))))

(deftest meta-lazy-seq-shared-completed-memo
  (let [runs (atom 0)
        original (BeamLisp.LazySeq/new (fn [] (swap! runs inc) :value))]
    (is (= :value (BeamLisp.LazySeq/force original)))
    (let [tagged (BeamLisp.Meta/with_meta original {:done true})]
      (is (erlang/== (erlang/map_get :resource tagged) (erlang/map_get :resource original)))
      (is (= :value (BeamLisp.LazySeq/force tagged)))
      (is (= 1 @runs)))))

(deftest meta-lazy-seq-no-env-registry-entry
  (let [pattern (tuple (tuple :meta_of :_) :_)
        before (BeamLisp.Env/match pattern)
        tagged (BeamLisp.Meta/with_meta (seq1) {:a 1})]
    (is (= {:a 1} (BeamLisp.Meta/meta tagged)))
    (is (erlang/== before (BeamLisp.Env/match pattern)))))

(deftest meta-lazy-seq-copies-and-captures-share
  (let [runs (atom 0)
        original (BeamLisp.LazySeq/new (fn [] (swap! runs inc) :value))
        tagged (BeamLisp.Meta/with_meta original {:captured true})
        copy tagged
        captured (fn [] tagged)]
    (is (= {:captured true} (BeamLisp.Meta/meta copy)))
    (is (= {:captured true} (BeamLisp.Meta/meta (captured))))
    (is (= :value (BeamLisp.LazySeq/force copy)))
    (is (= :value (BeamLisp.LazySeq/force (captured))))
    (is (= :value (BeamLisp.LazySeq/force original)))
    (is (= 1 @runs))))

(deftest meta-lazy-seq-equality-ignores-metadata
  (let [original (seq1)
        tagged (BeamLisp.Meta/with_meta original {:a 1})]
    (is (BeamLisp.Ns.Rt/eqv original tagged))))

(deftest meta-lazy-seq-realizes-same
  (let [tagged (BeamLisp.Meta/with_meta (seq1) {:a 1})]
    (is (= (list 1 2 3) (BeamLisp.LazySeq/to_list tagged)))))

(deftest meta-lazy-seq-printing-unaffected
  (let [plain (seq1)
        tagged (BeamLisp.Meta/with_meta plain {:doc "secret" :a (list 1 2)})]
    (is (erlang/== (Kernel/inspect tagged) (Kernel/inspect plain)))))

(deftest meta-lazy-seq-replaces-prior
  (let [tagged (BeamLisp.Meta/with_meta (seq1) {:a 1})
        replaced (BeamLisp.Meta/with_meta tagged {:b 2})]
    (is (= {:b 2} (BeamLisp.Meta/meta replaced)))
    (is (= {:a 1} (BeamLisp.Meta/meta tagged)))))

(deftest meta-lazy-seq-nil-clears
  (let [tagged (BeamLisp.Meta/with_meta (seq1) {:a 1})
        cleared (BeamLisp.Meta/with_meta tagged nil)]
    (is (erlang/== (erlang/map_get :resource cleared) (erlang/map_get :resource tagged)))
    (is (= nil (BeamLisp.Meta/meta cleared)))
    (is (= {:a 1} (BeamLisp.Meta/meta tagged)))))

(deftest meta-vary-meta-elixir-fn
  (let [tagged (BeamLisp.Meta/with_meta (seq1) {:a 1})
        bumped (BeamLisp.Meta/vary_meta tagged (fn [m] (assoc m :b 2)))]
    (is (= {:a 1 :b 2} (BeamLisp.Meta/meta bumped)))))

(deftest meta-vary-meta-passes-nil
  (let [bumped (BeamLisp.Meta/vary_meta (seq1) (fn [m] (assoc (or m {}) :k 1)))]
    (is (= {:k 1} (BeamLisp.Meta/meta bumped)))))

(deftest meta-vary-meta-beam-lisp-fn
  (let [tagged (BeamLisp.Meta/with_meta (seq1) {:doc "d"})
        f (ev-user "(fn [m] (assoc (or m {}) :tagged true))")]
    (is (= {:doc "d" :tagged true} (BeamLisp.Meta/meta (BeamLisp.Meta/vary_meta tagged f))))))

; ── wave14 metadata: value-typed values (documented no-op) ───────────────

(deftest meta-value-typed-noop
  (let [values (list (list 1 2 3)
                     {:a 1}
                     (BeamLisp.Vector/new (list 1 2))
                     42
                     "hello"
                     :kw
                     (erlang/list_to_tuple (list :symbol "x")))]
    (is (every? (fn [v] (and (erlang/== nil (BeamLisp.Meta/meta v))
                             (erlang/== v (BeamLisp.Meta/with_meta v {:doc "d"}))))
                values))))

(deftest meta-raise-non-map
  (testing "non-map metadata is rejected"
    (is (includes? (try
                     (do (BeamLisp.Meta/with_meta (seq1) "not a map") :no-raise)
                     (catch ArgumentError e (ex-message e)))
                   "metadata must be a map or nil"))))

(deftest meta-value-typed-via-interop
  (let [tagged (ev-user
                 "(BeamLisp.Meta/with_meta (BeamLisp.LazySeq/from_fun (fn [] (list 1 2))) {:doc \"via interop\"})")]
    (is (= (list 1 2) (BeamLisp.LazySeq/to_list tagged)))
    (is (= {:doc "via interop"} (BeamLisp.Meta/meta tagged)))))

; ── wave14 metadata: var metadata (general map, merge semantics) ─────────

(deftest meta-var-put-general-map
  (BeamLisp.Env/put_meta "user" "w14-general" {:private true})
  (is (= (tuple :ok {:private true}) (BeamLisp.Env/meta "user" "w14-general"))))

(deftest meta-var-merge-doc-and-private
  (BeamLisp.Env/put_meta "user" "w14-merge" {:doc "first"})
  (BeamLisp.Env/put_meta "user" "w14-merge" {:private true})
  (is (= (tuple :ok {:doc "first" :private true}) (BeamLisp.Env/meta "user" "w14-merge"))))

(deftest meta-var-merge-across-redefinition
  (BeamLisp.Env/put_meta "user" "w14-redef" {:doc "old" :dynamic true})
  (BeamLisp.Env/put_meta "user" "w14-redef" {:doc "new"})
  (is (= (tuple :ok {:doc "new" :dynamic true}) (BeamLisp.Env/meta "user" "w14-redef"))))

(deftest meta-var-defn-docstring-merge
  (ev-user "(defn w14-doc \"Squares n.\" [n] (* n n))")
  (is (= (tuple :ok {:doc "Squares n."}) (BeamLisp.Env/meta "user" "w14-doc")))
  (BeamLisp.Env/put_meta "user" "w14-doc" {:private true})
  (is (= (tuple :ok {:doc "Squares n." :private true}) (BeamLisp.Env/meta "user" "w14-doc"))))

(deftest meta-var-doc-string-from-merged-map
  (ev-user "(defn w14-ds \"Docs.\" [x] x)")
  (BeamLisp.Env/put_meta "user" "w14-ds" {:dynamic true})
  (is (= {:ns "user" :name "w14-ds" :doc "Docs."} (BeamLisp.Env/doc_string "user" "w14-ds"))))

(deftest meta-var-doc-string-core-fallback
  ; the RESOLUTION path (user ns -> core fallback), not the prose
  (let [resolved (BeamLisp.Env/doc_string "user" "zipmap")]
    (is (= "core" (:ns resolved)))
    (is (= "zipmap" (:name resolved)))
    (is (String/starts_with? (:doc resolved)
                             "Builds a map from parallel keys and values."))))

(deftest meta-var-doc-string-referred
  (BeamLisp.Env/add_refer "user" "w14-referred" "w14-other")
  (BeamLisp.Env/put_meta "w14-other" "w14-referred" {:doc "referred docs"})
  (is (= {:ns "w14-other" :name "w14-referred" :doc "referred docs"}
         (BeamLisp.Env/doc_string "user" "w14-referred"))))

; ── wave14 metadata: metadata on vectors (BUG-009) ───────────────────────

(deftest meta-vector-still-usable
  (is (= true (ev-user "(vector? (with-meta [1 2] {:k 1}))")))
  (is (= 2 (ev-user "(count (with-meta [1 2] {:k 1}))")))
  (is (= 1 (ev-user "(get (with-meta [1 2] {:k 1}) 0)")))
  (is (= 2 (ev-user "(nth (with-meta [1 2] {:k 1}) 1)")))
  (is (= [1 2 3] (ev-user "(conj (with-meta [1 2] {:k 1}) 3)"))))

(deftest meta-vector-round-trips
  (is (= {:k 1} (ev-user "(meta (with-meta [1 2] {:k 1}))")))
  (is (= nil (ev-user "(meta [1 2])")))
  (is (= nil (ev-user "(meta (with-meta (with-meta [1] {:k 1}) nil))"))))

(deftest meta-vector-conj-and-assoc-carry
  (is (= {:k 1} (ev-user "(meta (conj (with-meta [1] {:k 1}) 2))")))
  (is (= {:k 1} (ev-user "(meta (assoc (with-meta [1] {:k 1}) 0 9))"))))

(deftest meta-vector-vary-meta
  (is (= {:k 1} (ev-user "(meta (vary-meta [1] assoc :k 1))")))
  (is (= {:k 1 :j 2} (ev-user "(meta (vary-meta (with-meta [1] {:k 1}) assoc :j 2))"))))

(deftest meta-vector-invisible-to-equality
  (is (= true (ev-user "(= (with-meta [1 2] {:k 1}) [1 2])")))
  (is (= true (ev-user "(= [1 2] (with-meta [1 2] {:k 1}))")))
  (is (= "[1 2]" (ev-user "(pr-str (with-meta [1 2] {:k 1}))"))))

(deftest meta-vector-invisible-to-hashing
  (is (= :found (ev-user "(get {(with-meta [1 2] {:k 1}) :found} [1 2])")))
  (is (= :found (ev-user "(get (assoc {} (with-meta [1 2] {:k 1}) :found) [1 2])")))
  (is (= :found (ev-user "(get {[1 2] :found} (with-meta [1 2] {:k 1}))")))
  (is (= true (ev-user "(contains? {(with-meta [1 2] {:k 1}) :x} [1 2])")))
  (is (= 1 (ev-user "(count (distinct [(with-meta [1 2] {:k 1}) [1 2]]))")))
  (is (= 1 (ev-user "(count (into #{} [(with-meta [1 2] {:k 1}) [1 2]]))")))
  (is (= :x (ev-user "(get (zipmap [(with-meta [1 2] {:k 1})] [:x]) [1 2])")))
  (is (= 2 (ev-user "(get (frequencies [(with-meta [1 2] {:k 1}) [1 2]]) [1 2])"))))

(deftest meta-vector-nested-invisible-to-hashing
  (is (= :x (ev-user "(get {[(with-meta [1] {:k 1})] :x} [[1]])")))
  (is (= :x (ev-user "(get {{:a (with-meta [1] {:k 1})} :x} {:a [1]})")))
  (is (= true (ev-user "(= {:a (with-meta [1] {:k 1})} {:a [1]})"))))

; ── wave14 metadata: into chooses by size (BUG-008) ──────────────────────

(deftest meta-into-same-results
  (is (= [1 2 3] (ev-user "(into [1] [2 3])")))
  (is (= {:a 1} (ev-user "(into {} [[:a 1]])")))
  (is (= 2 (ev-user "(count (into #{} [1 2 2]))")))
  (is (= [2 3 4] (ev-user "(into [] (map inc [1 2 3]))"))))

(deftest meta-into-threshold
  ; 8192 is the measured crossover; span it in both directions.
  (is (= 100 (ev-user "(count (into [] (range 100)))")))
  (is (= 20000 (ev-user "(count (into [] (range 20000)))"))))

(deftest meta-into-lazy-from-not-forced
  ; Counting an infinite seq to choose a path would hang; taking from it must
  ; stay lazy.
  (is (= 5 (ev-user "(count (into [] (take 5 (iterate inc 0))))"))))

; ── wave14 metadata: map entries (BUG-010) ───────────────────────────────

(deftest meta-map-entries-list-is-an-entry
  (is (= {:a 1} (ev-user "(into {} '((:a 1)))")))
  (is (= {:a 1} (ev-user "(conj {} '(:a 1))")))
  (is (= {:a 1 :b 2} (ev-user "(into {} '((:a 1) (:b 2)))"))))

(deftest meta-map-entries-wrong-length-fails
  (is (includes? (try
                   (do (ev-user "(conj {} '(:a 1 2))") :no-raise)
                   (catch ArgumentError e (ex-message e)))
                 "two-element entry")))
