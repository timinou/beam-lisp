; identity_test.bl — vm.paths + vm.names (PLAN-123 D1).
;
; The daemon's on-disk identity and its hostnames are pure functions, now
; beam-lisp. These pin them against the values the Elixir Paths/Names produced,
; so the bl port cannot drift from the Rust launcher's copy (which keys the
; socket a client looks for) or the gateway's routes.

(ns vm.identity-test
  (:require [vm.paths :as paths] [vm.names :as names]))

(def ROOT "/home/user/code/undefine/beam-lisp")

(deftest tree-id-is-16-hex-of-sha256
  (testing "tree-id matches the Rust launcher + Elixir Paths byte-for-byte"
    (is (= "57461829a20cc2af" (paths/tree-id ROOT)))
    (testing "the fingerprint is the full 32-byte sha256"
      (is (= "57461829A20CC2AF4C1F543084363EC1622C8B8D01A076F973496AAC5E9BB5B9"
             (erlang/apply :binary :encode_hex (list (paths/fingerprint ROOT))))))))

(deftest endpoints-are-under-the-runtime-dir
  (testing "every endpoint path is <runtime>/<tree-id>.<ext>"
    (let [r (paths/endpoints ROOT)
          ep (:ok r)]
      (is (some? ep))
      (is (= "57461829a20cc2af" (:tree-id ep)))
      (is (clojure.string/ends-with? (:sock ep) "57461829a20cc2af.sock"))
      (is (clojure.string/ends-with? (:token ep) "57461829a20cc2af.token"))
      (is (clojure.string/ends-with? (:lock ep) "57461829a20cc2af.start")))))

(deftest slug-is-a-single-dns-label
  (testing "lowercased, non-alnum folded to one -, trimmed"
    (is (= "my-app-name" (names/slug "My.App Name!")))
    (is (= "" (names/slug "!!!")))
    (is (= "" (names/slug nil)))
    (is (= "feature-x" (names/slug "feature/x")))))

(deftest hosts-carry-the-port-name
  (testing "a named port answers at <label>.<base>.<suffix>; :ui at the base"
    (is (= "beam-lisp.test" (names/host ROOT "ui")))
    (is (= "web.beam-lisp.test" (names/host ROOT "web")))
    (is (= (list "web.beam-lisp.test" "web.beam-lisp.localhost")
           (to-list (names/hosts ROOT "web"))))
    (testing ":ui contributes no label"
      (is (nil? (names/label "ui"))))))

(run-tests)
