; schedules_test.bl — the schedules pane: one model, two faces, and a read path
; that cannot write.
;
; vm.inspect's covenant is that the terminal and the browser cannot disagree,
; because there is ONE model and two renderers. This proves it for the schedules
; pane the hard way: it renders both faces from the same model and compares the
; NUMBERS, so a field added to one face and not the other fails here.
;
; It also proves the property the pane's design depends on — rendering does not
; write — and it does so with an observable rather than an assertion of intent:
; the store's own BASIS. A transaction advances it; a read cannot (FUP-101).

(ns vm.schedules-test
  (:require [proc :as proc] [datom :as datom] [vm.inspect :as inspect]))

(def fires (atom 0))

(proc/defserver pane-probe
  (sched {:clock proc/wall-ms}
    (every 40 :ms :tick (fn [_] (swap! fires inc)) {:catch-up :skip})))

(defn- row-for [m srv id]
  (first (filter (fn [r] (and (= srv (:server r)) (= id (:id r)))) (:schedules m))))

(defn- jrow [srv id]
  (first (filter (fn [x] (= (str srv "/" id) (get x "key")))
                 (get (inspect/json {}) "schedules"))))

;; ── the pane is complete before anything runs ───────────────────────────

(deftest a-declared-schedule-appears-before-it-ever-runs
  ;; The row is written at BOOT, not on the first fire. A pane that showed only
  ;; what has RUN would hide exactly the schedule an operator came to look for —
  ;; the one that has not fired, which is usually the one that is wrong.
  (let [s (start pane-probe nil {})]
    (let [r (row-for (inspect/model {}) "pane-probe" "tick")]
      (is (some? r) "it is in the model the moment it is declared")
      (is (= :active (:state r)))
      (is (= true (:live r)) "…and the model says a scheduler is answering for it")
      (is (some? (:in-ms r)) "…and how far off its next occurrence is"))
    (stop s))

  ;; and it is STILL there with no process running: the store outlives the
  ;; scheduler, which is the whole reason it is a store
  (let [r (row-for (inspect/model {}) "pane-probe" "tick")]
    (is (some? r) "the declaration outlives the process that ran it")
    (is (= false (:live r)) "…and the model says so rather than pretending")))

;; ── one model, two faces ────────────────────────────────────────────────

(deftest the-two-faces-render-the-same-numbers
  (let [s (start pane-probe nil {})]
    (Process/sleep 130)
    ;; Freeze the ticker FIRST. The two faces are two model reads — `json`
    ;; builds its own model, not the one `m` already holds — and a live 40 ms
    ;; schedule ticks between them, so "the same numbers" is racy while the
    ;; scheduler runs. Pausing makes it decidable. (Same lesson the basis test
    ;; below learned: remove the other writer before comparing.)
    (proc/op! "pane-probe" "tick" :pause)
    (Process/sleep 50)
    (let [m (inspect/model {})
          r (row-for m "pane-probe" "tick")
          text (inspect/render-text m)
          j (jrow "pane-probe" "tick")]
      (is (>= (:runs r) 1) "it ran, so there is a number worth agreeing about")
      (is (= (:runs r) (get j "runs"))
          "the JSON face and the model are the same number")
      (is (String/contains? text (str (:runs r) " runs"))
          "the TERMINAL face shows that same number")
      (is (String/contains? text "pane-probe/tick") "…and names the schedule")
      ;; the nearest thing to a delivered guarantee: the two faces describe one
      ;; value, so they cannot drift apart by construction
      (is (= (:state r) (keyword (get j "state")))))
    (stop s)))

;; ── the property the pane's design rests on ─────────────────────────────

(deftest rendering-does-not-write
  ;; A render that transacted would queue behind the scheduler's writer — this
  ;; host has ONE dirty-IO scheduler, so a dashboard could slow down the work it
  ;; reports. The basis is the observable: a transaction advances it and a read
  ;; cannot.
  ;;
  ;; The scheduler is STOPPED first, and not for convenience: it writes on every
  ;; wake, so measuring the basis with a ticker running beside us would measure
  ;; the ticker. Removing the only other writer is what makes a moved basis mean
  ;; the render moved it. (The first version of this test failed for exactly that
  ;; reason — the number it caught was the scheduler's, not the pane's.)
  (let [s (start pane-probe nil {})]
    (Process/sleep 80)
    (stop s)
    (Process/sleep 30)
    (let [before (datom/basis-t (datom/db (proc/conn)))]
      (is (some? (row-for (inspect/model {}) "pane-probe" "tick"))
          "the row is still there to be read with no scheduler running")
      (reduce (fn [_ _] (inspect/model {})) nil (range 50))
      (is (= before (datom/basis-t (datom/db (proc/conn))))
          "50 renders advanced the store's basis — something on the render path wrote")
      (is (= before (do (inspect/json {})
                        (inspect/render-text (inspect/model {}))
                        (inspect/schedules-json {})
                        (datom/basis-t (datom/db (proc/conn)))))
          "…and all three faces are equally read-only"))))

;; ── the write path reaches a process it was never handed ────────────────

(deftest ops-reach-the-scheduler-by-name
  ;; The pane has the STORE and nothing else. It still has to be able to pause a
  ;; schedule, so the name a scheduler answers to is derived from its
  ;; declaration — the same trick vm.exec uses for the sequencer.
  (let [s (start pane-probe nil {})]
    (Process/sleep 60)
    (is (= true (:ok (proc/op! "pane-probe" "tick" :pause))))
    (Process/sleep 40)
    (is (= :paused (:state (row-for (inspect/model {}) "pane-probe" "tick")))
        "the pause reached the process, and the STORE shows it")
    (proc/op! "pane-probe" "tick" :resume)
    (is (= :active (:state (row-for (inspect/model {}) "pane-probe" "tick"))))
    (stop s)))

(deftest two-schedulers-for-one-declaration-are-refused
  ;; Not defensiveness: two of them would write the same rows under the same
  ;; keys, so the second is a second writer of ONE fact — not slower, wrong. The
  ;; refusal is against a LIVE holder only, so a predecessor that stopped
  ;; properly never blocks its successor.
  ;;
  ;; This got its own test because the example found it the hard way: it leaked a
  ;; scheduler, the next `start` died, and `:erlang.register`'s `badarg` said
  ;; nothing about why. The message now names the holder, and the reason.
  (let [s (start pane-probe nil {})]
    (is (thrown? (start pane-probe nil {})))
    (stop s))
  ;; and once it has properly stopped, the name is free again
  (let [s (start pane-probe nil {})]
    (is (some? s) "a stopped scheduler does not block the next one")
    (stop s)))

(deftest an-op-with-nothing-listening-says-so
  ;; 'nothing is listening' is a fact about the world, not an error in the
  ;; request: a button that silently does nothing is worse than one that is
  ;; disabled, and a page that cannot say why is worse than both.
  (let [r (proc/op! "no-such-server" "tick" :pause)]
    (is (= false (:ok r)))
    (is (String/contains? (:reason r) "no scheduler"))))
