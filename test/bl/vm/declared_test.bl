; declared_test.bl — a project file's periodic work: read, validated, armed.
;
; The path this proves is the one P4 exists for — a tree DECLARES its periodic
; work and the runtime does the rest:
;
;   env.bl :schedules  →  bl.env validates  →  vm.spec carries
;                      →  vm.sched arms a wheel  →  the verb runs
;                      →  the pane shows what happened
;
; Five things are worth pinning, and each of the five is a way the design could
; be locally right and systemically wrong:
;
;   * a bad declaration is DATA, not a crash (the project keeps its tool)
;   * a declared schedule appears BEFORE it ever runs, and survives its process
;   * the occurrence carries the TREE, because a daemon hosts several and one
;     of them pruning another's stores is not a smaller mistake, it is a wrong one
;   * an unresolvable verb is not resolved at ARMING (a project may name a verb
;     it has not written yet) and the failure lands on the SCHEDULE, where a
;     pane shows it, rather than on the command that spawned the VM
;   * asking twice is one wheel

(ns vm.declared-test
  (:require [bl.env :as env]
            [vm.spec :as spec]
            [vm.sched :as sched]
            [vm.inspect :as inspect]
            [proc.sched :as psched]))

(defn- row-for [m srv id]
  (first (filter (fn [r] (and (= srv (:server r)) (= id (:id r)))) (:schedules m))))

(defn- tmp-dir []
  (str "/tmp/bl-declared-" (erlang/apply :erlang :unique_integer (list (to-list [:positive])))))

;; ── the file is read, and its mistakes are values ───────────────────────

(deftest a-declaration-is-validated-and-refused-as-data
  (let [r (env/normalize
            {:schedules
             [{:id "ok"    :every [30 :min] :run "bl.cache/prune-scheduled"}
              {:id "two"   :every [1 :h] :daily [1 2] :run "a/b"}
              {:id "clock" :daily [25 0] :run "a/b"}
              {:id "typo"  :every [1 :h] :evry [1 :h] :run "a/b"}
              {:every [1 :h] :run "a/b"}
              {:id "verb"  :every [1 :h] :run "not-a-verb"}]}
            "/tmp/x" "/tmp/x/env.bl")
        errs (:errors r)]
    (is (= 1 (count (:schedules r))) "only the well-formed declaration survives")
    (is (= "ok" (:id (first (:schedules r)))))
    (is (= 5 (count errs)) "every problem is reported, in one pass")
    (is (some (fn [e] (includes? e "must say exactly one of")) errs) "two frequencies")
    (is (some (fn [e] (includes? e "not a time on a clock")) errs) "25:00")
    (is (some (fn [e] (includes? e "has unknown key evry")) errs) "a typo")
    (is (some (fn [e] (includes? e "needs an :id")) errs) "no id")
    (is (some (fn [e] (includes? e "namespace/verb")) errs) "a verb that is not one")))

(deftest a-project-file-s-declarations-reach-the-spec
  (let [d (tmp-dir)]
    (File/mkdir_p! d)
    (File/write! (str d "/env.bl")
                 (str "{:name \"declared-probe\"\n"
                      " :schedules [{:id \"a\" :every [1 :h] :run \"x/y\"}\n"
                      "             {:id \"b\" :daily [4 5] :run \"x/z\"}]}\n"))
    (let [sp (spec/read d)]
      (is (= 2 (count (:schedules sp))))
      (is (= ["a" "b"] (map (fn [s] (:id s)) (:schedules sp))))
      (is (= [1 :h] (:every (first (:schedules sp))))))
    (File/rm_rf! d)))

(deftest a-tree-with-no-declarations-arms-nothing
  (is (nil? (sched/start-for {:id "declared-test@none" :root "/tmp" :schedules []}))
      "a project that declares no periodic work gets no process, not an idle one")
  (is (= false (sched/armed? "declared-test@none"))))

; ── the owner's context, exactly ────────────────────────────────────────

(deftest a-declaration-s-body-resolves-and-the-tree-rides-in-its-occurrence
  ;; `from-data` is where a NAME becomes a body and where the owner's `:ctx` is
  ;; merged in. Both are provable exactly, with a verb that already exists:
  ;; `core/count` answers the SIZE of the occurrence it is handed, so 3 vs 4 is
  ;; the whole chain — a declaration, its resolution, and the tree's root
  ;; arriving in the map a body sees.
  ;;
  ;; The verb must be one the SERVER can resolve: a wheel fires in its own
  ;; process, where a test file's own namespace is not on the load path (the
  ;; ward loads test files by path, and a dynamically-added search dir does not
  ;; ride along to a process spawned later). A test verb named in the test file
  ;; is therefore resolvable from the test and NOT from the schedule — measured.
  (let [occ {:id :probe :due 1 :occurrence "o"}
        bare  (psched/from-data [{:id :probe :every [1 :h] :run "core/count"}])
        bound (psched/from-data [{:id :probe :every [1 :h] :run "core/count"
                                  :ctx {:root "/tree"}}])]
    (is (= 3 ((:run (first bare)) occ)) "the occurrence is three keys")
    (is (= 4 ((:run (first bound)) occ)) "…and the owner's context rides in it")
    (is (includes? (get ((:run (first bound)) occ) 0 "") "")
        "…the keys it hands the verb include the root")))

(deftest the-context-a-wheel-is-armed-with-names-the-tree
  (let [bound (sched/bind-context
                [{:id "x" :every [1 :h] :run "core/count"}] "/some/tree")]
    (is (= 1 (count bound)))
    (is (= {:root "/some/tree"} (:ctx (first bound))))
    (is (= "x" (:id (first bound))) "…and the declaration is otherwise untouched")
    (is (= [1 :h] (:every (first bound))))))

;; ── a wheel turns, and the pane sees it ─────────────────────────────────

(deftest a-trees-declared-work-is-armed-visible-and-run
  (let [vm {:id "declared-test@t1"
            :root (BeamLisp/cwd)
            ;; A verb that exists in the tree and does nothing when there is
            ;; nothing to do: with no index owner it answers `:no-owner` and
            ;; returns. What is being proved is the WHEEL — armed, turning,
            ;; recorded — not the verb.
            :schedules [{:id "refresh"
                         :every [60 :ms]
                         :run "vm.index/refresh-scheduled"}]}]
    (let [p (sched/start-for vm)]
      (is (some? p) "a wheel was started")
      (is (= true (sched/armed? "declared-test@t1")))
      (is (= p (sched/start-for vm)) "asking twice is the same wheel, not two writers")

      (Process/sleep 170)

      (let [r (row-for (inspect/model {}) "declared-test@t1" "refresh")]
        (is (some? r) "the pane knows it")
        (is (= true (:live r)))
        (is (= 0 (:fails r)) (str "the verb must resolve — " (:last-error r)))
        (is (>= (:runs r) 2) "…and how many times it has run"))

      (is (= :stopped (sched/stop-for vm)))
      (is (= false (sched/armed? "declared-test@t1")) "stopping frees the name"))))

(deftest a-verb-that-does-not-resolve-fails-on-the-schedule
  ;; NOT at arming: a project may name a verb it has not written yet, and a tree
  ;; must not lose its tool to a typo. The failure is a NUMBER and a MESSAGE on
  ;; the schedule the pane shows — loud where a human is looking, and silent
  ;; nowhere else but the tree's own work.
  (let [vm {:id "declared-test@t2"
            :root (BeamLisp/cwd)
            :schedules [{:id "bogus" :every [50 :ms] :run "no.such-ns/nope"}]}]
    (let [p (sched/start-for vm)]
      (is (some? p) "arming succeeds — a name is not resolved until it fires")
      ;; Longer than the wheel's two periods by a wide margin: the point is not
      ;; punctuality, it is that a failure LANDS. (Measured: 140 ms was enough
      ;; on an idle machine and not enough beside the rest of the suite.)
      (Process/sleep 300)
      (let [r (row-for (inspect/model {}) "declared-test@t2" "bogus")]
        (is (some? r))
        (is (= 0 (:runs r)) "it never ran")
        (is (>= (:fails r) 1) "…and the failure is recorded")
        (is (some? (:last-error r)) "…with its reason"))
      (sched/stop-for vm))))
