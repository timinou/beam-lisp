; console_guard_test.bl — every route of the session console is guarded, not only /machine.
;
; The console binds loopback, but a web page the user visits can still reach it two
; ways: DNS rebinding (a hostile name that resolves to 127.0.0.1) and a cross-site
; POST. The machine routes had a Host guard and a token guard; the session routes
; (the dashboard, /model, /schedules, /repl, /mcp, /intent ...) had neither, and the
; dashboard page carries the session token, so reading it disclosed the credential
; that authorizes everything else. This drives real requests with a hostile Host.

(ns vm.console-guard-test
  (:require [web] [vm.http :as http]))

(def TOKEN (erlang/apply :crypto :strong_rand_bytes (list 32)))
(def HEX (String/downcase (Base/encode16 TOKEN)))
(def EVIL "evil.example.com")

(defn- includes? [s sub] (String/contains? s sub))

(def CONNECT-MS 3000)
(def FIRST-RENDER-MS 30000)   ; the dashboard's first render builds the model: seconds, measured 5.4 s

(defn- read-all [cs acc]
  (let [r (erlang/apply :gen_tcp :recv (list cs 0 FIRST-RENDER-MS))]
    (if (and (erlang/is_tuple r) (= :ok (elem r 0))) (read-all cs (str acc (elem r 1))) acc)))

(defn- request
  ([port method path headers] (request port method path headers ""))
  ([port method path headers body]
   (let [cs (elem (erlang/apply :gen_tcp :connect
                    (list (tuple 127 0 0 1) port
                          (to-list [:binary (tuple :packet :raw) (tuple :active false)]) CONNECT-MS)) 1)
         hdr (join "" (map (fn [kv] (str (first kv) ": " (second kv) "\r\n")) headers))]
     (erlang/apply :gen_tcp :send
       (list cs (str method " " path " HTTP/1.1\r\n" hdr "content-length: " (erlang/byte_size body)
                     "\r\nconnection: close\r\n\r\n" body)))
     (read-all cs ""))))

(defn- status-of [resp] (second (split (first (split resp "\r\n")) " ")))
(defn- body-of [resp] (let [p (split resp "\r\n\r\n")] (if (> (count p) 1) (join "\r\n\r\n" (rest p)) "")))

(def PORT (let [p (+ 28000 (rem (erlang/system_time :millisecond) 3000))]
            (http/serve p {:root (BeamLisp/cwd) :tree-id "t" :token TOKEN
                           :started-at (erlang/system_time :second)})
            (erlang/apply :timer :sleep (list 500))
            p))

(def READ-ROUTES ["/" "/model" "/ports" "/index" "/schedules" "/pipelines" "/repl" "/catalog"])
(def WRITE-ROUTES ["/mcp" "/intent" "/index"])

(deftest every-read-route-refuses-a-hostile-host
  (doseq [p READ-ROUTES]
    (let [r (request PORT "GET" p [["host" EVIL]])]
      (is (= "403" (status-of r)) (str "GET " p " under Host " EVIL))
      (is (not (includes? (body-of r) HEX)) (str p " must not disclose the session token")))))

(deftest every-write-route-refuses-a-hostile-host
  (doseq [p WRITE-ROUTES]
    (is (= "403" (status-of (request PORT "POST" p [["host" EVIL]] "{}"))) (str "POST " p))))

(deftest the-dashboard-still-answers-to-loopback
  (let [r (request PORT "GET" "/" [["host" "127.0.0.1"]])]
    (is (= "200" (status-of r)) "the guard must not lock the owner out")))

(deftest the-model-still-answers-to-localhost
  (is (= "200" (status-of (request PORT "GET" "/model" [["host" (str "localhost:" PORT)]])))))

(deftest writes-need-the-token-even-from-a-good-host
  (doseq [p WRITE-ROUTES]
    (let [no (request PORT "POST" p [["host" "127.0.0.1"]] "{}")]
      (is (contains? #{"401" "403"} (status-of no)) (str "POST " p " without a token: " (status-of no))))))

(deftest a-write-with-the-token-from-a-good-host-is-not-refused-by-the-guard
  (let [r (request PORT "POST" "/mcp" [["host" "127.0.0.1"] ["x-bl-token" HEX]] "{}")]
    (is (not (contains? #{"401" "403"} (status-of r))) (str "got " (status-of r)))))

(run-tests)
