(ns vm.net-build-identity-test
 (:require [vm.net :as net] [vm.paths :as paths] [vm.osenv :as osenv]))
(defn hello-generation [endpoint build generation]
 (let [conn (elem (gen_tcp/connect
                   (tuple :local (erlang/binary_to_list (:sock endpoint))) 0
                   (list (tuple :inet_backend :inet) :local :binary
                         (tuple :packet 4) (tuple :active false)) 5000) 1)]
  (try
   (gen_tcp/send conn (erlang/term_to_binary
    (tuple :bl 1 :hello {:tree (paths/hello-fingerprint nil (:build endpoint) true)
                        :token (File/read! (:token endpoint)) :build build
                        :checkout_generation generation})))
   (let [received (gen_tcp/recv conn 0 5000)]
    (if (= :ok (elem received 0)) (erlang/binary_to_term (elem received 1)) received))
   (finally (gen_tcp/close conn)))))
(defn hello [endpoint build] (hello-generation endpoint build nil))

(deftest socket-handshake-uses-bound-endpoint-build-not-connection-ambient-env
 (let [runtime (str (System/user_home!) "/.tmp/netid-" (erlang/unique_integer (list :positive)))
       build "bound-build-42"]
  (File/mkdir_p! runtime) (File/chmod runtime 448)
  (try
   (osenv/with-env {"BL_BUILD_ID" build "XDG_RUNTIME_DIR" runtime}
    (fn []
     (let [endpoint (:ok (paths/endpoints nil (paths/build-id) true))
           started (net/listen nil (fn [_ _] nil) {:shared true})
           listener (:ok started)]
      (println "net-build-identity-start" {:build (paths/build-id)
        :overlay-build (osenv/get "BL_BUILD_ID") :error (:error started)})
      (assert listener "listener startup must succeed before handshake assertions")
      (try
       (is (erlang/is_pid (:pid listener)))
       (is (= :ready (elem (hello-generation endpoint (:build endpoint)
                            (System/get_env "BL_CHECKOUT_GENERATION")) 2)))
       (let [rejected (hello-generation endpoint (:build endpoint) "changed-checkout")]
         (is (= :reject (elem rejected 2)))
         (is (= :restart_required (elem rejected 3))))
       (let [ready (hello endpoint (:build endpoint))]
        (is (= :ready (elem ready 2)))
        (is (= (:build endpoint) (:build (elem ready 3)))))
       (osenv/with-env {"BL_BUILD_ID" "changed" "XDG_RUNTIME_DIR" runtime}
        (fn []
         (is (= :ready (elem (hello endpoint (:build endpoint)) 2)))
         (let [rejected (hello endpoint "wrong-build")]
          (is (= :reject (elem rejected 2)))
          (is (= :restart_required (elem rejected 3))))))
       (finally (net/stop listener))))))
   (finally (File/rm_rf! runtime)))))
