(ns vm.native-roots-test (:require [vm.native :as native]))

(defn- roots [project platform]
  (vec (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "vm.native" "source-native-roots")
                            (list project platform))))

(deftest consumer-and-platform-native-roots-are-both-considered
  (let [root (str (System/tmp_dir!) "/native-roots-" (erlang/unique_integer (list :positive)))
        project (str root "/project") platform (str root "/language")]
    (try
      (File/mkdir_p! (str project "/native"))
      (File/mkdir_p! (str platform "/native"))
      (is (= [project platform] (roots project platform)))
      (is (= [project] (roots project project)))
      (is (= [project] (roots project nil)))
      (is (= [platform] (roots (str root "/absent") platform)))
      (is (= [] (roots (str root "/absent") nil)))
      (finally (File/rm_rf! root)))))
