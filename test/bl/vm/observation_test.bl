(ns vm.observation-test
 (:require [vm.observation :as observation] [runtime.observation :as contract]
           [vm.scope :as scope] [vm.owner :as owner] [bl.json :as json]))
(defn- wait-for [pred]
 (loop [n 200] (cond (pred) true (zero? n) false :else (do (Process/sleep 5) (recur (dec n))))))
(deftest foreground-snapshot-is-scoped-and-bounded
 (let [captured (scope/with-vm nil observation/capture)
       a (observation/snapshot captured) b (observation/snapshot captured)]
  (is (= contract/schema (:schema a)))
  (is (= "beam" (:target a)))
  (is (= 1 (:total a)))
  (is (= 1 (count (:resources a))))
  (is (= (inc (:sequence a)) (:sequence b)))
  (is (not (:truncated a)))
  (is (string? (json/encode a)))
  (is (not (contains? (first (:resources a)) :messages)))
  (is (thrown? (observation/snapshot captured 129)))))
(deftest existing-owner-membership-is-the-only-authority
 (let [a (str "observation-a-" (System/unique_integer (list :positive)))
       b (str "observation-b-" (System/unique_integer (list :positive)))
       p (owner/spawn a :one (fn [] (receive :stop :ok)))
       q (owner/spawn a :two (fn [] (receive :stop :ok)))
       other (owner/spawn b :other (fn [] (receive :stop :ok)))
       captured (scope/with-vm a observation/capture)]
  (try
   (let [s (observation/snapshot captured 1)]
    (is (= 2 (:total s))) (is (:truncated s))
    (is (= 1 (count (:resources s))))
    (is (= 1 (get-in s [:query :examined])))
    (is (get-in s [:query :indexed]))
    (is (not (some (fn [r] (= (pr-str other) (:id r))) (:resources s)))))
   (erlang/send p :stop)
   (is (wait-for (fn [] (= 1 (:total (observation/snapshot captured))))))
   (finally (doseq [pid [p q other]] (when (Process/alive? pid) (erlang/exit pid :kill)))))))
(deftest history-pressure-cannot-evict-active-work
 (let [old {:id "old" :status :running} cancelling {:id "cancel" :status :cancelling}
       completed (mapv (fn [n] {:id n :status :done}) (range 40))
       rows (contract/retain-history (concat completed [old cancelling]) 32)]
  (is (= 32 (count rows)))
  (is (= [old cancelling] (subvec rows 0 2)))
  (is (= [old cancelling] (contract/retain-history [old cancelling] 1)))
  (is (thrown? (contract/retain-history [] 0)))))
