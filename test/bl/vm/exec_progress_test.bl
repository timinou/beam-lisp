(ns vm.exec-progress-test (:require [vm.exec :as exec]))

(defn await-count [n attempts]
 (if (= n (:queued (exec/state))) true
  (if (= attempts 0) false
   (do (Process/sleep 10) (await-count n (- attempts 1))))))

(deftest status-reads-never-create-caller-owned-tables
 (let [parent (erlang/self)
       child (spawn (fn [] (erlang/send parent [:snapshot (exec/state)]))) ]
  (is (map? (receive [:snapshot value] value (after 1000 nil))))
  (let [p (exec/start)]
   (try (is (= 7 (exec/run-reload (fn [] 7))))
        (finally (GenServer/stop p :normal 30000))))))

(deftest concurrent-tickets-and-caller-death-are-accounted-while-work-blocks
 (let [p (exec/start) parent (erlang/self)
       blocker (spawn (fn []
                       (exec/run-reload
                        (fn [] (erlang/send parent [:blocked (erlang/self)])
                         (receive :release :ok (after 10000 :timeout))))
                       (erlang/send parent :blocker-done)))]
  (try
   (is (= p (receive [:blocked worker] worker (after 3000 nil))))
   (let [workers (vec (map (fn [_] (spawn (fn [] (exec/run-reload (fn [] :ok))
                                                      (erlang/send parent :done)))) (range 32)))]
    (is (await-count 33 300))
    (erlang/exit (first workers) :kill)
    ;; Accepted work belongs to the sequencer and must still drain.
    (is (= 33 (:queued (exec/state))))
    (erlang/send p :release)
    (is (= :blocker-done (receive :blocker-done :blocker-done (after 3000 :timeout))))
    (doseq [_ (range 31)] (receive :done :ok (after 3000 (throw "worker failed to drain"))))
    (is (await-count 0 300))
    (is (= nil (:busy (exec/state)))))
   (finally (erlang/send p :release) (GenServer/stop p :normal 30000)))))

(deftest sequencer-death-clears-status-and-restart-attaches-cleanly
 (let [p (exec/start) parent (erlang/self)
       child (spawn (fn [] (try (exec/run-reload (fn [] (erlang/send parent :running)
                                                         (receive (after 10000 nil))))
                                (catch _ nil)) (erlang/send parent :caller-finished)))]
  (try
   (is (= :running (receive :running :running (after 3000 nil))))
   (erlang/exit p :kill)
   (is (await-count 0 300))
   (is (= :caller-finished (receive :caller-finished :caller-finished (after 3000 :timeout))))
   (let [next (exec/start)]
    (try (is (= :ready (exec/run-reload (fn [] :ready))))
         (finally (GenServer/stop next :normal 30000))))
   (finally (erlang/exit child :kill)))))

(deftest nested-submission-refuses-instead-of-deadlocking
 (let [p (exec/start)]
  (try
   (is (contains? (exec/run-reload (fn [] (exec/run-reload (fn [] :unreachable)))) :error))
   (is (await-count 0 300))
   (finally (GenServer/stop p :normal 30000)))))
