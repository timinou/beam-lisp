; gateway_test.bl — vm.gateway, the reverse proxy that answers names (FUP-085).
;
; The registry IS the routing table: a claim carries the hosts it answers to,
; so the gateway routes by Host: without reading any env.bl. These prove the
; whole edge end to end in-process — a claim, a backend, a proxied request that
; comes back with the backend's bytes; a CONNECT tunnel served with a vm.ca leaf
; that verifies against the root; and the pure address/probe functions the
; verbs print with — the behaviour the 1046-line Elixir Gateway guaranteed.

(ns vm.gateway-test
  (:require [vm.gateway :as gw] [vm.ports :as ports] [vm.ca :as ca]))

(def ROOT (BeamLisp/cwd))

(defn- echo-backend
  "Claim `name` (ephemeral), bind a one-shot HTTP backend on the claimed port
   that answers `body`, and return the port."
  [name host body]
  (let [port (:ok (ports/claim name 0 {:root ROOT :hosts (to-list [host])}))
        bsock (elem (erlang/apply :gen_tcp :listen
                      (list port (to-list [:binary (tuple :packet :raw) (tuple :active false)
                                           (tuple :reuseaddr true) (tuple :ip (tuple 127 0 0 1))]))) 1)]
    (spawn (fn []
      (loop []
        (let [ar (erlang/apply :gen_tcp :accept (list bsock :infinity))]
          (when (= :ok (elem ar 0))
            (let [c (elem ar 1)]
              (spawn (fn []
                (erlang/apply :gen_tcp :recv (list c 0 5000))
                (erlang/apply :gen_tcp :send
                  (list c (str "HTTP/1.1 200 OK\r\ncontent-length: " (count body)
                               "\r\nconnection: close\r\n\r\n" body)))
                (erlang/apply :gen_tcp :close (list c))))
              (recur)))))))
    port))

(defn- start-gw []
  (spawn (fn [] (gw/run {:port 0})))
  (erlang/apply :timer :sleep (list 800))
  (gw/port))

(deftest routes-come-from-the-claim-registry
  (testing "a claim carrying hosts registers a route; one without does not"
    (ports/claim "gwr" 0 {:root ROOT :hosts (to-list ["gwr.beam-lisp.test"])})
    (is (some (fn [c] (= "gwr" (:name c))) (gw/routes)))
    (ports/release "gwr" {:root ROOT})))

(deftest a-named-request-is-spliced-to-its-backend
  (testing "the gateway routes an HTTP request by Host: to the claimed port"
    (echo-backend "gwe" "gwe.beam-lisp.test" "HELLO")
    (let [gwport (start-gw)
          cs (elem (erlang/apply :gen_tcp :connect
                     (list (tuple 127 0 0 1) gwport
                           (to-list [:binary (tuple :packet :raw) (tuple :active false)]) 3000)) 1)]
      (erlang/apply :gen_tcp :send
        (list cs "GET / HTTP/1.1\r\nhost: gwe.beam-lisp.test\r\nconnection: close\r\n\r\n"))
      (let [resp (elem (erlang/apply :gen_tcp :recv (list cs 0 3000)) 1)]
        (is (String/contains? resp "HELLO")))
      (ports/release "gwe" {:root ROOT}))))

(deftest an-unknown-name-is-refused-with-the-marker
  (testing "a name no claim holds gets a 404 carrying the gateway marker header"
    (let [gwport (start-gw)
          cs (elem (erlang/apply :gen_tcp :connect
                     (list (tuple 127 0 0 1) gwport
                           (to-list [:binary (tuple :packet :raw) (tuple :active false)]) 3000)) 1)]
      (erlang/apply :gen_tcp :send
        (list cs "GET / HTTP/1.1\r\nhost: nobody.beam-lisp.test\r\nconnection: close\r\n\r\n"))
      (let [resp (elem (erlang/apply :gen_tcp :recv (list cs 0 3000)) 1)]
        (is (String/contains? resp "404"))
        (is (String/contains? (String/downcase resp) "x-bl-gateway:"))))))

(deftest a-connect-tunnel-is-served-with-a-ca-leaf
  (testing "CONNECT upgrades to TLS with a per-name leaf that verifies against the root"
    (erlang/apply :ssl :start (list))
    (echo-backend "gwt" "gwt.beam-lisp.test" "TLS")
    (let [gwport (start-gw)
          cs (elem (erlang/apply :gen_tcp :connect
                     (list (tuple 127 0 0 1) gwport
                           (to-list [:binary (tuple :packet :raw) (tuple :active false)]) 3000)) 1)]
      (erlang/apply :gen_tcp :send
        (list cs "CONNECT gwt.beam-lisp.test:443 HTTP/1.1\r\nhost: gwt.beam-lisp.test:443\r\n\r\n"))
      (let [est (elem (erlang/apply :gen_tcp :recv (list cs 0 3000)) 1)]
        (is (String/contains? est "200")))
      (let [tr (erlang/apply :ssl :connect
                 (list cs (to-list [(tuple :verify :verify_peer) (tuple :cacerts (list (ca/root-der)))
                                    (tuple :active false)
                                    (tuple :server_name_indication (erlang/binary_to_list "gwt.beam-lisp.test"))]) 5000))]
        (is (= :ok (elem tr 0))))
      (ports/release "gwt" {:root ROOT}))))

(deftest the-address-rule-shows-a-port-only-when-it-must
  (testing "url/3 is a pure function of host, port and whether 80 fronts"
    (is (= "http://web.test/" (gw/url "web.test" 80 false)))
    (is (= "http://web.test/" (gw/url "web.test" 7777 true)))
    (is (= "http://web.test:7777/" (gw/url "web.test" 7777 false)))
    (is (= "http://web.test/" (gw/url "web.test" nil false)))))

(run-tests)
