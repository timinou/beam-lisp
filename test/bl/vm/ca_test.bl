; ca_test.bl — vm.ca, a certificate authority in pure beam-lisp (FUP-085).
;
; Option B: the whole authority is beam-lisp — :public_key + :crypto BIFs, no
; x509 library. These prove the minted chain is CRYPTOGRAPHICALLY VALID
; (pkix_path_validation), that leaves are cached, and that the root survives a
; fresh persistent-term (the reload-survival story, K10).

(ns vm.ca-test
  (:require [vm.ca :as ca]))

(defn- fresh-ca []
  (erlang/apply :code :ensure_loaded (list :public_key))
  (erlang/apply :persistent_term :erase (list (tuple :vm-ca :root)))
  (erlang/apply :persistent_term :erase (list (tuple :vm-ca :leaves)))
  (ca/ensure-started))

(defn- cert-of [opts]
  (erlang/element 2 (some (fn [o] (if (= :cert (erlang/element 1 o)) o nil)) opts)))

(deftest root-is-a-self-signed-ca
  (testing "ensure-started mints a root cert with a PEM the client can trust"
    (let [root (fresh-ca)]
      (is (> (erlang/byte_size (:cert-der root)) 0))
      (is (clojure.string/starts-with? (ca/root-pem) "-----BEGIN CERTIFICATE-----")))))

(deftest a-leaf-verifies-against-the-root
  (testing "a per-name leaf is signed by the root and validates as a chain"
    (fresh-ca)
    (let [opts (:ok (ca/ssl-opts "web.blueprint.test"))
          leaf (cert-of opts)]
      (is (= true (erlang/apply :public_key :pkix_is_issuer (list leaf (ca/root-der)))))
      (is (= :ok (erlang/element 1
                   (erlang/apply :public_key :pkix_path_validation
                     (list (ca/root-der) (list leaf) (list)))))))))

(deftest leaves-are-cached
  (testing "the second ask for a name returns the same opts (no re-mint)"
    (fresh-ca)
    (is (= (:ok (ca/ssl-opts "a.test")) (:ok (ca/ssl-opts "a.test"))))))

(deftest sni-fun-selects-per-name
  (testing "the sni_fun returns a leaf's opts for a handshake name"
    (fresh-ca)
    (let [sf (ca/sni-fun)]
      (is (erlang/is_list (sf (erlang/binary_to_list "b.test"))))
      (is (= :undefined (sf ""))))))

(run-tests)
