; env_test.bl — G5 PROCESS-LOCAL ENV.
;
; The keystone the FIFO was masking: a command's OS-env view must be
; process-local, so two concurrent commands with different env do not race.
; vm.osenv is a process-dictionary overlay; because each command runs in its
; own BEAM process, concurrency is free of a shared env table.

(ns vm.env-test
  (:require [vm.osenv :as osenv]))

(deftest overlay-shadows-os-env
  (testing "an overlay value wins over the real OS env; unnamed keys fall through"
    (is (= "overlaid"
           (osenv/with-env {"BL_TEST_KEY" "overlaid"}
             (fn [] (osenv/get "BL_TEST_KEY")))))
    (testing "HOME (a real OS var) still resolves through the overlay"
      (is (some? (osenv/with-env {"BL_TEST_KEY" "x"}
                   (fn [] (osenv/get "HOME"))))))))

(deftest overlay-default-and-absence
  (testing "an unset key returns the default, nil without one"
    (is (nil? (osenv/get "BL_DEFINITELY_UNSET_XYZ")))
    (is (= "fallback" (osenv/get "BL_DEFINITELY_UNSET_XYZ" "fallback")))))

(deftest overlay-restores-after
  (testing "the overlay is unwound after the dynamic extent"
    (osenv/with-env {"BL_TEST_KEY" "inside"} (fn [] :ok))
    (is (nil? (osenv/get "BL_TEST_KEY")))))

(deftest concurrent-commands-do-not-race
  (testing "N processes each bind a DIFFERENT env; each reads only its own"
    ;; This is the guarantee the node-global System.put_env could not give.
    ;; 50 processes, each with its own FOO, all reading concurrently: every
    ;; one must observe its own value, never a neighbour's.
    (let [parent (erlang/self)
          n 50]
      (doseq [i (range n)]
        (spawn (fn []
                 (let [want (str "val-" i)
                       ;; bind this process's overlay, yield to interleave,
                       ;; then read back — a shared table would show another's
                       got (osenv/with-env {"FOO" want}
                             (fn []
                               (erlang/apply :timer :sleep (list 1))
                               (osenv/get "FOO")))]
                   (erlang/send parent [:result i want got])))))
      (let [ok (loop [seen 0 good 0]
                 (if (= seen n)
                   good
                   (receive [:result _i want got]
                     (recur (inc seen) (if (= want got) (inc good) good)))))]
        (is (= n ok))))))

(run-tests)
