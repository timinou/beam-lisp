; http_test.bl — vm.http, the session's HTTP face (FUP-085).
;
; One model, two faces: the dashboard, /model and /ports all render the SAME
; read-model (vm.inspect) `bl daemon status` shows, so they cannot disagree.
; These start the real dashboard on an ephemeral port and prove each endpoint
; answers — the routing, the read-model JSON, the token guard on writes — the
; contract the Elixir Daemon.HTTP held. (/mcp's own behaviour is mcp.server's;
; here we prove the mount is reachable and refuses a malformed body.)

(ns vm.http-test
  (:require [web] [vm.http :as http] [vm.ports :as ports] [vm.inspect :as inspect]))

(def ROOT (BeamLisp/cwd))
(def TOKEN (erlang/apply :crypto :strong_rand_bytes (list 32)))

;; a tiny loopback HTTP client (gen_tcp) — the corpus has no http client dep
(defn- http-get [port path]
  (let [cs (elem (erlang/apply :gen_tcp :connect
                   (list (tuple 127 0 0 1) port
                         (to-list [:binary (tuple :packet :raw) (tuple :active false)]) 3000)) 1)]
    (erlang/apply :gen_tcp :send (list cs (str "GET " path " HTTP/1.1\r\nhost: 127.0.0.1\r\nconnection: close\r\n\r\n")))
    (read-all cs "")))

(defn- http-post [port path body headers]
  (let [cs (elem (erlang/apply :gen_tcp :connect
                   (list (tuple 127 0 0 1) port
                         (to-list [:binary (tuple :packet :raw) (tuple :active false)]) 3000)) 1)
        hdr (join "" (map (fn [kv] (str (first kv) ": " (second kv) "\r\n")) headers))]
    (erlang/apply :gen_tcp :send
      (list cs (str "POST " path " HTTP/1.1\r\nhost: 127.0.0.1\r\ncontent-length: " (count body)
                    "\r\nconnection: close\r\n" hdr "\r\n" body)))
    (read-all cs "")))

(defn- read-all [cs acc]
  (let [r (erlang/apply :gen_tcp :recv (list cs 0 3000))]
    (if (and (erlang/is_tuple r) (= :ok (elem r 0)))
      (read-all cs (str acc (elem r 1)))
      acc)))

(defn- status-of [resp] (second (split (first (split resp "\r\n")) " ")))
(defn- body-of [resp] (let [p (split resp "\r\n\r\n")] (if (> (count p) 1) (join "\r\n\r\n" (rest p)) "")))

;; a fixed port for the whole suite — one server, many requests
(def PORT (let [p (+ 21000 (rem (erlang/system_time :millisecond) 4000))]
            (http/serve p {:root ROOT :tree-id "test" :token TOKEN :started-at (erlang/system_time :second)})
            (erlang/apply :timer :sleep (list 400))
            p))

(deftest the-dashboard-renders-html
  (testing "GET / answers HTML naming the tree"
    (let [resp (http-get PORT "/")]
      (is (= "200" (status-of resp)))
      (is (String/contains? resp "beam-lisp · warm session")))))

(deftest model-is-the-json-read-model
  (testing "GET /model answers the read-model as JSON with identity + ports"
    (let [resp (http-get PORT "/model")
          body (body-of resp)]
      (is (= "200" (status-of resp)))
      (is (String/contains? body "\"identity\""))
      (is (String/contains? body "\"ports\"")))))

(deftest ports-is-the-port-table
  (testing "GET /ports answers a JSON array"
    (let [resp (http-get PORT "/ports")]
      (is (= "200" (status-of resp)))
      (is (String/starts_with? (String/trim (body-of resp)) "[")))))

(deftest index-reads-without-a-build
  (testing "GET /index answers the phase off the ETS row"
    (let [resp (http-get PORT "/index")]
      (is (= "200" (status-of resp)))
      (is (String/contains? (body-of resp) "\"phase\"")))))

(deftest a-write-without-the-token-is-refused
  (testing "POST /intent without x-bl-token is 403 — loopback is not a trust boundary"
    (let [resp (http-post PORT "/intent" "{\"name\":\"demo\"}" (to-list []))]
      (is (= "403" (status-of resp))))))

(deftest an-unknown-path-is-404
  (testing "an unrouted path answers 404 JSON"
    (let [resp (http-get PORT "/nope")]
      (is (= "404" (status-of resp))))))

(run-tests)
