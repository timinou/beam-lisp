(ns vm.command-project-isolation-test
 (:require [bl.cli :as cli] [vm.osenv :as osenv] [env]))
(def KEY "BL_NAV_PROJECT_ISOLATION_FIXTURE")
(defn capture-command [root]
 (let [leader (Process/group_leader) device (elem (StringIO/open "") 1)]
  (try
   (Process/group_leader (erlang/self) device)
   (let [code (BeamLisp/with_cwd root
                (fn [] (cli/run-argv (list "eval" (str "(System/get_env \"" KEY "\")")))))
         output (elem (StringIO/contents device) 1)]
    [code output])
   (finally (Process/group_leader (erlang/self) leader) (StringIO/close device)))))
(deftest two-concurrent-projects-restore-command-state
 (let [root (str (System/tmp_dir!) "/command-project-" (erlang/unique_integer (list :positive)))
       a (str root "/a") b (str root "/b") parent (erlang/self) token (env/capture)
       original (cli/project-value) raw (erlang/apply :Elixir.System :get_env (list KEY))]
  (try
   (doseq [[path value] [[a "project-A"] [b "project-B"]]]
    (File/mkdir_p! path)
    (File/write! (str path "/env.bl") (pr-str {:env {KEY value}}))
    (let [world (env/fork)]
     (erlang/spawn (fn [] (env/bind token)
      (try
       (env/with-env world
        (fn []
         (let [before (cli/project-value) overlay (osenv/overlay)
               result (capture-command path)]
          (erlang/send parent [:project-result value result
             (= before (cli/project-value)) (= overlay (osenv/overlay))]))))
       (finally (env/destroy world)))))))
   (doseq [n (range 2)]
    (let [result (receive [:project-result value result restored overlay] [value result restored overlay]
                         (after 15000 nil))]
     (is (some? result))
     (when result
      (is (= 0 (get-in result [1 0])))
      (is (String/contains? (get-in result [1 1]) (first result)))
      (is (get result 2)) (is (get result 3)))))
   (is (= original (cli/project-value)))
   (is (= raw (erlang/apply :Elixir.System :get_env (list KEY))))
   (finally (File/rm_rf! root)))))
