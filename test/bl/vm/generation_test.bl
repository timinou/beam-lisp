; generation_test.bl — the generation receipt's contract, pinned.
;
; Port of the former ExUnit test/beam_lisp/generation_test.exs (PLAN-150 wave 2).
; A receipt keeps THREE identities apart — the current SOURCE key, the
; committed SEED, and the code actually LOADED — and a hotpatch is recorded
; only once its beams have loaded. Each is asserted on its own, so a
; conflation reads as a failure rather than as one plausible hash.

(ns vm.generation-test
  (:require [vm.generation :as gen]))

(def ^:private MODULES
  "The live compiler modules the default receipt fingerprints: the namespace
   shims whose `module_info(:md5)` is the running code's identity."
  [(erlang/binary_to_atom "Elixir.BeamLisp.Ns.Compiler")
   (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Lower")
   (erlang/binary_to_atom "Elixir.BeamLisp.Ns.Anf")])

(deftest receipt-separates-source-seed-and-loaded
  (testing "the source key, the seed digest and live module identity are distinct fields"
    (doseq [mod MODULES]
      (is (= :module (elem (code/ensure_loaded mod) 0))))
    (let [r (gen/receipt)]
      (is (= (BeamLisp.AOTCache/current_compiler_key) (:codegen_key (:source r))))
      (is (erlang/is_binary (:manifest_sha256 (:seed r))))
      (is (= 64 (erlang/byte_size (:manifest_sha256 (:seed r)))))
      (doseq [mod MODULES]
        (let [identity (get (:modules (:loaded r)) (erlang/atom_to_binary mod :utf8))
              oc (:object_code identity)]
          (is (= (String/downcase (Base/encode16 (erlang/apply mod :module_info (list :md5))))
                 (:loaded_md5 identity)))
          (is (= 64 (erlang/byte_size (:sha256 oc))))
          (is (erlang/is_binary (:path oc)))
          (testing "object_code's sha256 IS the code-path file's bytes"
            (is (= (:sha256 oc)
                   (sha256-hex (elem (code/get_object_code mod) 1))))))))))

(deftest in-memory-replacement-is-not-the-stale-object-file
  (testing "a module loaded from binary reports its live md5, not the file on disk"
    (let [mod (erlang/binary_to_atom "bl_generation_receipt_fixture")
          dir (str (System/tmp_dir) "/bl_generation_"
                   (erlang/apply :erlang :unique_integer (list (list :positive))))
          build (fn [value]
                  (let [forms (list (tuple :attribute 1 :module mod)
                                    (tuple :attribute 1 :export (list (tuple :value 0)))
                                    (tuple :function 1 :value 0
                                           (list (tuple :clause 1 (list) (list)
                                                        (list (tuple :atom 1 value))))))
                        r (erlang/apply :compile :forms (list forms (list :binary)))]
                    (elem r 2)))
          old-bytes (build :old)
          new-bytes (build :new)
          file (str dir "/bl_generation_receipt_fixture.beam")]
      (File/mkdir_p! dir)
      (erlang/apply :code :add_patha (list (erlang/binary_to_list dir)))
      (try
        (File/write! file old-bytes)
        (erlang/apply :code :load_binary (list mod (erlang/binary_to_list file) new-bytes))
        (let [identity (get (:modules (:loaded (gen/receipt {:modules (list mod)})))
                            (erlang/atom_to_binary mod :utf8))]
          (is (= :new (erlang/apply mod :value (list))))
          (is (= (String/downcase (Base/encode16 (erlang/apply :code :module_md5 (list new-bytes))))
                 (:loaded_md5 identity)))
          (testing "the object file is the OLD bytes, and reported as not matching"
            (is (= (sha256-hex old-bytes) (:sha256 (:object_code identity))))
            (is (not (:matches_loaded (:object_code identity))))))
        (finally
          (erlang/apply :code :purge (list mod))
          (erlang/apply :code :delete (list mod))
          (erlang/apply :code :del_path (list (erlang/binary_to_list dir)))
          (File/rm_rf! dir))))))

(deftest hotpatch-receipt-names-only-recorded-namespaces
  (testing "recording is de-duplicated and sorted; reset forgets it"
    (gen/reset_hotpatches)
    (try
      (is (= (list) (to-list (gen/hotpatched_namespaces))))
      (is (= :ok (gen/record_hotpatch (list "lower" "compiler" "lower"))))
      (is (= (list "compiler" "lower") (to-list (gen/hotpatched_namespaces))))
      (is (= (list "compiler" "lower") (to-list (:hotpatched_namespaces (gen/receipt)))))
      (finally
        (gen/reset_hotpatches)))))

(deftest receipt-exposes-build-and-cache-modes-without-conflating-them
  (testing "build/cache policy is reportable without leaking into identity"
    (let [r (gen/receipt)]
      (is (contains? #{"core" "elixir"} (:aot_backend (:build r))))
      ; Mix is OPTIONAL: a plain `bl test` VM runs without it, so the honest
      ; value set includes "release" beside Mix's dev/test/prod.
      (is (contains? #{"dev" "test" "prod" "release"} (:mix_env (:build r))))
      (is (contains? #{"fallback" "strict"} (:mode (:cache r))))
      (is (not (contains? (:source r) :hotpatched_namespaces)))
      (is (not (contains? (:loaded r) :seed))))))
