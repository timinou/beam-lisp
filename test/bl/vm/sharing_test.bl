; sharing_test.bl — which VM answers for a project.
;
; By default a project has its own VM. A project that declares `:vm "shared"` (or a
; command that passes `--share-vm`) uses the ONE VM its build runs for every shared
; project. These tests pin the rule and the exact file names, which the Rust
; launcher computes independently (tooling/drop/src/daemon.rs); the goldens below
; are the strings its tests assert, so the two cannot drift.

(ns vm.sharing-test
  (:require [vm.paths :as paths]))

(def DROP "a238fa91")

(defn- project
  "A temp project whose env.bl is `text` (nil: no env.bl)."
  [text]
  (let [root (str "/tmp/bl-sharing-test-" (erlang/apply :erlang :unique_integer (list (to-list [:positive]))))]
    (File/mkdir_p! root)
    (when text (File/write! (str root "/env.bl") text))
    root))

(deftest the-default-is-a-vm-per-project
  (let [a (project nil) b (project "{:name \"b\"}")]
    (is (false? (paths/shared? a DROP)))
    (is (false? (paths/shared? b DROP)))
    (is (not= (:sock (:ok (paths/endpoints a DROP))) (:sock (:ok (paths/endpoints b DROP))))
        "two projects, two sockets")
    (is (= (paths/tree-id a) (paths/endpoint-key a DROP false)))))

(deftest a-project-opts-in-with-its-declaration
  (let [shared (project "{:name \"s\" :vm \"shared\"}")
        own (project "{:name \"o\" :vm \"own\"}")]
    (is (true? (paths/shared? shared DROP)))
    (is (false? (paths/shared? own DROP)))))

(deftest only-the-two-spellings-mean-anything
  (doseq [v ["\"sometimes\"" "true" ":shared" "\"SHARED\"" "42"]]
    (is (false? (paths/shared? (project (str "{:vm " v "}")) DROP)) (str ":vm " v " is ignored"))))

(deftest a-broken-env-file-is-not-a-reason-to-share
  (is (false? (paths/shared? (project "{:vm \"shared\"") DROP)) "an unreadable file is absent")
  (is (false? (paths/shared? (project "not data at all") DROP))))

(deftest every-shared-project-meets-at-one-endpoint
  (let [a (project "{:vm \"shared\"}") b (project "{:vm \"shared\"}")
        ea (:ok (paths/endpoints a DROP)) eb (:ok (paths/endpoints b DROP))]
    (is (= (:sock ea) (:sock eb)) "one socket for both")
    (is (= (:token ea) (:token eb)))
    (is (true? (:shared ea)))
    (is (= "warm" (paths/endpoint-key a DROP true)))
    (is (clojure.string/ends-with? (:sock ea) "/warm-a238fa91.sock") "golden: the Rust launcher names the same file")
    (is (clojure.string/ends-with? (:starting ea) "/warm-a238fa91.starting"))))

(deftest a-source-build-is-never-shared
  (let [s (project "{:vm \"shared\"}")]
    (is (false? (paths/shared? s paths/SRC-BUILD)))
    (is (= (paths/tree-id s) (paths/endpoint-key s paths/SRC-BUILD true))
        "even when asked: a checkout runs its own sources")
    (is (clojure.string/ends-with? (:sock (:ok (paths/endpoints s paths/SRC-BUILD true))) "-src.sock"))))

(deftest two-builds-are-two-shared-vms
  (let [s (project "{:vm \"shared\"}")]
    (is (not= (:sock (:ok (paths/endpoints s "a238fa91"))) (:sock (:ok (paths/endpoints s "5e0dd11f")))))))

(deftest the-hello-field-is-the-checkout-unless-the-vm-is-shared
  (let [a (project nil) b (project nil)
        shared-fp (erlang/apply :crypto :hash (list :sha256 "warm"))]
    (is (= shared-fp (paths/hello-fingerprint a DROP true) (paths/hello-fingerprint b DROP true))
        "a shared VM checks the endpoint, not a project")
    (is (not= (paths/hello-fingerprint a DROP false) (paths/hello-fingerprint b DROP false)))
    (is (= (paths/fingerprint a) (paths/hello-fingerprint a DROP false)))
    (is (= (paths/fingerprint a) (paths/hello-fingerprint a paths/SRC-BUILD true)) "src checks the checkout")))

(deftest the-log-follows-the-endpoint
  (is (= "/s/beam-lisp/logs/warm-a238fa91.log" (paths/log-path-in "/s" "warm" DROP)))
  (let [a (project "{:vm \"shared\"}")]
    (is (clojure.string/ends-with? (paths/log-path a DROP true) "/beam-lisp/logs/warm-a238fa91.log"))
    (is (clojure.string/ends-with? (paths/log-path a DROP false)
                                   (str "/beam-lisp/logs/" (paths/tree-id a) "-a238fa91.log")))))

(deftest a-shared-vm-can-name-its-endpoint-without-a-project
  (is (= "warm" (paths/endpoint-key nil DROP true)))
  (is (true? (:shared (:ok (paths/endpoints nil DROP true))))))

(run-tests)
