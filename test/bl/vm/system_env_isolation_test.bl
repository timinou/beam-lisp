(ns vm.system-env-isolation-test
 (:require [vm.osenv :as osenv] [env]))
(def KEY "BL_NAV_ISOLATION_FIXTURE")
(defn raw-value [] (erlang/apply :Elixir.System :get_env (list KEY)))
(deftest ordinary-system-apis-and-handles-observe-overlay
 (let [raw (raw-value) handle System/get_env]
  (osenv/with-env {KEY "local"}
   (fn []
    (is (= "local" (System/get_env KEY)))
    (is (= "local" (get (System/get_env) KEY)))
    (is (= (tuple :ok "local") (System/fetch_env KEY)))
    (is (= "local" (System/fetch_env! KEY)))
    (is (= "local" (handle KEY)))
    (System/put_env KEY "changed")
    (is (= "changed" (System/get_env KEY)))
    (is (= raw (raw-value)))
    (System/delete_env KEY)
    (is (nil? (System/get_env KEY)))
    (is (= "fallback" (System/get_env KEY "fallback")))
    (is (= "fallback" (osenv/get KEY "fallback")))
    (is (= :error (System/fetch_env KEY)))
    (is (not (contains? (System/get_env) KEY)))
    (is (= :missing (try (System/fetch_env! KEY) :wrong (catch _ :missing))))
    (System/put_env {KEY "again"})
    (is (= "again" (System/get_env KEY)))
    (is (= raw (raw-value)))))
  (is (= raw (System/get_env KEY)))))
(deftest standard-system-reads-and-writes-are-isolated-concurrently
 (let [parent (erlang/self) token (env/capture) raw (raw-value)]
  (doseq [n (range 24)]
   (erlang/spawn (fn [] (env/bind token)
    (osenv/with-env {KEY (str n)}
     (fn []
      (System/put_env KEY (str "own-" n)) (Process/sleep 2)
      (erlang/send parent [:scope-result (= (str "own-" n) (System/get_env KEY))]))))))
  (let [good (loop [n 0 good 0]
              (if (= n 24) good
               (receive [:scope-result ok] (recur (inc n) (+ good (if ok 1 0)))
                        (after 5000 good))))]
   (is (= 24 good)) (is (= raw (raw-value))))))
(deftest conveyed-worker-gets-project-and-overlay-without-node-mutation
 (let [parent (erlang/self) original (erlang/get :bl-cli-project)]
  (try
   (erlang/put :bl-cli-project {:name "fixture-project"})
   (osenv/with-env {KEY "caller"}
    (fn []
     (let [token (env/capture)]
      (erlang/spawn (fn [] (env/bind token)
       (erlang/send parent [:conveyed (System/get_env KEY) (erlang/get :bl-cli-project)]))))))
   (is (= :ok (receive [:conveyed "caller" {:name "fixture-project"}] :ok (after 5000 :timeout))))
   (finally (if (= :undefined original) (erlang/erase :bl-cli-project) (erlang/put :bl-cli-project original))))))
(deftest subprocess-env-follows-overlay-and-explicit-options-win
 (let [raw (raw-value)]
  (osenv/with-env {KEY "child-default"}
   (fn []
    (let [result (System/cmd "/usr/bin/env" (list))]
     (is (= 0 (elem result 1)))
     (is (String/contains? (elem result 0) (str KEY "=child-default"))))
    (let [result (System/cmd "/usr/bin/env" (list) (list (tuple :env (list (tuple KEY "explicit")))))]
     (is (String/contains? (elem result 0) (str KEY "=explicit"))))
    (is (= raw (raw-value)))))))
(deftest bridging-preserves-original-system-capabilities
 (let [world (env/fork (env/current) {:caps [(tuple :Elixir.System :env_read)]})
       write-handle System/put_env]
  (try
   (osenv/with-env {KEY "read-only"}
    (fn []
     (env/with-env world
      (fn []
       (is (= "read-only" (env/eval (str "(System/get_env \"" KEY "\")"))))
       (is (= :denied (try (env/eval (str "(System/put_env \"" KEY "\" \"bad\")")) :wrong (catch _ :denied))))
       (is (= :denied (try (write-handle KEY "bad") :wrong (catch _ :denied))))))))
   (finally (env/destroy world)))))
(deftest system-call-arguments-run-once-and-in-source-order
 (let [seen (atom [])]
  (osenv/with-env {}
   (fn []
    (System/put_env (do (swap! seen conj :key) KEY)
                    (do (swap! seen conj :value) "once"))
    (is (= [:key :value] @seen))
    (is (= "once" (System/get_env KEY)))))))
