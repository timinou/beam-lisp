; burst_test.bl — a burst of simultaneous clients is all answered.
;
; The listening socket's backlog was the OS default, a handful. Eighty clients that
; connected in the same instant lost between 1 and 27 of themselves to a reset before
; the VM saw them, in five bursts of six. A warm VM shared by several projects, an
; editor and a build is exactly that load, and a dropped connection is a command that
; fails for no reason a person can find.

(ns vm.burst-test
  (:require [vm.net :as net] [vm.paths :as paths]))

(def DROP "a238fa91")
(def CLIENTS 80)
(def ROUNDS 3)
(def HELLO-WAIT-MS 15000)

(defn- as-drop-build [f]
  (let [prev (System/get_env "BL_BUILD_ID")]
    (System/put_env "BL_BUILD_ID" DROP)
    (try (f) (finally (if (nil? prev) (System/delete_env "BL_BUILD_ID") (System/put_env "BL_BUILD_ID" prev))))))

(defn- dial
  "One client: connect, say hello, and report :ok or why not."
  []
  (let [ep (:ok (paths/endpoints nil DROP true))
        r (gen_tcp/connect (tuple :local (erlang/binary_to_list (:sock ep))) 0
            (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false)) 5000)]
    (if (= :ok (elem r 0))
      (let [c (elem r 1)]
        (gen_tcp/send c (erlang/apply :erlang :term_to_binary
                          (list (tuple :bl 1 :hello {:tree (paths/hello-fingerprint nil DROP true)
                                                     :token (File/read! (:token ep))}))))
        (let [a (gen_tcp/recv c 0 HELLO-WAIT-MS)]
          (gen_tcp/close c)
          (if (= :ok (elem a 0)) :ok (elem a 1))))
      (elem r 1))))

(deftest a-burst-of-simultaneous-clients-is-all-answered
  (as-drop-build
    (fn []
      (let [l (:ok (net/listen nil (fn [f send] :ok) {:shared true}))]
        (try
          (doseq [round (range ROUNDS)]
            (let [res (frequencies (map deref (doall (map (fn [_] (future (dial))) (range CLIENTS)))))]
              (is (= {:ok CLIENTS} res) (str "round " round ": " (pr-str res)))))
          (finally (net/stop l)))))))

(deftest the-backlog-is-a-named-constant-deeper-than-a-handful
  (is (>= net/LISTEN-BACKLOG CLIENTS) "deep enough for the burst the test sends"))

(run-tests)
