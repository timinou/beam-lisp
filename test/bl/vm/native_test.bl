; native_test.bl — vm.native declaration policy (PLAN-122 N1).
;
; The POLICY (declare/available?/declaration/guards/host-naming) is bl now; the
; Rust artifact + the 3 load BIFs are the only substrate. The policy cases run
; with NO built .so; the NIF flow itself is exercised against the installed
; `datom_fjall.so`, guarded so a checkout with no Rust toolchain still passes
; (the backend then reads ABSENT, exactly as `datom.conformance` conditions).
; No crate is BUILT here.
;
; ── ported from the ExUnit `test/beam_lisp/native_test.exs` ────────────────
;
; The ExUnit suite tested `BeamLisp.Native` (Elixir). That module is gone; the
; declaration policy is `vm.native`. Every case it held is preserved here — the
; mapping, case for case:
;
;   * "a namespace can call its own NIF"          → a-namespace-can-call-its-own-nif
;   * "a native name is a VALUE"                  → a-namespace-can-call-its-own-nif (fn?)
;   * "missing NIF keeps callable stubs …"        → a-missing-nif-keeps-callable-stubs
;     (its `native.ex`-has-no-`Module.create` refutes are structural now: the
;      host module is synthesized in bl, and this asserts the observable —
;      the module is functions-only, no Elixir `__info__/1`)
;   * "a name that shadows core is refused …"     → a-name-that-shadows-core-is-refused-with-the-fix
;   * "a duplicate name is refused"               → a-duplicate-name-is-refused
;   * "a malformed signature is refused"          → a-malformed-signature-is-refused
;   * "the namespace still loads and available?"  → guards-refuse-bad-declarations + declare-records-and-links
;   * "an arity that disagrees with the crate"    → an-arity-that-disagrees-with-the-crate-is-not-available
;   * "the host module is named after the NS"     → the-host-module-is-named-after-the-namespace
;   * "an emitted namespace replays …"            → an-emitted-namespace-replays-its-native-declaration
;   * "the native functions work through AOT"     → the-native-functions-work-through-the-host-module
;
; Run: bin/bl test test/bl/vm/native_test.bl

(ns vm.native-test
  (:require [vm.native :as native]
            [datom.store-fjall]))

(deftest host-module-naming-contract
  (testing "ns → BeamLisp.Native.<Camel> — THE rustler::init! contract"
    (is (= :Elixir.BeamLisp.Native.Datom.StoreFjall
           (native/host-module "datom.store-fjall")))
    (is (= :Elixir.BeamLisp.Native.Wry.Webview
           (native/host-module "wry.webview")))
    (testing "a single-segment ns"
      (is (= :Elixir.BeamLisp.Native.Wry (native/host-module "wry"))))))

(deftest declare-records-and-links
  (testing "declare records the declaration and links each name as a value"
    (native/declare "vm.native-test.probe" "no_such_crate"
      (list (list "probe-open" 1) (list "probe-get" 2)))
    (is (= {:crate "no_such_crate" :sigs (list (list "probe-open" 1) (list "probe-get" 2))}
           (native/declaration "vm.native-test.probe")))
    (testing "an absent crate reads as ABSENT, never present-but-degraded"
      (is (= false (native/available? "vm.native-test.probe"))))
    (testing "the declaration appears in the AOT-replay list"
      (is (>= (count (native/declarations)) 1)))))

(deftest guards-refuse-bad-declarations
  (testing "a duplicate name is refused loudly"
    (is (thrown? (native/declare "vm.native-test.dup" "c"
                   (list (list "a" 1) (list "a" 2))))))
  (testing "a name that would shadow core is refused loudly"
    (is (thrown? (native/declare "vm.native-test.shadow" "c"
                   (list (list "get" 2)))))))

; ── the refusals, and the fix they carry ───────────────────────────────────
;
; `defnative` is a COMPILER form (not a macro), so the refusal is reached the
; way a user reaches it: by compiling a source string. The message is the
; contract here — a collision is diagnosed where it is DECLARED, not hundreds
; of lines away as an argument-type error (FUP-082).

(defn- eval-refusal
  "The message `src` raises while compiling, or nil when it is accepted. The ns
   is pinned so a refuted declaration cannot leak its namespace to later tests."
  [src]
  (try
    (BeamLisp.Env/with_ns (BeamLisp.Env/current_ns)
      (fn [] (BeamLisp/eval src)))
    nil
    (catch e (ex-message e))))

(defn- raise-class [f]
  (try (do (f) nil)
       (catch e (:__struct__ e))))

(deftest a-name-that-shadows-core-is-refused-with-the-fix
  (let [msg (eval-refusal
              "(ns native.test.shadow)\n(defnative \"datom_fjall\" (get 2))")]
    (is (string? msg) "the declaration is refused")
    (is (includes? msg "would shadow core") "the refusal names the collision")
    (is (includes? msg "Prefix them: shadow-get")
        "the fix reads as text — the names are joined, not printed as a list")))

(deftest a-duplicate-name-is-refused
  (let [msg (eval-refusal
              "(ns native.test.dup)\n(defnative \"datom_fjall\" (fjall-get 2) (fjall-get 3))")]
    (is (string? msg) "a repeated name is refused — the second would silently win")
    (is (includes? msg "native.test.dup: fjall-get declared more than once")
        "and names the offending name, joined as text")))

(deftest a-malformed-signature-is-refused
  (let [msg (eval-refusal
              "(ns native.test.malformed)\n(defnative \"datom_fjall\" fjall-get)")]
    (is (string? msg) "a signature that is not (name arity) is refused loudly")
    (is (includes? msg "expected (fn-name arity)"))))

; ── the fallback: an absent NIF is absent, never broken ────────────────────

(deftest a-missing-nif-keeps-callable-stubs
  (let [mod (native/declare "vm.native-test.canonical_missing" "no_such_crate_exists"
                            (list (list "missing-call" 1)))]
    (is (erlang/function_exported mod :missing_call 1)
        "the host module carries one stub per declared name/arity")
    (is (not (erlang/function_exported mod :__info__ 1))
        "and it is functions-only: synthesized in beam-lisp, not through Elixir")
    (is (= :Elixir.ErlangError
           (raise-class (fn [] (erlang/apply mod :missing_call (list :value)))))
        "calling an unloaded stub raises — the VM overwrites it at load time")
    (is (= false (native/available? "vm.native-test.canonical_missing"))
        "and the capability question answers false, so the layer above picks a fallback")))

(deftest the-host-module-is-named-after-the-namespace
  (let [ns "my.cool.ns"
        mod (native/declare ns "datom_fjall" (list (list "fjall-open" 1)))]
    (is (= :Elixir.BeamLisp.Native.My.Cool.Ns mod)
        "the module name is derived from the NAMESPACE — rustler::init! hardcodes it")
    (is (erlang/function_exported mod :fjall_open 1) "with the stub at the mapped fname")
    (is (= false (native/available? ns))
        "the library refuses to load into a namespace it was not built for")))

(deftest an-arity-that-disagrees-with-the-crate-is-not-available
  (native/declare "vm.native-test.arity" "datom_fjall" (list (list "fjall-get" 99)))
  (is (not (nil? (native/declaration "vm.native-test.arity"))) "the declaration is recorded")
  (is (= false (native/available? "vm.native-test.arity"))
      "load_nif refuses a library whose module lacks a stub for an export — and the
       refusal is REPORTED, not swallowed: the backend reads ABSENT, not degraded"))

; ── the NIF itself: the flow the absent case must not break ────────────────
;
; Guarded on `available?`, so a checkout with no Rust toolchain still runs the
; suite and the backend simply reads as absent (the same conditioning
; `datom.conformance` uses). No crate is BUILT here — the installed `.so` is
; used as it is.

(deftest a-namespace-can-call-its-own-nif
  (if (datom.store-fjall/available?)
    (let [path (str (System/tmp_dir!) "/bl_native_rt_"
                    (erlang/unique_integer (list :positive)) ".fjall")
          db (datom.store-fjall/fjall-open path)]
      (datom.store-fjall/fjall-put db "k" "v")
      (is (= "v" (datom.store-fjall/fjall-get db "k"))
          "a value put through the NIF reads back, no Elixir module between them")
      (is (fn? datom.store-fjall/fjall-get)
          "a native name is a VALUE, not only a callable"))
    (is true "skipped: datom_fjall NIF is absent (no Rust toolchain)")))

(deftest the-native-functions-work-through-the-host-module
  (if (native/available? "datom.store-fjall")
    (let [host :Elixir.BeamLisp.Native.Datom.StoreFjall
          path (str (System/tmp_dir!) "/bl_native_host_"
                    (erlang/unique_integer (list :positive)) ".fjall")
          db (erlang/apply host :fjall_open (list path))]
      (is (= :ok (erlang/apply host :fjall_put (list db "k" "v"))))
      (is (= "v" (erlang/apply host :fjall_get (list db "k")))
          "the host module the crate names is callable directly — the NIF's own ABI"))
    (is true "skipped: datom_fjall NIF is absent")))

; ── AOT: the declaration survives the build ────────────────────────────────
;
; The emitted `__bl_init__/0` records enough to recreate the host module and
; the declaration. Without that replay an AOT deployment starts with no native
; backend and silently chooses an in-memory store — no crash, no warning, and
; the only symptom is data missing after a restart (BUG-021).

(deftest an-emitted-namespace-replays-its-native-declaration
  (let [out (str (System/tmp_dir!) "/bl_aot_native_"
                 (erlang/unique_integer (list :positive)))
        mod (BeamLisp.Link/module_for "datom.store-fjall")
        key (tuple :native "datom.store-fjall")]
    (try
      (File/mkdir_p! out)
      (let [mods (BeamLisp.AOT/compile_file "priv/lib/datom/store-fjall.bl"
                                            (list (tuple :output_dir out)))]
        (is (>= (count mods) 1) "the namespace compiles to at least one beam")
        (is (not (nil? (native/declaration "datom.store-fjall")))
            "the declaration is RECORDED — what __bl_init__ replays")
        (is (some (fn [p] (= mod (erlang/element 1 p))) mods)
            "the namespace shim is among the emitted {mod, path} pairs")
        (is (erlang/function_exported mod :__bl_init__ 0)
            "and it carries __bl_init__/0"))
      ; REPLAY: drop the row, run the emitted init, and the row returns.
      (let [row (first (ets/lookup :beam_lisp_native_declarations key))]
        (ets/delete :beam_lisp_native_declarations key)
        (try
          (is (nil? (native/declaration "datom.store-fjall"))
              "precondition: the registry row is gone")
          (erlang/apply mod :__bl_init__ (list))
          (is (= row (first (ets/lookup :beam_lisp_native_declarations key)))
              "replaying __bl_init__ RESTORES the declaration — no silent loss of durability")
          (finally
            (ets/delete :beam_lisp_native_declarations key)
            (ets/insert :beam_lisp_native_declarations row)))
        (is (erlang/function_exported :Elixir.BeamLisp.Native.Datom.StoreFjall :__nif_loaded__ 0)
            "the host module came back with the replay")
        (is (datom.store-fjall/available?)
            "and the namespace reads AVAILABLE after the replay, not merely declared"))
      (finally (File/rm_rf! out)))))

(run-tests)
