; hotpatch_test.bl — vm.hotpatch's contract, pinned.
;
; Port of the retired dev-only Elixir hotpatch helper (PLAN-150).
; The hotpatch path is `hotpatch!` (string or list, `:source_root`),
; `apply-env!` (BL_HOTPATCH), and a per-namespace `compile_file` into a UNIQUE
; temp dir whose emitted beams are purged, deleted and reloaded, then recorded
; in `vm.generation`. Each assertion stands on its own so a broken step reads
; as a failure rather than as one plausible `:ok`.
;
; The namespace actually hot-patched is an ISOLATED FIXTURE compiled from a
; temp `:source_root`: the boot namespaces (compiler, lower, …) are NOT
; re-interned here, because doing so would invalidate the very closures this
; suite runs on. A real, UNCHANGED boot namespace reload is available as an
; explicit opt-in below.

(ns vm.hotpatch-test
  (:require [vm.hotpatch :as hp]
            [vm.generation :as gen]))

(defn- tmp-root
  "A fresh temp source root for one fixture namespace."
  []
  (str (System/tmp_dir) "/bl_hotpatch_src_"
       (erlang/apply :erlang :unique_integer (list (list :positive)))))

(defn- shim-module
  "The namespace shim module `Emit/module_for` builds for a dotted `ns` —
   `Elixir.BeamLisp.Ns.<CamelCased>`, one segment per dot-separated part."
  [ns]
  (Enum/reduce (String/split ns ".")
               :"Elixir.BeamLisp.Ns"
               (fn [seg mod] (Module/concat mod (Macro/camelize seg)))))

(defn- write-fixture!
  "Write `ns`'s source into `root` with `marker` as the body's answer."
  [root ns marker]
  (File/mkdir_p! root)
  (File/write! (Path/join root (str ns ".bl"))
               (str "(ns " ns ")\n(defn marker [] " marker ")\n")))

(defn- thrown-message
  "The `ex-message` of the error `thunk` raises, or nil when it does not throw —
   the refusal path is an error, and its WORDS are the contract."
  [thunk]
  (try (do (thunk) nil) (catch e (ex-message e))))

(deftest unknown-namespace-and-bad-source-root-raise
  (testing "a name with no source at the source root is refused, never skipped"
    (let [m (thrown-message (fn [] (hp/hotpatch! (list "no.such.boot.namespace")
                                                (list (tuple :source_root "/nonexistent-bl-hotpatch")))))]
      (is (some? m) "a missing source root must raise")
      (is (includes? m "no boot source for namespace") "the refusal names the missing namespace"))
    (let [m (thrown-message (fn [] (hp/hotpatch! "no.such.boot.namespace"
                                                (list (tuple :source_root "/nonexistent-bl-hotpatch")))))]
      (is (some? m) "the comma-separated string form must refuse the same way")
      (is (includes? m "no boot source for namespace")))))

(deftest apply-env-is-a-noop-when-unset-or-empty
  (testing "BL_HOTPATCH absent and empty both answer :ok without touching a namespace"
    (let [prev (System/get_env "BL_HOTPATCH")]
      (try
        (System/delete_env "BL_HOTPATCH")
        (is (= :ok (hp/apply-env!)) "an unset BL_HOTPATCH is a no-op")
        (System/put_env "BL_HOTPATCH" "")
        (is (= :ok (hp/apply-env!)) "an empty BL_HOTPATCH is a no-op")
        (finally
          (if (nil? prev)
            (System/delete_env "BL_HOTPATCH")
            (System/put_env "BL_HOTPATCH" prev)))))))

(deftest hotpatch-recompiles-a-namespace-from-its-source
  (testing "each call compiles CURRENT source, reloads the beams, records the ns, cleans its temp dir"
    (let [root (tmp-root)
          ns "hotpatch.probe"
          mod (shim-module ns)]
      (try
        (gen/reset_hotpatches)
        (write-fixture! root ns "7")
        (is (= :ok (hp/hotpatch! (list ns) (list (tuple :source_root root)))))
        (is (= 7 (erlang/apply mod :marker (list)))
            "the hot-patched namespace answers its compiled body")
        (is (= (list ns) (to-list (gen/hotpatched_namespaces)))
            "the namespace is recorded only after its beams loaded")

        ; the whole point: an EDIT is visible on the next call.
        (write-fixture! root ns "8")
        (is (= :ok (hp/hotpatch! ns (list (tuple :source_root root)))))
        (is (= 8 (erlang/apply mod :marker (list)))
            "a recompile answers the NEW source, not a cached beam")

        ; a map carrying `:source_root` is the in-language shape of the same opt
        (write-fixture! root ns "9")
        (is (= :ok (hp/hotpatch! (list ns) {:source_root root})))
        (is (= 9 (erlang/apply mod :marker (list))))

        (is (= (list ns) (to-list (gen/hotpatched_namespaces)))
            "recording the same namespace twice stays de-duplicated")
        (is (= (list) (Path/wildcard (str (System/tmp_dir) "/bl_hotpatch_" ns "_*")))
            "the per-namespace temp dir is removed once its beams are loaded")
        (finally
          (gen/reset_hotpatches)
          (erlang/apply :code :purge (list mod))
          (erlang/apply :code :delete (list mod))
          (File/rm_rf! root))))))

(deftest reloads-a-real-boot-namespace-when-armed
  (testing "an UNCHANGED boot namespace reload is a clean swap (opt-in: re-interns live vars)"
    (let [ns (System/get_env "BL_HOTPATCH_SELFTEST_NS")]
      (if (nil? ns)
        (do
          (println (str "hotpatch_test: skipped — set BL_HOTPATCH_SELFTEST_NS=<ns> to "
                        "hot-patch a REAL boot namespace (re-interns its live vars); "
                        "the isolated fixture above covers the path without that risk"))
          (is true))
        (try
          (gen/reset_hotpatches)
          (is (= :ok (hp/hotpatch! (list ns))))
          (is (= (list ns) (to-list (gen/hotpatched_namespaces))))
          (finally
            (gen/reset_hotpatches)))))))
