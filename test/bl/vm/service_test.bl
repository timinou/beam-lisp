(ns vm.service-test
 (:require [vm.service :as service] [vm.manager :as manager] [vm.owner :as owner] [vm.scope :as scope]))

(defn fixture [f]
 (let [id (str "service-test-" (erlang/unique_integer (list :positive)))]
  (manager/start)
  (manager/ensure {:id id})
  (try (f id) (finally (manager/drain id)))))

(deftest acquisition-reuses-owner-and-rejects-incompatible-writers
 (fixture
  (fn [id]
   (let [starts (atom 0) stops (atom 0)
         init (fn [] (swap! starts inc) {:answer 42})
         stop (fn [_] (swap! stops inc))
         a (service/acquire id :world {:root "/a"} init stop)
         b (service/acquire id :world {:root "/a"} init stop)]
    (is (= (:pid a) (:pid b)))
    (is (= {:answer 42} (:value b)))
    (is (= 1 @starts))
    (is (some (fn [m] (= (:pid a) (:pid m))) (owner/members id)))
    (is (try (service/acquire id :world {:root "/b"} init stop) false (catch e true)))
    (is (= :ok (service/stop! (:pid a))))
    (is (= 1 @stops))
    (let [c (service/acquire id :world {:root "/a"} init stop)]
     (is (not= (:pid a) (:pid c)))
     (is (= 2 @starts))
     (service/stop! (:pid c)))))))

(deftest failed-startup-is-retryable
 (fixture
  (fn [id]
   (is (try (service/acquire id :broken {} (fn [] (throw (ex-info "broken" {}))) (fn [_] nil))
        false (catch e true)))
   (let [r (service/acquire id :broken {} (fn [] :recovered) (fn [_] nil))]
    (is (= :recovered (:value r)))
    (service/stop! (:pid r))))))

(deftest lost-caller-does-not-cancel-owned-startup
 (fixture
  (fn [id]
   (let [parent (erlang/self)
         client (spawn
          (fn [] (service/acquire id :slow {}
           (fn [] (erlang/send parent [:initializing (erlang/self)])
            (receive :continue :ready)) (fn [_] nil))))]
    (receive [:initializing pid]
     (do
      (erlang/exit client :kill)
      (is (Process/alive? pid))
      (erlang/send pid :continue)
      (let [r (service/acquire id :slow {} (fn [] :duplicate) (fn [_] nil))]
       (is (= pid (:pid r)))
       (is (= :ready (:value r)))
       (service/stop! pid))))))))

(deftest competing-callers-await-one-startup
 (fixture
  (fn [id]
   (let [parent (erlang/self) starts (atom 0)
         init (fn [] (swap! starts inc) (Process/sleep 50) :ready)
         clients (mapv (fn [_] (spawn (fn [] (erlang/send parent
                   [:acquired (service/acquire id :world {} init (fn [_] nil))])))) (range 8))
         results (mapv (fn [_] (receive [:acquired r] r (after 10000 :timeout))) clients)]
    (is (every? map? results))
    (is (= 1 @starts))
    (is (= 1 (count (distinct (map :pid results)))))
    (service/stop! (:pid (first results)))))))

(deftest crash-reacquires-and-closed-realms-reject
 (fixture
  (fn [id]
   (let [r (service/acquire id :world {} (fn [] :first) (fn [_] nil))
         ref (erlang/monitor :process (:pid r))]
    (erlang/exit (:pid r) :kill)
    (receive [:DOWN seen :process _ _] :when (= ref seen) :ok)
    (let [next (service/acquire id :world {} (fn [] :next) (fn [_] nil))]
     (is (= :next (:value next)))
     (is (not= (:pid r) (:pid next)))
     (manager/drain id)
     (is (try (service/acquire id :world {} (fn [] :invalid) (fn [_] nil)) false (catch e true))))))))

(deftest realm-drain-invokes-service-cleanup
 (fixture
  (fn [id]
   (let [closed (atom false)
         r (service/acquire id :world {} (fn [] :ready) (fn [_] (reset! closed true)))]
    (manager/drain id)
    (is @closed)
    (is (not (Process/alive? (:pid r))))))))

(deftest global-acquisition-still-executes-under-the-target-realm
 (fixture
  (fn [id]
   (let [target (:env (manager/get-vm id))
         caller (BeamLisp.Env/env_id)
         r (service/acquire id :scoped {}
             (fn [] {:environment (BeamLisp.Env/env_id) :realm (scope/current)})
             (fn [_] nil))]
    (is (not= caller target))
    (is (= target (:environment (:value r))))
    (is (= id (:realm (:value r))))
    (service/stop! (:pid r))))))
