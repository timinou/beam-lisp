; session_test.bl — the pure-beam-lisp daemon session (PLAN-123 D3).
;
; The WHOLE daemon in beam-lisp: vm.net transport + vm.io proxy + vm.wire codec
; + vm.manager + bl.daemon/handle-in-vm. This drives a real AF_UNIX round-trip
; and asserts a command's stdout streams back as frames and its exit is framed
; after — no Elixir daemon code on the path.

(ns vm.session-test
  (:require [vm.session :as session] [vm.paths :as paths] [vm.net :as net]))

(defn- setup-tree []
  (let [root (str "/tmp/bl-session-test-" (erlang/apply :erlang :unique_integer (list (to-list [:positive]))))]
    (File/mkdir_p! (str root "/priv/boot"))
    (File/write! (str root "/priv/boot/core.bl") "")
    root))

(defn- client-run [root argv]
  (let [ep (:ok (paths/endpoints root))
        charlist (erlang/binary_to_list (:sock ep))
        token (File/read! (:token ep))
        conn (elem (gen_tcp/connect (tuple :local charlist) 0
                     (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false))) 1)]
    (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                         (list (tuple :bl 1 :hello {:tree (paths/fingerprint root) :token token}))))
    (gen_tcp/recv conn 0 5000)
    (let [id (erlang/list_to_binary (erlang/apply :lists :duplicate (list 16 65)))]
      (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                           (list (tuple :bl 1 :request id {:argv argv :cwd root :env {}})))))
    (loop [outs [] code nil]
      (let [r (gen_tcp/recv conn 0 10000)]
        (if (not= :ok (elem r 0))
          {:outs outs :code code}
          (let [f (erlang/apply :erlang :binary_to_term (list (elem r 1)))
                tag (elem f 2)]
            (cond
              (= tag :stdout) (recur (conj outs (elem f 5)) code)
              (= tag :exit) {:outs outs :code (elem f 4)}
              :else (recur outs code))))))))

(deftest a-command-round-trips-through-the-pure-bl-daemon
  (testing "eval streams stdout as frames and exits 0 — no Elixir on the path"
    (let [root (setup-tree)
          listener (:ok (session/start root))]
      (erlang/apply :timer :sleep (list 150))
      (let [r (client-run root (list "eval" "(println (* 6 7))"))]
        (session/stop listener)
        (is (= 0 (:code r)))
        ;; the println's "42" arrived as a stdout frame
        (is (some (fn [o] (clojure.string/includes? o "42")) (:outs r)))))))

(defn- client-run-env [root argv env]
  ;; like client-run but binds the request's env map (the client's os-env),
  ;; proving G5: env is read PROCESS-LOCALLY, never a node-global table.
  (let [ep (:ok (paths/endpoints root))
        charlist (erlang/binary_to_list (:sock ep))
        token (File/read! (:token ep))
        conn (elem (gen_tcp/connect (tuple :local charlist) 0
                     (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false))) 1)]
    (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                         (list (tuple :bl 1 :hello {:tree (paths/fingerprint root) :token token}))))
    (gen_tcp/recv conn 0 5000)
    (let [id (erlang/apply :crypto :strong_rand_bytes (list 16))]
      (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                           (list (tuple :bl 1 :request id {:argv argv :cwd root :env env}))))
      (loop [outs [] code nil]
        (let [r (gen_tcp/recv conn 0 20000)]
          (if (not= :ok (elem r 0))
            {:outs outs :code code}
            (let [f (erlang/apply :erlang :binary_to_term (list (elem r 1)))
                  tag (elem f 2)]
              (cond
                (= tag :stdout) (recur (conj outs (elem f 5)) code)
                (= tag :exit) {:outs outs :code (elem f 4)}
                :else (recur outs code)))))))))

(deftest g5-a-requests-env-is-read-process-locally
  (testing "a command reads its OWN request env via the osenv overlay, not a node table"
    (let [root (setup-tree)
          listener (:ok (session/start root))]
      (erlang/apply :timer :sleep (list 150))
      (let [r (client-run-env root (list "eval" "(vm.osenv/get \"BL_RACE_TEST\")") {"BL_RACE_TEST" "from-request"})]
        (session/stop listener)
        (is (= 0 (:code r)))
        (is (some (fn [o] (clojure.string/includes? o "from-request")) (:outs r)))))))

(deftest g5-two-concurrent-requests-with-different-env-do-not-race
  (testing "two requests with different env resolve to their OWN value — no node-global race"
    (let [root (setup-tree)
          listener (:ok (session/start root))
          parent (erlang/self)]
      (erlang/apply :timer :sleep (list 150))
      (spawn (fn [] (erlang/send parent [:a (client-run-env root (list "eval" "(vm.osenv/get \"BL_RACE\")") {"BL_RACE" "alpha"})])))
      (spawn (fn [] (erlang/send parent [:b (client-run-env root (list "eval" "(vm.osenv/get \"BL_RACE\")") {"BL_RACE" "beta"})])))
      (let [a (receive [:a r] r (after 25000 {:outs [] :code :timeout}))
            b (receive [:b r] r (after 25000 {:outs [] :code :timeout}))]
        (session/stop listener)
        (is (some (fn [o] (clojure.string/includes? o "alpha")) (:outs a)))
        (is (some (fn [o] (clojure.string/includes? o "beta")) (:outs b)))))))

(deftest g1-a-slow-request-does-not-delay-a-concurrent-fast-one
  (testing "no serial worker: a ~2s request in flight does not queue a fast one behind it"
    (let [root (setup-tree)
          listener (:ok (session/start root))
          parent (erlang/self)]
      (erlang/apply :timer :sleep (list 150))
      (spawn (fn [] (erlang/send parent [:slow (client-run root (list "eval" "(do (erlang/apply :timer :sleep (list 2000)) (println :slow))"))])))
      (erlang/apply :timer :sleep (list 200))
      (let [t0 (System/monotonic_time :millisecond)
            fast (client-run root (list "eval" "(println :fast)"))
            dt (- (System/monotonic_time :millisecond) t0)]
        (is (= 0 (:code fast)))
        (is (some (fn [o] (clojure.string/includes? o "fast")) (:outs fast)))
        (is (< dt 1500))
        (let [slow (receive [:slow r] r (after 8000 {:outs [] :code :timeout}))]
          (session/stop listener)
          (is (some (fn [o] (clojure.string/includes? o "slow")) (:outs slow))))))))

(deftest hello-with-a-bad-token-is-rejected
  (testing "the security boundary is the token — a wrong one gets :reject"
    (let [root (setup-tree)
          listener (:ok (session/start root))]
      (erlang/apply :timer :sleep (list 150))
      (let [ep (:ok (paths/endpoints root))
            charlist (erlang/binary_to_list (:sock ep))
            conn (elem (gen_tcp/connect (tuple :local charlist) 0
                         (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false))) 1)
            bad-token (erlang/list_to_binary (erlang/apply :lists :duplicate (list 32 9)))]
        (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                             (list (tuple :bl 1 :hello {:tree (paths/fingerprint root) :token bad-token}))))
        (let [reply (erlang/apply :erlang :binary_to_term (list (elem (gen_tcp/recv conn 0 5000) 1)))]
          (session/stop listener)
          (is (= :reject (elem reply 2))))))))

(defn- hello-reply [root build]
  (let [ep (:ok (paths/endpoints root))
        conn (elem (gen_tcp/connect (tuple :local (erlang/binary_to_list (:sock ep))) 0
                     (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false))) 1)]
    (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                         (list (tuple :bl 1 :hello {:tree (paths/fingerprint root)
                                                    :token (File/read! (:token ep))
                                                    :build build}))))
    (let [reply (erlang/apply :erlang :binary_to_term (list (elem (gen_tcp/recv conn 0 5000) 1)))]
      (gen_tcp/close conn)
      reply)))

(deftest a-daemon-refuses-a-client-that-expects-another-build
  (testing "the hello names the build; a different one gets :restart_required, never a run"
    (let [root (setup-tree)
          listener (:ok (session/start root))]
      (erlang/apply :timer :sleep (list 150))
      (let [mine (paths/build-id)
            other (hello-reply root (str mine "x"))
            same (hello-reply root mine)]
        (session/stop listener)
        (is (= :reject (elem other 2)))
        (is (= :restart_required (elem other 3)))
        (is (= :ready (elem same 2)))
        (is (= mine (:build (elem same 3))))))))

(deftest a-daemon-records-its-build-and-cleans-up-on-stop
  (testing ".meta names the tree and build; stop removes sock, token and meta"
    (let [root (setup-tree)
          listener (:ok (session/start root))
          ep (:ok (paths/endpoints root))]
      (erlang/apply :timer :sleep (list 150))
      (let [meta (net/read-meta (:meta ep))]
        (is (= (paths/build-id) (:build meta)))
        (is (= root (:root meta))))
      (session/stop listener)
      (is (not (File/exists? (:sock ep))))
      (is (not (File/exists? (:token ep))))
      (is (not (File/exists? (:meta ep)))))))

(run-tests)
