; session_test.bl — the pure-beam-lisp daemon session (PLAN-123 D3).
;
; The WHOLE daemon in beam-lisp: vm.net transport + vm.io proxy + vm.wire codec
; + vm.manager + bl.daemon/handle-in-vm. This drives a real AF_UNIX round-trip
; and asserts a command's stdout streams back as frames and its exit is framed
; after — no Elixir daemon code on the path.

(ns vm.session-test
  (:require [vm.session :as session] [vm.paths :as paths]))

(defn- setup-tree []
  (let [root (str "/tmp/bl-session-test-" (erlang/apply :erlang :unique_integer (list (to-list [:positive]))))]
    (File/mkdir_p! (str root "/priv/boot"))
    (File/write! (str root "/priv/boot/core.bl") "")
    root))

(defn- client-run [root argv]
  (let [ep (:ok (paths/endpoints root))
        charlist (erlang/binary_to_list (:sock ep))
        token (File/read! (:token ep))
        conn (elem (gen_tcp/connect (tuple :local charlist) 0
                     (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false))) 1)]
    (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                         (list (tuple :bl 1 :hello {:tree (paths/fingerprint root) :token token}))))
    (gen_tcp/recv conn 0 5000)
    (let [id (erlang/list_to_binary (erlang/apply :lists :duplicate (list 16 65)))]
      (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                           (list (tuple :bl 1 :request id {:argv argv :cwd root :env {}})))))
    (loop [outs [] code nil]
      (let [r (gen_tcp/recv conn 0 10000)]
        (if (not= :ok (elem r 0))
          {:outs outs :code code}
          (let [f (erlang/apply :erlang :binary_to_term (list (elem r 1)))
                tag (elem f 2)]
            (cond
              (= tag :stdout) (recur (conj outs (elem f 5)) code)
              (= tag :exit) {:outs outs :code (elem f 4)}
              :else (recur outs code))))))))

(deftest a-command-round-trips-through-the-pure-bl-daemon
  (testing "eval streams stdout as frames and exits 0 — no Elixir on the path"
    (let [root (setup-tree)
          listener (:ok (session/start root))]
      (erlang/apply :timer :sleep (list 150))
      (let [r (client-run root (list "eval" "(println (* 6 7))"))]
        (session/stop listener)
        (is (= 0 (:code r)))
        ;; the println's "42" arrived as a stdout frame
        (is (some (fn [o] (clojure.string/includes? o "42")) (:outs r)))))))

(deftest hello-with-a-bad-token-is-rejected
  (testing "the security boundary is the token — a wrong one gets :reject"
    (let [root (setup-tree)
          listener (:ok (session/start root))]
      (erlang/apply :timer :sleep (list 150))
      (let [ep (:ok (paths/endpoints root))
            charlist (erlang/binary_to_list (:sock ep))
            conn (elem (gen_tcp/connect (tuple :local charlist) 0
                         (list (tuple :inet_backend :inet) :local :binary (tuple :packet 4) (tuple :active false))) 1)
            bad-token (erlang/list_to_binary (erlang/apply :lists :duplicate (list 32 9)))]
        (gen_tcp/send conn (erlang/apply :erlang :term_to_binary
                             (list (tuple :bl 1 :hello {:tree (paths/fingerprint root) :token bad-token}))))
        (let [reply (erlang/apply :erlang :binary_to_term (list (elem (gen_tcp/recv conn 0 5000) 1)))]
          (session/stop listener)
          (is (= :reject (elem reply 2))))))))

(run-tests)
