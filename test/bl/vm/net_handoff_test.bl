(ns vm.net-handoff-test (:require [vm.net :as net]))

(defn pair []
 (let [opts (list (tuple :inet_backend :inet) :binary (tuple :packet 4) (tuple :active false))
       listener (elem (gen_tcp/listen 0 opts) 1)
       port (elem (elem (inet/sockname listener) 1) 1)]
  (try
   (let [client (elem (gen_tcp/connect (tuple 127 0 0 1) port opts 5000) 1)
         server (elem (gen_tcp/accept listener 5000) 1)]
    [client server])
   (finally (gen_tcp/close listener)))))
(defn ended? [pid]
 (let [ref (erlang/monitor :process pid)]
  (try
   (receive [:DOWN received :process _pid _why] :when (= received ref) true
    (after 5000 false))
   (finally (erlang/demonitor ref (list :flush))))))

(deftest handler-starts-as-owner-and-closes-on-return-without-acceptor-monitor
 (let [[client server] (pair) observer (erlang/self)]
  (try
   (let [worker (:ok (net/handoff-connection server
                  (fn [] (erlang/send observer (tuple :served (erlang/self)
                              (erlang/port_info server :connected))))))]
    (is (erlang/is_pid worker))
    (let [served (receive [:served pid owner] [pid owner] (after 5000 nil))]
     (is (= worker (first served)))
     (is (= (tuple :connected worker) (second served))))
    (is (ended? worker))
    (is (= (tuple :error :closed) (gen_tcp/recv client 0 5000))))
   (finally (gen_tcp/close client) (gen_tcp/close server)))))

(deftest failed-transfer-never-serves
 (let [[client server] (pair) observer (erlang/self)]
  (try
   (gen_tcp/close server)
   (is (some? (:error (net/handoff-connection server
                   (fn [] (erlang/send observer :unexpected-serving))))))
   (is (= :absent (receive :unexpected-serving :served (after 20 :absent))))
   (finally (gen_tcp/close client) (gen_tcp/close server)))))

(deftest parent-death-on-either-side-of-transfer-closes-without-serving
 (doseq [transfer? [false true]]
  (let [[client server] (pair) observer (erlang/self)
        parent (spawn (fn []
          (receive :own :ok)
          (let [ticket (erlang/make_ref) self (erlang/self)
                worker (spawn (fn [] (net/await-connection-start self ticket server
                              (fn [] (erlang/send observer :unexpected-serving)))))]
           (when transfer? (assert (= :ok (gen_tcp/controlling_process server worker))))
           (erlang/send observer (tuple :waiting worker))
           (receive :die :ok))))]
   (try
    (assert (= :ok (gen_tcp/controlling_process server parent)))
    (erlang/send parent :own)
    (let [worker (receive [:waiting pid] pid (after 5000 nil))]
     (assert (erlang/is_pid worker))
     (erlang/exit parent :kill)
     (is (ended? worker))
     (is (= (tuple :error :closed) (gen_tcp/recv client 0 5000)))
     (is (= :absent (receive :unexpected-serving :served (after 0 :absent)))))
    (finally (erlang/exit parent :kill) (gen_tcp/close client) (gen_tcp/close server))))))
