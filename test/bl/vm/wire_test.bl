; wire_test.bl — vm.wire, the client<->daemon frame codec (PLAN-123 D2).
;
; The wire shape is a CONTRACT with the Rust launcher. These pin the encoders'
; bytes against Elixir's Protocol output and prove decode+validate is total
; (a shape outside the schema is rejected, never executed).

(ns vm.wire-test
  (:require [vm.wire :as wire]))

(defn- hex [b] (erlang/apply :binary :encode_hex (list b)))
(defn- dup [n c] (erlang/list_to_binary (erlang/apply :lists :duplicate (list n c))))

(deftest encoders-are-byte-identical-to-elixir
  (testing "exit + stdout frames match the golden ETF bytes"
    (is (= "8368057702626C61017704657869746B001030313233343536373839616263646566612A"
           (hex (wire/exit (erlang/binary_to_list "0123456789abcdef") 42))))
    (is (= "8368067702626C610177067374646F75746D00000002696461006D000000026869"
           (hex (wire/stdout "id" 0 "hi"))))))

(deftest decode-validates-client-frames
  (testing "a well-formed hello decodes to {:hello …}"
    (let [hello (erlang/apply :erlang :term_to_binary
                  (list (tuple :bl 1 :hello {:tree (dup 32 1) :token (dup 32 2)})))
          r (wire/decode hello)]
      (is (some? (:ok r)))
      (is (= :hello (elem (:ok r) 0)))))
  (testing "a well-formed request decodes with argv + cwd"
    (let [req (erlang/apply :erlang :term_to_binary
                (list (tuple :bl 1 :request (dup 16 65)
                             {:argv (list "eval" "(+ 1 2)") :cwd "/tmp"})))
          r (wire/decode req)]
      (is (some? (:ok r)))
      (is (= :request (elem (:ok r) 0))))))

(deftest decode-rejects-bad-frames
  (testing "a shape outside the schema is rejected, never executed"
    (is (some? (:error (wire/decode (erlang/apply :erlang :term_to_binary (list (tuple :not :bl))))))))
  (testing "a hello with a short tree is malformed"
    (let [bad (erlang/apply :erlang :term_to_binary
                (list (tuple :bl 1 :hello {:tree (dup 8 1) :token (dup 32 2)})))]
      (is (= {:error :malformed} (wire/decode bad)))))
  (testing "a request with a non-16-byte id is malformed"
    (let [bad (erlang/apply :erlang :term_to_binary
                (list (tuple :bl 1 :request "short" {:argv (list "x") :cwd "/tmp"})))]
      (is (= {:error :malformed} (wire/decode bad))))))

(run-tests)
