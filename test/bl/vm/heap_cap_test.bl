; heap_cap_test.bl — a realm's :max-heap-words reaches its processes.
;
; The spec option existed and no cap ever applied. `env/fork` forwarded only :caps to
; the host fork, so a heap bound named in a project's env.bl was dropped on the way
; (measured: a 30M-element hog ran 25 s unkilled under a "1,000,000 word" cap), and
; a member started with `owner/spawn-in` never had the bound set on the process even
; when the env carried it. The bound is PER PROCESS (OTP's max_heap_size), so these
; tests assert what it is: a runaway member dies, its siblings and the registry do not.

(ns vm.heap-cap-test
  (:require [env] [vm.owner :as owner] [vm.core :as vmc]))

(def CAP 1000000)          ; words: 8 MB

;; A member's thunk runs in a process under the VM's env, where this namespace's
;; vars are not bound. So the thunks below carry their numbers and the allocator
;; as one self-contained fn.
(defn- hog-fn [elements]
  (fn [] (loop [acc [] n 0] (if (> n elements) (count acc) (recur (conj acc n) (inc n))))))

(defn- down-reason [pid ms]
  (erlang/monitor :process pid)
  (receive [:DOWN _r :process _p reason] reason (after ms :alive)))

(deftest a-forked-env-keeps-the-heap-bound-it-was-given
  (is (= CAP (BeamLisp.Env/heap_of (env/fork :global {:max-heap-words CAP})))
      "env/fork must forward :max-heap-words, not only :caps")
  (is (nil? (BeamLisp.Env/heap_of (env/fork :global {}))) "no option, no bound")
  (let [parent (env/fork :global {:max-heap-words CAP})]
    (is (= CAP (BeamLisp.Env/heap_of (env/fork parent {:max-heap-words (* 2 CAP)})))
        "a child never gets more than its parent")))

(deftest a-realms-member-is-killed-when-it-outgrows-the-cap
  (owner/start)
  (let [vm (vmc/spawn-vm {:id "heap@cap" :root "/tmp" :max-heap-words CAP})
        hog (vmc/serve vm :hog (hog-fn 30000000))]
    (is (= :killed (down-reason hog 20000)) "a hog past the cap dies instead of eating the node")))

(deftest a-member-under-the-cap-lives
  (owner/start)
  (let [vm (vmc/spawn-vm {:id "heap@ok" :root "/tmp" :max-heap-words CAP})
        small (vmc/serve vm :small (fn [] ((hog-fn 10000)) (Process/sleep 600) :done))]
    (is (= :normal (down-reason small 20000)))))

(deftest killing-one-hog-leaves-its-siblings-and-the-registry
  (owner/start)
  (let [vm (vmc/spawn-vm {:id "heap@sib" :root "/tmp" :max-heap-words CAP})
        sibs (doall (map (fn [_] (vmc/serve vm :s (fn [] (Process/sleep 4000)))) (range 3)))
        hog (vmc/serve vm :hog (hog-fn 30000000))]
    (down-reason hog 20000)
    (is (= 3 (count (filter erlang/is_process_alive sibs))) "siblings untouched")
    (is (= 3 (count (owner/procs "heap@sib"))) "and the registry kept exactly them")
    (doseq [p sibs] (erlang/exit p :kill))))

(deftest an-uncapped-realm-is-left-alone
  (owner/start)
  (let [vm (vmc/spawn-vm {:id "heap@free" :root "/tmp"})
        p (vmc/serve vm :m (fn [] ((hog-fn 2000000)) (Process/sleep 300) :done))]
    (is (= :normal (down-reason p 30000)) "no cap, no kill")))

(run-tests)
