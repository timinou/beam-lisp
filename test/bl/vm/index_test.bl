; index_test.bl — vm.index, the warm code-index owner (FUP-085).
;
; The property that matters is WHERE work runs: a datom conn's ETS store lives
; exactly as long as the process that made it, so a conn built in a per-command
; process dies with the answer. vm.index is the process that HOLDS it between
; questions, one per realm (root). These prove run-on-owner, that a table built
; during a request outlives the requester, and that the progress row reads
; without blocking — the same properties the Elixir Daemon.IndexWorker guaranteed.

(ns vm.index-test
  (:require [vm.index :as index]))

(defn- tmp-root []
  (str "/tmp/bl-index-test-"
       (erlang/apply :erlang :unique_integer (list (to-list [:positive])))))

(defn- fresh-owner
  "A private owner for one assertion, for a scratch root with no tree to index
   behind the test's back (`:build false`). Returns {:root r :pid p}."
  []
  (let [root (tmp-root)
        pid (index/start-for root "vm.index-test" {:build false})]
    {:root root :pid pid}))

(deftest run-executes-on-the-owner-not-the-caller
  (testing "run/2 hands the thunk to the root's owner process"
    (let [o (fresh-owner)
          root (get o :root)
          pid (get o :pid)
          ran-on (index/run root (fn [] (erlang/self)))]
      (is (erlang/is_pid pid))
      (is (= pid ran-on))
      (index/stop-for root))))

(deftest a-table-built-in-a-request-outlives-the-requester
  (testing "an ETS table created inside run/2 survives, because the owner holds it"
    (let [o (fresh-owner)
          root (get o :root)]
      (index/run root (fn []
                        (when (= :undefined (erlang/apply :ets :whereis (list :vm_index_probe)))
                          (erlang/apply :ets :new
                            (list :vm_index_probe (to-list [:set :public :named_table]))))
                        :ok))
      ;; the calling (test) process has returned from run; the table is the owner's
      (is (not= :undefined (erlang/apply :ets :whereis (list :vm_index_probe))))
      (index/stop-for root))))

(deftest progress-reads-without-a-call
  (testing "the progress row is ETS — a start frame then a file frame render"
    (let [o (fresh-owner)
          root (get o :root)]
      (is (= :cold (:phase (index/progress root))))
      (index/progress! root {:phase :start :n 8})
      (is (= :building (:phase (index/progress root))))
      (index/progress! root {:phase :file :i 2 :n 8 :file "x.bl"})
      (let [p (index/progress root)]
        (is (= 3 (:done p)))
        (is (= 8 (:total p)))
        (is (= "x.bl" (:file p))))
      (index/stop-for root))))

(deftest progress-ignores-a-non-frame
  (testing "a non-map (a Vector/Set) is not a frame and never corrupts the row"
    (let [o (fresh-owner)
          root (get o :root)]
      (index/progress! root {:phase :start :n 4})
      (index/progress! root [:not :a :frame])
      (is (= :building (:phase (index/progress root))))
      (index/stop-for root))))

(deftest a-failed-build-records-its-subject
  (testing "the error frame names the OPERATION, the ROOT and the FILE — a bare "
           "\"argument error\" tells a reader nothing they can act on"
    (let [f (index/error-frame "code.index/ensure-tree" "/tree" "/tree/bad.bl"
                              "could not read file \"/tree/bad.bl\": permission denied")]
      (is (= :error (:phase f)))
      (is (= "code.index/ensure-tree" (:op f)))
      (is (= "/tree" (:root f)))
      (is (= "/tree/bad.bl" (:file f)))
      (is (includes? (:message f) "/tree/bad.bl") "the message names the path")
      (is (includes? (:message f) "code.index/ensure-tree") "and the operation")
      (is (includes? (:message f) "permission denied") "and the cause"))))

(deftest a-build-that-cannot-resolve-its-root-records-that-too
  ; A genuinely fatal build — one the walk cannot even start — must still FAIL,
  ; with the reason ON THE ROW. The pane reads the row, so a fatal error has to
  ; reach it as something a person can act on.
  (let [root 12345]
    (index/start-for root "vm.index-test" {:build true})
    ; The build runs on the owner off the mailbox, so POLL rather than sleep a
    ; guessed number of milliseconds: a fixed wait is a flake on a slow machine
    ; and a false green if the build never ran at all.
    (let [p (loop [n 0]
              (let [row (index/progress root)]
                (if (or (= :error (:phase row)) (>= n 2400))
                  row
                  (do (erlang/apply :timer :sleep (list 25))
                      (recur (inc n))))))]
      (is (= :error (:phase p)) "the failed build is recorded, not swallowed")
      (is (= "code.index/ensure-tree" (:op p)) "the operation is on the frame")
      (is (= 12345 (:root p)) "and the root it was working on")
      (is (includes? (:message p) "code.index/ensure-tree") "the message names the operation")
      (is (includes? (:message p) "12345") "and the root it could not resolve"))
    (index/stop-for root)))

(run-tests)
