(ns vm.realm-identity-test (:require [vm.manager :as mgr] [veritas.model :as vm]))
(defn refused? [f]
 (try (f) false (catch _ true)))
(deftest display-id-never-authorizes-cross-project-or-changed-capability-reuse
 (let [id (str "identity-" (erlang/unique_integer (list :positive)))
       a {:id id :root (str (System/tmp_dir!) "/identity-a") :caps []}
       b (assoc a :root (str (System/tmp_dir!) "/identity-b"))]
  (mgr/start)
  (try
   (let [first-open (mgr/open a) e (:env (:vm first-open))]
    (is (:created first-open))
    (is (= e (:env (mgr/ensure a))))
    (is (= false (:created (mgr/open a))))
    (is (refused? (fn [] (mgr/open b))))
    (is (refused? (fn [] (mgr/ensure b))))
    (is (refused? (fn [] (mgr/validate-spec! b))))
    (is (refused? (fn [] (mgr/validate-root! b))))
    (is (refused? (fn [] (mgr/ensure (assoc a :caps :all)))))
    (is (= :ok (mgr/validate-root! (assoc a :caps :all))))
    (is (= e (:env (mgr/get-vm id))))
    (is (= :ok (mgr/validate-spec! a))))
   (finally (mgr/drain id)))))
(deftest truncated-module-key-collision-declines-before-environment-creation
 (let [id (str "key-collision-" (erlang/unique_integer (list :positive)))
       other (str id "-other") key "forced-collision"
       a {:id id :root (str (System/tmp_dir!) "/key-a") :key key :caps []}
       b {:id other :root (str (System/tmp_dir!) "/key-b") :key key :caps []}]
  (mgr/start)
  (try
   (mgr/open a)
   (is (refused? (fn [] (mgr/open b))))
   (is (= nil (mgr/get-vm other)))
   (is (some? (mgr/get-vm id)))
   (mgr/drain id)
   (is (:created (mgr/open b)))
   (finally (mgr/drain id) (mgr/drain other)))))

(deftest generated-actual-manager-histories-preserve-project-ownership
 (mgr/start)
 (let [root-a (str (System/tmp_dir!) "/history-realm-a")
       root-b (str (System/tmp_dir!) "/history-realm-b")
       model (vm/model "display collision cannot transfer realm ownership"
        {:state {:root nil}
         :init (fn [] (str "realm-history-" (erlang/unique_integer (list :positive))))
         :cleanup (fn [id] (mgr/drain id))
         :commands
         (into {} (map (fn [[op root]]
           [op {:next (fn [s _] (if (= :drain op) {:root nil}
                                 (if (:root s) s {:root root})))
                :run (fn [id _]
                       (if (= :drain op) (mgr/drain id)
                        (try (mgr/open {:id id :root root :caps []}) (catch _ nil))))}])
          [[:open-a root-a] [:open-b root-b] [:drain nil]]))
         :invariants {:owner (fn [s id] (= (:root s) (:root (mgr/get-vm id))))}})
       result (vm/check model {:seed 23 :histories 200 :max-len 12})]
  (is (= :witnessed (:modality result)))
  (println "realm-identity-histories" (select-keys result [:modality :histories :steps]))))
