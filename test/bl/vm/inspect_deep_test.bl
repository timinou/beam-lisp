; inspect_deep_test.bl — the pane's deep row and its ticker line (FUP-106).
;
; The summary row says WHERE a schedule stands. The deep row says WHAT IT HAS
; BEEN DOING, for ONE declaration: its recent occurrences with their outcomes,
; its refusals, and its verify verdict. This file pins the four properties that
; make it a READING of the store the pane already has rather than a second
; monitor beside it:
;
;   * it renders the ZERO case — a declaration that has never run, and one that
;     was REFUSED. Those are the two rows an operator comes for, and `declares
;     nothing` versus `declares a wheel that cannot turn` is a difference only a
;     refusal row can draw.
;   * the ORDER is newest first, asserted because it cannot be seen in the shape
;     of the value — and it is the difference between "what just happened?" and a
;     log.
;   * an occurrence carries its OUTCOME — `:ok` against `:failed`, and the
;     reason the store kept beside it — asserted because an outcome that was
;     always `:ok` would still look right on every happy schedule.
;   * the TICKER is a monitor's fact: the wheel is drawn from the runtime's name
;     table and never asked, so killing it must move the line.
;   * the window is BOUNDED, and rendering it WRITES NOTHING — the store's basis
;     is the observable (FUP-101).

(ns vm.inspect-deep-test
  (:require [proc :as proc] [proc.sched :as sched] [datom :as datom]
            [vm.inspect :as inspect]))

(def beats (atom 0))

;; A wheel that records every occurrence, so the deep row has a history to window.
;; 25 ms, so a test does not wait a second for six occurrences.
(proc/defserver deep-probe
  (sched {:clock proc/wall-ms}
    (every 25 :ms :beat (fn [_] (swap! beats inc)) {:catch-up :skip})))

;; The zero case: declared, alive, and with nothing to do for an hour.
(proc/defserver deep-idle
  (sched {:clock proc/wall-ms}
    (every 1 :h :idle (fn [_] (swap! beats inc)) {:catch-up :skip})))

;; A body that THROWS: the outcome half of the deep row needs a failure to be
;; right about, and `:on-error :continue` keeps the wheel alive so it can fail
;; more than once.
(proc/defserver deep-failer
  (sched {:clock proc/wall-ms}
    (every 30 :ms :boom (fn [_] (throw (ex-info "boom: the body threw" {})))
           {:catch-up :skip :on-error :continue})))

(defn- row-for [m srv id]
  (first (filter (fn [r] (and (= srv (:server r)) (= id (:id r)))) (:schedules m))))

(defn- ticker-for [m srv]
  (first (filter (fn [t] (= srv (:server t))) (:ticker m))))

(defn- descending?
  "Whether every element is greater than the one after it — the order the deep
   row documents. Written as adjacent pairs rather than a chain of `>`, so a
   1-row list is trivially in order and a 0-row list is never consulted."
  [xs]
  (every? (fn [i] (> (nth xs i) (nth xs (inc i)))) (range (dec (count xs)))))

;; ── the zero case ───────────────────────────────────────────────────────

(deftest a-declaration-that-never-ran-still-renders
  ;; A schedule that has fired nothing is usually the one an operator is looking
  ;; for. It must render with an EMPTY occurrence list, not as a missing row, and
  ;; it must not claim a refusal or a verdict it was never given.
  (let [s (start deep-idle nil {})]
    (let [deep (inspect/deep-row "deep-idle" "idle")]
      (is (some? deep) "a declaration that never ran still has a deep row")
      (is (= [] (:occurrences deep)) "…with no occurrences, which is the honest answer")
      (is (= [] (:refusals deep)) "…and nothing refused")
      (is (= :active (:state deep)))
      (is (nil? (:verify deep)) "…and no verdict, so a face draws no verify line"))
    (stop s))
  ;; and it reaches its OWN row through the model's `:deep` opt
  (let [m (inspect/model {:deep ["deep-idle" "idle"]})
        r (row-for m "deep-idle" "idle")]
    (is (some? r))
    (is (= [] (get (:deep r) :occurrences)))
    (is (includes? (inspect/render-text m) "deep")
        "the terminal face draws the deep block for the row it was asked about")))

(deftest a-refused-declaration-shows-its-refusal
  ;; A REFUSAL IS A FACT (proc.sched/refuse!): a wheel that cannot turn writes a
  ;; `:refused` row with its reason. Without it, `this project declares nothing`
  ;; and `this project declares something that cannot turn` are the same picture
  ;; — an absent row — and telling them apart is what the deep row is for.
  (let [r (sched/refuse! "deep-refused@x" :gone
                         "schedule gone: :run must be a \"namespace/verb\" string")
        deep (inspect/deep-row "deep-refused@x" "gone")]
    (is (= :refused r))
    (is (some? deep))
    (is (= [] (:occurrences deep)) "a refused declaration never ran")
    (is (= 1 (count (:refusals deep))) "…and its refusal is a row of its own")
    (is (includes? (:reason (first (:refusals deep))) "namespace/verb")
        "…carrying the reason it could not turn")
    (is (= :refused (:state deep)))
    (is (includes? (inspect/render-text (inspect/model {:deep ["deep-refused@x" "gone"]}))
                   "refusal"))))

;; ── the order, documented and asserted ──────────────────────────────────

(deftest the-deep-row-is-newest-first
  ;; Documented order: MOST RECENT FIRST. The row exists to answer `what just
  ;; happened?`, so the newest occurrence is the one a reader can still act on;
  ;; showing the oldest first would bury it under the history it is meant to
  ;; summarise. Asserted here because a caller cannot see the order in the value.
  (let [s (start deep-probe nil {})]
    (Process/sleep 120)
    ;; STOP the wheel before reading twice. Two reads a millisecond apart belong
    ;; to a world in which the schedule may fire between them — the honest limit
    ;; of "the two faces agree" (the design's own caveat) — and the assertion
    ;; below compares two of them. Removing the only writer makes it decidable.
    (stop s)
    (Process/sleep 20)
    (let [occ (:occurrences (inspect/deep-row "deep-probe" "beat"))]
      (is (>= (count occ) 2)
          (str "there is more than one occurrence to order (saw " (count occ) ")"))
      (is (descending? (map (fn [o] (:due o)) occ))
          "every occurrence is newer than the one after it")
      (is (= (:last-occ (row-for (inspect/model {}) "deep-probe" "beat"))
             (:occurrence (first occ)))
          "the FIRST row is the store's own last occurrence — the newest fact"))))

;; ── the outcome is a join, not a guess ─────────────────────────────────

(deftest an-occurrence-carries-its-outcome
  ;; `:ok` against `:failed` is the join between an occurrence and its failure:
  ;; proc.sched writes the occurrence id and the counter in ONE transaction, so
  ;; the transaction id is what says `this one failed`. An outcome that was
  ;; always `:ok` would look right on every happy schedule, which is why this
  ;; case exists — and why the schedule's own `:runs` is asserted to have stayed
  ;; put while `:fails` climbed.
  (let [s (start deep-failer nil {})]
    (Process/sleep 100)
    (stop s)
    (Process/sleep 20)
    (let [deep (inspect/deep-row "deep-failer" "boom")
          occ (:occurrences deep)
          failed (filter (fn [o] (= :failed (:outcome o))) occ)]
      (is (some? deep))
      (is (pos? (count occ)) "the occurrence was recorded even though the body threw")
      (is (= (count occ) (count failed)) "every occurrence FAILED")
      (is (= [] (filter (fn [o] (= :ok (:outcome o))) occ)) "…and none is called ok")
      (is (includes? (:reason (first failed)) "boom")
          "…with the reason the store kept beside it")
      (is (= 0 (:runs (row-for (inspect/model {}) "deep-failer" "boom")))
          "a failed occurrence is not a run")
      (is (pos? (:fails (row-for (inspect/model {}) "deep-failer" "boom"))))
      ;; …and the TICKER counts a failure as a fire. `:schedule/last-run` is
      ;; written on the success arm only, so a wheel that fails every time would
      ;; read `never fired` — the one thing it certainly is not.
      (is (some? (:last-fired-age-ms (ticker-for (inspect/model {}) "deep-failer")))))))

;; ── bounded, and read-only ──────────────────────────────────────────────

(deftest the-deep-row-is-bounded
  ;; The window is a WINDOW: a declaration that has fired thousands of times must
  ;; render the same number of lines as one that fired six, or the pane becomes a
  ;; log viewer. Arrange MORE occurrences than the limit and assert the cap — and
  ;; assert the cap is below the count that really happened, so the bound is
  ;; doing work rather than the schedule being slow.
  (let [s (start deep-probe nil {})]
    (Process/sleep (* 25 (+ inspect/DEEP-LIMIT 8)))
    (stop s)
    (Process/sleep 20)
    (let [r (row-for (inspect/model {}) "deep-probe" "beat")
          deep (inspect/deep-row "deep-probe" "beat")]
      (is (>= (:runs r) (inc inspect/DEEP-LIMIT))
          "the schedule fired more times than the window keeps")
      (is (= inspect/DEEP-LIMIT (count (:occurrences deep)))
          "…and the deep row shows exactly the bound, not the whole history")
      (is (descending? (map (fn [o] (:due o)) (:occurrences deep)))
          "…still newest first, even truncated"))))

(deftest rendering-the-deep-row-writes-nothing
  ;; FUP-101's rule, extended to the new row. A render that transacted would queue
  ;; behind the scheduler's writer, and this host has ONE dirty-IO scheduler. The
  ;; basis is the observable: a transaction advances it and a read cannot.
  ;;
  ;; The wheel is STOPPED first, and not for convenience: it writes on every wake,
  ;; so measuring with one running would measure the WHEEL. Removing the only
  ;; other writer is what makes a moved basis mean this row moved it.
  (let [s (start deep-probe nil {})]
    (Process/sleep 70)
    (stop s)
    (Process/sleep 30)
    (let [before (datom/basis-t (datom/db (proc/conn)))]
      (is (some? (inspect/deep-row "deep-probe" "beat"))
          "the row is still readable with no wheel running")
      (reduce (fn [_ _] (inspect/deep-row "deep-probe" "beat")) nil (range 30))
      (is (= before (datom/basis-t (datom/db (proc/conn))))
          "30 deep renders advanced the store's basis — the render path wrote")
      (is (= before (do (inspect/render-text (inspect/model {:deep ["deep-probe" "beat"]}))
                        (inspect/json {:deep ["deep-probe" "beat"]})
                        (datom/basis-t (datom/db (proc/conn)))))
          "…and the terminal and JSON faces are as read-only as the model"))))

;; ── the ticker: a monitor's fact ────────────────────────────────────────

(deftest the-ticker-line-changes-when-the-ticker-is-killed
  ;; The ticker is the ONE live thing in a store-only view, so it is drawn from a
  ;; monitor's fact — the runtime's own name table, which ERTS frees the instant a
  ;; process dies — and never by asking the wheel. Killing it must move the line,
  ;; or the pane is lying about the one fact it cannot read from the store.
  (let [s (start deep-probe nil {})]
    (Process/sleep 40)
    (is (some? s) "a wheel was started to kill")
    (let [before (inspect/model {})
          t0 (ticker-for before "deep-probe")]
      (is (some? t0) "the wheel appears in the ticker line")
      (is (= true (:alive t0)))
      (is (some? (:pid t0)) "…with the pid the runtime knows it by")
      (erlang/exit (Process/whereis (sched/op-name "deep-probe")) :kill)
      (Process/sleep 60)
      (let [after (inspect/model {})
            t1 (ticker-for after "deep-probe")]
        (is (some? t1) "the line outlives the process — the store half remains")
        (is (= false (:alive t1)) "…and now says dead")
        (is (nil? (:pid t1)))
        ;; the TERMINAL face, not just the value: the line is what a human reads
        (is (includes? (inspect/render-text before) "bl-sched/deep-probe  alive"))
        (is (includes? (inspect/render-text after) "bl-sched/deep-probe  dead")))
      ;; the name is freed by the death, so a wheel can start again — the death
      ;; did not leave the declaration unstartable
      (let [s2 (start deep-probe nil {})]
        (is (some? s2))
        (stop s2)))))

(deftest the-json-face-carries-the-ticker-and-the-deep-row
  ;; One model, three faces: a field added to the model is a field the JSON face
  ;; serves, or the faces have drifted into two truths.
  (let [s (start deep-probe nil {})]
    (Process/sleep 40)
    (let [j (inspect/json {:deep ["deep-probe" "beat"]})
          row (first (filter (fn [x] (= "deep-probe/beat" (get x "key")))
                             (get j "schedules")))]
      (is (contains? j "ticker"))
      (is (some (fn [t] (= "deep-probe" (get t "server"))) (get j "ticker")))
      (is (some? row))
      (is (contains? row "deep") "the deep row rides the row it belongs to")
      (is (erlang/is_binary (get-in row ["deep" "state"]))
          "…and is string-keyed like every other JSON map"))
    (stop s)))
