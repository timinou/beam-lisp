; Regression: VM orchestration starts native servers through core, not vm.core.
(ns vm.exec-start-test
  (:require [vm.exec :as exec]))

(deftest sequencer-starts-and-is-idempotent
  (let [p (exec/start)]
    (is (erlang/is_pid p))
    (is (= p (exec/start)))
    (is (= p (exec/run-reload (fn [] (erlang/self)))))
    (erlang/exit p :kill)))
