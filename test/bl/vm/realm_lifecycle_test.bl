(ns vm.realm-lifecycle-test
  (:require [bl.realm-lifecycle :as lifecycle]))

(deftest lifecycle-options-preserve-explicit-idle-and-dashboard-policy
  (is (= 28800 lifecycle/DEFAULT-IDLE-SECONDS))
  (is (= 28800 (:idle (lifecycle/start-options {})))))

(deftest lifecycle-options-honor-flags
  (is (= 0 (:idle (lifecycle/start-options {:idle 0}))))
  (is (= 90 (:idle (lifecycle/start-options {:idle 90}))))
  (is (= true (:ui (lifecycle/start-options {}))))
  (is (= false (:ui (lifecycle/start-options {:no-ui true}))))
  (is (= true (:commands-only (lifecycle/start-options {:commands-only true}))))
  (is (= "/x.log" (:log (lifecycle/start-options {:log "/x.log"}))))
  (is (= true (:shared (lifecycle/start-options {:share-vm true})))))

(deftest lifecycle-uses-nearest-project-from-subdirectories
  (let [root (str (System/tmp_dir!) "/realm-lifecycle-" (erlang/unique_integer (list :positive)))
        nested (str root "/nested")]
    (File/mkdir_p! nested)
    (File/write! (str root "/env.bl") "{}")
    (try
      (BeamLisp/with_cwd nested
        (fn []
          (is (= root (lifecycle/root-of {})))
          (is (= nested (lifecycle/root-of {:root nested})))))
      (finally (File/rm_rf! root)))))
