(ns vm.net-listener-ownership-test
 (:require [vm.net :as net] [vm.osenv :as osenv] [vm.paths :as paths] [env]))
(defn ended? [pid]
 (let [ref (erlang/monitor :process pid)]
  (try
   (receive [:DOWN seen :process _pid _reason] :when (= ref seen) true
    (after 5000 false))
   (finally (erlang/demonitor ref (list :flush))))))
(deftest acceptor-death-closes-listener-and-allows-a-fresh-bind
 (let [runtime (str (System/user_home!) "/.tmp/nlo-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! runtime) (File/chmod runtime 448)
  (try
   (osenv/with-env {"XDG_RUNTIME_DIR" runtime "BL_BUILD_ID" "listener-ownership"}
    (fn []
     (let [first (:ok (net/listen nil (fn [_ _] nil) {:shared true}))]
      (assert first "fixture listener starts")
      (try
       (is (= (tuple :connected (:pid first)) (erlang/port_info (:lsock first) :connected)))
       (erlang/exit (:pid first) :kill)
       (assert (ended? (:pid first)))
       (is (= :undefined (erlang/port_info (:lsock first))))
       (is (not (net/answering? (:sock-path first))))
       (let [next (net/listen nil (fn [_ _] nil) {:shared true})]
        (is (some? (:ok next)))
        (when (:ok next) (net/stop (:ok next))))
       (finally (net/stop first))))))
   (finally (File/rm_rf! runtime)))))

(defn with-runtime [f]
 (let [runtime (str (System/user_home!) "/.tmp/nlo-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! runtime) (File/chmod runtime 448)
  (try
   (osenv/with-env {"XDG_RUNTIME_DIR" runtime "BL_BUILD_ID" "listener-ownership"} f)
   (finally (File/rm_rf! runtime)))))

(deftest short-lived-starter-does-not-own-the-listening-port
 (with-runtime (fn []
  (let [observer (erlang/self)
        work (env/convey (fn [_unused]
         (erlang/send observer (tuple :listener-started
          (net/listen nil (fn [_ _] nil) {:shared true})))))
        starter (spawn (fn [] (work nil)))
        result (receive [:listener-started value] value (after 5000 nil))
        listener (:ok result)]
   (try
    (assert listener "short-lived fixture starts")
    (assert (ended? starter))
    (is (erlang/is_process_alive (:pid listener)))
    (is (= (tuple :connected (:pid listener)) (erlang/port_info (:lsock listener) :connected)))
    (is (net/answering? (:sock-path listener)))
    (finally
     (when listener (net/stop listener))
     (erlang/exit starter :kill)))))))

(deftest metadata-rename-failure-refuses-start-and-closes-the-bound-socket
 (with-runtime (fn []
  (let [endpoint (:ok (paths/endpoints nil (paths/build-id) true))]
   (File/mkdir_p! (:meta endpoint))
   (let [result (try (net/listen nil (fn [_ _] nil) {:shared true})
                    (catch error {:exception error}))]
    (try
     (is (some? (:exception result)))
     (is (not (net/answering? (:sock endpoint))))
     (is (not (File/exists? (:sock endpoint))))
     (is (not (File/exists? (str (:meta endpoint) ".tmp." (erlang/apply :os :getpid (list))))))
     (finally (when (:ok result) (net/stop (:ok result))))))))))

(deftest retiring-an-old-listener-cannot-unlink-its-replacement
 (with-runtime (fn []
  (let [old (:ok (net/listen nil (fn [_ _] nil) {:shared true}))]
   (assert old)
   (try
    (erlang/exit (:pid old) :kill) (assert (ended? (:pid old)))
    (let [current (:ok (net/listen nil (fn [_ _] nil) {:shared true}))]
     (assert current)
     (try
      (net/stop old)
      (is (net/answering? (:sock-path current)))
      (is (File/exists? (:token-path current)))
      (is (File/exists? (:meta-path current)))
      (finally (net/stop current))))
    (finally (net/stop old)))))))
