; inspect_test.bl — vm.inspect, the session's read-model (FUP-085).
;
; One model, two faces: `bl daemon status` and the browser page render the SAME
; value, so they cannot disagree. These pin the model's shape, that a claim
; shows up as a port row with the address a human keeps, and that the terminal
; render and the JSON face agree with the model — the covenant Daemon.Inspect held.

(ns vm.inspect-test
  (:require [vm.inspect :as insp] [vm.ports :as ports] [vm.paths :as paths]))

(def ROOT (BeamLisp/cwd))

(defn- cleanup [] (ports/release "web" {:root ROOT}) (ports/release "ui" {:root ROOT}))

(deftest the-model-has-the-five-panes
  (testing "identity, ports, tasks, index and image compose one value"
    (let [m (insp/model {:root ROOT})]
      (is (contains? m :identity))
      (is (contains? m :ports))
      (is (contains? m :tasks))
      (is (contains? m :index))
      (is (contains? m :identity))
      (is (= (paths/tree-id ROOT) (get-in m [:identity :tree-id]))))))

(deftest a-claim-is-a-port-row-with-a-named-url
  (testing "a live claim shows up in the ports pane with the address it answers at"
    (cleanup)
    (ports/claim "web" 0 {:root ROOT :hosts (to-list ["web.beam-lisp.test"])})
    (let [m (insp/model {:root ROOT})
          web (some (fn [p] (if (= "web" (:name p)) p nil)) (:ports m))]
      (is (not (nil? web)))
      (is (= (to-list ["web.beam-lisp.test"]) (:hosts web)))
      (is (clojure.string/starts-with? (:url web) "http://web.beam-lisp.test"))
      (is (clojure.string/starts-with? (:loopback web) "http://127.0.0.1:")))
    (cleanup)))

(deftest render-text-shows-identity-and-tree
  (testing "the terminal face renders from the model — pid, tree_id, uptime"
    (let [m (insp/model {:root ROOT :started-at (- (erlang/system_time :second) 5)})
          txt (insp/render-text m)]
      (is (clojure.string/starts-with? txt "bl daemon"))
      (is (clojure.string/includes? txt "tree_id"))
      (is (clojure.string/includes? txt (:name (:identity m)))))))

(deftest json-is-string-keyed-and-struct-free
  (testing "the JSON face has string keys and never a struct or pid term"
    (let [j (insp/json {:root ROOT})]
      (is (contains? j "identity"))
      (is (contains? j "ports"))
      (is (contains? j "index"))
      (is (erlang/is_binary (get (get j "identity") "tree-id"))))))

(run-tests)
