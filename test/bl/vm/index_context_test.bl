(ns vm.index-context-test
 (:require [vm.index :as index] [diagnostics :as diag] [env]))

(deftest index-owner-conveys-each-caller-and-restores-its-own-scopes
 (let [root (str (System/tmp_dir!) "/index-context-" (erlang/unique_integer (list :positive)))
       p (index/start-for root "index-context-fixture" {:build false})
       before (call p [:run (fn [] (env/capture))] :infinity)]
  (try
   (doseq [operation ["index-first" "index-second"]]
    (diag/with-context {:diagnostics/operation-id operation}
     (is (= operation (index/run root (fn [] (:diagnostics/operation-id (diag/context))))))
     (is (= p (index/run root (fn [] (erlang/self)))))))
   (is (= before (call p [:run (fn [] (env/capture))] :infinity)))
   (finally (index/stop-for root)))))
