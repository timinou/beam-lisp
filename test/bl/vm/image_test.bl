; test/bl/vm/image_test.bl — the image-kind rule: dev, release, drop.
; Run: bl test test/bl/vm/image_test.bl
;
; Ported from the ExUnit `test/beam_lisp/image_test.exs`. The kind of image is
; what gates MUTATING reloads: `reload` refuses a commit in a packaged image
; unless `BEAM_LISP_RELOAD` is set, and `bl.doctor` reports what the image is.
; Both read `vm.image`, which is the ONE place the rule lives — so the ways that
; decision can go wrong are pinned here, against the environment it is read from.
;
; Isolation. Every case sets the four signal variables and restores them, so a
; test cannot leak a kind into the next one. (`bl test` already runs each FILE in
; its own VM; the save/restore makes this file self-contained too.)

(ns vm.image-test
  (:require [vm.image :as image]))

(def env-keys ["BL_BIN" "BEAM_LISP_IMAGE" "BEAM_LISP_DEV" "BEAM_LISP_RELOAD"])

(defn- restore-env
  "Put an environment variable back the way it was found: unset stays unset."
  [k v]
  (if (nil? v) (System/delete_env k) (System/put_env k v)))

(defn- with-clean-env
  "Run `f` with the four image-signal variables cleared, restoring the whole set
   afterwards — the ExUnit suite's `setup`/`on_exit`."
  [f]
  (let [saved (map (fn [k] [k (System/get_env k)]) env-keys)]
    (doseq [k env-keys] (System/delete_env k))
    (try
      (f)
      (finally
        (doseq [pair saved] (restore-env (first pair) (second pair)))))))

(deftest a-plain-vm-is-development
  (with-clean-env
    (fn []
      (is (= "dev" (image/kind)))
      (is (image/dev?))
      (is (image/mutable?)))))

(deftest a-release-says-so-and-refuses-to-mutate-itself
  (with-clean-env
    (fn []
      (System/put_env "BEAM_LISP_IMAGE" "release")
      (is (= "release" (image/kind)))
      (is (not (image/dev?)))
      (is (not (image/mutable?))))))

(deftest a-drop-is-recognised-by-the-launchers-bl-bin
  (with-clean-env
    (fn []
      ;; Measured: the Rust launcher sets BL_BIN to the compound it runs from,
      ;; and it is nil under `mix bl`.
      (System/put_env "BL_BIN" "/somewhere/app")
      (is (= "drop" (image/kind)))
      (is (not (image/mutable?))))))

(deftest bl-bin-outranks-a-releases-declaration
  (with-clean-env
    (fn []
      ;; Priority is part of the rule: when BOTH signals are present, BL_BIN (a
      ;; drop's launcher naming its compound) is checked before BEAM_LISP_IMAGE
      ;; (a release's own declaration) — the exact order the host rule had.
      (System/put_env "BEAM_LISP_IMAGE" "release")
      (System/put_env "BL_BIN" "/somewhere/app")
      (is (= "drop" (image/kind)))
      (is (not (image/mutable?))))))

(deftest an-operator-can-opt-a-packaged-image-into-mutation
  (with-clean-env
    (fn []
      (System/put_env "BL_BIN" "/somewhere/app")
      (System/put_env "BEAM_LISP_RELOAD" "1")
      (is (image/mutable?))
      (is (= "drop" (image/kind)) "opting in does not change what it IS"))))

(deftest a-tree-can-declare-itself-development
  (with-clean-env
    (fn []
      (System/put_env "BL_BIN" "/somewhere/app")
      (System/put_env "BEAM_LISP_DEV" "1")
      (is (= "dev" (image/kind)) "the tree's declaration wins over the drop's BL_BIN")
      (is (image/mutable?)))))

(deftest mix-is-not-what-makes-an-image-development
  (with-clean-env
    (fn []
      ;; The whole point of the change, and what makes deleting Mix safe: the rule
      ;; reads the DECLARED environment, never whether Mix is loaded or running.
      ;; Under `bl test` Mix is not started; under `mix test` it is — either way
      ;; the answers below are the same, which is the claim.
      (is (= "dev" (image/kind)) "a plain VM is development whether Mix is here or not")
      (System/put_env "BL_BIN" "/x")
      (is (= "drop" (image/kind)) "a packaged VM with Mix present still refuses")
      (is (not (image/mutable?))))))
