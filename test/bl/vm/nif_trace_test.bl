; nif_trace_test.bl — the native-call flight recorder (vm.nif-trace).
;
; Ported from test/beam_lisp/nif_trace_test.exs when nif_trace.ex was dissolved
; into bl (PLAN-132 ZERO-.ex sweep). vm.nif-trace arms the VM's own tracer
; (:erlang.trace / :erlang.trace_pattern) over a module — by default the memo
; funnel BeamLisp.LazyMemo, whose functions are the stubs load_nif replaces, so
; tracing them names the native call about to run. These tests are its oracle:
;   1. a recording captures the calls the traced module makes, one line each,
;      naming the function and its arity;
;   2. stop FLUSHES — every call made before stop is in the file, because the
;      close is a round-trip through the tracer's FIFO mailbox, not a kill;
;   3. the env entry (start-from-env) is inert when the variable is unset.

(ns vm.nif-trace-test
  (:require [vm.nif-trace :as nt]))

(defn- tmp-path []
  (str "/tmp/nif-trace-test-"
       (erlang/apply :erlang :unique_integer (list (list :positive)))
       ".log"))

(defn- read-file [path]
  (elem (erlang/apply :file :read_file (list (erlang/binary_to_list path))) 1))

(defn- contains-bytes? [haystack needle]
  (not (= :nomatch (erlang/apply :binary :match (list haystack needle)))))

(deftest records-the-calls-the-module-makes
  (testing "a recording names each traced call by function/arity"
    (let [path (tmp-path)
          rec (nt/start path)]
      ; create/1 and exchange/4 are memo-funnel entries; tracing them is tracing
      ; the native calls those stubs stand in for.
      (BeamLisp.LazyMemo/create 123)
      (BeamLisp.LazyMemo/exchange (BeamLisp.LazyMemo/create 5) 5 456)
      (nt/stop rec)
      (let [txt (read-file path)]
        (is (contains-bytes? txt "create/1")
            "the recording names create/1, the funnel a NIF replaced")
        (is (contains-bytes? txt "exchange/")
            "and exchange, the other funnel exercised")))))

(deftest stop-flushes-every-queued-call
  (testing "a call made just before stop is still in the file — stop is a flush, not a kill"
    (let [path (tmp-path)
          rec (nt/start path)]
      (BeamLisp.LazyMemo/create 1)
      (BeamLisp.LazyMemo/create 2)
      (BeamLisp.LazyMemo/create 3)
      (nt/stop rec)
      (let [txt (read-file path)
            ; three create/1 lines survive the close round-trip
            lines (erlang/apply :binary :matches (list txt "create/1"))]
        (is (erlang/>= (count lines) 3)
            "all three create/1 calls made before stop are recorded")))))

(deftest env-entry-is-inert-when-unset
  (testing "start-from-env does nothing when the variable names no path"
    ; the test VM does not set BEAM_LISP_NIF_TRACE
    (is (nil? (nt/path)))
    (is (= :off (nt/start-from-env)))))
