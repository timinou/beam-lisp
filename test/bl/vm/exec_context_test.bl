(ns vm.exec-context-test
 (:require [vm.exec :as exec] [diagnostics :as diag]))

(deftest each-sequenced-request-carries-its-own-context
 (let [p (exec/start)]
  (try
   (doseq [operation ["first-request" "second-request"]]
    (diag/with-context {:diagnostics/operation-id operation}
     (is (= operation (exec/run-reload (fn [] (:diagnostics/operation-id (diag/context))))))
     (is (= operation (:result (exec/run-capture (fn [] (:diagnostics/operation-id (diag/context)))))))))
   (finally (GenServer/stop p :normal 30000)))))

(deftest capture-closes-its-io-process-and-restores-the-sequencer
 (let [p (exec/start)]
  (try
   (let [leader (exec/run-reload (fn [] (erlang/group_leader)))
         capture (exec/run-capture (fn [] (println "capture fixture") (erlang/group_leader)))
         io (:result capture)]
    (is (= "capture fixture\n" (:output capture)))
    (is (= false (erlang/is_process_alive io)))
    (is (= leader (exec/run-reload (fn [] (erlang/group_leader)))))
    (is (map? (:result (exec/run-capture (fn [] (throw "capture failure"))))))
    (is (= leader (exec/run-reload (fn [] (erlang/group_leader))))))
   (finally (GenServer/stop p :normal 30000)))))
