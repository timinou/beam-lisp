(ns vm.realm-readiness-test
 (:require [vm.realm :as realm] [vm.manager :as mgr] [vm.index :as index] [vm.spec :as spec]))

(deftest an-existing-manager-entry-still-ensures-its-services
 (let [root (str (System/tmp_dir!) "/realm-readiness-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! root)
  (File/write! (str root "/env.bl") "{:name \"readiness-fixture\" :paths []}")
  (mgr/start)
  (try
   ;; Models the creator disappearing after manager publication, before services.
   (let [first-open (mgr/open (spec/read root))]
    (is (:created first-open))
    (is (= nil (index/owner-pid root)))
    (is (= (:id (:vm first-open)) (:id (realm/open root))))
    (is (erlang/is_pid (index/owner-pid root)))
    (is (= :cold (:phase (index/progress root))) "opening a realm never schedules a source index"))
   (finally (realm/close root) (File/rm_rf! root)))))

(deftest document-edits-keep-the-analysis-realm-and-executed-code-retires
 (let [root (str (System/tmp_dir!) "/realm-sources-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! root)
  (File/write! (str root "/env.bl") "{:name \"source-fixture\" :paths []}")
  (mgr/start)
  (try
   (let [first (realm/open root "first")
         edited (realm/open root "second")]
    (is (= (:env first) (:env edited)) "document-only state survives edits")
    (mgr/run (:id edited) (fn []
      (BeamLisp.Env/put_key (tuple "realm.executed-provider" "value") 1)))
    (let [fresh (realm/open root "third")]
     (is (not= (:env edited) (:env fresh)) "executed provider definitions get a new scope")
     (is (= (:key edited) (:key fresh)) "physical module-name space stays bounded")
     (is (= :error (mgr/run (:id fresh) (fn [] (BeamLisp.Env/lookup (tuple "realm.executed-provider" "value"))))))
     (is (= :cold (:phase (index/progress root))))))
   (finally (realm/close root) (File/rm_rf! root)))))
