; ports_test.bl — vm.ports, the named-port registry in pure beam-lisp (FUP-085).
;
; Truth is a file, not a table: each claim is one term under the runtime dir, so
; the collision this catches — BETWEEN daemons — is visible where a per-VM table
; would be blind. These prove the claim lifecycle AND that the on-disk shape is
; byte-compatible with the Elixir Daemon.Ports it replaces (a claim bl writes,
; Elixir reads, and vice versa) — the golden covenant the migration keeps.

(ns vm.ports-test
  (:require [vm.ports :as ports] [vm.paths :as paths]))

(def ROOT (BeamLisp/cwd))

(defn- cleanup [] (ports/release "tport" {:root ROOT}) (ports/release "tpin" {:root ROOT}))

(deftest claim-ephemeral-is-idempotent
  (testing "a session re-claiming its own ephemeral name keeps the same port"
    (cleanup)
    (let [r1 (ports/claim "tport" 0 {:root ROOT :hosts ["tport.test"]})
          r2 (ports/claim "tport" 0 {:root ROOT})]
      (is (contains? r1 :ok))
      (is (= r1 r2))
      (cleanup))))

(deftest a-claim-is-listed-and-routable
  (testing "list, port-of and holder-of-host all see a live claim"
    (cleanup)
    (let [r (ports/claim "tport" 0 {:root ROOT :hosts ["tport.beam-lisp.test"]})
          port (:ok r)]
      (is (some (fn [c] (= "tport" (:name c))) (ports/list-claims)))
      (is (= port (ports/port-of "tport" ROOT)))
      (is (= "tport" (:name (ports/holder-of-host "tport.beam-lisp.test"))))
      (cleanup))))

(deftest release-frees-the-name
  (testing "after release the name resolves to nothing"
    (cleanup)
    (ports/claim "tport" 0 {:root ROOT})
    (ports/release "tport" {:root ROOT})
    (is (nil? (ports/port-of "tport" ROOT)))))

(deftest hosts-are-lowercased-and-deduped
  (testing "a claim's hosts are normalized so a Host: header matches verbatim"
    (cleanup)
    (ports/claim "tport" 0 {:root ROOT :hosts ["TPort.Test" "tport.test"]})
    (let [c (ports/holder-of-host "tport.test")]
      (is (= (to-list ["tport.test"]) (:hosts c))))
    (cleanup)))

(deftest the-on-disk-claim-is-a-stable-etf-term
  (testing "a claim is one ETF term with the exact keys the routing edge reads"
    ;; the shape is the durable contract every reader (vm.gateway, vm.inspect,
    ;; the ports verb) depends on — keys :name :port :pinned :hosts :tree_id
    ;; :root :pid :claimed_at, matching what the Elixir Daemon.Ports wrote before
    ;; it was deleted (byte-compatible, so an in-flight claim survived the cutover).
    (cleanup)
    (ports/claim "tport" 0 {:root ROOT :hosts ["tport.golden.test"]})
    (let [c (ports/holder-of-host "tport.golden.test")]
      (is (not (nil? c)))
      (is (= "tport" (get c :name)))
      (is (= (ports/port-of "tport" ROOT) (get c :port)))
      (is (= false (get c :pinned)))
      (is (= (paths/tree-id ROOT) (get c :tree_id)))
      (is (erlang/is_integer (get c :pid)))
      (is (erlang/is_integer (get c :claimed_at))))
    (cleanup)))

(deftest shared-os-pid-does-not-authorize-another-roots-pinned-claim
  (let [a (str (System/tmp_dir!) "/port-root-a-" (System/unique_integer (list :positive)))
        b (str a "-b")
        name (str "shared-pin-" (System/unique_integer (list :positive)))
        socket (elem (gen_tcp/listen 0 (list :binary (tuple :active false))) 1)
        port (elem (elem (inet/sockname socket) 1) 1)]
    (gen_tcp/close socket)
    (try
      (let [first (ports/claim name port {:root a})
            again (ports/claim name port {:root a})
            other (ports/claim name port {:root b})]
        (is (= {:ok port} first))
        (is (= first again) "same root and pid remain idempotent")
        (is (contains? other :error) "same pid is not ownership of another root")
        (is (= :taken (elem (:error other) 0)))
        (ports/release name {:root b})
        (is (= a (:root (ports/holder port))) "other root cannot release A's claim"))
      (finally (ports/release name {:root a}) (ports/release name {:root b})))))

(run-tests)
