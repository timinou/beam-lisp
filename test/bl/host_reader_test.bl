; host_reader_test.bl — the pinned `BeamLisp.Reader` ABI, diffed against the
; live one.
;
; `priv/host/reader.bl` ports `lib/beam_lisp/reader.ex` to ONE exact-named beam.
; The live Elixir module is still the ground truth here, so this suite is
; DIFFERENTIAL: the same corpus is run through the pinned probe and through
; `Elixir.BeamLisp.Reader`, and the two answer sets must be equal — values,
; exception classes AND messages.
;
; Nothing here replaces the live module. The source is compiled at its own probe
; atom with `:load? false`, the namespace shim beside it is dropped, and the
; pinned beam is loaded ALONE.
;
; The one thing that cannot be compared identity-for-identity is the module name
; inside a `FunctionClauseError` message: the probe names ITS own atom (by
; design — the same source raises `BeamLisp.Reader` at production).
; `norm/1` maps the probe's name back onto the live one before comparison.
;
; WHAT THE CORPUS IS FOR:
;   * every read path delegates to the self-hosted reader
;     (`BeamLisp.Ns.Reader`) — read_string/1,2, read_all/1, read_one/1;
;   * a malformed source maps to `BeamLisp.Reader.SyntaxError` carrying the
;     diagnostic's `:msg` VERBATIM, on both the bl and Elixir side;
;   * the atom-table high-water guard maps to `BeamLisp.Reader.AtomLimitError` —
;     a DISTINCT type from a syntax error — again on both sides;
;   * anything that is not a reader diagnostic or the atom guard passes through
;     untouched (the fallthrough `ErlangError` case);
;   * the legacy `:bl_diag` marker (the spelling before `diag.bl`) still renders
;     as `SyntaxError` — the live reader no longer emits it, so it is pinned by
;     calling the pinned `mapping_atom_limit/1` directly;
;   * `enable_bl_reader/0` interns the ns and answers `:bl`.
;
; THE NESTED EXCEPTION MODULES ARE NOT THIS FILE'S. `beam_lisp/reader.ex` also
; declares `BeamLisp.Reader.SyntaxError` and `BeamLisp.Reader.AtomLimitError`;
; a pinned source emits exactly ONE module, so those must be pinned from their
; own sources (see the header of `priv/host/reader.bl`). The suite deliberately
; uses the LIVE exception modules as the target of the mapping, which is what
; makes it runnable today and what the cutover must reproduce.
;
; Run: bin/bl test test/bl/host_reader_test.bl

(ns host.reader.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_reader_" (erlang/unique_integer (list :positive))))

(defn- reader-source [] (Path/join (BeamLisp/cwd) "priv/host/reader.bl"))

(def ^:private probe :Elixir.BeamLisp.ReaderHostProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.Reader)
(def ^:private live :Elixir.BeamLisp.Reader)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

; Compile the pinned source at the probe atom and publish ONLY the pinned beam:
; the compile's own load (and the namespace shim it built beside it) is dropped.
(defn- compile-probe [dir]
  (let [res (BeamLisp.AOT/compile_host_file (reader-source)
              (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false)))
        path (elem res 1)]
    (drop! probe)
    (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    probe))

; ── the observation: a call's whole answer, a raise included -------------

(defn- norm
  "Map the probe's own atom out of a message, so a `FunctionClauseError` name
   compares equal to the live module's. Live messages never contain the probe
   string, so they pass through unchanged."
  [m]
  (if (erlang/is_binary m)
    (String/replace m "BeamLisp.ReaderHostProbe" "BeamLisp.Reader")
    m))

(defn- ex-data-of
  "The `:data` an exception carries, or nil — safe for any raised value."
  [e]
  (if (and (erlang/is_map e) (erlang/is_map_key :data e)) (erlang/map_get :data e) nil))

(defn- answer
  "`[:value v]` or `[:raise class message data]`. The class and message are the
   ABI a caller's `catch`/`ex-message` reads."
  [mod fname args]
  (try (list :value (erlang/apply mod fname args))
       (catch e (list :raise (:__struct__ e) (norm (ex-message e)) (ex-data-of e)))))

(defn- answers [mod qs]
  (map (fn [q] (list (first q) (answer mod (first q) (second q)))) qs))

; ── the corpus ───────────────────────────────────────────────────────────

(def sources
  "Every reader input class the facade must pass through: empty/whitespace,
   literals of each kind, collections, quote/deref/metadata sugar, fn-literal
   sugar, multiple forms, comments, escapes, and the malformed cases that raise
   (unterminated collection/string, a stray closer, an unsupported reader
   conditional)."
  (list
    "" "   " "\n" "; only a comment\n"
    "42" "-7" "2.5" "1/2" "1N" "0x1f"
    "\"text\"" "\"a\\nb\"" "\"\\u27\""
    "nil" "true" "false"
    "foo" ":kw" "::kw" "a/b" "'foo" "@x"
    "^:private x" "^{:k 1} x" "#_ 1"
    "(+ 1 2)" "(a (b c))" "(one) (two)" "(one)\n(two (three))" "  ( x )  "
    "[1 2 3]" "{:a 1}" "#{1 2}" "#(inc %)" "#(vector %1 %2)"
    "#?(:cljs 1)" "#?(foo 1 :clj 2)"
    "(" ")" "[" "{" "#{" "(a" "[1" "\""
    "#" "##" "#(" "\\"))

(defn- queries
  "The whole differential corpus as `[fname args]` questions. The non-binary
   inputs pin the `is_binary` guard on the reader arities."
  []
  (concat
    (map (fn [s] (list :read_string (list s))) sources)
    (map (fn [s] (list :read_string (list s "f.bl"))) sources)
    (map (fn [s] (list :read_all (list s))) sources)
    (map (fn [s] (list :read_one (list s))) sources)
    (list (list :read_string (list 42))
          (list :read_string (list 42 "f.bl"))
          (list :read_string (list nil))
          (list :read_all (list :not-a-binary))
          (list :read_one (list 42)))))

; ── the pinned ABI, answer for answer ────────────────────────────────────

(deftest reader-pinned-matches-the-live-module
  (testing "the whole corpus: probe answers equal the live module's, question for question"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (= :non_existing (erlang/apply :code :which (list shim))))
      ; FUNCTIONS-ONLY: no synthesized struct surface.
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__info__ 1)))
      ; The production module's FUNCTIONAL ABI is present on the probe beam —
      ; the helper `mapping_atom_limit/1` rides along, the live `defp` exported.
      (is (erlang/function_exported live :read_string 2))
      (is (every? (fn [e] (or (erlang/== :__info__ (elem e 0))
                              (erlang/function_exported probe (elem e 0) (elem e 1))))
                  (erlang/apply live :module_info (list :exports)))
          "the pinned ABI covers every FUNCTIONAL live export")
      (is (erlang/function_exported probe :read_string 1))
      (is (erlang/function_exported probe :read_all 1))
      (is (erlang/function_exported probe :read_one 1))
      (is (erlang/function_exported probe :enable_bl_reader 0))
      ; PINNED ANSWERS first — the ABI itself, not merely probe == live.
      (is (= (list :value (list (tuple :symbol "foo")))
             (answer probe :read_all (list "foo"))))
      (is (= (list :value 42) (answer probe :read_one (list "42"))))
      (is (= 2 (count (erlang/apply probe :read_all (list "(one) (two)")))))
      (is (= :bl (erlang/apply probe :enable_bl_reader (list))))
      ; THE DIFF. One question list, two modules, equal answers.
      (let [qs (queries)]
        (is (= (answers live qs) (answers probe qs))))
      ; and per-question, so a failure names the entry point and its input
      ; instead of dumping the whole corpus.
      (doseq [q (queries)]
        (is (= (answer live (first q) (second q))
               (answer probe (first q) (second q)))
            (str (first q) " " (pr-str (second q)))))
      ; REPRODUCIBLE: a rebuild of the same source is the same bytes, so the
      ; beam can be committed into the seed and re-derived.
      (let [dir2 (tmp-dir)
            again (elem (BeamLisp.AOT/compile_host_file (reader-source)
                          (list (t2 :module probe) (t2 :output_dir dir2) (t2 :load? false)))
                        1)]
        (is (= (File/read! (elem (BeamLisp.AOT/compile_host_file (reader-source)
                                (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false)))
                              1))
               (File/read! again))))
      ; The SAME source compiles at its PRODUCTION atom — read, not loaded:
      ; `:load? false` writes the beam without replacing the live module.
      (let [res (BeamLisp.AOT/compile_host_file (reader-source)
                  (list (t2 :module live) (t2 :output_dir dir) (t2 :load? false)))]
        (is (= live (elem res 0)))
        (is (File/exists? (elem res 1)))
        (is (= 42 (erlang/apply live :read_one (list "42")))
            "the live module was never substituted mid-flight"))
      (File/rm_rf! dir))))

; ── the exception surface, pinned by class / message ─────────────────────

(defn- with-tight-guard
  "Pin the atom guard to refuse on the first sampled token, run `thunk`, and
   ALWAYS restore the env — a leaked 0.0 fraction would make every later read in
   the same VM refuse, so the cleanup is not optional."
  [thunk]
  (Application/put_env :beam_lisp :atom_high_water_fraction 0.0)
  (Application/put_env :beam_lisp :atom_check_interval 1)
  (try (thunk)
       (finally
         (Application/delete_env :beam_lisp :atom_high_water_fraction)
         (Application/delete_env :beam_lisp :atom_check_interval))))

(deftest reader-pinned-errors-are-the-live-errors
  (testing "a malformed source is a SyntaxError; the atom guard a distinct AtomLimitError"
    (let [dir (tmp-dir)]
      (compile-probe dir)

      ; SYNTAX: the diagnostic's `:msg` reaches the caller VERBATIM, on both
      ; sides and on every read entry point.
      (doseq [f (list :read_string :read_all :read_one)]
        (let [a (answer probe f (list "("))
              b (answer live f (list "("))]
          (is (= :raise (first a)) (str f " raises on an unterminated collection"))
          (is (= :Elixir.BeamLisp.Reader.SyntaxError (nth a 1)) (str f))
          (is (includes? (nth a 2) "unterminated collection") (str f))
          (is (= b a) (str f " agrees with the live module"))))
      ; the same class/message with a file attributed.
      (is (= (answer live :read_string (list "(a" "f.bl"))
             (answer probe :read_string (list "(a" "f.bl"))))
      ; a stray closer and an unterminated string are the same shape.
      (is (= (answer live :read_string (list ")"))
             (answer probe :read_string (list ")"))))
      (is (= (answer live :read_string (list "\""))
             (answer probe :read_string (list "\""))))

      ; ATOM GUARD: a distinct TYPE, so a test can assert which failure it
      ; provoked. `account!` samples every token at interval 1, so an
      ; already-interned name still trips — both sides, same token.
      (let [pa (with-tight-guard
                 (fn [] (answer probe :read_all (list "reader-guard-probe-sym"))))
            la (with-tight-guard
                 (fn [] (answer live :read_all (list "reader-guard-probe-sym"))))]
        (is (= :raise (first pa)))
        (is (= :Elixir.BeamLisp.Reader.AtomLimitError (nth pa 1)))
        (is (= :Elixir.BeamLisp.Reader.AtomLimitError (nth la 1)))
        (is (includes? (nth pa 2) "refusing to intern")
            "the guard's own message is carried, not a rewritten one")
        (is (includes? (nth pa 2) "reader-guard-probe-sym"))
        (is (includes? (nth la 2) "reader-guard-probe-sym")))

      ; PASS-THROUGH: the fallthrough re-raises what it did not map. The atom
      ; guard is the ONLY class the facade claims beyond a diagnostic, so a
      ; plain error keeps its own type.
      (is (= :Elixir.ArithmeticError
             (:__struct__ (try (erlang/apply probe :mapping_atom_limit
                                              (list (fn [] (erlang/error :badarith))))
                               nil
                               (catch e e)))))
      (is (= :Elixir.ArgumentError
             (:__struct__ (try (erlang/apply probe :mapping_atom_limit
                                              (list (fn [] (erlang/error (Elixir.ArgumentError/exception "nope")))))
                               nil
                               (catch e e)))))
      ; a `:diag` map whose `:msg` is NOT a binary is not a reader diagnostic
      ; (the guard is `is_binary(msg)`), so it stays an ErlangError.
      (is (= :Elixir.ErlangError
             (:__struct__ (try (erlang/apply probe :mapping_atom_limit
                                              (list (fn [] (erlang/error (maps/put :diag true (maps/new))))))
                               nil
                               (catch e e)))))
      ; the thunk's VALUE is returned untouched on the happy path.
      (is (= :fine (erlang/apply probe :mapping_atom_limit (list (fn [] :fine)))))

      ; THE LEGACY MARKER: `:bl_diag` is the spelling the marker carried before
      ; the vocabulary landed as `diag.bl` (`:diag`). The live reader no longer
      ; emits it, so the clause is pinned by calling the pinned
      ; `mapping_atom_limit/1` directly — it must render as SyntaxError, exactly
      ; as `:diag` does.
      (let [a (try (erlang/apply probe :mapping_atom_limit
                                 (list (fn [] (erlang/error
                                                (maps/put :bl_diag true
                                                          (maps/put :msg "legacy" (maps/new)))))))
                   nil
                   (catch e e))]
        (is (= :Elixir.BeamLisp.Reader.SyntaxError (:__struct__ a)))
        (is (= "legacy" (ex-message a))))

      (File/rm_rf! dir))))

; ── the pinned beam AT the production atom ───────────────────────────────
;
; The differential above proves the ABI at a probe atom. This one proves the
; CUTOVER shape: the same source compiled to `Elixir.BeamLisp.Reader` and
; loaded OVER the live module answers the language, and the live beam is
; restored afterwards.
(deftest reader-pinned-beam-stands-in-at-the-production-atom
  (testing "the production atom serves reads and renders diagnostics on the pinned beam"
    (let [dir (tmp-dir)
          out (str dir "/prod")
          beam (Path/join out "Elixir.BeamLisp.Reader.beam")
          orig-path (erlang/apply :code :which (list live))
          orig-bin (File/read! (erlang/list_to_binary orig-path))]
      (is (not= :non_existing orig-path) "precondition: the live beam is a readable file")
      (BeamLisp.AOT/compile_host_file (reader-source)
        (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)))
      (try
        (drop! live)
        (code/load_binary live (erlang/binary_to_list beam) (File/read! beam))
        (is (not (erlang/function_exported live :__info__ 1))
            "the pinned beam is functions-only; the language never calls __info__/1")
        (is (= (list (tuple :symbol "foo"))
               (erlang/apply live :read_all (list "foo"))))
        (is (= 42 (erlang/apply live :read_one (list "42"))))
        (is (= 2 (count (erlang/apply live :read_string (list "(one) (two)" "f.bl")))))
        ; a diagnostic renders as SyntaxError, carrying the message verbatim.
        (let [a (try (erlang/apply live :read_string (list "(" "f.bl")) nil (catch e e))]
          (is (= :Elixir.BeamLisp.Reader.SyntaxError (:__struct__ a)))
          (is (includes? (ex-message a) "unterminated collection")))
        ; the atom guard maps to its own type at this atom too.
        (let [a (with-tight-guard
                  (fn [] (try (erlang/apply live :read_all (list "reader-prod-sym")) nil (catch e e))))]
          (is (= :Elixir.BeamLisp.Reader.AtomLimitError (:__struct__ a))))
        (is (= :bl (erlang/apply live :enable_bl_reader (list))))
        (finally
          (drop! live)
          (code/load_binary live orig-path orig-bin)))
      ; RESTORED: the live beam owns the atom and answers again.
      (is (= orig-path (erlang/apply :code :which (list live))))
      (is (= 42 (erlang/apply live :read_one (list "42"))))
      (File/rm_rf! dir))))

; ── the COLD CHILD: a fresh VM resolving the pinned beam ─────────────────
;
; The parent's probes run in a VM that has already booted the language. The
; pinned port has to hold on the path where it matters at cutover: a FRESH VM
; whose `BeamLisp.init/0` calls `BeamLisp.Reader.enable_bl_reader/0` before
; `multi`/`sugar` are interned. The child resolves `BeamLisp.Reader` to the
; pinned beam and lets the application boot through it.

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands
   FIRST: `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(defn- cold-script
  "The child VM's program, as Elixir source. The app start is the REAL
   `enable_bl_reader/0` path: `BeamLisp.init/0` interns the toolchain through
   the pinned module before anything reads."
  []
  (str
    "IO.puts(\"which=\" <> List.to_string(:code.which(BeamLisp.Reader)))\n"
    "{:ok, _} = Application.ensure_all_started(:beam_lisp)\n"
    "IO.puts(\"which-after=\" <> List.to_string(:code.which(BeamLisp.Reader)))\n"
    "IO.puts(\"enable=\" <> inspect(BeamLisp.Reader.enable_bl_reader()))\n"
    "form = hd(BeamLisp.Reader.read_all(\"foo\"))\n"
    "IO.puts(\"read-tag=\" <> inspect(elem(form, 0)))\n"
    "IO.puts(\"read-name=\" <> inspect(elem(form, 1)))\n"
    "IO.puts(\"one=\" <> inspect(BeamLisp.Reader.read_one(\"42\")))\n"
    "IO.puts(\"str=\" <> inspect(length(BeamLisp.Reader.read_string(\"(one) (two)\", \"cold.bl\"))))\n"
    "syntax =\n"
    "  try do\n"
    "    BeamLisp.Reader.read_string(\"(\", \"cold.bl\")\n"
    "    \"none\"\n"
    "  rescue\n"
    "    e in BeamLisp.Reader.SyntaxError -> e.message\n"
    "  end\n"
    "IO.puts(\"syntax=\" <> syntax)\n"
    "IO.puts(\"ok\")\n"))

(deftest reader-pinned-beam-boots-a-cold-child-vm
  (testing "a fresh VM resolves the pinned reader and reads through it"
    (let [dir (tmp-dir)
          out (str dir "/boot")
          script (Path/join dir "cold.exs")
          beam (Path/join out "Elixir.BeamLisp.Reader.beam")]
      ; The pinned beam AT the production atom, written here, never loaded here.
      (BeamLisp.AOT/compile_host_file (reader-source)
        (list (t2 :module live) (t2 :output_dir out) (t2 :load? false)))
      (is (File/exists? beam))
      (File/write! script (cold-script))

      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)]))
            text (elem r 0)]
        (is (zero? (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))

        ; THE REPLACEMENT: the code server resolves `BeamLisp.Reader` to the
        ; pinned beam, both before the app start (the launcher's tier verdict
        ; path) and after it.
        (is (includes? text (str "which=" beam)) text)
        (is (includes? text (str "which-after=" beam)) text)

        ; THE BOOT: `BeamLisp.init/0` interned the toolchain through the pinned
        ; `enable_bl_reader/0` — a failure here is a failed application start,
        ; which the child would have raised.
        (is (includes? text "enable=:bl") text)

        ; THE READS: through the pinned facade, in a VM that never had the
        ; Elixir module loaded.
        (is (includes? text "read-tag=:symbol") text)
        (is (includes? text "read-name=\"foo\"") text)
        (is (includes? text "one=42") text)
        (is (includes? text "str=2") text)
        ; and the diagnostic renders as SyntaxError with the reader's message.
        (is (includes? text "syntax=cold.bl:1:1: unterminated collection") text)
        (is (includes? text "ok") text))

      (File/rm_rf! dir))))
