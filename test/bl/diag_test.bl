; test/bl/diag_test.bl
;
;   ./bl -p priv/boot -p priv/std test test/bl/diag_test.bl
;
; GOAL #1, both halves.
;
; The VOCABULARY half: a failure is DATA — a shape with five invariants, enforced
; at the producer (diag.bl), drawn by ONE renderer (errors.bl). These tests pin
; the invariants that have bitten: the message is printed ONCE, a typo'd key is
; refused instead of vanishing, the shape never degrades into "a map that looks
; like a diagnostic".
;
; The FIX OPTIONS half: an unbalanced source gets repairs that were CHECKED by
; re-reading the text they produce. The fixtures use the fields the tree's reader
; ACTUALLY emits (measured from a run — see the offsets), so this suite pins the
; reader's field contract even in an image where the reader cannot be loaded; and
; every "clears the file" assertion is a real forward check against a real reader
; through the host front door.

(ns diag_test
  (:require [diag] [repair] [errors]))

(def nl (unicode/characters_to_binary (list 10)))
(def q (unicode/characters_to_binary (list 34)))

(defn- read-failure
  "The failure a read produced, or nil when the text reads — exactly the shape
   `repair/options` takes as :read. A reader that reports only a message still
   answers \"does this read?\", which is all the forward check needs."
  [src file]
  (try
    (do (BeamLisp.Reader/read_string src file) nil)
    (catch e
      (let [d (:original e)]
        {:error (if (diag/diag? d)
                  d
                  {:diag true :severity :error :kind :not-a-reader-diagnostic
                   :msg (str d)})}))))

(def read-opts {:file "fix.bl" :read read-failure})

(defn- occurrences [s sub]
  (count (String/split s sub)))

; ── the vocabulary ───────────────────────────────────────────────────────────

(deftest a-well-formed-diagnostic-conforms
  (let [d (diag/warning :type-mismatch "argument 1 provably wrong"
                        {:line 12 :col 9 :file "p.bl" :offset 200
                         :end-line 12 :end-col 11 :end-offset 202}
                        {:form "(greet 42)"})]
    (is (nil? (diag/why-not d)))
    (is (diag/conforms? d))
    (is (diag/diag? d))
    (is (= :type-mismatch (:kind d)))
    (is (= :warning (:severity d)))))

(deftest a-typo-in-a-location-is-refused-not-dropped
  (let [why (try (do (diag/warning :arity "m" {:line 1 :col 2 :end-lin 9} nil) "no raise")
                 (catch e (str (:original e))))]
    (is (String/contains? why "unknown location keys"))
    (is (String/contains? why ":end-lin"))))

(deftest half-a-position-is-refused
  (is (String/contains? (try (do (diag/note :aside "m" {:line 4} nil) "no raise")
                             (catch e (str (:original e))))
                        ":line without :col"))
  (is (String/contains? (try (do (diag/note :aside "m" {:end-col 9} nil) "no raise")
                             (catch e (str (:original e))))
                        "span with no start"))
  (is (String/contains? (try (do (diag/note :aside "m" {:line 4 :col 2 :end-col 9} nil) "no raise")
                             (catch e (str (:original e))))
                        ":end-col without :end-line")))

(deftest a-map-that-merely-looks-like-a-diagnostic-is-not-one
  (is (not (diag/diag? {:msg "odd number of forms" :line 3 :col 1})))
  (is (not (diag/diag? nil)))
  (is (diag/diag? (diag/error :syntax "m" nil nil))))

(deftest the-renderer-prints-the-location-once
  (let [src (str "(greet 42)" nl)
        d (diag/error :type-mismatch "argument 1 provably wrong"
                      {:line 1 :col 8 :file "fix.bl"} nil)
        out (errors/render "fix.bl" src d)]
    (is (= 2 (occurrences out "fix.bl:1:8")))
    (is (String/contains? out "^"))
    (is (nil? (errors/delaborated? out)))))

(deftest a-span-underlines-the-whole-form
  (let [src (str "(greet 42)" nl)
        d (diag/error :type-mismatch "wrong"
                      {:line 1 :col 8 :file "fix.bl" :end-line 1 :end-col 10} nil)]
    (is (String/contains? (errors/render "fix.bl" src d) "^^"))))

; ── fix options for unbalanced parens ────────────────────────────────────────

(deftest the-candidates-come-from-fields-not-from-a-sentence
  (let [src (str "[1 2)" nl)
        d (diag/error :mismatched-closer "unexpected ) — expected ] to close the [ opened at fix.bl:1:1"
                      {:line 1 :col 5 :file "fix.bl" :offset 4}
                      {:expected "]" :closer ")"
                       :opened-at {:line 1 :col 1 :file "fix.bl" :offset 0}})
        cands (repair/candidates d src)
        marked (map (fn [c] (assoc c :viable (repair/reads? read-failure (repair/apply-fix src c) "fix.bl")))
                    cands)
        picked (repair/choose marked)]
    (is (= [:replace-close :insert-close-before :delete-close]
           (map (fn [c] (:kind c)) cands)))
    (is (= "]" (:insert (first cands))))
    (is (= 4 (:offset (first cands))))
    ; swapping the closer gives [1 2], which READS — so this candidate is real
    (is (repair/reads? read-failure (repair/apply-fix src (first cands)) "fix.bl"))
    ; inserting the missing ] before it gives [1 2]), which still has a stray )
    (is (not (repair/reads? read-failure (repair/apply-fix src (second cands)) "fix.bl")))
    ; one real repair, so the tie COLLAPSES and nothing is guessed
    (is (not (repair/ambiguous? marked)))
    (is (:solved picked))
    (is (= :replace-close (:kind (:chosen picked))))))

(deftest a-stray-closer-has-two-repairs-and-says-so
  ; measured: (inc 1))  ->  :kind :unexpected-closer, :closer ")", :col 8 :offset 7
  (let [src (str "(inc 1))" nl)
        d (diag/error :unexpected-closer "unexpected ) — nothing is open that it could close"
                      {:line 1 :col 8 :file "fix.bl" :offset 7}
                      {:closer ")"})
        cands (map (fn [c] (assoc c :viable (repair/reads? read-failure (repair/apply-fix src c) "fix.bl")))
                   (repair/candidates d src))
        picked (repair/choose cands)]
    ; deleting the stray ) gives (inc 1); inserting the missing ( gives ((inc 1))
    ; both read, both cost one edit: the tool must not pretend to know which
    (is (repair/ambiguous? cands))
    (is (= 2 (count (repair/viable cands))))
    (is (:solved picked))
    (is (= :cheapest-then-declared-preference (:policy picked)))
    (is (= :delete-close (:kind (:chosen picked))))
    (is (= 1 (count (:others picked))))
    (is (repair/reads? read-failure (repair/apply-fix src (:chosen picked)) "fix.bl"))))

(deftest an-unclosed-collection-closes-and-the-two-programs-differ
  ; measured: "(defn f [x]\n  (inc x)\n"  ->  :kind :unterminated-collection,
  ;          :expected ")", the OPENER at :line 1 :col 1 :offset 0
  (let [src (str "(defn f [x]" nl "  (inc x)" nl)
        d (diag/error :unterminated-collection "unterminated collection, expected )"
                      {:line 1 :col 1 :file "fix.bl" :offset 0}
                      {:expected ")"})
        cands (map (fn [c] (assoc c :viable (repair/reads? read-failure (repair/apply-fix src c) "fix.bl")))
                   (repair/candidates d src))
        kinds (set (map (fn [c] (:kind c)) (repair/viable cands)))
        picked (repair/choose cands)]
    ; closing at the end of the offending LINE gives (defn f [x]); closing at
    ; end of file swallows the second form — two different programs
    (is (contains? kinds :insert-closer-at-line-end))
    (is (contains? kinds :insert-closer-at-eof))
    (is (repair/ambiguous? cands))
    (is (:solved picked))
    (is (= :insert-closer-at-line-end (:kind (:chosen picked))))
    (is (repair/reads? read-failure (repair/apply-fix src (:chosen picked)) "fix.bl"))
    (is (not= (repair/apply-fix src (:chosen picked))
              (repair/apply-fix src (first (filter (fn [c] (= :insert-closer-at-eof (:kind c)))
                                                   (repair/viable cands))))))))

(deftest an-unterminated-string-is-closed
  ; measured: "\"abc" -> :kind :unterminated-string, :closer "\""
  (let [src (str q "abc" nl)
        d (diag/error :unterminated-string "unterminated string"
                      {:line 1 :col 1 :file "fix.bl" :offset 0}
                      {:closer q})
        cands (map (fn [c] (assoc c :viable (repair/reads? read-failure (repair/apply-fix src c) "fix.bl")))
                   (repair/candidates d src))
        picked (repair/choose cands)]
    (is (:solved picked))
    (is (= :insert-quote-at-line-end (:kind (:chosen picked))))
    (is (repair/reads? read-failure (repair/apply-fix src (:chosen picked)) "fix.bl"))))

(deftest a-diagnostic-with-no-move-says-so-instead-of-guessing
  (let [src (str "(inc 1" nl)
        d (diag/error :not-a-reader-diagnostic "no fields to work from" nil nil)
        r (repair/options src {:file "fix.bl" :read (fn [s f] {:error d})})]
    (is (= false (:ok r)))
    (is (empty? (:fixes r)))
    (is (String/contains? (repair/explain src {:file "fix.bl" :read (fn [s f] {:error d})})
                          "no repair obvious"))))

(deftest a-source-that-reads-has-nothing-to-repair
  (let [r (repair/options (str "(inc 1)" nl) read-opts)]
    (is (= true (:ok r)))
    (is (String/contains? (repair/explain (str "(inc 1)" nl) read-opts) "reads cleanly"))))

(deftest the-loop-applies-a-fix-and-re-reads
  ; The loop's contract: fix, RE-READ, stop when it reads. The reader here is a
  ; pure function of the text — it reports the stray ) exactly while the text has
  ; one — because a reader that answers differently on the second call would make
  ; the forward checks meaningless. (A source with two defects needs a reader
  ; that DESCRIBES the second one; the tree's reader does, and the walk is
  ; exercised where it can be.)
  (let [src (str "(inc 1))" nl)
        d (diag/error :unexpected-closer "nothing is open that it could close"
                      {:line 1 :col 8 :file "fix.bl" :offset 7}
                      {:closer ")"})
        model (fn [s f] (if (String/contains? s "))") {:error d} nil))]
    (is (= true (:ok (repair/fix-src src {:file "fix.bl" :read model}))))
    (is (= (list :delete-close) (:kinds (repair/fix-src src {:file "fix.bl" :read model}))))))
