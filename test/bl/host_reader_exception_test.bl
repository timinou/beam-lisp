; host_reader_exception_test.bl — the pinned exception ABI for the reader's two
; error types: `BeamLisp.Reader.SyntaxError` and `BeamLisp.Reader.AtomLimitError`.
;
; `priv/host/reader_exception.bl` is ONE pinned source that `compile_host_file/2`
; compiles at TWO exact atoms, one per exception, each with the same pair of
; options:
;
;     :struct_fields [{:__exception__ true} {:message nil}]
;     :behaviour     :"Elixir.Exception"
;
; The live `lib/beam_lisp/reader.ex` still declares both as `defexception
; [:message]` and is the ground truth, so the suite is DIFFERENTIAL: the same
; corpus runs through a probe compiled from the pinned source and through the
; live module, and the two answer sets must be equal — values, exception CLASSES
; and MESSAGES.
;
; Nothing here replaces the live module. Each probe is compiled at its own atom
; with `:load? false`, the namespace shim beside it is dropped, and the pinned
; beam is loaded ALONE — so a leftover shim reference would be `undef` here.
;
; What each block pins:
;   * the synthesized struct surface — `__struct__/0,1`, `__info__(:struct)`
;     (keys, order, defaults), the module-exact self tag, and the `:behaviour`
;     attribute (`:Elixir.Exception`, recorded as the BARE atom — the pinned
;     family's shape, not Elixir's one-element list);
;   * `exception/1` and `message/1` against the legacy generated code, clause
;     for clause: keyword lists (message default nil, unknown key → KeyError),
;     bare binaries, bad args → FunctionClauseError, `message/1` value / nil /
;     BadMapError / KeyError, `Exception.exception?/1`, `Exception.message/1`,
;     rescue, and `inspect` (the `__exception__` field is filtered by
;     `Inspect.Any`, so the rendering is `%Mod{message: …}`);
;   * the ONE-SOURCE-TWO-ATOMS wiring: the same source bytes, compiled at two
;     arbitrary atoms, build two structs each tagged with its own atom — the
;     source names neither, only the self fun literal;
;   * the explicit seed option contract (`host-opts`'s exact list);
;   * the cutover — both sources loaded OVER the live atoms, exercised, and the
;     live beams restored afterwards;
;   * the cold child — a fresh VM with NO application boot resolves the pinned
;     beams and answers, proving the exception modules need no host-namespace
;     Env.
;
; Run: bin/bl test test/bl/host_reader_exception_test.bl

(ns host.reader-exception.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_reader_exc_" (erlang/unique_integer (list :positive))))

(defn- src [] (Path/join (BeamLisp/cwd) "priv/host/reader_exception.bl"))

(def ^:private syntax-probe :Elixir.BeamLisp.Reader.SyntaxErrorProbe)
(def ^:private atom-probe :Elixir.BeamLisp.Reader.AtomLimitErrorProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.ReaderException)
(def ^:private live-syntax :Elixir.BeamLisp.Reader.SyntaxError)
(def ^:private live-atom :Elixir.BeamLisp.Reader.AtomLimitError)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

(defn- struct-fields
  "The `:struct_fields` list, in order: the `defexception [:message]` shape."
  []
  (list (t2 :__exception__ true) (t2 :message nil)))

(defn- seed-opts
  "The EXACT option list the seed's `host-opts` builds for one exception entry:
   the isolated base (`:module`/`:output_dir`/`:file`/`:source_hash`/`:load?
   false`) followed by `:struct_fields` then `:behaviour`, in that order."
  [mod dir]
  (list (t2 :module mod)
        (t2 :output_dir dir)
        (t2 :file (src))
        (t2 :source_hash (crypto/hash :sha256 (File/read! (src))))
        (t2 :load? false)
        (t2 :struct_fields (struct-fields))
        (t2 :behaviour :"Elixir.Exception")))

(defn- compile-at
  "Compile the pinned source at exact atom `mod`, then publish ONLY the pinned
   beam: the compile's own load (and the namespace shim it built beside it) is
   dropped first."
  [mod dir]
  (let [res (BeamLisp.AOT/compile_host_file (src) (seed-opts mod dir))
        path (elem res 1)]
    (drop! mod)
    (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    mod))

(defn- compile-pinned-file
  "Compile the source at `mod` and return the beam PATH, never loading it."
  [mod dir]
  (elem (BeamLisp.AOT/compile_host_file (src) (seed-opts mod dir)) 1))

; ── normalization: the probe names ITS own atom, by design ────────────────

(defn- norm-syntax [m]
  (if (erlang/is_binary m)
    (String/replace m "BeamLisp.Reader.SyntaxErrorProbe" "BeamLisp.Reader.SyntaxError")
    m))

(defn- norm-atom [m]
  (if (erlang/is_binary m)
    (String/replace m "BeamLisp.Reader.AtomLimitErrorProbe" "BeamLisp.Reader.AtomLimitError")
    m))

; ── the observation: a call's whole answer, a raise included ──────────────

(defn- ex-data-of [e]
  (if (and (erlang/is_map e) (erlang/is_map_key :data e)) (erlang/map_get :data e) nil))

(defn- value-shape
  "A struct value drops its own tag (`Map.from_struct`), so a probe-built struct
   and a live-built one compare equal despite different `__struct__` atoms."
  [v]
  (if (and (erlang/is_map v) (erlang/is_map_key :__struct__ v))
    (list :struct (Map/from_struct v))
    (list :value v)))

(defn- obs
  "`[:ok shape]` or `[:raise class message data]`, message normalized by the
   caller so the probe's own atom compares equal to the live module's."
  [normf thunk]
  (try (let [v (thunk)]
         (list :ok (value-shape (if (erlang/is_binary v) (normf v) v))))
       (catch e (list :raise (:__struct__ e) (normf (ex-message e)) (ex-data-of e)))))

; ── the differential corpus ──────────────────────────────────────────────

(defn- corpus
  "Every observation the exception ABI owes, as a LIST so probe and live compare
   index for index. `mod` supplies the exception entry points; `normf` maps the
   probe's own name out of a message."
  [mod normf]
  (let [E (fn [arg] (fn [] (erlang/apply mod :exception (list arg))))
        M (fn [arg] (fn [] (erlang/apply mod :message (list arg))))
        e0 (fn [] (erlang/apply mod :exception (list (list))))]
    (list
      ; ── exception/1: keyword lists, message default nil ──────────────
      (obs normf (E (list)))
      (obs normf (E (list (t2 :message nil))))
      (obs normf (E (list (t2 :message "hi"))))
      (obs normf (E (list (t2 :message "a") (t2 :message "b"))))
      ; ── exception/1: a bare binary message ──────────────────────────
      (obs normf (E "bin"))
      (obs normf (E ""))
      ; ── exception/1: an undeclared key is the live struct!'s KeyError ─
      (obs normf (E (list (t2 :other 1))))
      (obs normf (E (list (t2 :message "a") (t2 :other 1))))
      ; ── exception/1: a changed tag is the live validate_struct!'s ArgumentError
      (obs normf (E (list (t2 :__struct__ :other))))
      (obs normf (E (list (t2 :__struct__ "not-an-atom"))))
      (obs normf (E (list (t2 :__struct__ mod))))
      (obs normf (E (list (t2 :__struct__ mod) (t2 :message "m"))))
      ; ── exception/1: bad args are FunctionClauseError ────────────────
      (obs normf (E :nope))
      (obs normf (E nil))
      (obs normf (E 42))
      (obs normf (E (maps/new)))
      ; ── message/1: value, nil, and the live field-access refusals ────
      (obs normf (M (maps/put :message "m" (maps/new))))
      (obs normf (M (maps/put :message nil (maps/new))))
      (obs normf (M (maps/put :message "" (maps/new))))
      (obs normf (M (maps/new)))
      (obs normf (M 1))
      (obs normf (M nil))
      (obs normf (M "str"))
      ; A bare atom takes the compiler's dynamic-field fallback, which emits a
      ; deprecation warning (as the live beam's does) — the path is
      ; `:elixir_erl_pass.no_parens_remote/2` on both sides, so it is exercised
      ; implicitly rather than pinned here.
      (obs normf (M (e0)))
      (obs normf (M (erlang/apply mod :exception (list "m"))))
      ; ── the Exception protocol surface ───────────────────────────────
      (obs normf (fn [] (Elixir.Exception/exception? (erlang/apply mod :exception (list "x")))))
      (obs normf (fn [] (Elixir.Exception/exception? (e0))))
      (obs normf (fn [] (Elixir.Exception/exception? :not-an-exception)))
      (obs normf (fn [] (Elixir.Exception/message (erlang/apply mod :exception (list "x")))))
      (obs normf (fn [] (Elixir.Exception/message (e0))))
      (obs normf (fn [] (Elixir.Exception/message (M (maps/put :message nil (maps/new))))))
      ; ── inspect: `__exception__` filtered, `message` shown ───────────
      (obs normf (fn [] (Kernel/inspect (erlang/apply mod :exception (list "hi")))))
      (obs normf (fn [] (Kernel/inspect (e0))))
      (obs normf (fn [] (Kernel/inspect (erlang/apply mod :exception (list)))))
      ; ── rescue: raise the struct, catch it by its own type ───────────
      (obs normf (fn [] (try (do (erlang/error (erlang/apply mod :exception (list "boom")))
                                 :no-raise)
                            (catch e (list :rescued (= mod (:__struct__ e)) (normf (ex-message e)))))))
      ; ── the struct's own map, tag aside ──────────────────────────────
      (obs normf (fn [] (Map/from_struct (erlang/apply mod :exception (list "hi")))))
      (obs normf (fn [] (Map/from_struct (e0)))))))

; ── the pinned ABI, observation for observation ──────────────────────────

(defn- differential [probe live normf]
  (is (= (corpus live normf) (corpus probe normf))
      "probe answers equal the live module's on the whole corpus")
  (let [ls (corpus live normf)
        ps (corpus probe normf)]
    (doseq [i (range (count ls))]
      (is (= (nth ls i) (nth ps i)) (str "observation " i)))))

(deftest exception-pinned-matches-the-live-modules
  (testing "both exception types answer exactly as the live modules do"
    (let [dir (tmp-dir)]
      (compile-at syntax-probe dir)
      (compile-at atom-probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beams answer.
      (is (= :non_existing (erlang/apply :code :which (list shim))))
      (differential syntax-probe live-syntax norm-syntax)
      (differential atom-probe live-atom norm-atom)
      (File/rm_rf! dir))))

; ── the struct surface: keys, order, tag, behaviour ──────────────────────

(defn- struct-info [mod]
  (erlang/apply mod :__info__ (list :struct)))

(defn- attributes [mod]
  (erlang/apply mod :module_info (list :attributes)))

(defn- has-behaviour? [mod modname]
  (some (fn [pair] (and (= :behaviour (elem pair 0)) (= modname (elem pair 1))))
        (attributes mod)))

(deftest exception-pinned-struct-surface
  (testing ":struct_fields + :behaviour synthesize the defexception surface"
    (let [dir (tmp-dir)]
      (compile-at syntax-probe dir)
      (compile-at atom-probe dir)
      (doseq [mod (list syntax-probe atom-probe)]
        (is (erlang/function_exported mod :__struct__ 0))
        (is (erlang/function_exported mod :__struct__ 1))
        (is (erlang/function_exported mod :__info__ 1))
        (is (erlang/function_exported mod :exception 1))
        (is (erlang/function_exported mod :message 1))
        ; __struct__/0 — the tag is MODULE-EXACT, defaults are the legacy pair.
        (let [s0 (erlang/apply mod :__struct__ (list))]
          (is (erlang/is_map s0))
          (is (= 3 (erlang/map_size s0)))
          (is (= mod (erlang/map_get :__struct__ s0)))
          (is (= true (erlang/map_get :__exception__ s0)))
          (is (nil? (erlang/map_get :message s0))))
        ; __struct__/1 folds the given values over the defaults.
        (let [s1 (erlang/apply mod :__struct__ (list (list (t2 :message "hi"))))]
          (is (= mod (erlang/map_get :__struct__ s1)))
          (is (= true (erlang/map_get :__exception__ s1)))
          (is (= "hi" (erlang/map_get :message s1))))
        ; __info__(:struct) is the live module's, datum for datum: keys, order
        ; and defaults — what `Inspect.Any` reads to rebuild `%Mod{…}`.
        (is (= (struct-info live-syntax) (struct-info mod)))
        (is (= (list (maps/put :field :__exception__ (maps/put :required false (maps/put :default true (maps/new))))
                     (maps/put :field :message (maps/put :required false (maps/put :default nil (maps/new)))))
               (struct-info mod)))
        ; Both production and probe expose the same functional surface, including
        ; helpers (the pinned emitter exports `defn-` as well as public defs).
        (is (= (sort (erlang/apply live-syntax :__info__ (list :functions)))
               (sort (erlang/apply mod :__info__ (list :functions)))))
        (is (every? (fn [e] (erlang/function_exported mod (elem e 0) (elem e 1)))
                    (list (tuple :kv 2) (tuple :self_module 0)
                          (tuple :struct_default 0) (tuple :build_struct! 2))))
        ; -behaviour Exception, as the pinned emitter records it (BARE atom; the
        ; live Elixir beam records the one-element list — a family-wide shape).
        (is (has-behaviour? mod :"Elixir.Exception"))
        ; the pinned __info__/1 does NOT serve :attributes — the family shape.
        (is (= :Elixir.FunctionClauseError
               (:__struct__ (try (erlang/apply mod :__info__ (list :attributes)) nil (catch e e))))))
      ; the exception/1 return is a GENUINE struct of its own type.
      (let [s (erlang/apply syntax-probe :exception (list "hi"))]
        (is (Elixir.Exception/exception? s))
        (is (= syntax-probe (:__struct__ s))))
      (let [a (erlang/apply atom-probe :exception (list (list (t2 :message "hi"))))]
        (is (Elixir.Exception/exception? a))
        (is (= atom-probe (:__struct__ a))))
      (File/rm_rf! dir))))

; ── ONE source, TWO exact atoms, TWO seed mappings ───────────────────────

(deftest one-source-serves-both-exception-atoms
  (testing "the same source bytes build either exception; no production atom is named in code"
    (let [dir (tmp-dir)
          a-dir (str dir "/a")
          b-dir (str dir "/b")
          ; two ARBITRARY atoms, neither a production atom: the source cannot be
          ; reading its name from anywhere but its own fun literal.
          a :Elixir.BeamLisp.ReadExcProbeA
          b :Elixir.BeamLisp.ReadExcProbeB]
      (let [a-beam (compile-pinned-file a a-dir)
            b-beam (compile-pinned-file b b-dir)]
        (is (not= a-beam b-beam))
        (is (File/exists? a-beam))
        (is (File/exists? b-beam))
        (drop! a) (drop! b)
        (code/load_binary a (erlang/binary_to_list a-beam) (File/read! a-beam))
        (code/load_binary b (erlang/binary_to_list b-beam) (File/read! b-beam))
        (drop! shim)
        ; each beam carries its OWN tag, from the same source.
        (is (= a (:__struct__ (erlang/apply a :exception (list "x")))))
        (is (= b (:__struct__ (erlang/apply b :exception (list "x")))))
        (is (= a (erlang/map_get :__struct__ (erlang/apply a :__struct__ (list)))))
        (is (= b (erlang/map_get :__struct__ (erlang/apply b :__struct__ (list)))))
        ; and each renders ITS own name, with no shared state.
        (is (= "%BeamLisp.ReadExcProbeA{message: \"x\"}"
               (Kernel/inspect (erlang/apply a :exception (list "x")))))
        (is (= "%BeamLisp.ReadExcProbeB{message: \"x\"}"
               (Kernel/inspect (erlang/apply b :exception (list "x")))))
        (is (= "x" (erlang/apply a :message (list (erlang/apply b :exception (list "x")))))
            "message/1 reads the :message field of ANY struct, tag aside")
        (drop! a) (drop! b))
      ; ── the explicit seed option contract ────────────────────────────
      (let [opts (seed-opts syntax-probe dir)]
        (is (= syntax-probe (Keyword/fetch! opts :module)))
        (is (= (src) (Keyword/fetch! opts :file)))
        (is (= false (Keyword/fetch! opts :load?)))
        (is (erlang/is_binary (Keyword/fetch! opts :source_hash)))
        (is (= (struct-fields) (Keyword/fetch! opts :struct_fields)))
        (is (= :"Elixir.Exception" (Keyword/fetch! opts :behaviour)))
        ; the two mappings differ ONLY in `:module` and `:output_dir`.
        (is (= (struct-fields) (Keyword/fetch! (seed-opts atom-probe dir) :struct_fields)))
        (is (= :"Elixir.Exception" (Keyword/fetch! (seed-opts atom-probe dir) :behaviour)))
        (is (= (src) (Keyword/fetch! (seed-opts atom-probe dir) :file))))
      (File/rm_rf! dir))))

; ── the pinned beams AT the production atoms, saved and restored ─────────

(deftest exception-pinned-beams-stand-in-at-the-production-atoms
  (testing "the production atoms serve and render on the pinned beams, then the live beams return"
    (let [dir (tmp-dir)]
      (doseq [live (list live-syntax live-atom)]
        (let [out (str dir "/" (str live))
              beam (Path/join out (str live ".beam"))
              orig-path (erlang/apply :code :which (list live))
              orig-bin (File/read! (erlang/list_to_binary orig-path))
              before (corpus live (fn [m] m))]
          (is (not= :non_existing orig-path) "precondition: the live beam is a readable file")
          (compile-pinned-file live out)
          (is (File/exists? beam))
          (try
            (drop! live)
            (code/load_binary live (erlang/binary_to_list beam) (File/read! beam))
            (is (erlang/function_exported live :__info__ 1)
                "the struct surface rides along: __info__/1 is served")
            ; the pinned beam answers EXACTLY as the live one did at this atom,
            ; observation for observation.
            (is (= before (corpus live (fn [m] m))))
            (is (= live (:__struct__ (erlang/apply live :exception (list "x")))))
            (is (= "hi" (erlang/apply live :message (list (erlang/apply live :exception (list (list (t2 :message "hi"))))))))
            (is (= (str "%" (String/replace (str live) "Elixir." "") "{message: \"x\"}")
                   (Kernel/inspect (erlang/apply live :exception (list "x")))))
            (finally
              (drop! live)
              (code/load_binary live orig-path orig-bin)))
          ; RESTORED: the live beam owns the atom and answers again.
          (is (= orig-path (erlang/apply :code :which (list live))))
          (is (= before (corpus live (fn [m] m))) "the restored live beam answers as before")))
      (File/rm_rf! dir))))

; ── the COLD CHILD: a fresh VM, no application boot, no host-ns Env ──────

(defn- child-code-args
  "This VM's whole code path as `-pa` args, with `pinned` LAST so it lands FIRST:
   `-pa` PREPENDS, so the last one named wins."
  [pinned]
  (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
          (list "-pa" pinned)))

(defn- cold-script
  "The child VM's program. It NEVER starts the application: it resolves the two
   pinned exception beams off the path and exercises them, so a host-namespace
   Env dependency would be a load-time `undef` here."
  []
  (str
    "IO.puts(\"which-s=\" <> List.to_string(:code.which(BeamLisp.Reader.SyntaxError)))\n"
    "IO.puts(\"which-a=\" <> List.to_string(:code.which(BeamLisp.Reader.AtomLimitError)))\n"
    "s = BeamLisp.Reader.SyntaxError.exception(\"cold\")\n"
    "IO.puts(\"s-msg=\" <> inspect(BeamLisp.Reader.SyntaxError.message(s)))\n"
    "IO.puts(\"s-inspect=\" <> inspect(s))\n"
    "IO.puts(\"s-exc=\" <> inspect(Exception.exception?(s)))\n"
    "a = BeamLisp.Reader.AtomLimitError.exception([message: \"cold\"])\n"
    "IO.puts(\"a-msg=\" <> inspect(BeamLisp.Reader.AtomLimitError.message(a)))\n"
    "IO.puts(\"a-inspect=\" <> inspect(a))\n"
    "IO.puts(\"kw=\" <> inspect(BeamLisp.Reader.SyntaxError.exception([message: \"k\"])))\n"
    "rescued =\n"
    "  try do\n"
    "    raise BeamLisp.Reader.SyntaxError, \"boom\"\n"
    "  rescue\n"
    "    e in BeamLisp.Reader.SyntaxError -> Exception.message(e)\n"
    "  end\n"
    "IO.puts(\"rescued=\" <> inspect(rescued))\n"
    "IO.puts(\"ok\")\n"))

(deftest exception-pinned-beams-answer-in-a-cold-child-vm
  (testing "a fresh VM with no application boot resolves and exercises the pinned exceptions"
    (let [dir (tmp-dir)
          out (str dir "/cold")
          script (Path/join dir "cold.exs")
          s-beam (compile-pinned-file live-syntax out)
          a-beam (compile-pinned-file live-atom out)]
      (is (File/exists? s-beam))
      (is (File/exists? a-beam))
      (File/write! script (cold-script))
      (let [r (System/cmd "elixir"
                          (to-list (concat (child-code-args out) (list script)))
                          (to-list [(tuple :stderr_to_stdout true)
                                    (tuple :env (list (tuple "ERL_CRASH_DUMP" "/dev/null")))]))
            text (elem r 0)]
        (is (zero? (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))
        ; THE REPLACEMENT: the code server resolves both atoms to the pinned
        ; beams, in a VM that never booted the language.
        (is (includes? text (str "which-s=" s-beam)) text)
        (is (includes? text (str "which-a=" a-beam)) text)
        ; exception/1, message/1, inspect, Exception.exception?/1, raise+rescue.
        (is (includes? text "s-msg=\"cold\"") text)
        (is (includes? text "s-inspect=%BeamLisp.Reader.SyntaxError{message: \"cold\"}") text)
        (is (includes? text "s-exc=true") text)
        (is (includes? text "a-msg=\"cold\"") text)
        (is (includes? text "a-inspect=%BeamLisp.Reader.AtomLimitError{message: \"cold\"}") text)
        (is (includes? text "kw=%BeamLisp.Reader.SyntaxError{message: \"k\"}") text)
        (is (includes? text "rescued=\"boom\"") text)
        (is (includes? text "ok") text))
      (File/rm_rf! dir))))
