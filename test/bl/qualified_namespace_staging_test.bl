(ns qualified-namespace-staging-test)

(defn- fixture [action]
 (let [id (str "qualifiedlazy" (erlang/unique_integer (list :positive)))
       dir (str (System/get_env "HOME") "/tmp/" id) token (BeamLisp.Env/capture)]
  (File/mkdir_p! dir)
  (try (BeamLisp.Loader/with_ambient_dirs (list dir) (fn [] (action dir id)))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))
(defn- write-provider! [dir ns body]
 (let [file (str dir "/" ns ".bl")]
  (File/write! file (str "(ns " ns ") " body)) file))
(defn- effect-provider [flag]
 (str "(def initialized (File/write! \"" flag "\" \"+\" (list :append))) "
      "(defn value [] 42)"))
(defn- eval-preserving-context [source]
 (let [token (BeamLisp.Env/capture)]
  (try (BeamLisp/eval source) (finally (BeamLisp.Env/bind token)))))
(defn- original [action]
 (try (action) :unexpected-success (catch error (BeamLisp.ExInfo/ex_original error))))

(deftest fully-qualified-functions-defer-initialization-and-preserve-the-original-resolver
 (fixture
  (fn [dir id]
   (let [provider (str id "provider") caller (str id "caller") flag (str dir "/effect")
         other (str dir "/other")]
    (write-provider! dir provider (effect-provider flag))
    (eval-preserving-context (str "(ns " caller ") (defn run [] (" provider "/value))"))
    (is (= false (BeamLisp.Env/loaded_ns? provider)))
    (is (= false (File/exists? flag)))
    (is (some? (BeamLisp.Env/deferred_dirs provider)))
    (File/mkdir_p! other)
    (write-provider! other provider "(defn value [] :wrong-provider)")
    (BeamLisp.Loader/with_ambient_dirs (list other)
     (fn []
      (is (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! caller "run") (list))))
      (is (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! caller "run") (list))))))
    (is (= "+" (File/read! flag)))
    (is (= true (BeamLisp.Env/loaded_ns? provider)))))))

(deftest qualified-function-values-remain-lazy-until-the-value-is-read
 (fixture
  (fn [dir id]
   (let [provider (str id "provider") caller (str id "caller") flag (str dir "/effect")]
    (write-provider! dir provider (effect-provider flag))
    (eval-preserving-context (str "(ns " caller ") (defn value [] " provider "/value)"))
    (is (= false (BeamLisp.Env/loaded_ns? provider)))
    (is (= false (File/exists? flag)))
    (let [f (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! caller "value") (list))]
     (is (= 42 (BeamLisp.Ns.Rt/invoke f (list)))))
    (is (= "+" (File/read! flag)))))))

(deftest strict-staged-compilation-collects-implicit-qualified-dependencies-without-initializing-them
 (fixture
  (fn [dir id]
   (let [provider (str id "provider") caller (str id "caller") flag (str dir "/effect")
         source (str "(ns " caller ") (defn run [] (" provider "/value))")
         out (str dir "/ebin")]
    (write-provider! dir provider (effect-provider flag))
    (let [beams (BeamLisp.AOT/compile_source source
                 (list (tuple :output_dir out) (tuple :stage-sdk? true)))
          module (BeamLisp.Link/module_for caller)]
     (is (seq beams))
     (is (= false (BeamLisp.Env/loaded_ns? provider)))
     (is (= false (File/exists? flag)))
     (erlang/apply module :__bl_init__ (list))
     (is (= false (BeamLisp.Env/loaded_ns? provider)))
     (is (= 42 (erlang/apply module :run (list))))
     (is (= "+" (File/read! flag))))))))

(deftest fully-qualified-private-names-refuse-from-source-metadata-before-initialization
 (fixture
  (fn [dir id]
   (let [provider (str id "provider") caller (str id "caller") flag (str dir "/effect")]
    (write-provider! dir provider
     (str "(def initialized (File/write! \"" flag "\" \"ran\")) (defn- secret [] 42)"))
    (let [message (try
                   (BeamLisp.AOT/compile_source
                     (str "(ns " caller ") (defn run [] (" provider "/secret))")
                     (list (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true)))
                   nil (catch error (ex-message error)))]
     (is (some? message))
     (is (and message (String/contains? message (str provider "/secret is not public")))))
    (is (= false (File/exists? flag)))
    (is (= false (BeamLisp.Env/loaded_ns? provider)))))))

(deftest staging-does-not-grant-initialization-authority-to-a-needed-macro-provider
 (fixture
  (fn [dir id]
   (let [provider (str id "provider") caller (str id "caller") flag (str dir "/effect")]
    (write-provider! dir provider
     (str "(def initialized (File/write! \"" flag "\" \"ran\")) (defmacro value [] 42)"))
    (is (= (tuple :sdk_declaration_stage_load_refused provider)
          (original #(BeamLisp.AOT/compile_source
                      (str "(ns " caller ") (defn run [] (" provider "/value))")
                      (list (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true))))))
    (is (= false (File/exists? flag)))
    (is (= false (BeamLisp.Env/loaded_ns? provider)))))))

(deftest ordinary-needed-macros-and-explicit-prewarming-preserve-their-eager-semantics
 (fixture
  (fn [dir id]
   (let [macro-provider (str id "macro") macro-caller (str id "macrocaller")
         ordinary (str id "ordinary") caller (str id "caller")
         macro-flag (str dir "/macro-effect") flag (str dir "/effect")]
    (write-provider! dir macro-provider
     (str "(def initialized (File/write! \"" macro-flag "\" \"ran\")) (defmacro value [] 42)"))
    (eval-preserving-context (str "(ns " macro-caller ") (defn run [] (" macro-provider "/value))"))
    (is (= "ran" (File/read! macro-flag)))
    (is (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! macro-caller "run") (list))))
    (write-provider! dir ordinary (effect-provider flag))
    (eval-preserving-context (str "(ns " caller ") (defn run [] (" ordinary "/value))"))
    (is (= false (File/exists? flag)))
    (BeamLisp.Loader/ensure_loaded ordinary)
    (is (= "+" (File/read! flag)))
    (is (= 42 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! caller "run") (list))))
    (is (= "+" (File/read! flag)))))))
