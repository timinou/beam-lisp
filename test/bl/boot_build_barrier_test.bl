; boot_build_barrier_test.bl — the toolchain barrier, pinned at its live edge.
;
; Ported from the ExUnit `test/beam_lisp/boot_build_barrier_test.exs`, which
; reached the barrier through the Elixir build shell's var table and
; `BeamLisp.Tiers`. Here the barrier's own namespaces are called DIRECTLY:
; `priv/build/build.bl`'s `partition-plan` / `continue-after-toolchain?`,
; `priv/build/source-graph.bl`'s `header`, and `priv/build/seed.bl`'s floor
; closure — no build task in the path.
;
; The barrier: codegen (`priv/boot/`) and the build driver (`priv/build/`) build
; SERIALLY, before the parallel ordinary waves, because the compiler and the
; program scheduling it must both be sound before anything else is compiled. A
; toolchain source requiring an ordinary source is a structural error, rejected
; before any scheduling. The tier law adds the require-direction rule: a
; `std`/`lib`/`compat` source may require the source graph/planner/interface KERNEL,
; never the DRIVER.
;
; Run: bl test test/bl/boot_build_barrier_test.bl

(ns boot-build-barrier.test
  (:require [build :as b] [source-graph :as sg] [seed]))

(defn- has?
  "Membership without assuming a set: seq in, boolean out."
  [coll x]
  (some? (some (fn [y] (= y x)) coll)))

(defn- node [path ns] {:path path :ns ns :hash ns})

; ── the serial toolchain prefix ──────────────────────────────────────────────

(deftest toolchain-nodes-form-a-serial-topological-prefix-and-ordinary-waves-stay-parallel
  (let [boot-dir (BeamLisp.Tiers/boot_dir)
        core (node (Path/join boot-dir "core.bl") "core")
        compiler (node (Path/join boot-dir "compiler.bl") "compiler")
        driver (node (Path/join (BeamLisp.Tiers/build_dir) "build.bl") "build")
        a (node "priv/std/a.bl" "a")
        b* (node "priv/std/b.bl" "b")
        partition (b/partition-plan
                    {:order [core compiler driver a b*]
                     :waves [[core a] [compiler driver] [b*]]
                     :deps {(:path core) []
                            (:path compiler) [(:path core)]
                            (:path driver) []
                            (:path a) []
                            (:path b*) [(:path a)]}})]
    ; BOTH tiers are in the serial prefix: codegen AND the driver.
    (is (= [(:path core) (:path compiler) (:path driver)]
           (vec (map (fn [n] (:path n)) (:toolchain partition)))))

    (is (= [[(:path a)] [(:path b*)]]
           (vec (map (fn [w] (vec (map (fn [n] (:path n)) w)))
                     (:ordinary-waves partition)))))

    (is (= [] (vec (:errors partition))))))

(deftest a-toolchain-dependency-on-an-ordinary-source-is-rejected-before-scheduling
  (let [boot (node (Path/join (BeamLisp.Tiers/boot_dir) "compiler.bl") "compiler")
        driver (node (Path/join (BeamLisp.Tiers/build_dir) "build.bl") "build")
        ordinary (node "priv/std/helper.bl" "helper")
        partition (b/partition-plan
                    {:order [ordinary boot driver]
                     :waves [[ordinary] [boot] [driver]]
                     :deps {(:path boot) [(:path ordinary)]
                            (:path driver) []
                            (:path ordinary) []}})
        errors (vec (:errors partition))]
    (is (= 1 (count errors)))
    (is (includes? (first errors)
                   (str "toolchain source " (:path boot)
                        " requires ordinary source " (:path ordinary))))))

(deftest toolchain-errors-close-the-ordinary-source-execution-gate
  ; The barrier is TOOLCHAIN-source errors only (1baaab4): an ordinary source
  ; failing to compile is a report, not a reason to skip every later wave.
  (let [boot (Path/join (BeamLisp.Tiers/boot_dir) "compiler.bl")
        driver (Path/join (BeamLisp.Tiers/build_dir) "build.bl")]
    (is (b/continue-after-toolchain? {:errors [] :toolchain-paths [boot driver]}))

    (is (b/continue-after-toolchain?
          {:errors ["priv/std/helper.bl: failed"] :toolchain-paths [boot driver]}))

    (is (not (b/continue-after-toolchain?
               {:errors [(str boot ": failed")] :toolchain-paths [boot]})))

    (is (not (b/continue-after-toolchain?
               {:errors [(str driver ": failed")] :toolchain-paths [driver]})))))

; ── the tier law ─────────────────────────────────────────────────────────────

(deftest the-tier-law-std-lib-compat-may-require-the-graph-kernel-never-the-driver
  ; The law of tiers.ex, enforced over SOURCE with the kernel itself: every
  ; `.bl` under the program tiers is read by `source-graph/header` (the one
  ; parser), and no `:require` may name a driver namespace. `source-graph` is
  ; the kernel — std dev tooling (codebase, reload) requires it by design
  ; (PLAN-125).
  (let [drivers (remove (fn [ns] (has? (BeamLisp.Tiers/build_kernel_namespaces) ns))
                        (BeamLisp.Tiers/build_namespaces))
        offenders (for [tier ["std" "lib" "compat"]
                        path (Path/wildcard (Path/join (BeamLisp.Tiers/priv_root)
                                                       (str tier "/**/*.bl")))
                        [ns requires] [(sg/header (File/read! path))]
                        bad (vec (sort (filter (fn [r] (has? drivers r)) requires)))
                        :when (not (empty? bad))]
                    [path ns bad])]
    (is (= [] (vec offenders)))))

(deftest each-tiers-sources-are-recognised-relative-or-absolute
  (is (BeamLisp.Tiers/boot_source? "priv/boot/core.bl"))
  (is (BeamLisp.Tiers/boot_source? (Path/join (BeamLisp.Tiers/boot_dir) "core.bl")))
  (is (not (BeamLisp.Tiers/boot_source? "priv/build/build.bl")))

  (is (BeamLisp.Tiers/build_source? "priv/build/build.bl"))
  (is (not (BeamLisp.Tiers/build_source? "priv/boot/core.bl")))

  (is (not (BeamLisp.Tiers/boot_source? "priv/std/errors.bl")))
  (is (not (BeamLisp.Tiers/build_source? "priv/std/errors.bl")))

  ; `toolchain_source?` is the union — what the barrier schedules serially.
  (is (BeamLisp.Tiers/toolchain_source? "priv/boot/compiler.bl"))
  (is (BeamLisp.Tiers/toolchain_source? "priv/build/build-plan.bl"))
  (is (not (BeamLisp.Tiers/toolchain_source? "priv/std/errors.bl"))))

(deftest the-tiers-are-disjoint-and-the-gates-own-namespaces-are-tier-keyed
  (let [boot (BeamLisp.Tiers/boot_namespaces)
        build (BeamLisp.Tiers/build_namespaces)]
    (is (= ["app-resource" "build" "build-log" "build-plan" "claim" "deps"
            "deps-compile" "drop" "embed-asset" "hex" "mix-shim" "ns-interface"
            "pristine" "provenance" "release" "seed" "selfbuild" "source-graph"
            "store" "substrate" "z3-asset"]
           (vec (sort build))))

    (is (every? (fn [b] (not (has? boot b))) build))

    ; The drift gate runs on these; if one drifted into the wrong tier the gate
    ; would compare it against the wrong key. `reader-node` is codegen; the
    ; driver's own namespaces — the build, its planner, and the log they read
    ; their state from — are the build tier.
    (is (= :boot (BeamLisp.Tiers/tier_of_ns "reader-node")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "build-plan")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "source-graph")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "ns-interface")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "build-log")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "substrate")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "release")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "drop")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "pristine")))
    (is (= :build (BeamLisp.Tiers/tier_of_ns "selfbuild")))
    (is (= :library (BeamLisp.Tiers/tier_of_ns "datom")))))

; ── the staged-build refresh decision ────────────────────────────────────────

(deftest the-staged-refresh-decision-is-narrow
  ; The ExUnit suite read the Elixir build shell's `refresh_staged_build?/1` —
  ; the shell predicate that answered `"build" in staged`: a bootstrap floor
  ; that claims the DRIVER is re-read from SOURCE, one that claims a codegen
  ; name is not. That shell is a test-only façade over `priv/build/*.bl`, so the
  ; rule it enforced is pinned here against the live .bl content of the floor:
  ;
  ;   `seed/namespaces` floors CODEGEN only — a driver floored from a previous
  ;   generation is a MIXED TOOLCHAIN, its bytes outliving the source they were
  ;   written from — so no driver name can be staged; and
  ;   `BeamLisp.Tiers/tier_of_ns` is the same table the driver's own
  ;   `partition-plan` reads (through `toolchain_source?`).
  ;
  ; The decision is NARROW: the driver's own name, never "any build-tier name"
  ; ("build-plan" must NOT trigger it) and never a codegen name.
  (let [floor (map Macro/underscore (seed/namespaces (BeamLisp.Tiers/boot_dir)))
        drivers (BeamLisp.Tiers/build_namespaces)
        staged (fn [staged-names] (vec (filter (fn [ns] (= "build" ns)) staged-names)))]
    (is (= [] (vec (filter (fn [n] (has? drivers n)) floor)))
        "the floor is codegen-only: no driver namespace is ever staged")
    (is (has? drivers "build") "the driver's own name is a build-tier namespace")
    (is (= :build (BeamLisp.Tiers/tier_of_ns "build")))

    (is (= [] (staged [])) "nothing staged, nothing refreshed")
    (is (= [] (staged ["compiler" "reader"]))
        "a codegen staged list names no driver — no refresh")
    (is (= ["build"] (staged ["compiler" "build"]))
        "the driver's own name is the whole trigger")
    (is (= [] (staged ["compiler" "build-plan"]))
        "a DIFFERENT build-tier name does not trigger it — the decision is narrow")))

(deftest every-driver-source-and-namespace-use-the-same-freshness-key
 ;; A nested build source previously escaped the basename-only namespace
 ;; inventory and was stamped under a key its runtime loader could never accept.
 (doseq [path (Path/wildcard (Path/join (BeamLisp.Tiers/build_dir) "**/*.bl"))]
  (let [[namespace _] (sg/header (File/read! path))]
   (is (= (BeamLisp.AOTCache/key_for_source path)
          (BeamLisp.AOTCache/key_for_ns namespace)) path))))

(deftest shared-kernel-dependencies-cannot-pull-in-the-build-driver
 (let [kernel (set (BeamLisp.Tiers/build_kernel_namespaces))]
  (doseq [namespace kernel]
   (let [[declared requires] (sg/header (BeamLisp.Loader/source_content namespace))]
    (is (= namespace declared))
    (is (every? (fn [n] (or (= :boot (BeamLisp.Tiers/tier_of_ns n))
                            (contains? kernel n))) requires)
        (str namespace " must stay closed over the shared kernel and boot APIs"))))))

(deftest staged-toolchain-uses-the-supplied-priv-root
  (let [root (str (System/tmp_dir!) "/staged-barrier-" (System/unique_integer (list :positive)))
        runtime (node (str root "/boot/rt.bl") "rt")
        compiler (node (str root "/boot/compiler.bl") "compiler")
        driver (node (str root "/build/build.bl") "build")
        ordinary (node (str root "/std/example.bl") "example")]
    (File/mkdir_p! (str root "/boot"))
    (File/mkdir_p! (str root "/build"))
    (File/mkdir_p! (str root "/std"))
    (try
      (let [partition (b/partition-plan
                       {:order [compiler runtime driver ordinary]
                        :waves [[compiler runtime driver ordinary]] :deps {}} root)]
        (is (= [runtime compiler driver] (:toolchain partition)))
        (is (= [[ordinary]] (:ordinary-waves partition)))
        (is (= [] (:errors partition))))
      (finally (File/rm_rf! root)))))
