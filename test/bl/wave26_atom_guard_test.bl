; wave26_atom_guard_test.bl — the atom-table guard's THRESHOLDS and its TYPED
; error, ported from ExUnit test/beam_lisp/wave26_atom_guard_test.exs.
;
; The reader refused to intern past a high-water mark since an earlier wave, but
; the reader was never the only layer that interns: the compiler turns keyword
; forms into atoms too. A guard on one of two doors is not a guard, so these
; tests are specifically about the door that was open — and about the guard's
; configuration contract (the clamps) and the exact exception it raises.
;
; PARITY MAPPING. One `deftest` per ExUnit `test`, same order, one `is` per
; `assert`:
;
;   describe "the shared guard"
;     refuses a new name at the high-water mark        → 3 `is`
;     an already-interned name costs nothing           → 1 `is`
;     samples only every :atom_check_interval          → 3 `is`
;     a sane ceiling lets ordinary interning proceed   → 1 `is`
;     configuration is clamped rather than trusted     → 4 `is`
;   describe "the compile path"
;     compiling a novel keyword goes through the guard → 1 `is`
;     a keyword the VM already holds still compiles    → 1 `is`
;     ordinary evaluation is unaffected                → 2 `is`
;
; ADAPTATIONS.
;   * SETUP/ON_EXIT → a SCOPED RESTORE IN `finally`. Ward runs a file's tests in
;     ONE process with no per-test setup or teardown, and the guard reads its
;     ceiling from the GLOBAL application env. `with-guard-config!` saves both
;     keys (`fetch_env` distinguishes "unset" from "set"), overrides them, runs
;     the thunk, and restores them in a `finally` — so a leaked 0.0 fraction can
;     never make a later read refuse, even when the body raises. The clamp test
;     wraps its own body the same way.
;   * ExUnit runs each test in a FRESH process, so the guard's per-process intern
;     counter starts at 0 every test. Ward shares the process, so each test that
;     interns a NOVEL name calls `BeamLisp.AtomGuard/reset` first — the same
;     adaptation `test/bl/reader_atom_guard_test.bl` makes.
;   * `assert_raise AtomGuard.LimitError` is a TYPED check: the raised struct's
;     `:__struct__` must be `:Elixir.BeamLisp.AtomGuard.LimitError`, and the
;     message must contain the same substrings the ExUnit `=~` matched.
;
; Run: bin/bl test test/bl/wave26_atom_guard_test.bl

(ns wave26.atom-guard.test)

; ── guard-config scaffolding: override under a scoped restore ───────────────

(defn- clear-guard! []
  (Application/delete_env :beam_lisp :atom_high_water_fraction)
  (Application/delete_env :beam_lisp :atom_check_interval))

(defn- with-guard-config!
  "Run `thunk` with the guard's ceiling pinned to `fraction`/`interval`, then
   put the application env back exactly as it was. `fetch_env` distinguishes
   \"unset\" from \"set\": a key that was absent is deleted again, never left
   as nil. The restore is in a `finally`, so a raising body leaks nothing."
  [fraction interval thunk]
  (let [had-f (Application/fetch_env :beam_lisp :atom_high_water_fraction)
        old-f (Application/get_env :beam_lisp :atom_high_water_fraction)
        had-i (Application/fetch_env :beam_lisp :atom_check_interval)
        old-i (Application/get_env :beam_lisp :atom_check_interval)]
    (try
      (Application/put_env :beam_lisp :atom_high_water_fraction fraction)
      (Application/put_env :beam_lisp :atom_check_interval interval)
      (thunk)
      (finally
        (if (erlang/== :error had-f)
          (Application/delete_env :beam_lisp :atom_high_water_fraction)
          (Application/put_env :beam_lisp :atom_high_water_fraction old-f))
        (if (erlang/== :error had-i)
          (Application/delete_env :beam_lisp :atom_check_interval)
          (Application/put_env :beam_lisp :atom_check_interval old-i))))))

(defn- raised
  "The exception `thunk` raised, or nil when it returned normally — the value
   `assert_raise` inspected."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

(defn- limit-error?
  "True when `thunk` raises the TYPED `BeamLisp.AtomGuard.LimitError`."
  [thunk]
  (let [e (raised thunk)]
    (erlang/== :Elixir.BeamLisp.AtomGuard.LimitError (:__struct__ e))))

(defn- unique-tag []
  (erlang/unique_integer (list :positive)))

; ══ describe "the shared guard" ═════════════════════════════════════════════

(deftest refuses-a-new-name-when-the-table-is-at-its-high-water-mark
  ; fraction 0.0 ⇒ any live table is already past the ceiling.
  (with-guard-config! 0.0 1
    (fn []
      (BeamLisp.AtomGuard/reset)
      (let [e (raised (fn []
                        (BeamLisp.AtomGuard/to_atom
                          (str "wave26_never_before_seen_" (unique-tag)))))]
        (is (= :Elixir.BeamLisp.AtomGuard.LimitError (:__struct__ e)))
        (is (includes? (ex-message e) "refusing to intern"))
        (is (includes? (ex-message e) "aborts the whole VM"))))))

(deftest an-already-interned-name-costs-nothing-and-is-never-refused
  ; :wave26_existing exists from this very line, so the guard must let it through
  ; even with the ceiling on the floor: re-reading a name the VM already holds
  ; cannot grow the table, and refusing it would break every REPL re-evaluation.
  (let [_witness :wave26_existing]
    (with-guard-config! 0.0 1
      (fn []
        (is (= :wave26_existing (BeamLisp.AtomGuard/to_atom "wave26_existing")))))))

(deftest samples-only-every-atom-check-interval-new-names
  ; Interval 3 with the ceiling on the floor: the first two novel names pass
  ; unsampled, the third trips the check. This is the cost/accuracy trade the
  ; guard makes explicit.
  (with-guard-config! 0.0 3
    (fn []
      (BeamLisp.AtomGuard/reset)
      (let [tag (unique-tag)]
        (is (erlang/is_atom (BeamLisp.AtomGuard/to_atom (str "wave26_a_" tag))))
        (is (erlang/is_atom (BeamLisp.AtomGuard/to_atom (str "wave26_b_" tag))))
        (is (limit-error? (fn [] (BeamLisp.AtomGuard/to_atom (str "wave26_c_" tag)))))))))

(deftest a-sane-ceiling-lets-ordinary-interning-proceed
  (with-guard-config! 0.9999 1
    (fn []
      (BeamLisp.AtomGuard/reset)
      (let [tag (unique-tag)
            name (str "wave26_ok_" tag)]
        (is (= (BeamLisp.AtomGuard/to_atom name) (String/to_atom name)))))))

(deftest configuration-is-clamped-rather-than-trusted
  (try
    (Application/put_env :beam_lisp :atom_high_water_fraction 5.0)
    (is (= 1.0 (BeamLisp.AtomGuard/high_water_fraction)))
    (Application/put_env :beam_lisp :atom_high_water_fraction -1.0)
    (is (= 0.0 (BeamLisp.AtomGuard/high_water_fraction)))
    (Application/put_env :beam_lisp :atom_check_interval 0)
    (is (= 1 (BeamLisp.AtomGuard/check_interval)))
    (Application/put_env :beam_lisp :atom_check_interval :nonsense)
    (is (= 256 (BeamLisp.AtomGuard/check_interval)))
    (finally (clear-guard!))))

; ══ describe "the compile path" ═════════════════════════════════════════════

(deftest compiling-a-novel-keyword-goes-through-the-guard
  ; This is the hole the earlier wave left open: source can reach the compiler
  ; without passing the reader's counter (a macro building keyword forms, or any
  ; caller compiling forms directly), and the compiler interned them unguarded.
  (with-guard-config! 0.0 1
    (fn []
      (BeamLisp.AtomGuard/reset)
      (let [form (tuple :keyword (str "wave26_compiled_" (unique-tag)))]
        (is (limit-error? (fn [] (BeamLisp.Compiler/compile
                                   form (BeamLisp.Compiler/new_env "wave26")))))))))

(deftest a-keyword-the-vm-already-holds-still-compiles-at-any-ceiling
  (let [_witness :wave26_known_keyword]
    (with-guard-config! 0.0 1
      (fn []
        (is (= {:op :lit :val :wave26_known_keyword :ann {}}
               (BeamLisp.Compiler/compile (tuple :keyword "wave26_known_keyword")
                                          (BeamLisp.Compiler/new_env "wave26"))))))))

(deftest ordinary-evaluation-is-unaffected-by-the-guard-being-present
  ; The guard must be invisible in normal use — if it were not, every program
  ; would pay for a hazard that only hostile input creates.
  (is (= 2 (BeamLisp/eval "(:b {:a 1 :b 2})")))
  (is (= 3 (BeamLisp/eval "(count [:x :y :z])"))))
