; codebase_require_cycles_test.bl — the require graph as facts, and the one
; cycle check every consumer shares.
;
; BUG-064 was a require cycle only a cold drop could see: the loader's guard
; is process-local, and the AOT path runs the init in a second process. These
; tests pin that the SAME cycle is a static query away at dev time — indexed
; from source (nothing loaded), detected by sg/cycles, the one owner every
; consumer (build-plan, reload, this query) delegates to.
(ns codebase.require-cycles.test
  (:require [codebase :as cb] [datom]))

(defn- db-with
  "A multi-source corpus db. Bands each source's entity ids by position — the
   same rule as code.index/band-of — because transact-source! numbers facts
   from a per-source base (analyze-cached is one conn PER source; the band is
   the corpus assembler's job)."
  [sources]
  (let [conn (cb/connect-codebase)
        shift (fn [i fs] (mapv (fn [f] (assoc f :db/id (+ (:db/id f) (* i 1000000)))) fs))]
    (doseq [[i [ns src]] (map-indexed (fn [i p] [i p]) sources)]
      (let [facts (cb/index-source {} ns src)]
        (datom/transact! conn (concat (shift i (:fn facts))
                                      (shift i (:calls facts))
                                      (shift i (:instr facts))
                                      (shift i (:requires facts))))))
    (datom/db conn)))

(deftest require-edges-are-facts
  (let [db (db-with {"a" "(ns a (:require [b :as b2] [c]))\n(defn f [] 1)\n"})
        rows (into [] (datom/q '[:find ?d :in $ ?n
                                 :where [?e :ns/name ?n] [?e :ns/requires ?d]]
                               db "a"))]
    (is (= ["b" "c"] (vec (sort (map (fn [r] (get r 0)) rows))))
        ":as and bare specs both contribute their target, and only their target")))

(deftest a-require-cycle-is-named-without-loading-anything
  ; the BUG-064 shape, compressed: substrate (vm.*) ⇄ application (bl.*)
  (let [db (db-with {"vm.session" "(ns vm.session (:require [bl.daemon]))\n"
                     "bl.daemon"  "(ns bl.daemon (:require [bl.cli]))\n"
                     "bl.cli"     "(ns bl.cli (:require [vm.client]))\n"
                     "vm.client"  "(ns vm.client (:require [vm.session]))\n"})
        cycs (cb/require-cycles db)]
    (is (= 1 (count cycs)))
    (let [cyc (vec (first cycs))]
      (is (= (first cyc) (get cyc (- (count cyc) 1))) "a closed path")
      (is (= ["bl.cli" "bl.daemon" "vm.client" "vm.session"]
             (vec (sort (take (- (count cyc) 1) cyc))))
          "every member named"))))

(deftest an-acyclic-graph-has-no-cycles
  (let [db (db-with {"a" "(ns a (:require [b]))\n" "b" "(ns b)\n"})]
    (is (= [] (vec (cb/require-cycles db))))))
