(ns aot-namespace-metadata-test)

(defn- capture [source]
  (BeamLisp.AOT/capture_ns_decl {} (BeamLisp.Reader/read_first source "namespace-metadata.bl")))

(deftest namespace-name-metadata-preserves-complete-require-declarations
  (let [plain (capture "(ns probe (:require [alpha :as a :refer [item]] [beta :refer :all] gamma))")
        annotated (capture "(ns ^{:instr {:for \"mcp\"}} probe (:require [alpha :as a :refer [item]] [beta :refer :all] gamma))")]
    (is (= plain annotated))
    (is (= (list "alpha" "beta" "gamma") (:requires (get annotated "probe"))))
    (is (= (list (tuple "a" "alpha")) (:aliases (get annotated "probe"))))
    (is (= (list (tuple "item" "alpha")) (:refers (get annotated "probe"))))
    (is (= (list "beta") (:refer_alls (get annotated "probe"))))))

(deftest metadata-on-both-the-namespace-form-and-name-is-captured
  (is (= (capture "(ns probe (:require [alpha :as a]))")
         (capture "^{:doc \"outer\"} (ns ^{:doc \"name\"} probe (:require [alpha :as a]))"))))

(deftest actual-codebase-header-retains-its-dependencies
  (let [source (Path/join (BeamLisp.Tiers/priv_root) "std/codebase.bl")
        header (BeamLisp.Reader/read_first (BeamLisp.Loader/read_source source) source)
        metadata (get (BeamLisp.AOT/capture_ns_decl {} header) "codebase")]
    (is (map? metadata))
    (is (some #(= "typed" %) (:requires metadata)))
    (is (some #(= "datom" %) (:requires metadata)))))

(deftest sdk-staging-reports-a-missing-or-mismatched-namespace-before-compilation
  (let [source (Path/join (System/tmp_dir!)
                 (str "bl-namespace-header-" (System/unique_integer (list :positive)) ".bl"))
        namespace "namespace-metadata.expected"
        previous (Process/get :bl_sdk_staging_units)]
    (try
      (doseq [content ["(def value (erlang/error :must-not-run))" "(ns namespace-metadata.other)"]]
        (File/write! source content)
        (is (= (tuple :sdk_stage_namespace_required namespace source)
               (try
                 (BeamLisp.AOT/stage_sdk_dependency! namespace source (BeamLisp.Emit/module_for namespace))
                 :unexpected-success
                 (catch error (BeamLisp.ExInfo/ex_original error))))))
      (is (= (or previous (MapSet/new)) (Process/get :bl_sdk_staging_units)))
      (finally
        (File/rm source)
        (if previous (Process/put :bl_sdk_staging_units previous)
          (Process/delete :bl_sdk_staging_units))))))
