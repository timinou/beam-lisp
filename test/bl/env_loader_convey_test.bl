(ns env.loader-convey-test)

(deftest source-resolution-rides-with-a-conveyed-worker-and-is-restored
 (let [root (str (System/tmp_dir!) "/convey-roots-" (erlang/unique_integer (list :positive)))
       file (str root "/convey/fixture.bl")
       agent (elem (Agent/start (fn [] :state)) 1)]
  (File/mkdir_p! (Path/dirname file))
  (File/write! file "(ns convey.fixture) (defn answer [] 17)")
  (try
   (let [action (BeamLisp.Loader/with_search_dir root
                 (fn [] (BeamLisp.Env/convey (fn [_] (BeamLisp.Loader/source_content "convey.fixture")))))]
    (is (= (File/read! file) (Agent/get agent action)))
    (is (nil? (Agent/get agent (fn [_] (Process/get :bl_search_dirs)))))
    (is (nil? (Agent/get agent (fn [_] (Process/get :bl_fixed_dirs)))))
    (is (nil? (Agent/get agent (fn [_] (Process/get :bl_load_paths))))))
   (finally (Agent/stop agent :normal 30000) (File/rm_rf! root)))))

(deftest nested-failing-conveyance-restores-exact-loader-scope
 (let [before (BeamLisp.Env/capture)
       keys [:bl_search_dirs :bl_fixed_dirs :bl_load_paths]]
  (try
   (doseq [k keys] (Process/put k (list "caller")))
   (let [f (BeamLisp.Env/convey (fn [_]
             (doseq [k keys] (assert (= (list "caller") (Process/get k))))
             (throw "fixture failure")))]
    (doseq [k keys] (Process/put k (list "worker")))
    (try (erlang/apply f (list nil)) (catch _ nil))
    (doseq [k keys] (is (= (list "worker") (Process/get k)))))
   (BeamLisp.Env/bind (dissoc before :loader-resolution))
   (doseq [k keys] (is (nil? (Process/get k))))
   (finally (BeamLisp.Env/bind before)))))
