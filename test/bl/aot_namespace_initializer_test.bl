(ns aot.namespace-initializer-test)

(deftest namespace-replay-survives-a-forwarder-with-only-public-routes
 (let [namespace "aotinitializerfixture"
       directory (Path/join (System/tmp_dir!) (str "bl-namespace-init-" (erlang/unique_integer (list :positive))))
       path (Path/join directory "aotinitializerfixture.bl")
       source "(ns aotinitializerfixture) (def ^:per-env counter (atom 0)) (defn answer [] (swap! counter inc))"
       shim (BeamLisp.Emit/module_for namespace)
       body (BeamLisp.AOT/ns_body_module namespace)
       companion (BeamLisp.AOT/namespace_init_module_for namespace)]
  (try
   (File/mkdir_p! directory) (File/write! path source)
   (BeamLisp.AOT/compile_source source (list (tuple :file path) (tuple :output_dir directory)))
   (is (erlang/function_exported companion :__bl_init_namespace__ 0))
   (is (not (erlang/function_exported companion :__bl_init__ 0)))
   (is (= :namespace
          (Keyword/get (erlang/apply companion :module_info (list :attributes)) :bl_sdk_initializer_lambda_kind)))
   (let [replacement (BeamLisp.Emit/compile_descriptor
          (BeamLisp.Emit/descriptor_for shim
           (list (BeamLisp.Emit/function_clause :answer (BeamLisp.Emit/remote body :answer (list)))
                 (BeamLisp.Emit/function_clause :extra (BeamLisp.Emit/lit 73)))))]
    (BeamLisp.Env/publish_binaries! (list replacement) "namespace-forwarder-extension"))
   (is (not (erlang/function_exported shim :__bl_init__ 0)))
   (BeamLisp.Loader/with_search_dir directory
    (fn []
     (is (= :loaded (BeamLisp.AOT/ensure_loaded namespace)))
     (is (= shim (BeamLisp.Env/with_env :global
                   (fn [] (:module (elem (BeamLisp.Env/lookup (tuple :emitted_publication namespace)) 1))))))
     (doseq [_ (range 2)]
      (BeamLisp.Env/isolated :global (fn []
       (is (= 1 (erlang/apply shim :answer (list))))
       (is (= 2 (erlang/apply shim :answer (list))))
       (is (= 73 (erlang/apply shim :extra (list)))))))))
   (finally (File/rm_rf! directory)))))
