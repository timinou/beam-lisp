(ns aot-declaration-staging-test)

(defn- restricted [f]
 (BeamLisp.Loader/without_initialization (BeamLisp.Env/as_thunk f)))
(defn- original [f]
 (try (f) :unexpected-success (catch error (BeamLisp.ExInfo/ex_original error))))

(deftest stale-context-tokens-cannot-widen-a-declaration-compilation
 (let [before (BeamLisp.Env/capture)]
  (is (= (tuple :sdk_declaration_stage_initializer_refused "core")
       (restricted #(do (BeamLisp.Env/bind before)
                        (original #(BeamLisp.Loader/assert_initializer_execution_allowed! "core")))))))
  (is (= nil (Process/get :bl_loader_initialization_blocked)))))

(deftest source-and-cache-sinks-refuse-before-even-an-already-loaded-namespace-can-run
 (let [source "(ns stage.must-not-evaluate) (def value (erlang/error :ran-initializer))"]
  (restricted
   #(do
     (is (= (tuple :sdk_declaration_stage_initializer_refused :aot-cache-replay)
           (original #(BeamLisp.AOTCache/run_init_modules (list) (System/get_env "HOME")))))
     (is (= (tuple :sdk_declaration_stage_initializer_refused "core")
           (original #(BeamLisp.AOT/init_loaded_module "core" (BeamLisp.Emit/module_for "core")))))
     (is (= :sdk_declaration_stage_source_evaluation_refused
           (original #(BeamLisp.AOT/load_unit source (list)))))
     (is (= :sdk_declaration_stage_source_evaluation_refused
           (original #(BeamLisp.AOT/load_unit_in_snapshot source (list)))))
     (is (= :sdk_declaration_stage_source_evaluation_refused
           (original #(BeamLisp.AOT/compile_source source (list)))))))
  (is (= false (BeamLisp.Env/ns_exists? "stage.must-not-evaluate")))
  (is (= nil (Process/get :bl_loader_initialization_blocked)))))

(deftest restricted-conveyed-callbacks-restore-a-reusable-worker-after-success-and-failure
 (let [callback (restricted #(BeamLisp.Env/convey (fn [_] (BeamLisp.Env/capture))))
       throwing (restricted #(BeamLisp.Env/convey
                              (fn [_] (BeamLisp.Loader/assert_initializer_execution_allowed! "scope"))))]
  (is (= true (:loader-initialization-blocked (callback nil))))
  (is (= nil (Process/get :bl_loader_initialization_blocked)))
  (is (= (tuple :sdk_declaration_stage_initializer_refused "scope")
         (original #(throwing nil))))
  (is (= nil (Process/get :bl_loader_initialization_blocked)))))

(deftest general-initializer-asts-are-collected-without-evaluating-their-effects
 (let [unit (restricted #(BeamLisp.AOT/stage-sdk-unit!
              "(ns stage.deferred-source-test) (def value (erlang/error :ran-initializer)) (defn fetch [] value)"
              (list)))]
  (is (= 1 (count (Map/get (elem unit 1) "stage.deferred-source-test"))))
  (is (= :error (BeamLisp.Env/lookup (tuple "stage.deferred-source-test" "value"))))
  (is (= false (BeamLisp.Env/loaded_ns? "stage.deferred-source-test")))))
