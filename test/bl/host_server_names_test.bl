; Standard OTP server names are values, including application-instance terms.
(ns host.server-names-test)

(defserver named-owner
 (init [value] (ok value))
 (handle-call :value [_ value] (reply value value)))

(deftest pinned-server-accepts-standard-otp-registration-values
 (let [root (str (System/get_env "HOME") "/tmp/host-server-names-"
                 (erlang/unique_integer (list :positive)))
       source (str (BeamLisp.Tiers/priv_root) "/host/server.bl")
       probe :Elixir.BeamLisp.HostServerNamesProbe pids (atom [])]
  (try
   (BeamLisp.AOT/compile_host_file source
    (list (tuple :module probe) (tuple :output_dir root)
          (tuple :source_hash (Base/encode16 (crypto/hash :sha256 (File/read! source)) (list (tuple :case :lower))))
          (tuple :load? true)))
   (doseq [start [:start :start_link]
           kind [:local :global :via]]
    (let [key (tuple :host-server-names start kind (erlang/make_ref))
          name (case kind
                 :local (tuple :local :bl_host_otp_local)
                 :global (tuple :global key)
                 :via (tuple :via :global key))
          pid (erlang/apply probe start (list named-owner key {:name name}))]
     (swap! pids conj pid)
     (is (erlang/is_pid pid))
     (is (= key (erlang/apply probe :call (list (if (= kind :local) :bl_host_otp_local name) :value))))
     (is (= pid (if (= kind :local) (Process/whereis :bl_host_otp_local)
                  (global/whereis_name key))))
     (is (try (erlang/apply probe start (list named-owner :duplicate {:name name})) false
           (catch _ true)))
     (erlang/apply probe :stop (list pid))
     (is (= (if (= kind :local) nil :undefined)
            (if (= kind :local) (Process/whereis :bl_host_otp_local) (global/whereis_name key))))))
   ;; Preserve rejection instead of silently starting an anonymous owner.
   (doseq [name [(tuple :local "bad") (tuple :via "bad" :key) (tuple :global :key :extra) [:global :key]]]
    (is (try (erlang/apply probe :start (list named-owner nil {:name name})) false
          (catch _ true))))
   (finally
    (doseq [pid @pids] (when (Process/alive? pid) (stop pid)))
    (code/delete probe) (code/soft_purge probe) (File/rm_rf! root)))))
