(ns js.exact-global-test
  (:require [js.build :as build] [js.emit :as emit] [anf :as anf]))

(deftest static-linking-distinguishes-exact-provider-from-lexical-core-fallback
  (let [missing (atom []) used (atom #{})
        ctx (build/link-ctx {:ns "consumer" :requires []}
                            {"consumer" #{} "provider" #{} "core" #{"identity"}}
                            #{} missing #{} #{} used)]
    (is (= "N_core.d_identity" ((:resolve ctx) "provider" "identity" nil)))
    (is (= "MISSING(\"provider/identity\")" ((:resolve-exact ctx) "provider" "identity" nil)))
    (is (= [["consumer" "provider" "identity"]] @missing))))

(deftest emission-requires-an-exact-resolver-for-exact-IR
  (let [ctx {:resolve (fn [_ _ _] "lexical") :dest nil}
        exact (anf/global-exact "provider" "identity")]
    (is (= "lexical" (:val (emit/emit (anf/global "provider" "identity") ctx))))
    (is (thrown? (emit/emit exact ctx)))
    (is (= "exact" (:val (emit/emit exact (assoc ctx :resolve-exact (fn [_ _ _] "exact"))))))))

(deftest exact-static-linking-follows-explicit-reexports
  (BeamLisp.Env/add_refer "js.facade.fixture" "identity" "js.provider.fixture")
  (let [ctx (build/link-ctx {:ns "consumer" :requires []}
                            {"consumer" #{} "js.facade.fixture" #{} "js.provider.fixture" #{"identity"}}
                            #{} (atom []) #{} #{} (atom #{}))]
    (is (= "N_js$Oprovider$Ofixture.d_identity"
           ((:resolve-exact ctx) "js.facade.fixture" "identity" nil)))))
