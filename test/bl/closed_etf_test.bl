(ns closed-etf-test)

(defn- bytes [values] (erlang/list_to_binary (to-list values)))
(defn- refusal [f]
 (try (f) nil (catch e (let [data (ex-data e)] [(:kind data) (:reason data)]))))

(deftest finite-native-data-roundtrips-without-a-schema-specific-codec
 (doseq [value [nil false true :existing 0 -200 1.25 18446744073709551616
                "binary" (list) (list 1 2 3) (list 1000 :existing)
                (erlang/++ (list 1) :tail) (tuple) (tuple 1 {:key [2 3]})
                {:nested (list (tuple :value 4))} [1 2] #{1 2}
                (erlang/list_to_tuple (Enum/to_list (Range/new 1 300)))]]
  (let [encoded (erlang/term_to_binary value)]
   (is (= encoded (BeamLisp.CompilerData/check_closed_etf! encoded)))
   (is (= value (BeamLisp.CompilerData/decode_closed_etf! encoded))))))

(deftest runtime-identities-and-functions-refuse-even-inside-data
 (let [calls (atom 0) callback (fn [] (swap! calls inc))]
  (doseq [value [callback (erlang/self) (erlang/make_ref)
                 (erlang/make_fun :erlang :abs 1)]]
   (doseq [container [value (tuple :nested value) {:nested [value]} (list 1 value)]]
    (let [encoded (erlang/term_to_binary container)]
     (is (= [:unsafe-external-data :runtime-or-unknown-tag]
            (refusal #(BeamLisp.CompilerData/check_closed_etf! encoded))))
     (is (= [:unsafe-external-data :runtime-or-unknown-tag]
            (refusal #(BeamLisp.CompilerData/decode_closed_etf! encoded)))))))
  (is (= 0 @calls))))

(deftest forged-runtime-and-distribution-tags-are-never-skipped
 (doseq [tag [68 69 80 82 88 89 90 101 102 103 112 113 114 117 120 121 255]]
  (let [expected (if (= tag 80) :compressed :runtime-or-unknown-tag)]
   (is (= [:unsafe-external-data expected]
          (refusal #(BeamLisp.CompilerData/check_closed_etf! (bytes [131 tag])))))
   (is (= [:unsafe-external-data expected]
          (refusal #(BeamLisp.CompilerData/check_closed_etf! (bytes [131 104 1 tag]))))))))

(deftest structural-budgets-reject-small-header-bombs-before-allocation
 (doseq [header [[131 105 255 255 255 255]
                  [131 108 255 255 255 255]
                  [131 116 255 255 255 255]]]
  (is (= [:unsafe-external-data :node-limit]
         (refusal #(BeamLisp.CompilerData/check_closed_etf! (bytes header))))))
 (let [encoded (erlang/term_to_binary (tuple :one :two))]
  (is (= [:unsafe-external-data :node-limit]
         (refusal #(BeamLisp.CompilerData/check_closed_etf! encoded {:max-nodes 2}))))
  (is (= [:unsafe-external-data :byte-limit]
         (refusal #(BeamLisp.CompilerData/check_closed_etf! encoded {:max-bytes 2})))))
 (is (= [:unsafe-external-data :depth-limit]
        (refusal #(BeamLisp.CompilerData/check_closed_etf!
                    (erlang/term_to_binary (tuple (tuple (tuple 1)))) {:max-depth 1})))))

(deftest malformed-trailing-and-truncated-data-refuse
 (doseq [encoded [(bytes []) (bytes [131]) (bytes [130 106])
                   (bytes [131 97]) (bytes [131 109 0 0 1 0])
                   (bytes [131 104 1]) (bytes [131 106 97 1])
                   (bytes [131 108 0 0 0 1 97 1])]]
  (is (some? (refusal #(BeamLisp.CompilerData/check_closed_etf! encoded)))))
 (is (= [:unsafe-external-data :invalid-input]
        (refusal #(BeamLisp.CompilerData/check_closed_etf! :not-bytes))))
 (is (= [:unsafe-external-data :invalid-limits]
        (refusal #(BeamLisp.CompilerData/check_closed_etf! (bytes [131 106]) {:max-nodes 0}))))
 (let [encoded (erlang/term_to_binary {:key (tuple 1 2 "payload")})]
  (doseq [length (range (erlang/byte_size encoded))]
   (is (some? (refusal #(BeamLisp.CompilerData/check_closed_etf!
                        (binary/part encoded 0 length))))))))
