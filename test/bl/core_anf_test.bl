; core_anf_test.bl — the Core backend lowering bl-ANF (PLAN-079 S-C).
;
; S-A proved quoted → cerl. S-B proved quoted → bl-ANF has the right meaning
; (reference interpreter). S-C closes the triangle: quoted → bl-ANF → cerl →
; Core Erlang → .beam yields the SAME value as the Elixir backend. The Core
; backend now reads the neutral IR, not Elixir-quoted — the shape S-D makes the
; only path and PLAN-080's MLIR/LLVM track shares.

(ns core-anf.test
  (:require [compiler :as c] [self.core :as sc]))

(def kenv (assoc (c/new-env "user") :ns "user"))
(defn- quoted-of [src] (c/compile (BeamLisp.Reader/read_one src) kenv))
(defn- via-elixir [q] (first (erlang/tuple_to_list (Code/eval_quoted q))))
(def ctr (atom 0))
(defn- via-anf-core [q]
  (sc/eval-core-anf (erlang/binary_to_atom (str "bl_cat_" (swap! ctr inc))) q))
(defn- same? [src] (let [q (quoted-of src)] (= (via-elixir q) (via-anf-core q))))

(deftest literals-collections-calls
  (testing "leaves, collections, host calls, globals — through bl-ANF to Core"
    (is (same? "42"))
    (is (same? "[1 :a \"s\"]"))
    (is (same? "{:a 1 :b [2 3]}"))
    (is (same? "(+ 1 2)"))
    (is (same? "(str \"a\" \"b\")"))
    (is (same? "(first [1 2])"))
    (is (same? "(erlang/tuple_size (erlang/list_to_tuple (list 1 2 3)))"))
    (is (same? "(map inc [1 2 3])"))))

(deftest control-and-binding
  (testing "let, if, cond, loop/recur through bl-ANF"
    (is (same? "(let [x 5 y 3] (* x y))"))
    (is (same? "(if (> 3 2) :y :n)"))
    (is (same? "(if nil :y :n)"))
    (is (same? "(cond (> 1 2) :a (< 1 2) :b :else :c)"))
    (is (same? "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))"))))

(deftest fns-matching-errors
  (testing "closures, variadic, multi-clause, destructuring, case, try"
    (is (same? "((fn [n] (* n n)) 6)"))
    (is (same? "((fn [x & xs] (count xs)) 1 2 3 4)"))
    (is (same? "(let [f (fn ([a] :one) ([a b] :two))] [(f 1) (f 1 2)])"))
    (is (same? "(let [[a b] [1 2]] (+ a b))"))
    (is (same? "(case 2 1 :one 2 :two :other)"))
    (is (same? "(try (throw :x) (catch e (ex-message e)))"))
    (is (same? "(let [a (atom 0)] (try (throw :x) (catch e (swap! a inc)) (finally (swap! a (fn [n] (+ n 10))))) (deref a))"))))

(deftest defn-through-anf
  (testing "a defn built through the bl-ANF def path computes correctly"
    (sc/eval-def-anf (quoted-of "(defn cat-fact ([n] (cat-fact n 1)) ([n acc] (if (< n 2) acc (cat-fact (- n 1) (* acc n)))))"))
    (is (= 3628800 (BeamLisp.Ns.User/cat-fact 10)))
    (is (= 1 (BeamLisp.Ns.User/cat-fact 0)))))

(deftest defn-guard-through-anf
  (testing "a guarded defn built through bl-ANF keeps its guard"
    (sc/eval-def-anf (quoted-of "(defn cat-safe-div [a b] {:when (not= b 0)} (/ a b))"))
    (is (= 5 (BeamLisp.Ns.User/cat-safe-div 10 2)))
    (is (= :fc (try (BeamLisp.Ns.User/cat-safe-div 1 0) (catch e :fc))))))

(deftest closure-survives-redef-through-anf
  (testing "a closure from an early bl-ANF def survives 3 redefinitions"
    (sc/eval-def-anf (quoted-of "(defn cat-mk [k] (fn [x] [k x]))"))
    (let [clo (BeamLisp.Ns.User/cat-mk :v1)]
      (sc/eval-def-anf (quoted-of "(defn cat-mk [k] :v2)"))
      (sc/eval-def-anf (quoted-of "(defn cat-mk [k] :v3)"))
      (sc/eval-def-anf (quoted-of "(defn cat-mk [k] :v4)"))
      (is (= [:v1 7] (clo 7)))
      (is (= :v4 (BeamLisp.Ns.User/cat-mk 0))))))

(run-tests)
