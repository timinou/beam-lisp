; core_anf_test.bl — canonical ANF lowers directly to Core Erlang.

(ns core-anf.test (:require [compiler :as c] [lower :as sc]))
(def kenv (assoc (c/new-env "user") :ns "user"))
(defn- compile-anf [src] (c/compile (BeamLisp.Reader/read_one src) kenv))
(defn- via-runtime [src] (BeamLisp.Compiler/eval_string src))
(def ctr (atom 0))
(defn- eval-anf [node]
  (sc/eval-core (erlang/binary_to_atom (str "bl_cat_" (swap! ctr inc)))
                (sc/lower-anf node)))
(defn- via-core [src] (eval-anf (compile-anf src)))
(defn- same? [src] (= (via-runtime src) (via-core src)))

(deftest literals-collections-calls
  (testing "leaves, collections, host calls, globals"
    (is (same? "42")) (is (same? "[1 :a \"s\"]"))
    (is (same? "{:a 1 :b [2 3]}")) (is (same? "(+ 1 2)"))
    (is (same? "(str \"a\" \"b\")")) (is (same? "(first [1 2])"))
    (is (same? "(erlang/tuple_size (erlang/list_to_tuple (list 1 2 3)))"))
    (is (same? "(map inc [1 2 3])"))))

(deftest control-and-binding
  (testing "let, if, cond, loop/recur"
    (is (same? "(let [x 5 y 3] (* x y))")) (is (same? "(if (> 3 2) :y :n)"))
    (is (same? "(if nil :y :n)"))
    (is (same? "(cond (> 1 2) :a (< 1 2) :b :else :c)"))
    (is (same? "(loop [i 0 acc 0] (if (< i 10) (recur (+ i 1) (+ acc i)) acc))"))))

(deftest fns-matching-errors
  (testing "closures, variadic, multi-clause, destructuring, case, try"
    (is (same? "((fn [n] (* n n)) 6)"))
    (is (same? "((fn [x & xs] (count xs)) 1 2 3 4)"))
    (is (same? "(let [f (fn ([a] :one) ([a b] :two))] [(f 1) (f 1 2)])"))
    (is (same? "(let [[a b] [1 2]] (+ a b))"))
    (is (same? "(case 2 1 :one 2 :two :other)"))
    (is (same? "(try (throw :x) (catch e (ex-message e)))"))
    (is (same? "(let [a (atom 0)] (try (throw :x) (catch e (swap! a inc)) (finally (swap! a (fn [n] (+ n 10))))) (deref a))"))))

(deftest canonical-defn-through-core
  (eval-anf (compile-anf "(defn cat-fact ([n] (cat-fact n 1)) ([n acc] (if (< n 2) acc (cat-fact (- n 1) (* acc n)))))"))
  (is (= 3628800 (BeamLisp.Ns.User/cat-fact 10))) (is (= 1 (BeamLisp.Ns.User/cat-fact 0))))

(deftest canonical-guard-through-core
  (eval-anf (compile-anf "(defn cat-safe-div [a b] {:when (not= b 0)} (/ a b))"))
  (is (= 5 (BeamLisp.Ns.User/cat-safe-div 10 2)))
  (is (= :fc (try (BeamLisp.Ns.User/cat-safe-div 1 0) (catch e :fc)))))

(deftest closure-survives-redef-through-core
  (eval-anf (compile-anf "(defn cat-mk [k] (fn [x] [k x]))"))
  (let [clo (BeamLisp.Ns.User/cat-mk :v1)]
    (eval-anf (compile-anf "(defn cat-mk [k] :v2)"))
    (eval-anf (compile-anf "(defn cat-mk [k] :v3)"))
    (eval-anf (compile-anf "(defn cat-mk [k] :v4)"))
    (is (= [:v1 7] (clo 7))) (is (= :v4 (BeamLisp.Ns.User/cat-mk 0)))))

(deftest core-build-is-reproducible
  (let [build (fn []
                (let [expr (sc/lower-anf (compile-anf "(let [x 5 y 3] (+ (* x x) y))"))
                      m (sc/expr->module :bl_repro_probe expr)
                      res (compile/forms m (list :from_core :binary :return))]
                  (sc/reset-fresh!) (elem res 2)))]
    (sc/reset-fresh!)
    (let [b1 (build)] (sc/reset-fresh!)
      (let [b2 (build)] (is (= b1 b2)) (is (< 0 (erlang/byte_size b1)))))))

(run-tests)
