; test/bl/wave5_port_test.bl — wave 5: var linking and `receive`, ported from
; test/beam_lisp/wave5_test.exs.
;
; Run: bl test test/bl/wave5_port_test.bl
;
; ── why the `ev` helper ─────────────────────────────────────────────────────
;
; The ExUnit file drove every var-linking case through `BeamLisp.eval/1`,
; after a `setup` that called `BeamLisp.Env.in_ns("user")`. The observable
; contract of that pair is: a source STRING is compiled at run time with
; `*ns*` = "user", in the image's GLOBAL environment. `ev` reproduces it —
; run at the global env, `*ns*` bound to "user", then restore the caller's
; binding so an assertion wrapped around it still registers under THIS
; file's namespace. (A bare `in_ns` inside a deftest would move the test
; record itself to `user`.)
;
; `Test.realize/1` has no port: `=` is structural and forces a lazy seq, so
; the assertions pin the realized value directly.
;
; ── coverage map (ExUnit test → BL deftest) ─────────────────────────────────
;   var linking / a defn is a named function  → var-linking-named-fn-in-ns-module
;   var linking / redefinition takes effect   → var-linking-redefinition
;   var linking / the interned value is a
;                 composable capture          → var-linking-composable-capture
;   var linking / variadic and multi-arity    → var-linking-variadic-and-multi-arity
;   var linking / recur constant stack        → var-linking-recur-constant-stack
;   var linking / linked calls across ns      → var-linking-across-namespaces
;   var linking / prims variadic fallbacks    → var-linking-prim-variadic-fallbacks
;   receive / keyword pattern                 → receive-keyword-pattern
;   receive / symbol pattern binds            → receive-symbol-pattern-binds
;   receive / vector matches Erlang tuple     → receive-vector-matches-erlang-tuple
;   receive / vector matches beam-lisp vector → receive-vector-matches-bl-vector
;   receive / map pattern binds               → receive-map-pattern-binds
;   receive / after-timeout fires             → receive-after-timeout
;   receive / first matching clause wins      → receive-first-clause-wins
;   receive / wildcard matches anything       → receive-wildcard-matches

(ns wave5.port-test)

; ── helpers ─────────────────────────────────────────────────────────────────

(defn- ev
  "Compile and run `src` at the GLOBAL env with `*ns*` = \"user\", returning
   its value — the port of the ExUnit `setup` + `eval/1` pair."
  [src]
  (BeamLisp.Env/with_env :global
    (fn []
      (BeamLisp.Env/in_ns "user")
      (BeamLisp/eval src))))

(defn- self-send [msg] (erlang/send (erlang/self) msg))

; ── var linking ─────────────────────────────────────────────────────────────

(deftest var-linking-named-fn-in-ns-module
  (ev "(defn w5-linked [x] (* x x))")
  ; ExUnit: apply(BeamLisp.Ns.User, :"w5-linked", [9]) == 81 — the interned
  ; value is an exported function of the namespace module, not a private
  ; closure. A module-qualified call is exactly that assertion.
  (is (= 81 (BeamLisp.Ns.User/w5-linked 9))))

(deftest var-linking-redefinition
  (ev "(defn w5-redef [x] 1)")
  (is (= 1 (ev "(w5-redef 0)")))
  (ev "(defn w5-redef [x] 2)")
  (is (= 2 (ev "(w5-redef 0)"))))

(deftest var-linking-composable-capture
  (ev "(defn w5-double [x] (* 2 x))")
  (is (= '(2 4 6) (ev "(Enum/map [1 2 3] w5-double)")))
  ; ExUnit wrapped the lazy map in Test.realize/1 and compared to [2 4];
  ; `=` forces the seq, so the realized value is pinned here.
  (is (= '(2 4) (ev "(map w5-double [1 2])"))))

(deftest var-linking-variadic-and-multi-arity
  (ev "(defn w5-v [& xs] (count xs))")
  (is (= 4 (ev "(w5-v 1 2 3 4)")))
  (ev "(defn w5-m ([x] x) ([x y] (+ x y)))")
  (is (= 1 (ev "(w5-m 1)")))
  (is (= 3 (ev "(w5-m 1 2)"))))

(deftest var-linking-recur-constant-stack
  (ev "(defn w5-cd [n] (if (= n 0) :done (recur (dec n))))")
  (is (= :done (ev "(w5-cd 2000000)"))))

(deftest var-linking-across-namespaces
  ; (ns w5.lib) defines quadruple; w5.app requires it :as l. Run at the
  ; GLOBAL env: `require` hops into the loader server, which does not carry
  ; the caller's env chain, so an in-memory namespace must be declared at
  ; global for the require to resolve it (the ExUnit file ran at global too).
  (BeamLisp.Env/with_env :global
    (fn []
      (BeamLisp.Env/in_ns "user")
      (BeamLisp/eval "(ns w5.lib) (defn quadruple [x] (* 4 x))")
      (BeamLisp/eval "(ns w5.app (:require [w5.lib :as l]))")))
  (is (= 20 (BeamLisp.Env/with_env :global
               (fn [] (BeamLisp/eval "(l/quadruple 5)")))))
  (ev "(ns user)"))

(deftest var-linking-prim-variadic-fallbacks
  ; prims link to fixed arities; the variadic fallback must still answer.
  (is (= 10 (+ 1 2 3 4)))
  (is (= true (< 1 2 3)))
  (is (= true (= 1 1 1))))

; ── receive ─────────────────────────────────────────────────────────────────

(deftest receive-keyword-pattern
  (self-send :pong)
  (is (= :got-it (receive :pong :got-it))))

(deftest receive-symbol-pattern-binds
  (self-send 42)
  (is (= 84 (receive n (* n 2)))))

(deftest receive-vector-matches-erlang-tuple
  ; ExUnit sent {:greet, "tuple"}; list_to_tuple builds that same Erlang tuple.
  (self-send (erlang/list_to_tuple (list :greet "tuple")))
  (is (= "hi tuple" (receive [:greet who] (str "hi " who)))))

(deftest receive-vector-matches-bl-vector
  (erlang/send (erlang/self) [:greet "vector"])
  (is (= "hi vector" (receive [:greet who] (str "hi " who)))))

(deftest receive-map-pattern-binds
  (self-send {:cmd 7})
  (is (= 8 (receive {:cmd n} (+ n 1)))))

(deftest receive-after-timeout
  (is (= :timed-out (receive :never :no (after 10 :timed-out)))))

(deftest receive-first-clause-wins
  (self-send :x)
  (is (= :right (receive :y :wrong :x :right))))

(deftest receive-wildcard-matches
  (self-send :whatever)
  (is (= :wild (receive _ :wild))))

(run-tests)
