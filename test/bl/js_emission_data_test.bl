(ns bl.js.emission-data-test (:require [js.emit :as emit] [bl.util :as u]))

(defn- node-result [script]
 (System/cmd "node" (u/to-list ["--input-type=module" "-e" script])
                   (u/kw [:stderr_to_stdout true])))

(deftest escaped-literals-round-trip-control-and-unicode-codepoints
 (let [text (unicode/characters_to_binary
             (list 0 1 8 9 10 13 31 34 92 233 8232 8233 128578))
       result (node-result (str "const value=" (emit/js-str text)
                            ";console.log(Buffer.from(value,'utf8').toString('hex'));"))]
  (is (= 0 (elem result 1)) (elem result 0))
  (is (= (str (Base/encode16 text (list (tuple :case :lower))) "\n") (elem result 0)))))

(deftest identifier-escaping-remains-injective-and-reserves-js-keywords
 (let [names ["read-string" "read_string" "read$string" "1x" "$Nx" "class" "class$R" "é" "🙂"]
       outputs (mapv emit/mangle names)]
  (is (= (count names) (count (set outputs))))
  (is (= ["read_string" "read$Ustring" "$N1x" "class$R"]
         (mapv emit/mangle ["read-string" "read_string" "1x" "class"])))))

(deftest nested-functions-keep-captures-and-the-common-actor-callable-abi
 (emit/reset-state!)
 (let [node (BeamLisp.Ns.Compiler/compile
             (BeamLisp.Ns.Reader/read_one "(fn [x] (fn [y] (erlang/+ x y)))")
             (BeamLisp.Ns.Compiler/new_env "emitter.proof"))
       result (emit/emit node {:ns "emitter.proof" :dest nil})
       runtime (Path/dirname (BeamLisp.Loader/source_path "js.emit"))
       script (str "import * as R from " (emit/js-str (str "file://" runtime "/rt.mjs")) ";\n"
                   "import * as C from " (emit/js-str (str "file://" runtime "/actor/module.mjs")) ";\n"
                   (join "\n" (emit/kw-decls)) "\n"
                   (join "\n" (:lines result)) "\nconst f=" (:val result)
                   ";console.log(f(20)(22));")
       output (node-result script)]
  (is (String/contains? (:val result) "C.fn("))
  (is (= 0 (elem output 1)) (elem output 0))
  (is (= "42\n" (elem output 0)))))

(deftest native-objects-keep-all-three-emitter-input-collections-aligned
 (emit/reset-state!)
 (let [node (BeamLisp.Ns.Compiler/compile
             (BeamLisp.Ns.Reader/read_one "#js {:first 20 :second 22}")
             (assoc (BeamLisp.Ns.Compiler/new_env "emitter.native") :target :js :js-interop true))
       result (emit/emit node {:ns "emitter.native" :dest nil})
       runtime (Path/dirname (BeamLisp.Loader/source_path "js.emit"))
       output (node-result
                (str "import * as R from " (emit/js-str (str "file://" runtime "/rt.mjs")) ";\n"
                     "import * as J from " (emit/js-str (str "file://" runtime "/interop.mjs")) ";\n"
                     (join "\n" (:lines result)) "\nconst value=" (:val result)
                     ";console.log(value.first+value.second);"))]
  (is (= 0 (elem output 1)) (elem output 0))
  (is (= "42\n" (elem output 0)))))
