; tiers_test.bl — the pinned `Elixir.BeamLisp.Tiers` host leaf: ABI parity, the
; differential against the live module, and the ISOLATED PREBOOT PROOF.
;
; `priv/host/tiers.bl` is the fourth pinned host source (after `compiler_data`,
; `emit`, `link`): compiled by `BeamLisp.AOT/compile-host-file` into ONE
; exact-named beam whose top-level `defn`s are the call surface every caller
; already names at `Elixir.BeamLisp.Tiers`. `Tiers` is the module asked BEFORE
; rt/core exist — `bin/bl`'s boot-tier verdict, `AOTCache`'s codegen digest, the
; whole build driver — so this file judges the three things that make the pin
; sound, and nothing about the seed mapping (which is added only after this
; passes):
;
;   1. THE EXPORTED ABI IS EXACTLY the recalled public one, no more and no
;      fewer. The pinned emitter exports EVERY top-level `defn` it compiles, so
;      an extra helper is an ABI difference and a missing export is a crash.
;      (The Elixir-generated `__info__/1` is metadata, not call surface, and is
;      the one export the recalled module has that a pinned beam cannot.)
;
;   2. THE ANSWERS MATCH THE LIVE MODULE, question for question, over a corpus
;      that includes the arity defaults, the memoised tier sets, the inode-based
;      source predicates (through a symlink, through `..`, and outside the tree)
;      and the REFUSAL classes (`tier_of_ns` on a non-binary). A fresh compile
;      of the source at a PROBE atom is compared to `Elixir.BeamLisp.Tiers`
;      under a normaliser that makes a raise a value, so a divergence in the
;      exception class is a failure too.
;
;   3. THE EMITTED BEAM RUNS AT PREBOOT. That is the property the pin exists for
;      and the one a same-VM differential cannot see: the compiler that produced
;      the probe has `BeamLisp.Ns.Rt` and all of `core` loaded, so a call that
;      secretly went through the runtime would pass every test above. So the
;      source is compiled at the REAL atom, `load? false`, into a throwaway dir;
;      its atom table is checked for `Elixir.BeamLisp.Ns.Rt` in the PARENT; and a
;      fresh `elixir` child with ONLY that dir added to the code path calls
;      `priv_root`, `boot_namespaces`, `tier_of_ns`, `build_source?` and
;      `sources`, asserting `BeamLisp.Ns.Rt` is not loaded before or after and
;      that `BeamLisp.Env` is not on the path at all.
;
; Run: bin/bl test test/bl/tiers_test.bl

(ns tiers-test)

(def ^:private PROBE :Elixir.BeamLisp.TiersProbe)
(def ^:private LIVE :Elixir.BeamLisp.Tiers)

; ── the recalled ABI, written down once ─────────────────────────────────────

(defn- pair [k v] (erlang/list_to_tuple (list k v)))

(def ^:private RECALLED-EXPORTS
  "Every export of the recalled `BeamLisp.Tiers` that is CALL SURFACE, sorted.
   `__info__/1` is the Elixir-generated doc/attribute helper, not a function a
   caller names; the pinned beam has `module_info/0,1` (every BEAM module does)
   and no `__info__/1`."
  (list
    (pair :boot_dir 0) (pair :boot_dir 1)
    (pair :boot_namespaces 0)
    (pair :"boot_source?" 1) (pair :"boot_source?" 2)
    (pair :build_dir 0) (pair :build_dir 1)
    (pair :build_kernel_namespaces 0)
    (pair :build_namespaces 0)
    (pair :"build_source?" 1) (pair :"build_source?" 2)
    (pair :dirs 0) (pair :dirs 1)
    (pair :library_names 0)
    (pair :module_info 0) (pair :module_info 1)
    (pair :names 0)
    (pair :priv_root 0)
    (pair :sources 0) (pair :sources 1)
    (pair :tier_of_ns 1)
    (pair :"toolchain_source?" 1) (pair :"toolchain_source?" 2)))

(defn- exports [mod]
  (erlang/apply mod :module_info (list :exports)))

(defn- abi-exports [mod]
  "The module's exports minus the two non-call-surface entries a pinned beam and
   an Elixir module spell differently: `__info__/1` (Elixir-only metadata)."
  (Enum/reject (exports mod) (fn [e] (erlang/== (erlang/element 1 e) :__info__))))

; ── the pinned source, compiled once at a probe atom ────────────────────────

(defn- tiers-source [] (Path/join (BeamLisp/cwd) "priv/host/tiers.bl"))

(defn- t [k v] (erlang/list_to_tuple (list k v)))

(defn- ensure-probe!
  "The pinned `Tiers`, compiled from `priv/host/tiers.bl` at `PROBE` with
   `load? false`, then loaded here. Compiled once per VM: a second call returns
   the loaded atom without re-emitting."
  []
  (if (not= false (erlang/apply :code :is_loaded (list PROBE)))
    PROBE
    (let [out (str (System/tmp_dir!) "/bl_tiers_probe_"
                   (erlang/unique_integer (list :positive)))
          result (BeamLisp.AOT/compile_host_file (tiers-source)
                   (list (t :module PROBE) (t :output_dir out) (t :load? false)))
          path (erlang/element 2 result)]
      (code/purge PROBE)
      (code/delete PROBE)
      (code/load_binary PROBE (erlang/binary_to_list path) (File/read! path))
      PROBE)))

; ── normalised answers, so a RAISE is a value too ───────────────────────────

(defn- answer
  "The whole answer of `mod` applied to `name`/`args`: `[:value v]` or
   `[:raise Class message]`. Lets the corpus compare calls that refuse, CLASS
   included — the recall contract is the error class, not just the value.

   The one normalisation is the module name a `FunctionClauseError` reports:
   the probe's own atom necessarily appears in the message (`no function clause
   matching in BeamLisp.TiersProbe.tier_of_ns/1`), so it is folded back onto the
   recalled module's name. Class, arity and message text still have to match."
  [mod name args]
  (try [:value (erlang/apply mod name args)]
       (catch e [:raise (:__struct__ e)
                 (String/replace (ex-message e)
                                 "BeamLisp.TiersProbe" "BeamLisp.Tiers")])))

(defn- same-answer? [a b q]
  (= (answer a (first q) (second q))
     (answer b (first q) (second q))))

; ── the corpus ──────────────────────────────────────────────────────────────

(defn- tree-root [] (BeamLisp/cwd))

(defn- corpus []
  (let [tree (tree-root)
        priv (Path/join tree "priv")
        boot (Path/join priv "boot")
        build (Path/join priv "build")]
    (list
      ; construction and the plain tier lists
      (list :names (list))
      (list :library_names (list))
      (list :build_kernel_namespaces (list))
      ; the arity defaults, and an explicit root
      (list :dirs (list))
      (list :dirs (list priv))
      (list :dirs (list (Path/join tree "no-such-root")))
      (list :boot_dir (list))
      (list :boot_dir (list priv))
      (list :build_dir (list))
      (list :build_dir (list priv))
      (list :boot_namespaces (list))
      (list :build_namespaces (list))
      (list :priv_root (list))
      (list :sources (list))
      (list :sources (list (Path/join tree "no-such-root")))
      ; tier_of_ns, including its guard
      (list :tier_of_ns (list "core"))
      (list :tier_of_ns (list "rt"))
      (list :tier_of_ns (list "reader-node"))
      (list :tier_of_ns (list "build"))
      (list :tier_of_ns (list "build-plan"))
      (list :tier_of_ns (list "source-graph"))
      (list :tier_of_ns (list "ns-interface"))
      (list :tier_of_ns (list "datom"))
      (list :tier_of_ns (list "env"))
      (list :tier_of_ns (list "data-readers"))
      (list :tier_of_ns (list "totally-unknown"))
      (list :tier_of_ns (list :not-a-binary))
      (list :tier_of_ns (list 42))
      (list :tier_of_ns (list nil))
      ; boot_source?: in-tier, cross-tier, outside, explicit root, `..` both ways
      (list :"boot_source?" (list (Path/join boot "core.bl")))
      (list :"boot_source?" (list (Path/join build "build.bl")))
      (list :"boot_source?" (list (Path/join priv "std/env.bl")))
      (list :"boot_source?" (list (Path/join priv "std/reload/ward.bl")))
      (list :"boot_source?" (list (Path/join tree "lib/beam_lisp/tiers.ex")))
      (list :"boot_source?" (list (Path/join tree "priv/boot/core.bl")))
      (list :"boot_source?" (list (Path/join boot "core.bl") priv))
      (list :"boot_source?" (list (Path/join boot "core.bl") (Path/join tree "no-such-root")))
      (list :"boot_source?" (list (Path/join priv "build/../boot/core.bl")))
      (list :"boot_source?" (list (Path/join priv "boot/../std/env.bl")))
      (list :"boot_source?" (list (Path/join boot "a-file-that-is-not-there.bl")))
      (list :"boot_source?" (list "/etc/passwd"))
      ; build_source?
      (list :"build_source?" (list (Path/join build "build.bl")))
      (list :"build_source?" (list (Path/join build "source-graph.bl")))
      (list :"build_source?" (list (Path/join boot "core.bl")))
      (list :"build_source?" (list (Path/join priv "lib/datom.bl")))
      (list :"build_source?" (list (Path/join tree "lib/beam_lisp/tiers.ex")))
      (list :"build_source?" (list (Path/join build "build.bl") priv))
      (list :"build_source?" (list (Path/join build "build.bl") (Path/join tree "no-such-root")))
      (list :"build_source?" (list (Path/join priv "boot/../build/build.bl")))
      (list :"build_source?" (list (Path/join priv "build/../boot/core.bl")))
      (list :"build_source?" (list "/etc/passwd"))
      ; toolchain_source? is the disjunction, at both arities
      (list :"toolchain_source?" (list (Path/join boot "core.bl")))
      (list :"toolchain_source?" (list (Path/join build "build.bl")))
      (list :"toolchain_source?" (list (Path/join priv "std/env.bl")))
      (list :"toolchain_source?" (list (Path/join priv "compat/clojure/string.bl")))
      (list :"toolchain_source?" (list (Path/join boot "core.bl") priv))
      (list :"toolchain_source?" (list (Path/join build "build.bl") priv))
      (list :"toolchain_source?" (list "/etc/passwd")))))

; ── 1. the ABI ──────────────────────────────────────────────────────────────

(deftest the-pinned-tiers-exports-exactly-the-recalled-abi
  (let [recalled (sort (abi-exports LIVE))
        expected (sort RECALLED-EXPORTS)
        probe-exports (sort (exports (ensure-probe!)))]
    (is (= expected recalled)
        "the written-down ABI is the live module's call surface (minus __info__/1)")
    (is (= expected probe-exports)
        (str "exactly the recalled surface — the pinned emitter exports every "
             "top-level defn, so an extra helper is an ABI difference and a "
             "missing export a crash; got " (pr-str probe-exports)))))

(deftest every-abi-function-is-callable-at-both-its-arities
  (let [m (ensure-probe!)]
    (is (= (list "boot" "std" "lib" "compat" "build" "self")
           (erlang/apply m :names (list))))
    (is (= (list "boot" "std" "lib" "compat" "build")
           (erlang/apply m :library_names (list))))
    (is (= (list "source-graph") (erlang/apply m :build_kernel_namespaces (list))))
    (is (= (erlang/apply LIVE :boot_dir (list))
           (erlang/apply m :boot_dir (list))))
    (is (= (erlang/apply LIVE :build_dir (list))
           (erlang/apply m :build_dir (list))))
    (is (= (erlang/apply LIVE :dirs (list)) (erlang/apply m :dirs (list))))
    (is (= (erlang/apply LIVE :sources (list)) (erlang/apply m :sources (list))))))

(deftest the-pinned-module-is-a-deterministic-function-of-its-source
  (let [out (str (System/tmp_dir!) "/bl_tiers_repro_"
                 (erlang/unique_integer (list :positive)))
        build (fn []
                (erlang/element 2
                  (BeamLisp.AOT/compile_host_file (tiers-source)
                    (list (t :module :Elixir.BeamLisp.TiersRepro)
                          (t :output_dir out) (t :load? false)))))]
    (is (= (File/read! (build)) (File/read! (build)))
        "the pinned emitter is deterministic, so a committed seed beam can be
         re-derived from this source and judged by its digest")))

; ── 2. the differential against the live module ─────────────────────────────

(deftest the-pinned-tiers-answers-every-question-as-the-live-module-does
  (let [probe (ensure-probe!)
        mismatches (Enum/filter (corpus) (fn [q] (not (same-answer? probe LIVE q))))]
    (is (= [] (vec (Enum/map mismatches first)))
        (str "a fresh compile of priv/host/tiers.bl answers the corpus exactly "
             "as the live BeamLisp.Tiers does; divergent questions listed by name"))
    (is (pos? (count (corpus))) "the corpus is not empty")))

(deftest the-pinned-tiers-answers-the-expected-values-not-merely-the-live-ones
  (let [m (ensure-probe!)
        boot (erlang/apply m :boot_namespaces (list))
        build (erlang/apply m :build_namespaces (list))
        priv (BeamLisp.Tiers/priv_root)]
    (testing "the tier lists are deterministic plain lists"
      (is (= (list "boot" "std" "lib" "compat" "build" "self")
             (erlang/apply m :names (list))))
      (is (= (list "boot" "std" "lib" "compat" "build")
             (erlang/apply m :library_names (list))))
      (is (= (list "source-graph") (erlang/apply m :build_kernel_namespaces (list)))))
    (testing "the boot tier is the priv/boot basenames, data-readers excluded"
      (is (pos? (count boot)))
      (is (Enum/member? boot "core"))
      (is (Enum/member? boot "compiler"))
      (is (Enum/member? boot "reader"))
      (is (Enum/member? boot "reader-node"))
      (is (Enum/member? boot "rt"))
      (is (Enum/member? boot "sugar"))
      (is (Enum/member? boot "anf"))
      (is (Enum/member? boot "lower"))
      (is (Enum/member? boot "diag"))
      (is (not (Enum/member? boot "data-readers"))
          "data-readers declares no ns and can carry no provenance stamp")
      (is (every? (fn [n] (File/regular? (Path/join (Path/join priv "boot") (str n ".bl")))) boot)))
    (testing "the build tier is the priv/build basenames"
      (is (pos? (count build)))
      (is (Enum/member? build "build"))
      (is (Enum/member? build "build-plan"))
      (is (Enum/member? build "source-graph"))
      (is (Enum/member? build "ns-interface"))
      (is (every? (fn [n] (File/regular? (Path/join (Path/join priv "build") (str n ".bl")))) build)))
    (testing "tier_of_ns routes exactly where the tier sets say"
      (doseq [n boot]
        (is (= :boot (erlang/apply m :tier_of_ns (list n))) (str "boot " n)))
      (doseq [n build]
        (is (= :build (erlang/apply m :tier_of_ns (list n))) (str "build " n)))
      (is (= :library (erlang/apply m :tier_of_ns (list "datom"))))
      (is (= :library (erlang/apply m :tier_of_ns (list "env"))))
      (is (= :library (erlang/apply m :tier_of_ns (list "data-readers")))))
    (testing "the source predicates are inode-based, not string-prefix-based"
      (is (= true (erlang/apply m :"boot_source?" (list (Path/join priv "boot/core.bl")))))
      (is (= false (erlang/apply m :"boot_source?" (list (Path/join priv "build/build.bl")))))
      (is (= false (erlang/apply m :"boot_source?" (list (Path/join priv "std/env.bl")))))
      (is (= false (erlang/apply m :"boot_source?" (list "/etc/passwd"))))
      (is (= true (erlang/apply m :"boot_source?" (list (Path/join priv "build/../boot/core.bl"))))
          "`..` normalises before the walk: the ancestor really IS priv/boot")
      (is (= false (erlang/apply m :"boot_source?" (list (Path/join priv "boot/../std/env.bl"))))
          "traversing OUT of the tier is still outside it")
      (is (= true (erlang/apply m :"build_source?" (list (Path/join priv "build/build.bl")))))
      (is (= false (erlang/apply m :"build_source?" (list (Path/join priv "boot/core.bl")))))
      (is (= true (erlang/apply m :"toolchain_source?" (list (Path/join priv "boot/core.bl")))))
      (is (= true (erlang/apply m :"toolchain_source?" (list (Path/join priv "build/build.bl")))))
      (is (= false (erlang/apply m :"toolchain_source?" (list (Path/join priv "std/env.bl"))))))
    (testing "dirs keeps only existing tier directories; sources is sorted .bl"
      (let [ds (erlang/apply m :dirs (list priv))
            ss (erlang/apply m :sources (list priv))]
        (is (= 5 (count ds)))
        (is (every? (fn [d] (File/dir? d)) ds))
        (is (= (Enum/map (erlang/apply m :library_names (list))
                         (fn [t] (Path/join priv t)))
               ds)
            "tier order, not sorted — `dirs` walks @library_tiers")
        (is (pos? (count ss)))
        (is (= ss (sort ss)))
        (is (every? (fn [p] (ends-with? p ".bl")) ss))))))

(deftest a-non-binary-namespace-is-refused-by-the-guard-not-coerced
  (let [m (ensure-probe!)
        outcome (fn [mod]
                  (try (erlang/apply mod :tier_of_ns (list :not-a-ns))
                       :returned
                       (catch FunctionClauseError _e :function-clause)
                       (catch _e :other-class)))]
    (is (= :function-clause (outcome m))
        "a non-binary ns is refused by the clause guard, not read as :library")
    (is (= (outcome LIVE) (outcome m))
        "with the same error class the recalled module raised")))

(deftest the-inode-identity-holds-through-a-symlink
  (let [tmp (str (System/tmp_dir!) "/bl_tiers_link_"
                 (erlang/unique_integer (list :positive)))
        link (Path/join tmp "boot")
        priv (BeamLisp.Tiers/priv_root)
        m (ensure-probe!)]
    (File/mkdir_p! tmp)
    (try
      (File/ln_s! (Path/join (tree-root) "priv/boot") link)
      ; A path THROUGH the link: the walk sees priv/boot's inode, not the link
      ; path — the property the launcher's `beam_lisp-<vsn>/priv` shape needs.
      (is (= true (erlang/apply m :"boot_source?" (list (Path/join link "core.bl")))))
      (is (= true (erlang/apply m :"boot_source?" (list (Path/join link "core.bl")
                                                       priv))))
      (is (= false (erlang/apply m :"build_source?" (list (Path/join link "core.bl")))))
      ; and the live module agrees, answer for answer
      (is (= (BeamLisp.Tiers/boot_source? (Path/join link "core.bl"))
             (erlang/apply m :"boot_source?" (list (Path/join link "core.bl")))))
      (finally (File/rm_rf! tmp)))))

; ── 3. the isolated preboot proof ───────────────────────────────────────────

(defn- preboot-script []
  (str
    "mod = :\"Elixir.BeamLisp.Tiers\"\n"
    "{:module, ^mod} = :code.ensure_loaded(mod)\n"
    "IO.puts(\"loaded_from_tmp=\" <> to_string(:code.which(mod)))\n"
    "IO.puts(\"env_absent=\" <> to_string(:code.which(:\"Elixir.BeamLisp.Env\") == :non_existing))\n"
    "IO.puts(\"rt_before=\" <> to_string(:code.is_loaded(:\"Elixir.BeamLisp.Ns.Rt\")))\n"
    "priv = mod.priv_root()\n"
    "IO.puts(\"priv_root=\" <> priv)\n"
    "IO.puts(\"priv_is_dir=\" <> to_string(File.dir?(priv)))\n"
    "IO.puts(\"priv_parent=\" <> to_string(Path.dirname(priv)))\n"
    "boot = mod.boot_namespaces()\n"
    "IO.puts(\"boot_count=\" <> to_string(length(boot)))\n"
    "IO.puts(\"boot_core=\" <> to_string(\"core\" in boot))\n"
    "IO.puts(\"boot_reader_node=\" <> to_string(\"reader-node\" in boot))\n"
    "IO.puts(\"boot_data_readers=\" <> to_string(\"data-readers\" in boot))\n"
    "IO.puts(\"build_count=\" <> to_string(length(mod.build_namespaces())))\n"
    "IO.puts(\"build_has_build_plan=\" <> to_string(\"build-plan\" in mod.build_namespaces()))\n"
    "IO.puts(\"tier_core=\" <> to_string(mod.tier_of_ns(\"core\")))\n"
    "IO.puts(\"tier_build_plan=\" <> to_string(mod.tier_of_ns(\"build-plan\")))\n"
    "IO.puts(\"tier_datom=\" <> to_string(mod.tier_of_ns(\"datom\")))\n"
    "IO.puts(\"boot_source_in=\" <> to_string(mod.boot_source?(Path.join([priv, \"boot\", \"core.bl\"]))))\n"
    "IO.puts(\"boot_source_out=\" <> to_string(mod.boot_source?(Path.join([priv, \"build\", \"build.bl\"]))))\n"
    "IO.puts(\"build_source_in=\" <> to_string(mod.build_source?(Path.join([priv, \"build\", \"build.bl\"]))))\n"
    "IO.puts(\"build_source_out=\" <> to_string(mod.build_source?(Path.join([priv, \"boot\", \"core.bl\"]))))\n"
    "IO.puts(\"toolchain_in=\" <> to_string(mod.toolchain_source?(Path.join([priv, \"boot\", \"core.bl\"]))))\n"
    "IO.puts(\"toolchain_out=\" <> to_string(mod.toolchain_source?(Path.join([priv, \"std\", \"env.bl\"]))))\n"
    "IO.puts(\"names=\" <> inspect(mod.names()))\n"
    "IO.puts(\"dirs_ok=\" <> to_string(Enum.all?(mod.dirs(), &File.dir?/1)))\n"
    "IO.puts(\"sources_ok=\" <> to_string(length(mod.sources()) > 0))\n"
    "IO.puts(\"rt_after=\" <> to_string(:code.is_loaded(:\"Elixir.BeamLisp.Ns.Rt\")))\n"))

(defn- beam-atoms
  "Every atom in the beam's atom table — the structural read that shows a module
   does not NAME the runtime it must not call."
  [path]
  (let [r (erlang/apply :beam_lib :chunks
                        (list (erlang/binary_to_list path) (list :atoms)))]
    (cond
      (and (erlang/is_tuple r) (= :ok (erlang/element 1 r)))
      (erlang/element 2 (first (erlang/element 2 (erlang/element 2 r))))
      :else [])))

(deftest the-pinned-beam-does-not-name-the-runtime-it-must-not-call
  (let [out (str (System/tmp_dir!) "/bl_tiers_preboot_"
                 (erlang/unique_integer (list :positive)))
        result (BeamLisp.AOT/compile_host_file (tiers-source)
                 (list (t :module LIVE) (t :output_dir out) (t :load? false)))
        path (erlang/element 2 result)
        atoms (beam-atoms path)]
    (is (pos? (count atoms)) "the emitted beam was read back")
    (is (not (Enum/member? atoms :"Elixir.BeamLisp.Ns.Rt"))
        "the pinned beam never mentions BeamLisp.Ns.Rt — no core/Rt convenience
         leaked into the preboot path")
    (is (not (Enum/member? atoms :"Elixir.BeamLisp.Env"))
        "nor BeamLisp.Env: the preboot path cannot intern vars")
    (File/rm_rf! out)))

(deftest a-fresh-elixir-runs-the-candidate-beam-with-no-runtime-loaded
  (let [out (str (System/tmp_dir!) "/bl_tiers_preboot_"
                 (erlang/unique_integer (list :positive)))
        _ (BeamLisp.AOT/compile_host_file (tiers-source)
            (list (t :module LIVE) (t :output_dir out) (t :load? false)))
        r (System/cmd "elixir"
                      (to-list ["-pa" out "-e" (preboot-script)])
                      (to-list [(tuple :cd (tree-root))
                                (tuple :stderr_to_stdout true)]))
        text (elem r 0)
        priv (Path/join (tree-root) "priv")]
    (is (= 0 (elem r 1)) (str "the child VM exited " (elem r 1) ":\n" text))
    (testing "nothing but Elixir/OTP and the candidate beam"
      (is (includes? text "env_absent=true")
          "BeamLisp.Env is not on the child's code path at all")
      (is (includes? text "rt_before=false") "BeamLisp.Ns.Rt is not loaded up front")
      (is (includes? text (str "loaded_from_tmp=" out "/Elixir.BeamLisp.Tiers.beam"))
          "the child loaded the CANDIDATE beam, not a repo ebin"))
    (testing "the preboot answers are the tree's"
      (is (includes? text (str "priv_root=" priv)) "priv_root falls back to the checkout")
      (is (includes? text "priv_is_dir=true"))
      (is (includes? text (str "priv_parent=" (tree-root))))
      (is (includes? text "boot_count=9"))
      (is (includes? text "boot_core=true"))
      (is (includes? text "boot_reader_node=true"))
      (is (includes? text "boot_data_readers=false"))
      (is (includes? text "build_count=21"))
      (is (includes? text "build_has_build_plan=true"))
      (is (includes? text "tier_core=boot"))
      (is (includes? text "tier_build_plan=build"))
      (is (includes? text "tier_datom=library"))
      (is (includes? text "boot_source_in=true"))
      (is (includes? text "boot_source_out=false"))
      (is (includes? text "build_source_in=true"))
      (is (includes? text "build_source_out=false"))
      (is (includes? text "toolchain_in=true"))
      (is (includes? text "toolchain_out=false"))
      (is (includes? text "names=[\"boot\", \"std\", \"lib\", \"compat\", \"build\", \"self\"]"))
      (is (includes? text "dirs_ok=true"))
      (is (includes? text "sources_ok=true"))
      (is (includes? text "rt_after=false")
          "no call dragged the runtime in — the whole proof"))
    (File/rm_rf! out)))
