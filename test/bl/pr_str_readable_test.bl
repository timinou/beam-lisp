; test/bl/pr_str_readable_test.bl — `pr-str` is the READABLE printer: what it
; writes, the reader reads back to an equal value (FUP-032).
;
; The defect this fences: `(pr-str "/tmp/x")` answered `/tmp/x` — a bare string,
; unquoted — so nothing read it back as the string it was, and `pr-str` of a
; string was indistinguishable from `pr-str` of a symbol. It was not academic:
; `.bl-check.edn`'s per-source keys were written with `pr-str`, so the baseline
; on disk held `/tmp/x/a.bl {:sha …}`; the data reader read that key as a
; SYMBOL, every `(get-in base [:files path :sha])` missed, and the regression
; gate silently compared against nothing for a day.
;
; `print-str` and `println` are the RAW printers and stay raw: `str` is
; Clojure's `toString`, `print-str` its `print-str`. `pr-str` is the one whose
; output must survive a round trip.
(ns pr-str-readable-test)

(deftest a-scalar-round-trips-through-its-readable-form
  (testing "string, symbol, keyword, number, boolean, nil"
    (doseq [v ["/tmp/x" "" "with \"quotes\" inside" "with\na newline" "42"
               'sym :kw 0 42 -7 3.5 true false nil]]
      (is (= v (read-data (pr-str v)))
          (str "round trip failed for " (pr-str v))))))

(deftest a-container-of-scalars-round-trips-too
  (testing "vector, list, map, set, mixed"
    (doseq [v [["a" "b"] '("a" "b") {"k" "v"} {"k" 'sym} #{"a" "b"}
               [1 "two" :three 'four nil true 3.5]]]
      (is (= v (read-data (pr-str v)))
          (str "round trip failed for " (pr-str v))))))

(deftest the-raw-printers-stay-raw
  (testing "print-str and str do not quote — only pr-str does"
    (is (= "get" (print-str "get")))
    (is (= "get" (str "get")))))
