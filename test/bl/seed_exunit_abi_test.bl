; test/bl/seed_exunit_abi_test.bl — test.seed-exunit-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-exunit-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-ex-unit-case-publishes-its-macro-abi
  ;; `Elixir.BeamLisp.ExUnitCase` is the one-line `use` for async beam-lisp
  ;; tests: `use BeamLisp.ExUnitCase, warm: {name, sources}` must find a MACRO at
  ;; that atom, never an undefined function. The mapping is functions-only with
  ;; ONE opt — `:macro-exports [{:__using__ 1}]` — so the published beam must
  ;; carry BOTH halves of the pair: the `MACRO-__using__/2` implementer as an
  ;; EXPORT and `{__using__, 1}` in `__info__(:macros)`, the entry `require`
  ;; reads before it will expand the `use` at all. The plain `resolve_base/1`
  ;; the `setup_all` expansion calls rides beside them; the beam carries no
  ;; struct surface. Judged from the beam's own export chunk and, for the macros
  ;; table, by swapping the beam in at the production atom — from the REAL
  ;; source, so the assertion cannot drift from the file the seed compiles. The
  ;; macro must be STAGED before an Elixir test file compiles:
  ;; `bin/bl-stage-hosts` copies every beam the manifest's `hosts` list names
  ;; into the build ebin BEFORE `elixirc` runs, so a `use BeamLisp.ExUnitCase`
  ;; in the Elixir test corpus (`test/**/*_test.exs`) resolves against the
  ;; pinned beam rather than a missing module.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "ex-unit-case-out")
        real {"Elixir.BeamLisp.ExUnitCase" (Path/join root "priv/host/ex_unit_case.bl")}
        hd (s/host-scratch "ex-unit-case-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.ExUnitCase.beam")
          exports (s/beam-exports beam)]
      (is (File/exists? beam) "ExUnitCase is COMPILED into the floor")
      (is (s/has? exports (tuple :"MACRO-__using__" 2))
          "the published ExUnitCase beam exports the MACRO-__using__/2 implementer, the caller env leading")
      (is (s/has? exports (tuple :resolve_base 1))
          "the published beam exports the plain resolve_base/1 the setup_all expansion calls")
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "ExUnitCase is functions-only: the published beam carries no struct surface")
      (is (erlang/== (list (tuple :__using__ 1))
                     (s/with-swapped-module :"Elixir.BeamLisp.ExUnitCase" beam
                       (fn [m] (erlang/apply m :__info__ (list :macros)))))
          "and advertises it through __info__(:macros), so `use BeamLisp.ExUnitCase` expands __using__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
