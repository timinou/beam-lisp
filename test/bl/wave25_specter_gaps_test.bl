; test/bl/wave25_specter_gaps_test.bl — the Specter-gap semantics, ported from
; test/beam_lisp/wave25_specter_gaps_test.exs.
;
; `defn-`, `reify`, `identical?`, and `defprotocol`'s leading docstring — the
; top four gaps the Specter compatibility measurement ranked cheapest per slice
; unlocked. Each is tested for its semantics AND its edges: `defn-` is ENFORCED
; private (not merely flagged), `reify` closes over its lexical environment,
; `identical?` is reference equality with the documented `===` deviation, and a
; `defprotocol` docstring lands in the protocol's `:doc` var metadata.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 24 ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order (the four `describe` blocks flatten into that sequence):
;   defn-: callable in its own ns; marks the var private; docstring + private
;     coexist; not reachable by qualified name from another ns; not reachable
;     through an alias; cannot be :refer'd; public vars unaffected; rejects an
;     empty body; a public defn carries no private flag.
;   reify: one protocol dispatches; several protocols on one instance; closes
;     over its lexical environment; `this` is the instance; distinct per reify
;     site; an incomplete extension is refused at extend time.
;   identical?: equal value types; different values; strict (1 vs 1.0); fun
;     reference identity; the NONE-sentinel pattern.
;   defprotocol docstring: accepted and stored; retrievable via Env.doc_string;
;     absent docstring leaves no doc; docstring plus multiple methods.
;
; Adaptations, and why:
;   * `alias BeamLisp.{Compiler, Env}` becomes direct module calls.
;   * The ExUnit `setup` (init + `in_ns "user"`) has no ward equivalent; each
;     test calls `(start)` itself, exactly as the wave-24 port does.
;   * `assert_raise` pairs become typed `catch` clauses: `BeamLisp.CompileError`
;     with "is not public" for the privacy edges, `RuntimeError` with "missing
;     methods" for the incomplete `reify` — the type and the message ARE the
;     contract, so both are asserted, not merely "it refused".
;   * `{:ok, %{…}}` / `{:error}` results are Erlang tuples, so they are written
;     `(tuple :ok {…})` — a bare `{:ok …}` map literal would be a map, not the
;     two-tuple `Env.meta` answers with.
;
; Run: bin/bl test test/bl/wave25_specter_gaps_test.bl

(ns wave25-specter-gaps.test)

(defn- start []
  (BeamLisp/init)
  (BeamLisp.Env/in_ns "user"))

(defn- eval [source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "user")))

(defn- eval-in [ns-name source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env ns-name)))

; A compile error that names a var as not public — the Clojure
; "var: #'ns/name is not public" shape.
(defn- not-public? [f]
  (try
    (do (f) false)
    (catch BeamLisp.CompileError e (includes? (ex-message e) "is not public"))))

; ── defn- — private function definition ────────────────────────────────────

(deftest defines-a-fn-that-is-callable-inside-its-own-namespace
  (start)
  (eval-in "w25.a" "(ns w25.a)\n(defn- secret [x] (* x 2))\n(defn public-fn [x] (secret x))")
  ; bare and qualified access within the defining namespace both work
  (is (= 10 (eval-in "w25.a" "(secret 5)")))
  (is (= 10 (eval-in "w25.a" "(w25.a/secret 5)")))
  ; a public wrapper can call the private fn
  (is (= 42 (eval-in "w25.a" "(w25.a/public-fn 21)"))))

(deftest marks-the-var-private-in-its-metadata
  (start)
  (eval-in "w25.meta" "(ns w25.meta)\n(defn- hidden [x] x)")
  (is (= (tuple :ok {:private true}) (BeamLisp.Env/meta "w25.meta" "hidden"))))

(deftest a-docstring-and-the-private-flag-coexist-in-the-metadata
  (start)
  (eval-in "w25.meta2" "(ns w25.meta2)\n(defn- documented \"intentionally hidden\" [x] x)")
  (is (= (tuple :ok {:doc "intentionally hidden" :private true})
         (BeamLisp.Env/meta "w25.meta2" "documented"))))

(deftest is-not-reachable-by-qualified-name-from-another-namespace
  (start)
  (eval-in "w25.sec" "(ns w25.sec)\n(defn- secret [x] (* x 2))")
  (is (not-public? (fn [] (eval-in "w25.intruder" "(ns w25.intruder)\n(w25.sec/secret 5)")))))

(deftest is-not-reachable-through-an-alias-from-another-namespace
  (start)
  (eval-in "w25.aliased" "(ns w25.aliased)\n(defn- inner [x] x)")
  (is (not-public? (fn [] (eval-in "w25.ali2" "(ns w25.ali2)\n(w25.aliased/inner 1)")))))

(deftest cannot-be-refer-d-into-another-namespace
  (start)
  (eval-in "w25.ref" "(ns w25.ref)\n(defn- locked [x] x)")
  (is (not-public? (fn [] (eval-in "w25.ref2" "(ns w25.ref2 (:require [w25.ref :refer [locked]]))")))))

(deftest public-vars-in-the-same-namespace-are-unaffected
  (start)
  (eval-in "w25.pub" "(ns w25.pub)\n(defn- p [x] (+ x 1))\n(defn q [x] (p x))")
  (is (= 2 (eval-in "w25.other" "(ns w25.other)\n(w25.pub/q 1)"))))

(deftest rejects-an-empty-body-with-a-clear-error
  (start)
  (is (try
        (do (eval "(defn- nope)") false)
        (catch BeamLisp.CompileError e
          (includes? (ex-message e) "expected at least one parameter vector")))))

(deftest a-public-defn-does-not-carry-the-private-flag
  (start)
  (eval-in "w25.notpriv" "(ns w25.notpriv)\n(defn open [x] x)")
  (is (= :error (BeamLisp.Env/meta "w25.notpriv" "open"))))

; ── reify — anonymous protocol instances ───────────────────────────────────

(deftest builds-an-instance-implementing-one-protocol-dispatching-correctly
  (start)
  (eval-in "w25.r1" "(ns w25.r1)\n(defprotocol Area (area [this]))\n(def c (reify Area (area [this] 42)))")
  (is (= 42 (eval-in "w25.r1" "(area c)"))))

(deftest implements-several-protocols-on-one-instance
  (start)
  (eval-in "w25.r2" "(ns w25.r2)\n(defprotocol A (a [this]))\n(defprotocol B (b [this]))\n(def x (reify A (a [this] :a) B (b [this] :b)))")
  (is (= :a (eval-in "w25.r2" "(a x)")))
  (is (= :b (eval-in "w25.r2" "(b x)"))))

(deftest closes-over-its-lexical-environment-the-whole-point-versus-deftype
  (start)
  (eval-in "w25.r3" (str "(ns w25.r3)\n"
                         "(defprotocol Scale (scaled [this]))\n"
                         "(defn make-scaler [factor base]\n"
                         "  (reify Scale (scaled [this] (* factor base))))\n"
                         "(def s3 (make-scaler 3 10))\n"
                         "(def s5 (make-scaler 5 10))"))
  ; each instance captures the factor it was built with
  (is (= 30 (eval-in "w25.r3" "(scaled s3)")))
  (is (= 50 (eval-in "w25.r3" "(scaled s5)"))))

(deftest method-bodies-receive-the-instance-as-this
  (start)
  (eval-in "w25.r4" (str "(ns w25.r4)\n"
                         "(defprotocol Ident (self [this]))\n"
                         "(defprotocol Named (name-of [this]))\n"
                         "(def x (reify Ident (self [this] this) Named (name-of [this] \"anon\")))"))
  ; `this` inside a method is the same instance that was reified
  (is (= true (eval-in "w25.r4" "(identical? x (self x))")))
  (is (= "anon" (eval-in "w25.r4" "(name-of x)"))))

(deftest an-instance-is-a-new-type-distinct-from-other-reify-sites
  (start)
  (eval-in "w25.r5" "(ns w25.r5)\n(defprotocol T (tag [this]))\n(def a (reify T (tag [this] :a)))\n(def b (reify T (tag [this] :b)))")
  (is (= :a (eval-in "w25.r5" "(tag a)")))
  (is (= :b (eval-in "w25.r5" "(tag b)"))))

(deftest an-incomplete-extension-is-refused-at-extend-time
  (start)
  (eval-in "w25.r6" "(ns w25.r6)\n(defprotocol Two (m1 [this]) (m2 [this]))")
  (is (try
        (do (eval-in "w25.r6" "(reify Two (m1 [this] 1))") false)
        (catch RuntimeError e (includes? (ex-message e) "missing methods")))))

; ── identical? — reference equality ────────────────────────────────────────

(deftest equal-value-types-are-identical
  (start)
  (is (= true (eval "(identical? 1 1)")))
  (is (= true (eval "(identical? :k :k)")))
  (is (= true (eval "(identical? \"same\" \"same\")")))
  (is (= true (eval "(identical? [1 2] [1 2])"))))

(deftest different-values-are-not-identical
  (start)
  (is (= false (eval "(identical? 1 2)")))
  (is (= false (eval "(identical? :a :b)")))
  (is (= false (eval "(identical? [1 2] [1 3])"))))

(deftest is-strict-no-numeric-coercion-the-eq-eq-eq-deviation-honest
  (start)
  ; On the BEAM identical? is `===`: type-strict, so 1 and 1.0 are different
  ; terms. Clojure would also return false here; the deviation is on the TRUE
  ; side — see BeamLisp.Ns.Rt.identical?/2.
  (is (= false (eval "(identical? 1 1.0)"))))

(deftest functions-have-reference-identity
  (start)
  ; Funs are the one ordinary term that carries true identity on the BEAM: the
  ; same fun is identical to itself, two separately-created funs are not.
  (is (= true (eval "(let [f (fn [x] x)] (identical? f f))")))
  (is (= false (eval "(identical? (fn [x] x) (fn [x] x))"))))

(deftest serves-specters-none-sentinel-pattern-with-an-atom-sentinel
  (start)
  (eval "(def NONE :__none__)\n(defn strip [v] (if (identical? v NONE) :stripped v))")
  (is (= :stripped (eval "(strip NONE)")))
  (is (= 5 (eval "(strip 5)")))
  ; a copy of the sentinel value (same atom) is still the sentinel
  (is (= :stripped (eval "(strip :__none__)"))))

; ── defprotocol leading docstring ──────────────────────────────────────────

(deftest a-docstring-between-the-name-and-first-method-is-accepted-and-stored
  (start)
  (eval-in "w25.pd" (str "(ns w25.pd)\n"
                         "(defprotocol Greeter \"A greeter protocol.\" (greet [this] \"hi\"))\n"
                         "(extend-type :keyword Greeter (greet [this] \"hi\"))"))
  (is (= (tuple :ok {:doc "A greeter protocol."}) (BeamLisp.Env/meta "w25.pd" "Greeter")))
  ; the protocol still works after the docstring was skipped
  (is (= "hi" (eval-in "w25.pd" "(greet :x)"))))

(deftest the-docstring-is-retrievable-via-the-same-doc-resolution-as-defn
  (start)
  (eval-in "w25.pd2" "(ns w25.pd2)\n(defprotocol Doc'd \"documented protocol\" (m [this] 1))")
  (is (= {:ns "w25.pd2" :name "Doc'd" :doc "documented protocol"}
         (BeamLisp.Env/doc_string "w25.pd2" "Doc'd"))))

(deftest a-protocol-without-a-docstring-still-defines-and-has-no-doc
  (start)
  (eval-in "w25.pd3" "(ns w25.pd3)\n(defprotocol Plain (m [this] 2))\n(extend-type :keyword Plain (m [this] 2))")
  (is (= :error (BeamLisp.Env/meta "w25.pd3" "Plain")))
  (is (= 2 (eval-in "w25.pd3" "(m :x)"))))

(deftest multiple-methods-and-a-docstring-together
  (start)
  (eval-in "w25.pd4" (str "(ns w25.pd4)\n"
                          "(defprotocol P \"two methods\" (one [this] 1) (two [this] 2))\n"
                          "(extend-type :keyword P (one [this] 1) (two [this] 2))"))
  (is (= (tuple :ok {:doc "two methods"}) (BeamLisp.Env/meta "w25.pd4" "P")))
  (is (= 1 (eval-in "w25.pd4" "(one :x)")))
  (is (= 2 (eval-in "w25.pd4" "(two :x)"))))
