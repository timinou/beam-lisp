(ns host.loader-resolution-snapshot-test)

(def probe :Elixir.BeamLisp.LoaderResolutionSnapshotProbe)
(defn tmp-dir []
  (str (System/tmp_dir!) "/bl_resolution_snapshot_" (erlang/unique_integer (list :positive))))
(defn drop! [mod] (code/purge mod) (code/delete mod))
(defn compile-pinned [mod dir]
  (let [result (BeamLisp.AOT/compile_host_file
                 (Path/join (BeamLisp/cwd) "priv/host/loader.bl")
                 (list (tuple :module mod) (tuple :output_dir dir) (tuple :load? false)))
        path (second result)]
    (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
    (drop! :Elixir.BeamLisp.Ns.Host.Loader)))

(deftest resolution-snapshot-is-bounded-by-pass-and-search-context
  (let [dir (tmp-dir) other (str dir "-other")
        ns (str "resolution" (erlang/unique_integer (list :positive)))
        source (str "(ns " ns ") (def answer 42)")
        path (Path/join dir (str ns ".bl"))
        other-path (Path/join other (str ns ".bl"))]
    (File/mkdir_p! dir) (File/mkdir_p! other)
    (compile-pinned probe dir)
    (try
      (erlang/apply probe :with_search_dir (list dir (fn []
        (erlang/apply probe :with_declaration_snapshot (list (fn []
          (doseq [_ (range 100)]
            (is (= false (erlang/apply probe :resolvable? (list ns)))))
          (is (= 1 (erlang/map_size (Process/get :bl_declaration_snapshot))))
          (File/write! path source)
          (is (= false (erlang/apply probe :resolvable? (list ns))))
          (File/write! other-path source)
          (is (= true (erlang/apply probe :with_search_dir
                        (list other (fn [] (erlang/apply probe :resolvable? (list ns)))))))
          (is (= false (erlang/apply probe :resolvable? (list ns)))))))
        (is (= true (erlang/apply probe :resolvable? (list ns)))))))
      (is (nil? (Process/get :bl_declaration_snapshot)))
      (File/rm! path)
      (is (= false (erlang/apply probe :with_search_dir
                    (list dir (fn [] (erlang/apply probe :resolvable? (list ns)))))))
      ;; A changed cwd changes the meaning of relative search roots.
      (let [cwd (File/cwd!)]
        (try
          (File/cd! dir)
          (erlang/apply probe :with_search_dir (list "." (fn []
            (erlang/apply probe :with_declaration_snapshot (list (fn []
              (is (= false (erlang/apply probe :resolvable? (list ns))))
              (File/cd! other)
              (is (= true (erlang/apply probe :resolvable? (list ns))))
              (File/cd! dir)
              (is (= false (erlang/apply probe :resolvable? (list ns))))))))))
          (finally (File/cd! cwd))))
      ;; Loading code is positive live evidence, even after a cached negative.
      (let [mod (BeamLisp.Link/module_for ns)
            forms (list (tuple :attribute 1 :module mod)
                        (tuple :attribute 2 :export (list (tuple :answer 0)))
                        (tuple :function 3 :answer 0
                          (list (tuple :clause 3 (list) (list) (list (tuple :integer 3 42))))))]
        (try
          (erlang/apply probe :with_search_dir (list dir (fn []
            (erlang/apply probe :with_declaration_snapshot (list (fn []
              (is (= false (erlang/apply probe :resolvable? (list ns))))
              (let [compiled (compile/forms forms (list :binary :return_errors))]
                (is (= :ok (first compiled)))
                (code/load_binary mod (erlang/binary_to_list "resolution-test") (erlang/element 3 compiled)))
              (is (= true (erlang/apply probe :resolvable? (list ns))))
              (drop! mod)
              (is (= false (erlang/apply probe :resolvable? (list ns))))))))))
          (finally (drop! mod))))
      (erlang/apply probe :with_search_dir (list dir (fn []
        (erlang/apply probe :with_declaration_snapshot (list (fn []
          (Process/put :bl_declaration_snapshot (into {} (mapv (fn [i] [i nil]) (range 4096))))
          (is (= false (erlang/apply probe :resolvable? (list ns))))
          (is (= 4096 (erlang/map_size (Process/get :bl_declaration_snapshot))))))))))
      (is (try (erlang/apply probe :with_declaration_snapshot
                 (list (fn [] (throw :snapshot-fault)))) false
               (catch _ true)))
      (is (nil? (Process/get :bl_declaration_snapshot)))
      (finally (drop! probe) (File/rm_rf! dir) (File/rm_rf! other)))))
