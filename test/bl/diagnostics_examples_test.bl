(ns diagnostics.examples.test (:require [bl.doc :as doc]))

(deftest documented-results-and-standalone-programs-reproduce
  (let [token (BeamLisp.Env/capture)
        root (if (File/exists? "docs/diagnostics.bl.md") (BeamLisp/cwd) (System/get_env "BL_ROOT"))]
    (try
      (doseq [relative ["docs/diagnostics.bl.md" "docs/proc-diagnostics.bl.md"]]
        (let [checked (doc/run-and-write! (Path/join root relative) {:check? true})]
          (is (nil? (:error checked)))
          (is (empty? (:errors checked)))
          (is (not (:drift checked)))))
      (let [result (BeamLisp/run_file (Path/join root "examples/diagnostics/01-api.bl"))]
        (is (= 42 (:result result)))
        (is (= 5 (count (:events result))))
        (is (= {} (:context-after result))))
      (let [result (BeamLisp/run_file (Path/join root "examples/diagnostics/02-proc.bl"))]
        (is (= {:ok 42} (get-in result [:outcomes :returned])))
        (is (= {:timeout true} (get-in result [:outcomes :timed-out]))))
      (let [result (BeamLisp/run_file (Path/join root "examples/diagnostics/03-queue.bl"))]
        (is (= :new-result (:final-result result)))
        (is (some #(= :lost (:proc.queue/settlement %)) (:events result))))
      (let [result (BeamLisp/run_file (Path/join root "examples/diagnostics/04-delivery.bl"))]
        (is (= {:accepted 2 :written 2 :failed 0 :pending 0} (:delivery result))))
      (let [result (BeamLisp/run_file (Path/join root "examples/diagnostics/05-pipeline.bl"))]
        (is (= {:completed [1 2] :failure :transport} result)))
      (finally (BeamLisp.Env/bind token)))))
