; test/bl/seed_host_inventory_test.bl — test.seed-host-inventory.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-host-inventory
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-pinned-host-sources-are-explicit
  ;; A table, not a sweep: each pinned leaf names the EXACT module its source
  ;; becomes. All seventy-one are asserted, or a leaf could be added (or dropped)
  ;; while the floor still claimed the set it was built with. The struct-field
  ;; and behaviour mappings are pinned too, because they are the options that
  ;; decide what surface a pinned beam has: a struct module
  ;; (`Delay`/`Derived`/`Set`/`SeqCursor`/`Vector`/`LazySeq`/`Decimal`, and the
  ;; five reference-cell types `Atom`/`Volatile`/`Reduced`/`Promise`/`Future`
  ;; that share ONE source), a MACRO
  ;; module (`Decimal`, `Guards` and `ExUnitCase`, through the table's THREE
  ;; `:macro-exports` entries — `is_decimal/1`, the guards' three
  ;; `is_bl_map/1`/`is_ref_type/1`/`is_data_tuple/1`, and ExUnitCase's
  ;; `__using__/1`), a
  ;; behaviour module (`WebSocket`, `Application`, `Loader.Server`, `ReloadWatcher` and the
  ;; exception types), or
  ;; functions-only (`Deferred`/`Reactive`, the `Enumerable`/`Inspect` impls,
  ;; `Inspect.Decimal`, the reference runtime `Refs`, the metadata pair
  ;; `Meta`/`FormMeta` with `Num`, the runtime seams `AtomGuard`/`Transient`, and the `Sorted` family — `Sorted` itself plus the two hand-written struct types `SortedMap`/`SortedSet`, which carry no `:struct_fields` because the pinned SOURCE spells the struct surface out and the opt would collide, the appended tree-builder `Supervisor` and port driver `Z3Port`, and the appended open-dispatch engine `Multi` and `defserver` runtime `Server`, and the appended `Guards` macro module and functions-only `Record` factory, and the appended bounded-tracing `Trace` and live-reload `ReloadWatcher` GenServer, and the appended test-harness leaves — the test-only ANF oracle `AnfInterpreter`, the harness `Sandbox`, public editor `DevChange`, BL runner `TestRT`, and ExUnit-facing `Test.realize` helper).
  (let [hs (seed/host-sources "priv/host")]
    (is (= 71 (count hs)) "six preboot leaves (AOT, AOTCache, Bootstrap, Env, Loader, Launcher) join the substrate four, the Delay/Deferred, Derived/Reactive, Set/SetEnumerable and SeqCursor/SeqCursorEnumerable pairs, the Vector/VectorEnumerable pair, the lazy native facade LazyMemo before the LazySeq quartet of ForceError, LazySeq, LazySeqEnumerable and LazySeqInspect, the WebSocket and Application behaviour modules, the Meta/FormMeta metadata pair beside Num, the Reader/Compiler front doors with the reader's two exception types, the compiler's CompileError beside the thrown ExInfo, and the runtime seams AtomGuard with its LimitError beside Transient, and the Sorted family — the functions-only Sorted with its two hand-written struct types SortedMap and SortedSet, and the exact-decimal pair — the pinned struct Decimal with its :struct-fields beside the THREE :macro-exports in the table — Decimal's is_decimal/1, Guards' three guard macros and ExUnitCase's __using__/1, and the functions-only Inspect.Decimal, and the reference runtime — the five bare struct types Atom, Volatile, Reduced, Promise and Future sharing ONE source refs_structs.bl at five exact atoms, beside the functions-only Refs, and the pinned Loader.Server GenServer carrying :behaviour, and the appended Supervisor tree-builder and Z3Port port driver, both functions-only, and the appended Multi open-dispatch engine and Server defserver runtime, both functions-only, and the appended Guards macro module and functions-only Record type factory, and the appended bounded-tracing Trace and live-reload ReloadWatcher GenServer, and the appended test-harness trio — the test-only ANF oracle AnfInterpreter, the harness Sandbox, and the ExUnitCase macro module whose :macro-exports is the table's THIRD, plus the functions-only DevChange public editor, TestRT registry/runner, and ExUnit-facing Test.realize helper")
    (is (= ["Elixir.BeamLisp" "Elixir.BeamLisp.AOT" "Elixir.BeamLisp.AOTCache" "Elixir.BeamLisp.AnfInterpreter" "Elixir.BeamLisp.Application" "Elixir.BeamLisp.Atom" "Elixir.BeamLisp.AtomGuard" "Elixir.BeamLisp.AtomGuard.LimitError" "Elixir.BeamLisp.Bootstrap" "Elixir.BeamLisp.BuildPlan" "Elixir.BeamLisp.CompileError" "Elixir.BeamLisp.Compiler" "Elixir.BeamLisp.CompilerData" "Elixir.BeamLisp.Decimal" "Elixir.BeamLisp.Deferred" "Elixir.BeamLisp.Delay" "Elixir.BeamLisp.Derived" "Elixir.BeamLisp.DevChange" "Elixir.BeamLisp.Emit" "Elixir.BeamLisp.Env" "Elixir.BeamLisp.ExInfo" "Elixir.BeamLisp.ExUnitCase" "Elixir.BeamLisp.FormMeta" "Elixir.BeamLisp.Future" "Elixir.BeamLisp.Guards" "Elixir.BeamLisp.Launcher" "Elixir.BeamLisp.LazyMemo" "Elixir.BeamLisp.LazySeq" "Elixir.BeamLisp.LazySeq.ForceError" "Elixir.BeamLisp.Link" "Elixir.BeamLisp.Loader" "Elixir.BeamLisp.Loader.Server" "Elixir.BeamLisp.Meta" "Elixir.BeamLisp.Multi" "Elixir.BeamLisp.NamespaceInterface" "Elixir.BeamLisp.Num" "Elixir.BeamLisp.Optimize" "Elixir.BeamLisp.PackageAuthority" "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Reactive" "Elixir.BeamLisp.Reader" "Elixir.BeamLisp.Reader.AtomLimitError" "Elixir.BeamLisp.Reader.SyntaxError" "Elixir.BeamLisp.Record" "Elixir.BeamLisp.Reduced" "Elixir.BeamLisp.Refs" "Elixir.BeamLisp.ReloadWatcher" "Elixir.BeamLisp.Sandbox" "Elixir.BeamLisp.SeqCursor" "Elixir.BeamLisp.Server" "Elixir.BeamLisp.Set" "Elixir.BeamLisp.Sorted" "Elixir.BeamLisp.Sorted.SortedMap" "Elixir.BeamLisp.Sorted.SortedSet" "Elixir.BeamLisp.SourceGraph" "Elixir.BeamLisp.Supervisor" "Elixir.BeamLisp.Test" "Elixir.BeamLisp.TestRT" "Elixir.BeamLisp.Tiers" "Elixir.BeamLisp.Trace" "Elixir.BeamLisp.Transient" "Elixir.BeamLisp.Vector" "Elixir.BeamLisp.Volatile" "Elixir.BeamLisp.WebSocket" "Elixir.BeamLisp.Z3Port" "Elixir.Enumerable.BeamLisp.LazySeq" "Elixir.Enumerable.BeamLisp.SeqCursor" "Elixir.Enumerable.BeamLisp.Set" "Elixir.Enumerable.BeamLisp.Vector" "Elixir.Inspect.BeamLisp.Decimal" "Elixir.Inspect.BeamLisp.LazySeq"]
           (s/sorted (map (fn [e] (str (:module e))) hs))))
    (is (= ["priv/host/anf_interpreter.bl" "priv/host/aot.bl" "priv/host/aot_cache.bl" "priv/host/application.bl" "priv/host/atom_guard.bl" "priv/host/atom_guard_limit_error.bl" "priv/host/beam_lisp.bl" "priv/host/bootstrap.bl" "priv/host/build_plan.bl" "priv/host/compile_error.bl" "priv/host/compiler.bl" "priv/host/compiler_data.bl" "priv/host/decimal.bl" "priv/host/decimal_inspect.bl" "priv/host/deferred.bl" "priv/host/delay.bl" "priv/host/derived.bl" "priv/host/dev_change.bl" "priv/host/emit.bl" "priv/host/env.bl" "priv/host/ex_info.bl" "priv/host/ex_unit_case.bl" "priv/host/form_meta.bl" "priv/host/guards.bl" "priv/host/launcher.bl" "priv/host/lazy_memo.bl" "priv/host/lazy_seq.bl" "priv/host/lazy_seq_enumerable.bl" "priv/host/lazy_seq_force_error.bl" "priv/host/lazy_seq_inspect.bl" "priv/host/link.bl" "priv/host/loader.bl" "priv/host/loader_server.bl" "priv/host/meta.bl" "priv/host/multi.bl" "priv/host/ns_interface.bl" "priv/host/num.bl" "priv/host/optimize.bl" "priv/host/package_authority.bl" "priv/host/reactive.bl" "priv/host/reader.bl" "priv/host/reader_exception.bl" "priv/host/reader_exception.bl" "priv/host/record.bl" "priv/host/refs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/refs_structs.bl" "priv/host/reload_watcher.bl" "priv/host/sandbox.bl" "priv/host/seq_cursor.bl" "priv/host/seq_cursor_enumerable.bl" "priv/host/server.bl" "priv/host/set.bl" "priv/host/set_enumerable.bl" "priv/host/sorted.bl" "priv/host/sorted_map.bl" "priv/host/sorted_set.bl" "priv/host/source_graph.bl" "priv/host/supervisor.bl" "priv/host/test_helper.bl" "priv/host/test_rt.bl" "priv/host/tiers.bl" "priv/host/trace.bl" "priv/host/transient.bl" "priv/host/vector.bl" "priv/host/vector_enumerable.bl" "priv/host/web_socket.bl" "priv/host/z3_port.bl"]
           (s/sorted (map (fn [e] (:source e)) hs))))
    (is (= ["Elixir.BeamLisp.AOT.beam" "Elixir.BeamLisp.AOTCache.beam" "Elixir.BeamLisp.AnfInterpreter.beam" "Elixir.BeamLisp.Application.beam" "Elixir.BeamLisp.Atom.beam" "Elixir.BeamLisp.AtomGuard.LimitError.beam" "Elixir.BeamLisp.AtomGuard.beam" "Elixir.BeamLisp.Bootstrap.beam" "Elixir.BeamLisp.BuildPlan.beam" "Elixir.BeamLisp.CompileError.beam" "Elixir.BeamLisp.Compiler.beam" "Elixir.BeamLisp.CompilerData.beam" "Elixir.BeamLisp.Decimal.beam" "Elixir.BeamLisp.Deferred.beam" "Elixir.BeamLisp.Delay.beam" "Elixir.BeamLisp.Derived.beam" "Elixir.BeamLisp.DevChange.beam" "Elixir.BeamLisp.Emit.beam" "Elixir.BeamLisp.Env.beam" "Elixir.BeamLisp.ExInfo.beam" "Elixir.BeamLisp.ExUnitCase.beam" "Elixir.BeamLisp.FormMeta.beam" "Elixir.BeamLisp.Future.beam" "Elixir.BeamLisp.Guards.beam" "Elixir.BeamLisp.Launcher.beam" "Elixir.BeamLisp.LazyMemo.beam" "Elixir.BeamLisp.LazySeq.ForceError.beam" "Elixir.BeamLisp.LazySeq.beam" "Elixir.BeamLisp.Link.beam" "Elixir.BeamLisp.Loader.Server.beam" "Elixir.BeamLisp.Loader.beam" "Elixir.BeamLisp.Meta.beam" "Elixir.BeamLisp.Multi.beam" "Elixir.BeamLisp.NamespaceInterface.beam" "Elixir.BeamLisp.Num.beam" "Elixir.BeamLisp.Optimize.beam" "Elixir.BeamLisp.PackageAuthority.beam" "Elixir.BeamLisp.Promise.beam" "Elixir.BeamLisp.Reactive.beam" "Elixir.BeamLisp.Reader.AtomLimitError.beam" "Elixir.BeamLisp.Reader.SyntaxError.beam" "Elixir.BeamLisp.Reader.beam" "Elixir.BeamLisp.Record.beam" "Elixir.BeamLisp.Reduced.beam" "Elixir.BeamLisp.Refs.beam" "Elixir.BeamLisp.ReloadWatcher.beam" "Elixir.BeamLisp.Sandbox.beam" "Elixir.BeamLisp.SeqCursor.beam" "Elixir.BeamLisp.Server.beam" "Elixir.BeamLisp.Set.beam" "Elixir.BeamLisp.Sorted.SortedMap.beam" "Elixir.BeamLisp.Sorted.SortedSet.beam" "Elixir.BeamLisp.Sorted.beam" "Elixir.BeamLisp.SourceGraph.beam" "Elixir.BeamLisp.Supervisor.beam" "Elixir.BeamLisp.Test.beam" "Elixir.BeamLisp.TestRT.beam" "Elixir.BeamLisp.Tiers.beam" "Elixir.BeamLisp.Trace.beam" "Elixir.BeamLisp.Transient.beam" "Elixir.BeamLisp.Vector.beam" "Elixir.BeamLisp.Volatile.beam" "Elixir.BeamLisp.WebSocket.beam" "Elixir.BeamLisp.Z3Port.beam" "Elixir.BeamLisp.beam" "Elixir.Enumerable.BeamLisp.LazySeq.beam" "Elixir.Enumerable.BeamLisp.SeqCursor.beam" "Elixir.Enumerable.BeamLisp.Set.beam" "Elixir.Enumerable.BeamLisp.Vector.beam" "Elixir.Inspect.BeamLisp.Decimal.beam" "Elixir.Inspect.BeamLisp.LazySeq.beam"]
           (s/sorted (map (fn [e] (seed/host-beam e)) hs))))
    (let [by-mod (fn [m] (first (filter (fn [e] (= (str (:module e)) m)) hs)))]
      (is (= (list (tuple :seq nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Delay")))
          "Delay carries the :seq struct field the pinned beam synthesizes")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Deferred")))
          "Deferred is functions-only: no :struct_fields opt")
      (is (= (list (tuple :cell nil) (tuple :deps nil) (tuple :thunk nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Derived")))
          "Derived carries the :cell/:deps/:thunk struct fields, in that order")
      (is (= (list (tuple :members nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Set")))
          "Set carries the :members struct field")
      (is (= (list (tuple :chunk ()) (tuple :tail nil) (tuple :dirty false))
             (:struct-fields (by-mod "Elixir.BeamLisp.SeqCursor")))
          "SeqCursor carries the :chunk/:tail/:dirty struct fields, in that order, with :chunk defaulting to the RAW Erlang empty list")
      (is (= (list (tuple :items (erlang/list_to_tuple (list))) (tuple :meta nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Vector")))
          "Vector carries the :items/:meta struct fields, :items defaulting to the RAW Erlang empty tuple")
      (is (nil? (:struct-fields (by-mod "Elixir.Enumerable.BeamLisp.Vector")))
          "Enumerable.Vector is functions-only: no :struct_fields opt")
      (is (= (list (tuple :__exception__ true) (tuple :reason nil) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.LazySeq.ForceError")))
          "LazySeq.ForceError carries the defexception [:reason, :message] struct fields, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.LazySeq.ForceError")))
          "LazySeq.ForceError records -behaviour(Exception)")
      (is (= (list (tuple :resource nil) (tuple :metadata nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.LazySeq")))
          "LazySeq carries the :resource/:metadata struct fields in declaration order")
      (is (nil? (:struct-fields (by-mod "Elixir.Enumerable.BeamLisp.LazySeq")))
          "Enumerable.LazySeq is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.Inspect.BeamLisp.LazySeq")))
          "Inspect.LazySeq is functions-only: no :struct_fields opt")
      (is (= :"Elixir.WebSock" (:behaviour (by-mod "Elixir.BeamLisp.WebSocket")))
          "WebSocket carries the :behaviour opt so its pinned beam records -behaviour(WebSock)")
      (is (= :"Elixir.Application" (:behaviour (by-mod "Elixir.BeamLisp.Application")))
          "Application carries the :behaviour opt so its pinned beam records -behaviour(Application)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Application")))
          "Application is functions-only: no :struct_fields opt")
      (is (= (list (tuple :__exception__ true) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Reader.SyntaxError")))
          "Reader.SyntaxError carries the defexception [:message] struct fields, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.Reader.SyntaxError")))
          "Reader.SyntaxError records -behaviour(Exception)")
      (is (= (list (tuple :__exception__ true) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Reader.AtomLimitError")))
          "Reader.AtomLimitError carries the SAME struct fields, from the SAME source")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.Reader.AtomLimitError")))
          "Reader.AtomLimitError records -behaviour(Exception)")
      (is (= (:source (by-mod "Elixir.BeamLisp.Reader.SyntaxError"))
             (:source (by-mod "Elixir.BeamLisp.Reader.AtomLimitError")))
          "the two exceptions share ONE source: the mapping is a table, not deduped by source path")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Reader")))
          "Reader is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Compiler")))
          "Compiler is functions-only: no :struct_fields opt")
      (is (= (list (tuple :__exception__ true) (tuple :message nil)
                   (tuple :file nil) (tuple :line nil) (tuple :form nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.CompileError")))
          "CompileError carries the defexception [:message, :file, :line, :form] struct fields in DECLARATION order, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.CompileError")))
          "CompileError records -behaviour(Exception)")
      (is (= (list (tuple :__exception__ true) (tuple :message nil) (tuple :data nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.ExInfo")))
          "ExInfo carries the defexception [:message, :data] struct fields in DECLARATION order, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.ExInfo")))
          "ExInfo records -behaviour(Exception)")
      (is (= (list (tuple :__exception__ true) (tuple :message nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.AtomGuard.LimitError")))
          "AtomGuard.LimitError carries the defexception [:message] struct fields, :__exception__ first")
      (is (= :"Elixir.Exception" (:behaviour (by-mod "Elixir.BeamLisp.AtomGuard.LimitError")))
          "AtomGuard.LimitError records -behaviour(Exception)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.AtomGuard")))
          "AtomGuard is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Transient")))
          "Transient is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Sorted")))
          "Sorted is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Sorted.SortedMap")))
          "SortedMap writes __struct__/0,1 and __info__/1 by HAND, so the mapping carries NO :struct_fields — the opt would collide with the hand-written surface")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Sorted.SortedSet")))
          "SortedSet writes __struct__/0,1 and __info__/1 by HAND, so the mapping carries NO :struct_fields — the opt would collide with the hand-written surface")
      (is (= (list (tuple :unscaled 0) (tuple :scale 0))
             (:struct-fields (by-mod "Elixir.BeamLisp.Decimal")))
          "Decimal carries the :unscaled/:scale struct fields the pinned beam synthesizes, in that order")
      (is (= (list (tuple :is_decimal 1))
             (:macro-exports (by-mod "Elixir.BeamLisp.Decimal")))
          "Decimal is one of the THREE entries declaring :macro-exports: is_decimal/1, the defguard as a require-able macro")
      (is (= (list (tuple :is_bl_map 1) (tuple :is_ref_type 1) (tuple :is_data_tuple 1))
             (:macro-exports (by-mod "Elixir.BeamLisp.Guards")))
          "Guards is the second of the three: its three defguards as require-able macros, in declaration order")
      (is (= (list (tuple :__using__ 1))
             (:macro-exports (by-mod "Elixir.BeamLisp.ExUnitCase")))
          "ExUnitCase is the third: __using__/1, the public `use` a caller's test module expands, as a require-able macro over the MACRO-__using__/2 implementer its source carries")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Guards")))
          "Guards is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Guards")))
          "Guards records no -behaviour")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Record")))
          "Record is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Record")))
          "Record records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Record")))
          "Record declares no :macro-exports: the factory has no compile-time artifact")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Trace")))
          "Trace is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Trace")))
          "Trace records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Trace")))
          "Trace declares no :macro-exports either")
      (is (= :"Elixir.GenServer" (:behaviour (by-mod "Elixir.BeamLisp.ReloadWatcher")))
          "ReloadWatcher carries the :behaviour opt so its pinned beam records -behaviour(GenServer)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.ReloadWatcher")))
          "ReloadWatcher is functions-only: no :struct_fields opt")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.ReloadWatcher")))
          "ReloadWatcher declares no :macro-exports either")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Deferred")))
          "an entry with no :macro-exports carries no such key, so its option list is unchanged")
      (is (nil? (:struct-fields (by-mod "Elixir.Inspect.BeamLisp.Decimal")))
          "Inspect.Decimal is functions-only: no :struct_fields opt")
      (is (nil? (:macro-exports (by-mod "Elixir.Inspect.BeamLisp.Decimal")))
          "Inspect.Decimal declares no :macro-exports either")
      (is (= (list (tuple :cell nil) (tuple :watches nil))
             (:struct-fields (by-mod "Elixir.BeamLisp.Atom")))
          "Atom carries the :cell/:watches struct fields the pinned beam synthesizes, in that order")
      (is (= (list (tuple :key nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Volatile")))
          "Volatile carries the :key struct field")
      (is (= (list (tuple :value nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Reduced")))
          "Reduced carries the :value struct field")
      (is (= (list (tuple :pid nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Promise")))
          "Promise carries the :pid struct field")
      (is (= (list (tuple :task nil)) (:struct-fields (by-mod "Elixir.BeamLisp.Future")))
          "Future carries the :task struct field")
      (is (s/has? (map (fn [m] (str (:source (by-mod m))))
                     ["Elixir.BeamLisp.Volatile" "Elixir.BeamLisp.Reduced"
                      "Elixir.BeamLisp.Promise" "Elixir.BeamLisp.Future"])
                 (str (:source (by-mod "Elixir.BeamLisp.Atom"))))
          "the five refs types share ONE source (refs_structs.bl): the mapping maps ENTRIES, not sources, and no source path is deduped")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Refs")))
          "Refs is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Refs")))
          "Refs records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Refs")))
          "Refs declares no :macro-exports either")
      (is (= :"Elixir.GenServer" (:behaviour (by-mod "Elixir.BeamLisp.Loader.Server")))
          "Loader.Server carries the :behaviour opt so its pinned beam records -behaviour(GenServer)")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Loader.Server")))
          "Loader.Server is functions-only: no :struct_fields opt")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Supervisor")))
          "Supervisor is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Supervisor")))
          "Supervisor records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Supervisor")))
          "Supervisor declares no :macro-exports either")
      (is (nil? (:struct-fields (by-mod "Elixir.BeamLisp.Z3Port")))
          "Z3Port is functions-only: no :struct_fields opt")
      (is (nil? (:behaviour (by-mod "Elixir.BeamLisp.Z3Port")))
          "Z3Port records no -behaviour")
      (is (nil? (:macro-exports (by-mod "Elixir.BeamLisp.Z3Port")))
          "Z3Port declares no :macro-exports either"))
    (is (= ["Elixir.BeamLisp.Application" "Elixir.BeamLisp.AtomGuard.LimitError" "Elixir.BeamLisp.CompileError" "Elixir.BeamLisp.ExInfo" "Elixir.BeamLisp.LazySeq.ForceError" "Elixir.BeamLisp.Loader.Server" "Elixir.BeamLisp.Reader.AtomLimitError" "Elixir.BeamLisp.Reader.SyntaxError" "Elixir.BeamLisp.ReloadWatcher" "Elixir.BeamLisp.WebSocket"]
           (s/sorted (keep (fn [e] (if (some? (:behaviour e)) (str (:module e)) nil)) hs)))
        "Application, WebSocket, Loader.Server, ReloadWatcher, LazySeq.ForceError and the five exception types (the reader's two, CompileError, ExInfo and AtomGuard.LimitError) are the ONLY entries that record a behaviour; every other beam is behaviour-free")
    (doseq [m ["Elixir.BeamLisp.CompilerData" "Elixir.BeamLisp.Emit" "Elixir.BeamLisp.Link" "Elixir.BeamLisp.Tiers"
               "Elixir.BeamLisp.Reactive" "Elixir.BeamLisp.LazyMemo" "Elixir.Enumerable.BeamLisp.Set" "Elixir.Enumerable.BeamLisp.SeqCursor" "Elixir.Enumerable.BeamLisp.Vector" "Elixir.Enumerable.BeamLisp.LazySeq" "Elixir.Inspect.BeamLisp.LazySeq" "Elixir.Inspect.BeamLisp.Decimal"
               "Elixir.BeamLisp.Meta" "Elixir.BeamLisp.FormMeta" "Elixir.BeamLisp.Num"
               "Elixir.BeamLisp.Application" "Elixir.BeamLisp.Reader" "Elixir.BeamLisp.Compiler"
               "Elixir.BeamLisp.AtomGuard" "Elixir.BeamLisp.Transient" "Elixir.BeamLisp.Refs" "Elixir.BeamLisp.Loader.Server" "Elixir.BeamLisp.Sorted" "Elixir.BeamLisp.Sorted.SortedMap" "Elixir.BeamLisp.Sorted.SortedSet" "Elixir.BeamLisp.Supervisor" "Elixir.BeamLisp.Z3Port" "Elixir.BeamLisp.Multi" "Elixir.BeamLisp.Server" "Elixir.BeamLisp.Guards" "Elixir.BeamLisp.Record" "Elixir.BeamLisp.Trace" "Elixir.BeamLisp.ReloadWatcher" "Elixir.BeamLisp.AnfInterpreter" "Elixir.BeamLisp.Sandbox" "Elixir.BeamLisp.ExUnitCase" "Elixir.BeamLisp.DevChange" "Elixir.BeamLisp.TestRT" "Elixir.BeamLisp.Test" "Elixir.BeamLisp"]]
      (is (nil? (:struct-fields (first (filter (fn [e] (= (str (:module e)) m)) hs))))
          (str m " stays functions-only")))))

(deftest the-host-inventory-is-the-mapping-in-table-order
  ;; The manifest's `hosts` list is written from the mapping, so its order is the
  ;; TABLE's — reproducible, not a map's iteration order — because it is an
  ;; inventory a reader (and `Bootstrap`) compares against the mapping. A
  ;; consumer selecting host beams from it gets the same set on every read.
  (let [hs (seed/host-sources "priv/host")]
    (is (= (seed/host-names hs) (vec (map (fn [e] (seed/host-beam e)) hs)))
        "host-names is host-beam over the mapping, in table order")
    (is (= (count hs) (count (seed/host-names hs))))
    (is (= ["Elixir.BeamLisp.AOT.beam"
            "Elixir.BeamLisp.AOTCache.beam"
            "Elixir.BeamLisp.Bootstrap.beam"
            "Elixir.BeamLisp.Env.beam"
            "Elixir.BeamLisp.Loader.beam"
            "Elixir.BeamLisp.Launcher.beam"
            "Elixir.BeamLisp.CompilerData.beam"
            "Elixir.BeamLisp.SourceGraph.beam"
            "Elixir.BeamLisp.NamespaceInterface.beam"
            "Elixir.BeamLisp.BuildPlan.beam"
            "Elixir.BeamLisp.Emit.beam"
            "Elixir.BeamLisp.Optimize.beam"
            "Elixir.BeamLisp.Link.beam"
            "Elixir.BeamLisp.Tiers.beam"
            "Elixir.BeamLisp.Delay.beam"
            "Elixir.BeamLisp.Deferred.beam"
            "Elixir.BeamLisp.Derived.beam"
            "Elixir.BeamLisp.Reactive.beam"
            "Elixir.BeamLisp.Set.beam"
            "Elixir.Enumerable.BeamLisp.Set.beam"
            "Elixir.BeamLisp.SeqCursor.beam"
            "Elixir.Enumerable.BeamLisp.SeqCursor.beam"
            "Elixir.BeamLisp.WebSocket.beam"
            "Elixir.BeamLisp.Meta.beam"
            "Elixir.BeamLisp.FormMeta.beam"
            "Elixir.BeamLisp.Num.beam"
            "Elixir.BeamLisp.Application.beam"
            "Elixir.BeamLisp.Reader.SyntaxError.beam"
            "Elixir.BeamLisp.Reader.AtomLimitError.beam"
            "Elixir.BeamLisp.Reader.beam"
            "Elixir.BeamLisp.Compiler.beam"
            "Elixir.BeamLisp.CompileError.beam"
            "Elixir.BeamLisp.ExInfo.beam"
            "Elixir.BeamLisp.AtomGuard.LimitError.beam"
            "Elixir.BeamLisp.AtomGuard.beam"
            "Elixir.BeamLisp.Transient.beam"
            "Elixir.BeamLisp.Vector.beam"
            "Elixir.Enumerable.BeamLisp.Vector.beam"
            "Elixir.BeamLisp.LazyMemo.beam"
            "Elixir.BeamLisp.LazySeq.ForceError.beam"
            "Elixir.BeamLisp.LazySeq.beam"
            "Elixir.Enumerable.BeamLisp.LazySeq.beam"
            "Elixir.Inspect.BeamLisp.LazySeq.beam"
            "Elixir.BeamLisp.Sorted.beam"
            "Elixir.BeamLisp.Sorted.SortedMap.beam"
            "Elixir.BeamLisp.Sorted.SortedSet.beam"
            "Elixir.BeamLisp.Decimal.beam"
            "Elixir.Inspect.BeamLisp.Decimal.beam"
            "Elixir.BeamLisp.Atom.beam"
            "Elixir.BeamLisp.Volatile.beam"
            "Elixir.BeamLisp.Reduced.beam"
            "Elixir.BeamLisp.Promise.beam"
            "Elixir.BeamLisp.Future.beam"
            "Elixir.BeamLisp.Refs.beam"
            "Elixir.BeamLisp.Loader.Server.beam"
            "Elixir.BeamLisp.Supervisor.beam"
            "Elixir.BeamLisp.Z3Port.beam"
            "Elixir.BeamLisp.Multi.beam"
            "Elixir.BeamLisp.Server.beam"
            "Elixir.BeamLisp.Guards.beam"
            "Elixir.BeamLisp.Record.beam"
            "Elixir.BeamLisp.Trace.beam"
            "Elixir.BeamLisp.ReloadWatcher.beam"
            "Elixir.BeamLisp.AnfInterpreter.beam"
            "Elixir.BeamLisp.Sandbox.beam"
            "Elixir.BeamLisp.ExUnitCase.beam" "Elixir.BeamLisp.DevChange.beam" "Elixir.BeamLisp.TestRT.beam" "Elixir.BeamLisp.Test.beam" "Elixir.BeamLisp.beam" "Elixir.BeamLisp.PackageAuthority.beam"]
           (seed/host-names hs))
        "the table order is explicit, not sorted")))
