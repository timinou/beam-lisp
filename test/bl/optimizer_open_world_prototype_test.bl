; Normal-source open-world adversaries. Helper implementations remain unknown
; to fusion; a compiled caller must observe later body and binding changes.
(ns optimizer.open-world.prototype.test
  (:require [optimize :as o] [anf :as a] [compiler :as c] [lower :as l]))

(defn- unique-name [stem]
  (str stem (erlang/unique_integer (list :positive))))

(defn- descriptor [mod source]
  (c/reset-fresh!)
  (a/module mod
    (list {:op :defn-clause :fname :run :params '() :guard nil
           :body (c/compile-node (BeamLisp.Reader/read_one source) (c/new-env "user")) :ann {}})
    (list [:run 0]) '()))

(defn- emit [desc enabled]
  (let [pair (l/descriptor->beam desc {:enabled? enabled})]
    (is (= (tuple :module (elem pair 0)) (code/load_binary (elem pair 0) '() (elem pair 1))))
    (elem pair 0)))

(defn- caller [source enabled]
  (emit (descriptor (erlang/binary_to_atom (unique-name "Elixir.OptimizerWorld.Caller")) source) enabled))

(defn- run [mod] (erlang/apply mod :run '()))
(defn- outcome [mod]
  (try [:ok (run mod)] (catch-raw [kind reason stack] [kind reason])))

(defn- pipeline [ns]
  (str "(lists/foldl (fn [x a] (+ a x)) 0 "
       "(lists/map (fn [x] (+ x ((BeamLisp.Env/fetch! \"" ns "\" \"helper\")))) "
       "(lists/seq 0 4)))"))

(defn- fused? [desc]
  (some (fn [entry] (= :strict-map-fold (:rule entry))) (:evidence (o/explain desc))))

(deftest helper-body-only-replacement-is-observed-by-an-existing-caller
  (let [ns (unique-name "optimizer-world-")
        helper (erlang/binary_to_atom (unique-name "Elixir.OptimizerWorld.Helper"))
        source (pipeline ns)
        desc (descriptor (erlang/binary_to_atom (unique-name "Elixir.OptimizerWorld.Probe")) source)]
    (emit (descriptor helper "(+ 2 5)") true)
    (BeamLisp.Env/intern ns "helper" (fn [] (erlang/apply helper :run '())))
    (let [baseline (caller source false) optimized (caller source true)]
      (is (not (fused? desc)) "an opaque helper body is not a totality or stability proof")
      (is (= 45 (run baseline)))
      (is (= 45 (run optimized)))
      ; Same module, function and arity; only the emitted implementation changes.
      (emit (descriptor helper "(+ 2 9)") true)
      (is (= 65 (run baseline)))
      (is (= 65 (run optimized)))
      (code/purge helper)
      (emit (descriptor helper "(erlang/error :optimizer-world-failure)") true)
      (is (= :error (first (outcome baseline))))
      (is (= (outcome baseline) (outcome optimized))))))

(deftest global-callback-values-are-not-frozen-at-compilation
  (let [ns (unique-name "optimizer-world-binding-") source (pipeline ns)]
    (BeamLisp.Env/intern ns "helper" (fn [] 1))
    (let [baseline (caller source false) optimized (caller source true)]
      (is (= 15 (run baseline)))
      (is (= 15 (run optimized)))
      (BeamLisp.Env/intern ns "helper" (fn [] 10))
      (is (= 60 (run baseline)))
      (is (= 60 (run optimized))))))

(deftest a-mid-traversal-binding-change-is-observed-without-prefix-replay
  (let [ns (unique-name "optimizer-world-mid-")
        source (str "(lists/foldl (fn [x a] (+ a x)) 0 "
                    "(lists/map (fn [x] (do "
                    "((BeamLisp.Env/fetch! \"" ns "\" \"mark\") x) "
                    "(if (= x 2) (BeamLisp.Env/intern \"" ns "\" \"helper\" (fn [] 10))) "
                    "(+ x ((BeamLisp.Env/fetch! \"" ns "\" \"helper\"))))) (lists/seq 0 4)))")
        seen (atom [])]
    (BeamLisp.Env/intern ns "mark" (fn [x] (swap! seen conj x)))
    (BeamLisp.Env/intern ns "helper" (fn [] 1))
    (let [baseline (caller source false) optimized (caller source true)]
      (is (= 42 (run baseline)))
      (is (= [0 1 2 3 4] @seen))
      (reset! seen [])
      (BeamLisp.Env/intern ns "helper" (fn [] 1))
      (is (= 42 (run optimized)))
      (is (= [0 1 2 3 4] @seen))
      (is (not (fused? (descriptor (erlang/binary_to_atom (unique-name "Elixir.OptimizerWorld.MidProbe")) source)))))))

(deftest unavailable-proof-services-and-author-claims-cannot-authorize-unknowns
  (let [source "(fn [f xs] (lists/foldl f 0 (lists/map f xs)))"
        desc (descriptor (erlang/binary_to_atom (unique-name "Elixir.OptimizerWorld.Unknown")) source)
        normal (o/explain desc)
        claimed (o/explain desc {:solver :unavailable :solver-timeout 0
                                :verified true :pure true :facts {:f :total-integer}})]
    (is (= (:descriptor normal) (:descriptor claimed)))
    (is (= (:refusals normal) (:refusals claimed)))
    (is (not (fused? desc)))
    (is (seq (:refusals normal)))))
