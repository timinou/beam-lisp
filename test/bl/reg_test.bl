; test/bl/reg_test.bl — the registry as a CLAUSE: one form, a slice of one state.
; Run: bin/bl -p priv/std test --shared test/bl/reg_test.bl
;
; The registry was a macro that copied a whole `defserver`. A clause contributes
; its slice to a server's state instead, so the two things this file pins are:
;
;   · the declaration COMPOSES — a registry that also holds the author's own
;     state is one form with one `init` and one state, which is what a copied
;     body could never be;
;   · an impossible declaration is refused when the form is EXPANDED, with a
;     sentence, rather than at the first `register` nobody can read.
;
; The relation itself (register / whereis / where / retract on :DOWN) is
; unchanged behaviour, pinned here so the migration cannot quietly change it.

(ns reg.test
  (:require [proc :as proc]
            [proc.reg :as reg]))

;; ── the clause registry ─────────────────────────────────────────────────

(deftest the-registry-is-a-clause-of-the-one-server-form
  (is (some (fn [c] (= "registry" c)) (proc/registered-clauses))
      "`registry` is a clause of the one server form, not a form of its own"))

(deftest the-transform-returns-a-state-slice-and-the-down-handler
  ; The unit that turns a declaration into the relation — testable on its own,
  ; which is the whole difference between a clause and a copied body.
  (let [c (proc.reg/registry-clause '(registry (keys :id :node)) {:name 'x})]
    (is (some? (:init c)) "a registry CONTRIBUTES state; that is the composition")
    (is (= 6 (count (:clauses c))) "six calls including entries and bounded sample")
    (is (= 1 (count (:down c))) "and one :down handler, merged by the expander")
    (is (nil? (:prelude c)) "nothing to arm")))

(deftest an-impossible-declaration-is-refused-with-a-sentence
  (is (thrown? (proc.reg/registry-clause '(registry :id) {:name 'x}))
      "the keys are (keys …), not a bare keyword")
  (is (thrown? (proc.reg/registry-clause '(registry (keys :id) (keys :x)) {:name 'x}))
      "two keys clauses declare one registry twice")
  (is (thrown? (proc.reg/registry-clause '(registry (keys "id")) {:name 'x}))
      "a non-keyword key can never match an attribute map"))

;; ── the server: the clause composed with the author's own state ─────────

(proc/defserver workers
  (init [_] (ok {:own 0}))
  (registry (keys :id))
  (handle-call [:own] [_from st] (reply (:own st) st))
  (handle-call [:bump] [_from st] (reply (:own st) (assoc st :own (inc (:own st))))))

(deftest the-clause-composes-with-the-servers-own-state
  ; The reason the macro went away: two slices, one `init`, ONE state.
  (let [s (start workers nil {})]
    (is (= 0 (call s [:own])) "the author's own slice is there")
    (call s [:bump])
    (is (= :ok (proc.reg/register s (erlang/self) {:id 7})))
    (is (= (erlang/self) (proc.reg/whereis s {:id 7})) "the clause's slice is there TOO")
    (is (= 1 (call s [:own])) "…and neither slice overwrote the other")
    (stop s)))

(deftest an-entry-retracts-itself-when-the-pid-dies
  (let [s (start workers nil {})
        w (spawn (fn [] (receive [:stop] :ok)))]
    (is (= :ok (proc.reg/register s w {:id 1})))
    (is (= [w] (proc.reg/where s {})))
    (kill w)
    (Process/sleep 80)                    ; let the :DOWN land
    (is (nil? (proc.reg/whereis s {:id 1})) "the VM kept the relation true for us")
    (is (= 0 (call s [:own])) "…and the server's own slice is untouched by it")
    (stop s)))

(deftest an-undeclared-key-is-declined
  (let [s (start workers nil {})]
    (is (= :error (first (proc.reg/register s (erlang/self) {:oops 1}))))
    (stop s)))

(proc/defserver open-registry (registry))

(deftest a-registry-with-no-keys-clause-accepts-any-attribute
  (let [s (start open-registry nil {})]
    (is (= :ok (proc.reg/register s (erlang/self) {:whatever 1 :at-all 2})))
    (is (= (erlang/self) (proc.reg/whereis s {:at-all 2})))
    (stop s)))

(deftest bounded-indexed-sampling-preserves-registry-semantics
 (let [s (start workers nil {}) p (spawn (fn [] (receive :stop :ok))) q (spawn (fn [] (receive :stop :ok)))]
  (try
   (reg/register s p {:id 7}) (reg/register s q {:id 7})
   (let [sample (reg/sample s {:id 7} 1)]
    (is (= 2 (:total sample))) (is (= 1 (count (:entries sample))))
    (is (= 1 (:examined sample))) (is (:truncated sample)))
   (reg/register s p {:id 8})
   (is (= 1 (:total (reg/sample s {:id 7} 1))))
   (is (= p (:pid (first (:entries (reg/sample s {:id 8} 1))))))
   (reg/unregister s p)
   (is (= 0 (:total (reg/sample s {:id 8} 1))))
   (is (thrown? (reg/sample s {} 129)))
   (finally (kill p) (kill q) (stop s)))))

(deftest arbitrary-predicates-have-a-traversal-budget-and-unknown-total
 (let [st (assoc (reg/init-state []) :entries
            (into {} (map (fn [n] [n {:id n}]) (range 10000))))
       sample (reg/sample-entries st {:id -1} 8)]
  (is (= 4096 (:examined sample)))
  (is (nil? (:total sample)))
  (is (:truncated sample))
  (is (not (:complete sample)))
  (is (= [] (:entries sample)))))

(deftest declared-nil-and-replaced-attributes-have-the-same-query-meaning
 (let [pid (erlang/self)
       a (second (reg/register-entry (reg/init-state [:id]) pid {}))
       b (second (reg/register-entry a pid {:id 42}))
       c (reg/remove-entry b pid)]
  (is (= 1 (:total (reg/sample-entries a {:id nil} 1))))
  (is (= 0 (:total (reg/sample-entries b {:id nil} 1))))
  (is (= [pid] (mapv :pid (:entries (reg/sample-entries b {:id 42} 1)))))
  (is (= {} (:entries c)))
  (is (= {} (get-in c [:indexes :id])))
  (is (= (get-in a [:registry-monitors pid]) (get-in b [:registry-monitors pid])))
  (is (= {} (:registry-monitors c)))))
