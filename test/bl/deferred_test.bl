; test/bl/deferred_test.bl — delay / force / realized? / memoize.
; Run: mix beam_lisp.test test/bl/deferred_test.bl
;
; delay and memoize are the value-shaped face of the lazy memo cell. These
; tests pin the contracts a plausible implementation breaks silently: run-once,
; value returned as-is (not normalized to a seq), realized? state, one run per
; memo key, and shared-once evaluation under concurrent force.

(ns deferred.test)

(deftest delay-runs-body-once
  (let [n (atom 0)
        d (delay (do (swap! n inc) 42))]
    ; nothing runs until forced
    (is (= 0 @n))
    (is (= 42 (force d)))
    (is (= 42 (force d)))
    ; forced twice, body ran once
    (is (= 1 @n))))

(deftest delay-derefs-with-at
  (let [d (delay 7)]
    (is (= 7 @d))
    (is (= 7 @d))))

(deftest delay-returns-value-as-is
  ; a delay is NOT a sequence: its value comes back exactly as produced,
  ; a vector stays a vector rather than being normalized into a cons cell.
  (is (= [1 2 3] (force (delay [1 2 3]))))
  (is (= {:a 1} (force (delay {:a 1})))))

(deftest realized-tracks-state
  (let [d (delay 1)]
    (is (= false (realized? d)))
    (force d)
    (is (= true (realized? d))))
  ; a non-delay is trivially realized
  (is (= true (realized? 5))))

(deftest memoize-runs-once-per-key
  (let [calls (atom 0)
        f (memoize (fn [x] (swap! calls inc) (* x x)))]
    (is (= 25 (f 5)))
    (is (= 25 (f 5)))
    (is (= 36 (f 6)))
    ; two distinct keys, so exactly two runs
    (is (= 2 @calls))))

(deftest memoize-distinguishes-arity-and-values
  (let [calls (atom 0)
        f (memoize (fn [& xs] (swap! calls inc) (vec xs)))]
    (is (= [1 2] (f 1 2)))
    (is (= [1 2] (f 1 2)))
    (is (= [1] (f 1)))
    (is (= 2 @calls))))

(deftest delay-shares-under-concurrent-force
  ; N processes force ONE delay; the body must run exactly once, and every
  ; process must see the same answer. This is the herd protection the memo
  ; cell provides, inherited by delay for free.
  (let [runs (atom 0)
        d (delay (do (swap! runs inc)
                     ; widen the window so forces overlap
                     (Process/sleep 25)
                     :shared))
        tasks (vec (map (fn [_] (Task/async (fn [] (force d))))
                        (range 50)))
        results (map (fn [t] (Task/await t 5000)) tasks)]
    (is (every? (fn [r] (= :shared r)) results))
    (is (= 1 @runs))))
