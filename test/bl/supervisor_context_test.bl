(ns supervisor-context-test)
(defserver context-child
 (init [[provider]] (ok ((BeamLisp.Env/fetch_exact! provider "value"))))
 (handle-call :read [_from state] (reply state state)))
(defn- child [sup]
 (some (fn [row] (let [pid (elem row 1)] (when (erlang/is_pid pid) pid))) (DynamicSupervisor/which_children sup)))
(defn- wait-restart [sup previous]
 (loop [left 200]
  (let [pid (child sup)]
   (cond (and pid (not= pid previous)) pid
         (zero? left) nil
         :else (do (Process/sleep 5) (recur (dec left)))))))
(deftest dynamic-child-retains-spec-creators-bindings-through-restart
 (let [source (Path/join (BeamLisp/cwd) "priv/host/supervisor.bl")
       output (Path/join (System/tmp_dir!) (str "bl-supervisor-context-" (erlang/unique_integer (list :positive))))
       probe :Elixir.BeamLisp.SupervisorContextProbe
       compiled (BeamLisp.AOT/compile_host_file source
         (list (tuple :module probe) (tuple :output_dir output) (tuple :file source)
               (tuple :source_hash (crypto/hash :sha256 (File/read! source))) (tuple :load? false)))
       _ (code/load_binary probe (erlang/binary_to_list (elem compiled 1)) (File/read! (elem compiled 1)))
       sup (elem (DynamicSupervisor/start_link (list (tuple :strategy :one_for_one))) 1)
       caller (BeamLisp.Env/capture) owner (BeamLisp.Env/fork) provider "supervisor.context.owner"]
  (try
   (let [spec (BeamLisp.Env/with_env owner (fn []
                (BeamLisp.Env/declare_ns provider)
                (BeamLisp.Env/intern provider "value" (fn [] 42))
                (erlang/apply probe :server (list :context context-child [provider] {:restart :permanent}))))
         started (DynamicSupervisor/start_child sup spec)]
    (is (= caller (BeamLisp.Env/capture)))
    (is (= :ok (elem started 0)))
    (when (= :ok (elem started 0))
     (let [pid (elem started 1)]
      (is (= 42 (BeamLisp.Server/call pid :read)))
      (Process/exit pid :kill)
      (let [replacement (wait-restart sup pid)]
       (is (erlang/is_pid replacement))
       (when replacement (is (= 42 (BeamLisp.Server/call replacement :read))))))))
   (finally (Supervisor/stop sup) (BeamLisp.Env/destroy owner) (code/purge probe) (code/delete probe) (File/rm_rf! output)))))
