(ns startup-inventory-cache-test)

(defn- inventory [] (BeamLisp.Env/sdk_runtime_inventory_cached!))

(deftest unchanged-discovery-reuses-native-private-inventory
 ;; Warm byte-derived metadata and optional host dependencies before counting.
 (inventory) (inventory) (inventory)
 (let [trace (tuple :Elixir.BeamLisp.AOT :sdk_runtime_inventory_uncached! 1)]
  (erlang/trace_pattern trace true (list :local :call_count))
  (try
   (let [first (inventory) second (inventory)]
    (is (= first second))
    (is (= (tuple :call_count 0) (erlang/trace_info trace :call_count))
        "unchanged discovery does not repeat the complete import walk"))
   (finally (erlang/trace_pattern trace false (list :local :call_count))))))

(deftest unrelated-completed-publication-preserves-discovery
 (inventory) (inventory)
 (let [trace (tuple :Elixir.BeamLisp.AOT :sdk_runtime_inventory_uncached! 1)]
  (erlang/trace_pattern trace true (list :local :call_count))
  (try
   (BeamLisp.Env/with_code_evidence_publication (fn [] :ok))
   (inventory)
   (is (= (tuple :call_count 0) (erlang/trace_info trace :call_count))
       "a completed unrelated publication preserves SDK discovery")
   (finally (erlang/trace_pattern trace false (list :local :call_count))))))

(deftest source-validation-compares-bytes-even-with-preserved-mtime
 (let [root (str (System/tmp_dir!) "/startup-inventory-" (erlang/unique_integer (list :positive)))
       path (str root "/std/probe.bl")
       source "original source"
       proof (tuple {} {"std/probe.bl" (crypto/hash :sha256 source)})]
  (try
   (File/mkdir_p! (Path/dirname path))
   (File/write! path source)
   (let [before (File/stat! path)]
    (is (BeamLisp.Env/sdk_inventory_sources_current? root proof))
    (File/write! path "modified source")
    (File/touch! path (:mtime before))
    (is (not (BeamLisp.Env/sdk_inventory_sources_current? root proof)))
    (File/rm! path)
    (is (not (BeamLisp.Env/sdk_inventory_sources_current? root proof))))
   (finally (File/rm_rf! root)))))

(deftest initializer-refresh-without-emission-does-not-revalidate-the-sdk
 (BeamLisp.Env/retain_sdk_runtime!)
 (BeamLisp.Env/refresh_sdk_runtime!)
 (let [trace (tuple :Elixir.BeamLisp.Env :sdk_runtime_inventory_cached! 0)]
  (erlang/trace_pattern trace true (list :local :call_count))
  (try
   (doseq [_ (range 20)] (BeamLisp.Env/refresh_sdk_runtime!))
   (is (= (tuple :call_count 0) (erlang/trace_info trace :call_count))
       "no new receipt means no code to admit")
   (BeamLisp.Env/bump_sdk_receipt_revision!)
   (BeamLisp.Env/refresh_sdk_runtime!)
   (is (= (tuple :call_count 1) (erlang/trace_info trace :call_count))
       "new receipt revision takes the canonical verifier")
   (finally (erlang/trace_pattern trace false (list :local :call_count))))))
