; test/bl/bl_ask_test.bl — where `bl ask` keeps what it remembers.
; Run: bl test test/bl/bl_ask_test.bl
;
; `bl ask` is handed PATHs and answers questions about THOSE sources. Its caches
; are content-addressed, so where they land never changes an answer — but it
; decides who owns the artifact: whether deleting a project deletes its caches,
; and whether a run over a checkout elsewhere leaves them in the tree you
; happen to be standing in. `bl search` had exactly this defect (it pruned the
; shell's project while indexing another), and the same rule fixes it: the
; SOURCES decide, not the shell.

(ns bl.ask.test
  (:require [bl.cli] [bl.ask] [codebase] [typed] [datom]))

(defn- corpus!
  "A one-file project in a scratch directory: what makes it a project is the
   marker, so the store has a tree to belong to."
  []
  (let [root (str (System/tmp_dir!) "/bl_ask_" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p (str root "/src"))
    (File/write! (str root "/mix.exs") "")
    (File/write! (str root "/src/a.bl") "(ns demo.a)\n\n(defn bump [x] (inc x))\n")
    root))

(defn- count-in
  "Entries in a directory, or 0 when it is not there."
  [dir]
  (if (File/dir? dir) (count (File/ls! dir)) 0))

(deftest what-ask-remembers-lives-with-the-sources
  (let [saved (System/get_env "BL_CACHE_DIR")
        root (corpus!)
        mine (str root "/.local/bl/cache")
        here (str (BeamLisp/cwd) "/.local/bl/cache")]
    (System/delete_env "BL_CACHE_DIR")
    (let [before (count-in here)
          code (bl.cli/run-argv ["ask" "arity-mismatches" root])
          after (count-in here)]
      (if (nil? saved)
        (System/delete_env "BL_CACHE_DIR")
        (System/put_env "BL_CACHE_DIR" saved))
      (is (zero? code) "the question is answerable")
      (is (pos? (count-in mine)) "what it remembered lives with the sources")
      (is (= before after) "…and not with the shell that asked")
      (File/rm_rf! root))))

(deftest a-source-question-caches-its-analysis-with-the-sources
  ; `symbols` and `dead-code` answer from an ANALYSIS of the source text
  ; (lsp/document-symbols), not from the indexer's facts — and that analysis is
  ; ~2 s a file. A question asked twice over the same text must pay for it once,
  ; and the result must live with the sources the question was asked about.
  (let [saved (System/get_env "BL_CACHE_DIR")
        root (corpus!)
        mine (str root "/.local/bl/cache")
        analyses (fn []
                   (if (File/dir? mine)
                     (into #{} (filter (fn [f] (starts-with? f "symbols."))
                                       (File/ls! mine)))
                     #{}))]
    (System/delete_env "BL_CACHE_DIR")
    (let [code (bl.cli/run-argv ["ask" "symbols" root])
          first-run (analyses)
          again (bl.cli/run-argv ["ask" "symbols" root])
          second-run (analyses)]
      (if (nil? saved)
        (System/delete_env "BL_CACHE_DIR")
        (System/put_env "BL_CACHE_DIR" saved))
      (is (zero? code) "the question is answerable")
      (is (= 1 (count first-run)) "one file, one remembered analysis — under the sources")
      (is (= first-run second-run) "the second run reuses it: no new entry")
      (is (zero? again) "and it still answers")
      (File/rm_rf! root))))

; ── nplus1: the N+1 class as a question over facts ───────────────────

(deftest nplus1-finds-a-read-inside-a-loop-and-not-outside
  (let [root (str (System/tmp_dir!) "/bl_ask_n1_" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p (str root "/src"))
    (File/write! (str root "/mix.exs") "")
    (File/write! (str root "/src/a.bl")
      (str "(ns demo.a (:require [datom]))\n"
           "(defn rows [db ids]\n"
           "  (mapv (fn [e] (datom/pull db [:a] e)) ids))\n"       ; line 3: N+1
           "(defn one [db e]\n"
           "  (datom/pull db [:a] e))\n"                             ; line 5: straight-line
           "(defn nested [db ids]\n"
           "  (for [e ids] (let [m (datom/q '[:find ?x :in $ ?e :where [?e :a ?x]] db e)] m)))\n" ; line 7
           "(defn batched [db ids]\n"
           "  (mapv :a (datom/pull-many db [:a] ids)))\n"))          ; line 9: read OUTSIDE the loop
    (let [sigs (merge typed/core-sigs typed/core-seeds-v2 typed/host-seeds)
          conn (:conn (bl.ask/connect-set! sigs [(str root "/src/a.bl")]))
          rows (mapv vec (codebase/nplus1 (datom/db conn)))
          lines (into #{} (mapv (fn [r] (nth r 2)) rows))]
      (is (contains? lines 3) "pull inside mapv")
      (is (contains? lines 7) "q inside a for body, through a let")
      (is (not (contains? lines 5)) "a straight-line read is not an N+1")
      (is (not (contains? lines 9)) "the batched read outside the loop is the fix")
      (is (every? (fn [r] (>= (nth r 3) 1)) rows) "every row carries its loop depth"))
    (File/rm_rf! root)))
