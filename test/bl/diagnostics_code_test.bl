(ns diagnostics.code-test (:require [diagnostics :as d] [diagnostics.code :as code] [diagnostics.health :as health] [diagnostics.otp :as otp] [diagnostics.delivery :as delivery]))
(deftest code-sites-never-forward-arguments-or-unmapped-paths
  (code/configure! {"fixture/handler" {:site "site_fixture" :line 12}})
  (let [raw (tuple :fixture :handler (list "Bearer secret") (list (tuple :file "/private/customer.bl")))
        safe (code/stack (repeat 20 raw))]
    (is (= 8 (count safe)))
    (is (= {:code/site-id "site_fixture" :code/frame 0 :code/arity 1 :code/line 12} (first safe)))
    (is (not (String/contains? (pr-str safe) "secret")))
    (is (not (String/contains? (pr-str safe) "/private")))
    (is (= "site_fixture" (:code/site-id (code/frame (tuple :fixture :"-handler/2-fun-0-" 0) 0))))
    (is (= [] (code/stack [(tuple :unknown :customer (list "secret"))]))))
  (code/configure! {}))
(deftest sampler-only-resolves-registered-live-operation
  (is (nil? (code/snapshot "unknown")))
  (code/with-operation-fn "local_fixture"
    #(do (is (map? (code/snapshot "local_fixture"))) (is (nil? (:dictionary (code/snapshot "local_fixture"))))))
  (is (nil? (code/snapshot "local_fixture"))))
(deftest independent-health-does-not-need-a-sink
  (is (= 1 (:version (health/sample))))
  (is (erlang/is_integer (:sampled-at (health/sample)))))

(deftest blocked-writer-has-independent-private-health
  (let [path (str (System/tmp_dir) "/diagnostic-health-" (d/new-id))
        primary (logger/get_primary_config)
        parent (erlang/self)
        channel (otp/install! {:capacity 1 :writer (fn [_] (erlang/send parent :writing) (Process/sleep 60000))})]
    (try
      (d/emit! :diagnostics.span/started {})
      (receive :writing nil (after 2000 (is false)))
      (d/emit! :diagnostics.span/started {})
      (health/publish! path)
      (let [value (Jason/decode! (File/read! path))]
        (is (= 1 (get value "capacity")))
        (is (= 1 (get value "pending")))
        (is (= 1 (get value "dropped")))
        (is (= 0 (erlang/band (:mode (File/stat! path)) 63)))
        (is (<= (:size (File/stat! path)) 4096))
        (is (some? (get-in value ["identity" "diagnostics/boot-id"]))))
      (delivery/close! channel 0)
      (health/publish! path)
      (let [value (Jason/decode! (File/read! path))]
        (is (= false (get value "alive?")))
        (is (= 1 (get value "abandoned"))))
      (finally (otp/uninstall! 0) (logger/set_primary_config primary) (File/rm path)))))

(deftest health-publisher-restarts-under-its-own-supervisor
  (let [dir (System/get_env "XDG_RUNTIME_DIR")
        path (str dir "/diagnostic-health-" (d/new-id))
        primary (logger/get_primary_config)]
    (is (and dir (String/starts_with? dir "/run/")))
    (otp/install! {:writer (fn [_] nil)})
    (let [supervisor (health/start! path)]
      (try
        (is (erlang/is_pid supervisor))
        (let [children (fn [] (erlang/apply :"Elixir.Supervisor" :which_children (list supervisor)))
              original (elem (first (children)) 1)]
          (erlang/exit original :kill)
          (loop [left 100]
            (when (and (> left 0) (= original (elem (first (children)) 1)))
              (Process/sleep 10) (recur (dec left))))
          (is (not= original (elem (first (children)) 1)))
          (loop [left 100]
            (when (and (> left 0) (not (File/exists? path))) (Process/sleep 10) (recur (dec left))))
          (is (File/exists? path)))
        (finally (health/stop! supervisor) (otp/uninstall! 1000) (logger/set_primary_config primary) (File/rm path))))))
