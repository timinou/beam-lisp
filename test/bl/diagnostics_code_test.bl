(ns diagnostics.code-test (:require [diagnostics :as d] [diagnostics.code :as code] [diagnostics.health :as health]))
(deftest code-sites-never-forward-arguments-or-unmapped-paths
  (code/configure! {"fixture/handler" {:site "site_fixture" :line 12}})
  (let [raw (tuple :fixture :handler (list "Bearer secret") (list (tuple :file "/private/customer.bl")))
        safe (code/stack (repeat 20 raw))]
    (is (= 8 (count safe)))
    (is (= {:code/site-id "site_fixture" :code/frame 0 :code/arity 1 :code/line 12} (first safe)))
    (is (not (String/contains? (pr-str safe) "secret")))
    (is (not (String/contains? (pr-str safe) "/private")))
    (is (= [] (code/stack [(tuple :unknown :customer (list "secret"))]))))
  (code/configure! {}))
(deftest sampler-only-resolves-registered-live-operation
  (is (nil? (code/snapshot "unknown")))
  (code/with-operation-fn "local_fixture"
    #(do (is (map? (code/snapshot "local_fixture"))) (is (nil? (:dictionary (code/snapshot "local_fixture"))))))
  (is (nil? (code/snapshot "local_fixture"))))
(deftest independent-health-does-not-need-a-sink
  (is (= 1 (:version (health/sample))))
  (is (erlang/is_integer (:sampled-at (health/sample)))))
