(ns os.lease-test (:require [os.lease :as lease]))
(deftest live-owner-refuses-replacement-and-release-preserves-the-lock-inode
 (let [path (str (System/tmp_dir!) "/os-lease-" (erlang/unique_integer (list :positive)))
       held (:ok (lease/acquire! path))]
  (is (some? held))
  (try
   (let [inode (:inode (File/stat! path))]
    (is (= :busy (:error (lease/acquire! path))))
    (lease/release! held)
    (let [next (:ok (lease/acquire! path))]
     (is (some? next))
     (is (= inode (:inode (File/stat! path))))
     (lease/release! next)))
   (finally (lease/release! held) (File/rm path)))))
(deftest owner-death-releases-without-a-ttl
 (let [path (str (System/tmp_dir!) "/os-owner-" (erlang/unique_integer (list :positive)))
       me (erlang/self)
       owner (erlang/spawn (fn []
                (erlang/send me [:lease (lease/acquire! path)])
                (receive :stop :ok)))
       monitor (erlang/monitor :process owner)]
  (try
   (receive [:lease r] (is (some? (:ok r))) (after 5000 (throw :lease-timeout)))
   (is (= :busy (:error (lease/acquire! path))))
   (erlang/exit owner :kill)
   (receive [:DOWN ref _ _ _] :when (= ref monitor) nil)
   (let [deadline (+ (erlang/monotonic_time :millisecond) 5000)
         r (loop []
             (let [r (lease/acquire! path)]
              (if (and (= :busy (:error r)) (< (erlang/monotonic_time :millisecond) deadline))
               (do (Process/sleep 10) (recur)) r)))]
    (is (some? (:ok r))) (lease/release! (:ok r)))
   (finally (erlang/exit owner :kill) (File/rm path)))))
(deftest transferring-a-lease-outlives-the-creating-process
 (let [path (str (System/tmp_dir!) "/os-transfer-" (erlang/unique_integer (list :positive)))
       me (erlang/self)
       owner (erlang/spawn (fn [] (receive :stop :ok)))
       creator (erlang/spawn (fn []
                  (let [held (:ok (lease/acquire! path))]
                   (assert held) (lease/transfer! held owner)
                   (erlang/send me :transferred))))
       monitor (erlang/monitor :process creator)]
  (try
   (receive :transferred :ok (after 5000 (throw :transfer-timeout)))
   (receive [:DOWN ref _ _ _] :when (= ref monitor) nil)
   (is (= :busy (:error (lease/acquire! path))))
   (erlang/exit owner :kill)
   (finally (erlang/exit owner :kill) (File/rm path)))))
(deftest a-paused-os-owner-cannot-be-stolen
 (let [path (str (System/tmp_dir!) "/os-paused-" (erlang/unique_integer (list :positive)))
       held (:ok (lease/acquire! path))
       pid (str (elem (erlang/port_info (:port held) :os_pid) 1))]
  (try
   (is (= 0 (elem (System/cmd "kill" (list "-STOP" pid)) 1)))
   (is (= :busy (:error (lease/acquire! path))))
   (finally
    (System/cmd "kill" (list "-CONT" pid))
    (lease/release! held) (File/rm path)))))
