(ns codebase.loop-cost.test
  (:require [codebase :as cb] [datom]))

(defn- indexed [src] (cb/index-source {} "costprobe" src))
(defn- site [facts caller callee]
  (first (filter (fn [c] (and (= caller (:call/caller c)) (= callee (:call/callee c))))
                 (:calls facts))))

(deftest helper-effects-inherit-loop-context
  (let [facts (indexed "(defn rd [x] (File/read x)) (defn rows [xs] (map rd xs))")
        read (site facts "rd" "File/read")]
    (is (= 0 (:call/loop-depth read)))
    (is (= 1 (:call/effective-loop-depth read)))
    (is (= "local-context" (:call/cost-coverage read)))))

(deftest two-hop-helpers-inherit-context
  (let [facts (indexed "(defn rd [x] (File/read x)) (defn helper [x] (rd x)) (defn rows [xs] (map helper xs))")]
    (is (= 1 (:call/effective-loop-depth (site facts "rd" "File/read"))))))

(deftest foreign-iterator-callback-positions-are-not-bl-map-positions
  (doseq [body ["(Enum/map xs rd)" "(Enum/map xs (fn [x] (rd x)))"
                "(lists/map rd xs)"]]
    (let [facts (indexed (str "(defn rd [x] (File/read x)) (defn rows [xs] " body ")"))]
      (is (= 1 (:call/effective-loop-depth (site facts "rd" "File/read"))) body))))

(deftest collection-arguments-are-evaluated-once
  (let [facts (indexed "(defn rows [] (Enum/map (File/read \"x\") (fn [x] x)))")]
    (is (= 0 (:call/effective-loop-depth (site facts "rows" "File/read"))))))

(deftest recursive-context-is-not-a-finite-depth-proof
  (let [facts (indexed "(defn rd [x] (File/read x)) (defn recur-row [x] (rd x) (recur-row x))")
        read (site facts "rd" "File/read")]
    (is (= "recursive" (:call/cost-coverage read)))
    (is (not (contains? read :call/effective-loop-depth)))))

(deftest cyclic-propagation-is-bounded
  (let [facts (indexed "(defn a [xs] (map b xs)) (defn b [x] (a x))")]
    (is (every? (fn [c] (= "recursive" (:call/cost-coverage c))) (:calls facts)))))

(deftest inherited-store-reads-are-queryable
  (let [conn (cb/connect-codebase)
        facts (indexed "(defn rd [db] (datom/q '[:find ?x] db)) (defn rows [xs] (map rd xs))")]
    (datom/transact! conn (concat (:fn facts) (:calls facts)))
    (let [sites (cb/nplus1 (datom/db conn))]
      (is (some (fn [s] (and (= "rd" (nth s 0)) (= 1 (nth s 3)))) sites)))))
