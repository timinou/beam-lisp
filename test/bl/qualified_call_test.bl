; qualified_call_test.bl — alias/name means THAT namespace's name.
;
; A qualified call compiled while its namespace was declared but not loaded resolved to
; CORE's function of the same name: `(owner/count id)` answered the length of the id string
; and `(osenv/get "K" "d")` answered nil with the variable set (BUG-111). The provider and
; the caller live in fixtures that no other test loads, so the namespace really is unloaded
; when the caller compiles, whatever ran before this file.

(ns qualified-call-test)

(def FIXTURES "test/bl/fixtures/qcall")

(defn- caller-fn [name]
  (BeamLisp.Env/add_search_path FIXTURES)
  (BeamLisp.Loader/ensure_loaded "qc-caller")
  (BeamLisp.Env/fetch! "qc-caller" name))

(deftest a-qualified-call-reaches-its-own-namespace-not-core
  (testing "the provider is not loaded when the caller compiles"
    (is (= :provider-count ((caller-fn "via-count") "abc")) "core's count would answer 3")
    (is (= :provider-get ((caller-fn "via-get") "K" "d")) "core's get would answer nil")
    (is (= :provider-first ((caller-fn "via-first") "abc")) "core's first would answer \\a")
    (is (= :provider-only-here ((caller-fn "via-only-here") 1)) "a name core lacks was never affected")))

(deftest an-explicit-core-name-is-still-core
  (testing "the fix must not turn `core/x` into a lookup that misses"
    (is (= 3 (core/count "abc")))
    (is (= :d (core/get {} :k :d)))
    (is (= 1 (core/first [1 2])))
    (is (= 3 (clojure.core/count [1 2 3])))))

(run-tests)
