(ns build-claim-child-custody.test (:require [claim :as claim]))

(defn- eventually [f accepted]
  (loop [left 200]
    (let [result (f)]
      (if (or (accepted result) (zero? left)) result
        (do (Process/sleep 5) (recur (dec left)))))))

(deftest a-compiler-child-excludes-restaging-after-its-parent-dies
  (let [root (str (System/tmp_dir!) "/bl-child-custody-" (System/unique_integer (list :positive)))
        parent (erlang/self)
        writer (spawn (fn []
                        (claim/acquire! root "SDK producer")
                        (erlang/send parent (tuple :context (claim/follower-context root)))
                        (receive :finish :ok)))
        context (receive [:context value] value (after 5000 nil))
        child (spawn (fn []
                       (claim/with-follower context
                         (fn [] (erlang/send parent :reading) (receive :finish :ok)))))]
    (try
      (is (= :reading (receive :reading :reading (after 5000 :timeout))))
      (erlang/exit writer :kill)
      (let [holder (eventually #(claim/held-by root) #(= :child (:custody %)))]
        (is (= :child (:custody holder)))
        (is (not (:ok? (claim/acquire! root "replacement")))))
      (let [monitor (erlang/monitor :process child)]
        (erlang/send child :finish)
        (receive [:DOWN ref :process _ _] :when (= ref monitor) :ok (after 5000 :timeout)))
      (is (:ok? (eventually #(claim/acquire! root "after child exit") :ok?)))
      (finally
        (claim/release! root)
        (erlang/exit writer :kill) (erlang/exit child :kill)
        (File/rm_rf! root)))))

(deftest a-late-child-refuses-a-replacement-cohort-before-executing
  (let [root (str (System/tmp_dir!) "/bl-stale-child-" (System/unique_integer (list :positive)))
        ran (atom false)]
    (try
      (is (:ok? (claim/acquire! root "old parent")))
      (let [old (claim/follower-context root)]
        (claim/release! root)
        (is (:ok? (claim/acquire! root "new parent")))
        (is (= :stale-workspace-claim
               (try (claim/with-follower old #(reset! ran true)) nil
                    (catch e (:kind (ex-data e))))))
        (is (= false @ran))
        (is (= "new parent" (:bin (claim/read-claim root)))))
      (finally (claim/release! root) (File/rm_rf! root)))))
