; Genuine compiler output drives inventory. Inspection never invokes its MFA.
(ns test.seed-unit-members (:require [seed]))

(defn- fixture [action]
 (let [suffix (str (System/unique_integer (list :positive)))
       namespace (str "seed-unit-fixture-" suffix)
       root (str (System/tmp_dir!) "/seed-unit-members-" suffix)
       ebin (str root "/ebin") boot (str root "/boot")
       file (str boot "/" namespace ".bl")
       source (str "(ns " namespace ")
        (defmacro token [] (do (Process/put :seed-unit-macro-called true) :expanded))
        (defrecord Entryλ! [value])
        (defn answer [] :answer)
        (def initialized (do (Process/put :seed-unit-init-count
          (+ 1 (or (Process/get :seed-unit-init-count) 0))) (fn [] :state)))")
       view (BeamLisp.Env/fork :global) modules (atom [])]
  (File/mkdir_p! boot) (File/write! file source)
  (Process/delete :seed-unit-macro-called) (Process/delete :seed-unit-init-count)
  (try
   (let [beams (BeamLisp.Env/with_env view
                #(BeamLisp.AOT/compile_source source
                   (list (tuple :file file) (tuple :output_dir ebin) (tuple :mark_loaded? true))))
         shim (BeamLisp.Emit/module_for namespace)
         variant (String/replace_prefix (Atom/to_string shim) "Elixir.BeamLisp.Ns." "")]
    (reset! modules (mapv #(elem % 0) beams))
    (action {:namespace namespace :variant variant :root root :boot boot :ebin ebin :shim shim
             :beams beams :view view :macro (str "Elixir.BeamLisp.Ns.Init." variant ".Macros.beam")}))
   (finally
    (BeamLisp.Env/destroy view)
    (when (seq @modules) (BeamLisp.Env/retire_modules! @modules))
    (Process/delete :seed-unit-macro-called) (Process/delete :seed-unit-init-count)
    (File/rm_rf! root)))))

(defn- raw-attributes [bytes]
 (let [r (beam_lib/chunks bytes (list :attributes))]
  (map (fn [row]
         (let [value (elem row 1)]
          (tuple (elem row 0)
            (if (and (erlang/is_list value) (= 1 (erlang/length value))) (erlang/hd value) value))))
       (filter #(String/starts_with? (Atom/to_string (elem % 0)) "bl_")
        (Keyword/get (elem (elem r 1) 1) :attributes)))))

(defn- rewritten [bytes module key value]
 (BeamLisp.Emit/compile_descriptor
  (BeamLisp.Emit/descriptor_for module (list)
   (cons (tuple key value) (filter #(not= key (elem % 0)) (raw-attributes bytes))))))

(deftest actual-macro-class-and-value-companions-all-enter-the-unit-inventory
 (fixture
  (fn [f]
   (let [before (mapv (fn [beam] (tuple (elem beam 0) (code/which (elem beam 0)))) (:beams f))
         actual (seed/boot-inventory [(:variant f)] (:ebin f))
         expected (set (map #(str (Atom/to_string (elem % 0)) ".beam") (:beams f)))]
    (is (= [] (:errors actual)))
    (is (= expected (set (:beams actual))))
    (is (contains? expected (:macro f)))
    (is (contains? expected (str "Elixir.BeamLisp.Ns.Init." (:variant f) ".beam")))
    (is (contains? expected (str (Atom/to_string (BeamLisp.Record/module_name (:namespace f) "Entryλ!")) ".beam")))
    (is (= expected (set (map seed/beam-of (seed/emitted-variants (:variant f) (:ebin f))))))
    (is (= 1 (Process/get :seed-unit-init-count)))
    (is (= nil (Process/get :seed-unit-macro-called)))
    (is (= before (mapv (fn [beam] (tuple (elem beam 0) (code/which (elem beam 0)))) (:beams f))))))))

(deftest missing-real-macro-companion-refuses-before-old-floor-is-touched
 (fixture
  (fn [f]
   (let [out (str (:root f) "/previous")]
    (File/mkdir_p! out) (File/write! (str out "/keep") "previous-floor")
    (File/write! (str out "/manifest.term") "previous-manifest")
    (File/rm! (str (:ebin f) "/" (:macro f)))
    (is (seq (:errors (seed/boot-inventory [(:variant f)] (:ebin f)))))
    (let [result (seed/run {:boot (:boot f) :ebin (:ebin f) :out out})]
     (is (= false (:ok? result)))
     (is (includes? (join " " (:errors result)) "incomplete boot closure")))
    (is (= "previous-floor" (File/read! (str out "/keep"))))
    (is (= "previous-manifest" (File/read! (str out "/manifest.term"))))
    (is (= 1 (Process/get :seed-unit-init-count)))
    (is (= nil (Process/get :seed-unit-macro-called)))))))

(deftest malformed-duplicate-and-path-members-never-become-publication-inventory
 (fixture
  (fn [f]
   (let [beam (first (filter #(= (:shim f) (elem % 0)) (:beams f)))
         path (str (:ebin f) "/" (Atom/to_string (:shim f)) ".beam")]
    (doseq [descriptor [nil (list) (tuple :wrong (list)) (tuple :members :wrong)
                       (tuple :members (list "binary-is-not-module"))
                       (tuple :members (list (String/to_atom "../outside")))
                       (tuple :members (list (:shim f)))
                       (tuple :members (list :repeated :repeated))]]
     (File/write! path (elem (rewritten (elem beam 1) (:shim f) :bl_aot_unit_members descriptor) 1))
     (is (seq (:errors (seed/boot-inventory [(:variant f)] (:ebin f))))))
    (is (= 1 (Process/get :seed-unit-init-count)))
    (is (= nil (Process/get :seed-unit-macro-called)))))))

(deftest present-member-bytes-must-match-the-original-unit-provenance-and-module
 (fixture
  (fn [f]
   (let [module (String/to_atom (str "Elixir.BeamLisp.Ns.Body." (:variant f)))
         beam (first (filter #(= module (elem % 0)) (:beams f)))
         path (str (:ebin f) "/" (Atom/to_string module) ".beam")]
    (doseq [[key value] [[:bl_unit_namespace "foreign"] [:bl_unit_source_digest "foreign"]
                        [:bl_compiler_key "foreign"] [:bl_source_hash "foreign"]
                        [:bl_aot_artifact_role :unknown] [:bl_aot_artifact_version 0]]]
     (File/write! path (elem (rewritten (elem beam 1) module key value) 1))
     (is (seq (:errors (seed/boot-inventory [(:variant f)] (:ebin f))))))
    (File/write! path (elem (rewritten (elem beam 1) :seed_wrong_actual_module :bl_aot_artifact_version 1) 1))
    (is (seq (:errors (seed/boot-inventory [(:variant f)] (:ebin f)))))
    (is (= 1 (Process/get :seed-unit-init-count)))
    (is (= nil (Process/get :seed-unit-macro-called)))))))

(deftest manifest-coverage-is-checked-even-when-companion-file-still-exists
 (fixture
  (fn [f]
   ;; Multi is the fixed boot closure dependency; these are real current bytes.
   (let [ebin (or (System/get_env "BL_SEED_UNIT_MEMBERS_TEST_EBIN")
                  (Path/dirname (List/to_string (code/which :Elixir.BeamLisp.Ns.Multi))))]
    (doseq [variant (seed/emitted-variants "Multi" ebin)]
     (File/cp! (Path/join ebin (seed/beam-of variant))
               (str (:ebin f) "/" (seed/beam-of variant)))))
   (let [objects (:objects (seed/boot-inventory [(:variant f) "Multi"] (:ebin f)))
         modules (into {} (map (fn [object]
                         [(:name object) (Base/encode16 (crypto/hash :sha256 (:bytes object))
                                            (list (tuple :case :lower)))]) objects))
         write-manifest (fn [entries]
                          (File/write! (str (:ebin f) "/manifest.term")
                           (erlang/iolist_to_binary (io_lib/format "~p.~n" (list {"modules" entries})))))
         opts {:boot (:boot f) :out (:ebin f)}]
    (write-manifest modules)
    ;; The subset is deliberately not a complete native floor; only its unit
    ;; closure errors are inspected. Missing host rows never confer acceptance.
    (is (= [] (:errors (seed/check opts))))
    (write-manifest (dissoc modules (:macro f)))
    (let [result (seed/check opts)]
     (is (= false (:ok? result)))
     (is (includes? (join " " (:errors result))
           (str "manifest omits or mismatches compiler unit member: " (:macro f)))))
    (is (File/exists? (str (:ebin f) "/" (:macro f))))
    (is (= 1 (Process/get :seed-unit-init-count)))
    (is (= nil (Process/get :seed-unit-macro-called)))))))
