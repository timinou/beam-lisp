; reader_position_test.bl — the self-hosted reader (priv/reader.bl) must attach
; the SAME source-position metadata the live Elixir reader does.
;
; WHY THIS EXISTS
;
; reader_parity_test.bl compares the two readers through read_all/read-all,
; which DEEP-UNWRAP {:meta …} source positions — so it deliberately cannot see
; whether reader.bl attaches positions at all. But the compiler REQUIRES them:
; it reads {:line :col :file} off a form's {:meta …} wrapper to point a
; diagnostic at the user's file and line (compiler.bl env-from-meta,
; compile_diagnostic.ex, wave20_reader_pos_test.exs). A position-free reader
; compiles fine but points every error at nothing — a silent regression.
;
; This suite is the position gate. It reads the SAME source with both readers
; via their POSITION-RETAINING entry (read-string / read_string, NOT read-all)
; and asserts the trees — {:meta …} wrappers intact — are `=`. reader.ex is the
; answer key.
;
; THE SHAPE (observed empirically from BeamLisp.Reader.read_string):
;   * ONLY list forms carry a position: {:meta, {:list, items}, %{line col file}}
;   * a nested list carries its OWN position, independent of its parent
;   * symbols, keywords, scalars, vectors, maps, sets stay BARE (no wrapper) —
;     a list is where evaluation happens, so a list is what an error names
;   * line advances on \n, col on every other char; both 1-indexed; file is the
;     second arg threaded verbatim
;
; Run:  mix beam_lisp.test test/bl/reader_position_test.bl

(ns reader-position.test
  (:require [reader :as r]
            [reader-node :as rn]))

; --- the answer key -----------------------------------------------------------
;
; read_string (NOT read_all) keeps the {:meta …} position wrappers. `=` then
; compares position-bearing tree to position-bearing tree.

; read_string_elixir, not read_string: read_string follows the reader seam and
; becomes the .bl reader once this suite interns the `reader` ns, degrading the
; answer key to a self-comparison. The genesis-pinned entry keeps it honest.
(defn- ex [src file] (BeamLisp.Reader/read_string_elixir src file))
(defn- bl [src file] (r/read-string src file))

; --- whole-tree parity WITH positions -----------------------------------------
;
; The strongest assertion: the entire position-bearing tree must be `=` to the
; answer key, wrappers and maps and all.

(deftest top-level-list-position-matches
  (testing "a form on line 1 carries {:meta {:list …} {:line 1 :col 1 :file}}"
    (is (= (ex "(+ 1 2)" "a.bl") (bl "(+ 1 2)" "a.bl")))))

(deftest scalars-and-symbols-stay-bare
  (testing "a bare scalar/symbol/keyword carries NO wrapper in either reader"
    (is (= (ex "42" "a.bl") (bl "42" "a.bl")))
    (is (= (ex "foo" "a.bl") (bl "foo" "a.bl")))
    (is (= (ex ":kw" "a.bl") (bl ":kw" "a.bl")))))

(deftest vectors-and-maps-stay-bare
  (testing "vectors and maps are NOT wrapped (only lists are)"
    (is (= (ex "[1 2]" "a.bl") (bl "[1 2]" "a.bl")))
    (is (= (ex "{:a 1}" "a.bl") (bl "{:a 1}" "a.bl")))))

(deftest nested-list-carries-own-position
  (testing "an inner list gets its own col, independent of the outer list"
    (is (= (ex "(a (b c))" "f.bl") (bl "(a (b c))" "f.bl")))))

(deftest columns-advance-within-a-line
  (testing "two lists on one line carry their distinct columns"
    (is (= (ex "(foo)  (bar)" "f.bl") (bl "(foo)  (bar)" "f.bl")))))

(deftest lines-advance-over-newlines
  (testing "a form after blank lines is attributed to its real line"
    (is (= (ex "\n\n(+ 1 2)" "f.bl") (bl "\n\n(+ 1 2)" "f.bl")))))

(deftest comments-and-indentation-set-position
  (testing "a form after a leading comment lands on the next line"
    (is (= (ex "; lead\n(x)" "f.bl") (bl "; lead\n(x)" "f.bl"))))
  (testing "leading indentation sets the column"
    (is (= (ex "    (x)" "f.bl") (bl "    (x)" "f.bl")))))

(deftest prefix-forms-are-positioned-like-reader-ex
  (testing "quote/deref expand to a list positioned at the prefix char"
    (is (= (ex "'x" "f.bl") (bl "'x" "f.bl")))
    (is (= (ex "@x" "f.bl") (bl "@x" "f.bl"))))
  (testing "syntax-quote with a nested unquote list carries nested positions"
    (is (= (ex "`(a ~b)" "f.bl") (bl "`(a ~b)" "f.bl")))))

(deftest dispatch-forms-are-positioned-like-reader-ex
  (testing "#() fn literal is positioned at the # (reader.ex wraps the desugar)"
    (is (= (ex "#(+ % 1)" "f.bl") (bl "#(+ % 1)" "f.bl"))))
  (testing "#d[...] data-reader call is positioned at the #"
    (is (= (ex "#d[:find ?x]" "f.bl") (bl "#d[:find ?x]" "f.bl"))))
  (testing "a #{} set is NOT wrapped (only lists are), in both readers"
    (is (= (ex "#{1 2}" "f.bl") (bl "#{1 2}" "f.bl"))))
  (testing "a #Name{} record is NOT wrapped, in both readers"
    (is (= (ex "#Point{:x 1}" "f.bl") (bl "#Point{:x 1}" "f.bl")))))

(deftest fn-literal-sibling-position-matches
  ; reader.ex QUIRK, matched for parity: its `#(...)` handler feeds the body
  ; collection a position still pointing at the `#` while the char stream is
  ; already past `#(` — a constant TWO-column undercount that persists through
  ; the body AND into the RETURNED position. A single `#()` still matches (its
  ; own wrapper is positioned at `#` in both), but the form IMMEDIATELY AFTER a
  ; fn-literal inherits that 2-short column. read-all hides this (it strips
  ; positions); only a position-bearing sibling exposes it. reader.bl must
  ; reproduce the undercount, bug-for-bug, or flipping the live reader shifts
  ; every diagnostic column after a `#()`.
  (testing "the sibling after one #() is positioned like reader.ex"
    (is (= (ex "(a #(f %) b)" "f.bl") (bl "(a #(f %) b)" "f.bl"))))
  (testing "a #() followed by another #() — the second's column matches"
    (is (= (ex "(x #(f %) #(g %) y)" "f.bl") (bl "(x #(f %) #(g %) y)" "f.bl"))))
  (testing "the ->> threading case that first surfaced it (examples/threading.bl)"
    (is (= (ex "(->> xs (map #(* % %)) (reduce +))" "f.bl")
           (bl "(->> xs (map #(* % %)) (reduce +))" "f.bl")))))

; --- author metadata (^) must be ATTACHED, not dropped ------------------------
;
; read-all strips ALL metadata, so the parity suite (which compares via
; read-all) is blind to whether `^` metadata survives. But the LIVE compile
; path is read-string, and the compiler READS author metadata off a def/defn
; name: `name-author-meta` (compiler.bl) pulls `^{:args …}` / `^:private` /
; `^{:doc …}` off the name's {:meta …} wrapper to build the var's metadata map
; and to feed the type checker (examples/typing/*: "its ^ meta flows to the
; checker"). reader.ex ATTACHES it (attach_meta + metadata_spec); reader.bl
; must too, or flipping the live reader silently loses every annotation,
; :private flag, and metadata-borne docstring. read-all keeps stripping it, so
; the bare-shape consumers and the parity suite are unaffected.

(deftest caret-metadata-is-attached-like-reader-ex
  (testing "^:kw attaches {:kw true}"
    (is (= (ex "^:private x" "f.bl") (bl "^:private x" "f.bl"))))
  (testing "^{map} attaches the map with keyword-atom keys"
    (is (= (ex "^{:doc \"d\"} y" "f.bl") (bl "^{:doc \"d\"} y" "f.bl"))))
  (testing "^Sym attaches {:tag {:symbol Sym}}"
    (is (= (ex "^Sym z" "f.bl") (bl "^Sym z" "f.bl"))))
  (testing "^\"str\" attaches {:tag \"str\"}"
    (is (= (ex "^\"str\" w" "f.bl") (bl "^\"str\" w" "f.bl"))))
  (testing "the type-annotation shape ^{:args … :ret …} attaches verbatim"
    (is (= (ex "^{:args [int] :ret bool} double" "f.bl")
           (bl "^{:args [int] :ret bool} double" "f.bl"))))
  (testing "stacked ^:a ^:b merges both onto the target"
    (is (= (ex "^:private ^:static x" "f.bl") (bl "^:private ^:static x" "f.bl"))))
  (testing "^ metadata on a def name merges with the list's source position"
    (is (= (ex "(def ^:private secret 42)" "f.bl")
           (bl "(def ^:private secret 42)" "f.bl"))))
  (testing "^ metadata on a defn name, inside a positioned list"
    (is (= (ex "(defn ^{:doc \"d\"} f [x] x)" "f.bl")
           (bl "(defn ^{:doc \"d\"} f [x] x)" "f.bl")))))

(deftest read-all-still-strips-caret-metadata
  (testing "read-all deep-unwraps ^ metadata, so bare-shape consumers are unaffected"
    (is (= (BeamLisp.Reader/read_all_elixir "^:private x") (r/read-all "^:private x")))
    (is (= (BeamLisp.Reader/read_all_elixir "(def ^:private secret 42)")
           (r/read-all "(def ^:private secret 42)")))))

; --- data-reader / record SIBLING position (returned-pos undercount) ----------
;
; reader.ex reads a `#time"…"` payload and a `#Name{…}` map with the `#`
; position (pos0), not the position after the tag, so the RETURNED position —
; and thus the next sibling's column — undercounts by the tag length + 1. A
; single tag matches; only a sibling after it exposes the quirk. reader.bl must
; reproduce it bug-for-bug (same as the fn-literal case).

(deftest tag-sibling-position-matches
  (testing "the sibling after #time\"…\" is positioned like reader.ex"
    (is (= (ex "(f #time\"1990/2000\" #time\"1995\")" "f.bl")
           (bl "(f #time\"1990/2000\" #time\"1995\")" "f.bl"))))
  (testing "the sibling after a #Name{…} record is positioned like reader.ex"
    (is (= (ex "(f #Point{:x 1} (g))" "f.bl") (bl "(f #Point{:x 1} (g))" "f.bl")))))

; --- direct position readback (accessor-level, reader-node vocabulary) --------
;
; Beyond whole-tree `=`, assert the accessors the compiler actually uses return
; the right numbers — so a future refactor that changed the wrapper shape but
; kept `=` (unlikely, but) would still be caught at the interface the compiler
; consumes.

(deftest node-pos-reads-line-col-file
  (testing "node-pos on the top-level list returns the {:line :col :file} map"
    (let [[form] (bl "  (+ 1 2)" "src.bl")
          pos (rn/node-pos form)]
      (is (= 1 (maps/get :line pos)))
      (is (= 3 (maps/get :col pos)))
      (is (= "src.bl" (maps/get :file pos))))))

(deftest file-threads-verbatim
  (testing "the file arg reaches every wrapped form"
    (let [[form] (bl "(x)" "deep/path.bl")]
      (is (= "deep/path.bl" (maps/get :file (rn/node-pos form)))))))

; --- read-all still returns BARE trees (position-free) ------------------------
;
; read-string is the position channel; read-all must keep deep-unwrapping, so
; existing consumers and the parity suite are unaffected.

(deftest read-all-stays-position-free
  (testing "read-all returns no :meta wrappers even after read-string exists"
    (is (= (BeamLisp.Reader/read_all_elixir "(+ 1 2)") (r/read-all "(+ 1 2)")))))
