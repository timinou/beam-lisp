(ns sdk.inventory-cache-test)

(deftest unrelated-application-code-does-not-rediscover-the-sdk
 (BeamLisp.Env/ensure_sdk_runtime!)
 ;; The first hit may narrow the discovery certificate to its proven SDK set.
 (BeamLisp.Env/ensure_sdk_runtime!)
 (let [pattern (tuple :Elixir.BeamLisp.AOT :sdk_runtime_inventory_uncached! 1)]
  (try
   (erlang/trace_pattern pattern true (list :local :call_count))
   (BeamLisp/eval "(ns sdk.inventory.cache.application) (defn value [] 17)")
   (BeamLisp.Env/ensure_sdk_runtime!)
   (is (= 0 (elem (erlang/trace_info pattern :call_count) 1)))
   ;; Unrelated publication still uses the concurrency fence, but does not
   ;; change any SDK byte, source, receipt or protected executable route.
   (BeamLisp.Env/with_code_evidence_publication (fn [] :unrelated))
   (BeamLisp.Env/ensure_sdk_runtime!)
   (is (= 0 (elem (erlang/trace_info pattern :call_count) 1)))
   ;; A publication still in progress must decline the memo even if its final
   ;; effects could turn out to be unrelated. Sampling cannot certify that.
   (BeamLisp.Env/with_code_evidence_publication
    (fn [] (BeamLisp.Env/ensure_sdk_runtime!)))
   (is (> (elem (erlang/trace_info pattern :call_count) 1) 0))
   (finally (erlang/trace_pattern pattern false (list :local :call_count))))))
