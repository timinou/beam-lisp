(ns aot-constructor-string-test)
(defn- prefix [text pattern]
 (BeamLisp.AOT/interpret_constructor!
  {:op :remote :mod :Elixir.String :fun :starts_with?
   :args [{:op :lit :val text} {:op :lit :val pattern}]} {} {}))
(defn- refusal [f] (try (f) nil (catch e (:kind (ex-data e)))))
(deftest literal-prefix-predicates-preserve-string-semantics
 (is (= true (prefix "?name" "?")))
 (is (= true (prefix "?*tail" "?*")))
 (is (= false (prefix "?name" "?*")))
 (is (= true (prefix "" "")))
 (is (= true (prefix "épreuve" "é")))
 (is (= false (prefix "épreuve" "e"))))
(deftest nonliteral-patterns-and-excessive-inputs-remain-refused
 (is (= :constructor-machine-refused (refusal (fn [] (prefix "?name" ["?" "!"])))))
 (is (= :constructor-machine-refused (refusal (fn [] (prefix (String/duplicate "x" 65537) "x")))))
 (is (= :constructor-machine-refused (refusal (fn [] (prefix "x" (String/duplicate "x" 65537)))))))
(deftest prefix-support-does-not-admit-arbitrary-native-effects
 (let [path (Path/join (System/tmp_dir!) (str "constructor-prefix-never-write-" (erlang/unique_integer (list :positive))))
       effect {:op :remote :mod :Elixir.File :fun :write!
               :args [{:op :lit :val path} {:op :lit :val "unexpected"}]}]
  (is (not (File/exists? path)))
  (is (= :constructor-machine-refused
       (refusal (fn [] (BeamLisp.AOT/interpret_constructor! effect {} {})))))
  (is (not (File/exists? path)))))
(deftest actual-sdk-pattern-prefix-validators-use-the-constructor
 (BeamLisp.Loader/ensure_loaded "rewrite")
 (let [defs {"rewrite" (BeamLisp.Env/ns_defs "rewrite")}]
  (is (= true (BeamLisp.AOT/constructor_call! defs {} "rewrite" "pattern-var?" ['?name])))
  (is (= true (BeamLisp.AOT/constructor_call! defs {} "rewrite" "rest-pattern-var?" ['?*tail])))
  (is (= false (BeamLisp.AOT/constructor_call! defs {} "rewrite" "rest-pattern-var?" ['?name])))))
(deftest actual-deodorant-declarations-initialize-with-their-real-alias-metadata
 (BeamLisp.Loader/ensure_loaded "deodorant")
 (let [smells (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "deodorant" "all-smells") (list))]
  (is (pos? (count smells)))
  (is (some (fn [rule] (= 'datalog/n+1-read (:name rule))) smells))))
