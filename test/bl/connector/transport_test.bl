(ns connector.transport-test
  (:require [connector.transport :as transport] [veritas.model :as vm]))

(defn await-completion! [predicate]
  (let [deadline (+ (erlang/monotonic_time :millisecond) 3000)]
    (loop []
      (if (predicate) true
        (do
          (when (>= (erlang/monotonic_time :millisecond) deadline)
            (throw (ex-info "Owned delayed HTTP handler did not settle" {})))
          (Process/sleep 2)
          (recur))))))

(deftest receive-after-requires-an-explicit-sequence
  (is (= :first (receive (after 1 :first {:marker :last}))))
  (let [observed (atom false)]
    (is (= {:marker :last}
           (receive (after 1 (do (reset! observed true) {:marker :last})))))
    (is @observed)))

(deftest actual-http-deadlines-always-return-bounded-uncertain-maps
  (let [entered (atom 0) completed (atom 0)
        model (vm/model "Owned HTTP deadline oracle"
                {:state {}
                 :commands
                 {:ready {:request [:get "/ready"]
                          :response (fn [_ _] {:body {"ready" true}})}
                  :delayed {:request [:get "/delayed"]
                            :response (fn [_ _]
                              (swap! entered inc)
                              (try
                                (Process/sleep 200)
                                {:body {"late" true}}
                                (finally (swap! completed inc))))}}})
        server (vm/serve model)]
    (try
      (let [ready (transport/request! {:url (str (:url server) "/ready")
                                       :timeout-ms 5000})]
        (is (= 200 (:status ready)))
        (is (= :accepted (:outcome ready)))
        (is (= true (get-in ready [:body "ready"]))))
      ;; Collect each public result before assertions: a keyword regression
      ;; cannot conceal the other independent deadlines. httpc's own timeout
      ;; message may win the race with receive's after branch.
      (let [results (mapv (fn [budget]
                           (let [before @completed
                                 result (transport/request!
                                          {:url (str (:url server) "/delayed")
                                           :timeout-ms budget})]
                             (await-completion! (fn [] (> @completed before)))
                             result))
                         [20 35 50])]
        (is (= 3 @entered @completed))
        (doseq [result results]
          (is (map? result))
          (is (= 0 (:status result)))
          (is (= :uncertain (:outcome result)))
          (is (contains? #{:timeout :transport} (:error result)))))
      (finally
        (try (await-completion! (fn [] (= @entered @completed)))
          (finally ((:stop server))))))))
