; test/bl/connector/console_test.bl — background sync is visible from the store:
; events per step/drain, pruned; a snapshot for an app; a summary for any store.

(ns connector.console-test
  (:require [datom] [datom.store-fjall] [files] [datom.projection :as pj]
            [connector.keep :as keep] [connector.console :as console]
            [connector.google.gdrive :as gdrive] [connector.google.fake-drive :as fd]))

(files/register-under!)

(def DOC
  (pj/projection :test/doc
    {:active   '[[?scope :mount/state :active]]
     :member   '[[?scope :mount/root ?r] [?src :~file/live-under ?r] [:not [?src :file/folder? true]]]
     :revision '[[?src :file/rev ?rev]]}))

(def SCHEMA
  (-> (keep/full-schema) (into pj/schema) (into console/schema)
      (into [{:db/ident :mount/id :db/valueType :db.type/string :db/unique :db.unique/identity}
             {:db/ident :mount/root :db/valueType :db.type/ref}
             {:db/ident :mount/state :db/valueType :db.type/keyword}])))

(defn- setup [conn]
  (let [d (fd/make {:page-size 2})
        k (fn [id] [:gdrive "s" id])]
    (fd/add! d "r" {:name "R" :parent "root" :folder? true})
    (fd/add! d "a" {:name "a.md" :parent "r" :content "A"})
    (fd/add! d "x" {:name "x.xlsb" :parent "r" :content "X"})
    (let [kp {:conn conn :feed (gdrive/feed "s") :get (fd/get-fn d) :roots (fn [_] [(k "r")])}]
      (console/timed-step! conn kp)
      (datom/transact! conn [{:db/id -1 :mount/id "m1" :mount/state :active
                              :mount/root (nth (first (into [] (datom/datoms (datom/db conn) :avet :conn/key (k "r")))) 0)}])
      (let [scope (first (first (into [] (datom/q '[:find ?m :where [?m :mount/id "m1"]] (datom/db conn)))))
            opts {:scope-key "m1"
                  :apply (fn [row _] (if (ends-with? (get-in @d [:items (nth (:src-key row) 2) :name]) ".xlsb")
                                       {:skip :unsupported-type} {:target [:lib (nth (:src-key row) 2)]}))
                  :retire (fn [_ _] nil)}]
        (console/timed-drain! conn (keep/feed-key (:feed kp)) DOC scope opts)
        {:drive d :kp kp :scope scope :opts opts}))))

(deftest a-snapshot-shows-feed-scopes-and-events
  (let [c (datom/connect SCHEMA)
        w (setup c)
        snap (console/snapshot c {:feed (:feed (:kp w)) :roots [[:gdrive "s" "r"]] :projection DOC
                                  :scopes [{:scope (:scope w) :key "m1" :label "Dupont"}]})]
    (is (some? (get-in snap [:feed :cursor])))
    (is (= 2 (get-in snap [:feed :roots 0 :items])))
    (let [s (first (:scopes snap))]
      (is (= 0 (:owed s)))
      (is (= {:applied 1 :skipped 1} (:records s)))
      (is (= {"unsupported-type" 1} (:skipped-by-reason s)) "skip reasons are named"))
    (is (= [:drain :keep] (mapv :sync.event/kind (:events snap))) "newest first")
    (let [txt (console/render snap)]
      (is (includes? txt "scope Dupont  owed 0"))
      (is (includes? txt "drain m1")))))

(deftest a-failing-step-is-visible-with-its-error
  (let [c (datom/connect SCHEMA)
        w (setup c)]
    (fd/fail-next! (:drive w) 1 503)
    (fd/add! (:drive w) "b" {:name "b.md" :parent "r" :content "B"})
    (console/timed-step! c (:kp w))
    (let [snap (console/snapshot c {:feed (:feed (:kp w)) :roots [] :projection DOC :scopes []})]
      (is (some? (get-in snap [:feed :error])) "the feed carries its last error")
      (is (= 503 (get-in (first (:events snap)) [:sync.event/result :error :status]))))))

(deftest events-are-pruned-to-the-newest
  (let [c (datom/connect SCHEMA)
        fk [:gdrive "s"]]
    (doseq [i (range 0 (+ console/KEEP 30))] (console/record! c fk :keep {:ok :idle} 1 nil))
    (console/prune! c fk)
    (is (= console/KEEP (count (console/events (datom/db c) fk 100000))))))

(deftest any-store-summarises-itself-without-the-app
  (let [path (str "/tmp/bl-console-" (erlang/unique_integer (to-list [:positive])) ".fjall")
        c (datom/connect-with (datom.store-fjall/open path) SCHEMA)]
    (setup c)
    (datom/close! c)
    (let [c2 (datom/connect-with (datom.store-fjall/open path) [])
          s (console/store-summary (datom/db c2))
          txt (console/render-summary s)]
      (is (= 1 (count (:feeds s))))
      (is (includes? txt "feed [:gdrive \"s\"]"))
      (is (includes? txt ":applied"))
      (is (includes? txt "skipped by reason"))
      (datom/close! c2))
    (File/rm_rf! path)))
