(ns connector.clock.test (:require [connector.clock :as clock]))
(deftest virtual-observation-is-owned-idempotent-and-current
 (let [c (clock/virtual 100) identity (clock/listen! c)]
  (try
   (is (= identity (clock/listen! c)))
   (is (= 125 (clock/advance! c 25)))
   (is (= identity (receive [:connector.clock/changed token] token (after 100 nil))))
   (is (= :none (receive [:connector.clock/changed _] :duplicate (after 0 :none))))
   (is (= 40 (clock/restore! c 40)))
   (is (= identity (receive [:connector.clock/changed token] token (after 100 nil))))
   (is (= 40 (clock/now c)))
   (is (not (clock/realtime? c)))
   (clock/unlisten! c)
   (clock/advance! c 1)
   (is (= :none (receive [:connector.clock/changed _] :leaked (after 0 :none))))
   (finally (clock/unlisten! c)))))
(deftest independent-clocks-do-not-share-observation
 (let [a (clock/virtual 0) b (clock/virtual 0) watched (clock/listen! a)]
  (try
   (clock/advance! b 1)
   (is (= :none (receive [:connector.clock/changed _] :foreign (after 0 :none))))
   (clock/advance! a 2)
   (is (= watched (receive [:connector.clock/changed token] token (after 100 nil))))
   (finally (clock/unlisten! a)))))
(deftest system-clock-keeps-ordinary-contract
 (let [c (clock/system)]
  (is (erlang/is_integer (clock/now c)))
  (is (clock/realtime? c))
  (is (nil? (clock/listen! c)))
  (is (= :ok (clock/unlisten! c)))))
