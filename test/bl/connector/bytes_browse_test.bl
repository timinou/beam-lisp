; test/bl/connector/bytes_browse_test.bl — bytes over a real socket (PLAN-151
; P5) and browsing that writes nothing (P4).

(ns connector.bytes-browse-test
  (:require [connector.http :as http] [connector.google.gdrive :as gdrive]
            [connector.google.fake-drive :as fd] [datom] [files]))

;; ── a one-shot local HTTP server: serves `responses` in order ───────────────

(defn- serve [responses]
  (let [ls (erlang/element 2 (gen_tcp/listen 0 (to-list [:binary (tuple :active false) (tuple :reuseaddr true)])))
        port (erlang/element 2 (inet/port ls))]
    (erlang/spawn
      (fn []
        (doseq [resp responses]
          (let [s (erlang/element 2 (gen_tcp/accept ls))]
            (gen_tcp/recv s 0 5000)
            (gen_tcp/send s resp)
            (gen_tcp/close s)))
        (gen_tcp/close ls)))
    (str "http://127.0.0.1:" port "/f")))

(defn- resp [status headers body]
  (str "HTTP/1.1 " status " X\r\n"
       (join "" (map (fn [[k v]] (str k ": " v "\r\n")) headers))
       "Connection: close\r\n\r\n" body))

(deftest bytes-arrive-with-their-content-type
  (let [url (serve [(resp 200 [["Content-Type" "text/markdown"] ["Content-Length" "5"]] "hello")])
        r (http/get-bytes url "Bearer t" 100)]
    (is (= "hello" (:ok r)))
    (is (= "text/markdown" (:content-type r)))))

(deftest a-declared-length-over-the-cap-is-refused-by-name
  (let [url (serve [(resp 200 [["Content-Length" "5000"]] (join "" (repeat 5000 "x")))])
        r (http/get-bytes url "Bearer t" 100)]
    (is (= :too-large (get-in r [:error :reason])))
    (is (= 5000 (get-in r [:error :size])))))

(deftest an-undeclared-body-over-the-cap-is-refused-too
  (let [url (serve [(str "HTTP/1.1 200 X\r\nConnection: close\r\n\r\n" (join "" (repeat 300 "y")))])
        r (http/get-bytes url "Bearer t" 100)]
    (is (= :too-large (get-in r [:error :reason])))))

(deftest a-server-error-is-an-error-with-its-status
  (let [url (serve [(resp 503 [["Content-Length" "4"]] "busy")])
        r (http/get-bytes url "Bearer t" 100)]
    (is (= 503 (get-in r [:error :status])))))

(deftest nobody-answering-is-status-zero
  (let [r (http/get-bytes "http://127.0.0.1:1/nothing" "Bearer t" 100)]
    (is (= 0 (get-in r [:error :status])))))

;; ── what to read, decided from metadata alone ───────────────────────────────

(deftest content-requests-are-decided-before-any-download
  (let [doc {:key [:gdrive "n" "d1"] :mime "application/vnd.google-apps.document"}
        sheet {:key [:gdrive "n" "s1"] :mime "application/vnd.google-apps.spreadsheet"}
        pdf {:key [:gdrive "n" "p1"] :mime "application/pdf" :size 10}
        big {:key [:gdrive "n" "b1"] :mime "application/pdf" :size 999999999}]
    (is (includes? (:url (gdrive/content-request doc 1000)) "/files/d1/export?mimeType=text%2Fmarkdown"))
    (is (= "text/markdown" (:as (gdrive/content-request doc 1000))))
    (is (= :unsupported-google-type (:refused (gdrive/content-request sheet 1000))))
    (is (includes? (:url (gdrive/content-request pdf 1000)) "alt=media"))
    (is (= :too-large (:refused (gdrive/content-request big 1000))) "from the listed size, no download")
    (is (= gdrive/EXPORT-LIMIT (:limit (gdrive/content-request doc 999999999))) "export capped at 10 MB")))

;; ── browse: live, sorted, writes nothing ────────────────────────────────────

(deftest browse-lists-folders-first-and-writes-nothing
  (let [d (fd/make {:page-size 2})
        c (datom/connect files/schema)
        before (count (into [] (datom/datoms (datom/db c) :eavt)))]
    (fd/add! d "z" {:name "zeta.md" :parent "root" :content "z"})
    (fd/add! d "a" {:name "Alpha" :parent "root" :folder? true})
    (fd/add! d "m" {:name "mid.pdf" :parent "root" :content "m"})
    (fd/add! d "t" {:name "trashed.md" :parent "root" :content "t"})
    (fd/trash! d "t")
    (let [r (gdrive/browse (fd/get-fn d) "n" "root")]
      (is (= ["Alpha" "mid.pdf" "zeta.md"] (mapv :name (:ok r))) "folders first, then by name; trashed hidden; paged")
      (is (= [:gdrive "n" "a"] (:key (first (:ok r))))))
    (is (= before (count (into [] (datom/datoms (datom/db c) :eavt)))) "no datom written")))
