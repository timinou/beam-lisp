; test/bl/connector/directory_test.bl — `:directory` of the feeds (docs/connectors/
; rights-as-relations.md §4.1): Graph GET /users and Admin SDK users.list against the fakes.

(ns connector.directory-test
  (:require [connector :as conn]
            [connector.microsoft.graph :as g]
            [connector.microsoft.fake-graph :as fg]
            [connector.google.gdrive :as gdrive]
            [connector.google.fake-drive :as fd]
            [credential.store :as store]))

(defn- tmp-dir [] (str "/tmp/directory-test-" (erlang/unique_integer (list :positive))))

(defmacro with-fake [[f c] & body]
  `(let [~f (fg/start! {})
         ~c (let [c# (conn/open g/spec {:account-id "app" :client {:client-id (:client-id ~f) :client-secret (:client-secret ~f)}
                                        :store (store/store-file (tmp-dir))})]
              (g/connect! c# {:tenant (:tenant ~f) :login-base (:login-base ~f)})
              c#)]
     (try (do ~@body) (finally ((:stop ~f))))))

(defn- graph-dir [f c] (:directory (g/feed fg/DRIVE (:graph-base f) {:tenant (:tenant f)})))

(deftest graph-directory-is-403-until-granted
  (with-fake [f c]
    (let [r ((graph-dir f c) (g/get-via c) {})]
      (is (= 403 (get-in r [:error :status]))))))

(deftest graph-directory-pages-and-flags-guest-and-disabled
  (with-fake [f c]
    (fg/do! f :grant-directory nil)
    (let [r ((graph-dir f c) (g/get-via c) {})
          ps (get-in r [:ok :people])
          by (into {} (map (fn [p] [(:id p) p]) ps))]
      (is (= 5 (count ps)) "5 users over 3 pages of 2")
      (is (= "amina@contoso.com" (:email (get by "u-amina"))))
      (is (= true (:enabled? (get by "u-amina"))))
      (is (= false (:guest? (get by "u-amina"))))
      (is (= true (:guest? (get by "u-guest"))))
      (is (= "guest@partner.example" (:email (get by "u-guest"))))
      (is (= false (:enabled? (get by "u-gone"))))
      (is (= [:graph (:tenant f) :person "u-amina"] (:key (get by "u-amina"))))
      (is (nil? (get-in r [:ok :next]))))))

(deftest graph-directory-group-scoped
  (with-fake [f c]
    (fg/do! f :grant-directory nil)
    (let [r ((graph-dir f c) (g/get-via c) {:group "g-all"})
          ids (into #{} (map :id (get-in r [:ok :people])))]
      (is (= #{"u-amina" "u-youssef"} ids) "transitive members, persons only"))))

(deftest gdrive-directory-lists-domain-users
  (let [d (fd/make)]
    (fd/add-user! d {:id "1" :email "Amina@Contoso.com" :name "Amina" :title "Partner"})
    (fd/add-user! d {:id "2" :email "old@contoso.com" :name "Old" :suspended? true})
    (fd/add-user! d {:id "3" :email "c@contoso.com" :name "C"})
    (let [dir (:directory (gdrive/feed "sub-1" {:domain "contoso.com"}))]
      (is (= 403 (get-in (dir (fd/get-fn d) {}) [:error :status])))
      (fd/grant-directory! d)
      (let [ps (get-in (dir (fd/get-fn d) {}) [:ok :people])
            by (into {} (map (fn [p] [(:email p) p]) ps))]
        (is (= 3 (count ps)))
        (is (= "Partner" (:title (get by "amina@contoso.com"))))
        (is (= false (:enabled? (get by "old@contoso.com"))))
        (is (= [:gdrive "sub-1" :person "amina@contoso.com"] (:key (get by "amina@contoso.com"))))))
    (is (nil? (:directory (gdrive/feed "sub-1" nil))) "no domain, no directory")))
