; test/bl/reactive_test.bl — derived / derived?.
; Run: mix beam_lisp.test test/bl/reactive_test.bl
;
; A derived recomputes only when a dependency's value actually changed. These
; tests pin the recompute COUNT (the property a naive "recompute every deref"
; or "never recompute" both get wrong), transitivity through a chain, and the
; pull-based rule that swapping a dependency does no work until the next deref.

(ns reactive.test)

(deftest derived-computes-then-caches
  (let [a (atom 1)
        runs (atom 0)
        c (derived [a] (do (swap! runs inc) (* 2 a)))]
    (is (= 2 @c))
    (is (= 2 @c))
    ; two derefs, one computation
    (is (= 1 @runs))))

(deftest derived-recomputes-only-on-change
  (let [a (atom 1)
        runs (atom 0)
        c (derived [a] (do (swap! runs inc) (* 2 a)))]
    (is (= 2 @c))
    (swap! a inc)          ; a = 2
    (is (= 4 @c))
    (is (= 4 @c))
    ; ran once initially, once after the change
    (is (= 2 @runs))))

(deftest derived-is-pull-based
  ; swapping a dependency must NOT run the thunk; only deref does.
  (let [a (atom 1)
        runs (atom 0)
        c (derived [a] (do (swap! runs inc) a))]
    (swap! a inc)
    (swap! a inc)
    (swap! a inc)
    ; no deref yet: zero runs
    (is (= 0 @runs))
    (is (= 4 @c))
    (is (= 1 @runs))))

(deftest derived-multiple-deps
  (let [a (atom 2)
        b (atom 3)
        c (derived [a b] (+ a b))]
    (is (= 5 @c))
    (swap! a inc)
    (is (= 6 @c))
    (swap! b inc)
    (is (= 7 @c))))

(deftest derived-chains-and-propagates-staleness
  (let [a (atom 1)
        c-runs (atom 0)
        d-runs (atom 0)
        c (derived [a] (do (swap! c-runs inc) (* 2 a)))
        d (derived [c] (do (swap! d-runs inc) (+ 100 c)))]
    (is (= 102 @d))        ; c=2, d=102
    (is (= 102 @d))        ; both cached
    (is (= 1 @c-runs))
    (is (= 1 @d-runs))
    (swap! a inc)          ; a=2 -> c should become 4 -> d 104
    (is (= 104 @d))
    ; each recomputed exactly once more
    (is (= 2 @c-runs))
    (is (= 2 @d-runs))))

(deftest derived-predicate
  (is (= true (derived? (derived [] 1))))
  (is (= false (derived? (atom 1))))
  (is (= false (derived? 5))))
