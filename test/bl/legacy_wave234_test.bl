; legacy_wave234_test.bl — waves 2, 3 and 4 of the language, in beam-lisp.
;
; Ported from three ExUnit suites so the repository can shed their `.exs`:
;
;   * test/beam_lisp/wave2_test.exs — loop/recur, destructuring, variadic
;     params, the wave-2 prelude fns (reduce/range/list/second/zipmap).
;   * test/beam_lisp/wave3_test.exs — vectors, syntax-quote, defmacro.
;   * test/beam_lisp/wave4_test.exs — namespaces, the loader, fn-targeted
;     recur, the control-flow macros, variadic arithmetic.
;
; PARITY MAPPING: one `deftest` per ExUnit `test`, in the same order and
; grouped the same way. Every `assert`/`refute` becomes one or more `is`
; assertions; the count of `is` forms is the count of original assertions.
; Where the ExUnit suite pinned an exception with `assert_raise Type, ~r/msg/`,
; the port keeps BOTH halves of the contract: a typed `catch Type e` clause (a
; raise of any other type fails the assertion) plus the message regex, so an
; assertion can never pass on the wrong error.
;
; Four ExUnit details do not survive the crossing verbatim, and are adapted:
;
;   * `setup`/`on_exit`. Ward runs a file's tests in ONE image with no per-test
;     setup, and `Env.current_ns` is process-global — an ExUnit test that ran
;     `(ns …)` could not leak into the next because ExUnit runs each test in a
;     fresh process. Here every namespace-touching test restores the prior
;     namespace via `restoring-ns`/`with-ns`, so an earlier test's `(ns w4.x)`
;     cannot change what a later test's unqualified names resolve to. The
;     wave-3 syntax-quote case, which the original pinned to `user` explicitly,
;     does the same through `with-ns "user"`.
;   * `BeamLisp.Test.realize/1` (Elixir) → `doall` (the language's own seq
;     realization). Both force the same sequence of values.
;   * `(:require [w4.lib :as lib])` of a namespace defined only in this FILE.
;     Ward runs the file in an isolated env while the require loader is served
;     from a pinned process at `:global`, so a namespace declared only in the
;     ward fork is invisible to it. The ExUnit test ran in an env-unbound
;     process (its `BeamLisp.eval` interned VM-wide), so those tests define and
;     require their namespaces at `:global` via `at-global`.
;   * `refute eval("[1 2 3]") == [1, 2, 3]` — the Elixir type distinction
;     between a Vector struct and a list — becomes `(not (list? …))`: beam-lisp's
;     `=` is structural across sequential collections, so `list?` is the test
;     that a vector is not a list.
;
; Run: bin/bl test test/bl/legacy_wave234_test.bl

(ns legacy.wave234-test)

(defn- bl-eval
  "Compile and evaluate a source string in the current namespace — the port's
   `BeamLisp.eval`/`BeamLisp.Compiler.eval_string`."
  [source]
  (BeamLisp/eval source))

(defn- restoring-ns
  "Run `f`, then put the current namespace back exactly where it was. Ward has
   no `setup`/`on_exit`; this is the isolation an ExUnit test process gave for
   free."
  [f]
  (let [prev (BeamLisp.Env/current_ns)]
    (try
      (f)
      (finally (BeamLisp.Env/in_ns prev)))))

(defn- with-ns
  "Run `f` with the current namespace bound to `ns`, restoring afterwards."
  [ns f]
  (let [prev (BeamLisp.Env/current_ns)]
    (try
      (BeamLisp.Env/in_ns ns)
      (f)
      (finally (BeamLisp.Env/in_ns prev)))))

(defn- at-global
  "Run `f` in the `:global` env, restoring the ambient namespace afterwards.

   The `(:require …)` loader is served from a pinned process at `:global`, so a
   namespace defined only in this file's ward fork is invisible to it and the
   require comes back `namespace not found`. The ExUnit suite ran every test in
   a process with NO env binding — its `BeamLisp.eval` interned the source ns
   VM-wide — so the port defines the required namespaces where ExUnit did: at
   `:global`. (Same rule as `test/bl/per_env_def_test.bl`.)"
  [f]
  (BeamLisp.Env/with_env :global
    (fn []
      (let [prev (BeamLisp.Env/current_ns)]
        (try
          (f)
          (finally (BeamLisp.Env/in_ns prev)))))))

; wave 2 · loop/recur
; ─────────────────────────────────────────────────────────────────────────

(deftest loop-binds-and-recurs
  (is (= 10 (bl-eval "(loop [i 0 acc 0] (if (< i 5) (recur (+ i 1) (+ acc i)) acc))"))))

(deftest recur-in-tail-position-is-constant-stack
  ; 200k iterations of self-application: runs in constant stack.
  (is (= 200000 (bl-eval "(loop [i 0] (if (< i 200000) (recur (+ i 1)) i))"))))

(deftest recur-through-nested-lets-and-ifs-stays-in-tail-position
  (is (= 20 (bl-eval "(loop [i 0] (let [done? (>= i 10)] (if done? (let [answer (* i 2)] answer) (recur (+ i 1)))))"))))

(deftest recur-outside-tail-position-is-a-compile-error
  (is (try (bl-eval "(loop [i 0] (+ 1 (recur (+ i 1))))")
           false
           (catch BeamLisp.CompileError e (includes? (str (ex-message e)) "tail position"))
           (catch e false))
      "a CompileError naming tail position"))

(deftest recur-with-no-target-is-a-compile-error
  (is (try (bl-eval "(recur 1)")
           false
           (catch BeamLisp.CompileError e (includes? (str (ex-message e)) "no enclosing"))
           (catch e false))
      "a CompileError naming the missing enclosing loop/fn"))

(deftest recur-arity-must-match-the-loop
  (is (try (bl-eval "(loop [i 0] (recur 1 2))")
           false
           (catch BeamLisp.CompileError e (includes? (str (ex-message e)) "arity mismatch"))
           (catch e false))
      "a CompileError naming the arity mismatch"))

(deftest recur-inside-an-inner-fn-targets-that-fn-not-the-loop
  ; The fn is the innermost target; its arity (0) mismatches.
  (is (try (bl-eval "(loop [i 0] ((fn [] (recur 1))))")
           false
           (catch BeamLisp.CompileError e (includes? (str (ex-message e)) "arity mismatch"))
           (catch e false))
      "a CompileError naming the arity mismatch"))

(deftest recur-at-top-level-still-has-no-target
  (is (try (bl-eval "(recur 1)")
           false
           (catch BeamLisp.CompileError e (includes? (str (ex-message e)) "no enclosing"))
           (catch e false))
      "a CompileError naming the missing enclosing loop/fn"))

(deftest loop-result-is-a-value
  (is (= 3 (bl-eval "(+ 1 (loop [i 0] (if (< i 2) (recur (+ i 1)) i)))"))))

; ─────────────────────────────────────────────────────────────────────────
; wave 2 · destructuring
; ─────────────────────────────────────────────────────────────────────────

(deftest sequential-destructuring-in-let
  (is (= 3 (bl-eval "(let [[a b] [1 2]] (+ a b))")))
  (is (= 6 (bl-eval "(let [[a b c] [1 2 3]] (+ a (+ b c)))"))))

(deftest sequential-destructuring-with-rest
  (is (= '(2 3) (doall (bl-eval "(let [[a & rest] [1 2 3]] rest)"))))
  ; Clojure binds an exhausted rest to nil, not an empty collection:
  ; upstream code branches on `(when more …)`, and an empty collection is
  ; truthy.
  (is (= nil (bl-eval "(let [[a & rest] [1]] rest)")))
  (is (= true (bl-eval "(let [[a & rest] [1]] (nil? rest))"))))

(deftest nested-sequential-destructuring
  (is (= 6 (bl-eval "(let [[[a b] c] [[1 2] 3]] (+ a (+ b c)))"))))

(deftest map-destructuring-with-keys
  (is (= 3 (bl-eval "(let [{:keys [a b]} {:a 1 :b 2}] (+ a b))"))))

(deftest map-destructuring-with-explicit-keys
  (is (= 3 (bl-eval "(let [{:x x :y y} {:x 1 :y 2}] (+ x y))"))))

(deftest map-destructuring-with-as-binds-the-whole
  (is (= 2 (bl-eval "(let [{:keys [a] :as m} {:a 1 :b 2}] (:b m))"))))

(deftest sequential-params-in-defn
  (is (= 7 (bl-eval "(defn add-pair [[a b]] (+ a b)) (add-pair [3 4])"))))

(deftest map-params-in-defn-with-as
  (is (= "beam" (bl-eval "(defn greet [{:keys [name] :as person}] (str name)) (greet {:name \"beam\"})"))))

; ─────────────────────────────────────────────────────────────────────────
; wave 2 · variadic params
; ─────────────────────────────────────────────────────────────────────────

(deftest variadic-rest-collects-extra-args
  (is (= '(2 3) (doall (bl-eval "(defn f [a & rest] rest) (f 1 2 3)")))))

(deftest zero-extra-args-gives-an-empty-rest
  (is (= '() (doall (bl-eval "(defn f [a & rest] rest) (f 1)")))))

(deftest all-variadic-fn
  (is (= 4 (bl-eval "(defn f [& xs] (count xs)) (f 1 2 3 4)"))))

(deftest fixed-and-rest-are-both-bound
  (is (= 6 (bl-eval "(defn f [a b & rest] (+ a (+ b (count rest)))) (f 1 2 3 4 5)"))))

(deftest too-few-args-raises-an-argument-error
  ; the runtime names the SHAPE it could not call (RT.call_shape_error):
  ; an ArgumentError, not a bare RuntimeError.
  (is (try (bl-eval "(defn f [a b & rest] a) (f 1)")
           false
           (catch ArgumentError e (includes? (str (ex-message e)) "taking 2 or more arguments"))
           (catch e false))
      "an ArgumentError naming the variadic shape"))

; ─────────────────────────────────────────────────────────────────────────
; wave 2 · prelude wave-2 fns
; ─────────────────────────────────────────────────────────────────────────

(deftest reduce-is-loop-based-and-still-correct
  (is (= 4950 (bl-eval "(reduce (fn [acc x] (+ acc x)) 0 (range 100))"))))

(deftest range-is-lazy-bounded-and-unbounded
  ; range is lazy, bounded as well as unbounded — doall forces it, since what
  ; these assert is the sequence of values.
  (is (= '(0 1 2 3 4) (doall (bl-eval "(range 5)"))))
  (is (= '(2 3 4) (doall (bl-eval "(range 2 5)"))))
  (is (= '() (doall (bl-eval "(range 0)")))))

(deftest second-returns-the-second-element
  (is (= 20 (bl-eval "(second [10 20 30])"))))

(deftest list-is-variadic
  (is (= '(1 2 3) (bl-eval "(list 1 2 3)")))
  (is (= '() (bl-eval "(list)"))))

(deftest zipmap-pairs-keys-with-values
  (is (= {:a 1 :b 2} (bl-eval "(zipmap [:a :b] [1 2])"))))

; ─────────────────────────────────────────────────────────────────────────
; wave 3 · vectors
; ─────────────────────────────────────────────────────────────────────────

(deftest a-vector-is-not-a-list
  (is (vector? (bl-eval "[1 2 3]")))
  (is (not (list? (bl-eval "[1 2 3]")))))

(deftest conj-appends-to-vectors-prepends-to-lists
  (is (= [1 2 3] (bl-eval "(conj [1 2] 3)")))
  (is (= '(3 1 2) (bl-eval "(conj '(1 2) 3)"))))

(deftest seq-fns-accept-vectors
  (is (= 1 (bl-eval "(first [1 2])")))
  (is (= '(2 3) (doall (bl-eval "(rest [1 2 3])"))))
  (is (= 3 (bl-eval "(count [1 2 3])")))
  (is (= true (bl-eval "(empty? [])"))))

(deftest nth-is-o1-and-lenient
  (is (= 30 (bl-eval "(let [[a b] [10 20 30]] (+ a b))"))))

(deftest vectors-are-enumerable-for-elixir-interop
  (is (= 6 (bl-eval "(Enum/sum [1 2 3])")))
  (is (= '(2 4 6) (bl-eval "(Enum/map [1 2 3] (fn [x] (* x 2)))"))))

(deftest apply-accepts-vectors
  (is (= 7 (bl-eval "(apply (fn [x y] (+ x y)) [3 4])"))))

(deftest quote-yields-a-vector-for-vector-forms
  (is (vector? (bl-eval "'[1 2 3]")))
  (is (= [1 2 3] (bl-eval "'[1 2 3]"))))

(deftest vectors-print-in-clojure-syntax
  (is (= "[1 :two \"three\"]" (bl-eval "(pr-str [1 :two \"three\"])"))))

; ─────────────────────────────────────────────────────────────────────────
; wave 3 · syntax-quote
; ─────────────────────────────────────────────────────────────────────────

(deftest syntax-quote-qualifies-a-resolved-name-by-the-writing-namespace
  ; A name that resolves where the template was WRITTEN is emitted qualified,
  ; as Clojure does — that is what lets a library macro call its own helper
  ; from another namespace. A name that resolves to nothing is a fresh name
  ; the template introduces and stays bare. Pin the namespace explicitly:
  ; `Env.current_ns` is process-global and survives across evaluations.
  (with-ns "user"
    (fn []
      (bl-eval "(def w3-known 1)")
      (let [form (bl-eval "`(w3-known w3-unknown)")]
        (is (= 2 (count form)))
        (is (= "user/w3-known" (str (first form)))
            "a name that resolves where the template was written is qualified")
        (is (= "w3-unknown" (str (second form)))
            "a name that resolves to nothing stays bare")))))

(deftest syntax-quote-leaves-a-macro-name-bare
  ; Macros are resolved by the expander, which already searches the writing
  ; namespace and core. Qualifying one sent it down the ordinary var path,
  ; where it was invoked as a function — which broke every vendored macro
  ; nesting `when`/`let`.
  (is (= (list (quote when) true 1) (bl-eval "`(when true 1)"))))

(deftest syntax-quote-unquote-evaluates
  (let [form (bl-eval "(def x 42) `(w3-u1 ~x w3-u2)")]
    (is (= 3 (count form)))
    (is (= "w3-u1" (str (first form))))
    (is (= 42 (second form)))
    (is (= "w3-u2" (str (nth form 2))))))

(deftest syntax-quote-splicing-flattens
  (is (= '(1 2 3 4) (bl-eval "(def xs '(2 3)) `(1 ~@xs 4)"))))

(deftest syntax-quoted-vectors-stay-vectors
  (let [v (bl-eval "`[1 ~(+ 1 1)]")]
    (is (vector? v))
    (is (= [1 2] v))))

(deftest syntax-quote-splice-outside-a-list-is-an-error
  (is (try (bl-eval "`~@1")
           false
           (catch RuntimeError e (includes? (str (ex-message e)) "only valid inside"))
           (catch e false))
      "a RuntimeError saying ~@ is only valid inside"))

; ─────────────────────────────────────────────────────────────────────────
; wave 3 · defmacro
; ─────────────────────────────────────────────────────────────────────────

(deftest defmacro-unless
  (is (= :yes (bl-eval "(defmacro unless [c t f] `(if (not ~c) ~t ~f)) (unless (= 1 2) :yes :no)"))))

(deftest defmacro-args-arrive-unevaluated
  (is (= (quote b) (bl-eval "(defmacro quoted-second [form] `(quote ~(second form))) (quoted-second (a b c))"))))

(deftest defmacro-infix-via-unquoted-operator
  (is (= 5 (bl-eval "(defmacro infix [a op b] `(~op ~a ~b)) (infix 2 + 3)"))))

(deftest defmacro-variadic-with-splicing
  (is (= '(1 2 3) (bl-eval "(defmacro my-list [& xs] `(list ~@xs)) (my-list 1 2 3)"))))

(deftest defmacro-producing-vector-params-works
  (is (= 42 (bl-eval "(defmacro defconst [name v] (list (quote def) name v)) (defconst answer 42) answer"))))

(deftest a-macro-must-be-defined-before-use
  (is (try (bl-eval "(never-defined-macro 1 2)")
           false
           (catch RuntimeError e (includes? (str (ex-message e)) "undefined var"))
           (catch e false))
      "an undefined-var RuntimeError"))

; ─────────────────────────────────────────────────────────────────────────
; wave 4 · namespaces
; ─────────────────────────────────────────────────────────────────────────

(deftest ns-switches-the-current-namespace-for-defs
  (restoring-ns
    (fn []
      (bl-eval "(ns w4.alpha) (defn who [] :alpha)")
      (is (= :alpha (bl-eval "(ns w4.beta) (w4.alpha/who)"))))))

(deftest defs-are-isolated-between-namespaces
  (restoring-ns
    (fn []
      (bl-eval "(ns w4.a1) (def x 1)")
      (bl-eval "(ns w4.a2) (def x 2)")
      (is (= 1 (bl-eval "(ns w4.a1) x")))
      (is (= 2 (bl-eval "(ns w4.a2) x"))))))

(deftest core-falls-back-from-any-namespace
  (restoring-ns
    (fn []
      (bl-eval "(ns w4.somewhere)")
      (is (= '(2 3 4) (doall (bl-eval "(map inc [1 2 3])")))))))

(deftest aliases-qualify-calls-and-values
  (at-global
    (fn []
      (bl-eval "(ns w4.lib) (defn double-it [x] (* 2 x)) (def answer 42)")
      (bl-eval "(ns w4.app1 (:require [w4.lib :as lib]))")
      (is (= 42 (bl-eval "(lib/double-it 21)")))
      (is (= 42 (bl-eval "lib/answer"))))))

(deftest refer-brings-vars-in-bare
  (at-global
    (fn []
      (bl-eval "(ns w4.lib2) (defn triple [x] (* 3 x))")
      (bl-eval "(ns w4.app2 (:require [w4.lib2 :refer [triple]]))")
      (is (= 15 (bl-eval "(triple 5)"))))))

(deftest macros-resolve-through-aliases
  (at-global
    (fn []
      (bl-eval "(ns w4.mlib) (defmacro unless-m [c t f] `(if (not ~c) ~t ~f))")
      (bl-eval "(ns w4.mapp (:require [w4.mlib :as m]))")
      (is (= :yes (bl-eval "(m/unless-m (= 1 2) :yes :no)"))))))

(deftest a-missing-var-in-another-ns-reports-that-ns
  (restoring-ns
    (fn []
      (bl-eval "(ns w4.empty-ns) (defn _placeholder [] 1)")
      (bl-eval "(ns w4.caller-ns)")
      (is (try (bl-eval "(w4.empty-ns/nope 1)")
               false
               (catch RuntimeError e (includes? (str (ex-message e)) "undefined var: w4.empty-ns"))
               (catch e false))
          "the error names the namespace that lacks the var"))))

; ─────────────────────────────────────────────────────────────────────────
; wave 4 · the loader
; ─────────────────────────────────────────────────────────────────────────

(deftest require-loads-ns-bl-from-the-load-path-once
  (at-global
    (fn []
      (let [dir (str (System/tmp_dir!) "/bl_w4_" (erlang/unique_integer (list :positive)))]
        (File/mkdir_p! dir)
        (try
          (File/write! (Path/join dir "w4disk.bl")
                       "(ns w4disk)\n(defn from-disk [] :loaded)\n")
          (BeamLisp.Loader/with_load_path dir
            (fn []
              (bl-eval "(ns w4.diskapp (:require [w4disk :as disk]))")
              (is (= :loaded (bl-eval "(disk/from-disk)")))))
          (is (BeamLisp.Env/loaded_ns? "w4disk"))
          (finally (File/rm_rf! dir)))))))

(deftest a-required-files-ns-form-does-not-leak-into-the-requiring-ns
  (at-global
    (fn []
      (let [dir (str (System/tmp_dir!) "/bl_w4_" (erlang/unique_integer (list :positive)))]
        (File/mkdir_p! dir)
        (try
          (File/write! (Path/join dir "w4leak.bl")
                       "(ns w4leak)\n(def marker :from-w4leak)\n")
          (BeamLisp.Loader/with_load_path dir
            (fn []
              (bl-eval "(ns w4.leakapp (:require [w4leak]))")
              (is (= "w4.leakapp" (BeamLisp.Env/current_ns)))))
          (finally (File/rm_rf! dir)))))))

(deftest requiring-a-missing-namespace-names-the-search
  (at-global
    (fn []
      (is (try (bl-eval "(ns w4.broken (:require [no.such.ns]))")
               false
               (catch RuntimeError e (includes? (str (ex-message e)) "namespace not found: no.such.ns"))
               (catch e false))
          "the error names the namespace and the search"))))

; ─────────────────────────────────────────────────────────────────────────
; wave 4 · fn-targeted recur
; ─────────────────────────────────────────────────────────────────────────

(deftest fn-recur-re-enters-the-fn-in-constant-stack
  (is (= :done (bl-eval "(defn w4-countdown [n] (if (= n 0) :done (recur (dec n)))) (w4-countdown 500000)"))))

(deftest fn-recur-multi-arg
  (is (= 832040 (bl-eval "(defn w4-fib [n a b] (if (= n 0) a (recur (dec n) b (+ a b)))) (w4-fib 30 0 1)"))))

(deftest an-inner-fns-recur-targets-the-inner-fn-not-the-outer
  (is (= :inner-done (bl-eval "(defn w4-outer [n] (let [helper (fn [k] (if (= k 0) :inner-done (recur (dec k))))] (helper n))) (w4-outer 100)"))))

(deftest fn-recur-arity-must-match-the-fns-params
  (is (try (bl-eval "(fn [a b] (recur 1))")
           false
           (catch BeamLisp.CompileError e (includes? (str (ex-message e)) "recur arity mismatch"))
           (catch e false))
      "a CompileError naming the recur arity mismatch"))

; ─────────────────────────────────────────────────────────────────────────
; wave 4 · control-flow macros (prelude)
; ─────────────────────────────────────────────────────────────────────────

(deftest cond-picks-the-first-true-branch-else-last
  (is (= :b (bl-eval "(cond (< 2 1) :a (= 2 2) :b :else :c)")))
  (is (= nil (bl-eval "(cond false :a)"))))

(deftest case-dispatches-on-value-odd-clause-is-the-default
  (is (= :two (bl-eval "(case 2 1 :one 2 :two :other)")))
  (is (= :other (bl-eval "(case 9 1 :one :other)"))))

(deftest case-compares-with-eq-keywords-included
  (is (= 2 (bl-eval "(case :b :a 1 :b 2 3)"))))

(deftest when-runs-a-body-or-yields-nil
  (is (= 3 (bl-eval "(when (= 1 1) 1 2 3)")))
  (is (= nil (bl-eval "(when false 1)")))
  (is (= 7 (bl-eval "(when-not false 7)"))))

(deftest and-or-return-values-and-short-circuit
  (is (= true (bl-eval "(and)")))
  (is (= 2 (bl-eval "(and 1 2)")))
  (is (= nil (bl-eval "(and 1 nil 2)")))
  (is (= nil (bl-eval "(or)")))
  (is (= :x (bl-eval "(or nil :x)")))
  (is (= 1 (bl-eval "(or nil false 1)"))))

(deftest or-evaluates-its-first-form-once
  ; side effect: an Agent bump; if `or` re-evaluated, we'd get 2
  (restoring-ns
    (fn []
      (bl-eval "(def w4-box (erlang/element 2 (Agent/start_link (fn [] 0))))")
      (is (= 1 (bl-eval "(let [f (fn [] (Agent/update w4-box (fn [n] (+ n 1))) :val)] (do (or (f) :unused) (Agent/get w4-box (fn [n] n))))"))))))

; ─────────────────────────────────────────────────────────────────────────
; wave 4 · variadic arithmetic
; ─────────────────────────────────────────────────────────────────────────

(deftest plus-and-times-fold-any-arity-with-identity-at-zero
  (is (= 0 (bl-eval "(+)")))
  (is (= 1 (bl-eval "(*)")))
  (is (= 10 (bl-eval "(+ 1 2 3 4)")))
  (is (= 24 (bl-eval "(* 2 3 4)"))))

(deftest minus-and-divide-with-one-arg-negate-and-invert
  (is (= -5 (bl-eval "(- 5)")))
  (is (= 0.5 (bl-eval "(/ 2)")))
  (is (= 5 (bl-eval "(- 10 3 2)"))))

(deftest comparisons-chain
  (is (= true (bl-eval "(< 1 2 3)")))
  (is (= false (bl-eval "(< 1 3 2)")))
  (is (= true (bl-eval "(= 2 2 2)")))
  (is (= false (bl-eval "(= 2 2 3)")))
  (is (= true (bl-eval "(< 1)"))))
