(ns build-target-test (:require [build-plan :as plan] [build :as build]))
(deftest namespace-target-is-read-without-evaluation
  (is (plan/javascript-source? "(ns ^:js browser.worker) (js/Worker. \"x\")"))
  (is (plan/javascript-source? "(ns ^{:interop :javascript} browser.worker)"))
  (is (not (plan/javascript-source? "(ns ordinary) (def x :js)")))
  (is (not (plan/javascript-source? "; (ns ^:js comment)\n(ns ordinary)"))))
(deftest server-build-preserves-browser-source-without-compiling-it
  (let [root (str (System/tmp_dir!) "/build-target-" (System/unique_integer (list :positive)))
        browser (str root "/browser.bl") ordinary (str root "/ordinary.bl")]
    (File/mkdir_p! root)
    (try
      (File/write! browser "(ns ^:js target.browser) (defn worker [] (js/Worker. \"x\"))")
      (File/write! ordinary "(ns target.ordinary) (defn answer [] 42)")
      (let [r (build/run {:sources [browser ordinary] :root root :out (str root "/ebin") :jobs 1})]
        (is (empty? (:errors r)) (pr-str r))
        (is (= 1 (:built r)) (pr-str r))
        (is (File/regular? browser)))
      (File/write! ordinary "(ns ^:js target.ordinary) (defn answer [] (js/Worker. \"x\"))")
      (let [r (build/run {:sources [browser ordinary] :root root :out (str root "/ebin") :jobs 1 :scope :scoped})]
        (is (empty? (:errors r)) (pr-str r))
        (is (empty? (:manifest r)) "a target change removes the previous native beam record")
        (is (empty? (Path/wildcard (str root "/ebin/*Target.Ordinary*.beam")))
            "browser-only source cannot retain stale server beams"))
      (finally (File/rm_rf! root)))))


(deftest build-target-and-node-reuse-one-content-addressed-parts-record
  (let [root (str (System/tmp_dir!) "/build-target-parts-" (System/unique_integer (list :positive)))
        previous (System/get_env "BEAM_LISP_AOT_CACHE_DIR")
        previous-enabled (System/get_env "BEAM_LISP_AOT_CACHE")
        content "(ns ^:js memo.browser) (defn worker [] (js/Worker.))"
        trace (tuple :Elixir.BeamLisp.BuildPlan :build-content-parts 1)]
    (try
      (System/put_env "BEAM_LISP_AOT_CACHE_DIR" root)
      (System/put_env "BEAM_LISP_AOT_CACHE" "on")
      (plan/clear-memo)
      (erlang/trace_pattern trace true (list :local :call_count))
      (let [first (plan/memo-node "memo.browser" content)]
        (is (= true (:javascript? first)))
        (is (= 1 (elem (erlang/trace_info trace :call_count) 1)))
        ;; A fresh VM/table can reuse the persisted parse as well.
        (plan/clear-memo)
        (is (= first (plan/memo-node "memo.browser" content)))
        (is (= 1 (elem (erlang/trace_info trace :call_count) 1)))
        (is (= false (:javascript? (plan/memo-node "memo.browser"
                            (String/replace content "^:js " "")))))
        (is (= 2 (elem (erlang/trace_info trace :call_count) 1))))
      (finally
        (erlang/trace_pattern trace false (list :local :call_count))
        (plan/clear-memo)
        (if previous (System/put_env "BEAM_LISP_AOT_CACHE_DIR" previous)
                     (System/delete_env "BEAM_LISP_AOT_CACHE_DIR"))
        (if previous-enabled (System/put_env "BEAM_LISP_AOT_CACHE" previous-enabled)
                             (System/delete_env "BEAM_LISP_AOT_CACHE"))
        (File/rm_rf! root)))))
