(ns build-target-test (:require [build-plan :as plan] [build :as build]))
(deftest namespace-target-is-read-without-evaluation
  (is (plan/javascript-source? "(ns ^:js browser.worker) (js/Worker. \"x\")"))
  (is (plan/javascript-source? "(ns ^{:interop :javascript} browser.worker)"))
  (is (not (plan/javascript-source? "(ns ordinary) (def x :js)")))
  (is (not (plan/javascript-source? "; (ns ^:js comment)\n(ns ordinary)"))))
(deftest server-build-preserves-browser-source-without-compiling-it
  (let [root (str (System/tmp_dir!) "/build-target-" (System/unique_integer (list :positive)))
        browser (str root "/browser.bl") ordinary (str root "/ordinary.bl")]
    (File/mkdir_p! root)
    (try
      (File/write! browser "(ns ^:js target.browser) (defn worker [] (js/Worker. \"x\"))")
      (File/write! ordinary "(ns target.ordinary) (defn answer [] 42)")
      (let [r (build/run {:sources [browser ordinary] :root root :out (str root "/ebin") :jobs 1})]
        (is (empty? (:errors r)) (pr-str r))
        (is (= 1 (:built r)) (pr-str r))
        (is (File/regular? browser)))
      (File/write! ordinary "(ns ^:js target.ordinary) (defn answer [] (js/Worker. \"x\"))")
      (let [r (build/run {:sources [browser ordinary] :root root :out (str root "/ebin") :jobs 1 :scope :scoped})]
        (is (empty? (:errors r)) (pr-str r))
        (is (empty? (:manifest r)) "a target change removes the previous native beam record")
        (is (empty? (Path/wildcard (str root "/ebin/*Target.Ordinary*.beam")))
            "browser-only source cannot retain stale server beams"))
      (finally (File/rm_rf! root)))))
