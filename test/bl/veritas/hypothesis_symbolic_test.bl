; test/bl/veritas/hypothesis_symbolic_test.bl — behavioural proof, symbolically.
;
; The load-bearing claim: a hypothesis over a function's OUTPUT can be z3-PROVEN,
; not merely sampled. When the function lowers to a define-fun and the predicate
; is in the fragment, ∀ inputs. pred(inputs, (f inputs)) is a z3 query — so a
; behavioural law holds for EVERY input, and a violation is z3's counterexample.
;
; This is the upgrade the user asked for: covers (structural) AND hypothesis
; (behavioural) both become symbolic proofs, not source-string samples.

(ns veritas.hypothesis-symbolic-test
  (:require [veritas.property :as p] [veritas :as v] [z3]))

(def port (z3/open))

; ── a TRUE behavioural law over an infinite domain → :proven (was :witnessed) ─

(deftest floor-nonneg-is-proven
  (let [floor "(defn floor [c] (if (< c 0) 0 c))"
        r (p/prove port floor '(>= result 0) (v/int-of -1000000 1000000))]
    (is (= :proven (:modality r)))
    (is (= :z3 (:engine r)))))

; ── a FALSE behavioural law → :refuted with z3's witness ────────────────────

(deftest floor-strictly-positive-is-refuted
  (let [floor "(defn floor [c] (if (< c 0) 0 c))"
        ; claim (floor c) > 0 for all c — FALSE at c ≤ 0 (floor gives 0)
        r (p/prove port floor '(> result 0) (v/int-of -1000000 1000000))]
    (is (= :refuted (:modality r)))
    (is (= :z3 (:engine r)))
    (is (<= (:witness r) 0))))                 ; z3 hands back a c that yields 0

; ── a relation between input and output: floor is identity on the nonneg half ─

(deftest floor-identity-on-nonneg-is-proven
  (let [floor "(defn floor [c] (if (< c 0) 0 c))"
        ; ∀ c. (=> (>= c 0) (= result c))
        r (p/prove port floor '(=> (>= c 0) (= result c)) (v/int-of -1000000 1000000))]
    (is (= :proven (:modality r)))))

; ── untranslatable body falls back to SAMPLED hypothesis (honest) ───────────

(deftest untranslatable-falls-back-to-sample
  (let [weird "(defn tag [x] (if (> x 0) 1 2))"      ; translatable, but force sample:
        ; a predicate the fragment lacks (mod-by-constant is fine; use a call z3 lacks)
        r (p/prove port weird '(int? result) (v/int-of -10 10))]
    ; int? is not in the SMT fragment ⇒ sampled/enumerated, never a z3 proof
    (is (not (= :z3 (:engine r))))))

(run-tests)
