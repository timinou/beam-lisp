; test/bl/veritas/why_seed_test.bl — every verdict says which rung answered and
; why a stronger one declined; a sampling verdict carries the seed that
; reproduces it.

(ns why-seed-test
  (:require [veritas :as v] [z3]))

(def port (z3/open))

; `(str n)` is outside the SMT fragment (z3 DOES speak rem and nonlinear
; arithmetic, so those would not do), and an int range wider than 10 000 does
; not enumerate: this query can only be SAMPLED.
(def untranslatable '(not (includes? (str n) "77")))

(deftest symbolic-verdict-says-z3-decided
  (let [r (v/for-all port "n" (v/int-of 0 100) '(>= n 0))]
    (is (= :oracle (:engine r)))
    (is (= "z3 decided the query" (:why r)))))

(deftest enumerated-verdict-says-finite-and-why-z3-declined
  (let [r (v/for-all port "x" (v/one-of :a :b :c) '(keyword? x))]
    (is (= :enumerate (:engine r)))
    (is (= :proven (:modality r)))
    (is (includes? (:why r) "exhausted a finite domain"))
    (is (includes? (:why r) "symbolic declined"))))

(deftest sampled-verdict-carries-seed-and-reason
  (let [r (v/for-all port "n" (v/int-of 0 100000000) untranslatable {:seed 5})]
    (is (= :sample (:engine r)))
    (is (= 5 (:seed r)))
    (is (includes? (:why r) "seed 5"))
    (is (includes? (:why r) "outside the SMT fragment"))))

(deftest same-seed-same-verdict-different-seed-different-sample
  (let [g (v/int-of 0 100000000)
        a (v/for-all port "n" g untranslatable {:seed 11})
        b (v/for-all port "n" g untranslatable {:seed 11})
        c (v/for-all port "n" g untranslatable {:seed 12})]
    (is (= :refuted (:modality a)))
    (is (= (:witness a) (:witness b)))
    (is (= 12 (:seed c)))
    ;; the seed reaches the generator: two seeds sample two different sets
    (is (not= (v/gen-sample g 11 32) (v/gen-sample g 12 32)))))

(deftest default-seed-is-zero-and-stable
  (let [r (v/for-all port "n" (v/int-of 0 100000000) untranslatable)]
    (is (= 0 (:seed r)))))
