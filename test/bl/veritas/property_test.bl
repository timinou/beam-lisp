; test/bl/veritas/property_test.bl — the OUTPUT-property assurance.
;
; veritas.property's value: RUN a function and assert over its RETURN, then SHRINK
; a counterexample to the minimal input. The core never runs the target fn — this
; is what property adds. Each behaviour is a test:
;   1. a true property over a bounded int domain holds
;   2. a false property is refuted AND shrunk to the minimal witness
;   3. a crash is reported as a first-class outcome (not swallowed)
;   4. the domain comes from a veritas generator (any-of ⇒ cross-type)
;   5. a multi-arg property draws from tuple-of

(ns veritas.property-test
  (:require [veritas.property :as p] [veritas :as v]))

; ── 1. a true property holds ─────────────────────────────────────────────────

(deftest true-property-holds
  ; doubling a non-negative int is always >= the input
  (let [src "(defn dbl [n] (* 2 n))"
        r (p/hypothesis src '(>= result n) (v/int-of 0 100) 40)]
    (is (:holds r))))

; ── 2. a false property is refuted AND shrunk ────────────────────────────────

(deftest false-property-shrinks-to-minimal
  ; claim: n*2 is always > n. False at n=0 (0 is not > 0). Shrinks to 0.
  (let [src "(defn dbl [n] (* 2 n))"
        r (p/hypothesis src '(> result n) (v/int-of 0 100) 40)]
    (is (not (:holds r)))
    (is (= 0 (:shrunk r)))               ; the minimal failing input, not the first
    (is (not (:crash r)))))

(deftest shrink-finds-boundary-not-first-hit
  ; claim: (abs n) < 50 for all n in [-100,100]. False; the SIMPLEST witness by the
  ; shrink ladder is a small-magnitude failing value, and it is deterministic.
  (let [src "(defn ident [n] n)"
        r (p/hypothesis src '(< result 50) (v/int-of 0 100) 40)]
    (is (not (:holds r)))
    (is (>= (:shrunk r) 50))             ; a genuine counterexample
    (is (<= (:shrunk r) (:witness r))))) ; shrunk is no larger than the first hit

; ── 3. a crash is a first-class outcome ──────────────────────────────────────

(deftest crash-is-reported-not-swallowed
  ; dividing by (n - n) crashes for every n; the property run reports :crash true
  (let [src "(defn boom [n] (core/quot n (- n n)))"
        r (p/hypothesis src "(int? result)" (v/int-of 1 10) 20)]
    (is (not (:holds r)))
    (is (:crash r))))

; ── 4. the domain comes from a generator — any-of spans types ────────────────

(deftest any-of-domain-witnesses-type-partiality
  ; claim: (int? n) for every n. any-of yields a float/string/… ⇒ refuted.
  (let [src "(defn ident [n] n)"
        r (p/hypothesis src "(int? n)" (v/any-of) 20)]
    (is (not (:holds r)))))

; ── 5. a multi-arg property draws from tuple-of ──────────────────────────────

(deftest tuple-domain-drives-multi-arg
  ; claim: a+b >= a for all a,b >= 0. Holds over a nonneg tuple domain.
  (let [src "(defn add [a b] (+ a b))"
        r (p/hypothesis src '(>= result a)
                        (v/tuple-of (v/int-of 0 20) (v/int-of 0 20)) 8)]
    (is (:holds r))))

(deftest tuple-domain-refutes-and-shrinks
  ; claim: a - b >= 0 for all a,b in [0,20]. False when b>a. A counterexample exists.
  (let [src "(defn sub [a b] (- a b))"
        r (p/hypothesis src '(>= result 0)
                        (v/tuple-of (v/int-of 0 20) (v/int-of 0 20)) 8)]
    (is (not (:holds r)))
    (is (vector? (:shrunk r)))))         ; the witness is a [a b] pair

(run-tests)
