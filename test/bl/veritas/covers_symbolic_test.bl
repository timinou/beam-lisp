; test/bl/veritas/covers_symbolic_test.bl — coverage as a SYMBOLIC proof.
;
; The load-bearing claim: `covers` proves totality with z3, not just sampling.
; ∀ v ∈ gen, ∃ clause whose guard accepts v ≡ ∀ v. (or guard₁ … guardₙ). When
; the guards translate to SMT and the generator constrains, that is a z3 query —
; so an INFINITE domain (which enumerate can only sample → :witnessed) is now
; genuinely :proven, and a gap is z3's counterexample, not a lucky sample.

(ns veritas.covers-symbolic-test
  (:require [veritas :as v] [z3]))

(def port (z3/open))

; ── an INFINITE domain, total guards → z3 :proven (was :witnessed) ──────────

(deftest covers-total-is-z3-proven-over-infinite-domain
  (let [total "(defn sign ([n] :when (pos? n) :p) ([n] :when (neg? n) :neg) ([n] :when (zero? n) :z))"
        r (v/covers port total (v/int-of 0 1000000))]   ; span > 10000 ⇒ infinite
    (is (= :proven (:modality r)))
    (is (= :z3 (:engine r)))))

; ── an infinite domain with a GAP → z3 :refuted with a real witness ─────────

(deftest covers-gap-is-z3-refuted-with-witness
  (let [gappy "(defn sign ([n] :when (pos? n) :p) ([n] :when (neg? n) :neg))"  ; 0 falls through
        r (v/covers port gappy (v/int-of 0 1000000))]
    (is (= :refuted (:modality r)))
    (is (= :z3 (:engine r)))
    (is (= 0 (:witness r)))))                            ; z3 finds exactly 0

; ── finite domain still proven exhaustively (regression) ────────────────────

(deftest covers-finite-still-enumerates
  (let [total "(defn sign ([n] :when (pos? n) :p) ([n] :when (neg? n) :neg) ([n] :when (zero? n) :z))"
        r (v/covers port total (v/int-of -5 5))]
    (is (= :proven (:modality r)))
    (is (= :enumerate (:engine r)))))                    ; small ⇒ exhaustive path

; ── untranslatable guard falls back honestly (no false proof) ───────────────

(deftest covers-untranslatable-guard-falls-back
  ; a guard over a non-arithmetic predicate the SMT fragment lacks → sample.
  (let [weird "(defn k ([x] :when (keyword? x) :kw) ([x] :when (int? x) :int))"
        r (v/covers port weird (v/any-of))]
    ; any-of never constrains ⇒ sampled; modality is honest (not :proven z3)
    (is (not (= :z3 (:engine r))))))

(run-tests)
