; test/bl/veritas/fault_test.bl — the fault-SPACE analysis assurance.
;
; veritas.fault's value is the DATALOG half: the fault surface as a queryable set.
; Each load-bearing query is a test:
;   1. isolate is modality-tagged; a redundant law is PROVEN implied (z3 unsat)
;   2. independent-laws splits independent / implied / undecidable
;   3. build-db + uncovered-clauses finds a suite's blind spot (not-join)
;   4. redundant-mutants groups mutants with identical violation signatures
;   5. error-for / serve inject an error named by the law it breaks

(ns veritas.fault-test
  (:require [veritas.fault :as f] [veritas.mock :as m] [z3]))

(def port (z3/open))

; A contract with a DELIBERATELY redundant law: law 2 (>= v -50) is implied by
; law 0 (>= v -40), so it cannot be broken alone.
(def band
  (m/contract-from [["v" "Int"]]
                   ['(>= v -40) '(<= v 60) '(>= v -50)]))

; ── 1. isolate: modality + proven redundancy ─────────────────────────────────

(deftest isolate-tags-modality-and-redundancy
  (let [i0 (f/isolate port band 0)
        i1 (f/isolate port band 1)
        i2 (f/isolate port band 2)]
    (is (= "sat" (:status i0)))            ; law 0 breaks alone
    (is (= :proven (:modality i0)))
    (is (not (:implied i0)))
    (is (= "sat" (:status i1)))            ; law 1 breaks alone
    (is (:implied i2))                     ; law 2 CANNOT break alone
    (is (= "unsat" (:status i2)))          ; z3-PROVEN implied
    (is (= :proven (:modality i2)))))      ; the redundancy is a proof, not a guess

; ── 2. independent-laws: the three-way split ─────────────────────────────────

(deftest independent-laws-splits-three-ways
  (let [split (f/independent-laws (f/isolate-all port band))]
    (is (= [0 1] (:independent split)))    ; laws 0 and 1 break in isolation
    (is (= [2] (:implied split)))          ; law 2 is redundant
    (is (= [] (:undecidable split)))))

; ── 3. build-db + coverage: uncovered-clauses via not-join ───────────────────

(deftest uncovered-clauses-finds-blind-spot
  ; a suite that only ever breaks law 0 leaves laws 1 and 2 uncovered
  ; -45 is in [-50,-40): it breaks ONLY law 0 (>= v -40), staying >= -50 so law 2
  ; holds. (A value like -100 would break law 2 too — the measured coverage would
  ; then correctly show [0 2], which is why isolation needs the narrow band.)
  (let [mutants [{:value {:v -45} :fault/id 0 :kind :isolated :clause 0}]
        world (f/build-db port band mutants)
        db (:db world)]
    (is (= [0] (f/covered-clauses db)))    ; only law 0 is exercised (measured)
    (is (= [1 2] (f/uncovered-clauses db))))) ; the not-join blind spot

; ── 4. redundant-mutants: identical violation signatures group ───────────────

(deftest redundant-mutants-group-by-signature
  ; two DIFFERENT values that both violate exactly law 0 → same signature
  ; -45 and -48 both break ONLY law 0 (same signature); 999 breaks only law 1.
  (let [mutants [{:value {:v -45} :fault/id 0 :kind :isolated :clause 0}
                 {:value {:v -48} :fault/id 1 :kind :isolated :clause 0}
                 {:value {:v 999} :fault/id 2 :kind :isolated :clause 1}]
        world (f/build-db port band mutants)
        groups (f/redundant-mutants (:db world))]
    ; faults 0 and 1 share the {law 0} signature; fault 2 stands alone
    (is (= 1 (count groups)))
    (is (= [0 1] (:faults (first groups))))))

; ── 5. errors on demand: named injection ─────────────────────────────────────

(deftest error-for-breaks-exactly-the-named-law
  (let [e0 (f/error-for port band 0)]
    (is (some? e0))
    ; a value wrong for law 0 must FAIL law 0 in isolation…
    (is (not (m/check port (m/contract-from [["v" "Int"]] ['(>= v -40)]) e0)))
    ; …and law 2 cannot be requested at all (implied ⇒ nil)
    (is (nil? (f/error-for port band 2)))))

(deftest serve-injects-or-answers-valid
  (let [contract (m/contract-from [["v" "Int"]] ['(and (>= v 0) (<= v 100))])
        mock (m/make-mock port contract "v")
        srv (f/make-server mock {:bad 0})]
    (let [ok (f/serve srv 42)
          bad (f/serve srv :bad)]
      (is (:ok? ok))
      (is (= 42 (:v (:value ok))))         ; a normal key → deterministic valid answer
      (is (not (:ok? bad)))                ; the injected key → an error
      (is (= 0 (:reason bad))))))          ; tagged with the law it breaks

(run-tests)
