; test/bl/veritas/shrink_test.bl — one value-directed shrinker for every layer:
; ints toward 0, strings toward shorter prefixes, vectors toward fewer then
; simpler elements, maps toward fewer keys, tuples coordinate-wise.

(ns shrink-test
  (:require [veritas :as v] [z3]))

(deftest vector-shrinks-to-the-one-element-that-matters
  (let [fail? (fn [xs] (some (fn [x] (= x 7)) xs))]
    (is (= [7] (v/shrink fail? [3 9 7 1 7 4])))))

(deftest vector-elements-shrink-in-place
  ;; fails when any element is ≥ 10: minimal is one element, exactly 10
  (let [fail? (fn [xs] (some (fn [x] (>= x 10)) xs))]
    (is (= [10] (v/shrink fail? [1 250 3])))))

(deftest string-shrinks-to-shortest-failing-prefix
  (let [fail? (fn [s] (>= (count s) 3))]
    (is (= 3 (count (v/shrink fail? "abcdefghij"))))))

(deftest map-drops-irrelevant-keys
  (let [fail? (fn [m] (= :boom (get m :k)))]
    (is (= {:k :boom} (v/shrink fail? {:a 1 :k :boom :z "x"})))))

(deftest nested-history-shrinks-commands-and-args
  ;; a "history": the bug needs an :inc whose arg is ≥ 5 somewhere after a
  ;; :reset. The shrinker is SHAPE-BLIND (it will offer `[:inc]`), so a failure
  ;; predicate over structured values must reject malformed candidates — or
  ;; the caller must shrink with a shape-aware candidate fn (veritas.model does).
  (let [well-formed? (fn [h] (every? (fn [c] (and (vector? c) (= 2 (count c)) (int? (second c)))) h))
        fail? (fn [h]
                (and (well-formed? h)
                     (let [i (first (keep-indexed (fn [i c] (if (= :reset (first c)) i nil)) h))]
                       (and (some? i)
                            (some (fn [c] (and (= :inc (first c)) (>= (second c) 5)))
                                  (drop (+ i 1) h))))))
        h [[:inc 1] [:reset 0] [:inc 2] [:inc 40] [:dec 3] [:inc 9]]]
    (is (= [[:reset 0] [:inc 5]] (v/shrink fail? h)))))

(deftest tuple-witness-keeps-its-arity
  (let [port (z3/open)
        ;; `str` keeps it out of z3; a 2-tuple over wide ints samples
        r (v/for-all port "p" (v/tuple-of (v/int-of 0 100000) (v/int-of 0 100000))
                     '(not (includes? (str (+ p_0 p_1)) "1")))]
    (is (= :refuted (:modality r)))
    (is (= 2 (count (:shrunk r))))))

(deftest candidates-are-strictly-simpler
  (is (= [] (v/shrink-candidates 0)))
  (is (= [] (v/shrink-candidates :kw)))
  (is (= [] (v/shrink-candidates "")))
  (is (every? (fn [c] (< (count c) 4)) (take 5 (v/shrink-candidates [1 2 3 4])))))
