; test/bl/veritas/theories_test.bl — every sort the translator speaks, one verb.
;
; veritas's escalator is only as wide as its GENERATOR algebra. These tests
; pin the two theories the translator always had but the gens could not bind:
;
;   1. ENUM DATATYPES  — enum-of: nullary arms are a FINITE datatype (the
;      enumerate rung proves by exhaustion); with a payload arm the domain is
;      open and the z3 rung decides. The variants map must actually REACH the
;      translator (smt-of-opts → of-source-variants) — an :engine :z3 verdict
;      on an enum predicate is the proof it did.
;   2. COLLECTION LENGTH — coll-of: the bl rung binds real vectors, the z3
;      rung reasons over <var>_len (translate-len). A length law is :proven
;      over an unbounded domain; a content predicate honestly falls to sample.
;
; The witness contract is load-bearing here: a z3 model value must come back
; as a REAL bl value (a tag keyword, a {tag payload} map, a vector of the
; modelled length) — symmetrical with what holds? evaluates, never a raw SMT
; term.

(ns veritas.theories-test
  (:require [veritas :as v] [z3] [core]))

(def port (z3/open))

; ── enums: nullary arms — a finite datatype, exhaustively provable ──────────

(deftest enum-for-all-is-z3-proven
  (let [r (v/for-all port "phase" (v/enum-of :pending :running :done)
                     '(or (= phase :pending) (= phase :running) (= phase :done)))]
    (is (= :proven (:modality r)) "an exhaustive disjunction over the whole sort")
    (is (= :z3 (:engine r)) "the variants map reached the translator — symbolic rung")))

(deftest enum-for-all-refutes-with-projected-witness
  (let [r (v/for-all port "phase" (v/enum-of :pending :running :done)
                     '(not (= phase :running)))]
    (is (= :refuted (:modality r)) "a law the sort's own members break")
    (is (= :running (:witness r)) "the z3 ctor symbol projects back to the bl keyword")))

(deftest enum-enumerates-finitely-when-pred-leaves-fragment
  (let [r (v/for-all port "phase" (v/enum-of :a :b) '(keyword? phase))]
    (is (= :proven (:modality r)) "keyword? is outside the fragment — exhaustion proves")
    (is (= :enumerate (:engine r)))
    (is (= 2 (:tried r)) "the datatype IS the domain: two constructors, two checks")))

; ── enums: a payload arm — an open domain, z3 decides, witnesses project ────

(deftest enum-payload-exists-projects-payload-witness
  (let [r (v/exists port "mode" (v/enum-of [:on :int] :off)
                    '(some? (:on mode)))]
    (is (= :proven (:modality r)) "z3 synthesizes the :on arm")
    (is (map? (:witness r)) "the payload ctor projects to a bl map, not an SMT term")
    (is (core/int? (:on (:witness r))) "the projected payload is the bound integer")))

(deftest enum-payload-law-holds-symbolically
  (let [r (v/for-all port "mode" (v/enum-of [:on :int] :off)
                     '(or (some? (:on mode)) (= mode :off)))]
    (is (= :proven (:modality r)) "every ctor satisfies the arm law — discriminant + equality")
    (is (= :z3 (:engine r)))))

(deftest enum-preds-eval-on-both-rungs
  (is (v/holds? "mode" '(some? (:on mode)) {:on 3})
      "the sampled payload map evaluates the same predicate z3 decided"))

; ── collections: the length abstraction — proven over an unbounded domain ───

(deftest coll-length-law-is-z3-proven
  (let [r (v/for-all port "c" (v/coll-of 0 5) '(<= (count c) 5))]
    (is (= :proven (:modality r)) "the length abstraction reached z3")
    (is (= :z3 (:engine r)) "count over the var became c_len arithmetic")))

(deftest coll-length-law-refutes-with-vector-witness
  (let [r (v/for-all port "c" (v/coll-of 0 9) '(<= (count c) 5))]
    (is (= :refuted (:modality r)))
    (is (vector? (:witness r)) "the c_len model value projects to a real vector")
    (is (and (>= (count (:witness r)) 6) (<= (count (:witness r)) 9))
        "the witness length violates the law; z3 picks the model, not a minimum")))

(deftest coll-exists-none-over-the-bounded-length
  (let [r (v/exists port "c" (v/coll-of 0 3) '(> (count c) 3))]
    (is (= :proven (:modality r)))
    (is (core/some? (:none r)) "no vector of length ≤3 has more than 3 elements")))

(deftest coll-content-pred-falls-to-sample
  (let [r (v/for-all port "c" (v/coll-of 0 9)
                     '(not (some (fn [x] (= x 7)) c)))]
    (is (= :refuted (:modality r)) "the sampled full-range vector contains 7")
    (is (not= :z3 (:engine r)) "content is outside the length fragment — honest fall")
    (is (core/some? (core/some (fn [x] (core/= x 7)) (:witness r)))
        "the witness is a real failing vector — its bl evaluation is what failed")))

; ── OneOf: strings are decidable — the disjunction translates ───────────────

(deftest one-of-strings-constrains
  (let [r (v/exists port "s" (v/one-of "alpha" "beta") '(= s "beta"))]
    (is (= :proven (:modality r)))
    (is (= :z3 (:engine r)) "strings are decidable — the disjunction translates")
    (is (= "beta" (:witness r)))))

; ── tuples: opts merge across children; mixing modes falls honestly ─────────

(deftest tuple-int-plus-enum-is-jointly-symbolic
  (let [r (v/for-all port "p" (v/tuple-of (v/int-of 0 3) (v/enum-of :a :b))
                     '(not (= (nth p 1) :a)))]
    (is (= :refuted (:modality r)))
    (is (= :z3 (:engine r)) "one query, two sorts — the variants map merged across children")))

(deftest tuple-coll-plus-enum-falls-to-sample
  (let [r (v/for-all port "p" (v/tuple-of (v/coll-of 0 3) (v/enum-of :a :b))
                     '(>= (count (nth p 0)) 0))]
    (is (= :witnessed (:modality r)))
    (is (= :sample (:engine r))
        "no single translator pass speaks variants + lengths — the honest fall")))
