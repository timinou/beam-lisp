; test/bl/veritas/veritas_test.bl — the modal-verb assurance.
;
; The load-bearing claims of veritas, each as a deftest:
;   1. one generator feeds three engines (z3 / enumerate / sample)
;   2. the MODALITY never lets a sample pose as a proof
;   3. exists = mock, for-all = property, covers = lint — one verb
;   4. the fault space is exists-not, and a redundant law is PROVEN implied

(ns veritas-test
  (:require [veritas :as v] [z3]))

(def port (z3/open))

; ── 1. the three engines, one query shape ───────────────────────────────────

(deftest exists-int-is-z3-proven
  (let [r (v/exists port "n" (v/int-of -90 60) '(> n 50))]
    (is (= :proven (:modality r)))
    (is (= :z3 (:engine r)))
    (is (> (:witness r) 50))))

(deftest forall-int-holds-is-z3-proven
  (let [r (v/for-all port "n" (v/int-of 0 100) '(>= n 0))]
    (is (= :proven (:modality r)))
    (is (= :z3 (:engine r)))))

(deftest forall-int-fails-is-z3-refuted-with-witness
  (let [r (v/for-all port "n" (v/int-of 0 100) '(< n 50))]
    (is (= :refuted (:modality r)))
    (is (>= (:witness r) 50))))

(deftest real-and-string-prove-via-system-smt
  (let [rr (v/exists port "r" (v/real-of 0.0 1.0) '(and (> r 0.3) (< r 0.4)))
        rs (v/exists port "s" (v/string-of "sk_" 8 16) '(str-prefix? "sk_" s))]
    (is (= :proven (:modality rr)))
    (is (= :proven (:modality rs)))))

(deftest bool-is-exhaustively-decided
  (let [r (v/for-all port "b" (v/bool-of) '(or b (not b)))]
    ; bool constrains to z3 OR enumerates finitely — either way a real proof
    (is (= :proven (:modality r)))))

(deftest one-of-enumerates-and-refutes
  (let [ok (v/for-all port "c" (v/one-of 200 404 500) '(< c 600))
        bad (v/for-all port "c" (v/one-of 200 404 500) '(= c 200))]
    (is (= :proven (:modality ok)))
    (is (= :refuted (:modality bad)))))

; ── 2. the modality discipline: gen/any can only WITNESS ────────────────────

(deftest gen-any-samples-never-proves
  (let [r (v/for-all port "x" (v/any-of) '(int? x))]
    (is (= :refuted (:modality r)))     ; a float/string/… falls through int?
    (is (= :sample (:engine r)))))       ; and it did so by SAMPLING, not proof

; ── 3. covers = the coverage lint over a function's own guards ──────────────

(deftest covers-finds-the-gap
  (let [classify "(defn classify ([n] :when (pos? n) :p) ([n] :when (neg? n) :neg))"
        r (v/covers port classify (v/int-of -5 5))]
    (is (= :refuted (:modality r)))
    (is (= 0 (:witness r)))))            ; zero is the uncovered witness

(deftest covers-is-proven-when-domain-is-finite-and-total
  (let [fixed "(defn classify ([n] :when (pos? n) :p) ([n] :when (neg? n) :neg) ([n] :when (zero? n) :z))"
        r (v/covers port fixed (v/int-of -5 5))]
    (is (= :proven (:modality r)))       ; exhaustive over a finite domain ⇒ a PROOF
    (is (= :enumerate (:engine r)))))

(deftest covers-over-any-witnesses-type-partiality
  (let [kindp "(defn kind ([x] :when (keyword? x) :kw) ([x] :when (int? x) :int) ([x] :when (string? x) :str))"
        r (v/covers port kindp (v/any-of))]
    (is (= :refuted (:modality r)))))     ; a float/vector/map has no clause

; ── 4. the fault space is exists-not; a redundant law is PROVEN implied ─────

(deftest faults-isolate-and-prove-redundancy
  (let [contract {:gen (v/int-of -100 100)
                  :laws ['(>= v -40) '(<= v 60) '(>= v -50)]}   ; law 2 implied by law 0
        r (v/faults port contract)]
    (is (= 3 (count r)))
    (is (not (:implied (nth r 0))))       ; law 0 is independently breakable
    (is (not (:implied (nth r 1))))       ; law 1 too
    (is (:implied (nth r 2)))             ; law 2 CANNOT be broken alone — redundant
    (is (= :proven (:modality (nth r 2)))))) ; and that redundancy is z3-PROVEN

(run-tests)
