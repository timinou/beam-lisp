; test/bl/veritas/model_test.bl — histories as values: generate, check every
; step, shrink the failing story, replay it exactly.

(ns veritas.model-test
  (:require [veritas.model :as vm]))

;; ── a real system with a planted bug ────────────────────────────────────────
;; A counter (an atom — a real mutable system). BUG: after a :reset, the
;; third :inc double-counts. The model says a counter counts.

(defn- buggy-counter []
  (atom {:n 0 :since-reset nil}))

(defn- inc! [sys k]
  (swap! sys (fn [s]
               (let [since (:since-reset s)
                     bump (if (= since 2) (* 2 k) k)]
                 {:n (+ (:n s) bump)
                  :since-reset (if (nil? since) nil (+ since 1))}))))

(def counter
  (vm/model "counter"
    {:state 0
     :init buggy-counter
     :commands
     {:inc   {:args (vm/int-in 1 9)
              :next (fn [s k] (+ s k))
              :run  (fn [sys k] (inc! sys k))}
      :reset {:next (fn [_ _] 0)
              :run  (fn [sys _] (reset! sys {:n 0 :since-reset 0}))}
      :read  {:run (fn [sys _] (:n @sys))}}
     :invariants
     {:agrees (fn [state sys] (= state (:n @sys)))}}))

(deftest planted-bug-is-refuted-and-shrunk-to-its-story
  (let [r (vm/check counter {:seed 1 :histories 400 :max-len 20})]
    (is (= :refuted (:modality r)))
    (is (= :agrees (:broke r)))
    ;; the minimal story: reset, then three incs (the third double-counts)
    (is (= [:reset :inc :inc :inc] (mapv first (:shrunk r))))
    ;; every arg shrunk to the simplest value the GENERATOR allows (int-in 1 9
    ;; → 1, never 0: a shrunk history must be one the model could generate)
    (is (= [[:reset nil] [:inc 1] [:inc 1] [:inc 1]] (:shrunk r)))))

(deftest a-shrunk-history-replays-to-the-same-failure
  (let [r (vm/check counter {:seed 1 :histories 400 :max-len 20})
        again (vm/replay counter (:shrunk r))]
    (is (= false (:ok again)))
    (is (= :agrees (:broke again)))))

(deftest same-seed-same-verdict
  (let [a (vm/check counter {:seed 9 :histories 300 :max-len 20})
        b (vm/check counter {:seed 9 :histories 300 :max-len 20})]
    (is (= (:witness a) (:witness b)))
    (is (= (:shrunk a) (:shrunk b)))))

;; ── a correct system: witnessed, with coverage ──────────────────────────────
;; A bounded queue, capacity 3; the model is a vector.

(def bqueue
  (vm/model "bounded-queue"
    {:state []
     :init (fn [] (atom []))
     :commands
     {:push {:args (vm/int-in 0 99)
             :pre  (fn [s _] (< (count s) 3))
             :next (fn [s x] (conj s x))
             :run  (fn [sys x] (swap! sys conj x))}
      :pop  {:pre  (fn [s _] (pos? (count s)))
             :next (fn [s _] (subvec s 1))
             :run  (fn [sys _] (swap! sys (fn [q] (subvec q 1))))}}
     :invariants
     {:same-contents (fn [s sys] (= s @sys))
      :bounded       (fn [_ sys] (<= (count @sys) 3))}
     :settle :pop
     :eventually
     {:settle-pops-one (fn [s sys] (= s @sys))}}))

(deftest correct-model-is-witnessed-never-proven
  (let [r (vm/check bqueue {:seed 3 :histories 300 :max-len 25})]
    (is (= :witnessed (:modality r)))
    (is (= 300 (:tried r)))
    (is (pos? (get (:coverage r) :push 0)))
    (is (pos? (get (:coverage r) :pop 0)))
    (is (= [] (:unexercised r)))))

(deftest preconditions-are-respected-by-generation
  ;; if :pre were ignored, :pop on an empty queue would crash subvec
  (let [r (vm/check bqueue {:seed 4 :histories 200 :max-len 25})]
    (is (= :witnessed (:modality r)))))

(deftest a-crash-in-run-is-a-refutation-named-by-command
  (let [m (vm/model "crashy"
            {:state 0 :init (fn [] (atom 0))
             :commands {:boom {:args (vm/int-in 0 5)
                               :run (fn [_ k] (if (= k 5) (throw "kaboom") :ok))}}
             :invariants {}})
        r (vm/check m {:seed 2 :histories 200 :max-len 5})]
    (is (= :refuted (:modality r)))
    (is (= :crash (:kind r)))
    (is (= [[:boom 5]] (:shrunk r)))))

(deftest a-budget-stops-early-and-says-so
  (let [r (vm/check bqueue {:seed 5 :histories 100000 :max-len 25 :budget-ms 300})]
    (is (= :witnessed (:modality r)))
    (is (< (:tried r) 100000))
    (is (includes? (:why r) "time budget"))))
