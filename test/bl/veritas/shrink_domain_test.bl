; test/bl/veritas/shrink_domain_test.bl — a shrunk counterexample must stay in
; the SUPPLIED generator's domain. The review observed `(one-of 1 31 32 33)`
; refute with witness 1 but report `:shrunk 0`, outside the set
; (performance-review.md, finding 8). The value ladder is now filtered through
; the generator's domain; the original witness is preserved beside it.

(ns veritas.shrink-domain-test
  (:require [veritas :as v] [z3]))

(deftest one-of-shrink-stays-in-the-set
  (let [port (z3/open)
        r (v/for-all port "n" (v/one-of 1 31 32 33)
                     '(not (includes? (str n) "1")))]
    (is (= :refuted (:modality r)))
    (is (= 1 (:witness r)) "the original witness is preserved")
    (is (contains? #{1 31 32 33} (:shrunk r)) "the shrunk value is a set member")
    (is (not= 0 (:shrunk r)) "never shrinks past the lower edge to 0")))

(deftest one-of-shrink-walks-to-a-smaller-member
  (let [port (z3/open)
        ;; sample order puts 31 first; the shrink walks to the failing member 1
        r (v/for-all port "n" (v/one-of 31 1 32 33)
                     '(not (includes? (str n) "1")))]
    (is (= :refuted (:modality r)))
    (is (= 1 (:shrunk r)) "walks to the smaller in-domain member, not to 0")))

(deftest int-shrink-respects-its-bounds
  (let [port (z3/open)
        r (v/for-all port "n" (v/int-of 50 100000)
                     '(not (includes? (str n) "0000")))]  ; only 100000 matches
    (is (= :refuted (:modality r)))
    (is (>= (:shrunk r) 50) "never walks below the generator's :lo")
    (is (<= (:shrunk r) 100000) "never walks above the generator's :hi")))

(deftest tuple-shrink-stays-in-child-domains
  (let [port (z3/open)
        r (v/for-all port "p" (v/tuple-of (v/int-of 0 9) (v/int-of 0 9))
                     '(not (includes? (str (+ p_0 p_1)) "18")))]
    (is (= :refuted (:modality r)))
    (is (vector? (:shrunk r)))
    (is (= 2 (count (:shrunk r))) "arity is preserved")
    (doseq [c (:shrunk r)]
      (is (and (int? c) (>= c 0) (<= c 9))
          "each coordinate stays in its child generator's domain"))))

(deftest coll-shrink-keeps-its-length-bounds
  (let [port (z3/open)
        r (v/for-all port "c" (v/coll-of 2 6)
                     '(not (some (fn [x] (= x 3)) c)))]
    (is (= :refuted (:modality r)))
    (is (>= (count (:shrunk r)) 2) "the minimum length is respected")
    (is (<= (count (:shrunk r)) 6))
    (is (some (fn [x] (= x 3)) (:shrunk r))
        "the shrunk value still exhibits the failing element")))

(defrecord NarrowUnknown [])
(extend-type NarrowUnknown v/Gen
  (gen-sample [g seed n] [7])
  (gen-enumerate [g] [7])
  (gen-constrain [g var] nil)
  (gen-tag [g] :any))

(deftest unknown-domain-retains-its-produced-witness
  (let [port (z3/open)
        r (v/for-all port "n" (->NarrowUnknown) '(= n 0))]
    (is (= :refuted (:modality r)))
    (is (= 7 (:witness r)))
    (is (= 7 (:shrunk r))
        "no generic ladder may leave a custom generator's unknown domain")))

; ── the PUBLIC shrink API, exercised STANDALONE (no escalator) ───────
;
; `shrink-coords` was deleted in the finding-8 cutover ("no in-repo callers");
; it is public API again. `shrink-in-domain` is the new public domain-preserving
; walk the escalator AND veritas.property both shrink with.

(deftest invalid-zero-witness-cannot-be-produced-standalone
  ;; the review's exact observation, on the PUBLIC walk directly (no escalator):
  ;; witness 1 from `(one-of 1 31 32 33)` must never report a shrunk 0.
  (let [g (v/one-of 1 31 32 33)
        fails? (fn [n] (not (= n 7)))]   ; false at every member — and at 0
    (is (fails? 0) "0 is outside the set but DOES falsify the query")
    (is (= 0 (v/shrink fails? 1)) "the generator-blind ladder walks out of the set")
    (is (= 1 (v/shrink-in-domain g fails? 1)) "the domain-aware walk keeps a member")
    (is (not= 0 (v/shrink-in-domain g fails? 1)))))

(deftest shrink-coords-is-public-and-keeps-arity
  ;; a generator-blind coordinate tuple walk: arity preserved, still a
  ;; counterexample. Restored after the finding-8 cutover removed it.
  (let [fails? (fn [p] (>= (+ (first p) (second p)) 10))
        r (v/shrink-coords fails? [12 7])]
    (is (= 2 (count r)) "arity is preserved")
    (is (fails? r) "the result is still a counterexample")))

(run-tests)
