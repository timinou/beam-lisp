; test/bl/veritas/property_shrink_domain_test.bl — the PROPERTY module's shrunk
; counterexample must stay in the SUPPLIED generator's domain.
;
; veritas.property used its own generator-blind ladder (v/shrink-candidates), so
; `hypothesis` over `int-of 5 100` could report a `:shrunk` of 0 — outside the
; domain, i.e. not a counterexample of the query that was asked. The module now
; walks veritas core's DOMAIN-PRESERVING ladder (`v/shrink-in-domain`), the same
; GenShrink candidates the quantifier core uses. Every `:shrunk` below is
; asserted to (a) belong to the generator's domain and (b) still falsify the
; property, while the original `:witness` is preserved beside it.
;
; The review's own reproducer (`one-of 1 31 32 33` → shrunk 0) is covered
; standalone in shrink_domain_test.bl; this file covers the property path.

(ns veritas.property-shrink-domain-test
  (:require [veritas.property :as p] [veritas :as v]))

; ── bounded numeric: never walks below :lo ──────────────────────────────────

(deftest numeric-shrink-never-leaves-its-bounds
  ;; the property is false at EVERY input; the blind ladder walked to 0. The
  ;; domain-aware walk keeps the lower bound.
  (let [r (p/hypothesis "(defn ident [n] n)" '(> result 100000)
                        (v/int-of 40 100000) 20)]
    (is (not (:holds r)))
    (is (= 40 (:witness r)) "the original witness is preserved")
    (is (>= (:shrunk r) 40) "never shrinks below the generator's :lo")
    (is (<= (:shrunk r) 100000))))

(deftest numeric-shrink-walks-while-falsifying
  ;; a genuine descent: the first witness is 100000, the walk lands on the
  ;; smallest in-domain value that still falsifies (< 50 is false ⇔ result >= 50)
  (let [r (p/hypothesis "(defn ident [n] n)" '(< result 50)
                        (v/int-of 0 100000) 20)]
    (is (not (:holds r)))
    (is (= 100000 (:witness r)))
    (is (= 50 (:shrunk r)) "walks to the boundary, not past it")
    (is (not (< (:shrunk r) 50)) "the result still falsifies the property")))

(deftest real-shrink-stays-in-its-bounds
  (let [r (p/hypothesis "(defn ident [x] x)" '(> result 100.0)
                        (v/real-of 40.0 100.0) 20)]
    (is (not (:holds r)))
    (is (>= (:shrunk r) 40.0))
    (is (<= (:shrunk r) 100.0))))

; ── a finite set, including a nonnumeric member ─────────────────────────────

(deftest one-of-shrink-stays-in-the-set-across-types
  ;; the walk may change type (100 → "bb") but never leaves the supplied set
  (let [r (p/hypothesis "(defn ident [x] x)" '(= result :never)
                        (v/one-of 100 "bb" 5) 20)]
    (is (not (:holds r)))
    (is (= 100 (:witness r)))
    (is (= "bb" (:shrunk r)) "walks to a strictly smaller-sized member")
    (is (contains? #{100 "bb" 5} (:shrunk r)) "the shrunk value is a set member")))

; ── a tuple domain: arity kept, each coordinate in its child's domain ───────

(deftest tuple-shrink-keeps-arity-and-child-domains
  (let [r (p/hypothesis "(defn add [a b] (+ a b))" '(< result 50)
                        (v/tuple-of (v/int-of 0 100000) (v/int-of 0 100000)) 8)]
    (is (not (:holds r)))
    (is (vector? (:shrunk r)))
    (is (= 2 (count (:shrunk r))) "the argument arity is preserved")
    (doseq [c (:shrunk r)]
      (is (and (int? c) (>= c 0) (<= c 100000))
          "each coordinate stays in its child generator's domain"))
    (is (not (< (+ (first (:shrunk r)) (second (:shrunk r))) 50))
        "the shrunk tuple still falsifies the property")))

; ── a length-bounded collection domain ─────────────────────────────────────

(deftest collection-shrink-keeps-its-length-bounds
  (let [r (p/hypothesis "(defn ident [c] c)" '(= (count result) 99)
                        (v/coll-of 2 6) 20)]
    (is (not (:holds r)))
    (is (>= (count (:shrunk r)) 2) "the collection's minimum length is respected")
    (is (<= (count (:shrunk r)) 6))
    (is (not= 99 (count (:shrunk r))) "the shrunk collection still falsifies")))

; ── a tag domain (enum) ────────────────────────────────────────────────────

(deftest tag-shrink-stays-in-the-enum
  (let [r (p/hypothesis "(defn flag [x] (if (= x :on) 1 0))" '(= result 1)
                        (v/enum-of :on :off) 20)]
    (is (not (:holds r)))
    (is (= :off (:witness r)))
    (is (= :off (:shrunk r)))
    (is (contains? #{:on :off} (:shrunk r)) "the shrunk witness is still a tag")))

; ── an unknown generator (Gen, no GenShrink) retains its witness ────────────

(defrecord NarrowUnknown [])
(extend-type NarrowUnknown v/Gen
  (gen-sample [g seed n] [7])
  (gen-enumerate [g] [7])
  (gen-constrain [g var] nil)
  (gen-tag [g] :any))

(deftest unknown-generator-retains-its-produced-witness
  (let [r (p/hypothesis "(defn ident [n] n)" '(= result 0) (->NarrowUnknown) 20)]
    (is (not (:holds r)))
    (is (= 7 (:witness r)))
    (is (= 7 (:shrunk r))
        "an unknown domain offers no in-domain candidates — retain the witness")))

; ── errors: a raising call is a first-class failing outcome, shrunk in domain ─

(deftest crash-witness-is-shrunk-inside-the-domain
  (let [r (p/hypothesis "(defn boom [n] (core/quot n (- n n)))" '(= result 0)
                        (v/int-of 40 100000) 20)]
    (is (not (:holds r)))
    (is (:crash r) "a raise in the target is reported, not swallowed")
    (is (>= (:shrunk r) 40) "the crash input stays in the generator's domain")))

(run-tests)
