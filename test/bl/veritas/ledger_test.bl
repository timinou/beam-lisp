; test/bl/veritas/ledger_test.bl — a verdict is a fact that outlives the session.

(ns veritas.ledger-test
  (:require [veritas :as v] [veritas.model :as vm] [veritas.ledger :as vl] [datom] [z3]))

(def port (z3/open))

(defn- tmp [] (str "/tmp/bl-ledger-" (erlang/unique_integer (to-list [:positive])) ".fjall"))

(deftest three-modalities-recorded-reopened-reported
  (let [path (tmp)
        l (vl/open path)
        proven (v/for-all port "n" (v/int-of 0 100) '(>= n 0))
        refuted (v/for-all port "n" (v/int-of 0 100000000) '(not (includes? (str n) "77")) {:seed 5})
        witnessed (vm/check (vm/model "q" {:state 0 :init (fn [] (atom 0))
                                           :commands {:tick {:next (fn [s _] (+ s 1))
                                                             :run (fn [sys _] (swap! sys inc))}}
                                           :invariants {:agree (fn [s sys] (= s @sys))}})
                            {:seed 1 :histories 20})]
    (vl/record! l proven {:claim "non-negative on 0..100" :about ["demo/square"] :by "test"})
    (vl/record! l refuted {:claim "no 77 in any decimal" :replay "bl run replay.bl" :by "test"})
    (vl/record! l witnessed {:claim "counter agrees with model" :about ["demo/tick"] :by "test"})
    (datom/close! l)
    (let [l2 (vl/open path)
          vs (vl/all l2)
          md (vl/report l2)]
      (is (= 3 (count vs)))
      (is (= #{:proven :refuted :witnessed} (into #{} (map :verdict/modality vs))))
      ;; refuted comes first, with its witness and replay line
      (is (< (index-of md "## Refuted") (index-of md "## Witnessed")))
      (is (< (index-of md "## Witnessed") (index-of md "## Proven")))
      (is (includes? md "replay: bl run replay.bl"))
      (is (includes? md "seed 5"))
      (is (includes? md "witness: "))
      (is (= 1 (count (vl/about l2 "demo/tick"))))
      (datom/close! l2))
    (File/rm_rf! path)))

(deftest an-empty-ledger-reports-nothing
  (let [l (vl/open nil)]
    (is (= "" (vl/report l)))))
