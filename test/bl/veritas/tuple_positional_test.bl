; test/bl/veritas/tuple_positional_test.bl — the tuple positional-name symmetry.
;
; The load-bearing claim: a predicate over a TupleGen may spell its coordinates
; as p_0, p_1, … (the SAME names the tuple's z3 constraint declares) and that
; source evaluates in the bl fallback too — not just in z3.
;
; Why: TupleGen/gen-constrain declares z3 consts <var>_0 <var>_1. A predicate
; written for z3 uses those names. But holds? bound only <var> (the whole
; vector), so on the sample/enumerate rung p_0 was UNBOUND → raised → the
; property spuriously :refuted. This pins the fix: positional names bind in bl.

(ns veritas.tuple-positional-test
  (:require [veritas :as v] [z3]))

(def port (z3/open))

; ── z3 rung: positional predicate proves (already worked, guards regression) ─

(deftest tuple-positional-proves-via-z3
  (let [r (v/for-all port "p" (v/tuple-of (v/int-of 0 1000) (v/int-of 0 1000))
                     '(<= p_0 (+ p_0 p_1)))]
    (is (= :proven (:modality r)))
    (is (= :z3 (:engine r)))))

; ── enumerate rung: a FINITE tuple with a positional predicate, no z3 ────────
; one-of over non-int-translatable members would drop to enumerate; here we use
; small int-of tuples but force the enumerate path by a predicate z3 can still
; take — so instead assert the bl fallback directly via holds? on positional.

(deftest positional-holds-in-bl-fallback
  ; the exact eval the sample/enumerate rung performs — must NOT raise.
  (is (= true (v/holds? "p" '(<= p_0 (+ p_0 p_1)) [3 5])))
  (is (= true (v/holds? "p" '(>= p_1 0) [3 5])))
  ; a genuinely false positional predicate returns false (not a raise)
  (is (= false (v/holds? "p" '(> p_0 p_1) [3 5]))))

; ── the whole-vector name still works alongside positional ──────────────────

(deftest whole-vector-name-coexists
  (is (= true (v/holds? "p" '(= 2 (count p)) [3 5])))
  (is (= true (v/holds? "p" '(and (= p_0 (nth p 0)) (= p_1 (nth p 1))) [3 5]))))

; ── a scalar value is unaffected (no positional binding, no crash) ──────────

(deftest scalar-value-unaffected
  (is (= true (v/holds? "n" '(>= n 0) 5)))
  (is (= false (v/holds? "n" '(< n 0) 5))))

(run-tests)
