; test/bl/veritas/mock_test.bl — the mock SERVER assurance.
;
; veritas.mock adds the three things the core cannot express. Each is a test:
;   1. DETERMINISM — the same request key yields the same response (a real server)
;   2. BOUNDARY    — z3's optimizer returns the min/max valid response
;   3. INVALID     — a response the contract forbids (adversarial, by construction)
; plus the forward round-trip (synthesize backward, verify forward) and the
; honest three-way satisfiability verdict.

(ns veritas.mock-test
  (:require [veritas.mock :as m] [z3]))

(def port (z3/open))

; A contract: a temperature reading in a plausible band, with a status code.
(def weather
  (m/contract-from
    [["temp" "Int"] ["code" "Int"]]
    ['(and (>= temp -40) (<= temp 60))
     '(and (>= code 200) (< code 300))]))

; ── 1. the server is DETERMINISTIC — same key, same response ─────────────────

(deftest server-is-deterministic
  (let [srv (m/make-mock port weather "code")
        a (m/answer srv 250)
        b (m/answer srv 250)
        c (m/answer srv 275)]
    (is (:ok? a))
    (is (= (:value a) (:value b)))              ; same key ⇒ identical response
    (is (= 250 (:code (:value a))))             ; the seed field is pinned to the key
    (is (= 275 (:code (:value c))))))           ; a different key ⇒ its own pinned response

(deftest seeded-response-is-valid
  ; a pinned response must still satisfy the whole contract
  (let [r (m/synth-seeded port weather "code" 220)]
    (is (= "sat" (:status r)))
    (is (m/check port weather (:value r)))))

; ── 2. BOUNDARY — the optimizer finds the extreme valid response ─────────────

(deftest boundary-min-and-max
  (let [lo (m/synth-boundary port weather "temp" :min)
        hi (m/synth-boundary port weather "temp" :max)]
    (is (= "sat" (:status lo)))
    (is (= "sat" (:status hi)))
    (is (= -40 (:temp (:value lo))))            ; the contract's lower edge, for free
    (is (= 60 (:temp (:value hi))))))           ; and its upper edge

; ── 3. INVALID — a response the contract FORBIDS ─────────────────────────────

(deftest invalid-violates-the-contract
  (let [r (m/synth-invalid port weather)]
    (is (= "sat" (:status r)))
    (is (not (m/check port weather (:value r))))))  ; provably outside the contract

; ── the round-trip + honest satisfiability ───────────────────────────────────

(deftest forward-check-round-trip
  (is (m/check port weather {:temp 20 :code 200}))       ; a hand value that holds
  (is (not (m/check port weather {:temp 999 :code 200})))) ; temp out of band ⇒ fails

(deftest satisfiability-is-three-way
  (is (m/satisfiable? port weather))
  (is (= "sat" (m/satisfiable-status port weather)))
  ; a contradictory contract is caught with NO impl written
  (let [broken (m/contract-from [["x" "Int"]] ['(> x 10) '(< x 5)])]
    (is (= "unsat" (m/satisfiable-status port broken)))
    (is (not (m/satisfiable? port broken)))))

(run-tests)
