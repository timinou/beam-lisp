; test/bl/seed_otp_abi_test.bl — test.seed-otp-abi.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-otp-abi
  (:require [seed] [test.bl.seed-support :as s]))

(deftest the-loader-server-publishes-its-genserver-callback-surface
  ;; `Loader.Server` is the OTP application child started before `BeamLisp.init/0`
  ;; interns one var: `BeamLisp.Application` passes the MODULE ATOM in the child
  ;; list, so OTP asks the PINNED beam for its generated `child_spec/1` and then
  ;; the GenServer callbacks. The mapping is functions-only with ONE opt —
  ;; `:behaviour :"Elixir.GenServer"` — and the beam the floor PUBLISHES must
  ;; carry the whole GenServer surface: the generated `child_spec/1` and the four
  ;; generated defaults (`handle_cast/2`, `handle_info/2`, `terminate/2`,
  ;; `code_change/3`) beside the module's own `start_link/1`, `init/1` and
  ;; `handle_call/3`. Judged from the beam's own export chunk, from the REAL
  ;; source, so the assertion cannot drift from the file the seed compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "loader-out")
        real {"Elixir.BeamLisp.Loader.Server" (Path/join root "priv/host/loader_server.bl")}
        hd (s/host-scratch "loader-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.Loader.Server.beam")
          exports (s/beam-exports beam)]
      (is (File/exists? beam) "Loader.Server is COMPILED into the floor")
      (doseq [f [["start_link" 1] ["child_spec" 1] ["init" 1] ["in_server?" 0]
                 ["run" 1] ["handle_call" 3] ["handle_cast" 2] ["handle_info" 2]
                 ["terminate" 2] ["code_change" 3]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "Loader.Server exposes " (first f) "/" (second f)))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))

(deftest the-reload-watcher-publishes-its-genserver-callback-surface
  ;; `Elixir.BeamLisp.ReloadWatcher` is the dev-only live-reload watcher the
  ;; `reload` namespace starts to turn a `.bl` save into a staged bundle edit,
  ;; so the floor must publish the watcher's whole GenServer surface at that
  ;; atom. The mapping is functions-only with ONE opt — `:behaviour` (the
  ;; `Elixir.GenServer` atom, forwarded to `compile-host-file` exactly as
  ;; `Loader.Server`'s is) — so the emitted beam records `-behaviour(GenServer)`
  ;; and every behaviour reader, OTP included, judges it as a GenServer callback
  ;; module. `use GenServer`'s generated defaults (`child_spec/1`,
  ;; `handle_cast/2`, `code_change/3`) are spelled out in the pinned source
  ;; beside the module's own `start_link/1`, `init/1`, `handle_call/3`,
  ;; `handle_info/2`, `terminate/2`, the process API (`drain/0,1`, `sync/0,1,2`)
  ;; and the reload seam (`apply_change/1,2,3`), so the floor beam's export list
  ;; is the live module's exactly. Judged from the beam's own export chunk, from
  ;; the REAL source, so the assertion cannot drift from the file the seed
  ;; compiles.
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "reload-watcher-out")
        real {"Elixir.BeamLisp.ReloadWatcher" (Path/join root "priv/host/reload_watcher.bl")}
        hd (s/host-scratch "reload-watcher-src" "" real)
        r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
    (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
    (let [beam (Path/join out "Elixir.BeamLisp.ReloadWatcher.beam")
          exports (s/beam-exports beam)]
      (is (File/exists? beam) "ReloadWatcher is COMPILED into the floor")
      (is (s/has? exports (tuple :child_spec 1))
          "the pinned beam carries use GenServer's generated child_spec/1")
      (doseq [f [["start_link" 1] ["child_spec" 1] ["init" 1] ["handle_call" 3]
                 ["handle_cast" 2] ["handle_info" 2] ["terminate" 2]
                 ["code_change" 3] ["drain" 0] ["drain" 1] ["sync" 0] ["sync" 1]
                 ["sync" 2] ["apply_change" 1] ["apply_change" 2] ["apply_change" 3]]]
        (is (s/has? exports (tuple (String/to_atom (first f)) (second f)))
            (str "ReloadWatcher exposes " (first f) "/" (second f))))
      (is (not (s/has? exports (tuple :__struct__ 0)))
          "ReloadWatcher is functions-only: the published beam carries no struct surface")
      (is (not (s/has? exports (tuple :__info__ 1)))
          "ReloadWatcher is functions-only: the published beam carries no Elixir __info__/1"))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
