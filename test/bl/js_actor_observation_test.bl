(ns js-actor-observation-test (:require [js.actor :as actor]))
(deftest common-linker-refuses-unknown-host-leaves
 (let [ctx (actor/canonical-link-context [] {} #{} (atom #{}) (atom []))]
  (is (= "H.hostRef(rt, \"state\")" ((:remote ctx) :host :state 0)))
  (is (thrown? ((:remote ctx) :host :not-a-host-leaf 0)))
  (is (= "H.ref(rt, \"js\", \"rt-receive\")" (:receive ctx)))))
(deftest bundle-requires-the-checked-namespace-graph
 (is (thrown? (actor/write-bundle! "/tmp/bl-actor-missing-graph" "never.mjs" [] []))))
