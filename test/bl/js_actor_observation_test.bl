(ns js-actor-observation-test (:require [js.actor :as actor]))
(deftest read-only-host-leaves-have-suspension-evidence
 (let [resolve (actor/suspension-resolver {})]
  (doseq [name ["state" "self"]]
   (is (resolve {:mode :remote :mod :host :fun (keyword name)})))
  (doseq [name ["park" "park-release" "wait-until" "wait-input" "run-turn"
               "set-state" "set-self" "critical-enter" "critical-leave" "not-a-host-leaf"]]
   (is (not (resolve {:mode :remote :mod :host :fun (keyword name)}))))))
(deftest direct-projection-refuses-effects-and-missing-suspension-evidence
 (let [write-node (actor/compile-one "(fn [] (host/write \"private\"))")
       state-node (actor/compile-one "(fn [] (host/state))")]
  (is (thrown? (actor/emit-projections [{:name "rt-observation" :kind :fn :node write-node}]
                 {"rt-observation" true})))
  (is (thrown? (actor/emit-projections [{:name "rt-observation" :kind :fn :node state-node}]
                 {"rt-observation" false})))
  (is (string? (actor/emit-projections [{:name "rt-observation" :kind :fn :node state-node}]
                 {"rt-observation" true})))))
