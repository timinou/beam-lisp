; bl_transport_test.bl — the warm/cold flags, the old-verb forwarder, and the
; contract the Rust launcher and this CLI share.
;
; The launcher decides cold or warm BEFORE a VM exists, so it must parse the global
; flags itself; the VM parses them again. Two parsers of one grammar drift unless a
; test holds them together, so this one reads the launcher's source.

(ns bl-transport-test
  (:require [bl.cli :as cli] [bl.deprecated :as dep] [bl.doctor] [bl.install]))

(defn- includes? [s sub] (String/contains? s sub))

(def LAUNCHER-DIR "tooling/drop/src")

(defn- rust [f] (File/read! (str LAUNCHER-DIR "/" f)))

;; ── the shared flags ────────────────────────────────────────────────────────

(deftest the-transport-flags-are-parsed-by-the-shared-table
  (is (= true (:cold (cli/parse-argv ["--cold" "version"]))))
  (is (= true (:warm (cli/parse-argv ["--warm" "version"]))))
  (is (= true (:foreground (cli/parse-argv ["realm" "start" "--foreground"]))))
  (is (= "/p" (:root (cli/parse-argv ["realm" "stop" "--root" "/p"]))))
  (is (= "missing value for --root" (:error (cli/parse-argv ["realm" "stop" "--root"])))
      "a valued flag with no value is a usage error, not a silent default"))

(deftest open-is-a-flag-the-parser-knows
  ;; `bl open NAME --open` was rejected as an unknown flag by the parser before the
  ;; verb ever saw it, so the documented desktop-opener path was unreachable.
  (is (= true (:open (cli/parse-argv ["vm" "ui" "--open"]))))
  (is (nil? (:unknown (cli/parse-argv ["realm" "open" "web" "--open"])))))

(deftest the-flags-default-to-off
  (let [st (cli/parse-argv ["version"])]
    (is (= false (:cold st)))
    (is (= false (:warm st)))
    (is (nil? (:root st)))))

;; ── where the verb is ───────────────────────────────────────────────────────

(deftest the-verb-is-found-past-the-global-flags
  (is (= 0 (cli/verb-position ["ports"])))
  (is (= 1 (cli/verb-position ["--cold" "ports"])))
  (is (= 2 (cli/verb-position ["-p" "lib" "ports"])) "a valued flag's value is not the verb")
  (is (= 2 (cli/verb-position ["--root" "/p" "realm" "stop"])))
  (is (nil? (cli/verb-position ["--cold"])) "flags only: there is no verb")
  (is (nil? (cli/verb-position ["--" "ports"])) "after -- everything belongs to the program"))

;; ── one grammar, two parsers ────────────────────────────────────────────────

(defn- rust-valued-flags
  "The flag spellings the launcher's `verb_index` treats as taking a value, read
   from its source: the string literals in the VALUED array, plus the named
   consts it lists (resolved against transport.rs)."
  []
  (let [src (rust "launcher.rs")
        a (index-of src "const VALUED")
        body (subs src a (+ a (index-of (subs src a) "];")))
        literals (map second (re-seq #"\"(-{1,2}[a-z-]+)\"" body))
        named (map second (re-seq #"\b([A-Z_]+_FLAG)\b" body))
        t (rust "transport.rs")
        resolve (fn [n] (second (re-find (re-pattern (str "const " n ": &str = \"([^\"]+)\"")) t)))]
    (set (concat literals (map resolve named)))))

(deftest the-launcher-and-the-vm-agree-on-which-flags-take-a-value
  (is (= cli/VALUED-FLAGS (rust-valued-flags))
      "a flag taking a value in one parser and not the other makes its value a VERB in that one"))

(deftest the-launchers-flag-names-are-the-parsers
  (let [t (rust "transport.rs")]
    (doseq [f ["--cold" "--warm" "--root" "--foreground"]]
      (is (includes? t (str "\"" f "\"")) (str "the launcher must spell " f))
      (is (nil? (:unknown (cli/parse-argv [f "x"]))) (str "and the VM must accept " f)))))

;; ── the old verbs forward ───────────────────────────────────────────────────

(deftest every-old-spelling-forwards-to-a-verb-that-exists
  (testing "the target of each row is a registered command"
    (doseq [row dep/TABLE]
      (let [target (first (second row))]
        (is (contains? cli/commands target)
            (str "`" (join " " (first row)) "` forwards to `" target "`, which must be a command"))))))

(deftest an-old-spelling-is-rewritten-and-announced
  (is (= ["vm"] (dep/forward ["ports"])))
  (is (= "bl: `bl ports` is deprecated; use `bl vm`" (dep/notice ["ports"])))
  (is (= ["realm" "start"] (dep/forward ["daemon" "start"])))
  (is (= ["vm" "start" "gateway" "--foreground"] (dep/forward ["gateway" "run"]))))

(deftest a-current-spelling-passes-through-untouched
  (is (= ["vm" "stop" "abc"] (dep/forward ["vm" "stop" "abc"])))
  (is (nil? (dep/notice ["vm" "stop" "abc"])))
  (is (= ["test" "x.bl"] (dep/forward ["test" "x.bl"]))))

(deftest the-most-specific-prefix-wins
  (is (= ["realm" "start"] (dep/forward ["daemon" "start"])) "not `daemon` => `realm show`")
  (is (= ["realm" "show"] (dep/forward ["daemon"])))
  (is (= ["realm" "show"] (dep/forward ["daemon" "status"]))))

(deftest the-words-after-the-prefix-carry-over
  (is (= ["realm" "open" "web" "--open"] (dep/forward ["open" "web" "--open"])))
  (is (= ["vm" "start" "gateway" "--foreground" "--port" "0"] (dep/forward ["gateway" "run" "--port" "0"]))))

(deftest the-retired-verbs-are-no-longer-registered
  (testing "the dispatch table holds nouns; the forwarder holds the old words"
    (doseq [old ["daemon" "ports" "open" "ui" "gateway"]]
      (is (not (contains? cli/commands old)) (str old " is a deprecated spelling, not a command")))))

(deftest help-lists-every-registered-command-and-only-those
  (testing "a verb that runs but cannot be found, or is listed but cannot run"
    (let [listed (set (mapcat second cli/usage-groups))]
      (doseq [c (keys cli/commands)]
        (is (contains? listed c) (str c " runs but `bl` does not list it"))
        (is (some? (get cli/command-help c)) (str c " has no help line")))
      (doseq [c listed]
        (is (contains? cli/commands c) (str c " is listed but cannot run"))
        (is (some? (get cli/command-help c)) (str c " is listed with a blank help row"))))))

;; ── a stale unit is found, and reported with its fix ────────────────────────

(deftest a-command-line-with-an-old-spelling-is-recognised
  (is (= {:old "gateway run" :new "vm start gateway --foreground"}
         (dep/stale-in "/home/u/.local/bin/bl gateway run")))
  (is (= {:old "daemon start" :new "realm start"} (dep/stale-in "/usr/bin/bl daemon start")))
  (is (nil? (dep/stale-in "/home/u/.local/bin/bl vm start gateway --foreground"))
      "the current spelling is never reported")
  (is (nil? (dep/stale-in "/home/u/.local/bin/bl")) "no words after the executable"))

(defn- with-unit [exec f]
  (let [prev (System/get_env "XDG_CONFIG_HOME")
        cfg (str "/tmp/bl-unit-test-" (erlang/unique_integer (list :positive)))]
    (File/mkdir_p! (str cfg "/systemd/user"))
    (when exec
      (File/write! (str cfg "/systemd/user/bl-gateway.service")
                   (str "[Service]\nType=simple\nExecStart=" exec "\nRestart=on-failure\n")))
    (System/put_env "XDG_CONFIG_HOME" cfg)
    (try (f)
         (finally
           (if (nil? prev) (System/delete_env "XDG_CONFIG_HOME") (System/put_env "XDG_CONFIG_HOME" prev))
           (File/rm_rf! cfg)))))

(defn- unit-probe []
  (first (filter (fn [p] (= "gateway unit" (:name p))) (bl.doctor/probes))))

(deftest doctor-reports-a-unit-the-installer-wrote-before-the-rename
  (with-unit "/home/u/.local/bin/bl gateway run"
    (fn []
      (let [p (unit-probe)]
        (is (some? p))
        (is (= false (:ok p)))
        (is (includes? (:detail p) "bl install gateway"))
        (is (includes? (:detail p) "vm start gateway --foreground"))))))

(deftest doctor-is-quiet-about-a-current-or-absent-unit
  (with-unit "/home/u/.local/bin/bl vm start gateway --foreground"
    (fn [] (is (= true (:ok (unit-probe))))))
  (with-unit nil
    (fn [] (is (= "not installed" (:detail (unit-probe)))))))

(deftest the-installer-writes-the-spelling-doctor-accepts
  (testing "what `bl install gateway` writes is not itself reported as stale"
    (let [text (bl.install/unit-text "/home/u/.local/bin/bl")
          exec (first (filter (fn [l] (String/starts_with? l "ExecStart=")) (String/split text "\n")))]
      (is (nil? (dep/stale-in (subs exec (count "ExecStart=")))))
      (is (includes? exec "vm start gateway --foreground")))))

(run-tests)
