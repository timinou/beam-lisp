; test/bl/seed_publication_test.bl — test.seed-publication.
;
; Split from test/bl/seed_test.bl so each file stays under the runner's 300 s
; per-file bound. Shared helpers live in test.bl.seed-support.

(ns test.seed-publication
  (:require [seed] [test.bl.seed-support :as s]))

(deftest run-publishes-every-pinned-host-beam-and-check-judges-it
  (let [root (BeamLisp/cwd)
        ebin (Path/join root "build")
        out (s/scratch "host-out")
        hd (s/host-scratch "host-src" "")
        hosts (seed/host-sources hd)
        nss (map (fn [e] (str (:module e))) hosts)
        beams (map (fn [e] (seed/host-beam e)) hosts)]
    (let [r (s/seed-run! {:root root :out out :ebin ebin :host hd})]
      (is (:ok? r) (str "the floor is generated: " (pr-str (:errors r))))
      (doseq [b beams]
        (is (File/exists? (Path/join out b))
            (str b " is COMPILED into the floor, not copied from an ebin")))
      ; INVENTORY: the DATA-ONLY manifest must LIST every host beam, or
      ; `Bootstrap.install!/1` never copies it and the floor silently lacks the
      ; host leaf it carries. It is read here the way the pre-`elixirc` stage
      ; reads it — `file:consult/1` over an Erlang term, never `Code.eval_file`
      ; — because a manifest that must be EVALUATED to be read is a program.
      (let [manifest (s/term-manifest (Path/join out "manifest.term"))]
        (doseq [b beams]
          (is (some? (get (get manifest "modules") b))
              (str b " is in the manifest's module map")))
        ; INVENTORY: the manifest must NAME its host beams as data — the
        ; host-sources mapping's filenames, in the table's own order — so a
        ; consumer selects host beams by the list, not by a name prefix. The
        ; list is what lets a pinned leaf outside `Elixir.BeamLisp.*` be staged.
        (is (erlang/is_list (get manifest "hosts"))
            "the manifest inventory is a plain Erlang list, not a BL Vector")
        (is (= (seed/host-names hosts) (get manifest "hosts"))
            (str "the manifest's `hosts` list is the mapping's filenames in table order, got "
                 (pr-str (get manifest "hosts"))))
        (is (not (File/exists? (Path/join out "manifest.exs")))
            "the seed writes only data, never an executable Elixir manifest")))
    ; THE MACRO ABI of the PUBLISHED Decimal beam. `:macro-exports` is the whole
    ; difference between a plain function named `MACRO-is_decimal` and a macro a
    ; `require`d caller can expand, and the floor's beam must carry BOTH halves:
    ; the implementer as an EXPORT and `{is_decimal, 1}` in `__info__(:macros)`.
    ; The atom names a LIVE host leaf in this VM, so the beam is read by swapping
    ; it in, reading it, and restoring the live module.
    (let [decimal-beam (Path/join out "Elixir.BeamLisp.Decimal.beam")]
      (is (s/has? (s/beam-exports decimal-beam) (tuple :"MACRO-is_decimal" 2))
          "the published Decimal beam exports the MACRO-is_decimal/2 implementer")
      (is (s/has? (s/beam-exports decimal-beam) (tuple :seeded-probe 1))
          "and the fixture's own defn, so the beam read here is the one this run compiled")
      (is (erlang/== (list (tuple :is_decimal 1))
                     (s/with-swapped-module :"Elixir.BeamLisp.Decimal" decimal-beam
                       (fn [m] (erlang/apply m :__info__ (list :macros)))))
          "and advertises it through __info__(:macros), so `require BeamLisp.Decimal` expands is_decimal/1"))
    (let [c (s/seed-check! {:root root :out out :host hd})]
      (is (:ok? c) (str "a floor generated from this source is current: " (pr-str (:moved c))))
      (doseq [n nss]
        (is (s/has? (:current c) n) (str n " is judged current"))))
    (File/rm_rf! out)
    (File/rm_rf! hd)))
