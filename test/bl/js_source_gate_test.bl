(ns bl.js.source-gate-test)

(deftest shared-runtime-native-source-hooks-resolve-without-inventing-js-authority
 (let [script (str
   "import assert from 'node:assert/strict';\n"
   "import {pathToFileURL} from 'node:url';\n"
   "const {LEAVES}=await import(pathToFileURL(process.argv[1]));\n"
   "for(const [name,arity] of [['check_source_callable!',1],['check_source_invocation!',2],['check_source_invocation1!',2],['check_source_invocation2!',3]]) {\n"
   " const key='Elixir.BeamLisp.Env/'+name+'/'+arity;\n"
   " assert.equal(typeof LEAVES[key],'function');\n"
   " assert.equal(LEAVES['erlang/function_exported/3']('Elixir.BeamLisp.Env',name,arity),false);\n"
   " assert.throws(()=>LEAVES[key](...Array(arity).fill(null)),/BEAM Source execution is unavailable/);\n"
   "}\nconsole.log('JS_SOURCE_HOOKS_OK');\n")
       root (or (System/get_env "BL_TEST_SOURCE_ROOT") (BeamLisp/cwd))
       result (System/cmd "node" (list "--input-type=module" "-e" script
                                   (Path/join root "priv/lib/js/leaves.mjs"))
                              (list (tuple :stderr_to_stdout true)))]
  (is (= 0 (elem result 1)) (elem result 0))
  (is (String/contains? (elem result 0) "JS_SOURCE_HOOKS_OK"))))
