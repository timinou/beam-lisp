; convey_arity_test.bl — delegated callbacks keep their arity.
;
; `BeamLisp.Env/convey` (what the loader's `delegate` uses) wrapped EVERY
; callback as arity 1, so `(delegate (fn [] (listen! …)))` came back as an
; arity-1 fn and a later `(erlang/is_function install 0)` guard failed at
; application startup. It now conveys a 0-arity fun as 0-arity.
;
; env.bl is a PINNED host leaf (the floor's beam runs in this VM), so the
; current source is compiled and exercised in a child VM, like
; namespace_readiness_fast_path_test.bl. After the floor is regenerated the
; behaviour holds in every VM.
;
; Run: bl test test/bl/convey_arity_test.bl
(ns convey-arity-test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(deftest convey-preserves-callback-arity
  (let [dir (str (System/tmp_dir!) "/bl_convey_" (erlang/unique_integer (list :positive)))
        out (str dir "/ebin")
        script (Path/join (BeamLisp/cwd) "test/fixtures/convey_arity_child.bl")]
    (try
      (BeamLisp.AOT/compile_host_file "priv/host/env.bl"
        (list (t2 :module :Elixir.BeamLisp.Env) (t2 :output_dir out) (t2 :load? false)))
      (BeamLisp.AOT/compile_host_file script
        (list (t2 :module :Elixir.BeamLisp.Test.ConveyChild) (t2 :output_dir out) (t2 :load? false)))
      (let [args (concat (mapcat (fn [p] (list "-pa" (erlang/list_to_binary p))) (code/get_path))
                         (list "-pa" out "-e" "BeamLisp.Test.ConveyChild.run()"))
            r (System/cmd "elixir" (to-list args) (to-list [(tuple :stderr_to_stdout true)]))
            text (elem r 0)]
        (is (String/contains? text (str "env-beam=" out)) text)
        (is (String/contains? text "check-zero-arity-stays-zero=ok") text)
        (is (String/contains? text "check-one-arity-stays-one=ok") text)
        (is (String/contains? text "check-zero-arity-binds-the-callers-env=ok") text)
        (is (String/contains? text "semantics=ok") text))
      (finally (File/rm_rf! dir)))))
