; Runtime-built callback names must match reader-built qualified symbols.
(ns symbol-name-test)
(deftest symbol-construction-preserves-qualified-identity
 (is (= 'provider/perform (symbol "provider/perform")))
 (is (= 'provider/perform (symbol 'provider/perform)))
 (is (= (symbol "provider" "perform") (symbol "provider/perform")))
 (is (= 'perform (symbol "perform")))
 (is (= 'perform (symbol nil "perform"))))
