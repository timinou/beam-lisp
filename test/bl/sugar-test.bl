; test/bl/sugar-test.bl — the threading/cond macros in priv/boot/sugar.bl.
; Run: mix beam_lisp.test test/bl/sugar-test.bl
;
; These are all default-loaded and referred unqualified (no require above), so
; the suite doubling as a check that the `sugar` layer is wired into init and
; the Env fallback. Each assertion pins the property a plausible-wrong
; expansion would violate: cond->'s value-not-boolean threading, some->'s
; short-circuit (it must NOT call the next step on nil), when-some binding
; false where when-let would not.

(ns sugar.test)

;; ── cond-> / cond->> ─────────────────────────────────────────────────────────

(deftest cond->-threads-only-passing-clauses
  (is (= {:a 1} (cond-> {} true (assoc :a 1) false (assoc :b 2))))
  (is (= {:a 1 :b 2} (cond-> {} true (assoc :a 1) true (assoc :b 2))))
  ; the VALUE flows, not a boolean — a passing clause threads the running value
  (is (= 12 (cond-> 5 true inc (= 6 6) (* 2)))))

(deftest cond->-empty-clauses-is-identity
  (is (= 5 (cond-> 5))))

(deftest cond->>-threads-into-last
  (is (= (list 0 1 2) (cond->> (list 1 2) true (cons 0))))
  (is (= 7 (cond->> 3 true (- 10)))))

;; ── as-> ─────────────────────────────────────────────────────────────────────

(deftest as->-threads-by-name
  (is (= 9 (as-> 5 $ (+ $ 1) (* 2 $) (- $ 3))))
  ; position varies: first here, last there
  (is (= 4 (as-> 10 v (- v 2) (/ v 2)))))

;; ── some-> / some->> ─────────────────────────────────────────────────────────

(deftest some->-stops-at-nil
  (is (= 1 (some-> {:a {:b 1}} :a :b)))
  (is (= nil (some-> {:a {:b 1}} :x :b)))
  ; the short-circuit is SEMANTIC: :b is never called on nil. If it were, this
  ; would throw rather than return nil.
  (is (= nil (some-> nil inc))))

(deftest some->>-threads-into-last-until-nil
  (is (= 6 (some->> (list 1 2 3) (reduce +))))
  (is (= nil (some->> (get {} :missing) (map inc)))))

;; ── condp ────────────────────────────────────────────────────────────────────

(deftest condp-matches-by-shared-predicate
  (is (= :two (condp = 2 1 :one 2 :two 3 :three :many)))
  (is (= :one (condp = 1 1 :one 2 :two :many))))

(deftest condp-default-and-no-match
  (is (= :many (condp = 9 1 :one 2 :two :many)))
  ; no default and no match raises rather than returning nil
  (is (thrown? (condp = 9 1 :one 2 :two))))

;; ── doto ─────────────────────────────────────────────────────────────────────

(deftest doto-runs-side-effects-returns-x
  (let [a (doto (atom 0) (swap! inc) (swap! inc))]
    (is (= 2 (deref a))))
  ; returns the ORIGINAL value, not the last form's result
  (let [v (doto (atom :kept) (swap! (fn [_] :changed)))]
    (is (= :changed (deref v)))))

;; ── when-some / if-some ──────────────────────────────────────────────────────

(deftest when-some-binds-false-but-not-nil
  ; the whole point vs when-let: false is a value, nil is absence
  (is (= "got false" (when-some [v false] (str "got " v))))
  (is (= nil (when-some [v nil] "unreached")))
  (is (= 3 (when-some [v 3] v))))

(deftest if-some-branches-on-nil-only
  (is (= "then" (if-some [v false] "then" "else")))   ; false → then
  (is (= "else" (if-some [v nil] "then" "else")))
  (is (= 7 (if-some [v 7] v :else))))

;; ── fnil ─────────────────────────────────────────────────────────────────────

(deftest fnil-patches-nil-args
  (is (= 5 ((fnil + 0) nil 5)))
  (is (= [1] ((fnil conj []) nil 1)))
  ; a non-nil arg passes through untouched
  (is (= 8 ((fnil + 0) 3 5)))
  ; two- and three-arg patch arities
  (is (= 3 ((fnil + 1 1) nil nil 1)))
  (is (= 6 ((fnil + 1 2 3) nil nil nil))))
