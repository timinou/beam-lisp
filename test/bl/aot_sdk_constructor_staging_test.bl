(ns aot-sdk-constructor-staging-test)

(defmacro inspection-only [] (erlang/error :macro-kind-inspection-executed-body))

(defn- fixture [action]
 (let [dir (str (System/get_env "HOME") "/tmp/sdk-constructor-"
                (System/unique_integer (list :positive)))]
  (File/mkdir_p! dir)
  (try (action dir) (finally (File/rm_rf! dir)))))

(defn- provider-registry-snapshot []
 (let [binding (BeamLisp.Env/lookup (tuple "proc.server" "registry"))]
  (if (= :error binding) :uninitialized
   ;; Read an already present binding only: lookup does not load its namespace.
   ;; Keep both its exact cell and contents, catching mutation/replacement.
   [binding (deref (second binding))])))

(defn- own-code-lease-count []
 (if (= :undefined (ets/whereis :beam_lisp_code_leases)) 0
  (erlang/length (ets/match_object :beam_lisp_code_leases
            (tuple (tuple :_ (erlang/self) :_) true)))))

(deftest ordinary-compilation-does-not-have-sdk-constructor-authority
 (is (= :inactive (BeamLisp.AOT/staged_macro_lookup "user" "when")))
 (is (= :inactive (BeamLisp.AOT/staged_macro_kind "user" "when")))
 (is (not (BeamLisp.AOT/constructor_metadata_compiling?))))

(deftest ordinary-macro-kind-inspection-never-invokes-the-expander
 (let [env (BeamLisp.Compiler/new_env "aot-sdk-constructor-staging-test")]
  (is (= true (erlang/apply :Elixir.BeamLisp.Ns.Compiler :macro?
                (list env "inspection-only"))))
  (is (= false (erlang/apply :Elixir.BeamLisp.Ns.Compiler :macro?
                 (list env "not-a-declaration"))))))

(deftest source-declaration-fold-uses-native-element-then-accumulator-order
 ;; Directly pin the native Enum.reduce boundary that the real SDK closure
 ;; scanner crosses before any source initializer or macro can run.
 (let [forms (BeamLisp.Reader/read_string
               "(ns scan.fixture) (defn first-binding [x] x) (def value 7) (defmacro syntax [] nil) (File/write! \"never\" \"run\")")
       declarations (BeamLisp.AOT/constructor_source_definitions forms)]
  (is (= #{"first-binding" "value" "syntax"} (set (keys declarations))))
  (is (= "defn" (:head (get declarations "first-binding"))))
  (is (= "defmacro" (:head (get declarations "syntax"))))))

(deftest an-sdk-filename-with-different-source-refuses-before-effects
 (fixture
  (fn [dir]
   (let [file (BeamLisp.Loader/source_path "vm.owner") marker (str dir "/never-written")
         source (str "(ns vm.owner) (File/write! " (pr-str marker) " \"bad\")")
         before (BeamLisp.Env/capture)]
    (is (= :unattested-sdk-constructor-source
           (try (BeamLisp.AOT/compile_source source
                  (list (tuple :file file) (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true))) nil
                (catch e (:kind (ex-data e))))))
    (is (= false (File/exists? marker)))
    (is (= before (BeamLisp.Env/capture)))
    (is (= :inactive (BeamLisp.AOT/staged_macro_lookup "user" "when")))))))

(deftest actual-qualified-sdk-actor-source-compiles-without-provider-initialization
 ;; Exercise the real first ordinary-launcher frontier. No fake macro binding,
 ;; provider prewarm, startup callback or application declaration is required.
 (fixture
  (fn [dir]
   (let [file (BeamLisp.Loader/source_path "vm.owner")
         before (BeamLisp.Env/capture)
         provider-before (BeamLisp.Env/loaded_ns? "proc.server")
         registry-before (provider-registry-snapshot)
         leases-before (own-code-lease-count)
         receipt (BeamLisp.Loader/without_initialization
                  (BeamLisp.Env/as_thunk
                   #(BeamLisp.AOT/stage_sdk_dependency! "vm.owner" file
                      (BeamLisp.Emit/module_for "vm.owner"))))]
    ;; The real producer owns recursive prerequisite receipts, rather than
    ;; depending on an earlier test's manual SDK initialization or emission.
    (is (and (map? receipt) (BeamLisp.AOT/sdk_unit_compiled? "vm.owner")))
    (is (= provider-before (BeamLisp.Env/loaded_ns? "proc.server")))
    (is (= registry-before (provider-registry-snapshot)))
    (is (= leases-before (own-code-lease-count)))
    (is (= before (BeamLisp.Env/capture)))
    (is (= :inactive (BeamLisp.AOT/staged_macro_lookup "user" "when")))))))

(deftest trusted-compiler-runtime-does-not-borrow-a-mutable-core-callable
 (fixture
  (fn [dir]
   (let [file (BeamLisp.Loader/source_path "vm.owner")
         binding (BeamLisp.Env/lookup (tuple "core" "list"))
         marker (str dir "/mutable-core-callback")
         shadow (fn [& _] (File/write! marker "ran") nil)
         before (BeamLisp.Env/capture) leases-before (own-code-lease-count)]
    (try
     (BeamLisp.Env/intern "core" "list" shadow)
     ;; Use the actual recursive SDK producer: required units gain complete
     ;; emission receipts before compilation; none are manually initialized.
     (BeamLisp.Loader/without_initialization
      (BeamLisp.Env/as_thunk
       #(BeamLisp.AOT/stage_sdk_dependency! "vm.owner" file
          (BeamLisp.Emit/module_for "vm.owner"))))
     (is (= false (File/exists? marker)))
     (is (= (tuple :ok shadow) (BeamLisp.Env/lookup (tuple "core" "list"))))
     (is (= before (BeamLisp.Env/capture)))
     (is (= leases-before (own-code-lease-count)))
     (finally (BeamLisp.Env/intern "core" "list" (second binding))))))))


(deftest canonical-native-namespace-is-not-invented-as-a-source-unit
 (is (= nil (BeamLisp.AOT/constructor_source_owner "cpp" "jank.runtime.keyword"))))
