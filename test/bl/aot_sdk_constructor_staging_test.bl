(ns aot-sdk-constructor-staging-test)

(defn- fixture [action]
 (let [dir (str (System/get_env "HOME") "/tmp/sdk-constructor-"
                (System/unique_integer (list :positive)))]
  (File/mkdir_p! dir)
  (try (action dir) (finally (File/rm_rf! dir)))))

(deftest ordinary-compilation-does-not-have-sdk-constructor-authority
 (is (= :inactive (BeamLisp.AOT/staged_macro_lookup "user" "when")))
 (is (not (BeamLisp.AOT/constructor_metadata_compiling?))))

(deftest an-sdk-filename-with-different-source-refuses-before-effects
 (fixture
  (fn [dir]
   (let [file (BeamLisp.Loader/source_path "vm.owner") marker (str dir "/never-written")
         source (str "(ns vm.owner) (File/write! " (pr-str marker) " \"bad\")")
         before (BeamLisp.Env/capture)]
    (is (= :unattested-sdk-constructor-source
           (try (BeamLisp.AOT/compile_source source
                  (list (tuple :file file) (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true))) nil
                (catch e (:kind (ex-data e))))))
    (is (= false (File/exists? marker)))
    (is (= before (BeamLisp.Env/capture)))
    (is (= :inactive (BeamLisp.AOT/staged_macro_lookup "user" "when")))))))

(deftest actual-qualified-sdk-actor-source-compiles-without-provider-initialization
 ;; Exercise the real first ordinary-launcher frontier. No fake macro binding,
 ;; provider prewarm, startup callback or application declaration is required.
 (fixture
  (fn [dir]
   (let [file (BeamLisp.Loader/source_path "vm.owner") source (File/read! file)
         before (BeamLisp.Env/capture)
         provider-before (BeamLisp.Env/loaded_ns? "proc.server")
         beams (BeamLisp.AOT/compile_source source
                (list (tuple :file file) (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true)))]
    (is (seq beams))
    (is (= provider-before (BeamLisp.Env/loaded_ns? "proc.server")))
    (is (= before (BeamLisp.Env/capture)))
    (is (= :inactive (BeamLisp.AOT/staged_macro_lookup "user" "when")))))))
