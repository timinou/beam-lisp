(ns aot-inventory-cold-decode-test)
(deftest compiler-inventory-decodes-in-a-fresh-vm-before-sdk-modules-load
 (let [dir (str (System/tmp_dir!) "/sdk-cold-inventory-" (erlang/unique_integer (list :positive)))
       file (str dir "/fixture.bl") out (str dir "/ebin") inventory (str dir "/sdk-code.term")
       source "(ns cold.inventory.fixture) (defn unique-inventory-route [xs] (map (fn [x] (+ x 1)) xs)) (defserver worker (init [x] (ok x)))"
       token (BeamLisp.Env/capture)]
  (try
   (File/mkdir_p! dir) (File/write! file source)
   (let [beams (BeamLisp.AOT/compile_source source (list (tuple :file file) (tuple :output_dir out) (tuple :stage-sdk? true)))
         _ (BeamLisp.AOT/write_sdk_inventory! dir {file {:modules (mapv #(elem % 0) beams)}} out inventory)
         rows (:modules (erlang/binary_to_term (File/read! inventory) (list :safe)))
         host-dir (Path/dirname (List/to_string (code/which :Elixir.BeamLisp.AOT)))
         child "Code.ensure_loaded!(BeamLisp.AOT); [path] = System.argv(); data = :erlang.binary_to_term(File.read!(path), [:safe]); IO.puts(map_size(data.modules))"
         result (System/cmd "elixir" (list "--erl" "+S 2:2" "-pa" host-dir "-e" child inventory))]
    (is (every? (fn [row] (and (not (contains? row :binding-routes)) (not (contains? row :lambda-routes)))) (vals rows)))
    (is (= 0 (elem result 1)))
    (is (= (str (count rows)) (String/trim (elem result 0)))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))
