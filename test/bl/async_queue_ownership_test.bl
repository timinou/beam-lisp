(ns async.queue-ownership-test
 (:require [anf :as a] [lower :as lower] [proc.queue :as queue]))

(defn descriptor [mod]
 (a/module mod
  (list {:op :defn-clause :fname :perform :params (list (a/pvar "job"))
         :guard nil :body (a/var "job") :ann {}})
  (list [:perform 1]) (list)))
(defn wait-dead [pid]
 (let [ref (erlang/monitor :process pid)]
  (receive [:DOWN seen :process _ _] :when (= ref seen) true (after 10000 (do (erlang/demonitor ref (list :flush)) false)))))
(defn register-owner [mod parent]
 ;; Queue is loaded in the test Env; managed spawn conveys that scope and
 ;; owns the worker wrapper while the callback registration is staged.
 (BeamLisp.Refs/spawn_exec
  (fn []
   (queue/register-perform! 'same-name (erlang/make_fun mod :perform 1))
   (erlang/send parent [:registered (erlang/self)])
   (receive
    [:replace next]
    (do (queue/register-perform! 'same-name (erlang/make_fun next :perform 1))
        (erlang/send parent :replaced)
        (receive :stop nil))
    :stop nil))))

(deftest retained-queue-performs-have-process-local-lifetimes
 (let [one :bl_queue_callback_one two :bl_queue_callback_two
       three :bl_queue_callback_replacement parent (erlang/self)]
  (doseq [mod [one two three]] (lower/reload-descriptor! (descriptor mod)))
  (let [owner1 (register-owner one parent) owner2 (register-owner two parent)]
   (try
    (is (erlang/is_pid (receive [:registered p] p (after 10000 nil))))
    (is (erlang/is_pid (receive [:registered p] p (after 10000 nil))))
    (is (not (BeamLisp.Env/retire_module! one)))
    (is (not (BeamLisp.Env/retire_module! two)) "same server name has a distinct local owner")
    (erlang/send owner1 [:replace three])
    (is (= :replaced (receive :replaced :replaced (after 10000 :timeout))))
    (is (BeamLisp.Env/retire_module! one) "replacement releases the superseded callback")
    (is (not (BeamLisp.Env/retire_module! three)))
    (erlang/send owner1 :stop)
    (is (wait-dead owner1))
    (is (BeamLisp.Env/retire_module! three))
    (is (not (BeamLisp.Env/retire_module! two)))
    (erlang/send owner2 :stop)
    (is (wait-dead owner2))
    (is (BeamLisp.Env/retire_module! two))
    (finally
     (doseq [pid [owner1 owner2]] (when (Process/alive? pid) (erlang/exit pid :kill)))
     (doseq [mod [one two three]] (BeamLisp.Env/retire_module! mod)))))))
