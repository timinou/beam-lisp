; source_graph_test.bl — the namespace graph's contract, pinned at its source.
;
; Ported from the ExUnit `test/beam_lisp/source_graph_test.exs`. Those tests ran
; through the Elixir façade `BeamLisp.SourceGraph`; here they call
; `priv/build/source-graph.bl` DIRECTLY — the namespace used by the build
; plan and reload gate — with no Elixir seam in the path.
;
; Three contracts, each the one implementation the build depends on:
;
;   header         one file's node: its ns and direct requires. Read by the real
;                  reader, so a `:require` in a comment or a string is NEVER an
;                  edge — the exact trap raw-text scanning falls into.
;   cycles         every reachable require cycle, named as a closed path. The
;                  BUG-064 substrate/application shape is the one that shipped.
;   closure/hash   a ns's transitive requires and the sha256 freshness key over
;                  them; an unresolvable member is a distinct STABLE
;                  contribution (`ns:?`), never a silent hole.
;
; Run: bl test test/bl/source_graph_test.bl

(ns source-graph.test
  (:require [source-graph :as sg]))

(defn- reqs-of
  "A `reqs` callback over a static `{ns [requires…]}` map: an unknown ns has no
   requires (the build's own callback shape)."
  [m]
  (fn [n] (get m n [])))

; ── header ───────────────────────────────────────────────────────────────────

(deftest header-ns-with-no-requires
  (let [[ns reqs] (sg/header "(ns core)\n(defn f [] 1)")]
    (is (= "core" ns))
    (is (= [] (vec reqs)))))

(deftest header-takes-only-each-specs-target
  (let [src "(ns compiler\n  (:require [reader-node :as rn] [other]))\n(defn g [] 2)"
        [ns reqs] (sg/header src)]
    (is (= "compiler" ns))
    (is (= ["other" "reader-node"] (vec (sort reqs))))))

(deftest header-no-ns-form-yields-nil-and-empty
  (let [[ns reqs] (sg/header "(defn f [] 1)")]
    (is (nil? ns))
    (is (= [] (vec reqs)))))

(deftest header-empty-source-is-nil-and-empty
  (let [[ns reqs] (sg/header "")]
    (is (nil? ns))
    (is (= [] (vec reqs)))))

(deftest header-malformed-source-raises
  ; An unterminated form is a READ error and must surface, not be swallowed
  ; into a bogus `[nil []]` header — the build would then compile the file as
  ; `user` with no edges.
  (is (thrown? (sg/header "(ns a"))))

(deftest header-a-require-in-a-comment-is-not-an-edge
  ; The exact trap: raw-text scanning would read `datom` as a dependency.
  (let [src (str "(ns interop)\n"
                 "; the same way `datom` is required via (:require [datom]) elsewhere\n"
                 "(defn h [] 3)")
        [ns reqs] (sg/header src)]
    (is (= "interop" ns))
    (is (= [] (vec reqs)))))

(deftest header-refer-list-members-are-not-requires
  (let [[ns reqs] (sg/header "(ns a (:require [b :refer [x y]]))")]
    (is (= "a" ns))
    (is (= ["b"] (vec reqs)))))

(deftest header-a-semicolon-in-a-string-does-not-truncate-the-form
  (let [src "(ns a (:require [b]))\n(def s \"has ; semicolon\")"
        [ns reqs] (sg/header src)]
    (is (= "a" ns))
    (is (= ["b"] (vec reqs)))))

; ── cycles ───────────────────────────────────────────────────────────────────

(deftest an-acyclic-graph-has-none
  (is (= [] (vec (sg/cycles ["a"] (reqs-of {"a" ["b"] "b" []}))))))

(deftest a-two-node-cycle-is-named-as-a-closed-path
  (is (= [["x" "y" "x"]] (vec (map vec (sg/cycles ["x"] (reqs-of {"x" ["y"] "y" ["x"]})))))))

(deftest the-bug-064-shape-a-four-node-substrate-application-cycle
  (let [m {"vm.session" ["bl.daemon"],
           "bl.daemon" ["bl.cli"],
           "bl.cli" ["vm.client"],
           "vm.client" ["vm.session"]}
        cycs (sg/cycles ["bl.cli"] (reqs-of m))]
    (is (= 1 (count cycs)) "exactly one cycle")
    (let [cyc (vec (first cycs))]
      (is (= (first cyc) (last cyc)) "a closed path")
      (is (= ["bl.cli" "bl.daemon" "vm.client" "vm.session"]
             (vec (sort (take (- (count cyc) 1) cyc))))
          "every member named"))))

(deftest a-cycle-off-the-spine-of-an-acyclic-root-is-still-found
  (is (= [["c" "d" "c"]]
         (vec (map vec (sg/cycles ["a"] (reqs-of {"a" ["b" "c"] "b" [] "c" ["d"] "d" ["c"]})))))))

(deftest a-self-require-is-a-cycle-of-one
  (is (= [["a" "a"]] (vec (map vec (sg/cycles ["a"] (reqs-of {"a" ["a"]})))))))

(deftest an-unresolvable-require-is-skipped-not-crashed-on
  (is (= [] (vec (sg/cycles ["a"] (reqs-of {"a" ["missing"]}))))))

; ── closure / closure-hash ───────────────────────────────────────────────────

; a -> b -> c ; a -> d
(def closure-reqs {"a" ["b" "d"] "b" ["c"] "c" [] "d" []})

(deftest closure-is-transitive-and-includes-self
  (is (= ["a" "b" "c" "d"] (vec (sg/closure "a" (reqs-of closure-reqs)))))
  (is (= ["b" "c"] (vec (sg/closure "b" (reqs-of closure-reqs))))))

(deftest closure-is-cycle-safe
  (is (= ["x" "y"] (vec (sg/closure "x" (reqs-of {"x" ["y"] "y" ["x"]}))))))

(deftest hash-changes-iff-a-closure-members-source-hash-changes
  (let [reqs (reqs-of closure-reqs)
        h (fn [hashes] (sg/closure-hash "a" (fn [n] (get hashes n)) reqs))
        base {"a" "1" "b" "1" "c" "1" "d" "1"}]
    ; changing c (a transitive dep of a) changes a's hash
    (is (not= (h base) (h (assoc base "c" "2"))))
    ; changing an unrelated ns not in a's closure does not
    (is (= (h base) (h (assoc base "z" "9"))))))

(deftest an-unresolvable-member-is-a-distinct-stable-contribution
  ; missing → srchash nil → rendered as "missing:?" ; stable across calls
  (let [reqs (reqs-of {"a" ["missing"]})]
    (is (= (sg/closure-hash "a" (fn [_] nil) reqs)
           (sg/closure-hash "a" (fn [_] nil) reqs)))))
