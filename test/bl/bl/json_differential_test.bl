; test/bl/bl/json_differential_test.bl — bl.json bounded by INDEPENDENT oracles.
; Run: bl test test/bl/bl/json_differential_test.bl
;
; ── Why this file is separate from json_test.bl ──────────────────────────────
;
; json_test.bl pins the POLICY: `nil` is null, a vector is an array, a keyword is
; its name, a set sorts, a bad path is named. Those assertions encode what I
; decided, so they can only ever confirm that I implemented my own decisions.
;
; This file asks a different question: does the codec agree with parsers I did
; not write? Two of them are on hand and are both RFC 8259 + ECMA 404
; implementations that pass JSONTestSuite:
;
;   * `Jason/decode!` — a strict WHOLE-document decoder that RAISES. It is the
;     primary oracle because its contract matches bl.json's: one call, one
;     document, an error rather than a leftover tail.
;   * `json:decode/1` — OTP's own, the module bl.json delegates its lexer to.
;     A weaker oracle for OUR purposes (it is the backend, so it cannot catch a
;     mistake in how we drive it) but it does catch a hand-written escape or
;     number rule that disagrees with the module we claim to delegate to.
;
; The third oracle runs the other way: `bl.json/encode`'s OUTPUT is handed to
; Jason and to `json:decode`. A parser I did not write either accepts those
; bytes or it does not — which is the only way to bound "the encoder emits valid
; JSON" beyond the shapes I thought to try.
;
; ── What agreement can and cannot show ──────────────────────────────────────
;
; Agreement proves VALIDITY and INTERPRETATION: my bytes are JSON, and two
; independent readers take them the way my reader does. It CANNOT prove intent —
; if `nil` encoded as the string "nil", every parser would agree on the string.
; That is why the policy assertions live in json_test.bl and the agreement
; assertions live here. Neither file is sufficient alone.
;
; ⚠ Truncation fuzzing (the last deftest) is the part that bounds the error
; paths: `json_test.bl` hand-writes ten malformed documents, and ten is not a
; bound on anything.

(ns bl.json-differential-test
  (:require [bl.json :as j]))

;; ── a third-party decoder's value, as beam-lisp shapes ───────────────────────

(defn- normalise
  "A value from Jason or OTP `json` in beam-lisp's shapes, so the three can be
   compared. Both third-party decoders return LISTS for arrays — the very
   asymmetry `bl.json` exists to remove — so this is where the comparison
   absorbs it. OTP's `null` atom becomes nil; Jason already answers nil.

   The `null` divergence is asserted explicitly below rather than hidden here:
   OTP `json` answers the atom `null` where Jason and bl.json answer nil. That
   is a real difference between two conformant decoders, and one of the reasons
   bl.json owns the mapping."
  [v]
  (cond
    (= v :null) nil
    (nil? v) nil
    (map? v) (reduce (fn [m kv] (assoc m (first kv) (normalise (second kv)))) {} (to-list v))
    (sequential? v) (vec (map normalise (to-list v)))
    :else v))

(defn- ok? [r] (and (map? r) (contains? r :ok)))

(defn- oracle-jason [text]
  (try {:ok (Jason/decode! text)} (catch e {:error (str e)})))

(defn- oracle-otp [text]
  (try {:ok (json/decode text)} (catch e {:error (str e)})))

;; ── the corpus: JSON TEXT, none of it written by my encoder ─────────────────
;
; Built by hand so that no part of the pipeline under test produced its own
; input. Grouped by what each line is defending.

(def ^:private texts
  (to-list
    (concat
      ; scalars and the number grammar
      (list "0" "-0" "0.0" "-0.0" "1" "-1" "42" "1.5" "-1.25" "0.1" "1e2" "1E+2" "1e-2" "1E-2"
            "123456789012345678901234567890" "1.7976931348623157e308" "5.0e-324" "1e0" "10E3")
      ; strings: escapes, unicode, the BMP boundary, surrogate pairs
      (list "\"a\"" "\"\"" "\"\\n\"" "\"\\t\"" "\"\\r\"" "\"\\b\"" "\"\\f\"" "\"\\\\\"" "\"\\\"\""
            "\"\\/\"" "\"\\u0000\"" "\"\\u0041\"" "\"\\u00e9\"" "\"\\u20ac\"" "\"\\uD83D\\uDE00\""
            "\"héllo→\"" "\"😀\"" "\"a\\u0000b\"" "\"\\uFFFF\"")
      ; structure
      (list "{}" "[]" "[1]" "[1,2,3]" "[[]]" "[[[[[1]]]]]" "{\"a\":1}" "{\"a\":{\"b\":1}}"
            "{\"a\":[1,{\"b\":[true,false,null]}]}" "{\"\":\"\"}" "{\"a\":1,\"b\":2,\"c\":3}"
            "[{\"a\":1},{\"b\":2}]" "[null,true,false]"
            " {\"a\" : 1 , \"b\" : [ 1 , 2 ] } " "\t\r\n{}\t")
      ; MALFORMED — the decoder must refuse exactly where the oracles refuse
      (list "" " " "\t" "1 2" "[]]" "[]{}" "+1" "01" ".5" "1." "-" "1e" "e1" "0x1" "NaN" "Infinity"
            "-Infinity" "nan" "nul" "tru" "truefalse" "n" "{\"a\"}" "{\"a\":}" "{\"a\" 1}" "[1,]" "{,}"
            "{\"a\":1,}" "[,1]" "[1,,2]" "\"\\q\"" "\"\\uD83D\"" "\"\\u00\"" "\"\\uZZZZ\""
            "\"unterminated" "[1,2" "{\"a\":1" "{{}}" "}" "]"
            "\"\\" "1e400" "-1e400" "1E999" "[1 2]")
      ; INVALID UTF-8 INSIDE A STRING — the untrusted-input case. A peer can put
      ; these bytes on the wire; they are not JSON, and OTP's lexer is the thing
      ; that decides so. Written as bytes because the point is that the CODEC
      ; sees them, not the reader of this file.
      (list (erlang/list_to_binary (list 34 255 34))          ; a bare 0xFF byte
            (erlang/list_to_binary (list 34 195 34))          ; a truncated 2-byte sequence
            (erlang/list_to_binary (list 34 237 160 128 34))  ; a UTF-8-encoded SURROGATE (CESU-8)
            (erlang/list_to_binary (list 34 192 175 34))      ; overlong encoding of "/"
            (erlang/list_to_binary (list 34 226 130 34)))     ; a truncated 3-byte sequence
      )))

;; ── values, to drive the encoder side ────────────────────────────────────────

(def ^:private values
  (to-list
    (concat
      (list nil true false 0 1 -1 42 1.5 -0.0 0.1 1.0e22 123456789012345678901234567890
            "" "a" "with \"quotes\"" "with \\ backslash" "tab\there" "newline\nhere"
            "héllo→" "😀" (erlang/list_to_binary (list 0)) "lead null"
            :kw :ns/name (symbol "<=") (symbol "+")
            [] [1 2 3] (list) (list 1 2) (map inc (list 1 2)) (range 3)
            {} {"a" 1} {"b" 2 "a" 1} {:a 1} {1 "one"}
            #{} #{1} #{3 1 2} #{:b :a}
            [nil true false] {"a" nil} {"n" [1 {"d" (list nil)}]}
            {"deep" {"er" [1 2 {"x" (set (list 1 2))}]}}
            [1.5 "a" :k [2 {"b" #{3}}]])
      (list {"date" (Date/new! 2026 1 15)}))))

;; ── 1. the decoder vs two parsers I did not write ────────────────────────────

(deftest the-decoder-agrees-with-two-independent-parsers
  (is (= 103 (count texts)) "the corpus is the size this test was written against")
  (reduce
    (fn [acc t]
      (let [mine (j/try-decode t)
            jay  (oracle-jason t)
            otp  (oracle-otp t)]
        (is (= (ok? mine) (ok? jay)) (str "jason agrees on ACCEPTANCE of " (pr-str t)))
        (is (= (ok? mine) (ok? otp)) (str "otp json agrees on ACCEPTANCE of " (pr-str t)))
        (when (ok? mine)
          (is (= (:ok mine) (normalise (:ok jay))) (str "jason agrees on the VALUE of " (pr-str t)))
          (is (= (:ok mine) (normalise (:ok otp))) (str "otp json agrees on the VALUE of " (pr-str t)))))
      nil)
    nil
    texts))

(deftest the-null-divergence-between-conformant-decoders-is-real
  ; Not a claim about my code — a pinned fact about the two oracles, which is
  ; WHY bl.json owns the mapping instead of threading a third party's answer
  ; through its callers. If either oracle changes this, the reason to own it
  ; should be re-derived rather than assumed.
  (is (nil? (Jason/decode! "null")))
  (is (= :null (json/decode "null")) "OTP json answers the ATOM null")
  (is (nil? (j/decode "null")) "bl.json answers nil, like Jason"))

;; ── 2. my bytes, parsed by parsers I did not write ───────────────────────────

(deftest the-encoder-emits-json-independent-parsers-accept
  (is (= 47 (count values)) "the corpus is the size this test was written against")
  (reduce
    (fn [acc v]
      (let [r (j/try-encode v)]
        (is (ok? r) (str "the corpus encodes at all: " (pr-str v)))
        (when (ok? r)
          (let [b (:ok r)
                jay (oracle-jason b)
                otp (oracle-otp b)
                mine (j/try-decode b)]
            (is (ok? jay) (str "JASON parses my output: " (pr-str v) " -> " (pr-str b)))
            (is (ok? otp) (str "OTP JSON parses my output: " (pr-str v) " -> " (pr-str b)))
            (when (and (ok? jay) (ok? mine))
              ; two independent readers of the same bytes, compared to each other
              (is (= (:ok mine) (normalise (:ok jay)))
                  (str "my reader agrees with jason on my own bytes: " (pr-str b))))
            (when (and (ok? otp) (ok? mine))
              (is (= (:ok mine) (normalise (:ok otp)))
                  (str "my reader agrees with otp json on my own bytes: " (pr-str b)))))))
      nil)
    nil
    values))

(deftest pretty-output-is-also-accepted-and-means-the-same
  (reduce
    (fn [acc v]
      (let [r (j/try-encode v {:pretty 2})]
        (when (ok? r)
          (let [b (:ok r)]
            (is (ok? (oracle-jason b)) (str "jason parses my PRETTY output: " (pr-str v)))
            (is (= (j/try-decode (:ok (j/try-encode v)))
                   (j/try-decode b))
                (str "pretty changes the bytes, not the value: " (pr-str v))))))
      nil)
    nil
    values))

(deftest an-unencodable-value-is-refused-with-a-path-not-dropped
  ; The failure mode this library exists to kill: the MCP transport caught an
  ; encoder refusal and wrote NO line, which a client cannot tell from a server
  ; still thinking. A refusal must be an ERROR CARRYING THE PATH.
  (let [r (j/try-encode {"deep" [{"here" (erlang/self)}]})]
    (is (contains? r :error) "a pid is refused, not silently dropped")
    (is (includes? (:error r) "/deep/0/here") "and the message names where")))

;; ── 3. truncation fuzzing: every prefix of every document ────────────────────

(deftest every-prefix-of-a-valid-document-decodes-or-refuses-cleanly
  ; `json_test.bl` hand-writes ten malformed documents. This walks EVERY prefix
  ; of 24 valid ones — ~300 partial documents, none of them chosen by hand — and
  ; bounds three things at once: a prefix never crashes the codec, a prefix never
  ; hangs it, and a prefix never decodes to something a third-party parser
  ; refuses (which would mean bl.json invented a document out of a fragment).
  (let [valid (to-list (concat
                         (list "{}" "[]" "1" "-1.5" "1e2" "\"a\"" "\"\\u00e9\"" "\"\\uD83D\\uDE00\"")
                         (list "[1,2,3]" "{\"a\":1}" "{\"a\":[1,{\"b\":null}]}" "[[[1]]]"
                               "{\"\":\"\"}" "[true,false,null]" "\"héllo\"" "123456789012345678901234567890"
                               "{\"a\":{\"b\":{\"c\":[1,2,{\"d\":\"e\"}]}}}" "[[[[[1]]]]]"
                               "0.1" "1.7976931348623157e308" "{\"a\":1,\"b\":[2,3],\"c\":{\"d\":4}}")))
        prefixes (reduce (fn [acc t]
                           (reduce (fn [a k] (conj a (subs t 0 k)))
                                   acc
                                   (range 0 (erlang/byte_size t))))
                         []
                         valid)]
    (is (= 21 (count valid)) "the corpus is the size this test was written against")
    ; the prefix count MUST equal the corpus's total byte length — self-checking,
    ; so a corpus change cannot silently shrink what this walks
    (is (= (reduce (fn [a t] (+ a (erlang/byte_size t))) 0 valid)
           (count prefixes))
        "every non-empty prefix of every document is walked")
    (reduce
      (fn [acc p]
        (let [mine (j/try-decode p)]
          (is (map? mine) (str "a prefix always answers, never crashes: " (pr-str p)))
          (when (ok? mine)
            ; a prefix that DECODES must decode to something Jason also reads
            (is (ok? (oracle-jason p))
                (str "no prefix invents a document jason refuses: " (pr-str p)))))
        nil)
      nil
      prefixes)))
