; test/bl/bl/json_test.bl — bl.json fidelity suite.
; Run: bl test test/bl/bl/json_test.bl
;
; ── Provenance ───────────────────────────────────────────────────────────────
; Two contracts are pinned here, and they are different contracts.
;
; 1. THE VALUE MAPPING — beam-lisp's own, decided by `bl.json`, documented in
;    its header. `[1 2]` is an array, `(map …)` is an array, `#{…}` is an array
;    in a stable order, `nil` is `null`, a symbol is its name. These are the
;    cases the library exists for: under `bl.json/encode` every one of them
;    raised `Protocol.UndefinedError` naming an Elixir struct the caller never
;    wrote, and in the MCP transport an unencodable value was DROPPED — the
;    server logged to stderr and wrote no line, which a client cannot tell from
;    a server still thinking.
;
; 2. RFC 8259 — the grammar, which OTP's `json` module owns. Those cases pin
;    that the delegation is real: surrogate pairs decode, `+1` and `01` and
;    `NaN` are refused, a lone surrogate is refused, `1e400` is refused, and a
;    truncated document says so. A hand-rolled lexer would have to earn each of
;    these; `bl.json` inherits them.
;
; Where a case is about OUR decision, the `is` says so.

(ns bl.json-test
  (:require [bl.json :as j]))

;; ── scalars: the mapping table ──────────────────────────────────────────────

(deftest scalars
  (is (= "42" (j/encode 42)))
  (is (= "-7" (j/encode -7)))
  (is (= "1.5" (j/encode 1.5)))
  (is (= "true" (j/encode true)))
  (is (= "false" (j/encode false))))

(deftest nil-is-null-not-the-string-nil
  ; THE trap this library exists to close. OTP's own encoder stringifies the
  ; atom: `json:encode(nil)` is the JSON string "nil", because
  ; `encode_atom(nil, _)` falls through to the clause that binary-ifies any
  ; atom that is not `null`/`true`/`false`. A JSON consumer reading `"nil"`
  ; where it asked for a null is a silently wrong answer, not an error.
  (is (= "null" (j/encode nil)))
  (is (= "{\"a\":null}" (j/encode {"a" nil})))
  (is (= "[null]" (j/encode (list nil))))
  (is (= "{\"a\":\"nil\"}" (j/encode {"a" "nil"})) "a STRING is still a string"))

(deftest integers-are-exact
  ; JSON numbers are unbounded decimals; a BEAM integer is arbitrary precision,
  ; so nothing is lost. (A float could not carry this.)
  (is (= "123456789012345678901234567890"
         (j/encode 123456789012345678901234567890)))
  (is (= 123456789012345678901234567890
         (j/decode "123456789012345678901234567890"))))

(deftest floats-round-trip
  ; `float_to_binary(_, [short])` — the shortest text that parses back to the
  ; same float. The check is the ROUND TRIP, not a spelling: an encoder that
  ; emits 0.30000000000000004 has not lost anything, but one that emits 0.3 for
  ; a value that is not 0.3 has.
  (is (= 1.5 (j/decode (j/encode 1.5))))
  (is (= 0.1 (j/decode (j/encode 0.1))))
  (is (= 1.0e22 (j/decode (j/encode 1.0e22))))
  (is (= 0.0 (j/decode (j/encode 0.0)))))

;; ── strings ─────────────────────────────────────────────────────────────────

(deftest strings-are-escaped-by-otp
  (is (= "\"hi\"" (j/encode "hi")))
  (is (= "\"a\\\"b\"" (j/encode "a\"b")))
  (is (= "\"a\\\\b\"" (j/encode "a\\b")))
  ; RFC 8259 gives control characters two spellings; OTP picks the short one
  ; for the named escapes it has, and \uXXXX for the rest.
  (is (= "\"a\\nb\"" (j/encode "a\nb")))
  (is (= "\"a\\tb\"" (j/encode "a\tb")))
  (is (= "\"a\\u0000b\"" (j/encode (str "a" (erlang/list_to_binary (list 0)) "b"))))
  ; `/` is NOT escaped — legal either way, and escaping it bloats every path
  (is (= "\"a/b\"" (j/encode "a/b")))
  ; non-ASCII goes out as UTF-8, which RFC 8259 requires a reader to accept
  (is (= "\"héllo→\"" (j/encode "héllo→"))))

(deftest ascii-mode-escapes-what-a-non-utf8-reader-needs
  (is (= "\"h\\u00E9llo\"" (j/encode "héllo" {:ascii true})))
  (is (= "\"héllo\"" (j/encode "héllo")) "the default leaves UTF-8 alone")
  (is (= "héllo" (j/decode (j/encode "héllo" {:ascii true})))
      "and an ASCII-escaped string decodes back to the same value"))

(deftest a-string-that-is-not-utf8-is-refused-with-its-path
  ; OTP validates UTF-8 as it escapes, so an invalid byte cannot reach the wire
  ; as broken JSON. The value here is the TRANSLATION: `{invalid_byte, 255}`
  ; from deep inside a library becomes an error naming the field, which is the
  ; difference between a five-minute fix and an afternoon (BUG-068).
  (let [bad (erlang/list_to_binary (list 97 255 98))]
    (is (thrown-with-msg? "not valid UTF-8" (j/encode {"tag" bad})))
    (is (thrown-with-msg? "\"/tag\"" (j/encode {"tag" bad}))
        "the path names the member that is at fault")
    (is (thrown-with-msg? "not valid UTF-8" (j/encode (list "ok" bad))))
    (is (thrown-with-msg? "\"/1\"" (j/encode (list "ok" bad)))
        "and an array element is named by its index")))

;; ── collections: what Jason could not encode at all ─────────────────────────

(deftest every-bl-collection-is-an-array
  ; All four of these raised `Protocol.UndefinedError` under Jason, because each
  ; is a struct (or a tuple) with no `Jason.Encoder`. This is the library's
  ; reason to exist.
  (is (= "[1,2,3]" (j/encode [1 2 3])))
  (is (= "[1,2,3]" (j/encode (list 1 2 3))))
  (is (= "[2,3,4]" (j/encode (map inc [1 2 3]))) "a lazy seq — realised on the way out")
  (is (= "[0,1,2]" (j/encode (range 3)))))
; NB `(range 3)` prints as [0,1,2] here; the assertion above is the encoder's
; output, so a change in `range`'s print form does not weaken it.

(deftest a-set-is-an-array-in-a-stable-order
  ; JSON has no set. Emitting one is a policy decision, and the ORDER is the
  ; part that matters: a set is unordered, so an encoder that walks the
  ; underlying representation produces a different document run to run, and a
  ; `--json` consumer cannot diff it. Members are sorted by their printed form.
  (is (= "[1,2,3]" (j/encode #{1 2 3})))
  (is (= "[1,2,3]" (j/encode #{3 1 2})))
  (is (= (j/encode #{:b :a :c}) (j/encode #{:c :a :b}))))

(deftest empty-collections
  (is (= "[]" (j/encode [])))
  (is (= "[]" (j/encode (list))))
  (is (= "{}" (j/encode {})))
  (is (= "[]" (j/encode #{}))))

(deftest nesting-is-not-special
  (is (= "{\"a\":[1,{\"b\":[null,true]}]}"
         (j/encode {"a" [1 {"b" (list nil true)}]}))))

;; ── objects ─────────────────────────────────────────────────────────────────

(deftest object-keys-are-sorted-so-the-bytes-are-a-contract
  ; MEASURED motivation: Jason emits map keys in the BEAM's internal order —
  ; sorted below 32 keys and in hash order above — so `--json` output is stable
  ; only by accident of size. Sorting by the ENCODED key makes it deterministic
  ; for every size, whatever the map's representation is.
  (is (= "{\"a\":1,\"b\":2}" (j/encode {"b" 2 "a" 1})))
  (is (= "{\"a\":1,\"b\":2}" (j/encode {:b 2 :a 1}))
      "a keyword key is its name — same document as the string key")
  ; 40 keys — past the 32-key boundary where Jason's key order changes from
  ; sorted to hash order. The proof is monotonicity: every key appears at a
  ; later position than the key before it in sorted order.
  (let [m (reduce (fn [acc i] (assoc acc (str "k" i) i)) {} (range 40))
        out (j/encode m)
        ks (sort (keys m))
        pos (map (fn [k] (index-of out (str "\"" k "\":"))) ks)]
    (is (= 40 (count ks)))
    (is (= 0 (count (filter (fn [p] (nil? p)) pos))) "every key is present")
    (is (= pos (sort pos)) "and they appear in sorted order, every one of them")
    (is (< (index-of out "\"k10\":") (index-of out "\"k2\":"))
        "sorted as TEXT (k10 before k2) — what a JSON consumer can diff")))

(deftest a-foreign-struct-encodes-itself
  ; `bl.json` owns the mapping, but it does not own OTHER people's types. A
  ; struct with its own `Jason.Encoder` must reach it intact, or every caller
  ; that has a Date would lower it by hand — which is what the deleted
  ; `jsonable` / `json-safe` / `plain` pre-walks spent their branches on.
  ;
  ; NB the trap this pins: beam-lisp's `map?` is FALSE for every struct, so a
  ; dispatch that reaches for a struct through `map?` misses it entirely and
  ; drops it into the "no JSON representation" arm. That is not hypothetical —
  ; it is what the first version of `emit` did, and it was `interop`'s suite
  ; that caught it, not this one.
  (is (= false (map? (Date/new! 2026 1 15))) "`map?` excludes structs")
  (is (= true (struct? (Date/new! 2026 1 15))) "`struct?` is the predicate")
  (is (= "\"2026-01-15\"" (j/encode (Date/new! 2026 1 15))))
  (is (= "{\"d\":\"2026-01-15\"}" (j/encode {"d" (Date/new! 2026 1 15)}))
      "and it stays itself inside a collection"))

(deftest key-types-that-have-a-text
  (is (= "{\"a\":1}" (j/encode {:a 1})))
  (is (= "{\"<=\":1}" (j/encode {(symbol "<=") 1})) "a symbol key is its name")
  (is (= "{\"1\":\"one\"}" (j/encode {1 "one"})) "a number key is its digits, quoted"))

(deftest a-key-with-no-text-fails-rather-than-being-stringified
  ; A JSON object key is a string. A vector key has no faithful text, so
  ; inventing one produces a document that cannot be read back into the same
  ; value — a silent corruption. It fails instead, and says where.
  (is (thrown-with-msg? "object key of type" (j/encode {[1 2] "x"})))
  (is (thrown-with-msg? "JSON object keys are strings" (j/encode {[1 2] "x"}))))

(deftest two-keys-that-encode-to-the-same-text-fail
  ; `:a` and the string "a" are different bl values with the same JSON key.
  ; Writing both produces a document with a duplicate member, and every reader
  ; silently keeps one — data loss with no error anywhere. OTP's own
  ; `encode_map_checked/2` makes the same call.
  (is (thrown-with-msg? "two keys that both encode to" (j/encode {:a 1 "a" 2}))))

;; ── the values that used to be dropped on the wire ──────────────────────────

(deftest a-synthesized-guard-can-cross-the-wire
  ; The regression from BUG-033's artifact run: `code/verify` synthesized a
  ; repair perfectly and reached no one, because the guard was an AST and Jason
  ; had no encoder for it. The frame died on the way out, the transport wrote
  ; NO line, and the client saw a hang until it timed out. Every shape the
  ; repair travels in now encodes.
  (let [symbol-node (symbol "<=")
        frame {"jsonrpc" "2.0"
               "id" 8
               "result" {"verdict" "violated"
                         "repairs" [{"guard" (str "(" symbol-node " balance amt)")}]
                         "traces" (map inc [1 2 3])
                         "states" #{:init :done}}}]
    (is (= "{\"id\":8,\"jsonrpc\":\"2.0\",\"result\":{\"repairs\":[{\"guard\":\"(<= balance amt)\"}],\"states\":[\"done\",\"init\"],\"traces\":[2,3,4],\"verdict\":\"violated\"}}"
           (j/encode frame)))
    (is (= "violated" (get-in (j/decode (j/encode frame)) ["result" "verdict"])))))

(deftest a-symbol-is-its-name
  (is (= "\"<=\"" (j/encode (symbol "<="))))
  (is (= "\"my-fn\"" (j/encode (symbol "my-fn"))))
  (is (= "{\"op\":\"+\"}" (j/encode {"op" (symbol "+")}))))

(deftest a-keyword-is-its-name-not-its-colon
  (is (= "\"kw\"" (j/encode :kw)))
  (is (= "{\"a\":1}" (j/encode {:a 1}))))

;; ── values that have NO representation, and say so ──────────────────────────

(deftest an-unencodable-value-fails-with-its-path
  ; The other half of the dropped-frame bug: the failure must be LOUD and it
  ; must name the member, so the fix is obvious. A bare
  ; `Protocol.UndefinedError` naming `%BeamLisp.Vector{}` sends the reader
  ; looking in the wrong file entirely.
  (let [pid (erlang/self)]
    (is (thrown-with-msg? "no JSON representation" (j/encode pid)))
    (is (thrown-with-msg? "no JSON representation" (j/encode {"deep" [{"here" pid}]})))
    (is (thrown-with-msg? "\"/deep/0/here\"" (j/encode {"deep" [{"here" pid}]}))
        "the pointer is RFC 6901, so it can be read by any JSON tool")
    (is (thrown-with-msg? "no JSON representation" (j/encode (list 1 (fn [x] x))))
        "a function is not data")))

(deftest non-finite-floats-have-no-json-spelling
  ; `bl.json` refuses NaN and Infinity rather than emitting the text "nan"/
  ; "inf", which no JSON reader would accept.
  ;
  ; The guard is DEFENSIVE, and as of this writing UNREACHABLE from beam-lisp
  ; arithmetic: the BEAM RAISES on float overflow instead of producing an
  ; infinity, and `binary_to_term` — the back door that could build one from
  ; bytes — is refused by the runtime (all three checked here, not assumed).
  ;
  ; So this pins the REACHABLE half and records the gap, rather than claiming to
  ; cover a branch no input can reach.
  (is (thrown-with-msg? "arithmetic" (* 1.0e308 10.0))
      "overflow RAISES; it does not make an infinity to encode")
  (is (thrown-with-msg? "arithmetic" (math/pow 10.0 400.0)))
  (is (= 1.5 (j/decode (j/encode 1.5))) "ordinary floats cross")
  (is (= "0.0" (j/encode 0.0)))
  (is (= "-1.25" (j/encode -1.25))))

;; ── decode ──────────────────────────────────────────────────────────────────

(deftest decode-maps-json-to-bl-shapes
  (is (= 42 (j/decode "42")))
  (is (= "hi" (j/decode "\"hi\"")))
  (is (= nil (j/decode "null")))
  (is (= true (j/decode "true")))
  (is (= {"a" 1} (j/decode "{\"a\":1}")))
  (is (= {"a" [1 2]} (j/decode "{\"a\":[1,2]}"))))

(deftest arrays-decode-to-vectors-so-a-round-trip-holds
  ; UNDER JASON THIS WAS A LIST. `[1 2]` encoded to `[1,2]` and came back
  ; `(1 2)` — so `(= x (decode (encode x)))` was false for the language's own
  ; vector literal, and every consumer re-normalised by hand.
  (is (vector? (j/decode "[1,2]")))
  (is (= [1 2] (j/decode "[1,2]")))
  (is (vector? (get (j/decode "{\"a\":[1]}") "a")))
  (is (= [1 [2 [3]]] (j/decode "[1,[2,[3]]]"))))

(deftest object-key-policies
  ; `:string` is the default because it is the only TOTAL one. `:keyword`
  ; interns an atom per key, and the atom table is bounded and never collected,
  ; so a document from a peer is a way to exhaust it — `:existing-atom` is the
  ; policy for input you do not trust.
  (is (= {"a" 1} (j/decode "{\"a\":1}")))
  (is (= {:a 1} (j/decode "{\"a\":1}" {:keys :keyword})))
  (is (= {:a 1} (j/decode "{\"a\":1}" {:keys :existing-atom}))
      ":a is already interned — the test file itself contains it")
  (is (thrown-with-msg? "refuses to intern"
                        (j/decode "{\"definitely-not-an-interned-atom-77123\":1}"
                                  {:keys :existing-atom})))
  (is (= "a" (first (keys (j/decode "{\"a\":1}"))) ) "default keys are strings"))

(deftest a-duplicate-key-keeps-the-last
  ; RFC 8259 leaves this to the implementation. JavaScript, Python, Go and Jason
  ; all keep the LAST occurrence; disagreeing with them would be a difference
  ; nobody could see until it mattered.
  (is (= {"a" 2} (j/decode "{\"a\":1,\"a\":2}"))))

;; ── RFC 8259: what OTP's lexer gives us, pinned ────────────────────────────

(deftest string-escapes-decode
  (is (= "a\"b" (j/decode "\"a\\\"b\"")))
  (is (= "a\\b" (j/decode "\"a\\\\b\"")))
  (is (= "a\nb" (j/decode "\"a\\nb\"")))
  (is (= "a/b" (j/decode "\"a\\/b\"")) "\"/\" is a legal escape")
  (is (= "A" (j/decode "\"\\u0041\"")))
  (is (= "é" (j/decode "\"\\u00e9\"")))
  (is (= "😀" (j/decode "\"\\uD83D\\uDE00\""))
      "a surrogate PAIR becomes one character — the case a naive parser splits"))

(deftest number-grammar
  (is (= 0 (j/decode "0")))
  (is (= 0 (j/decode "-0")))
  (is (= 100.0 (j/decode "1E+2")) "exponent with a plus")
  (is (= 100.0 (j/decode "1e2")))
  (is (= 1.5 (j/decode "0.15e1"))))

(deftest malformed-input-is-refused-not-guessed
  (is (thrown-with-msg? "ends in the middle" (j/decode "{\"a\":")))
  (is (thrown-with-msg? "ends in the middle" (j/decode "[1,2")))
  (is (thrown-with-msg? "ends in the middle" (j/decode "")))
  (is (thrown-with-msg? "not JSON here" (j/decode "+1")) "a leading + is not JSON")
  ; the grammar is strict: no leading `+`, no leading zero, no bare `.5`
  ; `01` parses as the number 0 and leaves `1` behind, which the trailing check
  ; refuses — a refusal either way, said the way the lexer actually saw it
  (is (thrown-with-msg? "trailing bytes" (j/decode "01")))
  (is (thrown-with-msg? "not JSON here" (j/decode ".5")))
  (is (thrown-with-msg? "not JSON here" (j/decode "NaN")))
  (is (thrown-with-msg? "not JSON here" (j/decode "Infinity")))
  ; syntactically valid, not representable as an IEEE double — OTP refuses
  (is (thrown-with-msg? "unexpected sequence" (j/decode "1e400")))
  ; a lone surrogate is not a character, so the string cannot be built
  (is (thrown-with-msg? "ends in the middle" (j/decode "\"\\uD83D\""))))

(deftest trailing-bytes-are-a-malformed-document
  ; `json:decode/3` returns the unparsed tail; a caller that silently ignored it
  ; would accept `{"a":1}{"a":2}` as the first document. One call is one
  ; document, so a tail is an error that says how much was left.
  (is (thrown-with-msg? "trailing bytes" (j/decode "1 2")))
  (is (thrown-with-msg? "trailing bytes" (j/decode "{\"a\":1}{\"b\":2}")))
  (is (= 1 (j/decode "1 ")) "trailing WHITESPACE is not a second document"))

(deftest deep-nesting-does-not-touch-the-call-stack
  ; OTP's decoder carries an explicit stack, so depth costs heap, not frames.
  ; 2000 levels is far past what a recursive-descent parser would survive.
  (let [deep (reduce (fn [acc _] [acc]) 1 (range 2000))
        text (j/encode deep)]
    (is (vector? (j/decode text)))
    (is (= text (j/encode (j/decode text))))))

(deftest decode-wants-a-string
  (is (thrown-with-msg? "wants a string" (j/decode 42)))
  (is (thrown-with-msg? "wants a string" (j/decode nil))))

;; ── the round-trip law ──────────────────────────────────────────────────────

(deftest data-survives-a-round-trip
  ; The law `bl.json` exists to make true. It is deliberately stated over the
  ; JSON-representable subset: everything here is data with a JSON spelling.
  (are [v] (= v (j/decode (j/encode v)))
    42
    -7
    1.5
    "hi"
    "a \"quoted\" string"
    true
    false
    nil
    [1 2 3]
    []
    ["a" "b"]
    {"a" 1 "b" [2 3]}
    {}
    {"nested" {"deep" {"er" [1 {"x" nil}]}}}
    123456789012345678901234567890))

(deftest what-does-not-round-trip-and-why
  ; A keyword and a symbol have no JSON spelling; they cross as their NAMES. So
  ; the round-trip law is stated over the JSON-native subset, and these are the
  ; cases deliberately outside it. Stating them is the point: a reader deserves
  ; to know which direction of the mapping loses information.
  (is (= "kw" (j/decode (j/encode :kw))))
  (is (= "x" (j/decode (j/encode (symbol "x")))))
  (is (= {"a" 1} (j/decode (j/encode {:a 1})))
      "a keyword KEY is a string on the wire too")
  (is (= 1 (j/decode (j/encode 1))) "while JSON's own types do round-trip"))

(deftest try-encode-and-try-decode-are-total
  ; The form a boundary wants: it must answer a peer even when the answer is
  ; that it could not answer. `{:ok v}` / `{:error msg}`, the shape
  ; `interop/result` uses.
  (is (= {:ok "42"} (j/try-encode 42)))
  (is (= true (contains? (j/try-encode (erlang/self)) :error)))
  (is (includes? (:error (j/try-encode {"a" (erlang/self)})) "/a"))
  (is (= {:ok {"a" 1}} (j/try-decode "{\"a\":1}")))
  (is (= true (contains? (j/try-decode "{bad") :error))))

;; ── pretty ──────────────────────────────────────────────────────────────────

(deftest pretty-prints-with-an-indent
  (is (= "{\n  \"a\": 1\n}" (j/encode {"a" 1} {:pretty 2})))
  (is (= "[\n  1,\n  2\n]" (j/encode [1 2] {:pretty 2})))
  (is (= "{\n    \"a\": {\n        \"b\": 1\n    }\n}"
         (j/encode {"a" {"b" 1}} {:pretty 4}))
      "the pad compounds with depth")
  (is (= "{\n  \"a\": 1\n}" (j/encode {"a" 1} {:pretty true}))
      ":pretty true is two spaces")
  (is (= (j/decode (j/encode {"a" [1 {"b" nil}]}))
         (j/decode (j/encode {"a" [1 {"b" nil}]} {:pretty 2})))
      "pretty changes the bytes, never the value"))
