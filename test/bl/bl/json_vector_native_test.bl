(ns bl.json-vector-native-test
  (:require [bl.json :as j] [bl.json-native :as native]))

(deftest persistent-vector-storage-is-not-wire-data
  (is (native/loaded?) "this regression must exercise the native encoder")
  (doseq [n [0 1 5 31 32 33 63 64 65 1023 1024 1025 1056 1057 32769]]
    (let [v (reduce conj [] (range n))
          expected (str "[" (join "," (map str (range n))) "]")
          encoded (native/json-encode v)]
      (is (= expected encoded) (str "native logical vector at size " n))
      (is (= v (j/decode encoded))))))

(deftest trie-tag-shaped-flat-vector-remains-an-array
  (is (= "[\"bl_vec\",32,5,null,null]"
         (native/json-encode [:bl_vec 32 5 nil nil]))))

(deftest persistent-vectors-compose-inside-maps-and-vectors
  (let [row (reduce conj [] (range 65))
        rows (reduce conj [] (repeat 40 {"row" row}))]
    (is (= rows (j/decode (native/json-encode rows))))))
