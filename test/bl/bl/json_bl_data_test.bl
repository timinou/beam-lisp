; test/bl/bl/json_bl_data_test.bl
;
;   ./bin/bl test test/bl/bl/json_bl_data_test.bl
;
; The JSON encoder for beam-lisp data is `bl.json`. It encodes vectors, sets,
; lists and lazy seqs as arrays, keywords and symbols as strings, and names the
; type and JSON Pointer of a value it cannot encode.
;
; A bare `json/encode` (no alias) is OTP's `:json`, which cannot; the compiler
; warns at that call site and points at bl.json.

(ns bl.json-bl-data-test
  (:require [bl.test :refer [deftest is testing]]
            [bl.json :as json]))

(defn- has? [s part]
  (and (string? s) (not= :nomatch (binary/match s part))))

(deftest beam-lisp-data-encodes
  (testing "the reported shape: a vector of maps inside a map"
    (is (= "{\"system\":[{\"type\":\"text\"}]}" (json/encode {"system" [{"type" "text"}]}))))
  (testing "sets, lists, lazy seqs, keywords and symbols"
    (is (= "{\"k\":\"v\",\"l\":[1,2],\"q\":[2,3],\"s\":[1],\"sym\":\"a\"}"
           (json/encode {:k :v "l" (list 1 2) :q (map inc [1 2]) :s #{1} :sym 'a}))))
  (testing "nil is null and nested vectors stay arrays"
    (is (= "[null,[[1]],[]]" (json/encode [nil [[1]] []]))))
  (testing "it round-trips through decode"
    (is (= {"a" [1 "x" {"b" [true nil]}]}
           (json/decode (json/encode {:a [1 :x {:b [true nil]}]}))))))

(deftest an-unencodable-value-names-its-type-and-path
  (let [r (json/try-encode {"system" [{"body" (tuple 1 2)}]})]
    (is (has? (:error r) "tuple") (:error r))
    (is (has? (:error r) "/system/0/body") (:error r))))

(defn- compile-warnings
  "Stderr warnings from compiling `src` as file json_warn.bl."
  [src]
  (let [dev (second (erlang/tuple_to_list (StringIO/open "")))]
    (erlang/put :bl-compile-warnings dev)
    (try
      (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env "json-warn-fixture") "json_warn.bl")
      (finally (erlang/erase :bl-compile-warnings)))
    (let [text (second (erlang/tuple_to_list (StringIO/contents dev)))]
      (StringIO/close dev)
      text)))

(deftest bare-otp-json-calls-warn-with-their-position
  (testing "json/encode and json/decode without an alias"
    (let [w (compile-warnings
              "(ns json-warn-fixture)\n(defn f [v] (json/encode v))\n(defn g [s] (json/decode s))")]
      (is (has? w "json_warn.bl:2: json/encode is OTP's :json") w)
      (is (has? w "json_warn.bl:3: json/decode is OTP's :json") w)
      (is (has? w "Use bl.json") w)))
  (testing "no warning through the bl.json alias or the explicit OTP spelling"
    (is (= "" (compile-warnings
                (str "(ns json-warn-fixture (:require [bl.json :as json]))\n"
                     "(defn f [v] (json/encode v))\n"
                     "(defn g [v] (erlang/apply :json :encode (list v)))")))))
  (testing "OTP's other json functions do not warn"
    (is (= "" (compile-warnings
                "(ns json-warn-fixture)\n(defn f [n] (json/encode_integer n))")))))
