; wave25_transducer_test.bl — the transducer layer, exercised through the
; *vendored jank slices* (the byte-for-byte fixtures jank_compat checksum
; guards), ported from ExUnit test/beam_lisp/wave25_transducer_test.exs.
;
; A pass here means upstream core.jank code actually runs, not that a beam-lisp
; reimplementation agrees: every slice is loaded VERBATIM (only its column-0
; `;` header comments stripped) into ONE namespace, `jank.w25`, so cross-slice
; calls (transduce → reduce, mapcat → cat → preserving-reduced) resolve exactly
; as they would in core.jank.
;
; PARITY MAPPING. The ExUnit `setup`/`setup_all` has no ward equivalent — ward
; runs a file's tests in ONE process, in order — so the slice load happens ONCE,
; at load time, through `BeamLisp.Env/with_ns` (which restores the current ns).
; One `deftest` per ExUnit `test`, same order, one `is` per `assert`, so the
; assertion count is unchanged:
;
;   describe "reduced short-circuits reduce"            4 tests
;   describe "transduce"                                3 tests
;   describe "cat and the transducer 1-arities"        10 tests
;   describe "cpp/* shim entries through vendored paths"5 tests
;   describe "volatiles"                                6 tests
;   describe "interleave/interpose are lazy"            4 tests
;                                                      32 deftests / 57 `is`
;
; ADAPTATIONS.
;   * `in_slice/1` and `user/1` are the ExUnit helpers verbatim:
;     `BeamLisp.Compiler.eval_string(src, new_env(ns))`. `def`s land in the ns's
;     global var table, so a fresh env per call still sees the setup's defs —
;     the same reason the ExUnit suite worked.
;   * `assert_raise ArgumentError` on `(pop [])` is a typed class check: the
;     raised struct's `:__struct__` must be `:Elixir.ArgumentError`.
;   * `%BeamLisp.Vector{items: {…}}` comparisons become the BL vector literal
;     `[…]` for values the slices RETURN as vectors, and BL list literals
;     `'(…)` for values returned as lists/seqs (`doall`, `take`, pop-of-list).
;     This mirrors exactly what the ExUnit `==` compared: a BL value against the
;     literal the ExUnit source held.
;
;   * The ExUnit fixture reader used Elixir's `|>`, which threads FIRST. BL's
;     `->>` threads LAST, and `String/split` takes `(string, pattern)` — so the
;     same pipeline is written with explicit nesting here rather than `->>`,
;     which would feed `String/split` its pattern. The slice TEXT is identical.
;
; Run: bin/bl test test/bl/wave25_transducer_test.bl

(ns wave25.transducer.test)

; ── the vendored slices, co-loaded into one namespace ──────────────────────

(def ^:private slices
  ["04_comp" "37_take_while" "38_drop_while" "48_mapcat" "49_distinct"
   "66_reduced" "67_reduced_q" "68_ensure_reduced" "69_unreduced" "70_reduce"
   "71_completing" "72_transduce" "73_preserving_reduced" "74_cat" "75_peek"
   "76_pop" "81_promoting_arith" "83_int_q" "88_take_nth" "89_map"
   "90_map_indexed" "92_keep_indexed" "95_interpose" "98_reductions"
   "105_dedupe" "114_ratio" "115_decimal_rational" "116_sorted_preds"
   "120_nan_q"])

(defn- slice-src
  "The vendored slice text with its column-0 `;` header comments stripped — the
   ExUnit `Enum.reject(&String.starts_with?(&1, \";\"))` step. The slice text
   itself is never rewritten."
  [name]
  (join "\n"
        (filter (fn [line] (not (String/starts_with? line ";")))
                (String/split
                  (File/read! (Path/join (BeamLisp/cwd)
                                         (str "test/fixtures/jank/slice_" name ".bl")))
                  "\n"))))

(defn- load-slices!
  "Load every slice VERBATIM into `jank.w25`, restoring the current namespace
   after the `(ns jank.w25)` form runs."
  []
  (BeamLisp.Env/with_ns "jank.w25"
    (fn []
      (BeamLisp.Compiler/eval_string
        (str "(ns jank.w25)\n" (join "\n" (map slice-src slices)))
        (BeamLisp.Compiler/new_env "jank.w25")))))

(load-slices!)

(defn- in-slice
  "Evaluate `source` in a fresh `jank.w25` env — the ExUnit `in_slice/1`."
  [source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "jank.w25")))

(defn- user
  "Evaluate `source` in a fresh `user` env — the ExUnit `user/1`."
  [source]
  (BeamLisp.Compiler/eval_string source (BeamLisp.Compiler/new_env "user")))

(defn- raised
  "The exception `thunk` raised, or nil when it returned normally."
  [thunk]
  (try (do (thunk) nil) (catch e e)))

; ══ describe "reduced short-circuits reduce" ════════════════════════════════

(deftest reduced-step-halts-the-fold-and-yields-its-unwrapped-value
  ; 1+2+3=6 is the running total when the step first sees a value > 3; 4 and 5
  ; are never folded.
  (is (= 6 (in-slice "(reduce (fn [a x] (if (> x 3) (reduced a) (+ a x))) 0 [1 2 3 4 5])"))))

(deftest reduced-ensure-reduced-unreduced-round-trip-through-the-wrapper
  (is (= true (in-slice "(reduced? (reduced 42))")))
  (is (= false (in-slice "(reduced? 42)")))
  (is (= true (in-slice "(reduced? (ensure-reduced (reduced 5)))")))
  (is (= 7 (in-slice "(unreduced (reduced 7))")))
  ; unreduced passes a plain value through untouched.
  (is (= 9 (in-slice "(unreduced 9)"))))

(deftest reduce-returns-init-for-an-empty-coll-and-folds-a-vector
  (is (= 10 (in-slice "(reduce + 10 [])")))
  (is (= 10 (in-slice "(reduce + 0 [1 2 3 4])"))))

(deftest core-reduce-not-just-the-vendored-one-respects-reduced
  (user "(def w25-core-r (reduce (fn [a x] (if (> x 3) (reduced a) (+ a x))) 0 [1 2 3 4 5]))")
  (is (= 6 (user "w25-core-r"))))

; ══ describe "transduce" ════════════════════════════════════════════════════

(deftest map-transducer-over-cpp-reduce
  (is (= 9 (in-slice "(transduce (map inc) + 0 [1 2 3])"))))

(deftest take-while-transducer-stops-via-reduced
  (is (= 6 (in-slice "(transduce (take-while #(< % 4)) + 0 [1 2 3 4 5 6])"))))

(deftest completing-supplies-the-arity-1-step-so-conj-can-be-a-reducing-fn
  (is (= [2 3 4] (in-slice "(transduce (map inc) (completing conj) [] [1 2 3])"))))

; ══ describe "cat and the transducer 1-arities (previously untested)" ═══════

(deftest cat-concatenates-each-input-collection-into-the-reduction
  (is (= [1 2 3 4 5] (in-slice "(transduce cat (completing conj) [] [[1 2] [3] [4 5]])"))))

(deftest mapcat-s-transducer-composes-map-and-cat
  (is (= [1 1 2 4 3 9]
         (in-slice "(transduce (mapcat (fn [x] [x (* x x)])) (completing conj) [] [1 2 3])"))))

(deftest distinct-transducer-keeps-first-occurrences
  (is (= [1 2 3] (in-slice "(transduce (distinct) (completing conj) [] [1 2 1 3 2 1])"))))

(deftest drop-while-transducer-skips-leading-matches-then-emits-the-rest
  (is (= [3 4 1 2]
         (in-slice "(transduce (drop-while #(< % 3)) (completing conj) [] [1 2 3 4 1 2])"))))

(deftest take-while-transducer-keeps-leading-matches-then-stops
  (is (= [1 2 3]
         (in-slice "(transduce (take-while #(< % 4)) (completing conj) [] [1 2 3 4 5])"))))

(deftest map-indexed-transducer-pairs-each-element-with-its-index
  (is (= [[0 :a] [1 :b] [2 :c]]
         (in-slice "(transduce (map-indexed (fn [i x] [i x])) (completing conj) [] [:a :b :c])"))))

(deftest keep-indexed-transducer-drops-nil-results
  (is (= [0 2 4]
         (in-slice "(transduce (keep-indexed (fn [i x] (when (even? i) x))) (completing conj) [] [0 1 2 3 4])"))))

(deftest dedupe-transducer-removes-consecutive-duplicates
  (is (= [1 2 3 1] (in-slice "(transduce (dedupe) (completing conj) [] [1 1 2 2 3 1])"))))

(deftest interpose-transducer-inserts-sep-between-elements
  (is (= [1 :x 2 :x 3] (in-slice "(transduce (interpose :x) (completing conj) [] [1 2 3])"))))

(deftest take-nth-collection-arity-still-passes
  ; take-nth's transducer 1-arity also needs `rem`, a separate core gap
  ; (docs/jank-compat.md gap 7) — not this wave's.
  (is (= '(0 2 4 6) (in-slice "(doall (take-nth 2 [0 1 2 3 4 5 6]))"))))

; ══ describe "cpp/* shim entries through their vendored slice paths" ════════

(deftest peek-last-of-a-vector-first-of-a-seq-nil-when-empty
  (is (= 3 (in-slice "(peek [1 2 3])")))
  (is (= 1 (in-slice "(peek '(1 2 3))")))
  (is (nil? (in-slice "(peek [])"))))

(deftest pop-vector-without-last-seq-without-first-empty-throws
  (is (= [1 2] (in-slice "(pop [1 2 3])")))
  (is (= '(2 3) (in-slice "(pop '(1 2 3))")))
  (is (= :Elixir.ArgumentError (:__struct__ (raised (fn [] (in-slice "(pop [])")))))))

(deftest promoting-inc-is-plain-plus-on-arbitrary-precision-integers
  (is (= 42 (in-slice "(inc' 41)")))
  (is (= 4611686018427387905 (in-slice "(inc' 4611686018427387904)"))))

(deftest int?-is-integer
  (is (= true (in-slice "(int? 3)")))
  (is (= false (in-slice "(int? 3.0)"))))

(deftest is_-predicates-honestly-report-beam-lisp-s-type-space
  ; No Ratio, no BigDecimal, no sorted collection, no NaN reachable here — each
  ; is genuinely false for every value.
  (is (= false (in-slice "(ratio? 3)")))
  (is (= false (in-slice "(decimal? 3.0)")))
  (is (= false (in-slice "(sorted? [1 2])")))
  (is (= false (in-slice "(NaN? 1.0)"))))

; ══ describe "volatiles" ════════════════════════════════════════════════════

(deftest volatile!-and-deref-read-the-initial-value
  (user "(def w25-v (volatile! 10))")
  (is (= 10 (user "@w25-v")))
  (is (= 10 (user "(deref w25-v)"))))

(deftest vreset!-overwrites-and-returns-the-new-value
  (user "(def w25-v (volatile! 1))")
  (is (= 99 (user "(vreset! w25-v 99)")))
  (is (= 99 (user "@w25-v")))
  ; nil is a legal volatile value (drop-while's transducer stores it).
  (is (nil? (user "(vreset! w25-v nil)")))
  (is (nil? (user "@w25-v"))))

(deftest vswap!-reads-modifies-writes-and-returns-the-new-value
  (user "(def w25-v (volatile! -1))")
  (is (= 0 (user "(vswap! w25-v inc)")))
  (is (= 1 (user "(vswap! w25-v inc)")))
  (is (= 1 (user "@w25-v"))))

(deftest vswap!-with-extra-step-args
  (user "(def w25-v (volatile! 0))")
  (is (= 5 (user "(vswap! w25-v + 5)")))
  (is (= 5 (user "@w25-v"))))

(deftest volatile?-distinguishes-volatiles-from-atoms
  (user "(def w25-v (volatile! 0))")
  (user "(def w25-a (atom 0))")
  (is (= true (user "(volatile? w25-v)")))
  (is (= false (user "(volatile? w25-a)")))
  (is (= false (user "(volatile? 42)"))))

(deftest a-volatile-is-process-local-invisible-across-a-process-boundary
  ; The honest contract: visible only in the creating process. Hand the box to
  ; another process and deref there returns nil — which is why volatiles must
  ; not be used for cross-process coordination.
  (user "(def w25-v (volatile! 7))")
  (is (= 7 (user "@w25-v")))
  (is (nil? (BeamLisp.Refs/deref (user "(future (deref w25-v))")))))

; ══ describe "interleave/interpose are lazy in their inputs" ════════════════

(deftest interpose-over-an-infinite-seq-with-take-terminates
  (is (= '(0 :x 1 :x 2) (in-slice "(take 5 (interpose :x (range)))"))))

(deftest interleave-with-an-infinite-first-coll-and-take-terminates
  (is (= '(:sep 0 :sep 1 :sep)
         (in-slice "(take 5 (interleave (repeat :sep) (range)))"))))

(deftest interpose-finite-result-equals-the-expected-seq-and-prints
  (is (= true (in-slice "(= (interpose :x [1 2 3]) '(1 :x 2 :x 3))")))
  (is (= "(1 :x 2 :x 3)"
         (BeamLisp.Ns.Rt/print_str (in-slice "(interpose :x [1 2 3])")))))

(deftest doall-of-a-lazy-interleave-realizes-to-a-proper-list
  (is (= '(:sep 1 :sep 2) (in-slice "(doall (interleave (repeat :sep) [1 2]))"))))
