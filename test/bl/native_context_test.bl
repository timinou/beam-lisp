(ns native-context.test (:require [env]))
(defn- refusal [action]
 (try (action) nil (catch error (:original error))))
(deftest sdk-contexts-are-opaque-reused-and-owned-by-the-environment
 (let [scope (env/fork) token (env/with-env scope BeamLisp.Env/capture_native_context!)]
  (try
   (is (tuple? token)) (is (= 3 (erlang/tuple_size token)))
   (is (erlang/is_reference (elem token 2)))
   (is (= scope (:env (BeamLisp.Env/resolve_native_context! token))))
   (is (= false (Agent/get :Elixir.BeamLisp.Env #(contains? % :native-contexts))))
   (is (= token (env/with-env scope BeamLisp.Env/capture_native_context!)))
   (is (= :retired_native_context
          (refusal #(BeamLisp.Env/resolve_native_context!
                     (tuple :bl_native_context scope (erlang/make_ref))))))
   (is (Process/alive? (Process/whereis :Elixir.BeamLisp.Env)))
   (finally (env/destroy scope)))
  (is (= :retired_native_context (refusal #(BeamLisp.Env/resolve_native_context! token))))))
(deftest capacity-refusal-preserves-the-shared-environment-owner
 (let [scope (env/fork)]
  (try
   (env/with-env scope
    (fn []
     (let [tokens (mapv (fn [n] (BeamLisp.Env/with_ns (str "context.fixture." n)
                                  (fn [] (BeamLisp.Env/capture_native_context!)))) (range 256))]
      (is (= 256 (count (set tokens))))
      (is (= :native_context_capacity (refusal BeamLisp.Env/capture_native_context!)))
      (is (Process/alive? (Process/whereis :Elixir.BeamLisp.Env)))
      (is (= (first tokens) (BeamLisp.Env/with_ns "context.fixture.0" (fn [] (BeamLisp.Env/capture_native_context!))))))))
   (finally (env/destroy scope)))))
