; test/bl/tooling/pulse_draft_test.bl — the `.bl.org` scenario draft.
;
; `scenario-source` prints a bare deftest; `draft-source` prints the SAME
; recording as a literate document marked pending consolidation. This file pins
; the document's shape, its literate extraction, and the two rules that keep it
; safe to commit: secret-like values are redacted, and caller-supplied names
; cannot forge a fence, a heading or a form.
;
; Run: bl test test/bl/tooling/pulse_draft_test.bl

(ns tooling.pulse.draft-test
  (:require [tooling.pulse :as pulse]
            [bl.doc :as doc]
            [data.tap :as tap]
            [live.hiccup]))

(def steps
  "One recorded step, the shape `scenario` yields."
  [{:event [:assign :n 1] :expect [:text]}])

(defn sliced
  "The generated draft sliced as an org document: {:ok doc} | {:error …}."
  [text]
  (doc/slice-text text :org))

(defn code
  "The draft's beam-lisp cell source, asserted elsewhere to have parsed."
  [text]
  (doc/cells-source (:ok (sliced text))))

(defn ws-reply
  "The JSON payload the chip's websocket replies with to request `json`.
   The reply is `[:push (list (list :text json)) state]`; only the payload is
   of interest here."
  [json]
  (let [h (:handle-in (:ws-handlers (pulse/mount)))]
    (second (first (second (h ["x" json] nil))))))

(defn field
  "One field of a JSON reply payload, by name. The key's spelling after a
   round-trip depends on the reader, so accept either."
  [payload name]
  (let [m (interop/json-> payload)]
    (or (get m name) (get m (keyword name)))))

(defn count-lines
  "How many lines of `text` satisfy `pred`."
  [pred text]
  (count (filter pred (split text "\n"))))


;; ── the document ────────────────────────────────────────────────────

(deftest a-draft-names-the-scenario-the-app-and-its-status
  (let [src (pulse/draft-source "recorded-t7-t9" "my.app" "mount-for-test" steps)]
    (is (String/starts_with? src "#+TITLE: recorded-t7-t9"))
    (is (String/contains? src "#+BL_STATUS: pending-consolidation"))
    (is (String/contains? src "#+BL_KIND: pulse-scenario-draft"))
    (is (String/contains? src "#+BL_SOURCE: event-replay"))
    (is (String/contains? src "#+BL_SCENARIO: recorded-t7-t9"))
    (is (String/contains? src "#+BL_APP: my.app/mount-for-test"))
    (is (String/contains? src "#+BL_STEPS: 1"))
    (is (String/contains? src "#+BL_REDACTED: 0"))
    (is (String/contains? src ":CUSTOM_ID: recorded-t7-t9"))
    ;; the cell is `scenario-source`'s own output, so a draft and a pasted
    ;; test can never drift
    (is (String/contains? src "(ns tooling.pulse.draft.recorded-t7-t9"))
    (is (String/contains? src "(deftest recorded-t7-t9"))
    (is (String/contains? src "(app/mount-for-test)"))
    (is (String/contains? src "tooling.pulse/replay"))))

(deftest a-draft-states-what-it-is-not
  (let [src (pulse/draft-source "n" "my.app" "m" steps)]
    (is (String/contains? src "event replay, not a browser selector recording"))
    (is (String/contains? src "not a passing browser proof"))
    ;; no semantic assertion is synthesized: the one `is` in the document is
    ;; the signature comparison `scenario-source` already wrote
    (is (= 1 (count-lines (fn [l] (String/contains? l "(is ")) src)))))

(deftest draft-metadata-carries-the-user-and-the-moment
  (let [src (pulse/draft-source "n" "my.app" "m" steps
                                {:user "ada" :at 1768000000000 :note "from the studio"})]
    (is (String/contains? src "#+BL_USER: ada"))
    (is (String/contains? src "#+BL_RECORDED_AT: 1768000000000"))
    (is (String/contains? src "#+BL_NOTE: from the studio"))))

(deftest empty-steps-still-make-a-valid-document
  (let [src (pulse/draft-source "empty-run" "my.app" "mount-for-test" [])]
    (is (String/contains? src "#+BL_STEPS: 0"))
    (is (String/contains? src "(let [steps []"))
    (is (contains? (sliced src) :ok))
    (is (= "tooling.pulse.draft.empty-run" (:ns (:ok (sliced src)))))
    (is (String/contains? (code src) "(deftest empty-run"))))


;; ── literate extraction ─────────────────────────────────────────────

(deftest the-draft-is-a-readable-literate-document
  (let [src (pulse/draft-source "lifted" "my.app" "mount-for-test" steps)
        d (:ok (sliced src))]
    (is (= 1 (count (doc/cells d))))
    (is (= "tooling.pulse.draft.lifted" (:ns d)))
    ;; the loader's minimal extractor and bl.doc agree on the cell
    (is (= (doc/cells-source d) (BeamLisp.Loader/doc_source src :org)))
    (is (String/contains? (doc/cells-source d) "(deftest lifted"))
    ;; the prose is its OWN span — never swallowed into the code cell
    (is (some (fn [sp] (= :prose (:kind sp))) (:spans d)))
    ;; and only the fence lines are fences
    (is (= 1 (count-lines (fn [l] (= "#+begin_src beam-lisp" (trim l))) src)))
    (is (= 1 (count-lines (fn [l] (= "#+end_src" (trim l))) src)))))


(deftest the-drafts-cell-is-code-the-reader-accepts
  (let [src (pulse/draft-source "lifted" "my.app" "mount-for-test" steps)
        forms (BeamLisp.Compiler/read_all_data (code src))]
    ;; exactly the two forms the generator wrote — the ns, then the deftest —
    ;; so nothing a caller-supplied value could carry has been added
    (is (= 2 (count forms)))
    (is (= "ns" (name (first (first forms)))))
    (is (= "deftest" (name (first (second forms)))))))


;; ── redaction ───────────────────────────────────────────────────────

(deftest secret-like-values-never-reach-a-draft
  (let [event [:intent :auth/login {:username "ada" :password "hunter2"
                                    :nested {:api-key "sk-live-1"} :note "keep me"}]
        src (pulse/draft-source "login" "my.app" "m"
                                [{:event event :expect [:text]}])]
    (is (not (String/contains? src "hunter2")))
    (is (not (String/contains? src "sk-live-1")))
    ;; only the secret-like VALUES go; the rest of the event is the recording
    (is (String/contains? src "ada"))
    (is (String/contains? src "keep me"))
    (is (String/contains? src "...redacted..."))
    (is (String/contains? src "#+BL_REDACTED: 1"))
    ;; and the draft says the redaction is why it will not replay as recorded
    (is (String/contains? src "does not replay as recorded"))))

(deftest redaction-preserves-non-secret-shape
  ;; the projection may mask a VALUE, never silently restructure the recording
  (is (vector? (pulse/redact-event [:a :b])))
  (is (list? (pulse/redact-event '(:a :b))))
  (is (= [:a :b] (pulse/redact-event [:a :b])))
  (is (= '(:a :b) (pulse/redact-event '(:a :b))))
  (is (= [:intent :x {:password "...redacted..."}] (pulse/redact-event [:intent :x {:password "p"}]))))

(deftest redaction-is-a-pure-projection
  (let [event [:intent :x {:token "t" :plain "p" :session-id "s"}]
        masked (pulse/redact-event event)]
    (is (= "...redacted..." (get (nth masked 2) :token)))
    (is (= "...redacted..." (get (nth masked 2) :session-id)))
    (is (= "p" (get (nth masked 2) :plain)))
    ;; the recording itself is untouched
    (is (= "t" (get (nth event 2) :token)))
    (is (= true (pulse/redacted-event? event)))
    (is (= false (pulse/redacted-event? [:assign :n 1])))
    (is (= 2 (pulse/redactions [{:event [:assign :n 1] :expect []}
                                {:event [:x {:password "a"}] :expect []}
                                {:event [:y {:session "b"}] :expect []}])))))


;; ── names that cannot forge structure ───────────────────────────────

(deftest slugs-are-symbols-and-a-namespace-keeps-its-dots
  (is (= "recorded-t7-t9" (pulse/draft-slug "recorded-t7-t9")))
  (is (= "my.app" (pulse/draft-slug "my.app" true)))
  (is (= "my-app" (pulse/draft-slug "my.app")))          ; dots drop by default
  (is (= "my-app" (pulse/draft-slug "my app")))
  (is (= "s-9-lives" (pulse/draft-slug "9 lives")))      ; never a number token
  (is (nil? (pulse/draft-slug "###")))
  (is (nil? (pulse/draft-slug ""))))

(deftest a-hostile-name-cannot-forge-a-fence-or-a-form
  (let [evil "x\n#+end_src\n(bad)\n* heading"
        src (pulse/draft-source evil "my.app" "mount-for-test" steps)
        d (:ok (sliced src))]
    ;; the name is flattened onto ONE line everywhere it is shown
    (is (String/contains? src "x #+end_src (bad) * heading"))
    (is (= 1 (count-lines (fn [l] (= "#+end_src" (trim l))) src)))
    (is (= 1 (count-lines (fn [l] (= "#+begin_src beam-lisp" (trim l))) src)))
    ;; the document still slices, with the ONE cell the generator wrote
    (is (= 1 (count (doc/cells d))))
    (is (= "tooling.pulse.draft.x-end_src-bad-heading" (:ns d)))
    ;; the payload's own parentheses never reached the code
    (is (not (String/contains? (doc/cells-source d) "(bad)")))))

(deftest a-hostile-mount-name-cannot-inject-a-form
  (let [src (pulse/draft-source "ok" "my.app)\n(def evil 1)" "mount)\n(evil)" steps)
        d (:ok (sliced src))
        src-code (doc/cells-source d)]
    (is (= "tooling.pulse.draft.ok" (:ns d)))
    (is (not (String/contains? src-code "\n(def ")))
    (is (not (String/contains? src-code "\n(evil")))
    ;; the reader still sees exactly the two generated forms
    (is (= 2 (count (BeamLisp.Compiler/read_all_data src-code))))
    ;; the single generated assertion is still the only one
    (is (= 1 (count-lines (fn [l] (String/contains? l "(is ")) src-code)))))

(deftest a-hostile-metadata-value-stays-on-one-line
  (let [src (pulse/draft-source "n" "my.app" "m" steps
                                {:user "ada\n#+begin_src evil\n#+end_src"})]
    (is (String/contains? src "#+BL_USER: ada #+begin_src evil #+end_src"))
    (is (= 1 (count-lines (fn [l] (= "#+begin_src beam-lisp" (trim l))) src)))
    (is (= 1 (count-lines (fn [l] (= "#+end_src" (trim l))) src)))))


;; ── the wire: both projections from one request ──────────────────────

(deftest the-ws-export-ships-both-a-deftest-and-a-draft
  (let [t (pulse/tap)]
    (tap/clear! t)
    (tap/publish! t {:kind :commit :ops [[:text [0] "x"]]
                     :event [:intent :login {:password "pw-secret"}]})
    (let [fs (tap/frames t)
          from (:t (first fs))
          to (:t (last fs))
          ;; the legacy request shape: no name, no app — unchanged output
          legacy (ws-reply (str "[\"export\"," from "," to "]"))
          named  (ws-reply (str "[\"export\"," from "," to ",\"login-journey\"]"))]
      (is (String/contains? legacy "(deftest recorded-t"))
      (is (String/contains? legacy "(my-app/mount-for-test)"))
      (is (String/contains? legacy "#+BL_STATUS: pending-consolidation"))
      ;; a supplied name reaches the title, the CUSTOM_ID and the deftest
      (is (String/contains? named "#+BL_SCENARIO: login-journey"))
      (is (String/contains? named ":CUSTOM_ID: login-journey"))
      (is (String/contains? named "(deftest login-journey"))
      (is (String/contains? named "\"filename\":\"login-journey.bl.org\""))
      ;; `:draft` is the artifact that gets committed — the secret is gone
      (let [draft (field named "draft")]
        (is (String/contains? draft "#+BL_STATUS: pending-consolidation"))
        (is (String/contains? draft "...redacted..."))
        (is (not (String/contains? draft "pw-secret"))))
      ;; `:source` stays the raw, replayable recording: redacting it would
      ;; break the replay, so its contract is deliberately unchanged
      (is (String/contains? (field named "source") "pw-secret")))))

(deftest draft-from-reads-an-explicit-tap-not-the-process-ring
  (let [t (tap/open {:cap 10})]
    (tap/clear! (pulse/tap))                     ; the process ring is EMPTY
    (tap/publish! t {:kind :commit :ops [[:text [0] "x"]] :event [:assign :label "b"]})
    (let [fs (tap/frames t)
          from (:t (first fs))
          to (:t (last fs))
          src (pulse/draft-from "explicit" "my.app" "mount-for-test" from to t)
          opq (pulse/draft-from "explicit" "my.app" "mount-for-test" from to t
                                {:user "ada"})]
      (is (String/contains? src "#+BL_STEPS: 1"))
      (is (String/contains? src "[:assign :label \"b\"]"))
      (is (String/contains? opq "#+BL_USER: ada"))
      (is (= 0 (tap/size (pulse/tap)))))))

(deftest the-chip-offers-both-exports
  (let [html (live.hiccup/hiccup->html (pulse/chip-hiccup "/__pulse/ws"))]
    (is (String/contains? html "id=\"pc-export\""))
    (is (String/contains? html "id=\"pc-export-org\""))
    (is (String/contains? html ".bl.org draft"))
    (is (String/contains? html "test from here"))
    (is (String/contains? html "pending consolidation"))))


;; ── the file helper ─────────────────────────────────────────────────

(deftest draft-file-writes-only-inside-the-given-directory
  (let [dir "/tmp/pulse-draft-test"]
    (File/mkdir_p! dir)
    (let [r (pulse/draft-file! dir "../../escape" "my.app" "mount-for-test" steps)]
      (is (contains? r :ok))
      (is (String/contains? (:ok r) "/tmp/pulse-draft-test/"))
      (is (String/contains? (:ok r) "escape.bl.org"))
      (is (= true (File/exists? (:ok r))))
      (let [text (File/read! (:ok r))]
        (is (String/contains? text "#+BL_STATUS: pending-consolidation"))
        (is (= 1 (count (doc/cells (:ok (sliced text)))))))
      (File/rm! (:ok r)))
    ;; a directory that does not exist is REFUSED, never created
    (is (contains? (pulse/draft-file! "/tmp/pulse-draft-missing-9f3a" "a" "b" "c" []) :error))
    (is (contains? (pulse/draft-file! "" "a" "b" "c" []) :error))))
