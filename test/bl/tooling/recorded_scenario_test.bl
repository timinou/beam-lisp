; recorded_scenario_test.bl — a test the STUDIO wrote.
;
; The (deftest recorded …) block below is verbatim what pulse/scenario-source
; produced from three frames on the tap ring (see pulse_test.bl W5). The
; world it replays against is declared here, once, as any test would.
; Run: bl test test/bl/tooling/recorded_scenario_test.bl

(ns tooling.pulse.recorded.test
  (:require [tooling.pulse] [live.socket] [datom]))

(defn- flush-mailbox
  "Consume every message the replay pushed at `(erlang/self)`. The runner is one
   process for the whole tree, so `mount-for-test`'s socket frames would
   otherwise sit in the mailbox for the NEXT FILE to read as its own."
  []
  (loop []
    (receive
      _ (recur)
      (after 0 :ok))))

(defn- counter-view [_db _s locals]
  [:div [:span (str (get locals :n 0))] [:b (get locals :label "a")]])

(defn mount-for-test []
  (live.socket/mount {:view counter-view
                      :shared (datom/connect [])
                      :sink (erlang/self)
                      :locals {:n 0 :label "a"}}))

(deftest recorded
  ; recorded from the studio — replays the events, asserts what each changed
  (let [steps [{:event [:assign :n 1], :expect [:text]} {:event [:assign :label "b"], :expect [:text]} {:event [:assign :n 1], :expect []}]
        runs (tooling.pulse/replay (fn [] (mount-for-test)) steps)]
    (doseq [r runs]
      (is (= (:expect r) (:got r)) (str "after " (pr-str (:event r)))))
    (flush-mailbox)))
