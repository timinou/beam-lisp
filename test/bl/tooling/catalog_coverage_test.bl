; catalog_coverage_test.bl — the SELF-MEASUREMENT layer.
;
; Run: mix beam_lisp.test --path priv test/bl/tooling/catalog_coverage_test.bl
;
; The catalog indexes two fact sources into ONE datom db: `:prim/*` (the loom
; library's public surface) and `:entry/*` (what the showcase demonstrates,
; incl. `:entry/uses` — the prims each example references). Coverage is then a
; JOIN, computed live, never hand-maintained. These tests pin that the join is
; correct: a demonstrated prim is counted, an undemonstrated one is the gap,
; and the two partition the public surface exactly.

(ns tooling.catalog.coverage-test
  (:require [tooling.catalog :as c]))

;; One shared index over the real showcase — the same db `main` serves.
(def db (c/index-dir "examples/loom"))

;; ── the library surface is indexed ──────────────────────────────────

(deftest indexes-public-primitives
  ; loom ships ~50 public defns across box/token/ui/transform/form
  (is (> (count (c/public-prims db)) 30)
      "the library's public surface is discovered"))

(deftest public-prims-are-fully-qualified
  ; every prim name is "ns/local" so it joins against :entry/uses
  (is (every? (fn [n] (index-of n "/")) (c/public-prims db))
      "prim names carry their namespace"))

;; ── the join: demonstrated + undemonstrated partition the surface ───

(deftest demonstrated-and-gap-partition-the-surface
  (let [total (count (c/public-prims db))
        shown (count (c/demonstrated-prims db))
        gap   (count (c/undemonstrated-prims db))]
    (is (= total (+ shown gap))
        "every public prim is either demonstrated or a gap — never both, never neither")))

(deftest demonstrated-is-a-subset-of-public
  (let [pub (set (c/public-prims db))]
    (is (every? (fn [n] (contains? pub n)) (c/demonstrated-prims db))
        "you cannot demonstrate a prim that is not public")))

(deftest gap-and-demonstrated-are-disjoint
  (let [shown (set (c/demonstrated-prims db))
        gap   (set (c/undemonstrated-prims db))]
    (is (empty? (filter (fn [n] (contains? gap n)) shown))
        "no prim is both shown and a gap")))

;; ── a KNOWN demonstrated prim, and a KNOWN gap ──────────────────────

(deftest a-widely-used-prim-is-demonstrated
  ; every gallery composes with box/col — it must count as demonstrated
  (is (contains? (set (c/demonstrated-prims db)) "loom.box/col")
      "loom.box/col is referenced across the showcase"))

(deftest an-internal-only-prim-is-a-gap
  ; the sheet machinery (sx*, style->css, reset-sheet!, …) is loom's internal
  ; plumbing — no gallery calls it by name, so it is honestly a coverage gap.
  ; (Scale-facing tokens like t/color ARE demonstrated by the token gallery.)
  (is (contains? (set (c/undemonstrated-prims db)) "loom.token/style->css")
      "internal sheet plumbing is never demonstrated directly — a true gap"))

;; ── the coverage rollup ─────────────────────────────────────────────

(deftest coverage-reports-shown-total-pct-gap
  (let [cov (c/coverage db)]
    (is (= (:total cov) (count (c/public-prims db))))
    (is (= (:shown cov) (count (c/demonstrated-prims db))))
    (is (= (:gap cov) (c/undemonstrated-prims db)))
    (is (and (>= (:pct cov) 0) (<= (:pct cov) 100))
        "pct is a real percentage")))

(deftest coverage-pct-matches-the-ratio
  (let [cov (c/coverage db)
        expected (erlang/round (* 100.0 (/ (:shown cov) (:total cov))))]
    (is (= (:pct cov) expected))))

;; ── per-module breakdown ────────────────────────────────────────────

(deftest coverage-by-module-covers-every-module
  (let [mods (map :module (c/coverage-by-module db))]
    (is (contains? (set mods) "box"))
    (is (contains? (set mods) "ui"))
    (is (contains? (set mods) "token"))))

(deftest per-module-shown-never-exceeds-total
  (is (every? (fn [m] (<= (:shown m) (:total m))) (c/coverage-by-module db))
      "a module cannot demonstrate more prims than it has"))

(deftest module-totals-sum-to-the-surface
  ; each public prim belongs to exactly one module, so per-module totals
  ; must sum to the whole public surface
  (let [sum (reduce + 0 (map :total (c/coverage-by-module db)))]
    (is (= sum (count (c/public-prims db))))))

;; ── composition graph (R1) ──────────────────────────────────────────

(deftest co-occurrence-pairs-are-ordered-and-counted
  (let [pairs (c/co-occurrence db)]
    (is (seq pairs) "the showcase composes primitives together")
    ; each entry is [[a b] count] with a < b (undirected, canonical order)
    (is (every? (fn [pc] (let [[ab _] pc] (< (compare (first ab) (second ab)) 0))) pairs)
        "pairs are in canonical a<b order — no duplicate (b,a)")))

;; ── escape-hatch audit (R2) ─────────────────────────────────────────

(deftest escape-leaders-only-lists-nonzero
  ; the audit reports entries that reached past the token grammar to raw :style
  (is (every? (fn [e] (> (:n e) 0)) (c/escape-leaders db))
      "only entries with ≥1 escape hatch are listed"))

;; ── D1: per-thread coverage ──────────────────────────────────────

(deftest thread-coverage-spans-the-grammar
  ; every thread that has primitives reports shown/total/pct
  (let [ths (c/coverage-by-thread db)]
    (is (seq ths) "the grammar weaves at least one thread")
    (is (every? (fn [t] (and (<= (:shown t) (:total t))
                             (>= (:pct t) 0) (<= (:pct t) 100)))
                ths)
        "each thread's shown never exceeds its total; pct is a percentage")))

(deftest known-threads-are-present
  (let [names (set (map :thread (c/coverage-by-thread db)))]
    (is (contains? names :layout) "box weaves the layout thread")
    (is (contains? names :mark)   "ui weaves the mark thread")
    (is (contains? names :style)  "token weaves the style thread")))

(deftest a-prim-can-weave-several-threads
  ; box serves BOTH layout and style, so thread totals may exceed the surface
  (let [sum (reduce + 0 (map :total (c/coverage-by-thread db)))
        total (count (c/public-prims db))]
    (is (>= sum total)
        "multi-thread prims counted per thread ⇒ thread totals ≥ the flat surface")))

;; ── R3: static a11y audit ────────────────────────────────────────

(deftest showcase-is-a11y-clean
  ; loom's ui/field labels every input, so the real showcase has no findings
  (is (empty? (c/a11y-warnings db))
      "every demonstrated input carries a label link"))
