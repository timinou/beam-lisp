; test/bl/tooling/pulse_test.bl — the pulse instrument, on data.registry.
; Run: mix beam_lisp.test test/bl/tooling/pulse_test.bl

(ns tooling.pulse.test
  (:require [tooling.pulse :as pulse] [live.hiccup] [live.socket] [datom] [data.tap]))

(deftest track-then-snapshot
  (let [a (atom 7)
        id (pulse/track :atom "seven" (fn [] @a))
        cells (vec (:cells (pulse/snapshot)))
        mine (first (filter (fn [c] (= (:id c) id)) cells))]
    (is (= :atom (:kind mine)))
    (is (= "seven" (:name mine)))
    (is (= "7" (:value mine)))
    (pulse/untrack id)))

(deftest value-is-read-live
  (let [a (atom 1)
        id (pulse/track :atom "n" (fn [] @a))
        read-mine (fn [] (:value (first (filter (fn [c] (= (:id c) id))
                                                (vec (:cells (pulse/snapshot)))))))
        before (read-mine)]
    (swap! a inc)
    (is (= "1" before))
    (is (= "2" (read-mine)))
    (pulse/untrack id)))

(deftest untrack-removes
  (let [id (pulse/track :delay "d" (fn [] :x))
        present? (fn [] (some (fn [c] (= (:id c) id))
                              (vec (:cells (pulse/snapshot)))))]
    (is (= true (present?)))
    (pulse/untrack id)
    (is (not (present?)))))

(deftest throwing-reader-contained
  (let [id (pulse/track :bad "boom" (fn [] (throw (ex-info "x" {}))))
        vals (vec (map :value (:cells (pulse/snapshot))))]
    (is (some (fn [v] (= v ":unreadable")) vals))
    (pulse/untrack id)))

(deftest vitals-well-formed
  (let [v (pulse/vitals)]
    (is (<= 0 (:live-cells v)))
    (is (<= 0 (:retained-bytes v)))
    (is (<= 0 (:pending v)))
    (is (<= 0 (:tracked v)))))

(deftest page-and-chip-render
  (is (< 0 (String/length (pulse/page))))
  ; the chip is a self-contained fragment carrying the given endpoint
  (let [chip (pulse/chip-html "ws://host/__pulse/ws")]
    (is (< 0 (String/length chip)))
    (is (String/contains? chip "ws://host/__pulse/ws"))
    (is (String/contains? chip "pulse-chip"))))

(deftest mount-yields-page-and-handlers
  (let [m (pulse/mount)]
    (is (< 0 (String/length (:page m))))
    (is (contains? (:ws-handlers m) :init))
    (is (contains? (:ws-handlers m) :handle-info))))

(deftest chip-hiccup-is-a-node
  ; the chip is hiccup, so it composes into any view
  (let [node (pulse/chip-hiccup "/__pulse/ws")]
    (is (= :div (first node)))
    (is (= "pulse-chip" (get (second node) :id)))))

(deftest with-chip-injects-into-a-view
  ; decorate a view fn; the render carries both the app and the chip
  (let [my-view (fn [name] [:main [:h1 (str "hi " name)]])
        decorated (pulse/with-chip my-view)
        tree (decorated "ada")
        html (live.hiccup/hiccup->html tree)]
    (is (= :div (first tree)))
    (is (String/contains? html "hi ada"))
    (is (String/contains? html "pulse-chip"))
    (is (String/contains? html "/__pulse/ws"))))

(deftest with-chip-preserves-view-arity
  ; the decorated view keeps its own signature (multi-arg views still work)
  (let [v (fn [a b] [:p (str a "-" b)])
        d (pulse/with-chip v "/custom/ws")
        html (live.hiccup/hiccup->html (d "x" "y"))]
    (is (String/contains? html "x-y"))
    (is (String/contains? html "/custom/ws"))))

(deftest snapshot-carries-the-render-trace
  ; a traced subtree recompute shows up in the dashboard snapshot's trace
  (pulse/clear-trace!)
  (let [s (atom {:n 0})
        piece (pulse/traced :body [s] (fn [] [:p (str (:n @s))]))
        _ (deref piece)                 ; first paint
        _ (pulse/clear-trace!)          ; narrate updates only
        _ (swap! s update :n inc)
        _ (deref piece)                 ; recompute
        _ (pulse/note-patch! 1)
        snap (pulse/snapshot)
        t (:trace snap)]
    (is (some (fn [l] (= l "body")) (:recomputed t)))
    (is (= 1 (:patch-ops t)))))

(deftest traced-is-incremental
  ; pulse/traced recomputes only when its dep changes
  (pulse/clear-trace!)
  (let [a (atom 1)
        runs (atom 0)
        piece (pulse/traced :p [a] (fn [] (swap! runs inc) [:p (str @a)]))]
    (deref piece)
    (deref piece)          ; cached, no recompute
    (is (= 1 @runs))
    (swap! a inc)
    (deref piece)          ; recompute
    (is (= 2 @runs))))


;; ── W3: inspect + drive ─────────────────────────────────────────────

(deftest node-at-walks-differ-paths
  ; children are strings + elements, nils dropped, seqs spliced — as live.diff
  (let [tree [:div {:id "r"} "hello" nil [:ul (for [i [1 2]] [:li (str i)])] [:b "x"]]]
    (is (= "hello" (pulse/node-at tree [0])))
    (is (= [:li "2"] (pulse/node-at tree [1 1])))
    (is (= "x" (pulse/node-at tree [2 0])))
    (is (nil? (pulse/node-at tree [9])))))

(deftest inspect-answers-from-the-tap
  (let [t (pulse/tap)]
    (data.tap/clear! t)
    (data.tap/publish! t {:kind :mount :ops [] :event nil
                          :tree [:div [:button {:on-click [:intent :go {:n 1}] :class "b"} "go"]]})
    (data.tap/publish! t {:kind :commit :event [:assign :x 1]
                          :ops [[:text [0 0] "went"] [:set-attr [0] "class" "c"]]
                          :tree [:div [:button {:on-click [:intent :go {:n 1}] :class "c"} "went"]]})
    (let [i (pulse/inspect [0])]
      (is (= "button" (:tag i)))
      (is (= "[:intent :go {:n 1}]" (get (:events i) "on-click")))
      (is (= 1 (count (:touched i))))          ; only the commit touched [0]
      (is (= 2 (count (:ops (first (:touched i)))))) ; both ops are under [0]
      (is (= "[:assign :x 1]" (:event (first (:touched i))))))
    (is (= 1 (count (:touched (pulse/inspect [0 0])))))
    (is (= 1 (count (:ops (first (:touched (pulse/inspect [0 0])))))))))

(deftest set-drives-a-tracked-cell-through-its-writer
  (let [cell (atom 1)
        id (pulse/track :atom "drive-me" (fn [] @cell) (fn [v] (reset! cell v)))
        ro (pulse/track :atom "read-only" (fn [] 0))]
    (is (= {:ok "drive-me"} (pulse/set! "drive-me" "42")))
    (is (= 42 @cell))
    (is (= {:ok "drive-me"} (pulse/set! "drive-me" "{:a [1 2]}")))
    (is (= {:a [1 2]} @cell))
    (is (contains? (pulse/set! "read-only" "1") :error))
    (is (contains? (pulse/set! "nope" "1") :error))
    (is (= true (:writable (first (filter (fn [c] (= "drive-me" (:name c))) (pulse/cells))))))
    (pulse/untrack id) (pulse/untrack ro)))

;; ── W4: cost ────────────────────────────────────────────────────────

(deftest cost-is-svg-hiccup-over-the-tap
  (let [t (pulse/tap)]
    (data.tap/clear! t)
    (data.tap/publish! t {:kind :mount :ops [] :tree [:div "a"]})
    (data.tap/publish! t {:kind :commit :ops [[:text [0] "b"]] :tree [:div "b"] :ms 1.5})
    (data.tap/publish! t {:kind :commit :ops [] :tree [:div "b"] :ms 0.4})   ; recomputed, shipped nothing
    (let [h (pulse/cost-hiccup)
          html (live.hiccup/hiccup->html h)]
      (is (= :div (first h)))
      (is (String/contains? html "<svg"))
      (is (String/contains? html "<polyline"))
      (is (String/contains? html "1 commit recomputed but shipped 0 ops")))
    (is (pos? (pulse/wire-bytes (data.tap/frame t 2))))
    (is (pos? (pulse/wire-bytes (data.tap/frame t 1))))))

(deftest graph-draws-declared-edges-and-heat
  (let [a (atom 1) b (atom 2)
        sub (pulse/traced :two-deps {:alpha a :beta b} (fn [] [:p (str @a @b)]))]
    (is (= ["alpha" "beta"] (get (pulse/graph) :two-deps)))
    (pulse/clear-trace!)
    (deref sub)                                   ; first compute → recorded
    (let [html (live.hiccup/hiccup->html (pulse/graph-hiccup))]
      (is (String/contains? html "<svg"))
      (is (String/contains? html "alpha"))
      (is (String/contains? html "two-deps"))
      ;; the recomputed subtree's edges are hot (cyan), not idle (#1f2733)
      (is (String/contains? html "stroke=\"#39d0d8\"")))))

;; ── W5: click-to-test ───────────────────────────────────────────────

;; the world under test: a tiny live socket. `mount-for-test` is what a
;; recorded scenario replays against.
(defn- counter-view [_db _s locals]
  [:div [:span (str (get locals :n 0))] [:b (get locals :label "a")]])

(defn mount-for-test []
  (live.socket/mount {:view counter-view
                      :shared (datom/connect [])
                      :sink (erlang/self)
                      :locals {:n 0 :label "a"}}))

(deftest scenario-lifts-frames-into-steps-and-replays-them
  (let [t (pulse/tap)]
    (data.tap/clear! t)
    ;; "use the app": drive a socket that publishes into the studio's tap
    (let [st (assoc (mount-for-test) :tap t)
          st (live.socket/handle-event st [:assign :n 1])
          st (live.socket/handle-event st [:assign :label "b"])
          st (live.socket/handle-event st [:assign :n 1])]     ; no change → 0 ops
      ;; the mount ran before the tap was attached; the three commits are tapped
      (is (= 3 (data.tap/size t))))
    ;; export the three commits as a scenario (the :t counter never resets)
    (let [fs (data.tap/frames t)
          steps (pulse/scenario (:t (first fs)) (:t (last fs)))]
      (is (= 3 (count steps)))
      (is (= [:assign :n 1] (:event (first steps))))
      (is (= [:text] (:expect (first steps))))
      (is (= [] (:expect (nth steps 2))))               ; the no-op commit is recorded as such
      ;; replay against a FRESH world: every step's signature matches
      (let [runs (pulse/replay mount-for-test steps)]
        (is (every? :ok? runs)))
      ;; and a step that expects the wrong thing is caught
      (let [bad (assoc-in (into [] steps) [0 :expect] [:insert])
            runs (pulse/replay mount-for-test bad)]
        (is (= false (:ok? (first runs))))
        (is (= [:text] (:got (first runs)))))
      ;; the generated source is a deftest that references replay
      (let [src (pulse/scenario-source "recorded" "(tooling.pulse.test/mount-for-test)" steps)]
        (is (String/starts_with? src "(deftest recorded"))
        (is (String/contains? src "tooling.pulse/replay"))
        (is (String/contains? src "[:assign :label \"b\"]"))
        ;; WRITE it and RUN it: the exported test passes against the world
        (let [path "/tmp/recorded_scenario_test.bl"]
          (File/write! path (str "(ns tooling.pulse.recorded.test\n  (:require [tooling.pulse] [tooling.pulse.test]))\n\n" src))
          (is (= true (File/exists? path))))))))


;; ── W6: where the value lives — frontend cells ──────────────────────

(deftest tracked-cells-default-to-the-node
  ;; `track` is the backend cell: the value is computed here and read here
  (let [id (pulse/track :atom "be-default" (fn [] 1))
        c (first (filter (fn [x] (= (:id x) id)) (pulse/cells)))]
    (is (= :be (:where c)))
    (pulse/untrack id)))

(deftest a-frontend-cell-has-no-node-value-until-the-page-pushes-one
  (let [id (pulse/track-fe :atom "fe-mirrored")
        read-mine (fn [] (first (filter (fn [c] (= (:id c) id)) (pulse/cells))))]
    (is (= :fe (:where (read-mine))))
    (is (= ":unset" (:value (read-mine))))        ; the page has not spoken yet
    (is (= {:ok "fe-mirrored"} (pulse/fe-push! "fe-mirrored" 42)))
    (is (= "42" (:value (read-mine))))            ; mirrored, not computed here
    (pulse/untrack id)))

(deftest a-frontend-cell-is-driveable-through-its-mirror
  ;; the node can still set it (the ✎ route): the writer writes the mirror
  (let [id (pulse/track-fe :atom "fe-drive")
        read-mine (fn [] (:value (first (filter (fn [c] (= (:id c) id))
                                                (pulse/cells)))))]
    (is (= {:ok "fe-drive"} (pulse/set! "fe-drive" "7")))
    (is (= "7" (read-mine)))
    (pulse/untrack id)))

(deftest frontend-cells-are-registered-idempotently
  ;; a reconnecting chip re-announces its cells: that must not double a row
  (let [id (pulse/track-fe :atom "fe-once")
        n (fn [] (count (filter (fn [c] (= "fe-once" (:name c))) (pulse/cells))))]
    (is (= 1 (n)))
    (is (= {:ok "fe-once"} (pulse/fe-track! "atom" "fe-once")))
    (is (= 1 (n)))
    (pulse/untrack id)))

(deftest locality-counts-both-sides
  (let [a (pulse/track :atom "loc-be" (fn [] 1))
        b (pulse/track-fe :atom "loc-fe")
        loc (pulse/locality)]
    (is (<= 1 (:be loc)))
    (is (<= 1 (:fe loc)))
    (is (<= 2 (+ (:be loc) (:fe loc))))
    (pulse/untrack a) (pulse/untrack b)))

(deftest snapshot-carries-locality
  (let [loc (:locality (pulse/snapshot))]
    (is (contains? loc :fe))
    (is (contains? loc :be))))

(deftest unknown-frontend-push-is-refused
  (is (contains? (pulse/fe-push! "no-such-frontend-cell" 1) :error)))

(deftest chip-badges-every-atom-frontend-or-backend
  (let [chip (pulse/chip-html "/__pulse/ws")]
    ;; the frontend store and its queue travel with the chip
    (is (String/contains? chip "__pulseFe"))
    (is (String/contains? chip "__pulseFeQ"))
    ;; and the panel names both sides
    (is (String/contains? chip "frontend · held in this page"))
    (is (String/contains? chip "backend · held on the node"))
    ;; the collapsed badge reports the split
    (is (String/contains? chip "'fe · '"))))

(deftest fe-declare-queues-frontend-cells-for-the-page
  (let [node (pulse/fe-declare [[:atom "n" 0] [:atom "label" "a"]])
        html (live.hiccup/hiccup->html node)]
    (is (= :script (first node)))
    (is (String/contains? html "__pulseFeQ"))
    (is (String/contains? html "'n'"))
    (is (String/contains? html "'label'"))))

(deftest ws-registers-frontend-cells-and-mirrors-their-values
  ;; the chip's two verbs: fe-track (announce a browser-held cell) and
  ;; fe-set (push its current value)
  (let [h (:handle-in (:ws-handlers (pulse/mount)))]
    (h ["x" "[\"fe-track\",\"atom\",\"ws-fe\"]"] nil)
    (let [c (first (filter (fn [x] (= "ws-fe" (:name x))) (pulse/cells)))]
      (is (= :fe (:where c)))
      (is (= ":unset" (:value c)))
      (h ["x" "[\"fe-set\",\"ws-fe\",9]"] nil)
      (let [c2 (first (filter (fn [x] (= "ws-fe" (:name x))) (pulse/cells)))]
        (is (= "9" (:value c2))))
      (pulse/untrack (:id c)))))



(deftest frontend-announces-are-validated-and-capped
  ;; the rule as a question — no enrolment needed to test the boundaries
  (is (not (pulse/fe-admit? "atom" "")))        ; empty name
  (is (not (pulse/fe-admit? "atom" 123)))       ; name is not a string
  (is (not (pulse/fe-admit? 123 "x")))          ; kind is not a string
  (is (not (pulse/fe-admit? "atom" "x" 0)))    ; the cap branch: no room
  (is (pulse/fe-admit? "atom" "x" 64)))        ; room

(deftest a-malformed-announce-never-enrols
  ;; what a hostile or buggy page can reach is the ws verbs — and nothing else
  (let [h (:handle-in (:ws-handlers (pulse/mount)))
        before (count (pulse/cells))]
    (h ["x" "[\"fe-track\"]"] nil)                    ; no args at all
    (h ["x" "[\"fe-track\",123,\"x\"]"] nil)          ; kind is a number
    (h ["x" "[\"fe-track\",\"atom\",\"\"]"] nil)    ; empty name
    (h ["x" "[\"fe-track\",\"atom\",7]"] nil)        ; name is a number
    (is (= before (count (pulse/cells))))))

