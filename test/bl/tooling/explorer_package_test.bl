; explorer_package_test.bl — the explorer generalized to ANY package.
;
; Run: mix beam_lisp.test --path priv test/bl/tooling/explorer_package_test.bl
;
; The self-measuring engine is not a loom catalog — it explores any beam-lisp
; library. A package is a value: {:name :lib-dir :examples-dir [:threads]}. These
; tests point the SAME code path (`index-package`) at a tiny fixture library that
; is nothing like loom and declares no thread vocabulary, and confirm: the public
; surface is found, the private helper is excluded, coverage is honest, and the
; thread axis gracefully disappears when a package declares no threads.

(ns tooling.explorer.package-test
  (:require [tooling.catalog :as c]))

(def fixture
  {:name "widget"
   :lib-dir "test/fixtures/explore/lib"
   :examples-dir "test/fixtures/explore/examples"})

(def db (c/index-package fixture))

;; ── a foreign package's surface is discovered ───────────────────────

(deftest finds-the-public-surface
  (is (= ["fixture.widget/greet" "fixture.widget/shout"]
         (into [] (c/public-prims db)))
      "both public defns are indexed, fully qualified"))

(deftest excludes-private-defns
  (is (not (contains? (set (c/public-prims db)) "fixture.widget/whisper"))
      "a defn- is not part of the public surface"))

;; ── coverage is computed the same way for any package ───────────────

(deftest coverage-is-honest
  (let [cov (c/coverage db)]
    (is (= 2 (:total cov)) "two public primitives")
    (is (>= (:pct cov) 0) "pct is a real number")
    (is (= (:total cov) (+ (:shown cov) (count (:gap cov))))
        "demonstrated + gap partition the surface, for any package")))

;; ── graceful thread degradation (Wave 3) ────────────────────────────

(deftest no-thread-vocabulary-means-no-thread-axis
  ; the fixture package declares no :threads / :module-threads, so every prim
  ; carries an empty thread set — and the thread projection is empty, which is
  ; what lets the Self panel omit the thread card for a non-loom package.
  (is (empty? (c/db-threads db))
      "a package with no thread vocabulary exposes no threads")
  (is (empty? (c/coverage-by-thread db))
      "coverage-by-thread is empty ⇒ the panel omits the axis"))

;; ── the same engine still measures loom with its full thread axis ───

(deftest loom-still-has-its-threads
  ; the default package is unaffected — it declares the 7-thread grammar
  (let [loom-db (c/index-package c/loom-package)]
    (is (seq (c/db-threads loom-db))
        "loom declares a thread vocabulary, so its axis is present")
    (is (contains? (set (c/db-threads loom-db)) :layout)
        "loom weaves the layout thread")))
