; test/bl/tooling/incremental_test.bl — render only what changed.
; Run: mix beam_lisp.test test/bl/tooling/incremental_test.bl
;
; Proves the incremental property: an unchanged component returns identical
; hiccup, so the differ prunes it (zero ops); only the changed piece recomputes.

(ns tooling.incremental.test
  (:require [tooling.incremental :as inc]
            [live.diff :as diff]))

(deftest component-memoizes-and-diff-prunes
  (let [renders (atom 0)
        row (inc/component (fn [item]
                             (swap! renders inc)
                             [:li {:key (:id item)} (:text item)]))
        board (fn [items] (into [:ul] (map row items)))
        items1 [{:id 1 :text "a"} {:id 2 :text "b"} {:id 3 :text "c"}]
        items2 [{:id 1 :text "a"} {:id 2 :text "CHANGED"} {:id 3 :text "c"}]
        t1 (board items1)
        before @renders
        t2 (board items2)
        after @renders
        ops (diff/diff t1 t2)]
    ; three rows rendered initially
    (is (= 3 before))
    ; only the changed row recomputes
    (is (= 1 (- after before)))
    ; the diff touches only the changed subtree
    (is (= 1 (count ops)))))

(deftest subtree-recomputes-only-on-its-own-dep
  (let [header-state (atom {:title "Home"})
        body-state (atom {:count 0})
        hr (atom 0)
        br (atom 0)
        header (inc/subtree [header-state]
                            (fn [] (swap! hr inc) [:header (:title @header-state)]))
        body (inc/subtree [body-state]
                          (fn [] (swap! br inc) [:main (str "count " (:count @body-state))]))
        view (fn [] [:div @header @body])
        t1 (view)]
    ; change only the body
    (swap! body-state update :count inc)
    (let [t2 (view)
          ops (diff/diff t1 t2)]
      ; header computed once, never again; body computed twice (init + change)
      (is (= 1 @hr))
      (is (= 2 @br))
      ; one op: only the body subtree changed
      (is (= 1 (count ops))))))

(deftest unchanged-view-produces-no-ops
  (let [s (atom {:n 1})
        piece (inc/subtree [s] (fn [] [:p (str (:n @s))]))
        view (fn [] [:div @piece])
        t1 (view)
        t2 (view)]
    ; nothing changed: the differ prunes the whole tree
    (is (= 0 (count (diff/diff t1 t2))))))
