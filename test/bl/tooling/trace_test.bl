; test/bl/tooling/trace_test.bl — why did the UI update?
; Run: mix beam_lisp.test test/bl/tooling/trace_test.bl
;
; Proves the causal record: only the subtree whose dep changed records a
; recompute, and last-update summarizes the update honestly.

(ns tooling.trace.test
  (:require [tooling.trace :as trace]
            [live.diff :as diff]))

(deftest records-only-the-changed-subtree
  (let [tr (trace/open)
        header-state (atom {:title "Home"})
        body-state (atom {:count 0})
        header (trace/traced tr :header [header-state]
                             (fn [] [:header (:title @header-state)]))
        body (trace/traced tr :body [body-state]
                           (fn [] [:main (str (:count @body-state))]))
        view (fn [] [:div @header @body])
        t1 (view)]
    (trace/clear! tr)                    ; trace updates, not first paint
    (swap! body-state update :count inc) ; change ONLY body
    (let [t2 (view)
          ops (diff/diff t1 t2)]
      (trace/note-patch! tr (count ops))
      (let [u (trace/last-update tr)]
        ; only :body recomputed
        (is (= [:body] (:recomputed u)))
        ; one op shipped
        (is (= 1 (:patch-ops u)))))))

(deftest a-noop-change-shows-recompute-without-patch
  ; the invisible pathology made visible: a subtree recomputes but produces
  ; no DOM change (its output is equal), so :recomputed is non-empty yet
  ; patch-ops is 0.
  (let [tr (trace/open)
        s (atom {:v 1 :unrelated 0})
        ; depends on the WHOLE map, but renders only :v
        piece (trace/traced tr :piece [s] (fn [] [:p (str (:v @s))]))
        view (fn [] [:div @piece])
        t1 (view)]
    (trace/clear! tr)
    (swap! s update :unrelated inc)   ; changes the dep value, not the output
    (let [t2 (view)
          ops (diff/diff t1 t2)]
      (trace/note-patch! tr (count ops))
      (let [u (trace/last-update tr)]
        (is (= [:piece] (:recomputed u)))  ; it did recompute
        (is (= 0 (:patch-ops u)))))))      ; but shipped nothing — wasteful sub

(deftest trace-is-bounded
  (let [tr (trace/open)]
    (doseq [i (range 700)] (trace/record! tr {:kind :recompute :label :x}))
    ; capped, does not grow without bound
    (is (<= (count (trace/events tr)) 500))))

(deftest clear-resets
  (let [tr (trace/open)]
    (trace/record! tr {:kind :patch :ops 3})
    (is (= 1 (count (trace/events tr))))
    (trace/clear! tr)
    (is (= 0 (count (trace/events tr))))))
