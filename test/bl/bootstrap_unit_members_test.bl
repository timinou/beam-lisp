(ns test.bootstrap-unit-members (:require [seed]))

(defn- producer-ebin
  "The image ebin the boot tier was installed from. Asked of `Ns.Rt`, which no
   test reloads: another suite's fixture may republish `Ns.Multi` from a scratch
   directory it then deletes, and `code:which` would name that directory."
  []
 (or (System/get_env "BL_SEED_UNIT_MEMBERS_TEST_EBIN")
     (Path/dirname (erlang/list_to_binary (code/which :Elixir.BeamLisp.Ns.Rt)))))

(defn- inventory []
 (let [ebin (producer-ebin)
       objects (:objects (seed/boot-inventory (seed/namespaces (str (BeamLisp/cwd) "/priv/boot")) ebin))
       modules (into {} (map (fn [object]
                        [(:name object) (Base/encode16 (crypto/hash :sha256 (:bytes object))
                                           (list (tuple :case :lower)))]) objects))]
  {:ebin ebin :objects objects
   :manifest {"compiler_key" (BeamLisp.AOTCache/current_compiler_key) "modules" modules}}))

(defn- attribute [bytes key]
 (let [chunks (beam_lib/chunks bytes (list :attributes))
       attrs (Keyword/get (elem (elem chunks 1) 1) :attributes)
       value (Keyword/get attrs key)]
  (if (and (erlang/is_list value) (= 1 (erlang/length value))) (erlang/hd value) value)))

(defn- refusal [action]
 (try (action) nil (catch error (ex-message error))))

(deftest complete-current-producer-unit-bytes-pass-without-loading-or-sdk-admission
 (let [f (inventory) path (code/which :Elixir.BeamLisp.Ns.Core)
       lease (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)]
  (is (> (count (:objects f)) 0))
  (is (= :ok (BeamLisp.Bootstrap/assert_seed_unit_closure! (:ebin f) (:manifest f))))
  (is (= path (code/which :Elixir.BeamLisp.Ns.Core)))
  (is (= lease (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))))

(deftest manifest-omission-refuses-even-with-the-real-companion-still-on-disk
 (let [f (inventory)
       companion (first (filter #(= :macros (attribute (:bytes %) :bl_sdk_initializer_lambda_kind)) (:objects f)))
       path (code/which :Elixir.BeamLisp.Ns.Core)
       lease (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)]
  (is (some? companion))
  (is (File/exists? (str (:ebin f) "/" (:name companion))))
  (let [manifest (update (:manifest f) "modules" #(dissoc % (:name companion)))
        message (refusal #(BeamLisp.Bootstrap/assert_seed_unit_closure! (:ebin f) manifest))]
   (is (and (string? message) (includes? message "incomplete bootstrap compiler unit"))))
  (is (= path (code/which :Elixir.BeamLisp.Ns.Core)))
  (is (= lease (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))))

(deftest absent-descriptor-only-remains-compatible-with-a-mismatched-legacy-stage
 (let [root (str (System/tmp_dir!) "/bootstrap-legacy-unit-" (System/unique_integer (list :positive)))
       module :Elixir.BeamLisp.Ns.Legacy-unit-fixture
       name (str (Atom/to_string module) ".beam")
       beam (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for module (list) (list)))
       modules {name (Base/encode16 (crypto/hash :sha256 (elem beam 1)) (list (tuple :case :lower)))}
       before (code/which module)]
  (try
   (File/mkdir_p! root) (File/write! (str root "/" name) (elem beam 1))
   ;; A parser/legacy compatibility fixture; never loaded or SDK adopted.
   (is (= :ok (BeamLisp.Bootstrap/assert_seed_unit_closure! root
               {"compiler_key" "previous-generation" "modules" modules})))
   (is (includes? (refusal #(BeamLisp.Bootstrap/assert_seed_unit_closure! root
                            {"compiler_key" (BeamLisp.AOTCache/current_compiler_key) "modules" modules}))
                 "current bootstrap unit has no member descriptor"))
   (is (= before (code/which module)))
   (finally (File/rm_rf! root)))))
