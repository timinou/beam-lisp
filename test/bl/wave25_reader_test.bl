; test/bl/wave25_reader_test.bl — the wave-25 reader gaps, ported from
; test/beam_lisp/wave25_reader_test.exs.
;
; `^` reader metadata and `#?`/`#?@` reader conditionals: the two reader gaps
; the jank and Specter measurements landed on. The two halves assert at
; different depths — reader-level tests check the SHAPE `^`/`#?` read into
; (the `{:meta, form, m}` wrapper and the selected/spliced forms); the
; compiler-level tests check the payoff (`^{:doc …}` on a `def`/`defn`
; landing in the var's metadata, readable via `Env.meta`/`Env.doc_string`).
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; All 29 ExUnit tests map one-to-one onto a same-named BL deftest, in the
; original order (the `describe`-free file keeps its sequence):
;   ^:kw attaches {:kw true}; ^{map} attaches the map; ^Sym → {:tag Sym};
;   ^"str" → {:tag "str"}; stacked ^ merges; ^ on a list merges with its
;   source position; ^ survives on the def/defn name symbol; ^ with no
;   following form is a reader error; ^{...} map keys must be keywords;
;   ^{:doc} on a def lands in var metadata; ^:private on a def lands;
;   stacked ^{:doc} ^:private on a defn lands; defn's docstring and ^{}
;   both land; defn accepts a Clojure attr-map literal; doc/1 and meta see
;   the ^ doc; #? selects :clj; #? skips a non-matching branch; #? falls
;   back to :default; #? with no match and no :default is an error; #?
;   feature must be a keyword; #?@ splices into a vector; #?@ splices into
;   a list; #?@ uses :default; #?@ requires a collection; #?@ at top level
;   is refused; a misread bare `#?` symbol is gone; a def with ^ still
;   carries its source line; nested positions under ^ are intact;
;   read_all/read_one still deep-unwrap ^ and positions.
;
; Adaptations, and why:
;   * `alias BeamLisp.{Compiler, Env, FormMeta, Reader}` becomes direct module
;     calls; BL has no `alias` in a test file, and the calls are already named.
;   * A raw Elixir tuple `{:meta, form, m}` is written as `(tuple :meta f m)`
;     — BL has no literal Erlang tuple, and the reader produces exactly that
;     tuple. Reader-node children are Erlang LISTS, so a node's items are
;     `(list …)`, never the BL vector `[…]`.
;   * `assert_raise BeamLisp.Reader.SyntaxError, fn -> … end` becomes a typed
;     `(catch BeamLisp.Reader.SyntaxError _e true)` — the reader's diagnostic is
;     rendered by the host edge as that struct, so the type IS the contract.
;   * `use ExUnit.Case, async: false` has no ward equivalent: `bl test` already
;     runs each FILE in its own isolated fork, and the tests inside one file run
;     in order in that one env, so the shared var table is never raced.
;
; Run: bin/bl test test/bl/wave25_reader_test.bl

(ns wave25-reader.test)

(defn- read-w25 [src] (BeamLisp.Reader/read_string src "w25.bl"))
(defn- read-one-w25 [src] (BeamLisp.Reader/read_one src))
(defn- env [ns-name] (BeamLisp.Compiler/new_env ns-name))
(defn- start [] (BeamLisp/init))

; A compile/read that MUST refuse, with the reader's own error type.
(defn- syntax-error? [f]
  (try
    (do (f) false)
    (catch BeamLisp.Reader.SyntaxError _e true)))

; ── `^` reader metadata: the four shorthands ───────────────────────────────

(deftest caret-kw-attaches-kw-true-to-the-following-form
  (is (= (tuple :meta (tuple :symbol "some-name") {:private true})
         (first (read-w25 "^:private some-name")))))

(deftest caret-map-attaches-the-map-itself
  (is (= (tuple :meta (tuple :symbol "x") {:doc "hi"})
         (first (read-w25 "^{:doc \"hi\"} x")))))

(deftest caret-sym-attaches-tag-sym
  (is (= (tuple :meta (tuple :symbol "x") {:tag (tuple :symbol "String")})
         (first (read-w25 "^String x")))))

(deftest caret-string-attaches-tag-string
  (is (= (tuple :meta (tuple :symbol "x") {:tag "a type"})
         (first (read-w25 "^\"a type\" x")))))

(deftest stacked-caret-metadata-merges
  (is (= (tuple :meta (tuple :symbol "x") {:private true :static true})
         (first (read-w25 "^:private ^:static x")))))

(deftest caret-metadata-on-a-list-merges-with-its-source-position
  (let [form (first (read-w25 "^{:doc \"d\"} (foo 1)"))
        m (BeamLisp.FormMeta/meta form)]
    ; The user metadata and the wave-20 position share one wrapper but stay
    ; disjoint by key: the position is still there for error attribution. The
    ; column is where the LIST opens, matching the ExUnit answer key.
    (is (= (tuple :list (list (tuple :symbol "foo") 1)) (erlang/element 2 form)))
    (is (= "d" (get m :doc)))
    (is (= 1 (get m :line)))
    (is (= 12 (get m :col)))
    (is (= "w25.bl" (get m :file)))))

(deftest caret-metadata-survives-on-the-def-defn-name-symbol
  (let [form (first (read-w25 "(def ^{:doc \"x\"} foo 1)"))
        items (erlang/element 2 (erlang/element 2 form))]
    ; The whole list carries its position wrapper; the def name symbol carries
    ; the `^` metadata, unwrapped only by name_of/1.
    (is (= (tuple :symbol "def") (first items)))
    (is (= (tuple :meta (tuple :symbol "foo") {:doc "x"}) (second items)))
    (is (= 1 (nth items 2)))))

(deftest caret-with-no-following-form-is-a-reader-error
  (is (syntax-error? (fn [] (read-one-w25 "^:private")))))

(deftest caret-map-keys-must-be-keywords
  (is (syntax-error? (fn [] (read-one-w25 "^{foo 1} x")))))

; ── `^` landing in var metadata ────────────────────────────────────────────

(deftest caret-doc-on-a-def-lands-in-the-vars-metadata-readable-via-env-meta
  (start)
  (BeamLisp.Compiler/eval_string "(def ^{:doc \"adds one\"} add1 (fn [x] (+ x 1)))" (env "w25"))
  (is (= (tuple :ok {:doc "adds one"}) (BeamLisp.Env/meta "w25" "add1"))))

(deftest caret-private-on-a-def-lands-in-the-vars-metadata
  (start)
  (BeamLisp.Compiler/eval_string "(def ^:private secret 42)" (env "w25p"))
  (is (= (tuple :ok {:private true}) (BeamLisp.Env/meta "w25p" "secret"))))

(deftest stacked-caret-doc-and-private-on-a-defn-land-in-the-vars-metadata
  (start)
  (BeamLisp.Compiler/eval_string "(defn ^{:doc \"mult\"} ^:private mul [a b] (* a b))" (env "w25m"))
  (is (= (tuple :ok {:doc "mult" :private true}) (BeamLisp.Env/meta "w25m" "mul"))))

(deftest defns-docstring-and-caret-metadata-both-land-in-the-vars-metadata
  (start)
  (BeamLisp.Compiler/eval_string "(defn ^{:arglists '([x])} twice \"doubles\" [x] (* 2 x))" (env "w25d"))
  (let [m (erlang/element 2 (BeamLisp.Env/meta "w25d" "twice"))
        arg1 (first (get m :arglists))]
    (is (= "doubles" (get m :doc)))
    ; `'([x])` compiles to a list whose single element is the vector [x].
    (is (= [(tuple :symbol "x")] arg1))))

(deftest defn-accepts-a-clojure-attr-map-literal-after-the-docstring
  (start)
  (BeamLisp.Compiler/eval_string "(defn bitnot \"complement\" {:inline (fn* [o] o)} [x] (- x))" (env "w25a"))
  (let [m (erlang/element 2 (BeamLisp.Env/meta "w25a" "bitnot"))]
    (is (= "complement" (get m :doc)))
    (is (not (nil? (get m :inline))))))

(deftest doc-and-meta-see-the-caret-doc
  (start)
  (BeamLisp.Compiler/eval_string "(def ^{:doc \"the doc\"} ddoc 7)" (env "w25doc"))
  (is (= (tuple :ok {:doc "the doc"}) (BeamLisp.Env/meta "w25doc" "ddoc"))))

; ── `#?` reader conditional: selection ─────────────────────────────────────

(deftest reader-conditional-selects-the-clj-branch
  (is (= 1 (read-one-w25 "#?(:clj 1 :cljs 2)"))))

(deftest reader-conditional-skips-a-non-matching-branch-and-picks-the-matching-one
  (is (= 2 (read-one-w25 "#?(:cljs 1 :clj 2)"))))

(deftest reader-conditional-falls-back-to-default-when-no-platform-branch-matches
  (is (= 2 (read-one-w25 "#?(:cljs 1 :clj 2 :default 3)")))
  (is (= 3 (read-one-w25 "#?(:cljs 1 :default 3)"))))

(deftest reader-conditional-with-no-matching-feature-and-no-default-is-a-reader-error
  (is (syntax-error? (fn [] (read-one-w25 "#?(:cljs 1)")))))

(deftest reader-conditional-feature-must-be-a-keyword
  (is (syntax-error? (fn [] (read-one-w25 "#?(foo 1 :clj 2)")))))

; ── `#?@` reader conditional: splicing ─────────────────────────────────────

(deftest reader-conditional-splice-splices-a-vector-branch-into-a-vector
  (is (= (tuple :vector (list 0 1 2 3))
         (read-one-w25 "[0 #?@(:clj [1 2] :cljs [9]) 3]"))))

(deftest reader-conditional-splice-splices-into-a-list
  (is (= (tuple :list (list (tuple :symbol "a") (tuple :symbol "b")
                            (tuple :symbol "c") (tuple :symbol "d")))
         (read-one-w25 "(a #?@(:cljs [x] :clj [b c]) d)"))))

(deftest reader-conditional-splice-uses-default-when-no-platform-branch-matches
  (is (= (tuple :vector (list 2 3))
         (read-one-w25 "[#?@(:cljs [1] :default [2 3])]"))))

(deftest reader-conditional-splice-requires-the-selected-branch-to-be-a-collection
  (is (syntax-error? (fn [] (read-one-w25 "[#?@(:clj 1)]")))))

(deftest reader-conditional-splice-at-the-top-level-is-refused
  (is (syntax-error? (fn [] (read-one-w25 "#?@(:clj [1 2])")))))

(deftest reader-conditional-misread-as-a-bare-symbol-is-gone
  (is (= 5 (read-one-w25 "#?(:clj 5 :cljs 6)"))))

; ── regression: wave-20 positions still ride on lists ─────────────────────

(deftest a-def-with-caret-metadata-still-carries-its-source-line
  (let [list (first (read-w25 "(def ^{:doc \"x\"} foo 1)"))
        m (BeamLisp.FormMeta/meta list)]
    (is (= :meta (erlang/element 1 list)))
    (is (= 1 (get m :line)))
    (is (= 1 (get m :col)))
    (is (= "w25.bl" (get m :file)))))

(deftest positions-on-nested-lists-under-caret-are-intact
  (let [list (first (read-w25 "(outer\n  ^{:doc \"d\"} (inner 1))"))
        items (erlang/element 2 (erlang/element 2 list))
        inner (second items)]
    (is (= :meta (erlang/element 1 list)))
    (is (= (tuple :symbol "outer") (first items)))
    (is (= 2 (get (BeamLisp.FormMeta/meta inner) :line)))))

(deftest read-all-and-read-one-still-deep-unwrap-caret-metadata-and-positions
  (is (= (tuple :symbol "foo") (read-one-w25 "^:private foo")))
  (is (= (tuple :list (list (tuple :symbol "def") (tuple :symbol "foo") 1))
         (read-one-w25 "(def ^{:doc \"x\"} foo 1)"))))
