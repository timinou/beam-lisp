; wave26_laziness_test.bl — wave 26's uniform seq laziness, in beam-lisp,
; replacing test/beam_lisp/wave26_laziness_test.exs.
;
; The contract: map/filter/range/concat/take-while/drop-while compose without
; realizing what a consumer never asks for, and they chunk at 32 so a small
; strict map does not pay per-element LazySeq allocation.
;
; The load-bearing proofs use a side-effect COUNTER, never a stopwatch: a bug
; that realizes the whole source would take the same wall-clock for a small
; input but a wildly larger counter. The two bounded-count assertions carry the
; original's deliberately loose bound (`<= 64`, `<= 320`) and its `refute` half
; (`>= 1_000_000` / `>= 1000`) verbatim — the regression that matters is
; realizing the whole source, not the exact chunk size (see FUP-003 for the
; unreproduced 5-vs-32 chunk flake the loose bound documents).
;
; PARITY MAPPING — one `deftest` per ExUnit `test`, same order; each `assert`
; and `refute` becomes one `is`, so the assertion count is unchanged (22):
;
;   "bounded range is lazy: take 5 of (map f (range 1000000)) realizes one
;    chunk, not a million"                     → bounded-range-take-5-realizes-a-bounded-prefix
;   "laziness composes through map -> filter -> map"
;                                              → laziness-composes-through-map-filter-map
;   "infinite sources work with take without realizing everything"
;                                              → infinite-sources-work-with-take
;   "concat chains lazily: taking the head of a huge lazy input forces only
;    a chunk"                                  → concat-chains-lazily
;   "map over a realized coll is still a proper list when fully forced"
;                                              → map-over-a-realized-coll-is-a-proper-list
;   "empty lazy results are the empty seq (), and every empty sequence is one
;    value"                                    → empty-lazy-results-are-the-empty-seq
;   "nested lazy results inside a vector compare structurally"
;                                              → nested-lazy-results-compare-structurally
;   "count and doall realize the whole seq"    → count-and-doall-realize-the-whole-seq
;   "100k doall still does not blow the stack" → doall-100k-does-not-blow-the-stack
;
; ADAPTATIONS. The ExUnit `Test.realize/1` has no port: `doall` is the runtime's
; own force-to-proper-list and `=` is structural, so a realized value is pinned
; directly (the same substitution wave27_for_port_test makes). The ExUnit
; `eval/1` over a source STRING becomes the expression in place: a BL deftest IS
; the runtime, and every expression here is pure, so the string round-trip
; carried no behaviour.
;
; Run: bin/bl test test/bl/wave26_laziness_test.bl

(ns wave26.laziness-test)

; ── uniform laziness ────────────────────────────────────────────────────────

(deftest bounded-range-take-5-realizes-a-bounded-prefix
  ; The canonical Clojure laziness demo. Before wave 13, bounded `range` was
  ; eager, so this realized all 1,000,000 (measured 4.7s). A chunked map forces
  ; exactly one 32-element chunk.
  ;
  ; The PROPERTY is "realizes a bounded prefix, not the source": 5
  ; (element-at-a-time) and 32 (one chunk) both satisfy it, and both are correct
  ; laziness. Pinning == 32 made this the suite's only flake — it fails in
  ; roughly half of full-suite runs with a 5-vs-32 divergence. Left deliberately
  ; loose; what this protects is realizing the whole source. See FUP-003.
  (let [n (atom 0)
        s (map (fn [x] (swap! n inc) x) (range 1000000))]
    (take 5 s)
    (is (<= (deref n) 64))
    (is (not (>= (deref n) 1000000)))))

(deftest laziness-composes-through-map-filter-map
  ; f is counted at the innermost map; a pipeline of three lazy ops with
  ; `take 3` realizes only the source cells the fold needs.
  (let [n (atom 0)
        s (map (fn [x] (swap! n inc) (* x 2)) (range 1000))]
    (take 3 (map inc (filter even? s)))
    ; take 3 pulls 3 even numbers, so the source is realized until 6 evens are
    ; seen. The chunk granularity is 32, so the counter is a multiple of 32 —
    ; but far, far below 1000.
    (is (<= (deref n) 320))
    (is (not (>= (deref n) 1000)))))

(deftest infinite-sources-work-with-take
  (is (= '(1 2 3 4 5) (doall (take 5 (map inc (range))))))
  (is (= '(0 2 4 6 8 10 12) (doall (take 7 (filter even? (range))))))
  (is (= '(1 2 0 1) (doall (take 4 (concat (list 1 2) (range))))))
  (is (= '(5 6 7) (doall (take 3 (drop-while (fn [x] (< x 5)) (range)))))))

(deftest concat-chains-lazily
  ; Taking the head of a huge lazy input forces only a chunk: the first two
  ; elements are the realized `(:a :b)` head, and the lazy map tail is never
  ; forced, so nothing is mapped at all.
  (let [n (atom 0)
        s (concat (list :a :b) (map (fn [x] (swap! n inc) x) (range 1000000)))]
    (take 2 s)
    (is (= 0 (deref n)))))

(deftest map-over-a-realized-coll-is-a-proper-list
  ; Chunking realizes a small input in one chunk and terminates the chain as a
  ; proper list (no empty LazySeq tail), so existing list-shape consumers keep
  ; working.
  (is (= '(2 3 4) (doall (map inc [1 2 3]))))
  (is (= '(2 3) (doall (filter (fn [x] (> x 1)) [1 2 3])))))

(deftest empty-lazy-results-are-the-empty-seq
  ; An empty lazy seq realizes to `()` (the Clojure-model empty seq). List,
  ; vector and lazy seq are ONE sequential family (priv/boot/rt.bl, `k-compare`):
  ; equal when their elements are equal. So the three empties are one value —
  ; Clojure's rule. Wave 3 split `[]` from `()`; the runtime cutover (PLAN-148)
  ; retired that split by decision.
  (is (= true (= (map inc []) ())))
  (is (= true (= (map inc []) [])))
  (is (= true (= [] ())))
  (is (= true (= [1 2] '(1 2))))
  (is (= false (= [1 2] '(1 3))))
  (is (= false (= #{} ())))
  (is (= true (empty? (map inc [])))))

(deftest nested-lazy-results-compare-structurally
  ; split-with returns a vector of two lazy seqs; `=` must descend so the lazy
  ; elements realize against their realized siblings.
  (is (= true (= (split-with (fn [x] (< x 3)) [1 2 3 1 2])
                 '((1 2) (3 1 2))))))

(deftest count-and-doall-realize-the-whole-seq
  (is (= 1000 (count (range 1000))))
  (is (= 1000 (count (doall (map inc (range 1000)))))))

(deftest doall-100k-does-not-blow-the-stack
  (is (= 100000 (count (doall (take 100000 (map inc (range))))))))
