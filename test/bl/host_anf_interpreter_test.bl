; host_anf_interpreter_test.bl — the pinned `BeamLisp.AnfInterpreter` ABI, diffed
; against the live module.
;
; `priv/host/anf_interpreter.bl` ports `lib/beam_lisp/anf_interpreter.ex` to ONE
; exact-named beam: `capture/1`, the raise model `priv/self/anf.bl`'s reference
; interpreter runs every canonical `:try` through, and `reraise/3`, the tagged
; trace's way back to the public API. The live module is still ground truth here,
; so this suite is DIFFERENTIAL: the same thunks run through the pinned probe and
; through `Elixir.BeamLisp.AnfInterpreter`, and the two answer sets must agree.
;
; WHAT IS COMPARED. The raw catch CLASS and the RAW reason, for every raise the
; language can produce. The frame LISTS cannot be compared identity-for-identity
; — each module catches its own stack, so the frames name different call sites —
; so the trace's SHAPE is pinned separately (`{:interpreted_trace, list}`), and
; the point of that shape is the whole reason `reraise/3` exists: the interpreter
; must never hand a frame list to the raw-raise primop.
;
; Nothing here replaces the live module: the source is compiled at a probe atom
; with `:load? false`, the namespace shim beside it is dropped, and the pinned
; beam is loaded ALONE.
;
; Run: bin/bl test test/bl/host_anf_interpreter_test.bl

(ns host.anf-interpreter.test)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_anf_" (erlang/unique_integer (list :positive))))

(defn- anf-source [] (Path/join (BeamLisp/cwd) "priv/host/anf_interpreter.bl"))

(def ^:private probe :Elixir.BeamLisp.AnfInterpreterHostProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.AnfInterpreter)
(def ^:private live :Elixir.BeamLisp.AnfInterpreter)

(defn- drop! [mod]
  (do (code/purge mod) (code/delete mod) :ok))

; Compile the pinned source at the probe atom and publish ONLY the pinned beam:
; the compile's own load (and the namespace shim it built beside it) is dropped.
(defn- compile-probe [dir]
  (let [res (BeamLisp.AOT/compile_host_file (anf-source)
              (list (t2 :module probe) (t2 :output_dir dir) (t2 :load? false)))
        path (elem res 1)]
    (drop! probe)
    (code/load_binary probe (erlang/binary_to_list path) (File/read! path))
    (drop! shim)
    probe))

; ── the observation: a capture's whole answer, a re-raise included ----------

(defn- captured
  "`capture/1`'s answer as data. Success is `[:ok v]`; a raise is
   `[:raised class reason tag frames-are-list?]` — the frames' CONTENTS are the
   module's own stack and are deliberately not part of the comparison."
  [mod fun]
  (let [o (erlang/apply mod :capture (list fun))]
    (if (erlang/== :ok (elem o 0))
      (list :ok (elem o 1))
      (let [trace (elem o 3)]
        (list :raised (elem o 1) (elem o 2) (elem trace 0)
              (erlang/is_list (elem trace 1)))))))

(defn- reraised
  "Re-raise `kind`/`reason`/`trace` through `mod`, observed through a language
   `try`: `[:reraised class e]`, or `[:ok v]` if it somehow returned. The class
   and the normalized value are what a caller's own catch would read."
  [mod kind reason trace]
  (try (list :ok (erlang/apply mod :reraise (list kind reason trace)))
       (catch e (list :reraised __EXCEPTION_KIND__ e))))

; ── the corpus: every raise class, plus success -----------------------------

(defn- scenarios
  "The thunks the interpreter's catch must model: success, an `:error` of an
   atom, a tuple and an exception STRUCT, a language `(throw …)` (an ExInfo), a
   RAW `erlang/throw`, and a RAW `erlang/exit` — with a value and with a tuple."
  []
  (list
    (list :ok (fn [] (erlang/+ 1 2)))
    (list :error-atom (fn [] (erlang/error :boom)))
    (list :error-tuple (fn [] (erlang/error (tuple :bad :thing))))
    (list :error-struct (fn [] (erlang/error (Elixir.RuntimeError/exception "nope"))))
    (list :throw-language (fn [] (throw :payload)))
    (list :throw-raw-atom (fn [] (erlang/throw :x)))
    (list :throw-raw-tuple (fn [] (erlang/throw (tuple :a 1))))
    (list :exit-raw-atom (fn [] (erlang/exit :bye)))
    (list :exit-raw-tuple (fn [] (erlang/exit (tuple :shutdown :now))))))

; ── capture/1: the raw class and reason -------------------------------------

(deftest capture-pinned-matches-live
  (testing "success and every raise class: class and RAW reason equal the live module's"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      ; NO SHIM: the compile's namespace shim is gone; the pinned beam answers.
      (is (erlang/== :non_existing (erlang/apply :code :which (list shim))))
      ; The whole corpus, diffed one scenario at a time so a failure names it.
      (doseq [c (scenarios)]
        (is (= (captured live (second c)) (captured probe (second c)))
            (str "capture/" (pr-str (first c)))))
      ; THE TAGGED MODEL, pinned by shape: class, raw reason, and a frame LIST.
      (let [o (erlang/apply probe :capture (list (fn [] (erlang/error :boom))))
            trace (elem o 3)]
        (is (= :raised (elem o 0)))
        (is (= :error (elem o 1)))
        (is (= :boom (elem o 2)))
        (is (= :interpreted_trace (elem trace 0)))
        (is (erlang/is_list (elem trace 1)))
        (is (pos? (count (elem trace 1)))
            "a raise captures real frames, not an empty list"))
      ; PINNED ANSWERS first — the ABI itself, not merely probe == live.
      (is (= (list :ok 3) (captured probe (fn [] (erlang/+ 1 2)))))
      (is (= (list :raised :error :boom :interpreted_trace true)
             (captured probe (fn [] (erlang/error :boom)))))
      (is (= (list :raised :throw :x :interpreted_trace true)
             (captured probe (fn [] (erlang/throw :x)))))
      (is (= (list :raised :exit :bye :interpreted_trace true)
             (captured probe (fn [] (erlang/exit :bye)))))
      (File/rm_rf! dir))))

; ── reraise/3: the tagged trace's way back ----------------------------------

(deftest reraise-pinned-matches-live
  (testing "a captured class/reason/trace re-raises identically through both modules"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      ; Capture ONCE with the probe, then re-raise the SAME trace through both:
      ; the frames are a real list, and the re-raise must reach `erlang:raise/3`
      ; through the dynamic `apply` (a direct call lowers to `raw_raise`, which
      ; SEGFAULTS the VM given a frame list).
      (doseq [c (scenarios)]
        (let [f (second c)
              o (erlang/apply probe :capture (list f))]
          (when (erlang/== :raised (elem o 0))
            (let [kind (elem o 1) reason (elem o 2) trace (elem o 3)]
              (is (= (reraised live kind reason trace)
                     (reraised probe kind reason trace))
                  (str "reraise/" (pr-str (first c))))))))
      ; The class/reason survive the round trip, pinned directly.
      (let [o (erlang/apply probe :capture (list (fn [] (erlang/error :boom))))
            r (reraised probe (elem o 1) (elem o 2) (elem o 3))]
        (is (= :reraised (first r)))
        (is (= :error (nth r 1)))
        (is (= :boom (erlang/map_get :original (nth r 2)))))
      (File/rm_rf! dir))))

(deftest reraise-rejects-untagged-traces
  (testing "only {:interpreted_trace, frames} is accepted, as the live clause was"
    (let [dir (tmp-dir)
          bad (fn [mod t]
                (try (list :returned (erlang/apply mod :reraise (list :error :boom t)))
                     (catch e (list (:__struct__ e) (:function e) (:arity e)))))]
      (compile-probe dir)
      (doseq [t (list 42 (tuple :nope 1 2) (tuple :interpreted_trace 1 2) (list :interpreted_trace))]
        (is (= (bad live t) (bad probe t)) (str "bad trace " (pr-str t))))
      ; The refusal names THIS beam's own module: production names itself, the
      ; probe names itself — the same source, module-exact.
      (let [e (try (erlang/apply probe :reraise (list :error :boom 42))
                   nil
                   (catch e e))]
        (is (= probe (erlang/map_get :module e)))
        (is (= :reraise (erlang/map_get :function e)))
        (is (= 3 (erlang/map_get :arity e))))
      (File/rm_rf! dir))))

; ── the pinned ABI is exactly the live surface ------------------------------

(deftest pinned-abi-is-the-live-surface
  (testing "capture/1 and reraise/3 and nothing the file did not define"
    (let [dir (tmp-dir)]
      (compile-probe dir)
      (is (erlang/function_exported probe :capture 1))
      (is (erlang/function_exported probe :reraise 3))
      ; FUNCTIONS-ONLY: no `defstruct` surface, no synthesized `__info__/1`.
      (is (not (erlang/function_exported probe :__struct__ 0)))
      (is (not (erlang/function_exported probe :__info__ 1)))
      ; EVERY live export is present (`__info__/1` excluded by name: the live
      ; Elixir module has it, a pinned functions-only beam does not).
      (is (every? (fn [e] (or (erlang/== :__info__ (elem e 0))
                              (erlang/function_exported probe (elem e 0) (elem e 1))))
                  (erlang/apply live :module_info (list :exports)))
          "the pinned ABI covers every live export")
      ; … AND NOTHING ELSE: the file carries no helper, so its export list is
      ; exactly `module_info/0,1` plus the live module's two functions.
      (is (= (list (tuple :capture 1) (tuple :module_info 0)
                   (tuple :module_info 1) (tuple :reraise 3))
             (lists/sort (erlang/apply probe :module_info (list :exports))))
          "the pinned export list is exactly the live module's, minus __info__/1")
      ; REPRODUCIBLE: a rebuild of the same source is the same bytes, so the
      ; beam can be committed into the seed and re-derived.
      (let [dir2 (tmp-dir)
            again (elem (BeamLisp.AOT/compile_host_file (anf-source)
                          (list (t2 :module probe) (t2 :output_dir dir2) (t2 :load? false)))
                        1)]
        (is (= (File/read! (Path/join dir "Elixir.BeamLisp.AnfInterpreterHostProbe.beam"))
               (File/read! again)))
        (File/rm_rf! dir2))
      (File/rm_rf! dir))))

(run-tests)
