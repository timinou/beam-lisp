(ns test.apply-seqable)
(defn collect [& xs] (vec xs))
(deftest apply-inherits-runtime-seqability
 (is (= 6 (apply + #{1 2 3})))
 (is (= 0 (apply + #{})))
 (is (= [1 2 3] (apply collect (sorted-set 3 1 2))))
 (is (= [1 2] (apply collect (tuple 1 2))))
 (is (= ["é" "a"] (apply collect "éa")))
 (is (= [] (apply collect nil)))
 (is (= [0 1 2] (apply collect 0 [1 2])))
 (is (= [1 2] (apply collect (map inc [0 1]))))
 (is (= {:a 1 :b 2} (into {} (apply collect {:a 1 :b 2}))))
 (is (= {:a 1 :b 2} (into {} (apply collect (sorted-map :b 2 :a 1)))))
 (is (= :refused (try (apply collect 42) :accepted (catch _ :refused)))))
