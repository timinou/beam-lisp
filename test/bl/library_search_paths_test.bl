(ns library-search-paths-test (:require [vm.paths :as paths]))

(deftest cache-root-uses-command-local-absolute-xdg-and-ignores-relative-values
 (when (= (tuple :unix :linux) (os/type))
  (let [prior (System/get_env "XDG_CACHE_HOME") home (System/user_home!)]
   (try
    (System/put_env "XDG_CACHE_HOME" "/tmp/command-cache")
    (is (= "/tmp/command-cache/beam_lisp" (paths/cache-root)))
    (System/put_env "XDG_CACHE_HOME" "relative-cache")
    (is (= (Path/join home ".cache/beam_lisp") (paths/cache-root)))
    (System/put_env "XDG_CACHE_HOME" "")
    (is (= (Path/join home ".cache/beam_lisp") (paths/cache-root)))
    (finally (if prior (System/put_env "XDG_CACHE_HOME" prior) (System/delete_env "XDG_CACHE_HOME")))))))

(deftest native-library-discovery-filters-runtime-and-incomplete-builds
 (let [root (str (System/tmp_dir!) "/library-paths-" (erlang/unique_integer (list :positive)))
       prior (System/get_env "XDG_CACHE_HOME")
       tag (BeamLisp.Loader/library_runtime_tag)
       correct (str root "/beam_lisp/ebin/tiny-1-sha-" tag)
       interrupted (str root "/beam_lisp/ebin/partial-1-sha-" tag)
       foreign (str root "/beam_lisp/ebin/foreign-1-sha-erts0-elixir0")]
  (try
   (System/put_env "XDG_CACHE_HOME" root)
   (doseq [dir [correct interrupted foreign]] (File/mkdir_p! (str dir "/ebin")))
   (File/write! (str correct "/.compiled") "app-v2")
   (File/write! (str foreign "/.compiled") "app-v2")
   (is (= (str root "/beam_lisp/lib") (BeamLisp.Loader/shared_cache_root "lib")))
   (is (= [(str correct "/ebin")] (vec (BeamLisp.Loader/library_search_paths))))
   (File/write! (str interrupted "/.compiled") "app-v2")
   (is (= (sort [(str correct "/ebin") (str interrupted "/ebin")])
          (BeamLisp.Loader/library_search_paths))
       "a later completed compilation is discovered without restarting the VM")
   (finally
    (if (nil? prior) (System/delete_env "XDG_CACHE_HOME") (System/put_env "XDG_CACHE_HOME" prior))
    (File/rm_rf! root)))))

(deftest sparse-command-environment-retains-a-valid-host-cache-root
 (let [previous (erlang/get :bl-osenv-overlay) home (System/user_home!)]
  (try
   (erlang/put :bl-osenv-overlay {})
   (is (= (Path/join home ".cache/beam_lisp/lib") (BeamLisp.Loader/shared_cache_root "lib")))
   (erlang/put :bl-osenv-overlay {"HOME" nil "XDG_CACHE_HOME" "relative"})
   (is (= (Path/join home ".cache/beam_lisp/lib") (BeamLisp.Loader/shared_cache_root "lib")))
   (erlang/put :bl-osenv-overlay {"HOME" "/tmp/client-home" "XDG_CACHE_HOME" "/tmp/client-cache"})
   (is (= "/tmp/client-cache/beam_lisp/lib" (BeamLisp.Loader/shared_cache_root "lib")))
   (finally (if (= :undefined previous) (erlang/erase :bl-osenv-overlay) (erlang/put :bl-osenv-overlay previous))))))
