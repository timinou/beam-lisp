(ns library-search-paths-test)

(deftest native-library-discovery-filters-runtime-and-incomplete-builds
 (let [root (str (System/tmp_dir!) "/library-paths-" (erlang/unique_integer (list :positive)))
       prior (System/get_env "XDG_CACHE_HOME")
       tag (BeamLisp.Loader/library_runtime_tag)
       correct (str root "/beam_lisp/ebin/tiny-1-sha-" tag)
       interrupted (str root "/beam_lisp/ebin/partial-1-sha-" tag)
       foreign (str root "/beam_lisp/ebin/foreign-1-sha-erts0-elixir0")]
  (try
   (System/put_env "XDG_CACHE_HOME" root)
   (doseq [dir [correct interrupted foreign]] (File/mkdir_p! (str dir "/ebin")))
   (File/write! (str correct "/.compiled") "app-v2")
   (File/write! (str foreign "/.compiled") "app-v2")
   (is (= (str root "/beam_lisp/lib") (BeamLisp.Loader/shared_cache_root "lib")))
   (is (= [(str correct "/ebin")] (vec (BeamLisp.Loader/library_search_paths))))
   (File/write! (str interrupted "/.compiled") "app-v2")
   (is (= (sort [(str correct "/ebin") (str interrupted "/ebin")])
          (BeamLisp.Loader/library_search_paths))
       "a later completed compilation is discovered without restarting the VM")
   (finally
    (if (nil? prior) (System/delete_env "XDG_CACHE_HOME") (System/put_env "XDG_CACHE_HOME" prior))
    (File/rm_rf! root)))))
