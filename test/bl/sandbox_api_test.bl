; test/bl/sandbox_api_test.bl — the PUBLIC TEST API, end-to-end.
;
; Ported from the ExUnit `test/beam_lisp/sandbox_test.exs`, whose module IS an
; `ExUnitCase` consumer: `use BeamLisp.ExUnitCase, warm: {:sandbox_math, [math]}`
; resolves a base image ONCE per VM in `setup_all` and forks it per test in
; `setup`.
;
; A `.bl` file cannot `use` an Elixir macro, so this suite does what the MACRO
; does, through the same public entry points it calls:
;
;   * BASE SELECTION — `BeamLisp.ExUnitCase.resolve_base/1` with the identical
;     `{:sandbox_math, [<math fixture>]}` spec. That is the exact call the
;     macro's `setup_all` makes — and exactly the once-per-VM idempotence the
;     fourth case pins.
;   * INDEPENDENT FORK — `BeamLisp.Sandbox.checkout/1` a private child per test,
;     `checkin/1` on the way out: the macro's `setup`/`on_exit`, verbatim.
;   * THE REAL API — `BeamLisp.Sandbox.warm!/2`, `base!/1`, `eval/1`; no
;     substitute module, no re-implementation.
;
; `host_sandbox_test.bl` pins the two host beams against the live modules (ABI,
; guard failures, disassembly, and the macro expansion in a cold child). THIS
; suite pins what that differential cannot: the public test API as a CONSUMER
; exercises it — warm a base, fork it, shadow a var in the fork, leave the base
; untouched, and fork `:global` cold.
;
; Run: bin/bl test test/bl/sandbox_api_test.bl

(ns sandbox.api.test)

(def ^:private math (Path/join (BeamLisp/cwd) "test/fixtures/aot/math.bl"))

; ── what `use BeamLisp.ExUnitCase, warm: {:sandbox_math, [math]}` does ───────

(defn- base
  "The macro's base selection: `setup_all` resolves the `{name, sources}` spec
   once per VM. A `tuple` (not a bl map) because `resolve_base/1` matches an
   ERLANG two-tuple — a map would fall through to the `FunctionClauseError`."
  []
  (BeamLisp/init)
  (BeamLisp.ExUnitCase/resolve_base (tuple :sandbox_math (list math))))

(defn- with-fork
  "The macro's per-test fork: `checkout` a private child of the base, run `f`,
   `checkin` it — `on_exit`, by another name.

   `capture`/`bind` bracket the fork because a BL file runs every test in ONE
   process, where the macro's per-test ExUnit process is born and dies: the
   binding captured before `checkout` is restored after `checkin`, so the NEXT
   test resolves this namespace's own vars again. Without it the process stays
   bound to the just-destroyed fork and a plain `def` like `math` — resolved
   through the env, unlike a linked `defn` — is suddenly undefined."
  [f]
  (let [prev (BeamLisp.Env/capture)
        env  (BeamLisp.Sandbox/checkout (base))]
    (try
      (f)
      (finally
        (BeamLisp.Sandbox/checkin env)
        (BeamLisp.Env/bind prev)))))

(defn- var-of
  "The value half of an `Env/fetch` that must have SUCCEEDED."
  [r]
  (elem r 1))

(defn- answer [] (var-of (BeamLisp.Env/fetch "math" "answer")))

; ── the five cases ──────────────────────────────────────────────────────────

(deftest a-warm-fork-sees-the-base-s-vars
  (with-fork (fn []
    (is (= 42 (answer))))))

(deftest writes-stay-in-the-fork
  (with-fork (fn []
    (BeamLisp.Env/intern "math" "answer" 43)
    (is (= 43 (answer))))))

(deftest the-base-is-untouched-by-the-previous-test-s-shadow
  (with-fork (fn []
    (is (= 42 (answer))))))

(deftest warm-is-idempotent-per-vm
  (let [b (BeamLisp.Sandbox/base! :sandbox_math)]
    (is (= b (BeamLisp.Sandbox/warm! :sandbox_math (list "ignored"))))))

(deftest a-cold-env-sees-only-the-prelude-until-it-loads
  (BeamLisp.Env/isolated :global
    (fn []
      (is (= :error (BeamLisp.Env/fetch "math" "answer")))
      ; core prelude is reachable through the chain
      (is (= :ok (elem (BeamLisp.Env/fetch "user" "map") 0)))
      (BeamLisp.Sandbox/eval "(ns sandbox.cold) (def x 7)")
      (is (= 7 (var-of (BeamLisp.Env/fetch "sandbox.cold" "x"))))))
  ; destroyed on exit: nothing leaks to :global
  (is (= :error (BeamLisp.Env/fetch "sandbox.cold" "x"))))
