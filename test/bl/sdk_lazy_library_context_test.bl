(ns sdk.lazy-library-context-test
 (:require [reload.generation :as generation] [proc.server :as server]))

(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))

(deftest lazy-sdk-registration-uses-the-sdk-lifetime-and-restores-the-caller
 (let [graph (generation/prepare!
              {:application-id "lazy-sdk-context"
               :sources {"lazy.sdk.consumer" "(ns lazy.sdk.consumer) (defn value [] 1)"}})]
  (try
   (generation/with! graph
    (fn []
     (let [scope (BeamLisp.Env/env_id)
           origin (BeamLisp.Env/execution_origin)
           lease (Process/get :bl_executing_code_lease)]
      (BeamLisp.Loader/ensure_loaded "proc.reg")
      (is (= scope (BeamLisp.Env/env_id)))
      (is (= graph (generation/current)))
      (is (= origin (BeamLisp.Env/execution_origin)))
      (is (= lease (Process/get :bl_executing_code_lease)))
      (is (contains? @server/registry :registry)))))
   (is (= :retired (:status (generation/retire! graph))))
   (is (contains? @server/registry :registry) "default SDK vocabulary outlives its first application")
   (finally (generation/retire! graph)))))

(deftest source-cannot-use-the-sdk-loader-as-a-detach-boundary
 (is (= :dynamic-code-dependency
        (kind #(generation/prepare!
                {:sources {"lazy.sdk.escape"
                  "(ns lazy.sdk.escape) (defn escape [] (BeamLisp.Env/load_sdk_library! \"proc.reg\"))"}})))))
