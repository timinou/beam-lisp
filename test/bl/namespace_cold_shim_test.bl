; An AOT namespace shim can be the first call in a packaged VM. Its readiness
; guard must establish the runtime before touching the registry's ETS table.
(ns namespace-cold-shim.test)

(deftest a-direct-cold-shim-boots-and-initializes-its-namespace
  (let [suffix (str (System/unique_integer (list :positive)))
        ns-name (str "coldshim" suffix)
        out (Path/join (System/tmp_dir!) (str "bl_cold_shim_" suffix))
        mod (BeamLisp.Link/module_for ns-name)
        source (str "(ns " ns-name ") (defn value [] 7)")]
    (File/mkdir_p! out)
    (try
      (BeamLisp.AOT/compile_source source
        (list (tuple :file (Path/join out "unit.bl")) (tuple :output_dir out)))
      (let [paths (Enum/flat_map (code/get_path)
                    (fn [p] (list "-pa" (erlang/list_to_binary p))))
            script (str "m = " (Kernel/inspect mod) "\n"
                        "IO.inspect(Process.whereis(BeamLisp.Env), label: \"BEFORE\")\n"
                        "IO.inspect(apply(m, :value, []), label: \"VALUE\")\n"
                        "IO.inspect(BeamLisp.Env.loaded_ns?(\"" ns-name "\"), label: \"INITIALIZED\")\n"
                        "IO.inspect(:ets.whereis(:beam_lisp_vars) != :undefined, label: \"TABLE\")\n")
            result (System/cmd "elixir"
                     (erlang/++ paths (list "-pa" out "-e" script))
                     (list (tuple :stderr_to_stdout true)))
            text (elem result 0)]
        (is (= 0 (elem result 1)) text)
        (is (includes? text "BEFORE: nil") text)
        (is (includes? text "VALUE: 7") text)
        (is (includes? text "INITIALIZED: true") text)
        (is (includes? text "TABLE: true") text))
      (finally (File/rm_rf! out)))))
