; bootstrap_adapter_test.bl — canonical descriptor assembly and quoted-clause
; refusal, ported from test/beam_lisp/bootstrap_adapter_test.exs
; (BeamLisp.CanonicalBoundaryTest). Two claims, one test each:
;
;   1. `Emit.descriptor_for/2` builds the canonical descriptor for a module atom;
;      `compile_descriptor/1` → `load_binary!/1` publishes that module and its
;      `answer/0` runs the canonical body (`42`). Assembly executes body
;      semantics.
;   2. A raw QUOTED clause (`{:def, [], [{:answer, [], []}, [do: 42]]}`) is
;      REFUSED by `Emit.descriptor/3` with `BeamLisp.ExInfo` — it is not
;      forwarded to another compiler.
;
; Fidelity notes:
;   • the fixture module is assembled at a UNIQUE atom (the ExUnit
;     `Module.concat(__MODULE__, "FixtureN")`), so a shared ward VM that loads
;     many suites sees no name collision;
;   • the second case pins the CLASS, not `thrown?`: a typed `(catch BeamLisp.ExInfo …)`
;     matches exactly the contract, and any other raise is reported as a failure;
;   • the dynamically loaded fixture leaves no pollution — it is purged and
;     deleted in `finally`, so the atom is not left loaded in the VM.
;
; Run: bl test test/bl/bootstrap_adapter_test.bl

(ns bootstrap-adapter.test)

(defn- t2 [a b] (erlang/list_to_tuple (list a b)))
(defn- t3 [a b c] (erlang/list_to_tuple (list a b c)))

(defn- unique-module []
  (erlang/binary_to_atom
    (str "Elixir.BootstrapAdapter.Fixture" (erlang/unique_integer (list :positive)))
    :utf8))

(deftest canonical-module-assembly-executes-body-semantics
  (let [mod (unique-module)]
    (try
      (let [descriptor
            (BeamLisp.Emit/descriptor_for
              mod (list (BeamLisp.Emit/function_clause :answer (BeamLisp.Emit/lit 42))))
            compiled (BeamLisp.Emit/compile_descriptor descriptor)
            name (elem compiled 0)
            binary (elem compiled 1)]
        (is (erlang/=:= name mod) "the descriptor names the module it was built for")
        (is (erlang/is_binary binary) "compilation yields a beam binary")
        (is (erlang/=:= (BeamLisp.Emit/load_binary! (t2 name binary)) mod)
            "load_binary!/1 publishes the module the descriptor named")
        (is (erlang/=:= (erlang/apply mod :answer (list)) 42)
            "the assembled module executes the canonical body"))
      (finally
        (code/purge mod)
        (code/delete mod)))))

(deftest quoted-clauses-are-refused-rather-than-resent
  ; exactly the ExUnit fixture: {:def, [], [{:answer, [], []}, [do: 42]]}
  (let [quoted (t3 :def (list)
                   (list (t3 :answer (list) (list))
                         (list (t2 :do 42))))]
    (is (try
          (do (BeamLisp.Emit/descriptor :bad_quoted_clause (list quoted)
                                        (list (t2 :answer 0)))
              false)
          (catch BeamLisp.ExInfo e true)
          (catch e false))
        "a quoted clause is refused with BeamLisp.ExInfo")))
