; test/bl/canonical_record_interop_port_test.bl — a generated record IS an
; Elixir struct, ported from `test/beam_lisp/canonical_record_interop_test.exs`.
;
; A record made by `BeamLisp.Record.define/3` must be the canonical struct an
; Elixir module can name in a `%Record{}` LITERAL and in a `%Record{}` PATTERN —
; not merely a map. This suite proves exactly that pair against the Elixir
; COMPILER: it defines a record, compiles an Elixir consumer whose `create/0`
; builds the struct with a literal (omitting a field, so the default is
; exercised) and whose `read/1` destructures it with a struct pattern, then
; calls both. A record the Elixir compiler did not recognise as a struct would
; fail to compile or to match here.
;
; The redefinition half pins the ABI's DYNAMIC edge: redefining the name in place
; replaces the struct module's field set (`__info__(:exports_md5)` moves), a NEW
; consumer compiled afterwards sees the NEW field set (and the dropped field is
; gone, not merely nil), and the earlier consumers are not resurrected. Finally
; the reserved `__struct__` key is refused, and `__struct__/0` answers the
; CURRENT field set with nils.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; The one ExUnit test maps onto the same-named BL deftest. The ExUnit line
; `assert consumer.create() == %{__struct__: record, x: 3, y: nil}` splits into
; the field-level assertions below (`:__struct__` tag, each field present, each
; value right), which is the SAME claim stated so it does not depend on the
; handling described under “Adaptations”.
;
; Adaptations, and why:
;   * `Module.concat(__MODULE__, "Consumer#{System.unique_integer([:positive])}")`
;     → a unique `Elixir.CanonicalRecordInteropPortTest.ConsumerN` atom built the
;     same way; `Code.compile_string` is called directly (it is on the warm
;     image, as it is for `test/bl/aot_cache_test.bl`), and the Elixir source
;     text interpolates the record module's `Atom.to_string/1`.
;   * `assert ^record = BeamLisp.Record.define(...)` (a pin-match) → `(is (= record
;     again))`: the property is that define/3 answers the SAME module atom, which
;     equality asserts directly.
;   * `assert consumer.create() == %{__struct__: record, x: 3, y: nil}` — a MAP
;     LITERAL whose value is a free variable — is written as field reads
;     (`erlang/map_get`/`is_map_key`), not as a literal equality. Reason: `is`
;     with `=` re-splices its operands from the quoted form, and a `{…}` literal
;     whose VALUE is a symbol becomes that symbol AS DATA (a `{:symbol "…"}`)
;     rather than an evaluation of it. Reads keep the assertion non-circular
;     (they check the values the consumer's own literal produced) and exact
;     (`is_map_key` pins presence, so a dropped field fails rather than reading
;     nil).
;   * `assert_raise ArgumentError, ~r/cannot set :__struct__/, fn -> … end` →
;     a typed `catch ArgumentError` plus a substring check on `ex-message` —
;     class and message both pinned.
;   * There is no `setup`; the original called `BeamLisp.init()` in the test
;     body, so the port does too.
;
; Run: bin/bl test test/bl/canonical_record_interop_port_test.bl

(ns canonical.record.interop.port.test)

(defn- unique [] (erlang/unique_integer (list :positive)))

(defn- mod-atom [s] (erlang/binary_to_atom s :utf8))

(defn- raised-argument-error
  "The `ArgumentError` `thunk` raises, or nil — what an `assert_raise` bound."
  [thunk]
  (try (do (thunk) nil) (catch ArgumentError e e)))

(deftest generated-records-support-elixir-literals-and-struct-patterns
  (BeamLisp/init)
  (let [record (BeamLisp.Record/define "canonicalinterop" "Point" (list "x" "y"))
        consumer (mod-atom (str "Elixir.CanonicalRecordInteropPortTest.Consumer" (unique)))]
    (Code/compile_string
      (str "defmodule " consumer " do\n"
           "  def create, do: %" (Atom/to_string record) "{x: 3}\n"
           "  def read(%" (Atom/to_string record) "{x: value}), do: value\n"
           "end\n"))
    (let [created (erlang/apply consumer :create (list))]
      (is (= record (erlang/map_get :__struct__ created))
          "a struct LITERAL tags the value with the record module")
      (is (erlang/is_map_key :x created) "the literal's field is present")
      (is (erlang/is_map_key :y created) "the omitted field is present")
      (is (= 3 (erlang/map_get :x created)) "the literal set x")
      (is (= nil (erlang/map_get :y created)) "the omitted field defaults to nil")
      (is (= 3 (erlang/apply consumer :read (list created)))
          "a struct PATTERN destructures the record"))
    (let [old-hash (erlang/apply record :__info__ (list :exports_md5))
          again (BeamLisp.Record/define "canonicalinterop" "Point" (list "x" "z"))]
      (is (= record again) "redefinition answers the SAME module atom")
      (is (not= old-hash (erlang/apply record :__info__ (list :exports_md5)))
          "redefinition moves the struct's exports hash")
      (let [next (mod-atom (str consumer "Next"))]
        (Code/compile_string
          (str "defmodule " next " do def create, do: %" (Atom/to_string record) "{z: 7}\nend\n"))
        (let [made (erlang/apply next :create (list))]
          (is (= record (erlang/map_get :__struct__ made))
              "a consumer compiled after the redefine sees the record module")
          (is (= 7 (erlang/map_get :z made)) "the new field set is in effect")
          (is (= nil (erlang/map_get :x made)) "the retained field defaults to nil")
          (is (not (erlang/is_map_key :y made)) "the old field is gone, not merely nil")))
      (let [err (raised-argument-error
                  (fn [] (BeamLisp.Record/define "canonicalinterop" "Point" (list "__struct__"))))]
        (is (some? err) "the reserved __struct__ field is refused")
        (is (and err (String/contains? (ex-message err) "cannot set :__struct__"))
            "the refusal names the reserved key"))
      (let [zero (erlang/apply record :__struct__ (list))]
        (is (= record (erlang/map_get :__struct__ zero)))
        (is (= nil (erlang/map_get :x zero)))
        (is (= nil (erlang/map_get :z zero)))
        (is (not (erlang/is_map_key :y zero)) "the old field is gone from __struct__/0")))))
