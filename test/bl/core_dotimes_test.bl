(ns core.dotimes-test)
(deftest bounded-index-and-single-limit-evaluation
 (let [limits (atom 0) seen (atom [])
       result (dotimes [i (do (swap! limits inc) 4)] (swap! seen conj i))]
  (is (= [0 1 2 3] @seen)) (is (= 1 @limits)) (is (nil? result))))
(deftest empty-ranges-do-not-run-the-body
 (doseq [n [0 -1]]
  (let [calls (atom 0)]
   (is (nil? (dotimes [i n] (swap! calls inc))))
   (is (= 0 @calls)))))
