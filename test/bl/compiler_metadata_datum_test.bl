(ns compiler-metadata-datum-test)

(defn- datum [node]
 (erlang/apply :Elixir.BeamLisp.Ns.Compiler :datum (list node)))
(defn- form [data]
 (erlang/apply :Elixir.BeamLisp.Ns.Compiler :"data->form" (list data)))

(defmacro pass-form [value] value)

;; Older compiler-created vectors omit the optional nil metadata field.
(defmacro legacy-vector [value] (maps/remove :meta [value]))

(deftest macro-vectors-without-author-metadata-keep-their-elements
 (is (= [42] (legacy-vector 42)))
 (let [value (maps/remove :meta ['action])]
  (is (= ['action] (datum (form value))))
  (is (= nil (meta (datum (form value)))))))

(defmacro keyed-row [id]
 (with-meta [:li id] {:key id}))

(deftest symbol-author-metadata-survives-macro-data-and-ordinary-symbol-operations
 (let [node (first (BeamLisp.Reader/read_string
                    "^{:private true :tag :service :doc \"owner\"} fixture/Owner"
                    "symbol-metadata.bl"))
       data (datum node)
       expected {:private true :tag :service :doc "owner"}]
  (is (= expected (meta data)))
  (is (symbol? data))
  (is (= "Owner" (name data)))
  (is (= "fixture" (namespace data)))
  (is (= "fixture/Owner" (str data)))
  (is (= "fixture/Owner" (pr-str data)))
  (is (= :fixture/Owner (keyword data)))
  (is (= :fixture/Owner
         (BeamLisp.AOT/interpret_constructor!
          {:op :remote :mod :Elixir.BeamLisp.Ns.Core :fun :keyword
           :args [{:op :lit :val data}]} {} {})))
  (is (= 'fixture/Owner data))
  (is (= :same (get {data :same} 'fixture/Owner)))
  (is (= :same (get {'fixture/Owner :same} data)))
  (is (= data (datum (form data))))
  (is (= expected (meta (datum (form data)))))
  (is (= false (contains? (meta data) :line)))
  (is (= false (contains? (meta data) :file)))
  (is (= data (BeamLisp.CompilerData/check_first_order! data)))
  (is (= 'fixture/Owner (with-meta data nil)))
  (is (= "Owner" (BeamLisp.Ns.Rt/name-of data)))
  (is (= "fixture" (BeamLisp.Ns.Rt/namespace-of data)))))

(deftest malformed-metadata-shaped-tuples-remain-ordinary-opaque-values
 (let [value (tuple :meta)]
  (is (= false (symbol? value)))
  (is (= nil (BeamLisp.Ns.Rt/name-of value)))
  (is (= nil (BeamLisp.Ns.Rt/namespace-of value)))
  (is (= "{:meta}" (pr-str value)))))

(deftest vector-author-metadata-is-data-at-the-macro-boundary
 (let [node (first (BeamLisp.Reader/read_string
                    "^{:tag :syntax :doc \"author\" :type Thing :nested {:items [:a Thing]}} [x]"))
       data (datum node)
       expected {:tag :syntax :doc "author" :type 'Thing :nested {:items [:a 'Thing]}}]
  (is (= expected (meta data)))
  (is (= data (BeamLisp.CompilerData/check_first_order! data)))
  (is (= data (datum (form data))))
  (is (= expected (meta (datum (form data)))))))

(deftest author-data-and-reader-position-remain-separate
 (let [data (datum (first (BeamLisp.Reader/read_string
                           "^{:source '(f :x) :enabled true :count 2} [a b]" "metadata.bl")))]
  (is (= {:source '(quote (f :x)) :enabled true :count 2} (meta data)))
  (is (= false (contains? (meta data) :line)))
  (is (= false (contains? (meta data) :file)))
  (is (= data (datum (form data))))))

(deftest plain-runtime-metadata-is-stable-on-repeated-datum-roundtrips
 (let [data (with-meta ['x] {:tag :syntax :nested {:values [:a 'T]}})
       once (datum (form data)) twice (datum (form once))]
  (is (= data once))
  (is (= once twice))
  (is (= (meta data) (meta twice)))))

(deftest macro-metadata-expressions-rebuild-executable-syntax
 (let [rows (for [item [{:id 1} {:id 2}]]
              ^{:key (:id item)} [:li (:id item)])]
  (is (= [1 2] (mapv (fn [row] (:key (meta row))) rows))))
 (let [rows (pass-form
              (pass-form
                (map (fn [item] ^{:key (:id item)} [:li (:id item)])
                     [{:id 3} {:id 4}])))]
  (is (= [3 4] (mapv (fn [row] (:key (meta row))) rows))))
 (let [id 7 row (keyed-row id)]
  (is (= [:li 7] row))
  (is (= {:key 7} (meta row)))))

(deftest explicit-metadata-wrappers-and-quoted-data-roundtrip
 (let [wrapped (tuple :meta ['x] {:key '(:id item)})
       node (form wrapped)]
  (is (= :list (erlang/element 1 (:key (erlang/element 3 node)))))
  (is (= {:key '(:id item)} (meta (datum node)))))
 (let [quoted '^{:key (:id item)} [:li (:id item)]]
  (is (= {:key '(:id item)} (meta quoted)))
  (is (= (meta quoted) (meta (datum (form quoted)))))))
