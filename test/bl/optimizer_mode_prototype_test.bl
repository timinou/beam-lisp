; test/bl/optimizer_mode_prototype_test.bl — per-traversal callback-mode PROTOTYPE.
; Run: bin/bl test test/bl/optimizer_mode_prototype_test.bl
;
; `rt/k-reduce`'s explicit 5th argument `:normalized` picks the callback
; representation once per traversal (`rt/reduce-callback`), then runs the SAME
; storage walks. `:baseline` (what every ordinary call uses) is the oracle.
; Every case below is a differential: outcome(:baseline) = outcome(:normalized),
; where outcome = [value-or-error-string, ordered callback trace, effect count].

(ns optimizer.mode.prototype.test
  (:require [bl.json :as json]))

(defrecord ModePt [x y])

(defn- outcome
  "Run `(run mode)` with a fresh trace atom; capture result/error + trace."
  [mk mode]
  (let [seen (atom [])
        r (try [:ok ((mk seen) mode)] (catch e [:err (str e)]))]
    [r @seen]))

(defn- same? [msg mk]
  (let [a (outcome mk :baseline) b (outcome mk :normalized)]
    (when (= "1" (System/get_env "BL_MODE_SNAPSHOTS"))
      (println (json/encode {"type" "outcome" "case" msg "baseline" (pr-str a) "normalized" (pr-str b)})))
    (is (= a b) (str msg ": baseline " (pr-str a) " vs normalized " (pr-str b)))))

(defn- traced [seen f] (fn [a x] (swap! seen conj x) (f a x)))

; Differential outcomes may contain resource identities in values/errors.
; These immutable/read-only fixtures must be the same objects in both modes.
(def shared-cursor (BeamLisp.SeqCursor/new (list 1 2 3 4)))
(def shared-invalid-collection (atom 1))
(def shared-invalid-callable (atom 0))

(def colls
  [["nil" (fn [] nil)] ["()" (fn [] ())] ["list" (fn [] (list 1 2 3))]
   ["[]" (fn [] [])] ["[1]" (fn [] [1])] ["vec3" (fn [] [1 2 3])]
   ["vec33" (fn [] (vec (range 33)))] ["vec65" (fn [] (vec (range 65)))]
   ["map" (fn [] {:a 1 :b 2})] ["bigmap" (fn [] (zipmap (range 40) (range 40)))]
   ["set" (fn [] #{1 2 3})] ["sorted-set" (fn [] (sorted-set 3 1 2))]
   ["sorted-map" (fn [] (sorted-map :b 2 :a 1))] ["tuple" (fn [] (tuple 1 2 3))]
   ["string" (fn [] "abc")] ["record" (fn [] (->ModePt 1 2))]
   ["lazy-map" (fn [] (map inc (list 1 2 3)))] ["lazy-range" (fn [] (range 5))]
   ["lazy-empty" (fn [] (map inc []))]
   ["lazy63" (fn [] (map identity (range 63)))] ["lazy64" (fn [] (map identity (range 64)))]
   ["lazy65" (fn [] (map identity (range 65)))] ["lazy31" (fn [] (map identity (range 31)))]
   ["lazy32" (fn [] (map identity (range 32)))] ["lazy33" (fn [] (map identity (range 33)))]
   ["cursor" (fn [] shared-cursor)]
   ["improper" (fn [] (erlang/++ (list 1 2) :tail))]
   ["improper-vec-tail" (fn [] (erlang/++ (list 1 2) (vec [3 4])))]
   ["improper-lazy-tail" (fn [] (erlang/++ (list 1 2) (map inc (list 3 4))))]
   ["foreign" (fn [] (Date/new! 2026 1 2))]
   ["foreign-empty" (fn [] (maps/put :__struct__ :foreign-opaque-empty (maps/new)))]
   ["atom-invalid" (fn [] shared-invalid-collection)] ["int-invalid" (fn [] 5)]])

(def policies [:kernel :compat])

(defn- conj-ish [a x] (if (vector? a) (conj a x) [x]))

(def callables
  "[label make-callable]: native, tagged fixed/variadic/multi, keyword, map, set,
   vector, opaque, wrong arity, wrong kind."
  [["native2" (fn [seen] (traced seen (fn [a x] (conj-ish a x))))]
   ["native2-halt" (fn [seen] (traced seen (fn [a x] (if (= x 2) (reduced a) (conj-ish a x)))))]
   ["native1-badarity" (fn [seen] (fn [x] x))]
   ["native3-badarity" (fn [seen] (fn [a b c] a))]
   ["variadic" (fn [seen] (fn [& xs] (swap! seen conj xs) (count xs)))]
   ["multi" (fn [seen] (fn ([] :z) ([a] a) ([a b] (swap! seen conj b) b)))]
   ["multi-no2" (fn [seen] (fn ([] :z) ([a] a) ([a b c] a)))]
   ["variadic-min3" (fn [seen] (fn [a b c & r] a))]
   ["plus" (fn [seen] +)]
   ["keyword" (fn [seen] :a)]
   ["map" (fn [seen] {:x :y})]
   ["set" (fn [seen] #{1 2})]
   ["vector" (fn [seen] [:a :b])]
   ["atom" (fn [seen] shared-invalid-callable)]
   ["int" (fn [seen] 7)]
   ["nil" (fn [seen] nil)]])

(deftest every-callable-over-every-representation-and-policy
  (doseq [[cl mkf] callables [cn mkc] colls policy policies init [0 []]]
    (same? (str cl "/" cn "/" policy "/" (pr-str init))
           (fn [seen]
             (let [f (mkf seen)]
               (fn [mode] (BeamLisp.Ns.Rt/k-reduce f init (mkc) policy mode)))))))

(deftest invalid-callable-on-empty-input-never-errors-eagerly
  (doseq [bad [5 nil (atom 1) "s" (fn [x] x) [:a] :k]
          empty [nil () [] {} #{} (map inc [])]
          policy policies]
    (is (= :init (BeamLisp.Ns.Rt/k-reduce bad :init empty policy :normalized))
        (str "normalized touched an invalid callable " (pr-str bad)))
    (is (= (BeamLisp.Ns.Rt/k-reduce bad :init empty policy :baseline)
           (BeamLisp.Ns.Rt/k-reduce bad :init empty policy :normalized)))))

(deftest normalizing-does-not-invoke-the-callable
  (let [calls (atom 0) f (fn ([] (swap! calls inc)) ([a b] (swap! calls inc) a))]
    (BeamLisp.Ns.Rt/reduce-callback f)
    (BeamLisp.Ns.Rt/reduce-callback :kw)
    (is (= 0 @calls))
    (let [g (erlang/make_fun :erlang :+ 2)
          prepared (BeamLisp.Ns.Rt/reduce-callback g)]
      (is (erlang/is_function prepared 2))
      (is (= 7 (prepared 3 4)))
      (is (= 0 @calls)
          "preparation is inert; the native adapter checks Source at invocation"))))

(deftest argument-order-and-exactly-once-effects
  (doseq [policy policies]
    (same? (str "variadic arg order " policy)
           (fn [seen] (let [f (fn [& xs] (swap! seen conj xs) (first xs))]
                        (fn [mode] (BeamLisp.Ns.Rt/k-reduce f :a (vec (range 70)) policy mode)))))
    (same? (str "multi-arity " policy)
           (fn [seen] (let [f (fn ([] 0) ([a] a) ([a b] (swap! seen conj [a b]) (+ a b)))]
                        (fn [mode] (BeamLisp.Ns.Rt/k-reduce f 0 (list 1 2 3 4) policy mode)))))))

(deftest halt-nested-reduced-and-initial-reduced
  (doseq [policy policies mode [:baseline :normalized]]
    (is (= 3 (BeamLisp.Ns.Rt/k-reduce (fn [a x] (if (= x 3) (reduced a) (+ a x))) 0
                                      (list 1 2 3 4 5) policy mode)))
    (is (= 7 (BeamLisp.Ns.Rt/k-reduce (fn [a _] a) (reduced 7) [] policy mode))
        "initial Reduced on empty")
    (let [r (BeamLisp.Ns.Rt/k-reduce (fn [_ _] (reduced (reduced 1))) 0 [1 2] policy mode)]
      (is (= (BeamLisp.Ns.Rt/k-reduce (fn [_ _] (reduced (reduced 1))) 0 [1 2] policy :baseline) r)))))

(deftest chunk-halt-and-replay
  (doseq [n [31 32 33 63 64 65] policy policies]
    (same? (str "halt at chunk edge " n)
           (fn [seen] (let [s (map identity (range 200))
                            f (traced seen (fn [a x] (if (= x n) (reduced a) (+ a x))))]
                        (fn [mode] [(BeamLisp.Ns.Rt/k-reduce f 0 s policy mode)
                                    (BeamLisp.Ns.Rt/k-reduce f 0 s policy mode)]))))))

(deftest lazy-producer-effects-exactly-once-per-mode
  (doseq [mode [:baseline :normalized]]
    (let [calls (atom 0)
          s (map (fn [x] (swap! calls inc) x) (range))
          step (fn [a x] (if (= x 3) (reduced a) (+ a x)))]
      (is (= 3 (BeamLisp.Ns.Rt/k-reduce step 0 s :kernel mode)))
      (is (= 32 @calls))
      (is (= 3 (BeamLisp.Ns.Rt/k-reduce step 0 s :kernel mode)))
      (is (= 32 @calls) "replay reads the memo"))))

(deftest nested-lazy-fold-source-ingress-unchanged
  ; lazy-fold-source/lazy-reduce-source take a raw rf and are not touched.
  (is (= (BeamLisp.Ns.Rt/lazy-reduce-source + 0 (list 1 2 3))
         (BeamLisp.Ns.Rt/k-reduce + 0 (list 1 2 3) :kernel :normalized)))
  (is (= 4 (count (map inc (filter odd? (range 8)))))
      "recipe paths (count/vec/into) use raw 2-arity rf and ignore the mode"))

;; ── live core/reduced? under :compat + :normalized ────────────────────────
(defn- with-core-reduced? [pred thunk]
  (let [orig (BeamLisp.Env/fetch! "core" "reduced?")]
    (try (do (BeamLisp.Env/intern "core" "reduced?" pred) (thunk))
         (finally (BeamLisp.Env/intern "core" "reduced?" orig)))))

(defn- callback-kind [kind seen body]
  (cond
    (= kind :native) (fn [a x] (swap! seen conj x) (body a x))
    (= kind :variadic) (fn [& xs] (swap! seen conj (second xs)) (body (first xs) (second xs)))
    :else (fn ([] :zero) ([a x] (swap! seen conj x) (body a x)))))

(deftest live-predicate-before-mid-and-terminal-rebinding
  (doseq [mode [:baseline :normalized] kind [:native :variadic :multi]]
    ; A truthy public predicate dereferences its value. Use an actual marker,
    ; not an integer that would fail deref before testing the desired halt.
    (let [seen (atom []) marker (atom 3)
          f (callback-kind kind seen (fn [a x] (if (= x 3) marker x)))
          r (with-core-reduced? (fn [v] (= v marker))
              (fn [] (BeamLisp.Ns.Rt/k-reduce f 0 (vec (range 1 8)) :compat mode)))]
      (is (= [1 2 3] @seen) (str kind " before " mode))
      (is (= 3 r)))
    (let [seen (atom []) marker (atom 2)
          f (callback-kind kind seen
              (fn [a x]
                (when (= x 2)
                  (BeamLisp.Env/intern "core" "reduced?" (fn [v] (= v marker))))
                (if (= x 2) marker x)))
          r (with-core-reduced? (fn [_] false)
              (fn [] (BeamLisp.Ns.Rt/k-reduce f 0 (vec (range 1 6)) :compat mode)))]
      (is (= 2 r))
      (is (= [1 2] @seen) (str kind " mid " mode)))
    (let [marker (atom 9) calls (atom 0)
          r (with-core-reduced? (fn [v] (swap! calls inc) (= v marker))
              (fn [] (BeamLisp.Ns.Rt/k-reduce (fn [_ _] marker) 0 [] :compat mode)))]
      (is (= 0 r))
      (is (= 1 @calls)))
    (let [marker (atom 9) calls (atom 0) seen (atom [])
          f (callback-kind kind seen (fn [a x] marker))
          r (with-core-reduced?
              (fn [v] (swap! calls inc) (and (= 3 @calls) (= v marker)))
              (fn [] (BeamLisp.Ns.Rt/k-reduce f marker (list 1 2) :compat mode)))]
      (is (= 9 r))
      (is (= [1 2] @seen))
      (is (= 3 @calls) "n+1 predicate calls"))))

(deftest compat-user-callback-is-normalized-not-only-the-envelope
  ; a non-native user callback under :compat must still see (acc x), once each,
  ; with the live predicate asked after each call.
  (let [pcalls (atom 0) seen (atom [])
        f (fn [& xs] (swap! seen conj xs) (first xs))
        r (with-core-reduced? (fn [_] (swap! pcalls inc) false)
            (fn [] (BeamLisp.Ns.Rt/k-reduce f :a [1 2 3] :compat :normalized)))]
    (is (= :a r))
    (is (= [[:a 1] [:a 2] [:a 3]] @seen))
    (is (= 4 @pcalls))))

(deftest ordinary-public-reduce-stays-baseline
  (let [f (fn [a _] (inc a))]
    (doseq [coll [(list 1 2) [1 2] {:a 1} (map inc [1 2])]]
      (is (= (BeamLisp.Ns.Rt/k-reduce f 0 coll :compat :baseline) (reduce f 0 coll)))
      (is (= (BeamLisp.Ns.Rt/k-reduce f 0 coll) (BeamLisp.Ns.Rt/k-reduce f 0 coll :kernel :baseline))))))

(deftest prepared-callback-equals-original-step-in-the-same-vm
  ; The storage walkers are identical between images. This isolates the only
  ; changed operation without assuming maps iterate identically in two VMs.
  (doseq [[label make-f] callables a [0 [] {:a 7} (reduced 3)] x [1 2 {:a 9} [:x]]]
    (let [seen (atom []) f (make-f seen)
          reference (fn []
                      (if (erlang/is_function f 2)
                        (erlang/apply f (list a x))
                        (BeamLisp.Ns.Rt/call-invoke f (list a x))))
          prepared (BeamLisp.Ns.Rt/reduce-callback f)
          baseline (try [:ok (reference)] (catch e [:error (str e)]))
          trace @seen]
      (reset! seen [])
      (let [actual (try [:ok (erlang/apply prepared (list a x))] (catch e [:error (str e)]))]
        (is (= baseline actual) label)
        (is (= trace @seen) label)))))
