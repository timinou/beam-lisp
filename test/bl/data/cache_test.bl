; test/bl/data/cache_test.bl — data.cache content-addressed cache.
; Run: mix beam_lisp.test test/bl/data/cache_test.bl
;
; Pins the contracts: compute-once per key, cached value returned (not the
; would-be recompute), the datalog index reflects entries/hits, and the
; durable tier persists across a fresh store.

(ns data.cache.test
  (:require [data.cache :as cache]))

(deftest computes-once-per-key
  (let [calls (atom 0)
        v (cache/open "t1")
        r1 (cache/get! v [:doc 1] (fn [] (swap! calls inc) {"v" 1}))
        r2 (cache/get! v [:doc 1] (fn [] (swap! calls inc) {"v" 999}))
        r3 (cache/get! v [:doc 2] (fn [] (swap! calls inc) {"v" 2}))]
    (is (= {"v" 1} r1))
    ; second get returns the cached value, NOT the recompute
    (is (= {"v" 1} r2))
    (is (= {"v" 2} r3))
    ; two distinct keys => two computations
    (is (= 2 @calls))))

(deftest index-reflects-entries
  (let [v (cache/open "t2")]
    (cache/get! v [:a] (fn [] {"x" 1}))
    (cache/get! v [:b] (fn [] {"x" 2}))
    (let [s (cache/stats v)]
      (is (= 2 (:count s)))
      (is (< 0 (:bytes s))))))

(deftest hits-accumulate-in-index
  (let [v (cache/open "t3")]
    (cache/get! v [:k] (fn [] {"x" 1}))
    (cache/get! v [:k] (fn [] {"x" 1}))   ; hot hit -> hits + 1
    (cache/get! v [:k] (fn [] {"x" 1}))   ; hot hit -> hits + 1
    (let [top (first (cache/hottest v 1))]
      (is (= 2 (:hits top))))))

(deftest distinct-stores-do-not-collide
  ; the same key in two differently-named stores is two different slots.
  (let [a (cache/open "store-a")
        b (cache/open "store-b")
        ra (cache/get! a [:same] (fn [] :from-a))
        rb (cache/get! b [:same] (fn [] :from-b))]
    (is (= :from-a ra))
    (is (= :from-b rb))))

(deftest keys-are-structural
  ; keys compare by value, so an equal composite key hits the same slot.
  (let [calls (atom 0)
        v (cache/open "t4")]
    (cache/get! v {:type :doc :id 7} (fn [] (swap! calls inc) :once))
    (cache/get! v {:type :doc :id 7} (fn [] (swap! calls inc) :twice))
    (is (= 1 @calls))))
