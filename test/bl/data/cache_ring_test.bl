(ns data.cache-ring-test (:require [data.cache-ring :as ring]))

(deftest repeated-and-rejected-insertions-preserve-the-ring
  (let [s {:entries {} :order [] :hits 3}
        one (ring/offer s :a 1 10 100 2)]
    (is (= one (ring/offer one :a 2 10 100 2)))
    (doseq [charge [nil -1 0 101 1.0]]
      (is (= one (ring/offer one :b 2 charge 100 2))))
    (doseq [limit [nil -1 0 1.0]]
      (is (= one (ring/offer one :b 2 10 100 limit)))
      (is (= one (ring/offer one :b 2 10 limit 2))))
    (let [next (ring/offer (ring/offer one :b 2 10 100 2) :c 3 10 100 2)]
      (is (= {:b 2 :c 3} (:entries next)))
      (is (= [:b :c] (:order next)))
      (is (= 3 (:hits next))))))

(deftest generated-offers-keep-order-and-entries-in-correspondence
  (loop [n 0 state {:entries {} :order []}]
    (when (< n 1000)
      (let [next (ring/offer state (mod (* n 7) 23) n (if (= 0 (mod n 5)) 200 10) 100 16)]
        (is (<= (count (:entries next)) 16))
        (is (= (count (:entries next)) (count (:order next))))
        (is (= (set (keys (:entries next))) (set (:order next))))
        (recur (inc n) next)))))
