(ns data.cache-pool-pressure-test
  (:require [data.cache-pool :as pool]))

(defn under-zero-budget [f]
  (let [previous (Application/get_env :beam_lisp :lazy_cache_budget_bytes)]
    (Application/put_env :beam_lisp :lazy_cache_budget_bytes 0)
    (try (f)
         (catch e {:error (str e)})
         (finally
           (if (nil? previous)
             (Application/delete_env :beam_lisp :lazy_cache_budget_bytes)
             (Application/put_env :beam_lisp :lazy_cache_budget_bytes previous))))))

(deftest reclamation-does-not-need-the-cache-it-is-reclaiming
  (let [owner (spawn (fn [] (receive :stop :ok (after 15000 nil))))
        ref (erlang/monitor :process owner)
        ticket (erlang/make_ref)]
    (try
      (is (pool/register! owner))
      (is (pool/reserve! owner ticket 10000))
      (pool/retain! owner ticket)
      (let [before (:bytes (pool/stats))
            live-result (under-zero-budget (fn [] (pool/reap!)))]
        (is (= :ok live-result))
        (is (= before (:bytes (pool/stats))) "pressure cannot forget a live owner's credit")
        (erlang/exit owner :kill)
        (receive [:DOWN actual :process dead why] (is (= ref actual))
                 (after 5000 (assert false "owner did not exit")))
        (let [dead-result (under-zero-budget (fn [] (pool/reap!)))]
          (is (= :ok dead-result))
          (is (= (- before pool/OWNER-CHARGE 10000) (:bytes (pool/stats)))
              "the dead owner's metadata and retained value are reclaimed under pressure")))
      (finally
        (when (Process/alive? owner) (erlang/exit owner :kill))
        (pool/reap!)))))
