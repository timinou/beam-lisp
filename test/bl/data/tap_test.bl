; test/bl/data/tap_test.bl — data.tap: bounded ring + subscriber fan-out.
; Run: mix beam_lisp.test test/bl/data/tap_test.bl

(ns data.tap.test
  (:require [data.tap :as tap]))

(deftest publish-stamps-monotonic-t
  (let [t (tap/open)
        a (tap/publish! t {:x 1})
        b (tap/publish! t {:x 2})]
    (is (= 1 (:t a)))
    (is (= 2 (:t b)))
    (is (number? (:at a)))
    (is (= 2 (tap/size t)))
    (is (= {:x 2} (select-keys (tap/latest t) [:x])))))

(deftest ring-is-bounded
  (let [t (tap/open {:cap 3})]
    (doseq [i (range 10)] (tap/publish! t {:i i}))
    (is (= 3 (tap/size t)))
    (is (= [7 8 9] (mapv :i (tap/frames t))))
    ;; :t keeps climbing past the cap
    (is (= 10 (:t (tap/latest t))))
    (is (nil? (tap/frame t 1)))
    (is (= {:i 8} (select-keys (tap/frame t 9) [:i])))))

(deftest between-slices-by-t
  (let [t (tap/open)]
    (doseq [i (range 5)] (tap/publish! t {:i i}))
    (is (= [2 3 4] (mapv :t (tap/between t 2 4))))))

(deftest subscribers-receive-frames-as-messages
  (let [t (tap/open)]
    (tap/subscribe! t)
    (tap/publish! t {:hello "world"})
    (let [got (receive [:tap/frame f] f (after 200 :timeout))]
      (is (= "world" (:hello got)))
      (is (= 1 (:t got))))
    (tap/unsubscribe! t)
    (tap/publish! t {:hello "again"})
    (is (= :timeout (receive [:tap/frame _] :got (after 50 :timeout))))))

(deftest clear-keeps-counter
  (let [t (tap/open)]
    (tap/publish! t {})
    (tap/clear! t)
    (is (= 0 (tap/size t)))
    (is (= 2 (:t (tap/publish! t {}))))))
