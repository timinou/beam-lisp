; test/bl/data/config_test.bl — data.config as a protocol-plugged type.
; Run: mix beam_lisp.test test/bl/data/config_test.bl
;
; These tests PROVE the extension behaviour: `fetch` is a Settings protocol
; method, a Config satisfies the protocol, dispatch happens on the Config type,
; and the override/base semantics ride on top of that one dispatched verb.

(ns data.config.test
  (:require [data.config :as cfg]))

(deftest config-satisfies-the-protocol
  ; the extension is real: a Config satisfies Settings, a plain map does not.
  (let [c (cfg/create {:model "gpt"})]
    (is (satisfies? cfg/Settings c))
    (is (not (satisfies? cfg/Settings {:model "gpt"})))))

(deftest fetch-dispatches-on-the-config-type
  ; fetch is THE protocol verb; calling it on a Config runs the extended method.
  (let [c (cfg/create {:model "gpt" :limit 10})]
    (is (= "gpt" (cfg/fetch c :model)))
    (is (= 10 (cfg/fetch c :limit)))
    (is (= :fallback (cfg/fetch c :missing :fallback)))
    (is (nil? (cfg/fetch c :missing)))))

(deftest settings-returns-the-effective-map
  (let [c (cfg/create {:a 1 :b 2})]
    (is (= {:a 1 :b 2} (cfg/settings c)))))

(deftest put-is-seen-live-through-fetch
  (let [c (cfg/create {:n 1})]
    (is (= 1 (cfg/fetch c :n)))
    (cfg/put c :n 2)
    (is (= 2 (cfg/fetch c :n)))))

(deftest merge-in-folds
  (let [c (cfg/create {:a 1})]
    (cfg/merge-in c {:b 2 :c 3})
    (is (= 1 (cfg/fetch c :a)))
    (is (= 2 (cfg/fetch c :b)))
    (is (= 3 (cfg/fetch c :c)))))

(deftest overrides-win-and-clear
  (let [c (cfg/create {:model "gpt"})]
    (cfg/override c :model "claude")
    (is (= "claude" (cfg/fetch c :model)))
    ; the effective map also reflects the override
    (is (= "claude" (get (cfg/settings c) :model)))
    (cfg/clear-overrides c)
    (is (= "gpt" (cfg/fetch c :model)))))

(deftest override-does-not-touch-base
  (let [c (cfg/create {:x 1})]
    (cfg/override c :x 99)
    (is (= 99 (cfg/fetch c :x)))
    (cfg/put c :x 2)
    (cfg/clear-overrides c)
    ; base moved to 2 underneath the override; clearing reveals it
    (is (= 2 (cfg/fetch c :x)))))
