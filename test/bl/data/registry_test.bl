; test/bl/data/registry_test.bl — data.registry roll-call.
; Run: mix beam_lisp.test test/bl/data/registry_test.bl

(ns data.registry.test
  (:require [data.registry :as reg]))

(deftest enroll-then-list
  (let [r (reg/open)
        i1 (reg/enroll r :conn "alpha" {:port 1})
        i2 (reg/enroll r :conn "beta" {:port 2})]
    (is (= 2 (reg/size r)))
    ; oldest-first order
    (is (= ["alpha" "beta"] (mapv :name (reg/entries r))))
    (is (not= i1 i2))))

(deftest retire-removes
  (let [r (reg/open)
        id (reg/enroll r :job "w" {})]
    (is (= 1 (reg/size r)))
    (reg/retire r id)
    (is (= 0 (reg/size r)))
    (is (nil? (reg/lookup r id)))))

(deftest of-kind-filters
  (let [r (reg/open)]
    (reg/enroll r :conn "a" {})
    (reg/enroll r :conn "b" {})
    (reg/enroll r :job "c" {})
    (is (= 2 (count (reg/of-kind r :conn))))
    (is (= 1 (count (reg/of-kind r :job))))))

(deftest count-by-kind-histogram
  (let [r (reg/open)]
    (reg/enroll r :a "1" {})
    (reg/enroll r :a "2" {})
    (reg/enroll r :b "3" {})
    (let [bk (reg/count-by-kind r)]
      (is (= 2 (get bk :a)))
      (is (= 1 (get bk :b))))))

(deftest lookup-carries-meta
  (let [r (reg/open)
        id (reg/enroll r :conn "x" {:port 8080 :host "local"})
        e (reg/lookup r id)]
    (is (= "x" (:name e)))
    (is (= :conn (:kind e)))
    (is (= 8080 (get (:meta e) :port)))))
