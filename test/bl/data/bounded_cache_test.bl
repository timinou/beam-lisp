(ns data.bounded-cache-test
  (:require [data.bounded-cache :as cache] [data.cache-budget :as budget]))

(def NAME :navigation_bounded_cache_test)

(deftest budget-replacements-do-not-retain-historical-generations
  (let [s (reduce (fn [s n] (:state (budget/offer s :one n 1000)))
                  (budget/empty-state) (range 10000))]
    (is (= 1 (count (:entries s))))
    (is (= 1000 (:bytes s)))
    (is (= 9999 (get-in s [:entries :one :revision])))))

(deftest generated-insertions-always-respect-byte-and-count-bounds
  (loop [n 0 s (budget/empty-state)]
    (when (< n 600)
      (let [w (* 65536 (inc (mod (* n 17) 40)))
            d (budget/offer s (mod n 97) n w)
            next (:state d)]
        (is (<= (:bytes next) budget/MAX-BYTES))
        (is (<= (count (:entries next)) budget/MAX-ENTRIES))
        (is (= (:bytes next) (reduce + 0 (mapv :weight (vals (:entries next))))))
        (recur (inc n) next)))))

(deftest invalid-and-oversized-charges-cannot-corrupt-budget
  (doseq [w [nil -1 0 1.5 (+ budget/MAX-ENTRY 1)]]
    (let [s (budget/empty-state) d (budget/offer s :key 1 w)]
      (is (not (:accepted? d)))
      (is (= s (:state d))))))

(deftest values-and-revisions-are-exact-and-nil-is-cacheable
  (cache/clear! NAME)
  (is (cache/put! NAME :key 1 nil))
  (is (= {:hit? true :value nil} (cache/lookup NAME :key 1)))
  (is (not (:hit? (cache/lookup NAME :key 1.0))))
  (is (cache/put! NAME :key 2 {:value "new"}))
  (is (not (:hit? (cache/lookup NAME :key 1))))
  (is (= {:value "new"} (:value (cache/lookup NAME :key 2))))
  (is (= 1 (:size (cache/stats NAME)))))

(deftest reference-identities-do-not-collide-with-forged-container-keys
  (cache/clear! NAME)
  (let [a (erlang/make_ref) b (erlang/make_ref)]
    (is (cache/put! NAME {:store a} 1 :a))
    (is (= :a (:value (cache/lookup NAME {:store a} 1))))
    (is (not (:hit? (cache/lookup NAME {:store b} 1))))
    (is (not= (cache/key-data a 0) (cache/key-data (tuple :reference (erlang/node) (erlang/ref_to_list a)) 0)))
    (is (nil? (cache/footprint a)))
    (is (not (cache/put! NAME :opaque 1 a)))))

(deftest sub-binaries-charge-the-memory-they-retain
  (let [parent (binary/copy "x" (* 1024 1024))
        slice (binary/part parent 0 65536)]
    (is (>= (cache/footprint slice) (* 2 (binary/referenced_byte_size slice))))))

(deftest cache-owner-survives-the-reader-that-created-it
  (let [name :navigation_cache_transient_reader
        parent (erlang/self)
        pid (spawn (fn [] (cache/put! name :key 1 "survives")
                          (erlang/send parent :cache-reader-done)
                          (receive :finish nil (after 5000 nil))))
        monitor (erlang/monitor :process pid)]
    (receive :cache-reader-done :ok (after 5000 (assert false "reader timed out")))
    (erlang/exit pid :kill)
    (receive [:DOWN ref :process dead why]
      (is (= [monitor pid :killed] [ref dead why]))
      (after 5000 (assert false "reader did not terminate")))
    (is (= 1 (:size (cache/stats name))))
    (is (= "survives" (:value (cache/lookup name :key 1))))
    (is (some? (Process/whereis name)))))

(deftest large-values-are-declined-without-losing-the-previous-entry
  (cache/clear! NAME)
  (cache/put! NAME :key 1 "small")
  (is (not (cache/put! NAME :key 2 (binary/copy "x" budget/MAX-ENTRY))))
  (is (not (:hit? (cache/lookup NAME :key 2))))
  (is (= "small" (:value (cache/lookup NAME :key 1)))))

(deftest actual-cache-pressure-respects-the-pure-budget
  (cache/clear! NAME)
  (let [v (binary/copy "x" 400000)]
    (doseq [n (range 60)]
      (is (cache/put! NAME n 1 v))
      (is (<= (:bytes (cache/stats NAME)) budget/MAX-BYTES)))
    (is (< (:size (cache/stats NAME)) 60))))

(deftest computation-errors-propagate-and-opaque-results-only-bypass-cache
  (cache/clear! NAME)
  (is (= :threw (try (cache/value NAME :error 1 (fn [] (throw :boom))) (catch _ :threw))))
  (let [v (erlang/make_ref) calls (atom 0)
        read (fn [] (cache/value NAME :opaque 1 (fn [] (swap! calls inc) v)))]
    (is (= v (read)))
    (is (= v (read)))
    (is (= 2 @calls))))

(deftest changing-computation-code-does-not-reuse-an-old-answer
  (cache/clear! NAME)
  (is (= 1 (cache/value NAME :same-inputs 1 (fn [] 1))))
  (is (= 2 (cache/value NAME :same-inputs 1 (fn [] 2))))
  (is (= 1 (:size (cache/stats NAME)))))

(deftest admission-happens-before-starting-or-copying-to-an-owner
  (let [name :navigation_oversized_preflight_only
        v (binary/copy "x" budget/MAX-ENTRY)]
    (is (not (cache/put! name :large 1 v)))
    (is (nil? (Process/whereis name)))
    (is (not (cache/put! name :opaque 1 (erlang/make_ref))))
    (is (nil? (Process/whereis name)))))

(deftest successful-computation-does-not-wait-for-a-suspended-cache-owner
  (let [name :navigation_suspended_optional_cache
        _ (cache/put! name :existing 1 :cached)
        pid (Process/whereis name) parent (erlang/self)]
    (erlang/suspend_process pid)
    (try
      (is (= :cached (:value (cache/lookup name :existing 1))))
      (spawn (fn [] (erlang/send parent
                       (tuple :cache-independent-answer
                              (cache/value name :new 1 (fn [] :answer))))))
      ;; The cache owner stays suspended until the read returns. A five-second
      ;; default call would fail this contract; owner timing cannot affect data.
      (receive [:cache-independent-answer result]
        (is (= :answer result))
        (after 2000 (assert false "optional cache blocked a completed read")))
      (finally (erlang/resume_process pid)))))

(deftest owner-charges-the-validated-immutable-entry
  (cache/clear! NAME)
  (doseq [n (range 50)] (cache/put! NAME n 1 {:row n :data (str n)}))
  (let [stored (ets/tab2list NAME)]
    (is (= (:bytes (cache/stats NAME))
           (reduce (fn [n entry] (+ n (cache/footprint entry))) 0 stored)))))

(deftest bounded-fingerprints-preserve-typed-provenance
  (let [a (erlang/make_ref) b (erlang/make_ref)
        key {:principal "alice" :store a :schema {:version 1}}]
    (is (= 32 (erlang/byte_size (cache/fingerprint key))))
    (is (= (cache/fingerprint key) (cache/fingerprint key)))
    (is (not= (cache/fingerprint key) (cache/fingerprint (assoc key :principal "bob"))))
    (is (not= (cache/fingerprint key) (cache/fingerprint (assoc key :store b))))
    (is (not= (cache/fingerprint a)
              (cache/fingerprint (tuple :reference (erlang/node) (erlang/ref_to_list a)))))
    (is (not= (cache/fingerprint 1) (cache/fingerprint 1.0)))
    (is (nil? (cache/fingerprint {:opaque (fn [] nil)})))
    (is (nil? (cache/fingerprint (binary/copy "x" 1048576))))))
