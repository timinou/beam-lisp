(ns data.ranked-tree-test (:require [data.ranked-tree :as rank]))
(defn apply-change [state op key value]
 (let [before @state ctx (rank/context (fn [id] (get (:nodes before) id)) (:next before))
       root (if (= op :insert) (rank/insert ctx (:root before) key value)
                               (rank/remove ctx (:root before) key))
       changes (rank/changes ctx)]
  (reset! state {:root root :next (:next changes)
                 :nodes (merge (apply dissoc (:nodes before) (:delete changes)) (:new changes))})))
(defn read-page [state offset limit direction]
 (let [snapshot @state gets (atom 0)
       ctx (rank/context (fn [id] (swap! gets inc) (get (:nodes snapshot) id)) (:next snapshot))]
  {:values (rank/page ctx (:root snapshot) offset limit direction)
   :count (rank/size ctx (:root snapshot)) :gets @gets}))
(deftest persistent-node-rank-matches-sorted-oracle
 (let [state (atom {:root nil :next 0 :nodes {}})
       keys (mapv (fn [i] [(quot i 5) i]) (range 2048))]
  (doseq [k keys] (apply-change state :insert k (second k)))
  (is (= 2048 (count (:nodes @state))))
  (doseq [offset [0 50 1000 1998 2048]]
   (let [p (read-page state offset 50 :asc)]
    (is (= (subvec (into [] (range 2048)) offset (min 2048 (+ offset 50))) (:values p)))
    (is (= 2048 (:count p)))
    (is (< (:gets p) 100))
    (println "rank-read-work" {:offset offset :rows (count (:values p)) :gets (:gets p)})))
  (is (= (into [] (reverse (range 1998 2048))) (:values (read-page state 0 50 :desc))))
  (doseq [k (filter (fn [k] (even? (second k))) keys)]
   (apply-change state :remove k nil))
  (is (= 1024 (count (:nodes @state))))
  (let [expected (into [] (filter odd? (range 2048)))]
   (is (= expected (:values (read-page state 0 2048 :asc))))
   (is (= (subvec expected 900 950) (:values (read-page state 900 50 :asc)))))
  ;; Updating a value must not add an extra member or retain obsolete nodes.
  (apply-change state :insert [0 1] :changed)
  (is (= :changed (first (:values (read-page state 0 1 :asc)))))
  (is (= 1024 (count (:nodes @state))))))
(deftest missing-nodes-and-work-limits-decline
 (let [ctx (rank/context (fn [_] nil) 0)]
  (is (= :rank-node-missing (:refused (try (rank/page ctx 1 0 10 :asc) nil (catch e e))))))
 (let [ctx (rank/context (fn [_] {:id 1 :key [1 1] :value 1 :left 1 :right nil :height 2 :size 2}) 0)]
  (reset! (:work ctx) 8)
  (is (= :rank-work-limit (:refused (try (rank/page ctx 1 0 10 :asc) nil (catch e e)))))))
