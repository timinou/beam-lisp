(ns data.ranked-tree-store-test
 (:require [data.ranked-tree :as rank] [datom.store :as store]
           [datom.store-ets :as ets-store] [datom.store-fjall :as fjall]
           [datom.derived :as derived]))
(defn node-key [id] (derived/record-key [:rank-test/node id]))
(def ROOT (derived/record-key [:rank-test/root]))
(def SOURCE (derived/record-key [:rank-test/source]))
(defn mutate [s old key value op]
 (let [ctx (rank/context (fn [id] (store/-get s (node-key id))) (:next old))
       root (if (= :insert op) (rank/insert ctx (:root old) key value)
                              (rank/remove ctx (:root old) key))
       delta (rank/changes ctx)
       header {:root root :next (:next delta) :basis (inc (:basis old))}
       ops (into [[:put ROOT header] [:put SOURCE (:basis header)]]
              (concat (map (fn [pair] [:put (node-key (first pair)) (second pair)]) (:new delta))
                      (map (fn [id] [:delete (node-key id)]) (:delete delta))))]
  {:header header :ops ops}))
(defn page [s h offset limit]
 (let [gets (atom 0)
       ctx (rank/context (fn [id] (swap! gets inc) (store/-get s (node-key id))) (:next h))]
  {:rows (rank/page ctx (:root h) offset limit :asc) :count (rank/size ctx (:root h)) :gets @gets}))
(defn exercise [s]
 (loop [i 0 h {:root nil :next 0 :basis 0}]
  (if (= i 512)
   (let [before (page s h 462 50)
         pending (mutate s h [0 0] :changed :insert)]
    (is (= (vec (range 462 512)) (:rows before)))
    (is (< (:gets before) 100)) (is (= 512 (:count before)))
    ;; Preparing a failed source transaction cannot publish a new tree/root.
    (is (= h (store/-get s ROOT)))
    (is (= 0 (first (:rows (page s h 0 1)))))
    (store/-commit s (:ops pending))
    (is (= (:basis (:header pending)) (store/-get s SOURCE)))
    (is (= :changed (first (:rows (page s (:header pending) 0 1)))))
    ;; Old nodes are immutable and retired. An old-root consumer must decline,
    ;; leaving the database's immutable authoritative query to handle fallback.
    (is (= :rank-node-missing (:refused (try (page s h 0 1) nil (catch e e)))))
    (println "durable-rank-read-work" {:rows 50 :offset 462 :gets (:gets before)}))
   (let [pending (mutate s h [(quot i 5) i] i :insert)]
    (store/-commit s (:ops pending))
    (recur (inc i) (:header pending))))))
(deftest rank-roots-and-source-publish-through-the-same-storage-port
 (let [s (ets-store/open)] (try (exercise s) (finally (ets-store/close s))))
 (exercise (fjall/open (store/fresh-path ".rank-test"))))
