; test/bl/data/pulse_test.bl — data.pulse live cell dashboard core.
; Run: mix beam_lisp.test test/bl/data/pulse_test.bl
;
; Tests the pure/observable core (registry, vitals, snapshot). The websocket
; and HTML rendering are exercised by shape (page is non-empty, snapshot is
; well-formed); a live browser is out of scope for a unit test.

(ns data.pulse.test
  (:require [data.pulse :as pulse]))

(deftest track-then-snapshot-shows-the-cell
  (let [a (atom 7)
        id (pulse/track :atom "seven" (fn [] @a))
        cells (vec (:cells (pulse/snapshot)))
        mine (first (filter (fn [c] (= (:id c) id)) cells))]
    (is (= :atom (:kind mine)))
    (is (= "seven" (:name mine)))
    (is (= "7" (:value mine)))
    (pulse/untrack id)))

(deftest value-is-read-live
  (let [a (atom 1)
        id (pulse/track :atom "n" (fn [] @a))
        read-mine (fn [] (:value (first (filter (fn [c] (= (:id c) id))
                                                (vec (:cells (pulse/snapshot)))))))
        before (read-mine)]
    (swap! a inc)
    (is (= "1" before))
    (is (= "2" (read-mine)))
    (pulse/untrack id)))

(deftest untrack-removes-the-row
  (let [id (pulse/track :delay "d" (fn [] :x))
        present? (fn [] (some (fn [c] (= (:id c) id))
                              (vec (:cells (pulse/snapshot)))))]
    (is (= true (present?)))
    (pulse/untrack id)
    (is (not (present?)))))

(deftest a-throwing-reader-is-contained
  ; observation must never perturb: a reader that throws reports :unreadable,
  ; it does not crash the snapshot.
  (let [id (pulse/track :bad "boom" (fn [] (throw (ex-info "x" {}))))
        vals (vec (map :value (:cells (pulse/snapshot))))]
    (is (some (fn [v] (= v ":unreadable")) vals))
    (pulse/untrack id)))

(deftest vitals-are-well-formed
  (let [v (pulse/vitals)]
    ; native ground truth: non-negative counts and byte estimate present
    (is (<= 0 (:live-cells v)))
    (is (<= 0 (:retained-bytes v)))
    (is (<= 0 (:pending v)))
    (is (<= 0 (:tracked v)))))

(deftest by-kind-histogram
  (let [ids [(pulse/track :atom "a1" (fn [] 1))
             (pulse/track :atom "a2" (fn [] 2))
             (pulse/track :derived "d1" (fn [] 3))]
        bk (pulse/by-kind)]
    ; at least the three we just added are counted under their kinds
    (is (<= 2 (get bk :atom)))
    (is (<= 1 (get bk :derived)))
    (doseq [id ids] (pulse/untrack id))))

(deftest mount-yields-a-page-and-handlers
  (let [m (pulse/mount)]
    (is (< 0 (String/length (:page-html m))))
    (is (contains? (:ws-handlers m) :init))
    (is (contains? (:ws-handlers m) :handle-info))))
