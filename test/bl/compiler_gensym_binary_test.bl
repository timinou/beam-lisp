(ns compiler.gensym-binary-test (:require [compiler]))

(defn candidates []
  (let [alphabet ["x" "_" "1" "é" "💡" "\u0000" "\n" "\r"]
        bases (concat ["" "xy" "___" "x___" "x______" "\t" "a\r\nb"
                       (erlang/list_to_binary (list 255 0 120))]
                alphabet
                (for [a alphabet b alphabet] (str a b))
                (for [a alphabet b alphabet c alphabet] (str a b c)))]
    (vec (for [base bases digits ["0" "01" "99" "" "a" "١" "1_" "1\n"]
               suffix ["__auto" "__auto\n" "__auto\n\n" "__c"]]
           (str base "__" digits suffix)))))

(deftest binary-gensym-recognition-matches-the-anchored-pattern
  (let [oracle (Regex/compile! "^(.+)__[0-9]+__auto$")
        parser (BeamLisp.Env/fetch_exact! "compiler" "gensym-base")]
    (doseq [name (candidates)]
      (let [match (Regex/run oracle name)
            expected (when match (second match))
            actual (BeamLisp.Ns.Rt/invoke parser (list name))]
        (is (= expected actual) (str "gensym bytes=" (Kernel/inspect (erlang/binary_to_list name))))))
    (is (= "x_" (BeamLisp.Ns.Rt/invoke parser (list "x___1__auto"))))
    (is (= "x___" (BeamLisp.Ns.Rt/invoke parser (list "x_____1__auto"))))
    (is (= "é" (BeamLisp.Ns.Rt/invoke parser (list "é__01__auto\n"))))
    (is (nil? (BeamLisp.Ns.Rt/invoke parser (list "x__1__auto\n\n"))))
    (is (nil? (BeamLisp.Ns.Rt/invoke parser (list "__1__auto"))))))
