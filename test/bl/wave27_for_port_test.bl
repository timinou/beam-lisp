; wave27_for_port_test.bl — `for` (the list comprehension) and the variadic
; `vary-meta`, ported from the ExUnit `test/beam_lisp/wave27_for_test.exs`.
;
; `for` is the single most-reached-for macro in Clojure and was, before wave 27,
; the prelude's most glaring hole — jank's fidelity slice 44 always PASSED
; because it vendors upstream's own `for` into its test namespace, measuring that
; beam-lisp can *host* `for`, never that the language shipped one. This file
; asserts the prelude `for` behaves: laziness (proven by a realization COUNT, not
; a stopwatch), nesting, :let/:when/:while modifiers, destructuring, and gensym
; hygiene. `vary-meta`'s variadic arity is asserted beside it.
;
; The ExUnit `realize/1` (a `BeamLisp.eval` wrapper) is not needed: a BL deftest
; IS the runtime, so each `for` is realized in place by `doall` and compared with
; the structural `=`. Every original assertion is here — the realization-counter
; laziness checks are the load-bearing ones, since a stopwatch proves only speed.
;
; Run: bin/bl test test/bl/wave27_for_port_test.bl

(ns wave27.for.test)

; --- for comprehends over a vector, lazily ---

(deftest for-comprehends-lazily
  (is (= (doall (for [x [1 2 3]] (* x 2))) '(2 4 6)))
  ; empty collection → empty seq, no raise
  (is (= (doall (for [x []] x)) ()))
  ; an all-rejecting :when terminates with an empty seq
  (is (= (doall (for [x [1 2 3] :when false] x)) ())))

; --- nesting ---

(deftest for-nests-rightmost-fastest
  ; rightmost binding runs fastest; a later binding expr may refer to an
  ; earlier binding (y (range x) reads x)
  (is (= (doall (for [x [1 2] y (range x)] [x y])) '([1 0] [2 0] [2 1]))))

; --- modifiers ---

(deftest for-supports-let-when-while
  (is (= (doall (for [x [1 2 3] :let [y (* x 10)]] [x y])) '([1 10] [2 20] [3 30])))
  (is (= (doall (for [x (range 10) :when (even? x)] x)) '(0 2 4 6 8)))
  ; :while must terminate over an INFINITE source
  (is (= (doall (for [x (range) :while (< x 5)] x)) '(0 1 2 3 4))))

; --- destructuring ---

(deftest for-destructures-the-binding-form
  (is (= (doall (for [[a b] [[1 2] [3 4]]] (+ a b))) '(3 7)))
  (is (= (set (for [[k v] {:a 1 :b 2}] [k v])) #{[:a 1] [:b 2]})))

; --- laziness, proven by a realization COUNT ---
; The source has a million elements; taking 5 must realize at most one chunk.
; A counter proves laziness where a stopwatch proves only speed — the whole
; point of `for` being lazy.

(deftest for-is-lazy-bounded-take-realizes-bounded-prefix
  (is (let [c (atom 0)
            res (doall (take 5 (for [x (range 1000000)]
                                 (do (swap! c inc) (* x 2)))))]
        (and (<= 5 (deref c) (BeamLisp.LazySeq/chunk_size)) (= res '(0 2 4 6 8)))))
  ; :when over a huge range is lazy the same way
  (is (let [c (atom 0)
            res (doall (take 5 (for [x (range 1000000) :when (even? x)]
                                 (do (swap! c inc) x))))]
        (and (<= 5 (deref c) (BeamLisp.LazySeq/chunk_size)) (= res '(0 2 4 6 8))))))

; --- hygiene ---

(deftest for-does-not-capture-user-bindings
  ; gensym hygiene: the macro's temporaries must not capture a user binding of
  ; the same name
  (is (= (let [iter 5] (doall (for [x [1]] iter))) '(5)))
  (is (= (let [s 7] (doall (for [x [1]] s))) '(7)))
  (is (= (let [x 9] (doall (for [y [1]] x))) '(9))))

; --- vary-meta: variadic (wave 27) ---
; Clojure's vary-meta is (vary-meta obj f & args): the metadata is replaced by
; (apply f (meta obj) args). The 2-arity is unchanged; the variadic form is what
; (vary-meta x assoc :k v) needs.

(deftest vary-meta-is-variadic
  ; 2-arity behaviour is unchanged
  (is (= (meta (vary-meta [1] (fn [m] {:a 1}))) {:a 1}))
  ; the common variadic spelling Specter uses
  (is (= (meta (vary-meta [1] assoc :k 1)) {:k 1}))
  (is (= (meta (vary-meta [1] assoc :k 1 :j 2)) {:k 1 :j 2}))
  ; nil meta flows through as nil, as Clojure does
  (is (= (meta (vary-meta [1] (fn [m] (if (nil? m) {:from-nil true} m))))
         {:from-nil true})))
