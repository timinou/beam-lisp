; test/bl/catch_raw_test.bl — `(try … (catch-raw [kind reason stack] …))`.
;
; PORTED from perf/lazy-engine 5340975e `test/bl/catch_raw_test.bl` (commit
; b335a9bf, `compiler: (catch-raw [kind reason stack] …)`).
;
; `catch` NORMALIZES what it catches (an :error becomes an exception struct, a
; throw of a non-exception becomes ExInfo, an :exit becomes {:exit v}) — right
; for user code, and lossy for a runtime that must RECORD a failure and REPLAY
; it unchanged: a memo cell whose thunk raised hands every waiter the same
; kind, reason and stack the evaluator saw (PLAN-151). `catch-raw` is that
; clause: the class atom, raw reason, and a stable stack FRAME LIST that can
; be stored and passed to `erlang:raise/3` through `erlang:apply/3`.
;
; Kept as its OWN file, apart from `catch_exception_kind_test.bl` (which pins
; the folded handler's `__EXCEPTION_KIND__`), so an image whose compiler lacks
; the clause fails only these cases and the kind suite still runs.
;
; Run: bin/bl test test/bl/catch_raw_test.bl

(ns catch.raw.test)

(defn- raw-catch [f]
  (try (f) (catch-raw [kind reason stack] [kind reason stack])))

(deftest catch-raw-binds-the-class-and-the-unnormalized-reason
  (testing "the class atom, and the raw reason before normalization"
    (is (= [:throw :boom] (take 2 (raw-catch (fn [] (erlang/throw :boom))))))
    (is (= [:exit :bye] (take 2 (raw-catch (fn [] (erlang/exit :bye))))))
    (is (= [:error :badthing] (take 2 (raw-catch (fn [] (erlang/error :badthing))))))
    (is (= :error
           (first (raw-catch (fn [] (erlang/error (Elixir.ArgumentError/exception "x")))))))
    (is (= "x"
           (:message (second (raw-catch
                              (fn [] (erlang/error (Elixir.ArgumentError/exception "x")))))))
        "an exception reason arrives as the struct itself, untouched")))

(deftest catch-raw-stack-reraises-bit-for-bit
  (testing "the frame list survives storage and re-raising preserves class and reason"
    (let [[k r s] (raw-catch (fn [] (erlang/error :inner)))
          [k2 r2 _] (raw-catch
                      (fn [] (erlang/apply :erlang :raise (list k r s))))]
      (is (erlang/is_list s) "the captured stack is a persistent frame list")
      (is (= [:error :inner] [k2 r2])))))

(deftest catch-raw-body-value-passes-through
  (is (= 42 (try 42 (catch-raw [k r s] :never)))))

(deftest catch-raw-finally-still-runs
  (let [a (atom 0)]
    (is (= 1 (try (erlang/throw 1) (catch-raw [k r s] r) (finally (swap! a inc)))))
    (is (= 1 @a))))

(deftest ordinary-catch-is-unchanged-beside-catch-raw
  (is (= "x" (ex-message (try (erlang/error (Elixir.ArgumentError/exception "x"))
                              (catch e e))))))

(run-tests)
