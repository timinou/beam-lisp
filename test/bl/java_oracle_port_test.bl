; test/bl/java_oracle_port_test.bl — the interop manifest against the JVM it
; stands in for, ported from `test/beam_lisp/java_oracle_test.exs`.
;
; Each row is a Clojure expression using `java.math`/`java.util` interop the way
; an unmodified library writes it — `(.setScale x 2 RoundingMode/HALF_EVEN)`,
; `(BigDecimal. "1.5")`, `(catch NumberFormatException _ …)`, `Long/MAX_VALUE` —
; with the answer CAPTURED FROM THE JVM (`clojure -M` with the same `:import`s).
; beam-lisp compiles the identical text through `priv/lib/java/manifest.bl` and
; must print the same value.
;
; Each row's answer is DATA — an Elixir string, number, or boolean — and bl's
; `pr-str` is compared against the READABLE printing of it (`inspect/1`), which
; is what `pr-str` answers now: a string row reads `"ABC"` on both sides, a
; number row `3`. Before FUP-032 was fixed, a top-level string printed bare, so
; the two columns agreed only modulo that defect — and the fixture could not have
; told a string from a symbol.
;
; A row's answer is typed as the JVM typed it — a String where the JVM answered
; a String (`(.toPlainString x)` answers `"3.30"`; `(.toUpperCase "abc")` answers
; `"ABC"`), a number where it answered a number, a boolean where a boolean. bl's
; interop returns the same types, so the two columns are comparable directly, and
; a regression that stringified a number would now be caught instead of printing
; the same text.
;
; ── coverage map (ExUnit test → BL deftest) ────────────────────────────────
; Both ExUnit tests map one-to-one onto a same-named BL deftest, in order:
;   java interop through the manifest matches the JVM (all 34 rows);
;   an unlisted method, static, class or catch is a compile-time refusal with the
;     list (three refusal regexes + the deftype field-read escape hatch).
;
; Adaptations, and why:
;   * `use ExUnit.Case, async: false` has no ward equivalent: `bl test` runs each
;     FILE in its own isolated fork, and a file's tests run in order in that one
;     env. The ExUnit `setup_all` (`BeamLisp.AOT.boot()`) becomes `(BeamLisp/init)`
;     inside each test — the same live-toolchain start every BL suite performs.
;   * `BeamLisp.Compiler.eval_string/2` → `BeamLisp.Compiler/eval_string`; the
;     ExUnit `run/2`'s `rescue`/`catch` of ANY raise becomes `(catch _ "ERROR")`.
;   * `inspect(expected)` → `(BeamLisp.Ns.Rt/print_readably expected)`, the same
;     readable printer the `got` column uses.
;   * `assert_raise BeamLisp.CompileError, ~r/…/, fn -> … end` becomes a TYPED
;     `catch BeamLisp.CompileError` plus a `re-find` of the same regex on
;     `ex-message` — the class AND the message are both pinned, so this is not
;     weaker than the original. The fourth assertion (the deftype field read) is
;     a plain value equality, unchanged.
;   * The unique-namespace device the original got from `Module.concat` here is
;     just a fixed, suite-local namespace name (`java.oracle.port.*`), because a
;     ward fork is disposable: namespaces load once per VM and this file's VM is
;     its own.
;
; Run: bin/bl test test/bl/java_oracle_port_test.bl

(ns java.oracle.port.test)

(def ^:private rows
  [["(.toPlainString (.add 1.10M 2.20M))" "3.30"]
   ["(.toPlainString (.setScale 2.345M 2 RoundingMode/HALF_EVEN))" "2.34"]
   ["(.toPlainString (.setScale 2.345M 2 RoundingMode/HALF_UP))" "2.35"]
   ["(.toPlainString (.divide 10M 3M 4 RoundingMode/DOWN))" "3.3333"]
   ["(.toPlainString (.multiply (BigDecimal. \"1.5\") (BigDecimal/valueOf 4)))" "6.0"]
   ["(.toPlainString (.negate BigDecimal/ONE))" "-1"]
   ["(.toPlainString (.abs -2.5M))" "2.5"]
   ["(.signum -3M)" -1]
   ["(.compareTo 1.0M 1.00M)" 0]
   ["(.equals 1.0M 1.00M)" false]
   ["(.scale 1.230M)" 3]
   ["(.precision 1.230M)" 4]
   ["(.longValue 3.99M)" 3]
   ["(.toPlainString (.stripTrailingZeros 1.500M))" "1.5"]
   ["(.toPlainString (.movePointLeft 15M 2))" "0.15"]
   ["(.toPlainString (.movePointRight 1.5M 3))" "1500"]
   ["(.toUpperCase \"abc\")" "ABC"]
   ["(.startsWith \"hello\" \"he\")" true]
   ["(.substring \"hello\" 1 3)" "el"]
   ["(.lastIndexOf \"a.b.c\" \".\")" 3]
   ["(.toString 1.50M)" "1.50"]
   ["(str (.getTime (Date/from (java.time.Instant/ofEpochMilli 1000))))" "1000"]
   ["(.before (Date/from (java.time.Instant/ofEpochMilli 1)) (Date/from (java.time.Instant/ofEpochMilli 2)))" true]
   ["(instance? BigDecimal 1M)" true]
   ["(instance? BigDecimal 1)" false]
   ["(try (BigDecimal. \"x\") (catch NumberFormatException _ \"NFE\"))" "NFE"]
   ["(try (.divide 1M 3M) (catch ArithmeticException _ \"ARITH\"))" "ARITH"]
   ["(try (throw (ex-info \"b\" {})) (catch Exception _ \"EXC\"))" "EXC"]
   ["(try (throw (ex-info \"b\" {})) (catch Throwable _ \"THR\"))" "THR"]
   ["(str (UUID/fromString \"123E4567-E89B-12D3-A456-426614174000\"))" "123e4567-e89b-12d3-a456-426614174000"]
   ["(let [c (AtomicLong.)] (.incrementAndGet c) (.incrementAndGet c))" 2]
   ["Long/MAX_VALUE" 9223372036854775807]
   ["(Math/abs -3)" 3]
   ["(Character/isDigit \\7)" true]])

(defn- rows-env
  "The compile environment the original's `setup_all` + header pair built: the
   `(ns … (:import …))` runs first, so the short class names resolve, then a
   fresh env is taken for it."
  []
  (BeamLisp.Compiler/eval_string
    "(ns java.oracle.port.rows (:import [java.math BigDecimal RoundingMode] [java.util Date UUID] [java.util.concurrent.atomic AtomicLong]))")
  (BeamLisp.Compiler/new_env "java.oracle.port.rows"))

(defn- refusal-env []
  (BeamLisp.Compiler/eval_string
    "(ns java.oracle.port.refusals (:import [java.math BigDecimal RoundingMode]))")
  (BeamLisp.Compiler/new_env "java.oracle.port.refusals"))

(defn- run-row
  "One row's answer in `pr-str`'s shape: evaluate `src`, print the value
   readably; ANY raise is the literal \"ERROR\" — the ExUnit `run/2`."
  [env src]
  (try
    (BeamLisp.Ns.Rt/print_readably (BeamLisp.Compiler/eval_string src env))
    (catch _ "ERROR")))

(defn- refusal
  "The `BeamLisp.CompileError` `src` raises, or nil — what an `assert_raise`
   bound. Any other class is nil too, so `matches?` fails rather than passing."
  [env src]
  (try
    (do (BeamLisp.Compiler/eval_string src env) nil)
    (catch BeamLisp.CompileError e e)
    (catch _ nil)))

(defn- matches?
  "True when `e` is a CompileError whose message `re-find`s `pattern` — the
   original's `assert_raise BeamLisp.CompileError, ~r/pattern/`."
  [e pattern]
  (and (some? e) (some? (re-find (re-pattern pattern) (ex-message e)))))

(deftest java-interop-through-the-manifest-matches-the-jvm
  (BeamLisp/init)
  (let [env (rows-env)
        total (count rows)
        failures (to-list
                   (remove nil?
                     (map-indexed
                       (fn [i row]
                         (let [src (first row)
                               expected (second row)
                               got (run-row env src)]
                           (when (not= got (BeamLisp.Ns.Rt/print_readably expected))
                             (str "row " i ": " src
                                  "\n    JVM: " (pr-str expected)
                                  "\n    bl:  " (pr-str got)))))
                       rows)))]
    (is (= 34 total) "the corpus is complete: 34 rows, no case dropped")
    (is (= 0 (count failures))
        (str (count failures) " of " total " rows diverge:\n\n" (join "\n\n" failures)))))

(deftest an-unlisted-method-static-class-or-catch-is-a-compile-time-refusal-with-the-list
  (BeamLisp/init)
  (let [env (refusal-env)]
    (is (matches? (refusal env "(.frobnicate 1M 2M)")
                  "no Java method \\.frobnicate .* known methods: .*\\.add")
        "an unknown instance method is refused, listing the known ones")
    (is (matches? (refusal env "RoundingMode/SIDEWAYS")
                  "no static java.math.RoundingMode/SIDEWAYS .* this class has: .*HALF_EVEN")
        "an unknown static is refused, listing the class's members")
    (is (matches? (refusal env "(try 1 (catch java.io.IOException e 2))")
                  "catch java.io.IOException: not in the interop manifest")
        "an unknown catch class is refused as not in the exception table")
    ; a one-arg `.x` that the manifest does not know is still a deftype field read
    (is (= 42 (BeamLisp.Compiler/eval_string "(do (deftype P [x]) (.x (->P 42)))" env)))))
