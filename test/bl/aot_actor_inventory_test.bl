(ns aot-actor-inventory-test)

(def PROBE :Elixir.BeamLisp.AotActorInventoryProbe)
(def ^:private compiled-probe (atom nil))
(defn- scratch []
 (str (System/get_env "HOME") "/tmp/bl-aot-actor-inventory-"
      (erlang/unique_integer (list :positive))))
(defn- compile-probe! [dir]
 (let [token (BeamLisp.Env/capture)
       source (or (System/get_env "AOT_ACTOR_INVENTORY_SOURCE")
                  (str (or (System/get_env "BL_ROOT") (BeamLisp/cwd)) "/priv/host/aot.bl"))
       key [(crypto/hash :sha256 (File/read! source)) (BeamLisp.AOTCache/compiler_key)]
       cached @compiled-probe]
  (try
   ;; The fixture compiles the real, large host once per exact input. Every
   ;; case still invokes its actual verifier and supplies its own artifacts.
   (when-not (and (= key (:key cached)) (erlang/module_loaded PROBE)
                  (= (:md5 cached) (erlang/apply PROBE :module_info (list :md5))))
    (let [result (BeamLisp.AOT/compile_host_file source
                 (list (tuple :module PROBE) (tuple :output_dir dir) (tuple :load? false)))
         path (elem result 1)]
     (code/load_binary PROBE (erlang/binary_to_list path) (File/read! path))
     (reset! compiled-probe {:key key :md5 (erlang/apply PROBE :module_info (list :md5))})))
   (finally (BeamLisp.Env/bind token)))))
(defn- refused? [action]
 (try (action) false (catch _ true)))
(defn- attr [attrs key]
 (let [v (Keyword/get attrs key)] (if (and (erlang/is_list v) (= 1 (count v))) (first v) v)))

(deftest actor-artifacts-carry-exact-input-and-owner-and-replay-without-codegen
 (let [dir (scratch) source "(ns aot.actor.inventory.fixture)\n(defn value [] 17)\n(defserver worker (init [x] (ok x)) (handle-call :get [_ st] (reply st st)))\n"
       file (str dir "/actor.bl") out (str dir "/ebin") token (BeamLisp.Env/capture)]
  (try
   (File/mkdir_p! dir)
   (File/write! file source)
   (compile-probe! dir)
   (let [beams (erlang/apply PROBE :compile_source
                 (list source (list (tuple :file file) (tuple :output_dir out))))
         actor (BeamLisp.Server/module_for "aot.actor.inventory.fixture" "worker")
         ;; Erlang pairs are tuples, not a BL sequence.
         path (elem (first (filter #(= actor (elem % 0)) beams)) 1)
         bytes (File/read! path) md5 (elem (elem (beam_lib/md5 bytes) 1) 1)
         attrs (Keyword/get (elem (elem (beam_lib/chunks bytes (list :attributes)) 1) 1) :attributes)
         manifest {file {:modules (mapv #(elem % 0) beams)}}
         inventory-path (str dir "/sdk-code.term")]
    (is (some? path))
    (is (= (tuple "aot.actor.inventory.fixture" "worker") (attr attrs :bl_declaration_owner)))
    (is (= (crypto/hash :sha256 source) (attr attrs :bl_unit_source_digest)))
    (is (= md5 (erlang/apply actor :module_info (list :md5))))
    ;; An invalid descriptor would fail immediately if compilation were entered.
    (is (= actor (erlang/apply PROBE :replay_generated_module! (list {:name actor} md5))))
    (is (= (count beams) (erlang/apply PROBE :write_sdk_inventory!
                           (list dir manifest out inventory-path))))
    (let [inventory (erlang/binary_to_term (File/read! inventory-path) (list :safe))
          entry (get-in inventory [:modules (Atom/to_string actor)])]
     (is (= 2 (:version inventory)))
     (is (= :actor (:role entry)))
     (is (= :binary (:identities inventory)))
     (is (every? string? (mapcat :imports (vals (:modules inventory)))))
     (is (every? string? (mapcat #(or (:unit-references %) []) (vals (:modules inventory)))))
     (is (every? (fn [[route target]] (and (string? (elem route 0)) (int? (elem route 1)) (string? target)))
            (mapcat #(or (:forwarder-routes %) {}) (vals (:modules inventory)))))
     (is (= #{:actor :mutable-forwarder :initializer :stable-body}
            (set (map :role (vals (:modules inventory))))))
     (is (= "actor.bl" (:source entry)))
     (is (= md5 (:md5 entry)))
     (is (= (crypto/hash :sha256 bytes) (:sha256 entry)))
     (is (= (tuple "aot.actor.inventory.fixture" "worker") (:declaration-owner entry))))
    ;; A digest-valid partial projection is not a complete compiler receipt.
    ;; Omitted actor, body and value companion each refuse before publication.
    (doseq [role [:actor :stable-body :initializer]]
     (let [inventory (erlang/binary_to_term (File/read! inventory-path) (list :safe))
           omitted (first (keep (fn [[name row]] (when (= role (:role row)) name)) (:modules inventory)))
           partial {file {:modules (vec (remove #(= omitted (Atom/to_string %)) (:modules (get manifest file))))}}]
      (is (refused? #(erlang/apply PROBE :write_sdk_inventory! (list dir partial out inventory-path))))))
    ;; Evict only the idle fixture class. Reload uses its ordinary artifact,
    ;; again proving no descriptor compiler is needed on a packaged replay.
    (code/purge actor) (code/delete actor) (code/add_patha (erlang/binary_to_list out))
    (try
     (is (= actor (erlang/apply PROBE :replay_generated_module! (list {:name actor} md5))))
     (is (= md5 (erlang/apply actor :module_info (list :md5))))
     (finally (code/del_path (erlang/binary_to_list out))))
    (let [server (start actor 17)]
     (try (is (= 17 (call server :get))) (finally (stop server))))
    ;; Inventory never licenses a stale source or a module file with another
    ;; executable name, even if the build projection still lists it.
    (File/write! file (str source "\n; changed since compilation\n"))
    (is (refused? #(erlang/apply PROBE :write_sdk_inventory! (list dir manifest out inventory-path))))
    (File/write! file source)
    (let [other (first (filter #(not= actor (elem % 0)) beams))]
     (File/write! path (File/read! (elem other 1)))
     (is (refused? #(erlang/apply PROBE :write_sdk_inventory! (list dir manifest out inventory-path))))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))

(deftest a-literal-module-shaped-map-is-data-not-an-emitted-declaration
 (let [dir (scratch) token (BeamLisp.Env/capture)]
  (try
   (File/mkdir_p! dir) (compile-probe! dir)
   (let [data {:op :module :name :Elixir.InventoryData :clauses (list) :exports (list)}
         node {:op :lit :val data :ann {}}
         result (erlang/apply PROBE :prepare_generated_modules
                  (list node "aot.actor.inventory.literal" "payload" (list) {}))]
    (is (= node (elem result 0)))
    (is (= {} (elem result 1))))
   ;; Map expressions contain canonical Vector pairs in their ANF. Preserve
   ;; their Enumerable semantics while walking executable structure too.
   (let [source "(ns aot.actor.inventory.literal)\n(def payload {:op :module :name :Elixir.InventoryData :clauses [] :exports []})\n"
         beams (erlang/apply PROBE :compile_source
                 (list source (list (tuple :output_dir dir))))]
    (is (= false (boolean (some #(= :Elixir.InventoryData (elem % 0)) beams)))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))

(defn- forwarder-beam [target swapped? effect? extra?]
 (let [mod :Elixir.InventoryForwarderProof body :Elixir.InventoryForwarderBody
       args (list (BeamLisp.Emit/var "a") (BeamLisp.Emit/var "b"))
       call (BeamLisp.Emit/remote target :pair (if swapped? (Enum/reverse args) args))
       call (if effect? (BeamLisp.Emit/sequence
                         (list (BeamLisp.Emit/remote :erlang :send
                                 (list (BeamLisp.Emit/remote :erlang :self (list))
                                       (BeamLisp.Emit/lit :unexpected-forwarder-effect))) call)) call)
       clause (BeamLisp.Emit/function_clause :pair call
                (list {:pop :pvar :name "a"} {:pop :pvar :name "b"}))
       clauses (if extra? (list clause (BeamLisp.Emit/function_clause :new-export (BeamLisp.Emit/lit 99)))
                         (list clause))]
  (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for mod clauses))))

(deftest actual-forwarder-proof-preserves-arguments-and-destination-while-allowing-new-exports
 (let [dir (scratch) token (BeamLisp.Env/capture)
       body :Elixir.InventoryForwarderBody routes {(tuple :pair 2) body}]
  (try
   (File/mkdir_p! dir) (compile-probe! dir)
   (is (= true (erlang/apply PROBE :verify_sdk_forwarder!
                 (list (forwarder-beam body false false false) "inventory.forwarder" routes))))
   (is (= true (erlang/apply PROBE :verify_sdk_forwarder!
                 (list (forwarder-beam body false false true) "inventory.forwarder" routes))))
   (is (refused? #(erlang/apply PROBE :verify_sdk_forwarder!
                   (list (forwarder-beam :Elixir.ImpostorBody false false false) "inventory.forwarder" routes))))
   (is (refused? #(erlang/apply PROBE :verify_sdk_forwarder!
                   (list (forwarder-beam body true false false) "inventory.forwarder" routes))))
   (is (refused? #(erlang/apply PROBE :verify_sdk_forwarder!
                   (list (forwarder-beam body false true false) "inventory.forwarder" routes))))
   (is (refused? #(erlang/apply PROBE :verify_sdk_forwarder!
                   (list (forwarder-beam body false false false) "inventory.forwarder"
                         {(tuple :missing 0) body}))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))

(defn- many-forwarders [n]
 (let [body :Elixir.InventoryForwarderBody
       names (mapv (fn [i] (String/to_atom (str "route_" i))) (range n))
       args (list (BeamLisp.Emit/var "a") (BeamLisp.Emit/var "b"))
       clauses (to-list (mapv (fn [name]
                   (BeamLisp.Emit/function_clause name (BeamLisp.Emit/remote body name args)
                     (list {:pop :pvar :name "a"} {:pop :pvar :name "b"}))) names))]
  [(BeamLisp.Emit/compile_descriptor
     (BeamLisp.Emit/descriptor_for :Elixir.InventoryForwarderGrowth clauses))
   (into {} (mapv (fn [name] [(tuple name 2) body]) names))]))

(defn- verification-reductions [fixture]
 (let [before (elem (erlang/process_info (erlang/self) :reductions) 1)]
  (doseq [_ (range 3)]
   (erlang/apply PROBE :verify_sdk_forwarder!
     (list (first fixture) "inventory.forwarder.growth" (second fixture))))
  (- (elem (erlang/process_info (erlang/self) :reductions) 1) before)))

(deftest forwarder-verification-does-not-scan-all-exports-for-each-route
 (let [dir (scratch) token (BeamLisp.Env/capture)]
  (try
   (File/mkdir_p! dir) (compile-probe! dir)
   (let [small (many-forwarders 256) large (many-forwarders 512)
         _ (verification-reductions small)
         n (verification-reductions small) twice (verification-reductions large)]
    (println "SDK FORWARDER GROWTH" {:routes 256 :reductions n :twice-routes-reductions twice})
    (is (< twice (* n 2.8))))
   (finally (BeamLisp.Env/bind token) (File/rm_rf! dir)))))
