; test/bl/seed_support.bl — the helpers every split `seed` suite shares.
;
; `bl test` loads a required namespace from the cwd's search path, so a test file
; `(:require [test.bl.seed-support :as s])` and gets these directly. A file named
; `*_support.bl` is not a suite (the runner discovers `*_test.bl`), so this does
; not run on its own. The helpers are PUBLIC because a required ns is a module:
; a `defn-` here is not callable from the suite that required it.

(ns test.bl.seed-support
  (:require [seed]))

(defn sorted [coll] (vec (sort coll)))

(defn has? [coll x] (> (count (filter (fn [y] (= y x)) coll)) 0))

(defn scratch [name]
  (let [d (Path/join (System/tmp_dir) (str "bl-seed-test-" name))]
    (File/rm_rf! d)
    (File/mkdir_p! d)
    d))

(defn host-fixture [extra]
  ;; A `MACRO-<name>` implementer is part of the fixture because a mapping entry
  ;; that declares `:macro-exports` (Decimal's `is_decimal/1`, the guards'
  ;; `is_bl_map/1`/`is_ref_type/1`/`is_data_tuple/1`) is REFUSED by name unless
  ;; the compiled source carries the matching `MACRO-<name>/<arity+1>`. Leaves
  ;; that declare no macros simply export harmless extra functions.
  (str "(ns seed.host.fixture)\n"
       "(defn seeded-probe [x] x)\n"
       "(defn MACRO-is_decimal [caller x] nil)\n"
       "(defn MACRO-is_bl_map [caller x] nil)\n"
       "(defn MACRO-is_ref_type [caller x] nil)\n"
       "(defn MACRO-is_data_tuple [caller x] nil)\n"
       "(defn MACRO-__using__ [caller opts] nil)\n"
       extra))

(defn host-scratch
  "A scratch host dir holding a fixture source for EVERY entry
   `seed/host-sources` names. `real` optionally maps a module's `(str)` name to
   a checked-in source whose CONTENT is written in place of the fixture, so a
   test can drive the seed's own mapping with the real bytes of a leaf whose
   compiled surface it wants to inspect. The filenames come from the mapping
   itself, so this fixture can never test a shape the seed does not look for."
  ([name extra] (host-scratch name extra {}))
  ([name extra real]
   (let [d (Path/join (System/tmp_dir) (str "bl-seed-host-" name))]
     (File/rm_rf! d)
     (File/mkdir_p! d)
     (doseq [e (seed/host-sources d)]
       (let [p (get real (str (:module e)))]
         (File/write! (:source e)
           (if (some? p) (File/read! p) (host-fixture extra)))))
     d)))

(defn beam-exports
  "The export list a beam DECLARES, read from its `:exports` chunk without
   loading it. The question a published struct beam answers is about the bytes
   the floor carries, and a live module of the same name may be on the code
   path — so the beam is READ, never loaded."
  [path]
  (let [r (erlang/apply :beam_lib :chunks
                        (list (erlang/binary_to_list path) (list :exports)))]
    (if (and (tuple? r) (erlang/== :ok (erlang/element 1 r)))
      (let [chunks (erlang/element 2 (erlang/element 2 r))]
        (erlang/element 2 (erlang/hd chunks)))
      (list))))

(defn with-swapped-module
  "Run `f` with `mod` replaced by the BEAM at `path`, then put the module that was
   there back. The pinned host leaves are LIVE modules in this VM (the Elixir
   implementation of `decimal.ex` is still running at this wave), so a published
   beam is read by swapping it in and restoring the original — the same read
   `test/bl/host_decimal_test.bl` does at the production atom."
  [mod path f]
  (let [orig-path (erlang/apply :code :which (list mod))
        orig-bin (if (erlang/== :non_existing orig-path)
                   nil
                   (File/read! (erlang/list_to_binary orig-path)))]
    (try
      (do
        (code/purge mod)
        (code/delete mod)
        (code/load_binary mod (erlang/binary_to_list path) (File/read! path))
        (f mod))
      (finally
        (code/purge mod)
        (code/delete mod)
        (if (some? orig-bin)
          (code/load_binary mod orig-path orig-bin)
          :ok)))))

(defn restore-assertions!
  "Put the test library back into `core`.

   `seed/run` and `seed/check` LOAD every boot shim to ask its provenance, and
   loading `core` puts the compiled `BeamLisp.Ns.Core` back from `core.bl` —
   which does not carry `is-report/4` (the runner interns the test library into
   core's ENV, not into that beam). Every `is` after such a call would die
   `is-report/4 is undefined or private`. Re-evaluating the library into core is
   exactly what the runner does at file start, so the assertions keep working."
  []
  (let [priv (erlang/list_to_binary (erlang/apply :code :priv_dir (list :beam_lisp)))]
    (BeamLisp.Env/with_ns "core"
      (fn [] (BeamLisp/eval (File/read! (str priv "/std/test.bl")))))))

(defn seed-run! [opts] (let [r (seed/run opts)] (restore-assertions!) r))
(defn seed-check! [opts] (let [c (seed/check opts)] (restore-assertions!) c))

(defn term-manifest
  "The seed manifest as DATA, read the way the pre-`elixirc` stage reads it:
   `file:consult/1` over the Erlang term. Never `Code.eval_file` — the manifest
   is data, and the moment it stops being readable as data the stage has nothing
   to read before the runtime exists."
  [path]
  (let [r (erlang/apply :file :consult (list (erlang/binary_to_list path)))]
    (when-not (= :ok (erlang/element 1 r))
      (throw (str "the manifest at " path " is not consultable: " (pr-str r))))
    ; `file:consult/1` answers `{:ok, [Term]}` — the term is the FIRST element
    ; of the returned list, not the list itself.
    (erlang/hd (erlang/element 2 r))))
