; test/bl/auth_caps_test.bl — Biscuit rights → environment capabilities,
; working end to end. Each deftest is a USE CASE, not a unit test: mint,
; attenuate, authorize, project to caps, fork, and watch the gate hold.
;
; The rights vocabulary is datalog data: `["right" <module> <op>]` facts in
; a token's authority block; allow/deny policies as authorizer-side query
; predicates; revocation as an oracle over block ids. `auth/caps-for` runs
; the full Biscuit decision (signature → checks → policies) and projects
; the authority block's rights into the module set `env/fork` consumes.

(ns auth.caps-test
  (:require [auth] [env]))

(def root (auth/keypair))
(def root-pub (auth/public root))

(defn open-ctx []
  (auth/context {:policies [(auth/allow [])]}))

; The CI runner's token: may call String, may read AND write Files.
(def ci-token
  (auth/issue root [["entity" "ci-runner"]
                    ["right" "Elixir.String" "call"]
                    ["right" "Elixir.File" "read"]
                    ["right" "Elixir.File" "write"]]))

; ── use case 1: mint → authorize → caps → fork → the gate holds ──────

(deftest mint-authorize-project
  (let [r (auth/caps-for root-pub ci-token (open-ctx))]
    (is (contains? r :ok))
    ; "call" is the generic grant (bare module); other ops become pairs.
    ; Order follows the authority block's facts, distinct.
    (is (= [:Elixir.String] (filter (fn [e] (not (tuple? e))) (:ok r))))
    (is (= 2 (count (filter tuple? (:ok r)))))))

(deftest op-level-rights-read-yes-write-no
  ; The token holds File read AND write here, so exercise the split with a
  ; read-only token instead.
  (let [ro-token (auth/issue root [["right" "Elixir.File" "read"]])
        e (:ok (auth/sandbox-fork root-pub ro-token (open-ctx) :global))]
    (env/with-env e (fn []
      (is (env/allowed? "Elixir.File"))
      ; File/read's op compiles under the read grant — File/stat runs and
      ; returns {:ok, %File.Stat{}} (a tuple, not a map).
      (is (= :ok (elem (env/eval "(ns cap.ro) (File/stat \"/tmp\")") 0)))
      ; …but File/write is a different op: compile-rejected.
      (is (= :denied
             (try (do (env/eval "(ns cap.ro.w) (File/write \"/tmp/x\" \"y\")") :compiled)
                  (catch _ :denied))))))
    (env/destroy e)))

(deftest sandboxed-env-runs-granted-and-denies-the-rest
  (let [e (:ok (auth/sandbox-fork root-pub ci-token (open-ctx) :global))]
    (env/with-env e (fn []
      ; granted: compiles and RUNS
      (is (= "HI" (env/eval "(ns cap.granted) (String/upcase \"hi\")")))
      (is (env/allowed? "Elixir.File"))
      ; ungranted: rejected at COMPILE time — the bytecode never exists
      (is (not (env/allowed? "Elixir.System")))
      (is (= :denied
             (try (do (env/eval "(ns cap.denied) (System/getenv)") :compiled)
                  (catch _ :denied))))))
    (env/destroy e)))

; ── use case 2: revocation — the kill-switch ──────────────────────────

(deftest revoked-token-never-forks
  (let [oracle (auth/revocation-set (auth/revocation-ids ci-token))
        ctx (auth/context {:policies [(auth/allow [])] :revocation oracle})
        r (auth/caps-for root-pub ci-token ctx)]
    (is (contains? r :error))
    (is (= :deny (:verdict (:error r))))
    (is (= :revoked (:reason (:error r))))))

; ── use case 3: ambient policy overrides the token (deny-overrides) ───
;
; The token GRANTS System; the runtime's policy refuses it for sandboxes
; anyway. A capability says what the bearer may ASK; policy says what the
; runtime ever GRANTS. Deny policies precede allow.

(deftest runtime-policy-overrides-token-grant
  (let [sys-token (auth/issue root [["right" "Elixir.System" "call"]])
        ctx (auth/context
              {:policies [(auth/deny [{:name "right"
                                       :terms ["Elixir.System" {:var 0}]}])
                          (auth/allow [])]})
        r (auth/caps-for root-pub sys-token ctx)]
    (is (contains? r :error))
    (is (= :deny-policy (:reason (:error r))))))

; ── use case 4: sealing freezes the rights ────────────────────────────

(deftest sealed-token-authorizes-but-never-attenuates
  (let [sealed (auth/seal ci-token)]
    (is (contains? (auth/caps-for root-pub sealed (open-ctx)) :ok))
    (is (= :threw
           (try (do (auth/attenuate sealed [["right" "Elixir.System" "call"]])
                    :attenuated)
                (catch _ :threw))))))

; ── use case 5: narrowing is structural below the token too ──────────
;
; A fork inside the sandbox asks for MORE than the token granted —
; Env.fork intersects, so the child holds nothing.

(deftest fork-intersection-is-monotonic-below-the-token
  (let [parent (:ok (auth/sandbox-fork root-pub ci-token (open-ctx) :global))]
    (env/with-env parent (fn []
      (let [child (env/fork (env/current) {:caps ["Elixir.System"]})]
        (env/with-env child (fn []
          (is (not (env/allowed? "Elixir.System")))
          (is (= :denied
                 (try (do (env/eval "(ns cap.sub) (System/getenv)") :compiled)
                      (catch _ :denied))))))
        (env/destroy child))))
    (env/destroy parent)))

; ── use case 6: hostile symbol-table strings fail closed ─────────────
;
; A token asserting rights over modules that don't exist: the names drop
; OUT of the caps set (no atom is interned for them), so the env simply
; cannot call them.

(deftest junk-module-names-never-intern
  (let [t (auth/issue root [["right" "Elixir.NoSuchModule999" "call"]
                            ["right" "Elixir.String" "call"]])
        r (auth/caps-for root-pub t (open-ctx))]
    (is (= [:Elixir.String] (:ok r)))))
