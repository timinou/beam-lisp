(ns bl.doc.dynamic.test
 (:require [bl.doc :as doc] [bl.doc.spans :as sp] [bl.doc.html :as html]))
(def probe :Elixir.BeamLisp.DynamicDocumentLoaderProbe)
(defn loader-source [text]
 (when (not (erlang/function_exported probe :doc_source 2))
  (let [built (BeamLisp.AOT/compile_host_file "priv/host/loader.bl"
              (list (tuple :module probe) (tuple :output_dir "tmp/doc-dynamic-host") (tuple :load? false)))
        path (second built)]
   (code/load_binary probe (erlang/binary_to_list path) (File/read! path))))
 (erlang/apply probe :doc_source (list text :org)))
(def cached "* Live\n#+BEGIN: live :value outstanding-work :view table\n#+begin_src beam-lisp\n(throw :cached-content-executed)\n#+end_src\n#+END:extra\n  #+eNd:  \n#+begin_src beam-lisp :id real\n(def answer 42)\n#+end_src\n")
(deftest inert-roundtrip-and-loader-parity
 (let [d (:ok (doc/slice-text cached :org)) parts (:spans d) dynamic (nth parts 1)]
  (is (= [:prose :dynamic :cell :prose] (mapv :kind parts)))
  (is (= "live" (:name dynamic)))
  (is (= ":value outstanding-work :view table" (:header dynamic)))
  (is (= cached (doc/render-doc d)))
  (is (= 1 (count (doc/cells d))))
  (is (= "(def answer 42)" (doc/cells-source d))))
 (is (= (doc/doc-source cached :org) (loader-source cached)))
 (is (not (includes? (loader-source cached) "throw"))))
(deftest dynamic-partition-is-total-and-open-is-strict
 (let [raw "#+BEGIN: a\ncached\n#+END:\n#+begin: b\nopen" lines (vec (split raw "\n")) parts (sp/spans lines :org)]
  (is (= (vec (range (count lines))) (vec (mapcat (fn [p] (range (:from p) (:to p))) parts))))
  (is (= true (:open? (last parts))))
  (is (some? (:error (doc/slice-text raw :org))))))
(deftest dynamic-looking-lines-in-code-stay-code
 (let [raw "#+begin_src beam-lisp\n; literal\n#+BEGIN: not-a-span\n#+END:\n#+end_src" d (:ok (doc/slice-text raw :org))]
  (is (= [:cell] (mapv :kind (:spans d))))))
(deftest result-writer-preserves-dynamic-body
 (let [d (:ok (doc/slice-text cached :org)) written (doc/write-results d {"real" "42"})]
  (is (includes? written "(throw :cached-content-executed)"))
  (is (= 1 (count (doc/cells (:ok (doc/slice-text written :org))))))))
(deftest renderer-resolves-in-order-and-escapes
 (let [d (:ok (doc/slice-text "#+TITLE: Demo\n#+BEGIN: live :value a\n<script>cache</script>\n#+END:\n#+BEGIN: live :value b\ncache\n#+END:" :org))
       seen (atom []) rendered (html/page d {} {:render-dynamic (fn [s] (swap! seen conj (:header s)) [:p "<live>"])})]
  (is (= [":value a" ":value b"] @seen))
  (is (includes? rendered "&lt;live&gt;"))
  (is (not (includes? rendered "<script>")))
  (is (includes? (html/page d {}) "&lt;script&gt;cache&lt;/script&gt;"))
  (is (= 3 (count (html/body d {}))))))

(deftest literal-container-keeps-all-nested-source-inert
 (let [raw "#+BEGIN_EXAMPLE\n#+begin_src beam-lisp\n(throw :cached-one)\n#+end_src\n#+begin_src beam-lisp\n(throw :cached-two)\n#+end_src\n#+END_EXAMPLE\n#+begin_src beam-lisp\n(def outside 42)\n#+end_src\n"
       document (:ok (doc/slice-text raw :org))]
  (is (= 1 (count (doc/cells document))))
  (is (= "(def outside 42)" (doc/cells-source document)))
  (is (= "(def outside 42)" (loader-source raw)))))
