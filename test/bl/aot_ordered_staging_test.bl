(ns aot-ordered-staging-test)
(defn- fixture [action]
 (let [id (str "orderedstage" (erlang/unique_integer (list :positive)))
       dir (str (System/get_env "HOME") "/tmp/" id) previous (BeamLisp.Env/capture)]
  (File/mkdir_p! dir)
  (try (action dir id)
   (finally (BeamLisp.Env/bind previous) (File/rm_rf! dir)))))
(defn- restricted [action]
 (BeamLisp.Loader/without_initialization (BeamLisp.Env/as_thunk action)))

(deftest ordered-sdk-values-and-unnamed-actions-have-no-effects-until-normal-replay
 (fixture
  (fn [dir ns]
   (let [path (str dir "/effects")
         source (str "(ns " ns ") "
                     "(def value \"first\") "
                     "(File/write! " (pr-str path) " value (list :append)) "
                     "(def value \"second\") "
                     "(File/write! " (pr-str path) " value (list :append)) "
                     "(def after (File/read! " (pr-str path) ")) "
                     "(defn fetch [] [value after])")
         unit (restricted #(BeamLisp.AOT/stage-sdk-unit! source (list)))
         values (Map/get (elem unit 1) ns)]
    (is (= 5 (count values)))
    (is (= ["value" nil "value" nil "after"] (mapv #(elem % 0) values)))
    (is (= false (File/exists? path)))
    (is (= :error (BeamLisp.Env/lookup (tuple ns "value"))))
    (let [beams (BeamLisp.AOT/compile_source source
                 (list (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true)))
          module (BeamLisp.Link/module_for ns)]
     (is (seq beams))
     (is (= false (File/exists? path)))
     (is (= false (BeamLisp.Env/loaded_ns? ns)))
     (erlang/apply module :__bl_init__ (list))
     (is (= "firstsecond" (File/read! path)))
     (is (= ["second" "firstsecond"] (erlang/apply module :fetch (list))))
     (is (= :error (BeamLisp.Env/lookup (tuple ns nil)))))))))

(deftest ordinary-sdk-clause-extension-is-collected-without-registering-before-replay
 (fixture
  (fn [dir ns]
   ;; Test the real fixed SDK defining macro/declaration interaction, not a fake
   ;; binding or proc.reg prewarm. The unique clause is absent before replay.
   (BeamLisp.Loader/ensure_loaded "proc.server")
   (let [key (keyword ns)
         source (str "(ns " ns " (:require [proc.server :as server])) "
                     "(defn transform [_ _] {}) "
                     "(server/extend-clause! " (pr-str key) " transform)")
         lookup (fn [] (contains? @(BeamLisp.Env/fetch_exact! "proc.server" "registry") key))
         beams (BeamLisp.AOT/compile_source source
                 (list (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true)))
         module (BeamLisp.Link/module_for ns)]
    (is (seq beams))
    (is (= false (lookup)))
    (erlang/apply module :__bl_init__ (list))
    (is (= true (lookup)))
    (is (fn? (get @(BeamLisp.Env/fetch_exact! "proc.server" "registry") key)))))))

(deftest loaded-and-pending-arbitrary-action-macros-refuse-before-their-expander-can-run
 (fixture
  (fn [dir id]
   (let [provider (str id "macro") caller (str id "caller") path (str dir "/macro-effect")
         source (str "(ns " provider ") (defmacro dangerous [] (File/write! " (pr-str path) " \"ran\") nil)")]
    (File/write! (str dir "/" provider ".bl") source)
    (BeamLisp.Loader/with_ambient_dirs (list dir) #(BeamLisp.Loader/ensure_loaded provider))
    (is (= :unsupported-sdk-stage-action-macro
          (try
           (BeamLisp.AOT/compile_source
            (str "(ns " caller " (:require [" provider " :as m])) (m/dangerous)")
            (list (tuple :output_dir (str dir "/ebin")) (tuple :stage-sdk? true))) nil
           (catch error (:kind (ex-data error))))))
    (is (= false (File/exists? path)))
    (is (= :sdk-stage-local-macro-not-initialized
          (try (BeamLisp.AOT/compile_source
                (str "(ns " id "local) (defmacro dangerous [] (File/write! " (pr-str path) " \"ran\") nil) (dangerous)")
                (list (tuple :output_dir (str dir "/local")) (tuple :stage-sdk? true))) nil
               (catch error (:kind (ex-data error))))))
    (is (= false (File/exists? path)))))))

(deftest ordinary-clause-extension-uses-definition-owned-registration-from-a-foreign-namespace
 (fixture
  (fn [dir id]
   (BeamLisp.Loader/ensure_loaded "proc.server")
   (let [provider (str id "ordinary") key (keyword provider)
         source (str "(ns " provider " (:require [proc.server :as srv])) "
                     "(defn transform [_ _] {}) (srv/extend-clause! " (pr-str key) " transform)")]
    (File/write! (str dir "/" provider ".bl") source)
    (BeamLisp.Loader/with_ambient_dirs (list dir) #(BeamLisp.Loader/ensure_loaded provider))
    (is (fn? (get @(BeamLisp.Env/fetch_exact! "proc.server" "registry") key)))
    (is (= :error (BeamLisp.Env/lookup (tuple provider "register-clause!"))))
    (BeamLisp.Loader/ensure_loaded "proc.tick")
    (is (fn? (get @(BeamLisp.Env/fetch_exact! "proc.server" "registry") :tick)))))))
