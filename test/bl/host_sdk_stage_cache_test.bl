; Finite cache DATA/native pre-load checks. These synthetic native objects do
; not claim SDK ownership; genuine physical SDK restore is a separate component.
(ns host-sdk-stage-cache-test (:require [ward.core :refer [deftest is]]))
(defn- refused? [action]
  (try (action) false (catch _error true)))
(defn- manifest []
  {:version 2 :modules (list :Elixir.BeamLisp.CacheProbe.Unit)
   :digests {:Elixir.BeamLisp.CacheProbe.Unit (erlang/list_to_binary (to-list (repeat 32 0)))}})
(defn- parse [bytes] (BeamLisp.AOT/sdk_stage_manifest! bytes))

(deftest finite-v2-manifest-keeps-module-identities-as-data
  (let [m (parse (erlang/term_to_binary (manifest)))]
    (is (= 2 (:version m)))
    (is (= (list "Elixir.BeamLisp.CacheProbe.Unit") (:modules m)))
    (is (= (erlang/list_to_binary (to-list (repeat 32 0))) (get (:digests m) "Elixir.BeamLisp.CacheProbe.Unit")))))

(deftest malformed-manifests-refuse-without-general-etf-decoding
  (let [m (manifest) module (first (:modules m))
        malformed (list
          (erlang/term_to_binary m (list :compressed))
          (erlang/term_to_binary (dissoc m :digests))
          (erlang/term_to_binary (assoc m :modules (list module module)))
          (erlang/term_to_binary (assoc m :modules (erlang/++ (list module) :bad-tail)))
          (erlang/term_to_binary (assoc m :modules (list (erlang/make_ref))))
          (erlang/term_to_binary (assoc m :modules (list (fn [] (throw (ex-info "Must never run" {}))))))
          (erlang/term_to_binary {:version 2 :modules (list module) :digests {module "short"}})
          (erlang/term_to_binary {:version 2 :modules (list module) :digests {}})
          (erlang/term_to_binary (assoc m :modules (to-list (repeat 8193 module))))
          (erlang/iolist_to_binary (list (erlang/term_to_binary m) (list 0)))
          (binary/part (erlang/term_to_binary m) 0 15)
          (binary/copy (erlang/list_to_binary (list 0)) 1048577))]
    (doseq [bytes malformed]
      (is (refused? (fn [] (parse bytes)))))))

(deftest new-module-name-is-never-interned-by-manifest-parser
  (let [name "Elixir.BeamLisp.CacheProbe.NeverInternedSource204"
        encoded (fn [s] (erlang/iolist_to_binary (list (list 119 (erlang/byte_size s)) s)))
        bytes (erlang/iolist_to_binary
                (list (list 131 116 0 0 0 3) (encoded "version") (list 97 2)
                      (encoded "modules") (list 108 0 0 0 1) (encoded name) (list 106)
                      (encoded "digests") (list 116 0 0 0 1) (encoded name)
                      (list 109 0 0 0 32) (to-list (repeat 32 0))))
        absent-before (refused? (fn [] (erlang/binary_to_existing_atom name :utf8)))
        value (parse bytes)]
    (is absent-before)
    (is (= (list name) (:modules value)))
    (is (refused? (fn [] (erlang/binary_to_existing_atom name :utf8))))))

(deftest bounded-native-reader-refuses-overflow-before-unbounded-read
  (let [root (Path/join (System/user_home!) "tmp")
        path (Path/join root (str "sdk-stage-cache-read-" (System/unique_integer (list :positive))))
        bytes (erlang/list_to_binary (list 1 2 3 4))]
    (File/mkdir_p! root) (File/write! path bytes)
    (try
      (is (= bytes (BeamLisp.AOT/sdk_cache_read_bounded! path 4)))
      (is (refused? (fn [] (BeamLisp.AOT/sdk_cache_read_bounded! path 3))))
      (is (refused? (fn [] (BeamLisp.AOT/sdk_cache_read_bounded! path 0))))
      (is (refused? (fn [] (BeamLisp.AOT/sdk_cache_read_bounded! (str path "-missing") 4))))
      (finally (File/rm path)))))

(defn- native-object [module on-load? body]
  (let [forms (concat
                (list (tuple :attribute 1 :module module)
                      (tuple :attribute 1 :export (list (tuple :__bl_ns_defs__ 0) (tuple :on_load 0))))
                (if on-load? (list (tuple :attribute 1 :on_load (tuple :on_load 0))) (list))
                (list (tuple :function 1 :__bl_ns_defs__ 0 (list (tuple :clause 1 (list) (list) (list body))))
                      (tuple :function 1 :on_load 0 (list (tuple :clause 1 (list) (list) (list (tuple :atom 1 :ok)))))))
        result (compile/forms (to-list forms) (list :binary :no_spawn_compiler_process))]
    (when-not (= :ok (elem result 0)) (throw (ex-info "Native fixture did not compile" {})))
    (elem result 2)))

(deftest cached-native-on-load-and-executable-definition-tables-refuse-before-load
  (let [on-load :Elixir.BeamLisp.CacheProbe.OnLoad
        executable :Elixir.BeamLisp.CacheProbe.Executable
        body (tuple :map 1 (list))
        effect (tuple :call 1 (tuple :remote 1 (tuple :atom 1 :erlang) (tuple :atom 1 :error))
                            (list (tuple :atom 1 :must-never-execute)))]
    (is (refused? (fn [] (BeamLisp.AOT/sdk_stage_literal_definitions! on-load (native-object on-load true body)))))
    (is (not (erlang/module_loaded on-load)))
    (is (refused? (fn [] (BeamLisp.AOT/sdk_stage_literal_definitions! executable (native-object executable false effect)))))
    (is (not (erlang/module_loaded executable)))))

(deftest actual-literal-definition-table-can-be-read-without-loading-native-object
  (let [module :Elixir.BeamLisp.CacheProbe.Literal
        bytes (native-object module false (tuple :map 1 (list)))]
    (is (= {} (BeamLisp.AOT/sdk_stage_literal_definitions! module bytes)))
    (is (not (erlang/module_loaded module)))))
