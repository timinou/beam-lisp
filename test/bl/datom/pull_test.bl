; test/bl/datom/pull_test.bl — pull, lookup refs, aggregates.
; Run: mix beam_lisp.test test/bl/datom/pull_test.bl
;
; Wave 4 is the surface an application actually touches: reading a SHAPE
; out of the graph, naming an entity by a unique value, and folding a
; result set. The assertions state Datomic's contract.

(ns datom.pull.test
  (:require [datom.conn] [datom.db] [datom.pull] [datom.query.engine]))

(defn- fixture
  "Three people; Alan refers to the other two."
  []
  (let [c (datom.conn/connect
            [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/age :db/valueType :db.type/long}
             {:db/ident :p/email :db/valueType :db.type/string
              :db/unique :db.unique/identity}
             {:db/ident :p/city :db/valueType :db.type/string}
             {:db/ident :p/tag :db/valueType :db.type/keyword
              :db/cardinality :db.cardinality/many}
             {:db/ident :p/friend :db/valueType :db.type/ref
              :db/cardinality :db.cardinality/many}])
        r (datom.conn/transact! c [{:db/id -1 :p/name "Ada" :p/age 36
                                    :p/email "ada@example.com" :p/city "London"
                                    :p/tag :pioneer}
                                   {:db/id -2 :p/name "Grace" :p/age 45
                                    :p/city "New York"}
                                   {:db/id -3 :p/name "Alan" :p/age 41
                                    :p/city "London" :p/friend [-1 -2]}])]
    {:conn c
     :db (datom.conn/db c)
     :ada (get (:tempids r) -1)
     :grace (get (:tempids r) -2)
     :alan (get (:tempids r) -3)}))

;; ── pull ────────────────────────────────────────────────────────────

(deftest pull-reads-the-attributes-the-pattern-names
  (let [f (fixture)]
    (is (= {:db/id (:ada f) :p/name "Ada" :p/age 36}
           (datom.pull/pull (:db f) [:p/name :p/age] (:ada f))))))

(deftest pull-omits-an-attribute-the-entity-lacks
  ; Absent rather than nil-valued: a key present with nil would claim the
  ; entity HAS the attribute and its value is nothing.
  (let [f (fixture)]
    (is (= {:db/id (:grace f) :p/name "Grace"}
           (datom.pull/pull (:db f) [:p/name :p/email] (:grace f))))))

(deftest pull-returns-nil-for-an-entity-with-no-datoms
  ; Distinct from `{}`, which would claim the entity exists but matched
  ; nothing in the pattern.
  (let [f (fixture)]
    (is (nil? (datom.pull/pull (:db f) [:p/name] 999999)))))

(deftest the-wildcard-takes-every-attribute
  (let [f (fixture)
        result (datom.pull/pull (:db f) '[*] (:ada f))]
    (is (= "Ada" (:p/name result)))
    (is (= 36 (:p/age result)))
    (is (= "London" (:p/city result)))
    (is (= [:pioneer] (:p/tag result)))
    (is (= (:ada f) (:db/id result)))))

(deftest a-nested-pattern-follows-references
  ; The reason pull exists: one call for a TREE, rather than one query
  ; per level stitched together by hand.
  (let [f (fixture)
        result (datom.pull/pull (:db f) [:p/name {:p/friend [:p/name]}] (:alan f))]
    (is (= "Alan" (:p/name result)))
    (is (= 2 (count (:p/friend result))))
    (is (= (set ["Ada" "Grace"])
           (set (mapv (fn [m] (:p/name m)) (:p/friend result)))))))

(deftest nesting-composes-to-any-depth
  (let [f (fixture)
        result (datom.pull/pull (:db f)
                                [:p/name {:p/friend [:p/name {:p/friend [:p/name]}]}]
                                (:alan f))]
    ; Ada and Grace have no friends, so the third level is simply absent
    (is (= 2 (count (:p/friend result))))
    (is (every? (fn [m] (nil? (:p/friend m))) (:p/friend result)))))

(deftest a-reverse-reference-navigates-against-the-arrow
  ; `:p/_friend` asks WHICH ENTITIES POINT AT ME — the question VAET
  ; exists to answer. Without that index it means scanning every datom
  ; of the attribute and filtering by value.
  (let [f (fixture)]
    (is (= [(:alan f)]
           (get (datom.pull/pull (:db f) [:p/name :p/_friend] (:ada f)) :p/_friend)))))

(deftest a-reverse-reference-can-be-nested-too
  (let [f (fixture)
        result (datom.pull/pull (:db f) [:p/name {:p/_friend [:p/name]}] (:ada f))]
    (is (= [{:db/id (:alan f) :p/name "Alan"}] (get result :p/_friend)))))

(deftest cardinality-decides-the-shape-not-the-data
  ; A `many` attribute yields a VECTOR even holding one value, so a
  ; consumer never has to test which shape it received.
  (let [f (fixture)
        result (datom.pull/pull (:db f) [:p/tag :p/name] (:ada f))]
    (is (vector? (:p/tag result)) "many -> vector, even with one value")
    (is (= "Ada" (:p/name result)) "one -> the bare value")))

(deftest pull-many-shapes-several-entities
  (let [f (fixture)
        results (datom.pull/pull-many (:db f) [:p/name] [(:ada f) (:grace f)])]
    (is (= 2 (count results)))
    (is (= ["Ada" "Grace"] (mapv (fn [m] (:p/name m)) results)))))

(deftest pull-sees-only-current-facts
  (let [f (fixture)
        c (:conn f)]
    (datom.conn/transact! c [[:db/add (:ada f) :p/age 37]])
    (is (= 37 (:p/age (datom.pull/pull (datom.conn/db c) [:p/age] (:ada f)))))
    (is (= 36 (:p/age (datom.pull/pull (:db f) [:p/age] (:ada f))))
        "and an older db value still sees the older world")))

;; ── lookup refs ─────────────────────────────────────────────────────

(deftest a-lookup-ref-names-an-entity-by-a-unique-value
  ; How you refer to a person without knowing their id.
  (let [f (fixture)]
    (is (= (:ada f) (datom.pull/lookup-ref (:db f) [:p/email "ada@example.com"])))))

(deftest a-lookup-ref-that-matches-nothing-is-nil
  (let [f (fixture)]
    (is (nil? (datom.pull/lookup-ref (:db f) [:p/email "nobody@example.com"])))))

(deftest a-lookup-ref-requires-a-unique-attribute
  ; `find the entity with this value` is only well formed when at most
  ; one entity can have it. Returning an arbitrary match would be a
  ; different, silently wrong answer.
  (let [f (fixture)]
    (is (= :raised (try (do (datom.pull/lookup-ref (:db f) [:p/name "Ada"]) :ran)
                        (catch e :raised))))))

(deftest a-lookup-ref-does-not-resolve-a-retracted-value
  (let [f (fixture)
        c (:conn f)]
    (datom.conn/transact! c [[:db/retract (:ada f) :p/email "ada@example.com"]])
    (is (nil? (datom.pull/lookup-ref (datom.conn/db c) [:p/email "ada@example.com"])))))

(deftest resolve-entity-accepts-both-spellings
  (let [f (fixture)]
    (is (= (:ada f) (datom.pull/resolve-entity (:db f) (:ada f))))
    (is (= (:ada f) (datom.pull/resolve-entity (:db f) [:p/email "ada@example.com"])))))

;; ── aggregates ──────────────────────────────────────────────────────

(defn- q [query db] (datom.query.engine/q query db))

(deftest count-counts-the-result-rows
  (let [f (fixture)]
    (is (= (set [[3]]) (q '[:find (count ?e) :where [?e :p/name _]] (:db f))))))

(deftest sum-min-max-and-avg-fold-a-column
  (let [f (fixture)]
    (is (= (set [[122]]) (q '[:find (sum ?a) :where [?e :p/age ?a]] (:db f))))
    (is (= (set [[36]]) (q '[:find (min ?a) :where [?e :p/age ?a]] (:db f))))
    (is (= (set [[45]]) (q '[:find (max ?a) :where [?e :p/age ?a]] (:db f))))
    (is (= (set [[(/ 122 3)]]) (q '[:find (avg ?a) :where [?e :p/age ?a]] (:db f))))))

(deftest plain-variables-in-find-are-the-grouping-key
  ; No GROUP BY: the grouping and the projection are ONE list, so they
  ; cannot disagree — which is the entire class of SQL's
  ; `column must appear in the GROUP BY clause` error.
  (let [f (fixture)]
    (is (= (set [["London" 2] ["New York" 1]])
           (q '[:find ?c (count ?e) :where [?e :p/city ?c]] (:db f))))))

(deftest grouping-aggregates-over-the-right-rows
  ; THE aggregation hazard: rows are grouped BEFORE projection. Folding
  ; projected tuples instead would collapse the two Londoners into one
  ; row first and report a count of 1.
  (let [f (fixture)]
    (is (= (set [["London" 77] ["New York" 45]])
           (q '[:find ?c (sum ?a) :where [?e :p/city ?c] [?e :p/age ?a]] (:db f))))))

(deftest an-aggregate-with-no-grouping-variable-yields-one-row
  (let [f (fixture)]
    (is (= 1 (count (q '[:find (count ?e) :where [?e :p/name _]] (:db f)))))))

(deftest count-distinct-counts-values-not-rows
  (let [f (fixture)]
    (is (= (set [[2]])
           (q '[:find (count-distinct ?c) :where [?e :p/city ?c]] (:db f)))
        "two distinct cities across three people")))

(deftest an-unknown-aggregate-is-rejected
  (let [f (fixture)]
    (is (= :raised (try (do (q '[:find (bogus ?e) :where [?e :p/name _]] (:db f)) :ran)
                        (catch e :raised))))))

(deftest an-aggregate-over-a-non-variable-is-rejected
  (let [f (fixture)]
    (is (= :raised (try (do (q '[:find (count 42) :where [?e :p/name _]] (:db f)) :ran)
                        (catch e :raised))))))

(deftest a-reverse-ref-works-without-a-namespace
  ; Namespaces are a convention here, not a requirement, so the reverse
  ; spelling must work without one. `forward-attr` unconditionally
  ; inserted a `/`, building `:nil/friend` from `:_friend` \u2014 a keyword no
  ; datom carries, so the pull returned an EMPTY result rather than an
  ; error. Silently wrong, and only for schemas that skipped namespacing.
  (let [c (datom.conn/connect [{:db/ident :name :db/valueType :db.type/string}
                               {:db/ident :friend :db/valueType :db.type/ref}])
        ra (datom.conn/transact! c [{:db/id -1 :name "A"}])
        a (get (:tempids ra) -1)]
    (datom.conn/transact! c [{:db/id -2 :name "B" :friend a}])
    (let [result (datom.pull/pull (datom.conn/db c) [:name {:_friend [:name]}] a)]
      (is (= "A" (:name result)))
      (is (= 1 (count (:_friend result))) "B refers to A and must be found")
      (is (= "B" (:name (first (:_friend result))))))))
