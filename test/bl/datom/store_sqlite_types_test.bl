; test/bl/datom/store_sqlite_types_test.bl — do the SPECIAL value types
; (time and vector) survive the SQLite backend, including a reopen?
;
; Both live ABOVE the six-method store port: an instant is an i64 at rest, a
; DVec is an ordinary datom value the store round-trips through
; term_to_binary. The store never interprets either. This suite proves that
; claim empirically ON the durable backend rather than trusting the layering —
; and, for vector, proves the property the shared conformance suite does not
; cover at all.

(ns datom.store-sqlite.types.test
  (:require [datom] [datom.conn] [datom.db] [datom.time] [datom.vector]
            [datom.store-sqlite] [datom.query.engine :as eng]))

(defn- close? [a b] (erlang/< (erlang/abs (- a b)) 0.001))

;; ── vector: a DVec is a durable datom value ─────────────────────────

(deftest vector-value-round-trips-through-sqlite
  ; The raw store contract: put a DVec, get it back bit-identical. If
  ; term_to_binary did not carry the record faithfully, the packed body would
  ; come back wrong and every later similarity score would be garbage.
  (let [s (datom.store-sqlite/open-fresh)
        dv (datom.vector/embedding [3.0 4.0])]
    (datom.store/-put s "emb" dv)
    (let [back (datom.store/-get s "emb")]
      (is (datom.vector/vec? back) "a DVec survives as a DVec")
      (is (= 2 (datom.vector/dim back)))
      (let [fs (into [] (datom.vector/to-floats back))]
        (is (close? 0.6 (get fs 0)))
        (is (close? 0.8 (get fs 1)))))))

(defn- semantic-conn []
  ; A durable, SQLite-backed connection with a :db.type/vector column.
  (let [c (datom.conn/connect-with
            (datom.store-sqlite/open-fresh)
            [{:db/ident :doc/title :db/valueType :db.type/string}
             {:db/ident :doc/embedding :db/valueType :db.type/vector}])]
    (datom.conn/transact! c
      [{:db/id -1 :doc/title "a" :doc/embedding (datom.vector/embedding [1.0 0.0 0.0])}
       {:db/id -2 :doc/title "b" :doc/embedding (datom.vector/embedding [0.9 0.1 0.0])}
       {:db/id -3 :doc/title "c" :doc/embedding (datom.vector/embedding [0.0 1.0 0.0])}
       {:db/id -4 :doc/title "d" :doc/embedding (datom.vector/embedding [0.0 0.0 1.0])}])
    c))

(deftest similarity-search-works-over-sqlite
  ; End-to-end: a similar-to clause scans the embedding datoms out of the
  ; SQLite store and ranks them. The nearest of a [1 0 0] query must be the
  ; two vectors aligned with that axis ("a" then "b").
  (let [c (semantic-conn)
        q (datom.vector/embedding [1.0 0.0 0.0])
        result (into [] (eng/q '[:find ?title ?score
                                 :in $ ?q
                                 :where [?e :doc/title ?title]
                                        [(similar-to :doc/embedding ?q 2) [?e ?score]]]
                               (datom.conn/db c) q))
        titles (mapv (fn [r] (get r 0)) (sort-by (fn [r] (- (get r 1))) result))]
    (is (= 2 (count result)) "k=2 nearest returned")
    (is (= ["a" "b"] titles) "the axis-aligned vectors rank first, in order")))

(deftest vector-survives-reopen-and-still-searches
  ; The durable payoff: write embeddings, drop the connection, reopen the
  ; SAME store, and similarity search still finds them. This is the property
  ; only a persistent backend can even be asked for.
  (let [path (datom.store/fresh-path ".sqlite")
        c1 (datom.conn/connect-with
             (datom.store-sqlite/open path)
             [{:db/ident :doc/title :db/valueType :db.type/string}
              {:db/ident :doc/embedding :db/valueType :db.type/vector}])
        _ (datom.conn/transact! c1
            [{:db/id -1 :doc/title "x" :doc/embedding (datom.vector/embedding [1.0 0.0])}
             {:db/id -2 :doc/title "y" :doc/embedding (datom.vector/embedding [0.0 1.0])}])
        _ (datom.store-sqlite/sync! (datom.store-sqlite/open path)) ; checkpoint
        ; reopen over the same path, no schema re-declared
        c2 (datom.conn/connect-with (datom.store-sqlite/open path) [])
        q (datom.vector/embedding [1.0 0.0])
        result (into [] (eng/q '[:find ?title ?score
                                 :in $ ?q
                                 :where [?e :doc/title ?title]
                                        [(similar-to :doc/embedding ?q 1) [?e ?score]]]
                               (datom.conn/db c2) q))]
    (is (= 1 (count result)))
    (is (= "x" (get (get result 0) 0))
        "the vector written before the reopen is still searchable after it")))

;; ── time: an instant is a durable, time-travelling value ────────────

(deftest instant-value-round-trips-and-time-travels-over-sqlite
  ; :db.type/instant rides the value-codec LONG lane (i64 millis), and
  ; time-travel is the db layer's basis filter over tx — neither is the
  ; store's concern, so both must work on SQLite exactly as in memory.
  (let [c (datom.conn/connect-with
            (datom.store-sqlite/open-fresh)
            [{:db/ident :e/when :db/valueType :db.type/instant}
             {:db/ident :e/label :db/valueType :db.type/string}])
        t0 (erlang/monotonic_time :millisecond)
        r1 (datom.conn/transact! c [{:db/id -1 :e/label "evt" :e/when t0}])
        e (get (:tempids r1) -1)
        basis (:tx r1)]
    ; the instant round-trips as its i64 self
    (is (= t0 (:e/when (datom.db/entity (datom.conn/db c) e)))
        "an :instant value is recovered exactly")
    ; mutate, then read AS-OF the original basis: the old label is visible
    (datom.conn/transact! c [[:db/add e :e/label "changed"]])
    (is (= "evt" (:e/label (datom.db/entity
                             (datom.time/as-of (datom.conn/db c) basis) e)))
        "time-travel to an earlier basis works on the durable backend")
    (is (= "changed" (:e/label (datom.db/entity (datom.conn/db c) e)))
        "and the current basis sees the new value")))
