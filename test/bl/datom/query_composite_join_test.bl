(ns datom.query.composite-join-test
  (:require [datom :as d] [datom.query.engine :as engine]))

(defn fixture []
  (let [c (d/connect [{:db/ident :join/left :db/valueType :db.type/long :db/cardinality :db.cardinality/many}
                      {:db/ident :join/right :db/valueType :db.type/long :db/cardinality :db.cardinality/many}])]
    (d/transact! c [{:db/id 100 :join/left [1 2 3 4] :join/right [2 4 6]}]) c))

(deftest intersect-many-values-with-a-common-entity
  (let [c (fixture)]
    (try
      (let [db (d/db c)
            clauses '[[?e :join/left ?v] [?e :join/right ?v]]
            rows (engine/run-clauses db [{'?e 100}] clauses nil {})]
        (is (= #{2 4} (set (mapv (fn [r] (get r '?v)) rows))))
        (is (= rows (engine/run-clauses db [{'?e 100}] (vec (reverse clauses)) nil {}))))
      (finally (d/close! c)))))

(deftest multiple-bound-keys-preserve-duplicate-inputs-and-nonmatches
  (let [c (fixture)]
    (try
      (let [db (d/db c)
            rows [{'?e 100 '?v 2} {'?e 100 '?v 2} {'?e 100 '?v 3} {'?e 999 '?v 4}]
            clause '[?e :join/right ?v]
            expected (vec (mapcat (fn [row] (engine/eval-pattern db row clause)) rows))]
        (is (= expected (engine/run-clauses db rows [clause] nil {}))))
      (finally (d/close! c)))))

(deftest a-variable-missing-from-one-row-is-not-a-hash-constraint
  (let [c (fixture)]
    (try
      (let [db (d/db c)
            rows [{'?e 100 '?v 2} {'?e 100}]
            clause '[?e :join/right ?v]
            expected (vec (mapcat (fn [row] (engine/eval-pattern db row clause)) rows))]
        (is (= expected (engine/run-clauses db rows [clause] nil {}))))
      (finally (d/close! c)))))

(deftest composite-keys-follow-language-numeric-equality
  (let [c (fixture)]
    (try
      (let [db (d/db c) rows [{'?e 100 '?v 2.0} {'?e 100 '?v 4.0}]
            clause '[?e :join/right ?v]
            expected (vec (mapcat (fn [row] (engine/eval-pattern db row clause)) rows))]
        (is (= 2 (count expected)))
        (is (= expected (engine/run-clauses db rows [clause] nil {}))))
      (finally (d/close! c)))))

(deftest semantic-keys-support-equal-collection-representations-and-lazy-fallback
  (let [c (d/connect [{:db/ident :join/term :db/valueType :db.type/term
                       :db/cardinality :db.cardinality/many}])]
    (try
      (d/transact! c [{:db/id 100 :join/term [[1 2] [3 4]]}])
      (doseq [value [(list 1 2) (map identity [1 2])]]
        (let [db (d/db c) rows [{'?e 100 '?v value}] clause '[?e :join/term ?v]
              expected (vec (mapcat (fn [row] (engine/eval-pattern db row clause)) rows))]
          (is (= 1 (count expected)))
          (is (= expected (engine/run-clauses db rows [clause] nil {})))))
      (finally (d/close! c)))))

(deftest semantic-key-collisions-do-not-establish-equality
  (let [c (d/connect [{:db/ident :join/term :db/valueType :db.type/term}])]
    (try
      (d/transact! c [{:db/id 100 :join/term 1.0M}])
      (let [db (d/db c) rows [{'?e 100 '?v 1.00M}] clause '[?e :join/term ?v]
            expected (vec (mapcat (fn [row] (engine/eval-pattern db row clause)) rows))]
        (is (= [] expected))
        (is (= expected (engine/run-clauses db rows [clause] nil {}))))
      (finally (d/close! c)))))
