(ns datom.migrate-identity-alias-test (:require [datom :as d] [datom.migrate :as m]))
(def schema [{:db/ident :identity/item :db/valueType :db.type/string}])
(def old (join "" (repeat 64 "a"))) (def stable (join "" (repeat 64 "b"))) (def unknown (join "" (repeat 64 "c")))
(defn spec [id digest] {:migration/id id :migration/digest digest :migration/grows [] :migration/checks []})
(defn stored [db id] (first (first (d/q '[:find ?digest :in $ ?id :where [?e :migration/id ?id] [?e :migration/digest ?digest]] db id))))
(deftest explicit-reviewed-alias-preserves-existing-seal-and-refuses-unknown-identities
 (let [conn (d/connect schema) original (spec :identity/legacy old) replacement (assoc (spec :identity/legacy stable) :migration/legacy-digests #{old})]
  (try
   (is (= :applied (:status (m/apply! conn original))))
   (let [basis (d/basis-t (d/db conn))]
    (is (= :identity-conflict (:status (m/apply! conn (dissoc replacement :migration/legacy-digests)))))
    (is (= :already-applied (:status (m/apply! conn (assoc replacement :migration/fn (fn [_] (throw "Never rerun settled work")))))))
    (is (= :already-applied (:status (m/plan-with conn replacement))))
    (is (= old (stored (d/db conn) :identity/legacy)))
    (is (= basis (d/basis-t (d/db conn))))
    (is (= :identity-conflict (:status (m/apply! conn (assoc replacement :migration/legacy-digests #{unknown}))))))
   (finally (d/close! conn)))))
(deftest fresh-identities-record-only-the-current-digest
 (let [conn (d/connect schema) migration (assoc (spec :identity/fresh stable) :migration/legacy-digests #{old})]
  (try (is (= :applied (:status (m/apply! conn migration))))
   (is (= stable (stored (d/db conn) :identity/fresh)))
   (is (= :identity-conflict (:status (m/apply! conn (spec :identity/fresh old)))))
   (finally (d/close! conn)))))
(deftest malformed-compatibility-is-refused-before-any-write
 (let [conn (d/connect schema) basis (d/basis-t (d/db conn))]
  (try
   (doseq [migration [(assoc (spec :identity/bad stable) :migration/legacy-digests [old])
                     (assoc (spec :identity/bad stable) :migration/legacy-digests #{"bad"})
                     (assoc (spec :identity/bad stable) :migration/legacy-digests nil)
                     (assoc (dissoc (spec :identity/bad stable) :migration/digest) :migration/legacy-digests #{old})
                     (assoc (spec :identity/bad stable) :migration/legacy-digests (set (map (fn [n] (String/downcase (Base/encode16 (crypto/hash :sha256 (str n))))) (range 17))))]]
    (is (= :invalid-migration (try (m/apply! conn migration) nil (catch e (:kind (ex-data e)))))))
   (is (= basis (d/basis-t (d/db conn))))
   (finally (d/close! conn)))))
(deftest reviewed-started-backfill-resumes-without-erasing-the-reservation-seal
 (let [conn (d/connect schema) original (spec :identity/partial old)
       replacement (assoc (spec :identity/partial stable) :migration/legacy-digests #{old})]
  (try
   (is (= :progress (:status (m/step! conn original (fn [_] [[{:db/id -1 :identity/item "retained"}] true])))))
   (let [basis (d/basis-t (d/db conn))]
    (is (= :identity-conflict (:status (m/step! conn (dissoc replacement :migration/legacy-digests) (fn [_] (throw "Cannot run unknown source"))))))
    (is (= basis (d/basis-t (d/db conn)))))
   (is (= :applied (:status (m/step! conn replacement (fn [_] [[] false])))))
   (is (= #{["retained"]} (d/q '[:find ?v :where [_ :identity/item ?v]] (d/db conn))))
   (is (= #{[old]} (d/q '[:find ?digest :where [?e :migration/started-id :identity/partial] [?e :migration/digest ?digest]] (d/db conn))))
   (is (= stable (stored (d/db conn) :identity/partial)))
   (finally (d/close! conn)))))
