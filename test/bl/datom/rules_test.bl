; test/bl/datom/rules_test.bl — user-defined recursive rules.
; Run: mix beam_lisp.test test/bl/datom/rules_test.bl
;
; The properties that make recursion trustworthy:
;   1. transitive closure over a chain (linear recursion)
;   2. TERMINATION on a cyclic graph (bottom-up fixpoint, not top-down loop)
;   3. same-generation (non-linear, doubly-recursive rule)
;   4. naive and semi-naive evaluators return IDENTICAL relations
;   5. a rule composes with ordinary clauses and joins in one query

(ns datom.rules.test
  (:require [datom] [datom.query.rules] [datom.query.engine]))

(defn- chain
  "A directed chain 1->2->...->n as :edge/to ref datoms."
  [n]
  (let [conn (datom/connect
               [{:db/ident :edge/to :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
                {:db/ident :node/name :db/valueType :db.type/string}])]
    (datom/transact! conn
      (into [] (mapv (fn [i]
                       (if (< i (- n 1))
                         {:db/id (- (+ i 1)) :node/name (str (+ i 1)) :edge/to [(- (+ i 2))]}
                         {:db/id (- (+ i 1)) :node/name (str (+ i 1))}))
                     (range n))))
    conn))

(def REACH
  '[[(reachable ?a ?b) [?a :edge/to ?b]]
    [(reachable ?a ?b) [?a :edge/to ?x] (reachable ?x ?b)]])

(defn- node-named [db nm]
  (get (get (into [] (datom/q '[:find ?e :in $ ?n :where [?e :node/name ?n]] db nm)) 0) 0))

;; ── 1. transitive closure ───────────────────────────────────────────

(deftest transitive-closure-over-a-chain
  (let [db (datom/db (chain 5))
        start (node-named db "1")
        reached (set (mapv (fn [r] (get r 0))
                           (into [] (datom/q '[:find ?bn :in $ % ?s
                                               :where [(reachable ?s ?b)] [?b :node/name ?bn]]
                                             db REACH start))))]
    ; 1 reaches 2,3,4,5 (not itself — the chain is acyclic)
    (is (= #{"2" "3" "4" "5"} reached))))

;; ── 2. termination on a cycle ───────────────────────────────────────

(deftest recursion-terminates-on-a-cycle
  ; 1->2->3->1. A top-down expansion would loop forever; the bottom-up
  ; fixpoint cannot, because the derived set is finite and monotone.
  (let [conn (datom/connect
               [{:db/ident :edge/to :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
                {:db/ident :node/name :db/valueType :db.type/string}])]
    (datom/transact! conn
      [{:db/id -1 :node/name "1" :edge/to [-2]}
       {:db/id -2 :node/name "2" :edge/to [-3]}
       {:db/id -3 :node/name "3" :edge/to [-1]}])
    (let [db (datom/db conn)
          start (node-named db "1")
          reached (set (mapv (fn [r] (get r 0))
                             (into [] (datom/q '[:find ?bn :in $ % ?s
                                                 :where [(reachable ?s ?b)] [?b :node/name ?bn]]
                                               db REACH start))))]
      ; every node is reachable from 1, including 1 itself (via the cycle)
      (is (= #{"1" "2" "3"} reached)))))

;; ── 3. same-generation (non-linear recursion) ──────────────────────

(deftest same-generation
  (let [conn (datom/connect
               [{:db/ident :parent/of :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}
                {:db/ident :p/name :db/valueType :db.type/string}])]
    (datom/transact! conn
      [{:db/id -1 :p/name "gp" :parent/of [-2 -3]}
       {:db/id -2 :p/name "a" :parent/of [-4 -5]}
       {:db/id -3 :p/name "b" :parent/of [-6]}
       {:db/id -4 :p/name "c"} {:db/id -5 :p/name "d"} {:db/id -6 :p/name "e"}])
    (let [db (datom/db conn)
          rules '[[(sg ?x ?y) [?p :parent/of ?x] [?p :parent/of ?y]]
                  [(sg ?x ?y) [?px :parent/of ?x] [?py :parent/of ?y] (sg ?px ?py)]]
          c (get (get (into [] (datom/q '[:find ?e :where [?e :p/name "c"]] db)) 0) 0)
          same (set (mapv (fn [r] (get r 0))
                          (into [] (datom/q '[:find ?yn :in $ % ?c
                                              :where [(sg ?c ?y)] [?y :p/name ?yn]]
                                            db rules c))))]
      ; c is same-generation as its siblings c,d AND its cousin e (both are
      ; grandchildren of gp) — the recursive case reaches the cousin.
      (is (contains? same "d"))
      (is (contains? same "e")))))

;; ── 4. naive and semi-naive agree ──────────────────────────────────

(deftest naive-and-semi-naive-derive-the-same-relation
  (let [db (datom/db (chain 12))
        eval-plain (fn [d b clause]
                     (datom.query.engine/eval-clause
                       d b clause
                       (fn [op] (try (BeamLisp.Env/fetch! "core" (name op)) (catch e nil)))
                       {}))
        naive (get (datom.query.rules/materialise-with db REACH eval-plain :naive) 0)
        semi (get (datom.query.rules/materialise-with db REACH eval-plain :semi-naive) 0)]
    (is (= naive semi)
        "the fast evaluator matches the reference on the same input")))

;; ── 5. a rule joins with ordinary clauses ──────────────────────────

(deftest a-rule-composes-with-patterns-and-filters
  ; reachable nodes whose name sorts after "2" — the recursion feeds an
  ; ordinary pattern + predicate, all in one query.
  (let [db (datom/db (chain 5))
        start (node-named db "1")
        r (set (mapv (fn [row] (get row 0))
                     (into [] (datom/q '[:find ?bn :in $ % ?s
                                         :where [(reachable ?s ?b)]
                                                [?b :node/name ?bn]
                                                [(> ?bn "2")]]
                                       db REACH start))))]
    (is (= #{"3" "4" "5"} r))))
