(ns datom.dlit.test
  (:require [datom] [datom.store-ets]))

(deftest d-literal-reads-as-query-vector
  ; #d[...] reads as (datom/read-query [...]) → the validated query vector
  (let [qv #d[:find ?model :where [?e :spend/model ?model]]]
    (is (vector? qv))
    (is (= :find (get qv 0)))))

(deftest d-literal-runs
  (let [store (datom.store-ets/open)
        conn (datom/connect-with store [{:db/ident :spend/model :db/valueType :db.type/string}])
        _ (datom/transact! conn [{:db/id 1 :spend/model "gpt-4o"} {:db/id 2 :spend/model "claude"}])
        db (datom/db conn)]
    (is (= #{["gpt-4o"] ["claude"]}
           (datom/q #d[:find ?model :where [?e :spend/model ?model]] db)))))
