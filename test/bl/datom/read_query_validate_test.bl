(ns datom.read-query-validate.test
  (:require [datom.query.parse] [datom.query.agg]))

(defn- problems [query]
  (let [parsed (datom.query.parse/parse query)]
    (into (datom.query.parse/validate parsed)
          (datom.query.agg/validate-find (:find parsed)))))

(deftest validate-catches-malformed-aggregate
  ; (sum 5) — aggregate over a non-variable — is what read-query rejects.
  (is (seq (problems [:find (list 'sum 5) :where [(quote ?e) :a/x (quote ?v)]]))))

(deftest validate-passes-a-good-query
  (is (empty? (problems [:find (quote ?v) :where [(quote ?e) :a/x (quote ?v)]]))))
