; test/bl/datom/tuple_attrs_test.bl — composite tuple attributes (PLAN-115 B5).
; Run: bl test test/bl/datom/tuple_attrs_test.bl
;
; A `:db.type/tuple` attribute with `:db/tupleAttrs [a b …]` holds a vector of
; its component values, DERIVED by the writer whenever a component changes
; (Datomic's semantics: nil for a missing slot). It exists so a COMPOSITE key
; can be `:db.unique/identity` — kontor keys a posting by `[:posting/tx
; :posting/seq]`, a document type by `[code jurisdiction]`. The properties:
;   1. the tuple value is derived from the components, not asserted,
;   2. two entities with the same composite value collide on the unique tuple,
;   3. a partial entity gets nil in the missing slots.

(ns datom.tuple-attrs.test
  (:require [datom.conn] [datom.db] [datom.query.engine]))

(defn- fresh []
  (datom.conn/connect
    [{:db/ident :posting/tx  :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
     {:db/ident :posting/seq :db/valueType :db.type/long :db/cardinality :db.cardinality/one}
     {:db/ident :posting/key :db/valueType :db.type/tuple
      :db/tupleAttrs [:posting/tx :posting/seq]
      :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}]))

(deftest the-tuple-value-is-derived-from-its-components
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :posting/tx 100 :posting/seq 1}])
    (is (= [100 1] (:posting/key (datom.db/entity (datom.conn/db c) [:posting/key [100 1]])))
        "the writer derived [tx seq] from the two components")))

(deftest a-duplicate-composite-key-is-refused
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :posting/tx 100 :posting/seq 1}])
    (let [refused (try (datom.conn/transact! c [{:db/id -2 :posting/tx 100 :posting/seq 1}])
                       false (catch e true))]
      (is (= true refused) "a second entity with the same [tx seq] collides on the unique tuple"))
    (is (= 1 (count (datom.query.engine/q '[:find ?e :where [?e :posting/key _]] (datom.conn/db c))))
        "the refused entity left no tuple behind")))

(deftest a-distinct-composite-key-commits
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :posting/tx 100 :posting/seq 1}])
    (datom.conn/transact! c [{:db/id -2 :posting/tx 100 :posting/seq 2}])
    (is (= 2 (count (datom.query.engine/q '[:find ?k :where [?e :posting/key ?k]] (datom.conn/db c))))
        "two different [tx seq] pairs are two distinct keys")))

(deftest recomputing-a-tuple-when-a-component-changes
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :posting/tx 100 :posting/seq 1}])
    ; change one component; the tuple must recompute to the new pair
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:posting/key [100 1]]))]
      (datom.conn/transact! c [{:db/id eid :posting/seq 9}])
      (is (= [100 9] (:posting/key (datom.db/entity (datom.conn/db c) eid)))
          "the derived tuple followed the component change")
      (is (nil? (datom.db/entity (datom.conn/db c) [:posting/key [100 1]]))
          "the old tuple value no longer resolves"))))
