(ns datom.migrate-inferred-test
 (:require [datom :as d] [datom.migrate :as m] [datom.conn :as conn] [datom.schema :as schema]))

(def base [{:db/ident :item/id :db/valueType :db.type/string :db/unique :db.unique/identity}
           {:db/ident :item/name :db/valueType :db.type/string}
           {:db/ident :item/roles :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
           {:db/ident :item/value :db/valueType :db.type/term}])
(defn spec [id grows] {:migration/id id :migration/grows grows})
(def unique-name [{:db/ident :item/name :db/valueType :db.type/string :db/unique :db.unique/identity}])

(deftest shared-attribute-checks-preserve-snapshot-and-retraction-semantics
 (let [c (d/connect base)]
  (try
   (d/transact! c [[:db/add 9001 :item/roles :admin]])
   (let [before (d/db c)]
    (d/transact! c [[:db/add 9001 :item/roles :admin] [:db/add 9002 :item/roles :admin]])
    (let [duplicate (d/db c)]
     (d/transact! c [[:db/retract 9002 :item/roles :admin]])
     (is (= [] (m/check-unique before :item/roles)))
     (is (= #{9001 9002} (set (:entities (first (m/check-unique duplicate :item/roles))))))
     (is (= 1 (count (m/check-unique duplicate :item/roles))))
     (is (= [] (m/check-unique (d/db c) :item/roles)))
     (is (= [] (m/check-cardinality-one duplicate :item/roles)))))
   (finally (d/close! c)))))

(deftest uniqueness-is-inferred-and-no-duplicate-is-silently-selected
 (let [c (d/connect base) migration (spec :inferred/unique unique-name)]
  (try
   (d/transact! c [{:db/id -1 :item/id "a" :item/name "duplicate"}
                   {:db/id -2 :item/id "b" :item/name "duplicate"}])
   (is (= :breaking (:status (m/plan (d/db c) migration))))
   (is (= :breaking (:status (m/plan-with c migration))))
   (is (= :blocked (:status (m/apply! c migration))))
   (is (not (m/applied? (d/db c) migration)))
   (is (not (schema/unique? (conn/schema c) :item/name)))
   (is (= 2 (count (d/q '[:find ?e :where [?e :item/name "duplicate"]] (d/db c)))))
   (let [explicit (assoc migration :migration/checks [{:check :unique :attr :item/name}])]
    (is (= 1 (count (:breaking (m/plan-with c explicit))))))
   (finally (d/close! c)))))

(deftest remediation-is-checked-against-the-new-schema
 (let [c (d/connect base)
       migration (assoc (spec :inferred/remediate unique-name) :migration/fn
                    (fn [db] (mapv #(into [] (list :db/add (first %) :item/name "second"))
                               (d/q '[:find ?e :where [?e :item/id "b"]] db))))]
  (try
   (d/transact! c [{:db/id -1 :item/id "a" :item/name "duplicate"}
                   {:db/id -2 :item/id "b" :item/name "duplicate"}])
   (is (= :clean (:status (m/plan-with c migration))))
   (is (= :applied (:status (m/apply! c migration))))
   (is (schema/unique? (conn/schema c) :item/name))
   (is (= :already-applied (:status (m/apply! c migration))))
   (finally (d/close! c)))))

(deftest cardinality-and-type-tightening-need-no-manual-predicates
 (let [c (d/connect base)
       cardinal (spec :inferred/cardinality [{:db/ident :item/roles :db/valueType :db.type/keyword}])
       typed (spec :inferred/type [{:db/ident :item/value :db/valueType :db.type/long}])]
  (try
   (d/transact! c [{:db/id -1 :item/id "a" :item/roles [:admin :user] :item/value "wrong"}])
   (is (= :cardinality-one (:check (first (:breaking (m/plan-with c cardinal))))))
   (is (= :blocked (:status (m/apply! c cardinal))))
   (let [r (m/plan-with c typed)]
    (is (= :breaking (:status r)))
    (is (= :value-type (:check (first (:breaking r)))))
    (is (= :db.type/long (:expected (first (:breaking r))))))
   (is (= :blocked (:status (m/apply! c typed))))
   (is (= :db.type/term (schema/value-type (conn/schema c) :item/value)))
   (finally (d/close! c)))))

(deftest incomplete-backfill-does-not-complete-or-tighten-schema
 (let [c (d/connect base) migration (spec :inferred/batched unique-name)]
  (try
   (d/transact! c [{:db/id -1 :item/id "a" :item/name "same"}
                   {:db/id -2 :item/id "b" :item/name "same"}])
   (is (= :progress (:status (m/step! c migration
                (fn [db] [(mapv #(into [] (list :db/add (first %) :item/value 1))
                            (d/q '[:find ?e :where [?e :item/id "a"]] db)) true])))))
   (is (= :blocked (:status (m/step! c migration (fn [_] [[] false])))))
   (is (not (m/applied? (d/db c) migration)))
   (is (not (schema/unique? (conn/schema c) :item/name)))
   (finally (d/close! c)))))

(deftest invalid-or-unproved-derived-schema-cannot-be-stamped-as-complete
 (let [c (d/connect base)
       invalid (spec :inferred/invalid [{:db/ident :item/name :db/valueType :not-a-type}])
       tuple (spec :inferred/tuple [{:db/ident :item/composite :db/valueType :db.type/tuple
                                    :db/tupleAttrs [:item/id :item/name] :db/unique :db.unique/identity}])]
  (try
   (is (try (m/apply! c invalid) false (catch e (= :invalid-migration (:kind (ex-data e))))))
   (is (not (m/applied? (d/db c) invalid)))
   (is (= :breaking (:status (m/plan-with c tuple))))
   (is (= :prospective-tuple-preview-required (:reason (first (:breaking (m/plan-with c tuple))))))
   (is (= :blocked (:status (m/apply! c tuple))))
   (is (not (m/applied? (d/db c) tuple)))
   (finally (d/close! c)))))
