; test/bl/datom/normalize_test.bl — equality pushdown keeps every answer.
; Run: bin/bl test test/bl/datom/normalize_test.bl
;
; `datom.query.plan/normalize-where` folds `[(= ?v C)]` into the one pattern
; that binds ?v. Two things must hold, and this file proves both:
;
;   1. SAME ANSWERS. For EVERY query in a finite family (each shape × each
;      constant × each attribute, including the shapes the rewrite must refuse)
;      over a database holding every value in play, the planner's answer equals
;      the answer with no rewrite at all. The family is enumerated, not sampled,
;      so over this domain it is a proof by exhaustion, not a lucky run.
;   2. FEWER ROWS. On an indexed attribute the rewritten query reads the
;      constant's AVET prefix, not the column: the store hands back the
;      matching datoms only.

(ns datom.normalize.test
  (:require [datom.conn] [datom.db] [datom.store] [datom.store-ets]
            [datom.query.engine] [datom.query.plan] [datom.query.parse]))

(def ^:private SCHEMA
  [{:db/ident :j/state :db/valueType :db.type/keyword :db/index true}
   {:db/ident :j/firm  :db/valueType :db.type/ref :db/index true}
   {:db/ident :j/n     :db/valueType :db.type/long}
   {:db/ident :j/tag   :db/valueType :db.type/string}])

(def ^:private STATES [:queued :failed :published :awaiting])

(defn- world
  "Two firms, 24 jobs cycling through every state, n and tag; firm entities
   are refs. Small enough to answer every query in the family, wide enough
   that every constant has 0, 1 or many matches."
  []
  (let [c (datom.conn/connect-with (datom.store-ets/open) SCHEMA)]
    (datom.conn/transact! c [{:db/id -1 :j/tag "firm-a"} {:db/id -2 :j/tag "firm-b"}])
    (datom.conn/transact!
      c
      (mapv (fn [i] {:db/id (- -10 i)
                     :j/state (get STATES (mod i 3))      ; :awaiting never used
                     :j/firm (if (even? i) 1 2)
                     :j/n (mod i 5)
                     :j/tag (str "t" (mod i 4))})
            (range 24)))
    c))

(def ^:private SHAPES
  "Query builders over (attr, constant). Each shape is either one the rewrite
   TAKES, or one it must LEAVE (the comment says which and why)."
  [;; takes: the canonical form
   (fn [a c] [:find '?j :where ['?j a '?v] [(list '= '?v c)]])
   ;; takes: constant first
   (fn [a c] [:find '?j :where ['?j a '?v] [(list '= c '?v)]])
   ;; takes: with a join on the entity
   (fn [a c] [:find '?j '?t :where ['?j :j/tag '?t] ['?j a '?v] [(list '= '?v c)]])
   ;; LEAVES: ?v is a :find variable (removing it changes the result shape)
   (fn [a c] [:find '?j '?v :where ['?j a '?v] [(list '= '?v c)]])
   ;; LEAVES: ?v read by another predicate
   (fn [a c] [:find '?j :where ['?j a '?v] [(list '= '?v c)] [(list 'some? '?v)]])
   ;; LEAVES: ?v bound by two patterns (a join on the value)
   (fn [a c] [:find '?j :where ['?j a '?v] ['?k a '?v] [(list '= '?v c)]])
   ;; LEAVES: ?v in the ENTITY slot, not the value slot
   (fn [a c] [:find '?x :where ['?v :j/tag '?x] [(list '= '?v c)]])])


(def ^:private CASES
  "attribute × constants: every constant has 0, 1+ or many matches, and some
   are the wrong TYPE for the attribute (equality must still agree)."
  [[:j/state [:queued :failed :awaiting :nope "queued" 3]]
   [:j/n [0 1 4 9 "1" :queued]]
   [:j/tag ["t0" "t3" "zz" :t0 0]]
   [:j/firm [1 2 99]]])

(defn- where-at [query]
  (loop [i 0] (if (= :where (get query i)) i (recur (+ i 1)))))

(defn- reference
  "The SAME question with the rewrite blocked: ?v is added to :find (a
   protected variable is never folded), then projected away. It shares no
   code with the rewrite — the engine answers the predicate as a filter — so
   agreement is evidence about the rewrite, not about itself."
  [query]
  (let [find-end (where-at query)
        finds (subvec query 1 find-end)]
    [(into (into [:find] (conj finds '?v)) (subvec query find-end)) (count finds)]))

(defn- both
  "[answer-with-rewrite reference-answer] for one query."
  [db query]
  (let [with (datom.query.engine/q query db)
        [rq n] (reference query)
        raw (if (some (fn [x] (= x '?v)) (subvec query 1 (where-at query)))
              (datom.query.engine/q query db)        ; already protected: no rewrite either way
              (into #{} (map (fn [row] (subvec (vec row) 0 n)) (datom.query.engine/q rq db))))]
    [with raw]))

(deftest every-query-in-the-family-answers-the-same
  (let [db (datom.conn/db (world))
        checked (atom 0)]
    (doseq [[a cs] CASES
            c cs
            shape SHAPES]
      (let [query (shape a c)
            [with raw] (both db query)]
        (swap! checked inc)
        (is (= raw with)
            (str "rewrite changed the answer of " (pr-str query)
                 ": " (count raw) " rows → " (count with)))))
    (is (= (* (count SHAPES) (reduce + 0 (map (fn [x] (count (second x))) CASES)))
           @checked)
        "the whole family was enumerated")))

(deftest the-rewrite-takes-exactly-the-safe-shapes
  (let [p (fn [q] (:where (datom.query.plan/plan (datom.query.parse/parse q))))]
    (is (= [['?j :j/state :queued]]
           (p '[:find ?j :where [?j :j/state ?v] [(= ?v :queued)]])))
    (is (= [['?j :j/state :queued]]
           (p '[:find ?j :where [?j :j/state ?v] [(= :queued ?v)]])))
    (is (= 2 (count (p '[:find ?j ?v :where [?j :j/state ?v] [(= ?v :queued)]])))
        ":find ?v keeps its predicate")
    (is (= 3 (count (p '[:find ?j :where [?j :j/state ?v] [(= ?v :queued)] [(some? ?v)]])))
        "a second reader keeps it")
    (is (= 2 (count (p '[:find ?j :in $ ?v :where [?j :j/state ?v] [(= ?v :queued)]])))
        "an :in variable keeps it")
    (is (= 2 (count (p '[:find ?j :where [?j :j/state ?v] [(= ?v ?w)]])))
        "a variable on both sides is not a constant")
    (is (= 2 (count (p '[:find ?j :where [?j :j/state ?v] [(= ?v [:a])]])))
        "a collection constant is not taken")))

(deftest an-indexed-constant-reads-its-prefix-not-the-column
  (let [c (world)
        db (datom.conn/db c)
        rows (atom 0)
        q '[:find ?j :where [?j :j/firm ?f] [?j :j/state ?st] [(= ?st :failed)]]
        ;; :failed is every third job: 8 of 24
        answer (datom.query.engine/q q db)
        trace (second (datom.query.engine/with-trace (fn [] (datom.query.engine/q q db))))
        state-step (first (filter (fn [s] (= :j/state (get (:clause s) 1))) trace))]
    (is (= 8 (count answer)))
    (is (= :avet (:index state-step)) "the state clause reads AVET by its constant")
    (is (= 8 (:candidates state-step))
        (str "only the matching datoms come back, not the column: "
             (:candidates state-step)))))
