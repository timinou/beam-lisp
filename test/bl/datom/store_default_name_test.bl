(ns datom.store-default-name-test
 (:require [datom :as d] [datom.store-ets :as ets-store]
           [datom.blob-ets :as blob-ets] [datom.store :as store]))
(defn- open-close! [] (let [c (d/connect)] (d/close! c)))
(deftest fixed-diagnostic-names-have-distinct-native-lifetimes
 (let [a (ets-store/open) b (ets-store/open) x (blob-ets/open) y (blob-ets/open)]
  (try
   (is (= :datom_store (ets/info (:table a) :name)))
   (is (= :datom_store (ets/info (:table b) :name)))
   (is (not= (:table a) (:table b)))
   (is (= :datom_blobs (ets/info (:table x) :name)))
   (is (= :datom_blobs (ets/info (:table y) :name)))
   (is (not= (:table x) (:table y)))
   (finally (ets-store/close a) (ets-store/close b) (store/close x) (store/close y)))))
(deftest warmed-default-connection-open-close-does-not-intern-table-names
 ;; Warm the actual writer/Store/BlobStore/SDK routes before measuring atoms.
 ;; This is a resource-growth regression, not a timing or throughput benchmark.
 (dotimes [_ 16] (open-close!))
 (let [before (erlang/system_info :atom_count)]
  (dotimes [_ 128] (open-close!))
  (is (= before (erlang/system_info :atom_count)))))
