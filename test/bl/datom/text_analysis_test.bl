(ns datom.text-analysis-test (:require [datom.text :as text]))
(deftest single-pass-analysis-preserves-terms
  (doseq [s ["" "a" "ab" "abc" "abc abc" "a\u0000b\u0000c" "Liberté LIBERTÉ" "الحُرّيـة،合同条款。日本語" "foo-bar 123" (String/duplicate "x" 100) (String/duplicate "é" 33)]]
    (is (= (text/index-terms-original s) (text/index-terms-fused s)))))
