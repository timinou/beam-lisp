; test/bl/datom/reaches_relation_test.bl — reaches as a first-class relation.
; Run: mix beam_lisp.test test/bl/datom/reaches_relation_test.bl
;
; The unification: the transitive closure of the call graph is ONE relation,
; :~reaches, registered as a defrelation. Its access modes ARE the three
; questions people ask of a call graph:
;
;   [?a :~reaches ?b] with ?a bound → reachable(a)   (forward :bf — what a needs)
;   [?a :~reaches ?b] with ?b bound → impact(b)       (reverse :fb — what breaks)
;   [?a :~reaches ?b] both bound     → reaches?(a,b)  (probe  :bb)
;
; So `reachable` and `impact` are not two functions with two closure computations
; — they are two adornments of one relation. This suite is the oracle for that:
; each mode returns the right cone on a disconnected graph (the discriminating
; case), and the relation composes inside an ordinary query.

(ns datom.reaches-relation.test
  (:require [codebase :as cb] [datom :as d]
            [datom.query.relation :as rel]))

;; ── a call graph with two disconnected components ───────────────────
;; a -> b -> c   and   x -> y   (y unreachable from a; c unreachable from x)

(defn- world []
  (let [conn (cb/connect-codebase)]
    (d/transact! conn [{:db/id -1 :call/caller "a" :call/callee "b"}
                       {:db/id -2 :call/caller "b" :call/callee "c"}
                       {:db/id -3 :call/caller "x" :call/callee "y"}])
    conn))

(defn- svec [xs] (into [] (sort (into [] xs))))

;; ── 1. the relation is registered and self-describes ────────────────

(deftest reaches-is-a-registered-relation
  (cb/register-reaches!)
  (is (rel/computed? :~reaches) ":~reaches is a computed relation")
  (let [spec (rel/relation :~reaches)]
    (is (contains? (get spec :modes) :bf) "supports forward mode")
    (is (contains? (get spec :modes) :fb) "supports reverse mode")
    (is (contains? (get spec :modes) :bb) "supports probe mode")))

;; ── 2. forward mode = reachable ─────────────────────────────────────

(deftest forward-mode-is-reachable
  (cb/register-reaches!)
  (let [db (d/db (world))
        fwd (fn [a] (svec (mapv first
                     (into [] (d/q '[:find ?b :in $ ?a :where [?a :~reaches ?b]] db a)))))]
    (is (= ["b" "c"] (fwd "a")) "reachable(a) = a's cone {b c}, not y")
    (is (= ["y"] (fwd "x")) "reachable(x) = {y}")
    (is (= [] (fwd "c")) "reachable(c) = {} (sink)")))

;; ── 3. reverse mode = impact ────────────────────────────────────────

(deftest reverse-mode-is-impact
  (cb/register-reaches!)
  (let [db (d/db (world))
        rev (fn [b] (svec (mapv first
                     (into [] (d/q '[:find ?a :in $ ?b :where [?a :~reaches ?b]] db b)))))]
    (is (= ["a" "b"] (rev "c")) "impact(c) = {a b}, not x")
    (is (= ["x"] (rev "y")) "impact(y) = {x}")
    (is (= [] (rev "a")) "impact(a) = {} (root)")))

;; ── 4. the codebase helpers delegate to the relation ────────────────

(deftest reachable-and-impact-delegate-to-the-relation
  (let [db (d/db (world))]
    (is (= ["b" "c"] (svec (mapv (fn [r] (get r 0)) (cb/reachable db "a"))))
        "cb/reachable(a) == forward mode")
    (is (= ["a" "b"] (svec (mapv (fn [r] (get r 0)) (cb/impact db "c"))))
        "cb/impact(c) == reverse mode")))

;; ── 5. composition: the relation joins with ordinary clauses ────────
;; "which callees of a's cone are also reached by x?" (intersection = none here)

(deftest reaches-composes-in-a-query
  (cb/register-reaches!)
  (let [db (d/db (world))
        both (into [] (d/q '[:find ?n :in $ ?a ?x
                             :where [?a :~reaches ?n] [?x :~reaches ?n]]
                           db "a" "x"))]
    (is (= [] (into [] both)) "no node is reached by both a and x (disjoint components)")))
