(ns datom.checkpoint-test
 (:require [datom.store :as s] [datom.store-fjall :as fj] [datom.store-map :as sm]
           [datom.profile :as profile] [datom :as d]))
(defn failed? [f] (try (f) false (catch _ true)))
(defn drain [artifact opts]
 (loop [] (when-not (:done? (s/checkpoint-step! artifact opts)) (recur))))

(deftest tracked-checkpoint-copies-exact-captured-view-while-source-keeps-changing
 (let [source (fj/open-fresh) destination (s/fresh-path ".checkpoint")]
  (doseq [i (range 12)] (s/-put source (str "key-" i) {:value i}))
  (let [original (vec (s/-range source nil nil))
        cursor (s/capture-checkpoint! (profile/watch source))
        artifact (s/begin-checkpoint! cursor destination)]
   (try
    (is (s/checkpoint-capable? source))
    (is (s/checkpoint-capable? (profile/watch source)))
    (is (not (File/exists? destination)))
    (s/-put source "key-0" :changed) (s/-delete source "key-1") (s/-put source "later" :inserted)
    (let [first (s/checkpoint-step! artifact {:chunk-size 2 :max-chunk-bytes 512})]
     (is (= 2 (:copied first))) (is (<= (:bytes first) 512)) (is (not (:done? first))))
    (s/release-checkpoint! cursor)
    (is (failed? #(s/begin-checkpoint! cursor (s/fresh-path ".refused"))))
    (drain artifact {:chunk-size 2 :max-chunk-bytes 512})
    (let [receipt (s/finish-checkpoint! artifact) restored (fj/open destination)]
     (is (= :stable (:durability receipt))) (is (= :logical (:kind receipt)))
     (is (= 12 (:entries receipt))) (is (= (:path source) (:source receipt)))
     (is (= original (vec (s/-range restored nil nil))))
     (is (= receipt (s/finish-checkpoint! artifact))))
    (finally (s/release-checkpoint! cursor) (s/abort-checkpoint! artifact))))))

(deftest native-checkpoint-preserves-complete-datom-indexes-and-basis
 (let [source (fj/open-fresh)
       c (d/connect-with source [{:db/ident :checkpoint/key :db/valueType :db.type/string :db/unique :db.unique/identity}])
       destination (s/fresh-path ".checkpoint")]
  (d/transact! c [{:db/id -1 :checkpoint/key "before"}])
  (let [basis (d/basis-t (d/db c)) cursor (s/capture-checkpoint! source)
        artifact (s/begin-checkpoint! cursor destination)]
   (try
    (d/transact! c [{:db/id -1 :checkpoint/key "after"}])
    (drain artifact {:chunk-size 4 :max-chunk-bytes 4096})
    (s/finish-checkpoint! artifact)
    (let [restored (d/connect-with (fj/open destination) [])]
     (is (= #{["before"]} (d/q '[:find ?key :where [_ :checkpoint/key ?key]] (d/db restored))))
     (is (= basis (d/basis-t (d/db restored))))
     (d/transact! restored [{:db/id -1 :checkpoint/key "restored-writes"}])
     (is (= 2 (count (d/q '[:find ?key :where [_ :checkpoint/key ?key]] (d/db restored))))))
    (finally (s/release-checkpoint! cursor) (s/abort-checkpoint! artifact))))))

(deftest checkpoint-refuses-clobber-and-incomplete-publication
 (let [source (fj/open-fresh) destination (s/fresh-path ".checkpoint")
       cursor (s/capture-checkpoint! source) artifact (s/begin-checkpoint! cursor destination)]
  (try
   (is (failed? #(s/finish-checkpoint! artifact)))
   (is (not (File/exists? destination)))
   (drain artifact {})
   (File/mkdir_p! destination)
   (File/write! (str destination "/sentinel") "owned")
   (is (failed? #(s/finish-checkpoint! artifact)))
   (is (= :aborted (s/abort-checkpoint! artifact)))
   (is (= "owned" (File/read! (str destination "/sentinel"))))
   (is (failed? #(s/begin-checkpoint! cursor destination)))
   (is (failed? #(s/begin-checkpoint! cursor (str (:path source) "/nested"))))
   (finally (s/release-checkpoint! cursor) (s/abort-checkpoint! artifact)))))

(deftest checkpoint-bounds-and-cancellation-are-explicit
 (let [source (fj/open-fresh) destination (s/fresh-path ".checkpoint")]
  (s/-put source "large" (String/duplicate "x" 256))
  (let [cursor (s/capture-checkpoint! source) artifact (s/begin-checkpoint! cursor destination)]
   (try
    (is (failed? #(s/checkpoint-step! artifact {:chunk-size 1 :max-chunk-bytes 2})))
    (is (= 1 (:copied (s/checkpoint-step! artifact {:chunk-size 1 :max-chunk-bytes 1024}))))
    (is (failed? #(s/checkpoint-step! artifact {:chunk-size 0})))
    (finally (s/abort-checkpoint! artifact) (s/release-checkpoint! cursor))))
  (is (= :checkpoint-cancelled
        (try (s/checkpoint! source destination {:cancel? (fn [] true)}) nil
         (catch e (:kind (ex-data e))))))
  (is (not (File/exists? destination)))
  (is (not (s/checkpoint-capable? (sm/open))))
  (is (= :checkpoint-unavailable
         (try (s/capture-checkpoint! (sm/open)) nil (catch e (:kind (ex-data e))))))))

(deftest accepted-native-finalization-outlives-submitter-and-uses-exact-reply-tag
 (let [source (fj/open-fresh) destination (s/fresh-path ".checkpoint-thread")
       cursor (s/capture-checkpoint! source) artifact (s/begin-checkpoint! cursor destination)
       parent (erlang/self) tag (erlang/make_ref) unrelated (erlang/make_ref)]
  (try
   (drain artifact {})
   (erlang/send parent [unrelated :unrelated-message])
   (let [p (erlang/spawn (fn []
                         (erlang/send parent [:submitted (fj/fjall-checkpoint-finish (:handle artifact) parent tag)])))]
    (receive [:submitted accepted] (is (= :accepted accepted)) (after 5000 (is false)))
    (receive [reply-tag value] :when (= reply-tag tag)
             (is (= destination (elem value 0))) (after 10000 (is false)))
    (loop [n 0] (when (and (Process/alive? p) (< n 100)) (Process/sleep 1) (recur (inc n))))
    (is (not (Process/alive? p)))
    (receive [reply-tag value] :when (= reply-tag unrelated) (is (= :unrelated-message value))
             (after 1000 (is false)))
    (is (= :stable (:durability (s/finish-checkpoint! artifact)))))
   (finally (s/release-checkpoint! cursor) (s/abort-checkpoint! artifact)))))
