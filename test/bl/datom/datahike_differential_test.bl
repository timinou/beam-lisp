; test/bl/datom/datahike_differential_test.bl — the datahike↔datom oracle.
; Run: bl test test/bl/datom/datahike_differential_test.bl
;
; ── What this proves ──────────────────────────────────────────────────
;
; PLAN-115's whole claim: the datahike surface is a PROJECTION of datom's
; single engine, not a second engine. This suite is how we keep that claim
; honest, feature by feature, with the JVM as the oracle.
;
;   test/oracle/datahike/corpus.edn     — scenarios in datahike's spelling,
;                                          the ONE source of truth
;   test/oracle/datahike/run_jvm.clj    — runs them on published datahike,
;                                          freezes typed answers into
;   test/oracle/datahike/expected.edn   — committed, so this gate needs no JVM
;
; This file replays the IDENTICAL corpus through datom and asserts each read's
; answer equals the JVM's, under one engine-neutral encoding (decimals as
; {:dec "…"}, result-sets sorted, refs as {:db/id N}, entity :db/id dropped).
;
; A scenario carries :status — :ready (must pass now) or :pending (waits on a
; wave's datom feature). Only :ready scenarios are asserted; :pending ones are
; reported so a wave flipping :ready needs no harness edit, only the corpus.
;
; In W0 the datom driver below is a DIRECT, documented translation of the
; datahike call onto datom's API (q arg-order, report key rename). From W1 the
; real `datahike.api` shim REPLACES this driver — at which point this test runs
; the shim, not a hand-translation, and the translation here is deleted.

(ns datom.datahike-differential.test
  (:require [datom.conn] [datom.db] [datom.query.engine] [datom.pull]
           [clojure.edn :as edn]))

(def corpus-path "test/oracle/datahike/corpus.edn")
(def expected-path "test/oracle/datahike/expected.edn")

(defn- slurp-edn [path]
  (edn/read-string (elem (File/read path) 1)))

;; ── engine-neutral encoding (must mirror run_jvm.clj/enc) ─────────────────

(defn- decimal? [v] (erlang/is_map_key :__struct__ (if (map? v) v {})))

(defn- enc [v]
  (cond
    (and (map? v) (= (:__struct__ v) :Elixir.BeamLisp.Decimal))
      {:dec (decimal/plain-str v)}
    (map? v)
      (into (sorted-map) (map (fn [kv] [(first kv) (enc (second kv))]) v))
    (set? v)
      (into [] (sort-by pr-str (map enc v)))
    (sequential? v)
      (into [] (map enc v))
    :else v))

(defn- sorted-tuples [result]
  (into [] (sort-by pr-str (map (fn [t] (into [] (map enc t))) result))))

;; ── the datom driver (W0: a hand-translation; W1+: the datahike.api shim) ──

(defn- build-conn [schema txes]
  (let [c (datom.conn/connect (into [] schema))]
    (reduce (fn [_ tx] (datom.conn/transact! c (into [] tx))) nil txes)
    c))

(defn- run-read [c rd]
  (let [db (datom.conn/db c)
        kind (:kind rd)]
    (cond
      (= kind :q)
        (let [r (datom.query.engine/q (:query rd) db)]
          (if (set? r) (sorted-tuples r)
            (if (sequential? r) (into [] (sort-by pr-str (map enc r)))
              (enc r))))
      (= kind :pull)
        (enc (datom.pull/pull db (:pattern rd) (:eid rd)))
      (= kind :entity)
        (enc (into (sorted-map) (dissoc (datom.db/entity db (:eid rd)) :db/id)))
      :else {:error true :msg (str "unknown read kind " kind)})))

(defn- run-scenario [sc]
  (let [c (build-conn (:schema sc) (:txes sc))]
    (into (sorted-map)
          (map (fn [rd]
                 [(:id rd)
                  (try (run-read c rd)
                       (catch e {:error true :msg (str e)}))])
               (:reads sc)))))

;; ── the differential ──────────────────────────────────────────────────────

(def corpus (slurp-edn corpus-path))
(def expected (:answers (slurp-edn expected-path)))

(deftest ready-scenarios-match-the-jvm
  (reduce
    (fn [_ sc]
      (when (= :ready (:status sc))
        (let [name (:name sc)
              want (get expected name)
              got (run-scenario sc)]
          (is (= want got)
              (str name ": datom diverges from datahike\n"
                   "  JVM: " (pr-str want) "\n"
                   "  bl:  " (pr-str got))))))
    nil
    (:scenarios corpus)))
