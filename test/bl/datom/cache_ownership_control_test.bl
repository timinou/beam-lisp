(ns datom.cache-ownership-control-test
 (:require [datom :as d] [datom.store :as store] [datom.store-map :as memory]
           [datom.store-fjall :as fjall] [datom.attr-basis :as marks]
           [datom.query.corpus :as corpus] [datom.vector :as vector]
           [data.bounded-cache :as cache] [env]))
(def SCHEMA [{:db/ident :vec :db/valueType :db.type/vector}])
(defn populate [c]
 (d/transact! c [{:db/id -1 :vec (vector/embedding [1.0 0.0])}])
 (corpus/column (d/db c) :vec))

(defn locked? [path]
 (let [script (str "import os,sys,fcntl\n"
                   "fd=os.open(sys.argv[1],os.O_RDONLY)\n"
                   "try:\n fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)\n"
                   "except BlockingIOError:\n sys.exit(73)\n")
       result (System/cmd "python3" (to-list ["-c" script path])
                          (list (tuple :stderr_to_stdout true)))
       status (elem result 1)]
  (when (not (contains? #{0 73} status)) (throw {:probe-failed result}))
  (= 73 status)))

(deftest a-live-raw-store-key-keeps-the-native-directory-lock
 ;; A private parent-owned ETS table models the old raw cache key without
 ;; replacing production code or changing another namespace's global shim.
 (let [table (ets/new :raw_store_control (list :set :public))
       token (env/capture) parent (erlang/self)
       path (store/fresh-path ".cache-ownership-control")
       child (erlang/spawn
              (fn []
               (env/bind token)
               (try
                (let [s (fjall/open path) c (d/connect-with s SCHEMA)]
                 (try
                  (populate c)
                  (ets/insert table (tuple (tuple s :vec) :retained-key))
                  (finally (d/release! c) (store/close s))))
                (erlang/send parent [:raw-key-control :released])
                (catch e (println "raw-key-control-child-error" e)
                         (erlang/send parent [:raw-key-control :failed])))))
       monitor (erlang/monitor :process child)]
  (try
   (is (= :released (receive [:raw-key-control result] result (after 10000 :timeout))))
   (is (= :normal (receive [:DOWN ref :process pid why] why (after 10000 :timeout))))
   (is (= 1 (ets/info table :size)))
   (erlang/garbage_collect)
   (let [held (locked? path)]
    (is held "an external process observes the lock held by a raw ETS key")
    (println "native-cache-negative-control"
             {:child-dead (not (Process/alive? child)) :native-lock-held held}))
   (finally
    (when (Process/alive? child) (Process/exit child :kill))
    (erlang/demonitor monitor (list :flush))
    (ets/delete table)
    (File/rm_rf! path) (File/rm_rf! (str path ".blobs"))))))
