(ns datom.index-coverage-test
  (:require [datom] [datom.conn :as conn] [datom.db :as db] [datom.time :as time]
            [datom.index :as index] [datom.schema :as schema] [datom.index-coverage :as coverage]
            [datom.store :as store] [datom.store-ets :as ets] [datom.store-fjall :as fjall]
            [datom.query.page :as page]))

(def components [{:db/ident :p/firm :db/valueType :db.type/long}
                 {:db/ident :p/at :db/valueType :db.type/long :db/index true}])
(def composite {:db/ident :p/order :db/valueType :db.type/tuple :db/tupleAttrs [:p/firm :p/at] :db/index true})

(deftest installing-tuple-derives-existing-current-entities-atomically
  (doseq [s [(ets/open) (fjall/open-fresh)]]
    (let [c (conn/connect-with s components)
          r (datom/transact! c [{:db/id -1 :p/firm 7 :p/at 11}])
          e (get (:tempids r) -1) old (:db-after r)]
      (datom/transact! c [[:db/add e :p/at 12]])
      (conn/install-schema! c [composite])
      (is (= [7 12] (:p/order (db/entity (conn/db c) e))))
      (is (= 1 (count (db/datoms (conn/db c) :avet :p/order))))
      (is (coverage/complete? s (conn/schema c) :p/order (db/basis-t (conn/db c))))
      (is (= [] (db/datoms old :eavt e :p/order)))
      (let [basis (db/basis-t (conn/db c))]
        (conn/install-schema! c [composite])
        (is (= 1 (count (db/datoms (conn/db c) :avet :p/order))))))))

(deftest reopen-repairs-durable-schema-with-missing-index-coverage
  (let [s (fjall/open-fresh) path (:path s)
        c (conn/connect-with s [{:db/ident :p/at :db/valueType :db.type/long}])
        r (datom/transact! c [{:db/id -1 :p/at 11}])
        e (get (:tempids r) -1)]
    (datom/transact! c [[:db/add e :p/at 12]])
    ;; Simulate migration's durable schema commit followed by process loss
    ;; before sync-schema!, the actual previously uncovered recovery window.
    (datom/transact! c [{:db/id -2 :db/ident :p/at :db/valueType :db.type/long :db/index true}])
    (is (= [] (db/datoms (conn/db c) :avet :p/at)))
    (datom/close! c)
    (let [reopened (fjall/open path) c2 (conn/connect-with reopened [])
          now (conn/db c2) old (time/as-of now (:tx r))]
      (is (= [12] (mapv index/-v (db/datoms now :avet :p/at))))
      (is (= [11] (mapv index/-v (db/datoms old :avet :p/at))))
      (is (coverage/complete? reopened (conn/schema c2) :p/at (db/basis-t now)))
      (datom/close! c2))))

(deftest interrupted-checkpoint-restarts-after-source-basis-changes
  (let [s (ets/open) c (conn/connect-with s [{:db/ident :p/at :db/valueType :db.type/long}])]
    (datom/transact! c [{:db/id -1 :p/at 1}])
    (let [after (schema/install-all (conn/schema c) [(second components)])
          basis (db/basis-t (conn/db c))]
      ;; Checkpoint has an impossible past cursor; a changed basis must not
      ;; resume from it and skip either old or new data.
      (store/-put s (datom.derived/record-key (coverage/ident :p/at))
        {:status :building :definition (coverage/definition after :p/at) :basis basis
         :after (index/prefix-end (index/key-prefix :aevt :p/at)) :rows 1})
      (datom/transact! c [{:db/id -2 :p/at 2}])
      (conn/install-schema! c [(second components)])
      (is (= #{1 2} (set (mapv index/-v (db/datoms (conn/db c) :avet :p/at))))))))

(defrecord InterruptedStore [inner observe]
  store/Store
  (-get [s k] (store/-get (:inner s) k))
  (-range [s lo hi] (store/-range (:inner s) lo hi))
  (-put [s k v] (store/-put (:inner s) k v))
  (-delete [s k] (store/-delete (:inner s) k))
  (-update [s k f] (store/-update (:inner s) k f))
  (-commit [s ops]
    (when-let [f @(:observe s)] (f ops))
    (store/-commit (:inner s) ops))
  store/PageScan
  (-scan-datoms-page [s lo after hi limit] (store/page-datoms (:inner s) lo after hi limit)))

(deftest actual-writer-death-during-backfill-is-repaired-on-reopen
  (let [inner (fjall/open-fresh) path (:path inner) observe (atom nil)
        wrapped (->InterruptedStore inner observe)
        c (conn/connect-with wrapped [{:db/ident :p/at :db/valueType :db.type/long}])
        parent (erlang/self) attempts (atom 0)]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :p/at i}) (range 1100)))
    ;; Durable migration schema exists before its live-map sync.
    (datom/transact! c [{:db/id -2000 :db/ident :p/at :db/valueType :db.type/long :db/index true}])
    (reset! observe (fn [_]
                      (when (= 2 (swap! attempts inc))
                        (erlang/send parent [:coverage-interrupted (erlang/self)])
                        (receive :continue :ok (after 10000 (throw "interruption timed out"))))))
    (let [worker (spawn (fn []
                         (try (conn/sync-schema! c [(second components)]) (catch _ :interrupted))))]
      (receive [:coverage-interrupted writer]
        (erlang/exit writer :kill)
        (after 10000 (assert false "did not reach second coverage batch")))
      (reset! observe nil)
      (is (= :building (:status (coverage/certificate inner :p/at))))
      (is (= 1024 (:rows (coverage/certificate inner :p/at))))
      (conn/release! c)
      (store/close inner)
      (let [s2 (fjall/open path) c2 (conn/connect-with s2 [])]
        (is (= 1100 (count (db/datoms (conn/db c2) :avet :p/at))))
        (is (coverage/complete? s2 (conn/schema c2) :p/at (db/basis-t (conn/db c2))))
        (datom/close! c2)))))

(deftest restarted-writer-can-perform-nested-schema-transaction
  (let [c (datom/connect components)]
    (datom/transact! c [{:db/id -1 :p/firm 7 :p/at 11}])
    (erlang/exit (:writer c) :kill)
    (conn/install-schema! c [composite])
    (is (= #{[[7 11]]} (datom/q '[:find ?v :where [?e :p/order ?v]] (conn/db c))))))

(deftest tuple-components-recover-without-repeating-schema-definitions
  (let [s (fjall/open-fresh) path (:path s) c (conn/connect-with s (conj components composite))
        r (datom/transact! c [{:db/id -1 :p/firm 7 :p/at 11}]) e (get (:tempids r) -1)]
    (datom/close! c)
    (let [again (conn/connect-with (fjall/open path) [])]
      (is (= [:p/firm :p/at] (schema/tuple-attrs (conn/schema again) :p/order)))
      (datom/transact! again [[:db/add e :p/at 12]])
      (is (= [7 12] (:p/order (db/entity (conn/db again) e))))
      (datom/transact! again [[:db/retract e :p/firm 7]])
      (is (= [nil 12] (:p/order (db/entity (conn/db again) e))))
      (datom/close! again))))

(deftest explicit-legacy-tuple-definitions-repair-durable-component-metadata-once
  (let [s (fjall/open-fresh) path (:path s) defs (conj components composite)
        c (conn/connect-with s defs)
        r (datom/transact! c [{:db/id -1 :p/firm 7 :p/at 11}]) e (get (:tempids r) -1)
        ae (index/-e (first (db/datoms (conn/db c) :avet :db/ident :p/order)))]
    ;; Reproduce the old store representation, which recorded tuple type and
    ;; index flags but omitted the component vector entirely.
    (datom/transact! c [[:db/retract ae :db/tupleAttrs [:p/firm :p/at]]])
    (datom/close! c)
    (let [repaired (conn/connect-with (fjall/open path) defs)]
      (is (= [[:p/firm :p/at]]
             (mapv index/-v (db/datoms (conn/db repaired) :eavt ae :db/tupleAttrs))))
      (datom/close! repaired))
    (let [again (conn/connect-with (fjall/open path) [])]
      (is (= [:p/firm :p/at] (schema/tuple-attrs (conn/schema again) :p/order)))
      (datom/transact! again [[:db/add e :p/at 13]])
      (is (= [7 13] (:p/order (db/entity (conn/db again) e))))
      (datom/close! again))))

(deftest schema-recovery-pairs-retractions-before-restoring-current-definitions
  (let [s (fjall/open-fresh) path (:path s) c (conn/connect-with s (conj components composite))
        r (datom/transact! c [{:db/id -1 :p/firm 7 :p/at 11}]) e (get (:tempids r) -1)]
    (conn/install-schema! c [{:db/ident :p/at :db/valueType :db.type/long :db/index false}
                            (assoc composite :db/tupleAttrs [:p/at :p/firm])])
    (datom/close! c)
    (let [again (conn/connect-with (fjall/open path) [])]
      (is (not (schema/indexed? (conn/schema again) :p/at)))
      (is (= [:p/at :p/firm] (schema/tuple-attrs (conn/schema again) :p/order)))
      (datom/transact! again [[:db/add e :p/at 12]])
      (is (= [12 7] (:p/order (db/entity (conn/db again) e))))
      (datom/close! again))))

;; Simulate a pre-upgrade handle which retained its own schema atom. Ordinary
;; new connections share schema and can no longer produce this gap, but legacy
;; and deliberately detached writers must still invalidate coverage safely.
(defn legacy-schema-handle [c]
  (assoc (dissoc c :snapshot) :schema (atom (conn/schema c))))

(deftest legacy-writer-component-gaps-cannot-be-hidden-by-later-correct-writes
  (let [s (ets/open) stale (legacy-schema-handle (conn/connect-with s components))
        r (datom/transact! stale [{:db/id -1 :p/firm 7 :p/at 11}
                                  {:db/id -2 :p/firm 7 :p/at 21}])
        a (get (:tempids r) -1) b (get (:tempids r) -2)
        current (conn/connect-with s (conj components composite))]
    (is (coverage/complete? s (conn/schema current) :p/order (db/basis-t (conn/db current))))
    (datom/transact! stale [[:db/add a :p/at 12]])
    (is (not (coverage/complete? s (conn/schema current) :p/order (db/basis-t (conn/db current)))))
    (datom/transact! current [[:db/add b :p/at 22]])
    (is (nil? (coverage/certificate s :p/order)))
    (is (not (coverage/complete? s (conn/schema current) :p/order (db/basis-t (conn/db current)))))
    (conn/install-schema! current [composite])
    (is (coverage/complete? s (conn/schema current) :p/order (db/basis-t (conn/db current))))
    (is (= [7 12] (:p/order (db/entity (conn/db current) a))))))

(deftest bulk-components-without-derived-tuples-invalidate-until-repair
  (let [s (ets/open) c (conn/connect-with s (conj components composite))]
    (datom/load-facts! c [{:db/id 10000 :p/firm 7 :p/at 11}])
    (is (not (coverage/complete? s (conn/schema c) :p/order (db/basis-t (conn/db c)))))
    (conn/install-schema! c [composite])
    (is (= [7 11] (:p/order (db/entity (conn/db c) 10000))))
    (is (coverage/complete? s (conn/schema c) :p/order (db/basis-t (conn/db c))))))

(deftest legacy-unindexed-writer-cannot-leave-scalar-coverage-admitted
  (let [s (ets/open) stale (legacy-schema-handle (conn/connect-with s [{:db/ident :p/at :db/valueType :db.type/long}]))
        current (conn/connect-with s [(second components)])]
    (datom/transact! stale [{:db/id -1 :p/at 11}])
    (is (not (coverage/complete? s (conn/schema current) :p/at (db/basis-t (conn/db current)))))
    (is (= :unsupported-plan
           (:reason (page/page '[:find ?e ?at :where [?e :p/at ?at]] (conn/db current)
                               {:order-by ['?at :asc]} []))))
    (datom/transact! current [{:db/id -2 :p/at 12}])
    (is (nil? (coverage/certificate s :p/at)))
    (conn/install-schema! current [(second components)])
    (is (= #{11 12} (set (mapv index/-v (db/datoms (conn/db current) :avet :p/at)))))))

(deftest ordinary-earlier-connection-maintains-new-tuple-coverage
  (let [s (ets/open) earlier (conn/connect-with s components)
        r (datom/transact! earlier [{:db/id -1 :p/firm 7 :p/at 11}])
        e (get (:tempids r) -1)
        current (conn/connect-with s (conj components composite))]
    (try
      (datom/transact! earlier [[:db/add e :p/at 12]])
      (is (= [7 12] (:p/order (db/entity (conn/db current) e))))
      (is (coverage/complete? s (conn/schema current) :p/order (db/basis-t (conn/db current))))
      (is (= (conn/db earlier) (conn/db current)))
      (finally (conn/release! current) (ets/close s)))))
