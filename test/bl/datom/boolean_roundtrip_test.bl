; test/bl/datom/boolean_roundtrip_test.bl — a durable boolean is a boolean.
; Run: bl test test/bl/datom/boolean_roundtrip_test.bl
;
; ── The defect this pins ──────────────────────────────────────────────
;
; `native/datom_fjall` decodes the value lanes in Rust. The BOOLEAN lane came
; back through `rustler::atoms! { true_, false_ }`, and rustler stringifies the
; IDENTIFIER when no name is given — so the atoms really were `:true_` and
; `:false_`, not `true`/`false`. The trailing underscore exists only because
; `true`/`false` are Rust keywords; it is not part of the atom's name. Rustler's
; own stdlib writes the aliased form (`false_ = "false"`), which is what this
; crate now does too.
;
; Why it matters, in three shapes, all measured on the broken build:
;
;   * `pull` returned `:true_` — a KEYWORD. It is not `= true`, so every
;     equality check against a boolean failed;
;   * it is TRUTHY. `:false_` is an atom, so a stored `false` gated the
;     `true` branch — a wrong answer that looks like an answer;
;   * it cannot match a bound query term. `[?e :probe/flag true]` compared
;     against `:true_` and returned NOTHING, so a correct index silently
;     looked empty.
;
; Only the BOOLEAN LANE was affected. `:db.type/term` rides the ESC lane
; (`term_to_binary`, decoded by the BEAM), so nested booleans were always
; correct — that case is asserted here too, to keep the two decode paths from
; being confused for one another.

(ns datom.boolean-roundtrip.test
  (:require [datom.conn] [datom.db] [datom.pull] [datom.query.engine]
            [datom.store-fjall]))

(defn- q
  "A query's tuples as a vector, in the engine's order."
  [query db]
  (into [] (datom.query.engine/q query db)))

(defn- fixture
  "A connection over a FRESH DURABLE store with the boolean schema.

   Durability is the point: the defect lives in the fjall native value lane,
   so an in-memory store would not exercise it. An absent backend is ABSENT,
   not broken — `nil`, and the tests skip, the same rule
   `migrate_durable_test` states for `impls`."
  []
  (when (datom.store-fjall/available?)
    (datom.conn/connect-with (datom.store-fjall/open-fresh)
      [{:db/ident :probe/flag :db/valueType :db.type/boolean}
       {:db/ident :probe/off  :db/valueType :db.type/boolean}
       {:db/ident :probe/term :db/valueType :db.type/term}])))

(defn- seed!
  "One entity carrying `true`, `false`, and a term with nested booleans.
   Returns its entity id."
  [c]
  (let [r (datom.conn/transact! c [{:db/id -1
                                    :probe/flag true
                                    :probe/off  false
                                    :probe/term [true false {:nested true}]}])]
    (get (:tempids r) -1)))

;; ── the value lane ──────────────────────────────────────────────────

(deftest a-stored-boolean-reads-back-as-that-boolean
  (let [c (fixture)]
    (when (some? c)
      (let [e (seed! c)
            p (datom.pull/pull (datom.conn/db c) [:probe/flag :probe/off] e)]
        (is (= true (:probe/flag p)) "a stored `true` is `true`")
        (is (= false (:probe/off p)) "a stored `false` is `false`")
        (is (not (keyword? (:probe/flag p))) "the value is not a keyword")
        (is (not (keyword? (:probe/off p))) "neither is the false one")))))

(deftest a-stored-false-is-falsy
  ; The shape that turns a wrong value into a wrong BRANCH: an atom is truthy,
  ; so `:false_` took the `true` path everywhere a flag was consulted.
  (let [c (fixture)]
    (when (some? c)
      (let [e (seed! c)
            p (datom.pull/pull (datom.conn/db c) [:probe/off] e)]
        (is (= false (if (:probe/off p) true false))
            "a false flag does not read as true")
        (is (= :no (if (:probe/off p) :yes :no))
            "the false branch is the one taken")))))

;; ── the index: a bound boolean term must match ──────────────────────

(deftest a-bound-boolean-query-matches-the-datom-it-names
  ; The key encoding was always right (codec.bl tags booleans 0x20/0x21); this
  ; is the READ side having to agree with it. When it did not, the equality
  ; filter compared `true` against `:true_` and the query returned nothing.
  (let [c (fixture)]
    (when (some? c)
      (let [e (seed! c)
            d (datom.conn/db c)]
        (is (= [[e]] (q '[:find ?e :where [?e :probe/flag true]] d))
            "`true` matches the entity that holds it")
        (is (= [[e]] (q '[:find ?e :where [?e :probe/off false]] d))
            "`false` matches too — a bound false is a real value, not an absence")
        (is (= [] (q '[:find ?e :where [?e :probe/flag false]] d))
            "and a mismatched bound term still matches nothing")))))

;; ── the term lane is a DIFFERENT path ───────────────────────────────

(deftest nested-booleans-in-a-term-value-are-unaffected
  (let [c (fixture)]
    (when (some? c)
      (let [e (seed! c)
            p (datom.pull/pull (datom.conn/db c) [:probe/term] e)]
        (is (= [true false {:nested true}] (:probe/term p))
            "an any-term value rides the ETF escape lane, decoded by the BEAM")))))

;; ── durability: the decode survives a reopen ────────────────────────

(deftest a-boolean-survives-a-reopen
  ; The durable property in full: the value in the store is read back by a
  ; connection that was told nothing. Reusing the store handle is the suite's
  ; idiom (`reopening-a-store-recovers-its-data`); a same-VM file reopen races
  ; the handle's GC, which is a different question from this one.
  (let [c (fixture)]
    (when (some? c)
      (let [e (seed! c)
            c2 (datom.conn/connect-with (:store c) [])
            p2 (datom.pull/pull (datom.conn/db c2) [:probe/flag :probe/off] e)
            d2 (datom.conn/db c2)]
        (is (= true (:probe/flag p2)) "the true flag survives the reopen")
        (is (= false (:probe/off p2)) "and so does the false flag")
        (is (= [[e]] (q '[:find ?e :where [?e :probe/off false]] d2))
            "the reopened store's index answers the bound boolean")))))

;; ── retraction: a tombstone over a boolean datom ────────────────────

(deftest a-boolean-datom-can-be-retracted
  ; A retraction must FIND the datom it names. The lookup walks the boolean
  ; key lane, and the transaction compares against the value read back — so a
  ; decode that disagrees with the key would leave the assertion standing.
  (let [c (fixture)]
    (when (some? c)
      (let [e (seed! c)]
        (datom.conn/transact! c [[:db/retract e :probe/off false]])
        (let [d (datom.conn/db c)
              p (datom.pull/pull d [:probe/flag :probe/off] e)]
          (is (= [] (q '[:find ?e :where [?e :probe/off false]] d))
              "the retracted false is gone from the index")
          (is (= true (:probe/flag p)) "the sibling flag is untouched")
          (is (not (contains? p :probe/off))
              "and the retracted attribute is out of the pull"))))))
