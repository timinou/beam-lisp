(ns datom.open-failure-test (:require [datom.store-fjall :as fjall]))
(deftest failed-open-reports-its-cause-before-a-malformed-handle-can-escape
  (let [path (str (System/tmp_dir!) "/not-a-directory-" (System/unique_integer (list :positive)))]
    (try
      (File/write! path "occupied")
      (let [problem (try (fjall/open path) nil (catch e (ex-data e)))]
        (is (= :store-open-failed (:reason problem)))
        (is (some? (:native problem))))
      (finally (File/rm! path)))))
