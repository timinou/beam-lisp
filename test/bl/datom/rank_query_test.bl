(ns datom.rank-query-test
 (:require [datom :as d] [datom.query.rank-plan :as plan] [datom.store :as store] [datom.store-ets :as ets-store]
           [datom.store-fjall :as fjall] [datom.query.rank-build :as build]
           [datom.query.rank-index :as rank] [datom.query.rank-query :as query-rank]
           [proc.table :as table]))
(def S [{:db/ident :item/scope :db/valueType :db.type/ref :db/index true}
        {:db/ident :item/order :db/valueType :db.type/long :db/index true}
        {:db/ident :item/name :db/valueType :db.type/string}])
(def Q '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(def C '[:find (count ?e) . :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(defn await-window [database scope offset]
 (loop [n 0]
  (let [r (d/q-window Q database {:order-by ['?at :asc] :offset offset :limit 10} scope)]
   (if (or (= :exact (:status r)) (>= n 500)) r
    (do (Process/sleep 10) (recur (inc n)))))))
(defn exercise [s]
 (let [c (d/connect-with s S)]
  (try
   (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope (if (<= eid 80) 7 8)
                                  :item/order (quot eid 5) :item/name (str "item-" eid)}) (range 1 97)))
   (let [database (d/db c)
         expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q database 7))))
         cold (d/q-window Q database {:order-by ['?at :asc] :offset 65 :limit 10} 7)
         ready (await-window database 7 65)]
    (is (= :rank-not-ready (:reason cold)))
    (is (= :exact (:status ready)))
    (is (= 80 (:total ready)))
    (is (= (subvec expected 65 75) (:rows ready)))
    (is (= 80 (d/q C database 7)))
    (is (= :invalid-offset (:reason (d/q-window Q database {:order-by ['?at :asc] :offset -1} 7))))
    (is (= :expired-authorization (:reason (d/q-window Q database
           {:order-by ['?at :asc] :offset 65 :authorization {:expires-at 0}} 7))))
    (is (= :invalid-authorization (:reason (d/q-window Q database
           {:order-by ['?at :asc] :offset 65 :authorization {:expires-at "bad"}} 7))))
    (is (= :rank-not-ready (:reason (d/q-window Q database
           {:order-by ['?at :asc] :offset 65 :budget {:seeks 1}} 7))))
    (is (not= :exact (:status (d/q-window Q (d/as-of database (dec (:basis-t database)))
           {:order-by ['?at :asc] :offset 65} 7))))
    ;; A warm index never skips current policy invocation or its cleanup.
    (let [released (atom 0) allowed (atom true)
          context (d/query-context database
           (fn [q] (if @allowed {:query Q :inputs [7] :release (fn [] (swap! released inc))}
                      {:refused :denied :release (fn [] (swap! released inc))})))]
     (is (= (:rows ready) (:rows (d/q-window Q context {:order-by ['?at :asc] :offset 65 :limit 10}))))
     (is (= 1 @released))
     (reset! allowed false)
     (is (= :denied (try (d/q-window Q context {:order-by ['?at :asc] :offset 65})
                         :accepted (catch e (:refused (ex-data e))))))
     (is (= 2 @released)))
    (let [foreign (await-window database 8 5)]
     (is (= 16 (:total foreign)))
     (is (every? (fn [r] (> (first r) 80)) (:rows foreign))))
    ;; Invalid complete roots must rebuild even when no source write occurs.
    (let [p (plan/descriptor Q (:schema database) [7] ['?at :asc]) id (build/ident p)
          old (:generation (rank/header s id))]
     (BeamLisp.Env/intern "rank.query.rebind-fixture" "changed" :changed)
     (is (= :exact (:status (await-window database 7 65))))
     (is (not= old (:generation (rank/header s id))))))
   (finally (d/release! c)))))
(deftest automatic-window-count-and-policy-contract
 (let [s (ets-store/open)] (try (exercise s) (finally (ets-store/close s))))
 (exercise (fjall/open (store/fresh-path ".rank-query-test"))))

(deftest bounded-capacity-evicts-and-serves-later-scopes
 (let [s (ets-store/open) c (d/connect-with s S)]
  (try
   (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope eid :item/order eid :item/name (str eid)}) (range 1 7)))
   (let [database (d/db c)]
    (d/q Q database 1)
    (doseq [scope (range 1 7)]
     (let [r (await-window database scope 1)]
      (is (= :exact (:status r)))
      (is (= 1 (:total r)))
      (is (<= (count (build/registry s)) 4))))
    ;; Evicted scopes can re-enter; the cap is not a lifetime user quota.
    (is (= :exact (:status (await-window database 1 1)))))
   (finally (d/release! c) (ets-store/close s)))))
