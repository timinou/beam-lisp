; test/bl/datom/frame_test.bl — the DataFrame surface.
; Run: mix beam_lisp.test test/bl/datom/frame_test.bl
;
; The contract of datom.frame is one sentence: `q-df` is `q` then hand-built
; columns, value-for-value. So the assertions here mostly re-derive a frame the
; long way (run `q`, columnise by hand) and demand the two agree. If they ever
; diverge, q-df has grown a semantics of its own — which it must not.
;
; pull->df gets the same treatment against pull-many.

(ns datom.frame.test
  (:require [datom.conn] [datom.db] [datom.frame :as frame]
            [datom.query.engine :as engine]))

(defn- people
  "A small graph: three people in two cities, one with a missing city."
  []
  (let [c (datom.conn/connect
            [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/age  :db/valueType :db.type/long}
             {:db/ident :p/city :db/valueType :db.type/string}])]
    (datom.conn/transact! c
      [{:db/id -1 :p/name "Ada"   :p/age 36 :p/city "London"}
       {:db/id -2 :p/name "Grace" :p/age 45 :p/city "London"}
       {:db/id -3 :p/name "Alan"  :p/age 41 :p/city "Paris"}])
    c))

(defn- cols
  "An Explorer.DataFrame → a plain map of column-name → list of values, the
   shape the assertions compare (Explorer's own to_columns, string-keyed)."
  [df]
  (Explorer.DataFrame/to_columns df))

(defn- q [query db] (engine/q query db))

;; ── q-df is q, in columns ───────────────────────────────────────────

(deftest q-df-columns-match-q-tuples
  (let [db    (datom.conn/db (people))
        query '[:find ?name ?age
                :where [?e :p/name ?name] [?e :p/age ?age]]
        ; the long way: run q, sort for a stable row order, columnise by hand
        rows  (sort (Enum/to_list (q query db)))
        names (mapv (fn [r] (nth r 0)) rows)
        ages  (mapv (fn [r] (nth r 1)) rows)
        ; the surface
        df    (frame/q-df query db)
        c     (cols df)]
    (testing "the DataFrame has one column per :find element, in :find order"
      (is (= (list "name" "age") (Explorer.DataFrame/names df))))
    (testing "every column equals the hand-built projection of q"
      (is (= (Enum/to_list names) (Map/get c "name")))
      (is (= (Enum/to_list ages)  (Map/get c "age"))))
    (testing "the row count matches q's answer count"
      (is (= 3 (nth (Explorer.DataFrame/shape df) 0))))))

(deftest q-df-preserves-find-order-not-alphabetical
  ; A map-built DataFrame would sort columns alphabetically (age before name);
  ; q-df must keep :find order (name before age). This is the ordered-pairs
  ; construction, pinned.
  (let [db (datom.conn/db (people))
        df (frame/q-df '[:find ?name ?age
                         :where [?e :p/name ?name] [?e :p/age ?age]] db)]
    (is (= (list "name" "age") (Explorer.DataFrame/names df)))))

(deftest q-df-aggregate-groups-and-names
  (let [db (datom.conn/db (people))
        df (frame/q-df '[:find ?city (count ?e)
                         :where [?e :p/city ?city]] db)
        c  (cols df)]
    (testing "an aggregate column is named op_var"
      (is (= (list "city" "count_e") (Explorer.DataFrame/names df))))
    (testing "the grouping is correct: London 2, Paris 1"
      ; rows may arrive in any order; compare as a set of {city count} pairs
      (let [pairs (into #{}
                        (map (fn [i] [(nth (Map/get c "city") i)
                                      (nth (Map/get c "count_e") i)])
                             (range (nth (Explorer.DataFrame/shape df) 0))))]
        (is (contains? pairs ["London" 2]))
        (is (contains? pairs ["Paris" 1]))))))

(deftest q-df-empty-result-is-a-shaped-empty-frame
  ; No match → 0 rows, but STILL the right columns. An empty frame must keep its
  ; shape so a downstream pipeline (select, plot) does not crash on a missing
  ; column.
  (let [db (datom.conn/db (people))
        df (frame/q-df '[:find ?name :where [?e :p/name ?name] [?e :p/age 999]] db)]
    (is (= (list "name") (Explorer.DataFrame/names df)))
    (is (= 0 (nth (Explorer.DataFrame/shape df) 0)))))

(deftest q-df-dtypes-follow-the-values
  ; Explorer infers a column's dtype from its values, which are the datom
  ; values, which carry their :db.type. A long column is integer, a string
  ; column is string — the schema, recovered.
  (let [db (datom.conn/db (people))
        df (frame/q-df '[:find ?name ?age
                         :where [?e :p/name ?name] [?e :p/age ?age]] db)
        dt (Explorer.DataFrame/dtypes df)]
    (is (= :string (Map/get dt "name")))
    ; Explorer represents a 64-bit signed int dtype as {:s, 64}
    (is (= (erlang/list_to_tuple (list :s 64)) (Map/get dt "age")))))

;; ── pull->df is pull-many, in columns ───────────────────────────────

(deftest pull-df-columns-and-nulls
  (let [c    (people)
        r    (datom.conn/transact! c [{:db/id -9 :p/name "Deb" :p/age 50}]) ; no city
        deb  (get (:tempids r) -9)
        db   (datom.conn/db c)
        ; find Ada's id via a query so the test does not hardcode an id
        ada  (nth (first (Enum/to_list
                           (engine/q '[:find ?e :where [?e :p/name "Ada"]] db))) 0)
        df   (frame/pull->df db [ada deb] [:p/name :p/age :p/city])
        cc   (cols df)]
    (testing "columns are db/id then the attributes, in order"
      (is (= (list "db/id" "p/name" "p/age" "p/city") (Explorer.DataFrame/names df))))
    (testing "a present attribute carries its value; an absent one is null (nil)"
      (is (= "Ada" (nth (Map/get cc "p/name") 0)))
      (is (= "Deb" (nth (Map/get cc "p/name") 1)))
      (is (= "London" (nth (Map/get cc "p/city") 0)))
      (is (= nil (nth (Map/get cc "p/city") 1))))
    (testing "one row per entity"
      (is (= 2 (nth (Explorer.DataFrame/shape df) 0))))))

;; ── the optional-dep gate ───────────────────────────────────────────

(deftest available-is-true-when-explorer-is-present
  ; In the test env Explorer IS a dep, so the gate is true and the surface is
  ; live. (The absent-dep branch — a clear raise — is asserted by inspection of
  ; require-explorer!; it cannot be exercised where the dep is loaded.)
  (is (= true (frame/available?))))
