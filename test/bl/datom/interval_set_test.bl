; test/bl/datom/interval_set_test.bl — many intervals, held as one value.
; Run: bl test test/bl/datom/interval_set_test.bl
;
; `datom.time`'s interval is ONE half-open span. A recurrence produces MANY,
; and "every day at 06:00, except the holidays" is not an expression until
; something can HOLD them — that is the IntervalSet, and composing it is the
; point of roadmap R2 (docs/scheduling/the-rule-and-the-set.md §2).
;
; The invariant IS the value: spans sorted, disjoint and maximal. These
; assertions hold the normalisation (the constructor), the algebra built on
; it, and the two properties that make the type safe to store and re-read —
; idempotence, and measurement that counts gaps as gaps.

(ns datom.interval-set.test
  (:require [datom.time] [clojure.string]))

(defn- iv
  "A half-open :second interval [from, to). Coalescing and splitting are pure
   arithmetic, so their edges are stated on this scale rather than a calendar."
  [from to]
  (datom.time/->Interval from to :second :gregorian))

(defn- bounds
  "A set's canonical spans as [from to] pairs, for readable expectations."
  [s]
  (mapv (fn [x] [(datom.time/from x) (datom.time/to x)])
        (datom.time/set-spans s)))

(defn- message-of
  "The text a refusal carries, or nil when the call does not refuse."
  [f]
  (try (f) nil (catch e (str e))))

(defn- mentions?
  "Whether a refusal names a thing. This namespace's refusals are written so
   the fix is IN the message, and this is how that is held to."
  [s needle]
  (clojure.string/includes? s needle))

;; ── normalising: the invariant, established once ────────────────────

(deftest touching-spans-coalesce-into-one
  (let [s (datom.time/interval-set [(iv 1 3) (iv 3 5)])]
    (is (= [[1 5]] (bounds s))
        "[1,3) then [3,5) covers every instant of [1,5) with no gap")
    (is (= 1 (datom.time/set-count s)))))

(deftest a-gap-keeps-two-spans
  (let [s (datom.time/interval-set [(iv 1 3) (iv 4 6)])]
    (is (= [[1 3] [4 6]] (bounds s)))
    (is (= 2 (datom.time/set-count s)))))

(deftest overlapping-spans-coalesce-into-their-hull
  (is (= [[1 9]] (bounds (datom.time/interval-set [(iv 1 5) (iv 3 9)])))))

(deftest shuffled-input-and-empty-spans-normalise-the-same
  (let [messy (datom.time/interval-set [(iv 4 6) (iv 3 3) (iv 1 3)])
        tidy  (datom.time/interval-set [(iv 1 3) (iv 4 6)])]
    (is (= tidy messy)
        "an out-of-order input with an empty span inside equals the sorted one")
    (is (= [[1 3] [4 6]] (bounds messy))
        "the empty [3,3) span contributes no instant and is dropped")))

(deftest an-empty-collection-is-the-empty-set
  (let [s (datom.time/interval-set [])]
    (is (datom.time/set-empty? s))
    (is (= 0 (datom.time/set-count s)))
    (is (= 0 (datom.time/set-measure s)))
    (is (not (datom.time/set-covers? s 0)))
    (is (not (datom.time/set-overlaps? s (datom.time/interval-set [(iv 0 1)]))))))

(deftest interval-set-refuses-a-member-that-is-not-an-interval
  (is (mentions? (message-of (fn [] (datom.time/interval-set [(iv 1 2) 5])))
                 "interval-set")
      "a non-interval is refused by name, not silently dropped"))

;; ── the algebra ─────────────────────────────────────────────────────

(deftest subtract-can-split-one-span-into-two
  (let [a (datom.time/interval-set [(iv 1 10)])
        b (datom.time/interval-set [(iv 4 5)])
        d (datom.time/set-subtract a b)]
    (is (= [[1 4] [5 10]] (bounds d))
        "removing a hole from the middle leaves TWO spans — this is why a set is not an interval")
    (is (= 2 (datom.time/set-count d)))))

(deftest the-holiday-exception-is-a-subtraction
  ; the motivating composition: occurrences minus the days that do not run
  (let [occurrences (datom.time/interval-set [(iv 0 1) (iv 2 3) (iv 4 5) (iv 6 7)])
        holidays    (datom.time/interval-set [(iv 2 3) (iv 6 7)])
        runs        (datom.time/set-subtract occurrences holidays)]
    (is (= [[0 1] [4 5]] (bounds runs))
        "every day at 06:00 except the holidays is now an expression")))

(deftest subtracting-nothing-leaves-the-set-unchanged
  (let [a (datom.time/interval-set [(iv 1 3) (iv 5 7)])]
    (is (= a (datom.time/set-subtract a (datom.time/interval-set []))))))

(deftest intersecting-disjoint-sets-is-empty-not-an-error
  (let [a (datom.time/interval-set [(iv 1 3)])
        b (datom.time/interval-set [(iv 4 6)])
        i (datom.time/set-intersect a b)]
    (is (datom.time/set-empty? i))
    (is (= [] (bounds i)))))

(deftest intersect-keeps-the-instants-both-sets-hold
  (let [a (datom.time/interval-set [(iv 1 5) (iv 8 10)])
        b (datom.time/interval-set [(iv 3 9)])]
    (is (= [[3 5] [8 9]] (bounds (datom.time/set-intersect a b))))))

(deftest union-joins-across-two-sets
  (let [a (datom.time/interval-set [(iv 1 3)])
        b (datom.time/interval-set [(iv 3 5) (iv 7 8)])]
    (is (= [[1 5] [7 8]] (bounds (datom.time/set-union a b)))
        "touching spans coalesce across the two sets exactly as within one")))

;; ── complement: bounded, or refused ─────────────────────────────────

(deftest complement-without-a-bound-refuses
  (let [s (datom.time/interval-set [(iv 2 3)])
        msg (message-of (fn [] (datom.time/set-complement s)))]
    (is (some? msg) "a set is unbounded below, so its complement cannot be guessed")
    (is (mentions? msg "bound")
        "the refusal names the missing bound — the fix is in the message")))

(deftest complement-within-a-bound-returns-the-gaps
  (let [s (datom.time/interval-set [(iv 2 3) (iv 5 6)])
        gaps (datom.time/set-complement s (iv 1 7))]
    (is (= [[1 2] [3 5] [6 7]] (bounds gaps)))))

(deftest complement-of-an-empty-set-is-the-whole-bound
  (is (= [[1 7]]
         (bounds (datom.time/set-complement (datom.time/interval-set []) (iv 1 7))))))

;; ── the questions a set can be asked ────────────────────────────────

(deftest covers-is-half-open-at-both-ends
  (let [s (datom.time/interval-set [(iv 1 3) (iv 5 7)])]
    (is (datom.time/set-covers? s 1) "an instant equal to a span's from IS covered")
    (is (datom.time/set-covers? s 2))
    (is (not (datom.time/set-covers? s 3)) "an instant equal to a span's to is NOT covered")
    (is (not (datom.time/set-covers? s 4)) "and neither is an instant in the gap")
    (is (datom.time/set-covers? s 5))
    (is (not (datom.time/set-covers? s 7)))))

(deftest overlaps-is-false-for-sets-that-merely-touch
  (let [a (datom.time/interval-set [(iv 1 3)])
        b (datom.time/interval-set [(iv 3 5)])
        c (datom.time/interval-set [(iv 2 4)])]
    (is (not (datom.time/set-overlaps? a b))
        "[1,3) and [3,5) share no instant, however adjacent")
    (is (datom.time/set-overlaps? a c))))

(deftest overlaps-sweeps-multiple-spans
  (let [a (datom.time/interval-set [(iv 1 3) (iv 7 9)])
        far (datom.time/interval-set [(iv 3 4) (iv 4 6)])
        near (datom.time/interval-set [(iv 3 4) (iv 8 10)])]
    (is (not (datom.time/set-overlaps? a far)))
    (is (datom.time/set-overlaps? a near))))

(deftest measure-counts-gaps-as-gaps
  (let [s (datom.time/interval-set [(iv 1 2) (iv 8 9)])
        spans (datom.time/set-spans s)]
    (is (= 2 (datom.time/set-measure s))
        "two one-second spans hold two seconds, not the eight-second hull")
    (is (= 8 (- (datom.time/to (second spans)) (datom.time/from (first spans))))
        "the hull is 8 — exactly the answer measure must NOT give")))

(deftest measure-of-a-coalesced-set-is-its-width
  (is (= 4 (datom.time/set-measure (datom.time/interval-set [(iv 1 3) (iv 3 5)])))))

;; ── safe to store and re-read ───────────────────────────────────────

(deftest a-normalised-set-is-a-fixed-point
  (let [s (datom.time/interval-set [(iv 1 3) (iv 4 6) (iv 6 9)])]
    (is (= s (datom.time/interval-set (datom.time/set-spans s)))
        "re-normalising canonical spans changes nothing — the value round-trips")
    (is (= s (datom.time/set-union s s))
        "a set unioned with itself is itself")))

(deftest interval-set?-recognises-the-type
  (is (datom.time/interval-set? (datom.time/interval-set [(iv 1 2)])))
  (is (datom.time/interval-set? (datom.time/interval-set [])))
  (is (not (datom.time/interval-set? (iv 1 2))))
  (is (not (datom.time/interval-set? {:spans []}))
      "a bare map with a :spans key is not a set — the predicate is type-based"))
