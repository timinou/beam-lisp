(ns datom.query-page-joins-test
  (:require [datom] [datom.query.page :as page] [datom.query.engine :as engine]))

(def schema [{:db/ident :doc/title :db/valueType :db.type/string}
             {:db/ident :doc/owner :db/valueType :db.type/string}
             {:db/ident :passage/doc :db/valueType :db.type/ref :db/index true}
             {:db/ident :passage/text :db/valueType :db.type/string}
             {:db/ident :passage/order :db/valueType :db.type/long :db/index true}
             {:db/ident :doc/tags :db/valueType :db.type/string :db/cardinality :db.cardinality/many}])
(def query '[:find ?c ?text ?title ?s :where
             [?c :passage/text ?text] [?c :passage/doc ?s]
             [?s :doc/title ?title] [?s :doc/owner "alice"]])
(defn fixture []
  (let [c (datom/connect schema)]
    (datom/transact! c [{:db/id -1 :doc/title "A" :doc/owner "alice"}
                       {:db/id -2 :doc/title "B" :doc/owner "bob"}])
    (let [docs (into {} (map (fn [r] [(second r) (first r)])
                             (datom/q '[:find ?e ?title :where [?e :doc/title ?title]] (datom/db c))))]
      (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :passage/text (str "text " i)
                                        :passage/order i :passage/doc (get docs (if (= 0 (mod i 3)) "A" "B"))}) (range 30))))
    c))
(defn walk [q d order budget]
  (loop [after nil rows [] rounds 0]
    (is (< rounds 100))
    (let [p (datom/q-page q d {:order-by order :after after :limit 3 :budget budget})]
      (is (contains? #{:exact :incomplete} (:status p)))
      (if (and (:after p) (< rounds 100))
        (recur (:after p) (into rows (:rows p)) (inc rounds))
        (into rows (:rows p))))))
(deftest forward-joins-page-by-entity-id-with-sparse-owner-filters
  (let [d (datom/db (fixture)) oracle (vec (sort-by first (engine/q-uncached query d)))]
    (is (= oracle (walk query d ['?c :asc] {:rows 45 :seeks 45})))
    (is (= (vec (reverse oracle)) (walk query d ['?c :desc] {:rows 4096 :seeks 4096})))))
(deftest joins-with-indexed-value-order-and-safe-predicates
  (let [d (datom/db (fixture))
        q (into query '[[?c :passage/order ?n] [(>= ?n 9)] [(< ?n 25)]])
        oracle (vec (reverse (sort-by first (engine/q-uncached q d))))]
    (is (= oracle (walk q d ['?n :desc] {:rows 70 :seeks 70})))))
(deftest fanout-and-noninjective-results-still-refuse
  (let [d (datom/db (fixture))
        q (into query '[[?s :doc/tags ?tag]])]
    (is (= :unsupported-plan (:reason (datom/q-page q d {:order-by ['?c :asc]}))))
    (is (= :unsupported-plan (:reason (datom/q-page '[:find ?title :where [?s :doc/title ?title]] d {:order-by ['?s :asc]}))))))
(deftest joined-entity-changes-respect-old-bases-and-cursors
  (let [c (fixture) d (datom/db c) opts {:order-by ['?c :asc] :limit 3}
        p (datom/q-page query d opts)
        src (nth (first (:rows p)) 3)]
    (is (= :exact (:status p)))
    (datom/transact! c [[:db/add src :doc/owner "bob"]])
    (is (= :invalid-cursor (:reason (datom/q-page query (datom/db c) (assoc opts :after (:after p))))))
    (is (= 10 (count (walk query d ['?c :asc] {:rows 4096 :seeks 4096}))))
    (is (empty? (:rows (datom/q-page query (datom/db c) opts))))))

(deftest scalar-entity-input-seeks-directly-to-its-bounded-functional-row
  (let [d (datom/db (fixture))
        e (first (first (datom/q '[:find ?e :where [?e :passage/order 29]] d)))
        q '[:find ?c ?text ?title :in $ ?c :where [?c :passage/text ?text]
             [?c :passage/doc ?s] [?s :doc/title ?title]]
        r (datom/q-page q d {:order-by ['?c :asc] :limit 2
                              :budget {:rows 10 :seeks 10 :bytes 4096}} e)]
    (is (= :exact (:status r)))
    (is (= [[e "text 29" "B"]] (:rows r)))
    (is (not (:more? r)))))

(deftest scalar-entity-input-retains-the-physical-history-budget
  (let [c (fixture) d (datom/db c)
        e (first (first (datom/q '[:find ?e :where [?e :passage/order 29]] d)))]
    (doseq [i (range 12)] (datom/transact! c [[:db/add e :passage/text (str "revision " i)]]))
    (let [r (datom/q-page '[:find ?c ?text :in $ ?c :where [?c :passage/text ?text]]
                         (datom/db c) {:order-by ['?c :asc] :limit 2
                                      :budget {:rows 5 :seeks 10 :bytes 4096}} e)]
      (is (= :incomplete (:status r)))
      (is (empty? (:rows r))))))
