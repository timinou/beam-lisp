; test/bl/datom/query_builtins_test.bl — database query builtins (PLAN-115 B4).
; Run: bl test test/bl/datom/query_builtins_test.bl
;
; Datomic's DATABASE FUNCTIONS read the database inside a :where clause. datom
; supports the two an unmodified query (and kontor's invariants) reach for:
;   [(get-else $ ?e ?a default) ?v]  — ?v is the entity's value, or default
;   [(missing? $ ?e ?a)]             — the entity has NO value for the attribute
; The `$` is the source; datom has one default source, so it is accepted and
; ignored. These are intercepted in eval-clause because they need the db handle
; the plain predicate path does not carry. Answers cross-checked vs datahike.

(ns datom.query-builtins.test
  (:require [datom.conn] [datom.query.engine]))

(defn- db []
  (let [c (datom.conn/connect
            [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
             {:db/ident :nick :db/valueType :db.type/string :db/cardinality :db.cardinality/one}])]
    (datom.conn/transact! c [{:db/id -1 :name "ada"   :nick "ace"}
                             {:db/id -2 :name "grace"}])   ; no nick
    (datom.conn/db c)))

(deftest get-else-defaults-a-missing-value
  (is (= #{["ada" "ace"] ["grace" "none"]}
         (datom.query.engine/q
           '[:find ?name ?n
             :where [?e :name ?name]
                    [(get-else $ ?e :nick "none") ?n]]
           (db)))
      "get-else binds the value, or the default when the attribute is absent"))

(deftest missing?-keeps-entities-without-the-attribute
  (is (= #{["grace"]}
         (datom.query.engine/q
           '[:find ?name
             :where [?e :name ?name]
                    [(missing? $ ?e :nick)]]
           (db)))
      "missing? keeps only the entity that has no :nick"))

(deftest get-else-of-a-present-value-is-that-value
  (is (= "ace"
         (datom.query.engine/q
           '[:find ?n .
             :where [?e :name "ada"]
                    [(get-else $ ?e :nick "none") ?n]]
           (db)))
      "when the value is present, get-else returns it, not the default"))
