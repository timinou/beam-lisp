(ns datom.canonical-snapshot-test
  (:require [datom :as d] [datom.conn :as conn] [datom.db :as db]
            [datom.schema :as schema] [datom.store-ets :as ets]))

(def basic [{:db/ident :snap/value :db/valueType :db.type/long}])
(def indexed [{:db/ident :snap/value :db/valueType :db.type/long :db/index true}])

(deftest connections-share-current-schema-but-values-retain-their-schema
  (let [s (ets/open) a (conn/connect-with s basic) b (conn/connect-with s)
        old (conn/db a)]
    (try
      (d/transact! a [{:db/id 1 :snap/value 7}])
      (conn/install-schema! a indexed)
      (let [now (conn/db b)]
        (is (= (conn/db a) now))
        (is (schema/indexed? (:schema now) :snap/value))
        (is (not (schema/indexed? (:schema old) :snap/value)))
        (is (< (:basis-t old) (:basis-t now)))
        (is (= 1 (count (db/datoms now :avet :snap/value)))))
      (is (= (:schema a) (:schema b)))
      (is (= (:snapshot a) (:snapshot b)))
      (finally (conn/release! a) (ets/close s)))))

(deftest connection-recovered-from-old-value-writes-with-current-schema
  (let [s (ets/open) c (conn/connect-with s basic) old (conn/db c)]
    (try
      (conn/install-schema! c [{:db/ident :snap/tags :db/valueType :db.type/string
                               :db/cardinality :db.cardinality/many}])
      (d/transact! (conn/conn-of old) [[:db/add 1 :snap/tags "a"] [:db/add 1 :snap/tags "b"]])
      (is (= #{"a" "b"} (set (:snap/tags (d/entity (conn/db c) 1)))))
      (is (nil? (get (:schema old) :snap/tags)))
      (finally (conn/release! c) (ets/close s)))))

(deftest second-connection-can-install-new-definitions
  (let [s (ets/open) a (conn/connect-with s basic)]
    (try
      (let [b (conn/connect-with s [{:db/ident :snap/extra :db/valueType :db.type/string}])]
        (d/transact! a [{:db/id 1 :snap/extra "visible"}])
        (is (= "visible" (:snap/extra (d/entity (conn/db b) 1))))
        (is (= (conn/db a) (conn/db b))))
      (finally (conn/release! a) (ets/close s)))))
