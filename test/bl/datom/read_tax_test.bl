; test/bl/datom/read_tax_test.bl — the read path's cost budget + retraction semantics.
; Run: bl test test/bl/datom/read_tax_test.bl
;
; Reductions (not wall time) are load-independent, so the budget is a real
; regression gate: a per-element core `reduce`/`some?`/`not` creeping back into
; scan-datoms / filter-datoms costs ~170+ reductions a row and trips it.

(ns datom.read-tax.test
  (:require [datom.conn] [datom.db] [datom.index] [datom.time]))

(defn- reds [] (erlang/element 2 (erlang/process_info (erlang/self) :reductions)))

(defn- fixture
  "`n` entities, a name + a cardinality-one `:e/state` updated 5 times each:
   n*(2+1) current datoms, n*5 retractions in history."
  [n]
  (let [c (datom.conn/connect
            [{:db/ident :e/name :db/valueType :db.type/string}
             {:db/ident :e/state :db/valueType :db.type/long}])]
    (datom.conn/transact! c (mapv (fn [i] {:db/id (- (inc i)) :e/name (str "n" i) :e/state 0}) (range n)))
    (let [ids (mapv (fn [d] (datom.index/-e d)) (datom.db/datoms (datom.conn/db c) :aevt :e/name))]
      (doseq [k (range 1 6)]
        (datom.conn/transact! c (mapv (fn [e] [:db/add e :e/state k]) ids))))
    c))

(defn- cost [f]
  (let [r0 (reds) res (f) r1 (reds)]
    {:n (count res) :reds (- r1 r0)}))

(defn- per-datom [{:keys [n reds]}] (quot reds (max 1 n)))

(deftest read-cost-budget
  (let [db (datom.conn/db (fixture 300))
        cur (cost (fn [] (datom.db/datoms db :aevt :e/state)))
        hist (cost (fn [] (datom.db/datoms (datom.time/history db) :eavt)))]
    (is (= 300 (:n cur)))
    ; measured after (300 entities): current 9233, history 668 reds/returned datom,
    ; (before the fix, 1000 entities: current ~50000, history ~2270); bounds ~2x measured
    (is (< (per-datom cur) 18000) (str "current reds/datom " (per-datom cur)))
    (is (< (per-datom hist) 1400) (str "history reds/datom " (per-datom hist)))))

(deftest current-read-honours-retraction-and-reassert
  (let [c (datom.conn/connect [{:db/ident :e/v :db/valueType :db.type/long
                                :db/cardinality :db.cardinality/many}])
        r (datom.conn/transact! c [{:db/id -1 :e/v 7}])
        e (get (:tempids r) -1)
        vals (fn [] (set (map datom.index/-v (datom.db/datoms (datom.conn/db c) :eavt e :e/v))))]
    (is (= #{7} (vals)))
    (datom.conn/transact! c [[:db/retract e :e/v 7]])
    (is (= #{} (vals)))
    (datom.conn/transact! c [[:db/add e :e/v 7]])
    (is (= #{7} (vals)) "re-assert after retract is current again")
    (let [h (datom.db/datoms (datom.time/history (datom.conn/db c)) :eavt e :e/v)]
      (is (= 3 (count h)) "history keeps assert, retract, assert")
      (is (= 1 (count (filter datom.index/retraction? h)))))))

(deftest composite-and-float-values-pair-correctly
  (let [c (datom.conn/connect [{:db/ident :e/d :db/valueType :db.type/term
                                :db/cardinality :db.cardinality/many}
                               {:db/ident :e/s :db/valueType :db.type/string
                                :db/cardinality :db.cardinality/many}])
        r (datom.conn/transact! c [{:db/id -1 :e/d 1.5 :e/s "a"}])
        e (get (:tempids r) -1)
        now (fn [a] (set (map datom.index/-v (datom.db/datoms (datom.conn/db c) :eavt e a))))]
    (datom.conn/transact! c [[:db/retract e :e/d 1.5] [:db/retract e :e/s "a"]])
    (is (= #{} (now :e/d)))
    (is (= #{} (now :e/s)))))
