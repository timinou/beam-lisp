(ns datom.value-validator-test (:require [datom.schema :as schema]))

(deftest bulk-validator-shares-all-transaction-value-type-semantics
 (doseq [t schema/VALUE-TYPES]
  (let [s {:test/value {:db/ident :test/value :db/valueType t}}
        validate (schema/value-validator s :test/value)]
   (doseq [v [nil true false 0 -1 1.5 "value" :value [1 2] {:from 1 :to 2 :resolution :day}
              {:dim 1 :body "1234"} {:dim 2 :body "1234"} {:size 0 :sha "too-short"}]]
    (is (= (schema/validate-value s :test/value v) (validate v)))))))

(deftest bulk-validator-preserves-unknown-and-untyped-results
 (is (= {:error :unknown-attribute :attr :missing}
        ((schema/value-validator {} :missing) :anything)))
 (is (nil? ((schema/value-validator {:known {:db/ident :known}} :known) nil))))
