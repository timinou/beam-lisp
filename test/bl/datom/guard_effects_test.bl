(ns datom.guard-effects-test (:require [datom] [datom.conn :as conn] [datom.db :as db]))
(defn- fresh [] (datom/connect [{:db/ident :test/value :db/valueType :db.type/long}]))
(defn- value-at [c] (db/attr-value (datom/db c) 1 :test/value))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest guarded-function-expansion-runs-once-on-success-and-refusal
 (let [c (fresh) calls (atom 0)]
  (try
   (conn/guard! c :ceiling (fn [report] (when (> (or (db/attr-value (:db-after report) 1 :test/value) 0) 10) :too-large)))
   (datom/transact! c [[:db/fn (fn [_] (swap! calls inc) [[:db/add 1 :test/value 5]])]])
   (is (= 1 @calls)) (is (= 5 (value-at c)))
   (reset! calls 0)
   (is (thrown? (datom/transact! c [[:db/add 2 :test/value 1]
                                  [:db/fn (fn [_] (swap! calls inc) [[:db/add 1 :test/value 50]])]])))
   (is (= 1 @calls)) (is (= 5 (value-at c)))
   (is (nil? (db/attr-value (datom/db c) 2 :test/value)))
   (finally (conn/release! c)))))

(deftest bulk-loads-cannot-bypass-a-registered-guard
 (let [c (fresh)]
  (try
   (conn/guard! c :blocked (fn [_] :blocked))
   (is (thrown? (datom/load-facts! c [{:db/id 1 :test/value 20}])))
   (is (nil? (value-at c)))
   (finally (conn/release! c)))))

(deftest guard-predicates-cannot-mutate-the-source-store
 (let [c (fresh)]
  (try
   (conn/guard! c :illegal-write (fn [_] (datom/transact! c [[:db/add 2 :test/value 99]]) nil))
   (is (= :read-only-observation (kind #(datom/transact! c [[:db/add 1 :test/value 1]]))))
   (is (nil? (value-at c)))
   (is (nil? (db/attr-value (datom/db c) 2 :test/value)))
   (finally (conn/release! c)))))
