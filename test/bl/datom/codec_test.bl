; test/bl/datom/codec_test.bl — the order-preserving key encoding.
; Run: mix beam_lisp.test test/bl/datom/codec_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
;   sort(encode(a), encode(b))  ==  sort(a, b)
;
; Everything the index layer does rests on that one property. If it fails
; for some value pair, a range scan over that type silently returns the
; wrong rows — no error, just wrong answers.
;
; The assertions below compare ENCODED byte order against the order the
; values themselves have. That framing matters: a test asserting specific
; byte sequences would pin the encoding's shape rather than its contract,
; and would have to be rewritten every time the codec is tuned.

(ns datom.codec.test
  (:require [datom.codec]))

(defn- before?
  "Whether `a` encodes to bytes that sort before `b`'s."
  [a b]
  (erlang/< (datom.codec/encode-value a) (datom.codec/encode-value b)))

;; ── integers ────────────────────────────────────────────────────────

(deftest integers-order-numerically-across-zero
  ; The offset encoding exists for this: a raw two's-complement byte
  ; pattern makes -1 look LARGER than 1, so every negative entity id or
  ; timestamp would sort at the wrong end.
  (is (before? -100 -1))
  (is (before? -1 0))
  (is (before? 0 1))
  (is (before? -5 5)))

(deftest integers-order-by-magnitude-not-digit-count
  ; Fixed width exists for this: a variable-width encoding compares "9"
  ; against "1" and stops there, so 9 would sort after 10.
  (is (before? 9 10))
  (is (before? 99 100))
  (is (before? 1 1000000)))

(deftest integers-round-trip
  (are [n] (= n (datom.codec/decode-int (datom.codec/encode-int n)))
    0
    1
    -1
    42
    -42
    123456789
    -123456789))

;; ── strings ─────────────────────────────────────────────────────────

(deftest strings-order-lexicographically-at-equal-length
  (is (before? "a" "b"))
  (is (before? "Z" "a")))

(deftest strings-order-lexicographically-across-lengths
  ; THE regression. The first implementation used `term_to_binary`, which
  ; wraps a value in an envelope carrying a LENGTH PREFIX — so encoded
  ; strings sorted by length before content:
  ;
  ;   "z" < "aa"   was true   (should be false)
  ;   "abc" < "b"  was false  (should be true)
  ;
  ; A first probe using only same-length pairs passed completely. These
  ; four assertions are what caught it.
  (is (not (before? "z" "aa")))
  (is (before? "abc" "b"))
  (is (before? "aaa" "ab"))
  (is (not (before? "short" "longer-string-here"))))

(deftest a-string-prefix-sorts-before-its-extensions
  ; What makes a prefix RANGE work on string values.
  (is (before? "ab" "abc"))
  (is (before? "" "a")))

;; ── cross-type ordering ─────────────────────────────────────────────

(deftest types-order-by-tag-so-comparison-is-total
  ; An index holds heterogeneous values and must never crash comparing
  ; them. The exact interleaving matters less than being total, stable,
  ; and consistent with the language's own ranking.
  (is (before? nil 1))
  (is (before? nil "a"))
  (is (before? false true))
  (is (before? 1 "a"))
  (is (before? "a" :a)))

(deftest encoding-is-deterministic
  ; Two encodings of the same value must be identical, or an index write
  ; and a later lookup would disagree about where the datom lives.
  (are [v] (= (datom.codec/encode-value v) (datom.codec/encode-value v))
    42
    -1
    "text"
    :keyword
    nil
    true))

(deftest distinct-values-encode-distinctly
  (is (not (= (datom.codec/encode-value 1) (datom.codec/encode-value 2))))
  (is (not (= (datom.codec/encode-value "a") (datom.codec/encode-value "b"))))
  (is (not (= (datom.codec/encode-value :a) (datom.codec/encode-value "a")))
      "a keyword and a same-named string are different values"))

;; ── composition ─────────────────────────────────────────────────────

(deftest concatenated-keys-order-component-wise
  ; An index key is several encoded components in a row, and it must
  ; order by the FIRST differing component — the property that makes
  ; EAVT sort by entity, then attribute, then value.
  (let [k (fn [& parts] (datom.codec/concat-bins (mapv datom.codec/encode-value parts)))]
    (is (erlang/< (k 1 :a) (k 1 :b)))
    (is (erlang/< (k 1 :b) (k 2 :a)) "the first component dominates")
    (is (erlang/< (k 1 :a "x") (k 1 :a "y")))))

(deftest a-shorter-key-is-a-prefix-of-its-extensions
  ; This is what BUG-005 broke for tuple keys and what binary keys fix:
  ; `[1]` must sort immediately before `[1 :a]`, NOT before every key.
  (let [k (fn [& parts] (datom.codec/concat-bins (mapv datom.codec/encode-value parts)))]
    (is (erlang/< (k 1) (k 1 :a)))
    (is (erlang/< (k 1 :a) (k 2)))
    (is (erlang/< (k 1) (k 2)))))

;; ── review-gate regressions (wave 2 swarm) ──────────────────────────────────
;;
;; Three ways the codec could produce two DIFFERENT values with the SAME
;; bytes — which in an index means one datom silently overwriting another.

(deftest integers-outside-64-bit-range-are-rejected-loudly
  ; beam-lisp integers are BEAM bignums, so an out-of-range value wrapped
  ; inside the 8-byte window: 2^63 and -2^63 encoded IDENTICALLY. Below
  ; the range it was different but no better — negative bytes reached
  ; `list_to_binary`, raising a bare badarg from inside a write.
  ;
  ; A range error at the boundary is recoverable. A silent key collision
  ; is data loss.
  (are [n] (= :raised (try (do (datom.codec/encode-int n) :encoded)
                           (catch e :raised)))
    9223372036854775808
    -9223372036854775809
    99999999999999999999999)
  ; the boundaries themselves remain encodable
  (are [n] (= n (datom.codec/decode-int (datom.codec/encode-int n)))
    9223372036854775807
    -9223372036854775808))

(deftest a-string-containing-NUL-cannot-forge-a-component-boundary
  ; Components are terminated by 0x00, so a value CONTAINING 0x00 could
  ; impersonate two components: the string `a<NUL>Pfoo` encoded to exactly
  ; the same bytes as the components "a" then :foo.
  (let [nul-string (erlang/list_to_binary (to-list [97 0 80 102 111 111]))
        two-components (datom.codec/concat-bins
                         [(datom.codec/encode-value "a")
                          (datom.codec/encode-value :foo)])]
    (is (not (= two-components (datom.codec/encode-value nul-string))))))

(deftest escaping-preserves-string-order
  ; The escape must not disturb ordering, or it trades one silent bug for
  ; another.
  (let [nul (erlang/list_to_binary (to-list [97 0]))]
    (is (before? "a" nul) "a < a<NUL>")
    (is (before? nul "b"))))

(deftest floats-order-numerically-including-across-zero
  ; A float reaches the codec whenever an attribute has no :db/valueType
  ; (validation accepts anything). It used to fall through to
  ; term_to_binary, which orders by SERIALIZED SHAPE — so 10.0 sorted
  ; before 2.0 and a range predicate returned the wrong rows.
  (is (before? 2.0 10.0))
  (is (before? -5.0 -1.0) "negatives run backwards in raw IEEE bits")
  (is (before? -1.0 0.0) "the sign bit makes negatives look large")
  (is (before? 0.0 0.5))
  (is (before? -0.5 0.5)))
