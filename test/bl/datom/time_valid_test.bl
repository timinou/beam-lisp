; test/bl/datom/time_valid_test.bl — the VALID-time half of datom.time.
; Run: mix beam_lisp.test test/bl/datom/time_valid_test.bl
;
; The transaction-time half (as-of/since/history) is exercised by the EAV
; and time-travel tests. This pins the interval value type: construction,
; the half-open [from,to) contract, Allen's algebra, set operations, the
; #o reader, and the round-trip through a :db.type/time column.

(ns datom.time.valid.test
  (:require [datom] [datom.time :as time]))

;; ── construction & the half-open contract ───────────────────────────

(deftest resolutions-and-bounds
  ; one type, four resolutions; the upper bound advances one unit
  (is (= :year   (time/resolution (time/interval :year 2026))))
  (is (= :month  (time/resolution (time/interval :year 2026 :month 6))))
  (is (= :day    (time/resolution (time/interval :year 2026 :month 6 :day 15))))
  (is (= :second (time/resolution (time/interval :year 2026 :month 6 :day 15
                                                 :hour 14 :minute 30 :second 0))))
  ; a day is exactly 86400 seconds wide, half-open
  (is (= 86400 (time/width (time/interval :year 2026 :month 6 :day 15))))
  ; a leap-year February is 29 days; the half-open month proves it
  (is (= (* 29 86400) (time/width (time/interval :year 2024 :month 2))))
  ; a common-year February is 28
  (is (= (* 28 86400) (time/width (time/interval :year 2023 :month 2)))))

(deftest adjacency-concatenates
  ; the property that kills "end of day": the 15th ends where the 16th begins
  (let [d15 (time/interval :year 2026 :month 6 :day 15)
        d16 (time/interval :year 2026 :month 6 :day 16)]
    (is (= (time/to d15) (time/from d16)))
    (is (time/meets? d15 d16))
    (is (not (time/overlaps? d15 d16)))))       ; touching is not overlapping

;; ── Allen's 13 relations ────────────────────────────────────────────

(deftest allen-relations
  (let [morning   #o"2026-06-15T09/2026-06-15T12"
        midday    #o"2026-06-15T11/2026-06-15T14"
        afternoon #o"2026-06-15T13/2026-06-15T17"
        day       #o"2026-06-15"]
    (is (= :overlaps      (time/allen morning midday)))
    (is (= :precedes      (time/allen morning afternoon)))
    (is (= :overlapped-by (time/allen midday morning)))    ; inverse
    (is (= :contains      (time/allen day morning)))
    (is (= :during        (time/allen morning day)))
    (is (= :equals        (time/allen day #o"2026-06-15")))
    (is (= :meets         (time/allen day #o"2026-06-16")))
    (is (= :starts        (time/allen #o"2026-06-15T09/2026-06-15T10" morning)))
    ; derived predicate families
    (is (time/overlaps? morning midday))
    (is (time/disjoint? morning afternoon))
    (is (time/contains? day morning))
    (is (time/subset? morning day))))

(deftest allen-totality
  ; exactly one relation holds, and it is the inverse of the swap
  (let [a #o"2026-06-15T09/2026-06-15T12"
        b #o"2026-06-15T11/2026-06-15T14"]
    (is (= :overlaps (time/allen a b)))
    (is (= :overlapped-by (time/allen b a)))))

;; ── set algebra ─────────────────────────────────────────────────────

(deftest set-operations
  (let [work #o"2026-06-15T09/2026-06-15T17"
        mtg  #o"2026-06-15T10/2026-06-15T11"]
    ; intersection is the overlap
    (is (= mtg (time/intersect work mtg)))
    ; disjoint intervals do not intersect
    (is (nil? (time/intersect #o"2026-06-15T09/2026-06-15T10"
                              #o"2026-06-15T11/2026-06-15T12")))
    ; difference leaves the two gaps around the meeting
    (is (= 2 (count (time/subtract work mtg))))
    ; adjacency concatenates under union
    (is (= #o"2026-06-15T09/2026-06-15T17"
           (time/union #o"2026-06-15T09/2026-06-15T12"
                       #o"2026-06-15T12/2026-06-15T17")))
    ; a fully-covered interval subtracts to nothing
    (is (= [] (time/subtract mtg work)))))

;; ── the #o reader ───────────────────────────────────────────────────

(deftest reader-literals
  ; a literal equals the explicit construction
  (is (= (time/interval :year 2026 :month 6 :day 15) #o"2026-06-15"))
  (is (= (time/interval :year 2026) #o"2026"))
  (is (= (time/interval :year 2026 :month 6) #o"2026-06"))
  ; a closed interval `A/B` is [from(A), from(B)) — the end point exclusive
  (is (= (time/from #o"2026-06-15T09/2026-06-15T17")
         (time/from (time/interval :year 2026 :month 6 :day 15 :hour 9))))
  (is (= (time/to #o"2026-06-15T09/2026-06-15T17")
         (time/from (time/interval :year 2026 :month 6 :day 15 :hour 17))))
  ; a day range names the whole day: 2026-06-15/2026-06-16 == the 15th
  (is (= #o"2026-06-15" #o"2026-06-15/2026-06-16"))
  ; the AVET range-scan predicate
  (is (time/starts-before? #o"978/1016" #o"1000"))
  (is (not (time/starts-before? #o"1016/1035" #o"1000"))))

;; ── the round-trip through a :db.type/time column ───────────────────

(deftest stores-as-a-value
  (let [conn (datom/connect
               [{:db/ident :reign/of   :db/valueType :db.type/string}
                {:db/ident :reign/span :db/valueType :db.type/time}])]
    (datom/transact! conn [{:db/id -1 :reign/of "Aethelred" :reign/span #o"978/1016"}])
    (let [db   (datom/db conn)
          rows (datom/q '[:find ?s :where [?e :reign/span ?s]] db)
          span (first (first rows))]
      ; it round-trips bit-identically, like any value
      (is (= span #o"978/1016"))
      ; and answers a valid-time question after storage
      (is (time/overlaps? span #o"1015")))))
