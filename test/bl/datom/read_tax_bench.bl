; Bench: reductions per returned datom for datom.db/datoms. Run: BL_DAEMON=off ./bin/bl run test/bl/datom/read_tax_bench.bl
(ns datom.read-tax.bench
  (:require [datom.conn] [datom.db] [datom.time]))

(defn reds [] (erlang/element 2 (erlang/process_info (erlang/self) :reductions)))

(defn build [n]
  (let [c (datom.conn/connect
            [{:db/ident :e/name :db/valueType :db.type/string}
             {:db/ident :e/n :db/valueType :db.type/long}
             {:db/ident :e/state :db/valueType :db.type/long}])]
    (datom.conn/transact! c (mapv (fn [i] {:db/id (- (inc i)) :e/name (str "n" i) :e/n i :e/state 0}) (range n)))
    (let [ids (mapv (fn [d] (datom.index/-e d)) (datom.db/datoms (datom.conn/db c) :aevt :e/name))]
      (doseq [k (range 1 6)]
        (datom.conn/transact! c (mapv (fn [e] [:db/add e :e/state k]) ids))))
    c))

(let [c (build 1000)
      db (datom.conn/db c)
      m (fn [label f] (let [r0 (reds) res (f) r1 (reds)]
                        (println label (count res) "datoms" (- r1 r0) "reds" (quot (- r1 r0) (max 1 (count res))) "per-datom")))]
  (m "current eavt " (fn [] (datom.db/datoms db :eavt)))
  (m "current aevt state" (fn [] (datom.db/datoms db :aevt :e/state)))
  (m "history eavt " (fn [] (datom.db/datoms (datom.time/history db) :eavt)))
  (m "raw scan eavt" (fn [] (datom.index/scan (:store db) :eavt))))
