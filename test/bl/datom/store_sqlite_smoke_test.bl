; test/bl/datom/store_sqlite_smoke_test.bl — a standalone check of the SQLite
; substrate before it joins the shared conformance suite. Substrate-specific
; assertions (durability across reopen, the `.sqlite` file convention) live
; HERE; the protocol-only assertions live in conformance_test.bl and run
; against every backend unchanged.

(ns datom.store-sqlite.smoke.test
  (:require [datom.store] [datom.store-sqlite]))

(deftest nif-is-available
  (is (datom.store-sqlite/available?)
      "the datom_sqlite NIF must load for this suite to mean anything"))

(deftest get-put-round-trip
  (let [s (datom.store-sqlite/open-fresh)]
    (datom.store/-put s "k" 42)
    (is (= 42 (datom.store/-get s "k")))
    (is (nil? (datom.store/-get s "absent")))))

(deftest range-is-ordered-and-inclusive
  (let [s (datom.store-sqlite/open-fresh)]
    (doseq [k ["c" "a" "d" "b"]] (datom.store/-put s k k))
    (is (= ["a" "b" "c" "d"] (datom.store/range-keys s nil nil)))
    (is (= ["a" "b" "c"] (datom.store/range-keys s "a" "c")))
    (is (= ["b" "c" "d"] (datom.store/range-keys s "b" nil)))
    (is (= ["a" "b"] (datom.store/range-keys s nil "b")))))

(deftest commit-is-ordered-and-atomic
  (let [s (datom.store-sqlite/open-fresh)]
    (datom.store/-put s "old" 1)
    (datom.store/-commit s [[:put "x" 10] [:delete "old"] [:put "y" 20]])
    (is (= 10 (datom.store/-get s "x")))
    (is (= 20 (datom.store/-get s "y")))
    (is (nil? (datom.store/-get s "old")))
    ; retract-then-reassert must keep the value
    (datom.store/-commit s [[:delete "x"] [:put "x" 99]])
    (is (= 99 (datom.store/-get s "x")))))

(deftest update-is-atomic-counter
  ; A durable backend takes BINARY keys only (the datom layer encodes every
  ; key to an order-preserving binary before it reaches the store), so the
  ; counter key here is a binary, exactly as the real tx/entity counters are.
  (let [s (datom.store-sqlite/open-fresh)]
    (is (= 1 (datom.store/next-id s "tx-counter")))
    (is (= 2 (datom.store/next-id s "tx-counter")))
    (is (= 2 (datom.store/-get s "tx-counter")))))

(deftest values-of-any-shape-round-trip
  (let [s (datom.store-sqlite/open-fresh)]
    (datom.store/-put s "vec" [1 2 3])
    (datom.store/-put s "map" {:a 1})
    (datom.store/-put s "kw" :keyword)
    (is (= [1 2 3] (datom.store/-get s "vec")))
    (is (= {:a 1} (datom.store/-get s "map")))
    (is (= :keyword (datom.store/-get s "kw")))))

(deftest data-survives-reopen
  ; The property a durable backend exists for: reopen the SAME path and the
  ; data is still there. `sync!` forces the checkpoint so the bytes are on disk
  ; before the second handle opens.
  (let [path (datom.store/fresh-path ".sqlite")
        s1 (datom.store-sqlite/open path)]
    (datom.store/-put s1 "durable" [:still :here])
    (datom.store-sqlite/sync! s1)
    (let [s2 (datom.store-sqlite/open path)]
      (is (= [:still :here] (datom.store/-get s2 "durable"))
          "a value written, synced, then reopened is recovered"))))
