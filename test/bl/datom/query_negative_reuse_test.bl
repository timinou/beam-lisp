(ns datom.query-negative-reuse-test
 (:require [datom :as d] [datom.query.engine :as engine] [datom.query.parse :as parse]
           [datom.query.read-plan :as reads] [datom.profile :as profile]
           [datom.store-ets :as store] [data.bounded-cache :as cache]))
(def schema [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/blocked :db/valueType :db.type/boolean}
             {:db/ident :p/audit :db/valueType :db.type/string}])
(def query '[:find ?e :where [?e :p/name ?n] [:not [?e :p/blocked true]]])
(deftest a-negative-read-is-complete-evidence-even-when-the-result-is-empty
 (cache/clear! :datom.query.results)
 (let [s (profile/watch (store/open)) c (d/connect-with s schema)]
  (try
   (d/transact! c (mapv (fn [i] {:db/id i :p/name (str i) :p/blocked true}) (range 1 101)))
   (let [db (d/db c)]
    (doseq [_ (range 3)] (is (= #{} (d/q query db))))
    (let [before (profile/counters s)]
     (is (= #{} (d/q query db)))
     (is (= (:rows before) (:rows (profile/counters s)))))
    (d/transact! c [{:db/id 1 :p/audit "unrelated"}])
    (let [before (profile/counters s)]
     (is (= #{} (d/q query (d/db c))))
     (is (= (:rows before) (:rows (profile/counters s)))))
    (d/transact! c [[:db/retract 1 :p/blocked true]])
    (is (= #{[1]} (d/q query (d/db c))))
    (is (= #{} (d/q query db)))
    (is (nil? (Process/get :datom_query_scan_work))))
   (finally (d/close! c)))))
(deftest unknown-providers-and-functions-never-become-attribute-certificates
 (is (= #{:p/name :p/blocked} (set (reads/attributes (parse/parse query)))))
 (is (nil? (reads/attributes (parse/parse '[:find ?e :where [?e :p/name ?n] [(custom/check ?n)]]))))
 (is (nil? (reads/clause-attributes '[:not-join :bad [?e :p/name ?n]] 0)))
 (is (nil? (reads/clause-attributes '[:and [?e :p/name ?n]] 32))))
