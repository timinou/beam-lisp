(ns datom.profile-lifetime-test
 (:require [datom :as d] [datom.conn :as conn] [datom.profile :as profile]
           [datom.store :as store] [datom.store-ets :as ets-store]))
(deftest release-removes-global-native-store-retainers
 (let [s (ets-store/open) c (d/connect-with s) watched (profile/watch s)]
  (try
   (conn/guard! c :lifetime (fn [_] nil))
   (is (some (fn [ps] (= s (profile/watched ps))) (profile/watched-stores)))
   (let [before (profile/totals)]
    (store/-get watched :absent)
    (is (= 1 (:get (profile/delta before))))
    (d/release! c)
    (is (not (some (fn [ps] (= s (profile/watched ps))) (profile/watched-stores))))
    (is (nil? (profile/delta before)))
    (is (nil? (get (Agent/get conn/GUARD-REGISTRY (fn [reg] reg)) s))))
   ;; The caller can still use an explicitly held wrapper after retirement.
   (is (nil? (store/-get watched :absent)))
   (is (= 2 (:get (profile/counters watched))))
   (finally (d/release! c) (ets-store/close s)))))
(deftest instrumentation-registration-has-a-finite-node-wide-cap
 (let [s (ets-store/open)]
  (try
   (doseq [n (range 300)] (profile/watch s))
   (is (<= (count (profile/watched-stores)) 256))
   (profile/release-store! s)
   (is (not (some (fn [ps] (= s (profile/watched ps))) (profile/watched-stores))))
   (finally (ets-store/close s)))))
