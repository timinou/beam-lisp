; test/bl/datom/surface_test.bl — the forms that make queries writable.
;
; Everything here exists because SOMETHING cannot be expressed without
; it. That is the bar for adding to a query language: not "Datomic has
; it", but "here is a question you otherwise cannot ask".
;
;   :in binding forms   pass values IN without building query text
;   or-join / not-join  scope a sub-query's variables explicitly
;   pull recursion      walk a hierarchy of unknown depth
;   pull options        default / limit / rename
;
; Each test below names the question that was unaskable before.

(ns datom.surface.test
  (:require [datom.conn] [datom.db] [datom.pull] [datom.query.engine]))

(defn- people
  []
  (let [c (datom.conn/connect
            [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/age :db/valueType :db.type/long}
             {:db/ident :p/city :db/valueType :db.type/string}
             {:db/ident :p/email :db/valueType :db.type/string
              :db/unique :db.unique/identity}
             {:db/ident :p/phone :db/valueType :db.type/string}
             {:db/ident :p/friend :db/valueType :db.type/ref
              :db/cardinality :db.cardinality/many}])]
    (datom.conn/transact! c [{:db/id -1 :p/name "Ada" :p/age 36 :p/city "London"
                              :p/email "ada@example.com"}
                             {:db/id -2 :p/name "Grace" :p/age 45 :p/city "NY"
                              :p/phone "555-0100"}
                             {:db/id -3 :p/name "Alan" :p/age 41 :p/city "London"
                              :p/friend [-1 -2]}])
    c))

(defn- q [query db & inputs] (apply datom.query.engine/q query db (or inputs '())))

;; ── :in binding forms ───────────────────────────────────────────────

(deftest a-scalar-input-binds-one-value
  (let [db (datom.conn/db (people))]
    (is (= (set [["Ada"]])
           (q '[:find ?n :in $ ?age :where [?e :p/age ?age] [?e :p/name ?n]] db 36)))))

(deftest a-collection-input-is-how-you-write-IN
  ; `[?age ...]` produces ONE ROW PER VALUE. Without it, `WHERE age IN
  ; (36, 45)` has to be built by assembling query text or by running the
  ; query once per value and merging — the two things a data-as-code
  ; query language exists to avoid.
  (let [db (datom.conn/db (people))]
    (is (= (set [["Ada"] ["Grace"]])
           (q '[:find ?n :in $ [?age ...] :where [?e :p/age ?age] [?e :p/name ?n]]
              db [36 45])))
    (is (= (set [])
           (q '[:find ?n :in $ [?age ...] :where [?e :p/age ?age] [?e :p/name ?n]]
              db []))
        "an empty collection matches nothing, rather than everything")))

(deftest a-tuple-input-destructures-one-value
  (let [db (datom.conn/db (people))]
    (is (= (set [["Alan"]])
           (q '[:find ?n :in $ [?age ?city]
                :where [?e :p/age ?age] [?e :p/city ?city] [?e :p/name ?n]]
              db [41 "London"])))))

(deftest a-relation-input-joins-against-data-the-database-does-not-hold
  ; `[[?age ?city]]` is a TABLE passed in as an argument. This is how a
  ; query joins against ids from another service, a CSV, or a previous
  ; query's results — without that data ever being transacted.
  (let [db (datom.conn/db (people))]
    (is (= (set [["Ada"] ["Grace"]])
           (q '[:find ?n :in $ [[?age ?city]]
                :where [?e :p/age ?age] [?e :p/city ?city] [?e :p/name ?n]]
              db [[36 "London"] [45 "NY"]])))))

(deftest a-predicate-may-read-a-variable-bound-by-any-input-form
  ; Validation counted only SCALAR inputs as bound, so a predicate over a
  ; collection-bound variable looked like a predicate over nothing and
  ; the query was rejected as malformed.
  (let [db (datom.conn/db (people))]
    (is (= (set [["Grace"]])
           (q '[:find ?n :in $ [?age ...]
                :where [?e :p/age ?age] [?e :p/name ?n] [(> ?age 40)]]
              db [36 45])))))

(deftest input-arity-and-shape-are-checked
  (let [db (datom.conn/db (people))]
    (is (= :rejected
           (try (do (q '[:find ?n :in $ ?a :where [?e :p/name ?n]] db) :accepted)
                (catch e :rejected)))
        "a missing argument is an error, not a nil binding")
    (is (= :rejected
           (try (do (q '[:find ?n :in $ [?a ?b] :where [?e :p/name ?n]] db [1]) :accepted)
                (catch e :rejected)))
        "a tuple of the wrong width is an error")))

;; ── or-join / not-join ──────────────────────────────────────────────

(deftest or-join-expresses-what-plain-or-cannot
  ; Plain `:or` requires every branch to bind the SAME variables, because
  ; a row present in one branch and absent in another has no meaning.
  ; That rules out the common case: two branches reaching the same entity
  ; by different routes, each binding its own intermediate.
  ;
  ; `or-join` names the variables that escape; the rest are local.
  (let [db (datom.conn/db (people))]
    (is (= (set [["Ada"] ["Grace"]])
           (q '[:find ?n :where [?e :p/name ?n]
                [:or-join [?e]
                  [?e :p/email ?email]
                  [?e :p/phone ?phone]]]
              db))
        "reachable by email OR by phone, binding different variables")))

(deftest or-join-does-not-leak-its-local-variables
  (let [db (datom.conn/db (people))]
    ; If ?email escaped, the row count would change as later clauses
    ; constrained against it.
    (is (= 2 (count (q '[:find ?n :where [?e :p/name ?n]
                         [:or-join [?e] [?e :p/email ?email] [?e :p/phone ?phone]]]
                       db))))))

(deftest not-join-asks-whether-anything-matches-without-naming-it
  ; Plain `:not` needs every variable inside pre-bound. `not-join` scopes
  ; the negation to the shared variables, so you can say "this person has
  ; no friend" without introducing the friend to the outer query.
  (let [db (datom.conn/db (people))]
    (is (= (set [["Ada"] ["Grace"]])
           (q '[:find ?n :where [?e :p/name ?n]
                [:not-join [?e] [?e :p/friend ?f]]]
              db))
        "only Alan has friends")))

(deftest the-plain-forms-still-work
  ; The -join variants are additions, not replacements.
  (let [db (datom.conn/db (people))]
    ; Ada and Alan are both in London, so negation leaves Grace alone.
    (is (= (set [["Grace"]])
           (q '[:find ?n :where [?e :p/name ?n] [:not [?e :p/city "London"]]] db)))
    (is (= (set [["Ada"] ["Alan"]])
           (q '[:find ?n :where [?e :p/name ?n]
                [:or [?e :p/name "Ada"] [?e :p/name "Alan"]]]
              db)))))

;; ── pull recursion ──────────────────────────────────────────────────

(defn- chain
  "A four-deep management chain: L4 -> L3 -> L2 -> L1."
  []
  (let [c (datom.conn/connect
            [{:db/ident :e/name :db/valueType :db.type/string}
             {:db/ident :e/boss :db/valueType :db.type/ref}])
        r (datom.conn/transact! c [{:db/id -1 :e/name "L1"}
                                   {:db/id -2 :e/name "L2" :e/boss -1}
                                   {:db/id -3 :e/name "L3" :e/boss -2}
                                   {:db/id -4 :e/name "L4" :e/boss -3}])]
    {:db (datom.conn/db c) :bottom (get (:tempids r) -4)}))

(defn- chain-depth
  [m]
  (loop [x m d 0] (if (nil? (:e/boss x)) d (recur (:e/boss x) (+ d 1)))))

(deftest an-integer-spec-bounds-the-descent
  (let [f (chain)]
    (is (= 1 (chain-depth (datom.pull/pull (:db f) [:e/name {:e/boss 1}] (:bottom f)))))
    (is (= 2 (chain-depth (datom.pull/pull (:db f) [:e/name {:e/boss 2}] (:bottom f)))))))

(deftest the-ellipsis-spec-descends-until-nothing-is-left
  ; A hierarchy of UNKNOWN depth — an org chart, a comment thread, a
  ; category tree — cannot be pulled with a fixed pattern at all.
  (let [f (chain)]
    (is (= 3 (chain-depth (datom.pull/pull (:db f) [:e/name {:e/boss (quote ...)}]
                                           (:bottom f)))))))

(deftest a-cycle-terminates-instead-of-recurring-forever
  ; Cycles are ordinary, not exotic: mutual friendship is one, and so is
  ; any bidirectional edge. A revisited entity comes back as a bare
  ; `{:db/id N}` — it is already in the result further up, so repeating
  ; it would either loop forever or duplicate a subtree without end.
  (let [c (datom.conn/connect
            [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/pal :db/valueType :db.type/ref}])
        r (datom.conn/transact! c [{:db/id -1 :p/name "A"} {:db/id -2 :p/name "B"}])
        a (get (:tempids r) -1)
        b (get (:tempids r) -2)]
    (datom.conn/transact! c [[:db/add a :p/pal b] [:db/add b :p/pal a]])
    (let [result (datom.pull/pull (datom.conn/db c) [:p/name {:p/pal (quote ...)}] a)]
      (is (some? result) "it terminates at all")
      (is (= "B" (:p/name (:p/pal result))))
      (is (nil? (:p/name (:p/pal (:p/pal result))))
          "the revisited entity is a bare id, not another expansion"))))

(deftest a-self-reference-terminates-too
  (let [c (datom.conn/connect
            [{:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/pal :db/valueType :db.type/ref}])
        r (datom.conn/transact! c [{:db/id -1 :p/name "Solo"}])
        e (get (:tempids r) -1)]
    (datom.conn/transact! c [[:db/add e :p/pal e]])
    (is (some? (datom.pull/pull (datom.conn/db c) [:p/name {:p/pal (quote ...)}] e)))))

;; ── pull options ────────────────────────────────────────────────────

(deftest default-distinguishes-absent-from-assumed
  (let [f (people)
        db (datom.conn/db f)
        ada (datom.pull/lookup-ref db [:p/email "ada@example.com"])]
    (is (= "unknown" (:p/phone (datom.pull/pull db ['(default :p/phone "unknown")] ada)))
        "absent, and here is what to assume")
    (is (= "Ada" (:p/name (datom.pull/pull db ['(default :p/name "unknown")] ada)))
        "a present value is untouched")))

(deftest limit-bounds-an-unbounded-read
  ; Without it, pulling an entity with a million inbound references is
  ; one unbounded read that no caller asked for.
  (let [db (datom.conn/db (people))
        alan (first (first (q '[:find ?e :where [?e :p/name "Alan"]] db)))]
    (is (= 1 (count (:p/friend (datom.pull/pull db ['(limit :p/friend 1)] alan)))))
    (is (= 2 (count (:p/friend (datom.pull/pull db ['(limit :p/friend 99)] alan))))
        "a limit above the count returns everything, not an error")))

(deftest as-renames-a-key-for-the-consumer
  (let [db (datom.conn/db (people))
        ada (datom.pull/lookup-ref db [:p/email "ada@example.com"])
        result (datom.pull/pull db ['(:p/name :as :name)] ada)]
    (is (= "Ada" (:name result)))
    (is (nil? (:p/name result)) "renamed, not duplicated")))

(deftest a-recursive-pull-uses-the-SAME-pattern-at-every-level
  ; `{:attr ...}` means "this shape, and so on downward". Taking every
  ; attribute at the recursive level instead leaked fields the pattern
  ; never asked for \u2014 a data-exposure bug rather than a cosmetic one,
  ; since a pull pattern is exactly how a caller states which fields
  ; they are entitled to see.
  (let [c (datom.conn/connect
            [{:db/ident :e/name :db/valueType :db.type/string}
             {:db/ident :e/secret :db/valueType :db.type/string}
             {:db/ident :e/boss :db/valueType :db.type/ref}])
        r (datom.conn/transact! c [{:db/id -1 :e/name "L1" :e/secret "classified"}
                                   {:db/id -2 :e/name "L2" :e/secret "also" :e/boss -1}])
        result (datom.pull/pull (datom.conn/db c)
                                [:e/name {:e/boss (quote ...)}]
                                (get (:tempids r) -2))]
    (is (= "L2" (:e/name result)))
    (is (= "L1" (:e/name (:e/boss result))))
    (is (nil? (:e/secret result)) "not asked for at the top level")
    (is (nil? (:e/secret (:e/boss result)))
        "and not leaked at the recursive level either")))
