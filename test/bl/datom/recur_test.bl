; test/bl/datom/recur_test.bl — recurrence, and the thing cron cannot say.
; Run: bl test test/bl/datom/recur_test.bl
;
; The cases here are chosen for what they BREAK, not for coverage. Each is one
; of the ways a recurrence engine can be plausibly, periodically, silently
; wrong: an ordinal weekday (which the field model cannot express at all), a
; month that lacks the day a rule names, February the 29th, two spellings of one
; set that must agree, and a rule that must be refused rather than approximated.
;
; Timestamps are seconds, and they are LITERALS so the assertion and the date
; are checkable against a calendar by eye:
;
;   1548979200  2019-02-01        a Friday, and the anchor below
;   1550793600  2019-02-22        February 2019 has four Fridays; this is the last
;   1553817600  2019-03-29        March 2019's last Friday — the 29th
;   1567123200  2019-08-30        August 2019's last Friday — the 30th
;   1709164800  2024-02-29        a leap day
;
; The 2019-02 case is the load-bearing one. Cron's day-of-week and day-of-month
; fields intersect, so the only way to write "the last Friday" is to intersect
; Friday with a day RANGE — `0 0 24-31 * 5` is the one everybody writes — and it
; misses whenever the last Friday falls before the 24th. Measured over
; 2015-2030: 5 of 192 months, every one of them a February. February 2019 is one
; of the five.

; The refer list below IS the DSL's visibility: bringing those words in is what
; makes a rule read as the sentence. `next`, `prev`, `validate` and `explain` stay
; qualified — `next` because BL's core already has one, the rest because they are
; the model's verbs rather than the sentence's words.
(ns datom.recur.test
  (:require [datom.recur :as recur
             :refer [rule on at in day every times until starting lasting
                     taking weeks-start preview count-in occurrences]]
            [datom.time :as time]))

(def ^:private YEAR (* 366 86400))

(defn- starts
  "The start instants of a rule's occurrences in [from, to)."
  [r from to]
  (mapv time/from (recur/occurrences r from to)))

(defn- message-of
  "The text a refusal carries. A refusal that does not say anything is the
   failure this helper exists to make visible."
  [f]
  (try
    (f)
    nil
    (catch e (str e))))

(defn- mentions?
  "Whether a refusal names a thing. The refusals in this namespace are written
   so that the fix is IN the message — the accepted set, the offending key — and
   this is how that is held to."
  [s needle]
  (clojure.string/includes? s needle))

(defn- ascending?
  "Whether `xs` is in ascending order. BL's `sort` yields a LIST while these
   helpers build VECTORS, and `=` is type-strict, so `(= (sort xs) xs)` can
   never hold however sorted the data is; compare the sorted vector instead."
  [xs]
  (= (vec (sort xs)) xs))

;; datom.time/day-of-week answers 0=Sunday … 6=Saturday — an INTEGER, its own
;; documented convention, not a keyword; Friday is therefore 5.
(def ^:private FRIDAY 5)

;; ── the ordinal weekday, which a field model cannot say ─────────────

(deftest the-last-friday-is-found-in-a-month-where-the-cron-hack-misses
  (let [r (recur/rule :month (recur/on :friday :last) (recur/starting 1548979200))]
    (is (= 1550793600 (time/from (recur/next r (dec 1550793600))))
        "February 2019's last Friday is the 22nd — day < 24, so 24-31 * 5 skips it")
    (is (= 1553817600 (time/from (recur/next r (dec 1553817600))))
        "March 2019's is the 29th")
    (is (= 1567123200 (time/from (recur/next r (dec 1567123200))))
        "August 2019's is the 30th")))

(deftest the-last-friday-is-one-per-month-not-a-day-range
  ; The property the day-range hack destroys: exactly one, every month, and
  ; always the LAST one. A range either misses a month or fires twice.
  (let [r (recur/rule :month (recur/on :friday :last) (recur/starting 1548979200))
        xs (starts r 1548979200 (+ 1548979200 YEAR))]
    (is (= 12 (count xs)) "twelve months, twelve occurrences")
    (is (ascending? xs) "ascending")
    (is (every? (fn [s] (= FRIDAY (time/day-of-week s))) xs) "every one is a Friday")
    (is (every? (fn [s] (not= (:month (time/date-parts s))
                              (:month (time/date-parts (+ s (* 7 86400))))))
                xs)
        "never a Friday twice in one month — the NEXT Friday is a different month")))

(deftest two-spellings-of-the-last-friday-agree
  ; BYDAY's ordinal and BYSETPOS select from the same set, and RFC 5545 has both.
  ; A second code path for the second spelling is how a calendar grows two
  ; answers to one question, so this asserts they are ONE set.
  (let [a (recur/rule :month (recur/on :friday :last) (recur/starting 1548979200))
        b (recur/rule :month (recur/on :friday) (recur/taking :last) (recur/starting 1548979200))
        w 1548979200
        u (+ 1548979200 YEAR)]
    (is (= (starts a w u) (starts b w u)))))

(deftest an-ordinal-weekday-needs-a-monthly-or-yearly-rule
  ; RFC 5545 forbids it elsewhere, and the honest response is a refusal that
  ; says so — never a rule that parses and quietly means a different set.
  (let [m1 (message-of (fn [] (recur/rule :week (recur/on :friday :last))))
        m2 (message-of (fn [] (recur/rule :week 2 (recur/on :friday :last))))]
    (is (some? m1) "a WEEKLY rule with an ordinal is refused")
    (is (mentions? m1 "MONTHLY") "…and names MONTHLY")
    (is (mentions? m1 "RFC 5545") "…and cites the rule it is enforcing")
    (is (mentions? m2 "MONTHLY") "…the same, with the interval spelled out")))

;; ── a month that does not have the day ─────────────────────────────

(deftest a-month-without-the-31st-simply-has-no-occurrence
  ; Not clamped, not shifted, not fired on the 30th: absent. Clamping is a
  ; POLICY (and a reasonable one) but it is not what the rule says, and it must
  ; be a decision someone makes, not a thing the engine does quietly.
  (let [r (recur/rule :month (day 31) (recur/starting 1548979200))
        xs (starts r 1548979200 (+ 1548979200 YEAR))]
    (is (= 7 (count xs))
        "one year from 2019-02-01: the seven 31-day months, and NOT February")
    (is (= 7 (recur/count-in r 1548979200 (+ 1548979200 YEAR)))
        "count-in answers from the same set")
    (is (ascending? xs) "ascending")))

(deftest february-29-exists-only-in-a-leap-year
  (let [r (recur/rule :year (in :february) (day 29))
        xs (starts r 0 1790000000)]
    (is (>= (count xs) 1))
    (is (contains? (set xs) 1709164800) "2024-02-29 is in the set")
    (is (= 1709164800 (last xs))
        "…and it is the LAST one before 2026-09: no 28th was ever substituted for a
         29th, and 2025-02 has no 29th to give")))

;; ── the walk ───────────────────────────────────────────────────────

(deftest next-and-occurrences-come-from-the-same-walk
  ; The property the whole namespace rests on: a preview and a firing cannot
  ; disagree, because there is one scan. If these two ever differ, a screen is
  ; showing an instant the wheel will not fire.
  (let [r (recur/rule :week 2 (recur/on :monday) (recur/at 8 0) (recur/starting 1548979200))
        w 1548979200
        u (+ w YEAR)
        xs (starts r w u)]
    (is (= xs (loop [acc [] cursor (dec w)]
                (if (>= (count acc) (count xs))
                  acc
                  (if-let [iv (recur/next r cursor)]
                    (recur (conj acc (time/from iv)) (time/from iv))
                    acc)))))))

(deftest next-is-strictly-after
  (let [r (recur/rule :day (recur/at 6 0) (recur/starting 1548979200))
        first* (time/from (recur/next r 1548979200))]
    (is (> first* 1548979200) "an occurrence equal to the cursor is not the next one")))

(deftest an-unbounded-rule-is-refused-and-says-why
  ; A set needs an upper bound. The refusal names the distinction rather than
  ; throwing a nil into a comparison 400 years later.
  (let [m (message-of (fn [] (recur/occurrences (recur/rule :day) 0 nil)))]
    (is (some? m))
    (is (mentions? m "upper bound")
        "…and explains that an unbounded rule is a wheel, not a set")))

;; ── refusals, by name ──────────────────────────────────────────────

(deftest an-unsupported-rrule-part-is-refused-instead-of-dropped
  ; The failure this prevents: BYYEARDAY silently ignored, so a rule meant for
  ; the 100th day of the year fires every day. Dropping a part is NEVER right.
  (let [m (message-of (fn [] (recur/parse-rrule "FREQ=YEARLY;BYYEARDAY=100")))]
    (is (some? m))
    (is (mentions? m "BYYEARDAY") "names the part")))

(deftest an-unknown-rule-key-names-itself-and-the-accepted-set
  (let [m (message-of (fn [] (recur/rule :month {:concurency 2})))]
    (is (some? m) "a typo in a rule key is a loud failure, not a default")
    (is (mentions? m "concurency") "…naming the key")))

(deftest count-and-until-cannot-both-bound-a-rule
  (let [m (message-of (fn [] (recur/rule :day (recur/times 3) (recur/until 1767225600))))]
    (is (some? m) "RFC 5545 forbids both, and so does this")))

(deftest at-and-its-expansion-cannot-both-be-given
  ; (at 9 30) expands to BYHOUR/BYMINUTE. Naming both is ambiguous, and an
  ; ambiguous rule is refused rather than resolved by precedence.
  (let [m (message-of (fn [] (recur/rule :day (recur/at 9 30) {:byhour [10]})))]
    (is (some? m))))

(deftest a-part-that-is-not-a-part-is-refused-with-the-list
  (let [m (message-of (fn [] (recur/rule :month (recur/on :friday) :last)))]
    (is (some? m))
    (is (mentions? m "selector")
        "the refusal names the accepted shapes, so the fix is in the message")))

(deftest an-ordinal-word-that-is-not-one-names-the-words
  (let [m (message-of (fn [] (recur/rule :month (recur/on :friday :sometime))))]
    (is (some? m))
    (is (mentions? m "last")
        "…listing the ordinals, including last")))

;; ── the model is data, and stable ──────────────────────────────────

(deftest the-sentence-and-the-map-are-the-same-value
  ; The surface is a spelling, not a second model: both routes land in
  ; `validate`, and the values are equal. This is what makes it safe to store a
  ; rule, read it back, and hand it to a solver.
  (is (= (recur/rule :month (recur/on :friday :last) (recur/at 9 30))
         (recur/validate {:freq :monthly :byday [[:friday -1]] :at [9 30]}))))

(deftest validating-twice-changes-nothing
  ; `validate` normalises, and every function in the namespace calls it, so a
  ; normalisation that is not idempotent would make the SECOND call disagree
  ; with the first — i.e. `(next rule …)` and `(occurrences rule …)` would use
  ; different rules.
  (let [once (recur/rule :week 2 (recur/on :monday) (recur/at 8 0))]
    (is (= once (recur/validate once)))))

(deftest a-bare-integer-part-is-the-interval
  (is (= 2 (:interval (recur/rule :week 2 (recur/on :monday)))))
  (is (= (:interval (recur/rule :week 2 (recur/on :monday)))
         (:interval (recur/rule :week (recur/every 2) (recur/on :monday))))
      "the sugar and the explicit form are one value"))

(deftest long-and-short-frequency-words-are-one-frequency
  (is (= (:freq (recur/rule :monthly)) (:freq (recur/rule :month))))
  (is (= (:freq (recur/rule :years)) (:freq (recur/rule :yearly)))))

(deftest an-occurrence-is-an-interval-not-an-instant
  ; A recurrence that produced bare instants would lose the reason `datom.time`
  ; exists. `lasting` is how a rule says how long its occurrence is; without it
  ; the width is one unit of the rule's resolution.
  (let [with-duration (recur/rule :day (recur/at 6 0) (recur/lasting 1800) (recur/starting 1548979200))
        iv (first (recur/occurrences with-duration 1548979200 (+ 1548979200 86400)))]
    (is (= 1800 (time/width iv))))
  (let [bare (recur/rule :day (recur/starting 1548979200))
        iv (first (recur/occurrences bare 1548979200 (+ 1548979200 86400)))]
    (is (= 86400 (time/width iv)) "a daily rule without :at is a day wide")))

(deftest an-rrule-round-trips-through-the-interchange
  ; RRULE is the wire format, not the model: what we PARSE must be what we
  ; EMIT, or the rule that leaves this system is not the rule that runs in it.
  (let [r (recur/parse-rrule "FREQ=MONTHLY;INTERVAL=2;BYDAY=-1FR;BYHOUR=9;BYMINUTE=30")
        back (recur/parse-rrule (recur/->rrule r))]
    (is (= (:freq r) (:freq back)))
    (is (= (:interval r) (:interval back)))
    (is (= (:byday r) (:byday back)))
    (is (= (:byhour r) (:byhour back)))
    (is (= (:byminute r) (:byminute back)))))

;; ── the two questions a person actually asks ───────────────────────

(deftest why-names-the-selector-that-admitted-an-instant
  ; At 03:00 the only question is "why did this run". A rule string cannot
  ; answer it; a rule as data can, because the scan knows which selector matched.
  (let [r (recur/rule :month (recur/on :friday :last) (recur/starting 1548979200))
        w (recur/why r 1550793600)]
    (is (= true (:matched w)) "2019-02-22 is an occurrence")
    (is (= :occurrence (:tag w)))
    (is (string? (:text w))))
  (let [r (recur/rule :month (recur/on :friday :last) (recur/starting 1548979200))
        n (recur/why r 1550707200)]
    (is (= false (:matched n)) "2019-02-21 is a Thursday and is not one")
    (is (some? (:reason n)) "…and the reason is a value, not a sentence to parse")))

(deftest explain-reads-as-english-with-the-structure-kept
  (let [e (recur/explain (recur/rule :month (recur/on :friday :last) (recur/at 9 30)))]
    (is (= :recurrence (:tag e)))
    (is (string? (:summary e)))
    (is (some? (:rule e)) "the normalised rule rides along")
    (is (some? (first (filter (fn [c] (= :byday (:tag c))) (:clauses e))))
        "the byday clause is tagged, so a UI renders structure rather than re-parsing text")))

(deftest preview-is-the-next-n-and-it-is-the-same-walk
  (let [r (recur/rule :week (recur/on :monday) (recur/at 8 0) (recur/starting 1548979200))
        p (recur/preview r 1548979200 5)]
    (is (= 5 (count p)))
    (is (ascending? (mapv time/from p)) "ascending")
    (is (= (time/from (recur/next r 1548979200)) (time/from (first p)))
        "the first of the preview IS what next fires")
    (is (= 6 (recur/count-in r 1548979200 (+ 1548979200 (* 40 86400))))
        ; 40 days on from Friday 2019-02-01 reach 2019-03-13; the Mondays at
        ; 08:00 inside are Feb 4, 11, 18, 25 and Mar 4, 11 — six, not five.
        "count-in answers from the same set")))
