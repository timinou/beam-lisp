; test/bl/datom/corpus_cache_test.bl — the derived embedding-column cache.
; Run: bl test test/bl/datom/corpus_cache_test.bl
;
; datom.query.corpus memoises the assembled `[[entity dvec] …]` corpus of an
; embedding column, keyed by (store, attr) and validated against the db's
; basis/filter/since. These tests are its oracle for the properties a datom
; cache must never violate:
;   1. a HIT returns the SAME corpus a fresh assembly would — and the query
;      built on it returns bit-identical rows in bit-identical order;
;   2. a basis advance (any transaction) MISSES — the cache can never serve
;      datoms from a basis the caller is not reading;
;   3. under a byte budget, memory stays bounded and eviction is LRU.

(ns datom.corpus-cache.test
  (:require [datom :as d] [datom.vector :as v] [datom.index]
            [datom.query.corpus :as corpus] [datom.db] [datom.attr-basis]))

(def BIG-BUDGET (* 512 1024 1024))

(defn- fresh-conn []
  (d/connect [{:db/ident :vec :db/valueType :db.type/vector}
              {:db/ident :tag :db/valueType :db.type/string}]))

(defn- vec-conn-with [n]
  (let [c (fresh-conn)]
    (d/transact! c (mapv (fn [i]
                           {:db/id (- (+ i 1))
                            :vec (v/embedding [(* 0.1 i) (* 0.01 i) (- 1.0 (* 0.02 i))])})
                         (range n)))
    (d/db c)))

(def Q '[:find ?e ?s :in $ ?q :where [(similar-to :vec ?q 3) [?e ?s]]])

;; ── correctness: hits, assembly equality, invalidation ────────────────

(deftest a-hit-preserves-rows-and-order
  (corpus/forget!)
  (corpus/set-budget! BIG-BUDGET)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :vec (v/embedding [0.0 1.0 0.0])}
                    {:db/id -3 :vec (v/embedding [0.9 0.1 0.0])}])
    (let [db (d/db c)
          q (v/embedding [1.0 0.0 0.0])
          cold (d/q Q db q)
          _ (is (= 1 (:columns (corpus/stats))) "one column resident after first eval")
          warm (d/q Q db q)]
      (is (= cold warm) "a warm eval returns the identical result set")
      (is (= 1 (:columns (corpus/stats))) "no second column — the warm eval hit")
      (is (= 3 (:rows (corpus/stats))) "the resident corpus holds all three rows"))))

(deftest a-corpus-hit-equals-a-fresh-assembly
  ; The cached column must equal what a direct, uncached assembly produces:
  ; same entities, same DVec values, same order.
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [0.1 0.2 0.3])}
                    {:db/id -2 :vec (v/embedding [0.4 0.5 0.6])}])
    (let [db (d/db c)
          direct (filterv some?
                          (mapv (fn [dat]
                                  (let [e (datom.index/-e dat) val (datom.index/-v dat)]
                                    (if (v/vec? val) [e val] nil)))
                                (datom.db/attr-datoms db :vec)))
          cached (corpus/column db :vec)]
      (is (= direct cached) "the cached corpus equals a fresh assembly"))))

(deftest a-transaction-invalidates
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :vec (v/embedding [0.0 1.0 0.0])}])
    (let [db1 (d/db c)]
      (corpus/column db1 :vec)
      (is (= 2 (:rows (corpus/stats))) "two rows cached at the first basis")
      ; a new datom advances the basis: the OLD db1 must still see 2 (its basis),
      ; and a read at the NEW basis must see 3 — the cache overwrites the slot.
      (d/transact! c [{:db/id -3 :vec (v/embedding [0.0 0.0 1.0])}])
      (let [db2 (d/db c)]
        (is (= 2 (count (corpus/column db1 :vec))) "the old basis still sees two rows")
        (is (= 3 (count (corpus/column db2 :vec))) "the new basis sees three rows")
        (is (= 3 (:rows (corpus/stats))) "the slot now holds the newer, larger corpus")))))

(deftest packed-search-equals-pair-search
  ; The hot path uses datom.query.corpus/packed + vector/search-packed; it must
  ; return exactly what the pair path (column + vector/search) returns.
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :vec (v/embedding [0.0 1.0 0.0])}
                    {:db/id -3 :vec (v/embedding [0.9 0.1 0.0])}
                    {:db/id -4 :vec (v/embedding [0.2 0.9 0.1])}])
    (let [db (d/db c)
          q (v/embedding [1.0 0.0 0.0])
          via-pairs (v/search q (corpus/column db :vec) 3 0)
          via-packed (v/search-packed q (corpus/packed db :vec) 3 0)]
      (is (= via-pairs via-packed) "packed search is bit-identical to pair search")
      (is (= 4 (v/packed-count (corpus/packed db :vec))) "packed corpus holds every row"))))

(deftest resident-search-equals-pair-search
  ; The hot path now uses datom.query.corpus/resident + vector/search-resident
  ; (native decoded+quantised index). It must return exactly what the pair path
  ; returns, at both exact (rerank 0) and quantised (rerank>0) widths.
  (corpus/forget!)
  (let [db (vec-conn-with 20)
        q (v/embedding [0.5 0.1 0.2])
        via-pairs-exact (v/search q (corpus/column db :vec) 5 0)
        via-resident-exact (v/search-resident q (corpus/resident db :vec) 5 0)
        via-pairs-quant (v/search q (corpus/column db :vec) 5 200)
        via-resident-quant (v/search-resident q (corpus/resident db :vec) 5 200)]
    (is (= via-pairs-exact via-resident-exact) "resident exact == pair exact")
    (is (= via-pairs-quant via-resident-quant) "resident quantised == pair quantised")
    (is (= 20 (v/resident-count (corpus/resident db :vec))) "resident holds every row")))

(deftest a-mistyped-value-is-skipped-not-fatal
  (corpus/forget!)
  (let [c (fresh-conn)]
    ; :tag is a string column; nothing embeds there, so the vec corpus stays empty
    ; and a non-DVec value never reaches the corpus.
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :tag "not-a-vector"}])
    (let [db (d/db c)]
      (is (= 1 (count (corpus/column db :vec))) "only the one real embedding is in the corpus"))))

;; ── memory bound: budget, eviction, recency (PLAN-132 Phase 4) ────────

(deftest a-budget-bounds-resident-memory
  ; With a tiny budget, caching many distinct columns must not grow without
  ; bound: total bytes stays near the soft budget (each column here is small),
  ; and evictions are counted.
  (corpus/forget!)
  (corpus/set-budget! 3000)
  (let [dbs (mapv (fn [_] (vec-conn-with 25)) (range 8))]
    (doseq [db dbs] (corpus/column db :vec))
    (let [s (corpus/stats)]
      (is (<= (:bytes s) 6000) "total bytes held stays near the soft budget")
      (is (> (:evictions s) 0) "columns past the budget were evicted")
      (is (< (:columns s) 8) "not all eight columns are resident at once")))
  (corpus/set-budget! BIG-BUDGET))

(deftest lru-evicts-under-pressure
  ; Under a budget that holds ~1.5 small columns, building a third column while
  ; over budget forces an eviction; the cache stays bounded and correct.
  (corpus/forget!)
  (let [a (vec-conn-with 20)]
    (corpus/column a :vec)
    (let [one (:bytes (corpus/stats))]
      (corpus/set-budget! (+ one (quot one 2)))
      (corpus/column (vec-conn-with 20) :vec)  ; A + B over budget -> evict
      (corpus/column a :vec)                    ; refresh A's recency
      (corpus/column (vec-conn-with 20) :vec)  ; more pressure
      (let [s (corpus/stats)]
        (is (> (:evictions s) 0) "pressure caused an eviction")
        (is (<= (:bytes s) (* 2 one)) "memory stays within the soft budget"))))
  (corpus/set-budget! BIG-BUDGET))

(deftest a-hit-does-not-grow-the-cache
  ; A repeated read (hit) on an existing entry must not add a column or change
  ; the row count — it only stamps a fresh access time.
  (corpus/forget!)
  (corpus/set-budget! BIG-BUDGET)
  (let [db (vec-conn-with 20)]
    (corpus/column db :vec)
    (is (= 1 (:columns (corpus/stats))) "one column resident")
    (corpus/column db :vec)
    (is (= 1 (:columns (corpus/stats))) "a hit does not add a column")
    (is (= 20 (:rows (corpus/stats))) "a hit does not change the row count")))

;; ── attribute-scoped invalidation ─────────────────────────────────────
;;
;; A corpus is a snapshot of ONE attribute. A rebuild per unrelated write is
;; what made a hand-rolled SECOND cache necessary in the application that
;; first needed this (knowledger): on its 64 708-row embedding column,
;; decode+quantise is 5.3 s + 2.1 s, paid again for every audit row, label
;; and title written. The discriminator is the ATTRIBUTE's basis, recorded
;; by the connection from the same `changed-attrs` set the subscriptions
;; use.

(defn- vec+tag-conn []
  (d/connect [{:db/ident :vec :db/valueType :db.type/vector}
              {:db/ident :tag :db/valueType :db.type/string}]))

(deftest an-unrelated-write-does-not-invalidate-a-column
  (corpus/forget!)
  (corpus/set-budget! BIG-BUDGET)
  (let [c (vec+tag-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0]) :tag "a"}])
    (let [db1 (d/db c)
          first-rows (corpus/column db1 :vec)]
      ; a write to a DIFFERENT attribute advances the store basis
      (d/transact! c [{:db/id -2 :tag "b"}])
      (let [db2 (d/db c)]
        (is (> (datom.db/basis-t db2) (datom.db/basis-t db1)) "the basis moved")
        (is (= (into [] first-rows) (into [] (corpus/column db2 :vec)))
            "but the column's corpus is the SAME rows — not reassembled")
        ; and a write to the column's OWN attribute still invalidates
        (d/transact! c [{:db/id -3 :vec (v/embedding [0.0 1.0 0.0])}])
        (is (= 2 (count (corpus/column (d/db c) :vec))) "its own write does rebuild")))))

(deftest an-unknown-attribute-reads-as-changed
  ; `forget!` (or a store handle the connection never recorded) must NOT be
  ; read as "nothing changed" — that would serve a corpus the caller is not
  ; reading. Unknown ⇒ the store's basis ⇒ a rebuild.
  (corpus/forget!)
  (datom.attr-basis/forget!)
  (let [c (vec+tag-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}])
    (let [db (d/db c)]
      (is (= 1 (count (corpus/column db :vec))))
      (datom.attr-basis/forget!)
      (is (= 1 (count (corpus/column db :vec))) "still correct after the map is dropped"))))

