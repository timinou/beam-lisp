; test/bl/datom/corpus_cache_test.bl — the derived embedding-column cache.
; Run: bl test test/bl/datom/corpus_cache_test.bl
;
; datom.query.corpus memoises the assembled `[[entity dvec] …]` corpus of an
; embedding column, keyed by (store, attr) and validated against the db's
; basis/filter/since. These tests are its oracle for the properties a datom
; cache must never violate:
;   1. a HIT returns the SAME corpus a fresh assembly would — and the query
;      built on it returns bit-identical rows in bit-identical order;
;   2. a basis advance (any transaction) MISSES — the cache can never serve
;      datoms from a basis the caller is not reading;
;   3. a history / since view does not collide with the current view.

(ns datom.corpus-cache.test
  (:require [datom :as d] [datom.vector :as v] [datom.index]
            [datom.query.corpus :as corpus] [datom.db]))

(defn- fresh-conn []
  (d/connect [{:db/ident :vec :db/valueType :db.type/vector}
              {:db/ident :tag :db/valueType :db.type/string}]))

(def Q '[:find ?e ?s :in $ ?q :where [(similar-to :vec ?q 3) [?e ?s]]])

(deftest a-hit-preserves-rows-and-order
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :vec (v/embedding [0.0 1.0 0.0])}
                    {:db/id -3 :vec (v/embedding [0.9 0.1 0.0])}])
    (let [db (d/db c)
          q (v/embedding [1.0 0.0 0.0])
          cold (d/q Q db q)
          _ (is (= 1 (:columns (corpus/stats))) "one column resident after first eval")
          warm (d/q Q db q)]
      (is (= cold warm) "a warm eval returns the identical result set")
      (is (= 1 (:columns (corpus/stats))) "no second column — the warm eval hit")
      (is (= 3 (:rows (corpus/stats))) "the resident corpus holds all three rows"))))

(deftest a-corpus-hit-equals-a-fresh-assembly
  ; The cached column must equal what a direct, uncached assembly produces:
  ; same entities, same DVec values, same order.
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [0.1 0.2 0.3])}
                    {:db/id -2 :vec (v/embedding [0.4 0.5 0.6])}])
    (let [db (d/db c)
          direct (filterv some?
                          (mapv (fn [dat]
                                  (let [e (datom.index/-e dat) val (datom.index/-v dat)]
                                    (if (v/vec? val) [e val] nil)))
                                (datom.db/attr-datoms db :vec)))
          cached (corpus/column db :vec)]
      (is (= direct cached) "the cached corpus equals a fresh assembly"))))

(deftest a-transaction-invalidates
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :vec (v/embedding [0.0 1.0 0.0])}])
    (let [db1 (d/db c)]
      (corpus/column db1 :vec)
      (is (= 2 (:rows (corpus/stats))) "two rows cached at the first basis")
      ; a new datom advances the basis: the OLD db1 must still see 2 (its basis),
      ; and a read at the NEW basis must see 3 — the cache overwrites the slot.
      (d/transact! c [{:db/id -3 :vec (v/embedding [0.0 0.0 1.0])}])
      (let [db2 (d/db c)]
        (is (= 2 (count (corpus/column db1 :vec))) "the old basis still sees two rows")
        (is (= 3 (count (corpus/column db2 :vec))) "the new basis sees three rows")
        (is (= 3 (:rows (corpus/stats))) "the slot now holds the newer, larger corpus")))))

(deftest packed-search-equals-pair-search
  ; The hot path uses datom.query.corpus/packed + vector/search-packed; it must
  ; return exactly what the pair path (column + vector/search) returns.
  (corpus/forget!)
  (let [c (fresh-conn)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :vec (v/embedding [0.0 1.0 0.0])}
                    {:db/id -3 :vec (v/embedding [0.9 0.1 0.0])}
                    {:db/id -4 :vec (v/embedding [0.2 0.9 0.1])}])
    (let [db (d/db c)
          q (v/embedding [1.0 0.0 0.0])
          via-pairs (v/search q (corpus/column db :vec) 3 0)
          via-packed (v/search-packed q (corpus/packed db :vec) 3 0)]
      (is (= via-pairs via-packed) "packed search is bit-identical to pair search")
      (is (= 4 (v/packed-count (corpus/packed db :vec))) "packed corpus holds every row"))))

(deftest a-mistyped-value-is-skipped-not-fatal
  (corpus/forget!)
  (let [c (fresh-conn)]
    ; :tag is a string column; nothing embeds there, so the vec corpus stays empty
    ; and a non-DVec value never reaches the corpus.
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0 0.0])}
                    {:db/id -2 :tag "not-a-vector"}])
    (let [db (d/db c)]
      (is (= 1 (count (corpus/column db :vec))) "only the one real embedding is in the corpus"))))
