; test/bl/datom/excise_test.bl — excision, the deliberate hole (PLAN-115 W6).
; Run: bl test test/bl/datom/excise_test.bl
;
; datom's history is otherwise append-only: a retraction TOMBSTONES a fact but
; leaves it reproducible through `history`/`as-of`. EXCISION is the deliberate
; exception — it physically removes datoms from every index AND from history, so
; the fact becomes unrecoverable. It exists for legal erasure (GDPR right-to-be-
; forgotten) and for shedding data an append-only store should never have kept.
; datahike's :db/purge* projects onto `excise!`. The contract these pin:
;   1. retractEntity keeps history; excise does NOT (the whole distinction),
;   2. excise removes from EVERY index (a value lookup no longer finds it),
;   3. :attr excision removes one attribute, leaving the rest of the entity.
; See docs/trust-boundary.md for the audit-guarantee exception this documents.

(ns datom.excise.test
  (:require [datom.conn] [datom.db] [datom.time] [datom.query.engine]))

(defn- fresh []
  (datom.conn/connect
    [{:db/ident :email :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
     {:db/ident :name  :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
     {:db/ident :ssn   :db/valueType :db.type/string :db/cardinality :db.cardinality/one}]))

(defn- names-current [c]
  (set (datom.query.engine/q '[:find ?n :where [?e :name ?n]] (datom.conn/db c))))
(defn- names-history [c]
  (set (datom.query.engine/q '[:find ?n :where [?e :name ?n]] (datom.time/history (datom.conn/db c)))))

(deftest retraction-keeps-history-excision-does-not
  ; retractEntity: gone from current, STILL in history
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :email "a@x.com" :name "Alice"}])
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:email "a@x.com"]))]
      (datom.conn/transact! c [[:db/retractEntity eid]])
      (is (= #{} (names-current c)) "retraction removes from the current view")
      (is (= #{["Alice"]} (names-history c)) "but a retracted fact is still in history")))
  ; excision (a separate database, so history holds nothing but this entity):
  ; gone from current AND from history — the distinction that matters.
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :email "b@x.com" :name "Bob"}])
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:email "b@x.com"]))]
      (datom.conn/excise! c [[:entity eid]])
      (is (= #{} (names-current c)) "excision removes from the current view")
      (is (= #{} (names-history c)) "AND from history — the fact is unrecoverable"))))

(deftest excision-removes-from-every-index
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :email "c@x.com" :name "Carol"}])
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:email "c@x.com"]))]
      (datom.conn/excise! c [[:entity eid]])
      ; the AVET index (unique :email) must no longer find it
      (is (nil? (datom.db/entity (datom.conn/db c) [:email "c@x.com"]))
          "the value lookup (AVET) no longer resolves the excised entity")
      ; and the email can be reused — no ghost unique value left behind
      (datom.conn/transact! c [{:db/id -2 :email "c@x.com" :name "Carol II"}])
      (is (= #{["Carol II"]} (names-current c))
          "the unique value is free again — nothing lingers in any index"))))

(deftest attribute-excision-leaves-the-rest-of-the-entity
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :email "d@x.com" :name "Dana" :ssn "111-22-3333"}])
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:email "d@x.com"]))]
      ; erase only the SSN (a GDPR field erasure), keep the account
      (datom.conn/excise! c [[:attr eid :ssn]])
      (let [ent (datom.db/entity (datom.conn/db c) eid)]
        (is (nil? (:ssn ent)) "the ssn is gone")
        (is (= "Dana" (:name ent)) "the name remains")
        (is (= "d@x.com" (:email ent)) "the account still exists")))))

(deftest excise-reports-the-count-removed
  (let [c (fresh)]
    (datom.conn/transact! c [{:db/id -1 :email "e@x.com" :name "Eve"}])
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:email "e@x.com"]))
          report (datom.conn/excise! c [[:entity eid]])]
      (is (= 2 (:excised report)) "two datoms removed: :email and :name"))))
