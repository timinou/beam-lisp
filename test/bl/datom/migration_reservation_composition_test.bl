; HOME native regression draft; requires base policy + addendum and genuine SDK.
; Retained policy/uncertain custody: isolated final VM, never shared cleanup.
(ns datom.migration-reservation-composition-test
 (:require [datom.dynamic-policy-test :as fixture] [datom.migration-admission :as migration]
           [datom :as d] [datom.conn :as conn] [datom.store-fjall :as fjall]
           [proc.queue-family-root :as root] [reload.generation :as g]
           [reload :as reload] [reload.runtime :as runtime] [env]))
(defn setup []
 (let [path (fixture/directory) app (str "policy-compose-" (erlang/unique_integer (list :positive)))
       graph (fixture/prepared path app (fixture/policy-plan))
       journal (d/connect-with (fjall/open (str path "/journal.fjall")))]
  (fixture/ready! graph journal) (fixture/install! graph) (g/with! graph migration/expand!)
  {:path path :graph graph :journal journal}))
(defn receipts [graph journal] (g/with! graph (fn [] [(conn/guard-association-inventory! journal)])))
(defn reserved [context action]
 (let [graph (:graph context) journal (:journal context)]
  (g/with! graph #(conn/with-guard-reservation! (receipts graph journal) {:root (:path context)} action))))
(deftest actual-outer-reservation-is-reused-through-source-publication-without-owning-cleanup
 (let [context (setup) graph (:graph context) journal (:journal context)
       called (atom 0) seen (atom []) slot (g/slot) enabled @runtime/policy-override]
  (try
   (reload/set-enabled! true)
   (is (= :applied (:status (reserved context
    (fn []
     (swap! seen conj (conn/guard-reservation-status journal))
     (migration/with-publication!
      (fn []
       (swap! called inc)
       ;; generation's mandatory gate composes again under the same exact native
       ;; outer ticket. Only the outer owner completes and releases it.
       (let [answer (g/publish! slot nil graph)]
        (swap! seen conj (conn/guard-reservation-status journal)) answer))))))))
   (is (= 1 @called))
   (is (= [{:state :activating} {:state :activating}] @seen))
   (is (= (:digest graph) (g/selected slot)))
   (is (= {:state :free} (conn/guard-reservation-status journal)))
   (is (nil? (Process/get :datom.conn/guard-reservation)))
   (is (= 1 (:frontier (fixture/status graph))))
   (finally (g/close! slot (g/selected slot)) (reload/set-enabled! enabled)))))
(deftest copied-marker-and-genuine-sibling-execution-cannot-borrow-owner-custody
 (let [context (setup) graph (:graph context) journal (:journal context) called (atom 0)
       parent (erlang/self) notice (erlang/make_ref)]
  (is (= :known (reserved context
   (fn []
    (let [ticket (Process/get :datom.conn/guard-reservation) token (env/capture) fake (erlang/make_ref)]
     (try
      (Process/put :datom.conn/guard-reservation fake)
      (is (= :guard-association-reserved
             (fixture/kind #(migration/with-publication! (fn [] (swap! called inc))))))
      (is (= fake (Process/get :datom.conn/guard-reservation)))
      (is (= {:state :activating} (conn/guard-reservation-status journal)))
      (finally (Process/put :datom.conn/guard-reservation ticket)))
     (spawn (fn []
      (env/bind token) (Process/put :datom.conn/guard-reservation ticket)
      (erlang/send parent [:copied notice
       (try (migration/with-publication! (fn [] (swap! called inc))) "unexpected acceptance"
         (catch error (str error)))])))
     (is (String/contains?
            (receive [:copied id value] :when (= id notice) value (after 10000 "timeout"))
            "unadmitted_execution_origin"))
     (spawn (fn []
      (Process/put :datom.conn/guard-reservation ticket)
      (erlang/send parent [:sibling notice (fixture/kind #(g/with! graph
       (fn [] (migration/with-publication! (fn [] (swap! called inc))))))])))
     (is (= :migration-policy-custodian-required
            (receive [:sibling id value] :when (= id notice) value (after 10000 :timeout))))
     (is (= ticket (Process/get :datom.conn/guard-reservation)))
     (is (= 0 @called))
     :known)))))
  (is (= {:state :free} (conn/guard-reservation-status journal)))
  (is (= 0 @called))))
(deftest wrong-root-and-other-genuine-scope-refuse-before-owner-action
 (let [context (setup) graph (:graph context) journal (:journal context) called (atom 0)
       next (g/prepare! {:application-id (:application-id graph)
                         :sources {"phase.fixture" "(ns phase.fixture) (defn identity [x] [x])"}
                         :resources (:resources graph)})]
  (is (not= (:digest graph) (:digest next)))
  (is (= :inherited (root/inherit! next graph)))
  (root/enter-initializer! next) (g/with! next #(g/bind-runtime! {})) (root/ready! next)
  (is (= :known (g/with! graph
   #(conn/with-guard-reservation! (receipts graph journal) {:root (str (:path context) "/different")}
     (fn []
      (is (= :migration-reservation-mismatch
             (fixture/kind #(migration/with-publication! (fn [] (swap! called inc)))))) :known)))))
  (is (= 0 @called))
  (is (= :known (reserved context
   (fn []
    (is (= :migration-reservation-mismatch
           (fixture/kind #(g/with! next (fn [] (migration/with-publication! (fn [] (swap! called inc))))))))
    :known))))
  (is (= 0 @called))
  (is (= {:state :free} (conn/guard-reservation-status journal)))))
(deftest unknown-accepted-action-retains-outer-reservation-without-callback-replay
 (let [context (setup) journal (:journal context) called (atom 0)]
  (is (= :fixture-unknown
         (fixture/kind #(reserved context
          (fn [] (migration/with-publication!
           (fn [] (swap! called inc) (throw (ex-info "fixture unknown" {:kind :fixture-unknown})))))))))
  (is (= 1 @called))
  (is (= {:state :uncertain} (conn/guard-reservation-status journal)))
  (is (nil? (Process/get :datom.conn/guard-reservation)))
  (is (= :guard-activation-uncertain
         (fixture/kind #(g/with! (:graph context)
          (fn [] (migration/with-publication! (fn [] (swap! called inc))))))))
  (is (= 1 @called))))
