(ns datom.cache-validity-test (:require [datom.cache-validity :as validity]))

(deftest unknown-and-malformed-evidence-is-never-reused
  (doseq [bad [nil :unknown -1 1.0 "1"]]
    (is (not (validity/reusable? bad 1 1)))
    (is (not (validity/reusable? 1 bad 1)))
    (is (not (validity/reusable? 1 1 bad))))
  (is (not (validity/reusable? 0 0 0))))

(deftest all-small-histories-require-a-past-build-and-no-later-write
  (doseq [reader (range 8) built (range 8) mark (range 8)]
    (is (= (and (> mark 0) (<= mark built) (<= built reader))
           (validity/reusable? reader built mark)))))
