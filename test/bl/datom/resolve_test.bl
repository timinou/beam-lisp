; test/bl/datom/resolve_test.bl — the datom_resolve NIF (Fix A), end to end.
; Run: mix beam_lisp.test test/bl/datom/resolve_test.bl
;
; ── What this locks ───────────────────────────────────────────────────
;
; This IS the golden-vector conformance suite: beam-lisp encodes datom
; values through `store-redb`'s packed writer, the Rust NIF decodes them
; back into typed columns, and we assert the columns equal what a plain
; `index/scan` (the bl decode path) produces. Same bytes, two decoders,
; zero disagreements — across every dtype, the retraction filter, and the
; any-term escape lane that carries arbitrary EDN/BEAM structures.
;
; It is skipped when the redb NIF is absent (a BEAM-only checkout), the
; same gate the conformance suite uses.

(ns datom.resolve.test
  (:require [datom.store-redb] [datom.index] [datom.store]))

;; A fresh durable store per test: the engine owns its path convention
;; (`open-fresh` behind datom.store/FileBacked), so no `.redb` suffix here.

;; A tiny schema-free write: build datoms and commit them straight to the
;; store via the index write path, then read them two ways.

(defn- put-datoms [store datoms]
  ; write only EAVT/AEVT (the base indexes); the resolve test scans AEVT.
  (datom.store/-commit
    store
    (to-list (mapcat (fn [d]
                       (mapv (fn [index] [:put (datom.index/key-for index d) d])
                             [:eavt :aevt]))
                     datoms))))

(defn- aevt-bounds [a]
  ; the AEVT key range for one attribute: prefix [a] .. its end.
  (let [prefix (datom.index/key-prefix :aevt a)]
    [prefix (datom.index/prefix-end prefix)]))

;; `resolve` and `scan` both return datoms [e a v tx op]; comparing them
;; directly is the golden equivalence. Sort both by [e (str v)] so scan
;; order does not matter.
(defn- sort-datoms [datoms]
  (sort-by (fn [d] [(datom.index/-e d) (str (datom.index/-v d))]) datoms))

(defmacro when-redb [& body]
  `(if (datom.store-redb/available?)
     (do ~@body)
     (is true)))   ; NIF absent: vacuously pass, like the conformance gate.

;; ── the golden equivalence: NIF columns == scan columns ─────────────

(defn- resolve-eq-scan? [store a]
  (let [bounds (aevt-bounds a)
        resolved (datom.store-redb/resolve store (get bounds 0) (get bounds 1))
        scanned (datom.index/scan store :aevt a)]
    (= (sort-datoms scanned) (sort-datoms resolved))))

(deftest resolve-matches-scan-for-scalars
  (when-redb
    (let [store (datom.store-redb/open-fresh)
          datoms [[1000 :spend/cost 42 7000 true]
                  [1001 :spend/cost 99 7000 true]
                  [1002 :spend/cost 7 7001 true]]
          _ (put-datoms store datoms)]
      (is (resolve-eq-scan? store :spend/cost)))))

(deftest resolve-decodes-every-lane
  (when-redb
    (let [store (datom.store-redb/open-fresh)
          datoms [[1 :a/long 42 7000 true]
                  [2 :a/long -9223372036854775808 7000 true]   ; i64 min
                  [3 :a/str "gpt-4o" 7000 true]
                  [4 :a/kw :provider/anthropic 7000 true]
                  [5 :a/bool true 7000 true]
                  [6 :a/float 3.14 7000 true]]]
      ; each attribute scanned on its own so the column is homogeneous
      (put-datoms store datoms)
      (is (resolve-eq-scan? store :a/long))
      (is (resolve-eq-scan? store :a/str))
      (is (resolve-eq-scan? store :a/kw))
      (is (resolve-eq-scan? store :a/bool))
      (is (resolve-eq-scan? store :a/float)))))

(deftest resolve-returns-raw-datoms-including-retractions
  ; The NIF does NOT filter — it returns every datom in the range, exactly
  ; as a scan does, so `datom.db/filter-datoms` (the single, basis-aware
  ; filter) stays the only place presence is decided. Here: assert 42,
  ; retract 42, assert 99 — resolve returns all three, same as scan.
  (when-redb
    (let [store (datom.store-redb/open-fresh)
          datoms [[500 :bal/cost 42 7000 true]
                  [500 :bal/cost 42 7001 false]
                  [500 :bal/cost 99 7002 true]]
          _ (put-datoms store datoms)
          bounds (aevt-bounds :bal/cost)
          resolved (datom.store-redb/resolve store (get bounds 0) (get bounds 1))
          scanned (datom.index/scan store :aevt :bal/cost)]
      (is (= (sort-datoms scanned) (sort-datoms resolved)))
      ; and the op flags survive: one retraction present among the three.
      (is (= 3 (count resolved)))
      (is (= 1 (count (filterv (fn [d] (not (datom.index/-op d))) resolved)))))))

(deftest resolve-round-trips-arbitrary-structures
  (when-redb
    (let [store (datom.store-redb/open-fresh)
          body {:blocks [{:type :h1 :text "Title"}
                         {:type :list :items #{:a :b :c}}]
                :meta {:tags [:draft :urgent] :rev 7}}
          datoms [[900 :doc/body body 7000 true]]
          _ (put-datoms store datoms)
          bounds (aevt-bounds :doc/body)
          resolved (datom.store-redb/resolve store (get bounds 0) (get bounds 1))]
      ; the any-term escape lane hands the nested structure back intact.
      (is (= 1 (count resolved)))
      (is (= body (datom.index/-v (first resolved))))
      (is (= 900 (datom.index/-e (first resolved)))))))
