(ns datom.query-context-test
 (:require [datom.query.functions :as functions] [env]))
(def effects (atom 0))
(defn dangerous [value] (swap! effects inc) value)
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn- run-task [action]
 (let [work (BeamLisp.Env/convey (fn [_] (action)))]
  (Task/await (Task/async (fn [] (work nil))) 5000)))

(deftest closed-authority-follows-captured-workers-after-caller-extent-ends
 (reset! effects 0)
 (let [work (functions/with-only
              #(BeamLisp.Env/convey
                 (fn [_] ((functions/resolve-op 'dangerous (fn [] dangerous)) 7))))
       result (run-task (fn [] (kind (fn [] (work nil)))))]
  (is (= :query-function-refused result))
  (is (= 0 @effects))
  (is (not (functions/restricted?)))))

(deftest captured-query-scope-narrows-and-restores-reusable-workers
 (reset! effects 0)
 (let [work (functions/with-only {"+" +}
              #(BeamLisp.Env/convey
                 (fn [_]
                  [(functions/restricted?)
                   ((functions/resolve-op '+ (fn [] dangerous)) 20 22)
                   (kind (fn [] (functions/resolve-op 'dangerous (fn [] dangerous))))])))
       result (run-task
                (fn [] (functions/with-only {"dangerous" dangerous "+" +}
                   (fn []
                    (let [value (work nil)]
                     [value (functions/restricted?)
                      ((functions/resolve-op 'dangerous (fn [] nil)) 9)])))))]
  (is (= [[true 42 :query-function-refused] true 9] result))
  (is (= 1 @effects))
  (is (not (functions/restricted?)))))

(deftest captured-query-scope-restores-after-worker-throws
 (let [work (functions/with-only
             #(BeamLisp.Env/convey
                (fn [_]
                 (when-not (functions/restricted?) (throw :scope-missing))
                 (throw (ex-info "synthetic scoped failure" {:kind :synthetic})))))
       result (run-task
                (fn [] (let [failure (kind (fn [] (work nil)))]
                         [failure (functions/restricted?)])))]
  (is (= [:synthetic false] result))))

(deftest captured-unrestricted-callback-cannot-widen-querying-caller
 (reset! effects 0)
 (let [work (BeamLisp.Env/convey
             (fn [_] ((functions/resolve-op 'dangerous (fn [] dangerous)) 7)))]
  (is (= :query-function-refused
         (functions/with-only #(kind (fn [] (work nil))))))
  (is (= 0 @effects))
  (is (not (functions/restricted?)))))
