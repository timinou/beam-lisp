; test/bl/datom/shape_test.bl — shape → JSON Schema, and shape as validator.
; Run: mix beam_lisp.test test/bl/datom/shape_test.bl --path examples
;
; The one property: a shape is declared ONCE as data, and both the derived
; JSON Schema and the validator read that same declaration — so they cannot
; disagree about what the shape means.

(ns datom.shape.test
  (:require [semantic.shape :as shape]))

;; ── scalars ─────────────────────────────────────────────────────────

(deftest scalar-schema
  (is (= {"type" "STRING"} (shape/->json-schema :string)))
  (is (= {"type" "INTEGER"} (shape/->json-schema :integer)))
  (is (= {"type" "NUMBER"} (shape/->json-schema :number)))
  (is (= {"type" "BOOLEAN"} (shape/->json-schema :boolean))))

;; ── objects: every field required ───────────────────────────────────

(deftest object-schema
  (let [s (shape/->json-schema {:name :string :age :integer})]
    (is (= "OBJECT" (get s "type")))
    (is (= {"type" "STRING"} (get (get s "properties") "name")))
    (is (= {"type" "INTEGER"} (get (get s "properties") "age")))
    ; both fields required (order-independent)
    (is (= #{"name" "age"} (set (to-list (get s "required")))))))

;; ── lists and enums ─────────────────────────────────────────────────

(deftest list-schema
  (let [s (shape/->json-schema [:list :string])]
    (is (= "ARRAY" (get s "type")))
    (is (= {"type" "STRING"} (get s "items")))))

(deftest enum-schema
  (let [s (shape/->json-schema [:enum "a" "b" "c"])]
    (is (= "STRING" (get s "type")))
    (is (= ["a" "b" "c"] (into [] (get s "enum"))))))

(deftest nested-schema
  ; the real extraction shape: a list of objects with an enum field
  (let [s (shape/->json-schema [:list {:name :string :kind [:enum "person" "place"]}])]
    (is (= "ARRAY" (get s "type")))
    (is (= "OBJECT" (get (get s "items") "type")))
    (is (= "STRING" (get (get (get (get s "items") "properties") "kind") "type")))
    (is (= ["person" "place"] (into [] (get (get (get (get s "items") "properties") "kind") "enum"))))))

;; ── the SAME shape validates a value ────────────────────────────────

(deftest validator-agrees-with-schema
  (let [s [:list {:name :string :kind [:enum "person" "place"]}]]
    ; a conforming value
    (is (shape/valid? s [{"name" "Holmes" "kind" "person"}
                         {"name" "Baker Street" "kind" "place"}]))
    ; wrong enum value
    (is (not (shape/valid? s [{"name" "Holmes" "kind" "animal"}])))
    ; missing field
    (is (not (shape/valid? s [{"name" "Holmes"}])))
    ; wrong scalar type
    (is (not (shape/valid? {:age :integer} {"age" "not a number"})))
    (is (shape/valid? {:age :integer} {"age" 42}))))
