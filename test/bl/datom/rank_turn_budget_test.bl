(ns datom.rank-turn-budget-test (:require [datom.query.rank-build :as build]))
(deftest turns-start-small-and-account-for-measured-commit-time
 (is (= 1 (build/turn-rows nil)))
 (is (= 1 (build/turn-rows {:rows 16 :elapsed-us 1700000})))
 (is (= 4 (build/turn-rows {:rows 16 :elapsed-us 80000})))
 (is (= 16 (build/turn-rows {:rows 16 :elapsed-us 1000})))
 (doseq [sample [{:rows 0 :elapsed-us 1} {:rows -1 :elapsed-us 1}
                 {:rows 1 :elapsed-us 0} {:rows 1 :elapsed-us nil}]]
  (is (= 1 (build/turn-rows sample)))))

(deftest empty-turns-never-predict-cheap-entity-construction
 (let [empty-turn (build/observe-turn nil 0 100)
       costly (build/observe-turn empty-turn 1 80000)
       cheap (build/observe-turn costly 16 1000)]
  (is (= 1 (build/turn-rows empty-turn)))
  (is (= 1 (build/turn-rows costly)))
  (is (= 1 (build/turn-rows cheap)))
  (is (= 80000 (:us-per-row cheap)))))
