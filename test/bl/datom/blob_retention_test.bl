(ns datom.blob-retention-test
 (:require [datom.blob :as blob] [datom.blob-fs :as fs] [datom.blob-ets :as memory]
           [datom.blob-overlay :as overlay] [datom.file :as file] [datom.store :as store]
           [datom :as d] [datom.store-fjall :as fjall]))
(defn refused [f] (try (f) nil (catch e (:kind (ex-data e)))))
(deftest pins-exclude-every-delete-and-close-without-blocking-content-addressed-puts
 (doseq [bs [(fs/open :tmp) (memory/open)]]
  (let [sha (file/sha256 "old") pin (blob/retain! bs) second (blob/retain! bs)]
   (try
    (blob/-blob-put bs sha "old")
    (is (= :blob-retention-active (refused #(blob/-blob-delete bs sha))))
    (is (= :blob-retention-active (refused #(store/close bs))))
    (is (= "old" (blob/-blob-get bs sha)))
    (is (= :released (blob/release! bs pin)))
    (is (= :blob-retention-active (refused #(blob/-blob-delete bs sha))))
    ;; Releasing an obsolete token cannot release a different live pin.
    (is (= :released (blob/release! bs pin)))
    (is (= :blob-retention-active (refused #(blob/ensure-collectable! bs))))
    (blob/release! bs second)
    (is (= true (blob/ensure-collectable! bs)))
    (blob/-blob-delete bs sha) (is (not (blob/-blob-has? bs sha)))
    (finally (blob/release! bs pin) (blob/release! bs second) (store/close bs))))))
(deftest dead-pin-owners-are-pruned-and-other-tier-tokens-cannot-release-them
 (let [bs (fs/open :tmp) other (memory/open) parent (erlang/self)
       child (spawn-monitor (fn [] (erlang/send parent [:pin (blob/retain! bs)])))]
  (try
   (receive [:pin pin]
    (do (let [monitor (elem child 1)]
     (receive [:DOWN ref :process _ _] :when (= ref monitor) nil (after 5000 (is false))))
    (is (= true (blob/ensure-collectable! bs)))
    (is (= :blob-retention-identity (refused #(blob/release! other pin))))
    (is (= :released (blob/release! bs pin))))
    (after 5000 (is false)))
   (finally (store/close bs) (store/close other)))))
(deftest filesystem-aliases-share-retention-authority
 (let [bs (fs/open :tmp) link (str (:dir bs) "-alias") sha (file/sha256 "bytes") pin (blob/retain! bs)]
  (try
   (File/ln_s! (:dir bs) link)
   (let [alias (fs/open link)]
    (blob/-blob-put alias sha "bytes")
    (is (= :blob-retention-active (refused #(blob/-blob-delete alias sha))))
    (is (= "bytes" (blob/-blob-get bs sha))))
   (finally (blob/release! bs pin) (File/rm! link) (store/close bs)))))
(deftest gc-refuses-before-any-orphan-deletion-and-recovers-after-release
 (let [c (d/connect-with (fjall/open-fresh)) bs (:blobs c) sha (file/sha256 "orphan")]
  (try
   (blob/-blob-put bs sha "orphan")
   (let [pin (blob/retain! bs)]
    (try
     (is (= :blob-retention-active (refused #(d/gc-files! c))))
     (is (blob/-blob-has? bs sha))
     (finally (blob/release! bs pin))))
   (is (= 1 (:swept (d/gc-files! c))))
   (is (not (blob/-blob-has? bs sha)))
   (is (= :blob-retention-unavailable (refused #(blob/retain! (overlay/open (memory/open))))))
   (finally (d/close! c)))))
