(ns datom.watch-delta-test
  (:require [datom] [datom.db :as db] [datom.watch :as watch]
            [datom.profile :as profile] [datom.query.engine :as engine]))

(def schema [{:db/ident :item/name :db/valueType :db.type/string}
             {:db/ident :item/group :db/valueType :db.type/string}])
(def query '[:find ?e ?n :in $ ?g :where [?e :item/group ?g] [?e :item/name ?n]])
(defn fixture []
  (let [c (datom/connect schema)]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :item/group "g" :item/name (str i)}) (range 256))) c))
(defn oracle [q before after]
  (let [a (engine/q-uncached q before "g") b (engine/q-uncached q after "g")]
    {:added (into #{} (filter (fn [x] (not (contains? a x))) b))
     :removed (into #{} (filter (fn [x] (not (contains? b x))) a))}))

(deftest changed-entity-diff-reuses-the-authoritative-query-engine
  (let [c (fixture) before (datom/db c)
        eid (first (first (datom/q '[:find ?e :where [?e :item/name "1"]] before)))
        report (datom/transact! c [[:db/add eid :item/name "changed"]])
        after (datom/db c) p (profile/watch (db/store-of after))
        actual (watch/delta-diff query ["g"] (assoc before :store p) (assoc after :store p)
                                 (:tx report) (:tx-datoms report))]
    (is (= (oracle query before after) actual))
    (is (< (:rows (profile/counters p)) 32))
    (let [r (datom/transact! c [[:db/retract eid :item/group "g"]]) next (datom/db c)]
      (is (= (oracle query after next)
             (watch/delta-diff query ["g"] after next (:tx r) (:tx-datoms r)))))))

(deftest duplicate-projections-and-overtaken-streams-use-full-evaluation
  (let [c (fixture) before (datom/db c)
        r (datom/transact! c [{:db/id -1 :item/group "g" :item/name "late"}])
        after (datom/db c) projected '[:find ?g :in $ ?g :where [?e :item/group ?g]]]
    (is (nil? (watch/delta-diff projected ["g"] before after (:tx r) (:tx-datoms r))))
    (datom/transact! c [{:db/id -1 :item/group "g" :item/name "later"}])
    (let [next (datom/db c)]
      (is (= (oracle query before next)
             (watch/delta-diff query ["g"] before next (:tx r) (:tx-datoms r)))))))

(deftest changed-store-identity-declines-delta-certification
  (let [a (fixture) b (fixture) before (datom/db a)
        ids (into {} (into [] (datom/q '[:find ?n ?e :where [?e :item/name ?n]] before)))
        ra (datom/transact! a [[:db/add (get ids "1") :item/name "changed"]])
        rb (datom/transact! b [[:db/add (get ids "1") :item/name "changed"]
                              [:db/add (get ids "2") :item/name "also-changed"]])
        after (datom/db b)]
    (is (= (oracle query before after)
           (watch/delta-diff query ["g"] before after (:tx rb) (:tx-datoms ra))))))
