; PURE metadata decision controls, not execution/native authority proofs.
(ns datom.dynamic-opening-model-test
 (:require [datom.store-opening :as opening] [datom.migration-policy :as policy]))
(defn kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(deftest indexed-opening-and-phase-permit-prevent-the-preflight-publication-race
 (let [permit (erlang/make_ref) policy-ticket (erlang/make_ref) ticket (erlang/make_ref)
       creator {:application-id "model-app" :scope :model-scope :digest "model-digest"}
       issued {:policy policy-ticket :state :issued :creator creator :owner (erlang/self) :path "/model/root/tenant"}
       cells {(policy/table-key) {"model-app" {:application-id "model-app" :root "/model/root"
                     :state :active :ticket policy-ticket :permits {permit issued}}}}
       row {:ticket ticket :creator creator :owner (erlang/self) :path "/model/root/tenant"
            :producer :fjall :phase :pending :migration-permit permit}
       indexed (opening/admit cells row)]
  (is (= :pending (get-in indexed [:datom.conn/store-openings ticket :phase])))
  (is (= :migration-opening-pending (kind #(opening/check-publication! cells "model-app" "/model/root"))))
  (is (= :migration-opening-pending (kind #(opening/check-publication! indexed "model-app" "/model/root"))))
  (is (= :uncertain (get-in (opening/lose-owner indexed ticket) [:datom.conn/store-openings ticket :phase])))
  (is (= :migration-opening-pending
         (kind #(opening/check-publication! (opening/lose-owner indexed ticket) "model-app" "/model/root"))))
  (is (= :guard-store-admission-reserved
         (kind #(opening/admit (assoc cells :datom.conn/guard-admissions {"model-app" {:application-id "model-app" :root "/model/root"}}) row))))
  (is (= :migration-managed-open-required (kind #(opening/admit cells (assoc row :migration-permit (erlang/make_ref))))))
  (is (= :migration-managed-open-required
         (kind #(opening/admit (assoc-in cells [(policy/table-key) "model-app" :state] :installing) row))))))
(deftest claimed-purpose-and-schema-markers-cannot-manufacture-queue-allocation
 (let [row {:ticket (erlang/make_ref) :owner (erlang/self)
            :creator {:application-id "model-app" :scope :copied :digest "copied"}
            :path "/model/root/queues/spoof" :producer :fjall
            :queue-role {:kind :native-queue-allocation :ticket (erlang/make_ref)
                         :opening-ticket (erlang/make_ref) :owner (erlang/self)
                         :application-id "model-app" :generation "copied" :scope :copied}}]
  (is (= :queue-family-allocation-ticket-refused (kind #(opening/admit {} row))))
  (is (nil? (get-in {} [:datom.conn/store-openings (:ticket row)])))
  (is (= :reserved-migration-store (kind #(policy/business-schema {:queue/key {:db/ident :queue/key :db/valueType :db.type/string}}))))))
