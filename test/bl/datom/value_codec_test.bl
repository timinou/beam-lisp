; test/bl/datom/value_codec_test.bl — the scheme-C typed value payload.
; Run: mix beam_lisp.test test/bl/datom/value_codec_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
;   decode(encode(dtype, v)) == v      for every value the database accepts
;
; The KEY codec (codec.bl) must SORT; this one must only ROUND-TRIP, and
; do it fast. So the assertions are round-trip identity per dtype plus the
; escape hatch, and a check that each typed lane's payload has the shape
; the Rust NIF will read (a known lane tag + a fixed or raw-utf8 body).

(ns datom.value-codec.test
  (:require [datom.value-codec]))

; encode chooses its lane from the value's RUNTIME TYPE now, so the tests
; pass the value alone; the `_` marks where a caller's dtype used to sit,
; kept in the test names to document which schema type rides which lane.
(defn- roundtrips? [v]
  (= v (datom.value-codec/decode (datom.value-codec/encode v))))

(defn- lane-of [v]
  (erlang/hd (erlang/binary_to_list (datom.value-codec/encode v))))

;; ── the fixed-width integer lanes ───────────────────────────────────

(deftest long-roundtrips
  (is (roundtrips? 0))
  (is (roundtrips? 1))
  (is (roundtrips? -1))
  (is (roundtrips? 42))
  (is (roundtrips? 9223372036854775807))    ; i64 max
  (is (roundtrips? -9223372036854775808))   ; i64 min
  (is (roundtrips? 1724680000000))          ; an epoch-ms magnitude
  (is (= datom.value-codec/LANE-LONG (lane-of 42))))

(deftest ref-and-instant-share-the-long-lane
  (is (roundtrips? 1000))
  (is (roundtrips? 1724680000000))
  (is (= datom.value-codec/LANE-LONG (lane-of 1000)))
  (is (= datom.value-codec/LANE-LONG (lane-of 1724680000000))))

(deftest bignum-past-i64-takes-the-escape-hatch
  ; 2^70 — beyond signed 64 bits, so it cannot be the fixed lane. It must
  ; still round-trip (the language has arbitrary-precision integers).
  (let [big 1180591620717411303424]
    (is (roundtrips? big))
    (is (= datom.value-codec/LANE-ESC (lane-of big)))))

;; ── boolean ─────────────────────────────────────────────────────────

(deftest boolean-roundtrips
  (is (roundtrips? true))
  (is (roundtrips? false))
  (is (= datom.value-codec/LANE-BOOL (lane-of true))))

;; ── string / keyword (variable width) ───────────────────────────────

(deftest string-roundtrips
  (is (roundtrips? ""))
  (is (roundtrips? "gpt-4o"))
  (is (roundtrips? "a string with spaces and 🌟 unicode"))
  (is (= datom.value-codec/LANE-STR (lane-of "x"))))

(deftest keyword-roundtrips-with-namespace
  ; The namespace MUST survive — `:spend/model` decoding to `:model` would
  ; be silent data corruption.
  (is (roundtrips? :simple))
  (is (roundtrips? :spend/model))
  (is (roundtrips? :db.type/long))
  (is (= datom.value-codec/LANE-KEYWORD (lane-of :spend/model))))

;; ── float (fast lane on an untyped attr) ────────────────────────────

(deftest float-roundtrips
  (is (roundtrips? 3.14))
  (is (roundtrips? 0.0))
  (is (roundtrips? -2.5))
  (is (roundtrips? 1.0e300))
  (is (= datom.value-codec/LANE-FLOAT (lane-of 3.14))))

;; ── the any-term escape hatch: datom's "store any structure" promise ──

(deftest arbitrary-term-roundtrips
  ; :db.type/term (or any value that does not fit its lane) → ESC.
  (is (roundtrips? {:blocks [{:type :h1 :text "Title"}]
                                  :meta {:tags [:draft :urgent] :rev 7}}))
  (is (roundtrips? [1 2 3 :a "mix"]))
  (is (roundtrips? #{:a :b :c}))
  (is (= datom.value-codec/LANE-ESC (lane-of {:a 1}))))

(deftest nil-takes-the-escape-hatch
  ; A nil in an otherwise-typed column must not corrupt the fixed lane.
  (is (roundtrips? nil))
  (is (= datom.value-codec/LANE-ESC (lane-of nil))))

;; ── encoding is by RUNTIME TYPE, so every value lands in a real lane ──

(deftest every-value-round-trips-regardless-of-any-attr-intent
  ; The codec keys off what the value IS, not what an attribute declares.
  ; So a string always rides the STR lane (never crashes trying to be a
  ; long), and type VALIDATION against :db/valueType is left to
  ; schema/validate-value at transact time — a clean separation.
  (is (roundtrips? "not a number"))
  (is (= datom.value-codec/LANE-STR (lane-of "not a number")))
  (is (roundtrips? 42))
  (is (= datom.value-codec/LANE-LONG (lane-of 42))))
