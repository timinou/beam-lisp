; test/bl/datom/value_codec_test.bl — the scheme-C typed value payload.
; Run: bl test test/bl/datom/value_codec_test.bl
;
; ── What must hold ────────────────────────────────────────────────────
;
;   decode(encode(dtype, v)) == v      for every value the database accepts
;
; The KEY codec (codec.bl) must SORT; this one must only ROUND-TRIP, and
; do it fast. So the assertions are round-trip identity per dtype plus the
; escape hatch, and a check that each typed lane's payload has the shape
; the Rust NIF will read (a known lane tag + a fixed or raw-utf8 body).

(ns datom.value-codec.test
  (:require [datom.value-codec]))

; encode chooses its lane from the value's RUNTIME TYPE now, so the tests
; pass the value alone; the `_` marks where a caller's dtype used to sit,
; kept in the test names to document which schema type rides which lane.
(defn- roundtrips? [v]
  (= v (datom.value-codec/decode (datom.value-codec/encode v))))

(defn- lane-of [v]
  (erlang/hd (erlang/binary_to_list (datom.value-codec/encode v))))

;; ── the fixed-width integer lanes ───────────────────────────────────

(deftest long-roundtrips
  (is (roundtrips? 0))
  (is (roundtrips? 1))
  (is (roundtrips? -1))
  (is (roundtrips? 42))
  (is (roundtrips? 9223372036854775807))    ; i64 max
  (is (roundtrips? -9223372036854775808))   ; i64 min
  (is (roundtrips? 1724680000000))          ; an epoch-ms magnitude
  (is (= datom.value-codec/LANE-LONG (lane-of 42))))

(deftest ref-and-instant-share-the-long-lane
  (is (roundtrips? 1000))
  (is (roundtrips? 1724680000000))
  (is (= datom.value-codec/LANE-LONG (lane-of 1000)))
  (is (= datom.value-codec/LANE-LONG (lane-of 1724680000000))))

(deftest bignum-past-i64-takes-the-escape-hatch
  ; 2^70 — beyond signed 64 bits, so it cannot be the fixed lane. It must
  ; still round-trip (the language has arbitrary-precision integers).
  (let [big 1180591620717411303424]
    (is (roundtrips? big))
    (is (= datom.value-codec/LANE-ESC (lane-of big)))))

;; ── boolean ─────────────────────────────────────────────────────────

(deftest boolean-roundtrips
  (is (roundtrips? true))
  (is (roundtrips? false))
  (is (= datom.value-codec/LANE-BOOL (lane-of true))))

;; ── string / keyword (variable width) ───────────────────────────────

(deftest string-roundtrips
  (is (roundtrips? ""))
  (is (roundtrips? "gpt-4o"))
  (is (roundtrips? "a string with spaces and 🌟 unicode"))
  (is (= datom.value-codec/LANE-STR (lane-of "x"))))

(deftest keyword-roundtrips-with-namespace
  ; The namespace MUST survive — `:spend/model` decoding to `:model` would
  ; be silent data corruption.
  (is (roundtrips? :simple))
  (is (roundtrips? :spend/model))
  (is (roundtrips? :db.type/long))
  (is (= datom.value-codec/LANE-KEYWORD (lane-of :spend/model))))

;; ── float (fast lane on an untyped attr) ────────────────────────────

(deftest float-roundtrips
  (is (roundtrips? 3.14))
  (is (roundtrips? 0.0))
  (is (roundtrips? -2.5))
  (is (roundtrips? 1.0e300))
  (is (= datom.value-codec/LANE-FLOAT (lane-of 3.14))))

;; ── the any-term escape hatch: datom's "store any structure" promise ──

(deftest arbitrary-term-roundtrips
  ; :db.type/term (or any value that does not fit its lane) → ESC.
  (is (roundtrips? {:blocks [{:type :h1 :text "Title"}]
                                  :meta {:tags [:draft :urgent] :rev 7}}))
  (is (roundtrips? [1 2 3 :a "mix"]))
  (is (roundtrips? #{:a :b :c}))
  (is (= datom.value-codec/LANE-ESC (lane-of {:a 1}))))

(deftest nil-takes-the-escape-hatch
  ; A nil in an otherwise-typed column must not corrupt the fixed lane.
  (is (roundtrips? nil))
  (is (= datom.value-codec/LANE-ESC (lane-of nil))))

;; ── encoding is by RUNTIME TYPE, so every value lands in a real lane ──

(deftest every-value-round-trips-regardless-of-any-attr-intent
  ; The codec keys off what the value IS, not what an attribute declares.
  ; So a string always rides the STR lane (never crashes trying to be a
  ; long), and type VALIDATION against :db/valueType is left to
  ; schema/validate-value at transact time — a clean separation.
  (is (roundtrips? "not a number"))
  (is (= datom.value-codec/LANE-STR (lane-of "not a number")))
  (is (roundtrips? 42))
  (is (= datom.value-codec/LANE-LONG (lane-of 42))))

;; ── the datom lane: a stored datom, packed field-wise ───────────────

(defn- datom-roundtrips? [d]
  ; The SLOT is the contract a store honours: encode-datom may legitimately
  ; fall back to ESC (a bignum entity), and then decode-slot — not
  ; decode-datom — is what reads it back.
  (= d (datom.value-codec/decode-slot (datom.value-codec/encode-slot d))))

(deftest datom-lane-roundtrips-every-field
  ; A datom is what every index stores, so this is the lane that carries the
  ; database. Every field must survive, including the ones a reader takes for
  ; granted: `op` (which distinguishes an assertion from a retraction at the
  ; same tx), and `a`'s NAMESPACE (a keyword's name alone would collide).
  (is (datom-roundtrips? [1 :person/name "Ada" 42 true]))
  (is (datom-roundtrips? [1 :person/name "Ada" 42 false]))
  (is (datom-roundtrips? [0 :a nil 0 true]))
  (is (datom-roundtrips? [999999999999 :db/ident :my/ident 7 false]))
  (is (datom-roundtrips? [1 :x -1 2 true]))
  (is (datom-roundtrips? [7 :x 3.14 9 true]))
  (is (= datom.value-codec/LANE-DATOM
         (datom.value-codec/byte-at (datom.value-codec/encode-datom [1 :a 1 1 true]) 0)))
  (is (= datom.value-codec/LANE-DATOM
         (datom.value-codec/byte-at (datom.value-codec/encode-slot [1 :a 1 1 true]) 0))))

(deftest datom-lane-carries-any-value-shape
  ; `v` is the only unbounded field, and it must carry whatever the database
  ; accepts — the datom lane packs v with the SAME runtime-lane codec, so a
  ; composite value is no different from an integer here.
  (is (datom-roundtrips? [1 :doc/body {:blocks [{:type :h1 :text "T"}]} 3 true]))
  (is (datom-roundtrips? [1 :tag #{:a :b} 3 true]))
  (is (datom-roundtrips? [1 :blob (erlang/list_to_binary (to-list [16 0])) 3 true]))
  (is (datom-roundtrips? [1 :kw :db.type/ref 3 true])))

(deftest a-user-value-shaped-like-a-datom-still-round-trips
  ; The slot codec classifies by SHAPE (no schema, no caller tag), so the
  ; property that makes that safe is the one asserted here: a 5-element value
  ; that merely LOOKS like a datom survives unchanged.
  (is (= [1 :a "x" 2 true]
         (datom.value-codec/decode-slot (datom.value-codec/encode-slot [1 :a "x" 2 true]))))
  (is (= [1 :a "x" 2 :not-a-bool]
         (datom.value-codec/decode-slot
           (datom.value-codec/encode-slot [1 :a "x" 2 :not-a-bool]))))
  (is (= datom.value-codec/LANE-ESC
         (datom.value-codec/byte-at
           (datom.value-codec/encode-slot [1 :a "x" 2 :not-a-bool]) 0))))

(deftest datom-lane-falls-back-when-a-field-does-not-fit
  ; Totality: the lane has two failure shapes (an attribute name past 255
  ; bytes, an e/tx past i64) and both must degrade to ESC rather than
  ; truncate. A truncated entity id is silent corruption.
  (let [long-a (keyword (erlang/list_to_binary
                           (to-list (mapcat (fn [_] [240 159 152 128]) (range 100)))))
        big (erlang/bsl 1 70)]
    ; 100 emoji: 100 CHARACTERS (an Erlang atom allows 255) but 400 BYTES, which
    ; is what the lane's one-byte length field cannot hold. This is the only way
    ; the guard is reachable — a keyword is at most 255 characters, so an
    ; attribute name can exceed 255 bytes only by being multi-byte.
    (is (> (erlang/byte_size (str long-a)) 255))
    (is (= datom.value-codec/LANE-ESC
           (datom.value-codec/byte-at
             (datom.value-codec/encode-datom [1 long-a "v" 1 true]) 0)))
    (is (datom-roundtrips? [1 long-a "v" 1 true]))
    (is (= datom.value-codec/LANE-ESC
           (datom.value-codec/byte-at
             (datom.value-codec/encode-datom [big :a "v" 1 true]) 0)))
    (is (datom-roundtrips? [big :a "v" 1 true]))))

(deftest slot-reads-values-written-before-the-datom-lane-existed
  ; A durable store upgrades LAZILY: rows written as ETF stay readable, and a
  ; mixed keyspace is the expected state, not an error. 131 is the ETF version
  ; byte and no lane tag is 131, which is what makes the first byte a total
  ; discriminator — asserted here directly, because if a future lane ever took
  ; 131 every legacy row would decode as garbage.
  (is (= [1 :a "x" 2 true]
         (datom.value-codec/decode-slot
           (erlang/term_to_binary [1 :a "x" 2 true]))))
  (is (= 42 (datom.value-codec/decode-slot (erlang/term_to_binary 42))))
  (is (= :kw (datom.value-codec/decode-slot (erlang/term_to_binary :kw))))
  (is (nil? (datom.value-codec/decode-slot nil)))
  (is (not= datom.value-codec/LEGACY-ETF datom.value-codec/LANE-DATOM)))

(deftest a-scalar-slot-keeps-its-own-lane
  ; The same keyspace holds transaction and entity counters, so the slot codec
  ; must carry scalars too — and a scalar must NOT take the datom lane.
  (is (= 42 (datom.value-codec/decode-slot (datom.value-codec/encode-slot 42))))
  (is (= datom.value-codec/LANE-LONG
         (datom.value-codec/byte-at (datom.value-codec/encode-slot 42) 0)))
  (is (= "s" (datom.value-codec/decode-slot (datom.value-codec/encode-slot "s")))))

