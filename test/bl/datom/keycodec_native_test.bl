; test/bl/datom/keycodec_native_test.bl — the native key codec is byte-identical.
; Run: mix beam_lisp.test test/bl/datom/keycodec_native_test.bl
;
; The order-preserving KEY encoding is the dominant transact cost, so it moves
; into Rust (native/datom_fjall/src/keycodec.rs). A key that encodes to
; different bytes than the bl codec would SORT differently — a silently corrupt
; index. So the ONLY acceptable native codec is one byte-identical to the bl
; oracle (datom.codec/encode-value). This suite is that oracle check, across the
; four bulk lanes and their edge cases; a native answer that differs, or that
; the native path declines (nil) where it should not, fails here.

(ns datom.keycodec-native.test
  (:require [datom.store-fjall :as fj] [datom.codec :as codec]))

;; Native encode for a value already classified into a lane. The NIF takes all
;; four slots positionally; we fill the one that matters and dummy the rest.
(defn- nat [tag ival sval bval]
  (fj/keycodec-encode tag ival sval bval))

;; bl strings ARE UTF-8 binaries, so pass them straight to the NIF's binary slot.
(defn- nat-int [n]  (nat :int n "" false))
(defn- nat-str [s]  (nat :str 0 s false))
(defn- nat-kw  [s]  (nat :kw  0 s false))
(defn- nat-bool [b] (nat :boolean 0 "" b))

;; ── ints (within ±2^53: the float-unified lane) ─────────────────────

(deftest ints-encode-identically
  (doseq [n [0 1 -1 42 -42 255 256 65535 -65536
             1000000 -1000000 9007199254740992 -9007199254740992]]
    (is (= (codec/encode-value n) (nat-int n))
        (str "int " n " native == bl"))))

;; ── strings (raw UTF-8, nul-escaped, 0-terminated) ──────────────────

(deftest strings-encode-identically
  (doseq [s ["" "a" "ast-node" "compiler" "erlang/binary_to_atom" "<top>"
             "with space" "unicode-\u00e9\u00e8"]]
    (is (= (codec/encode-value s) (nat-str s))
        (str "string " (pr-str s) " native == bl"))))

(deftest strings-with-nul-are-escaped-identically
  ;; the escape-nul path: a 0x00 in the payload must become 0x00 0xFF, or two
  ;; keys could collide. Build a string containing a NUL byte.
  (let [with-nul (erlang/list_to_binary (to-list [97 0 98]))]  ; "a<NUL>b" as a binary
    (is (= (codec/encode-value with-nul) (nat-str with-nul))
        "a string containing NUL escapes identically")))

;; ── keywords (name bytes, keyword tag) ──────────────────────────────

(deftest keywords-encode-identically
  (doseq [s ["fn" "call" "fn/name" "call/caller" "db/id"]]
    (let [kw (erlang/binary_to_atom s :utf8)]
      (is (= (codec/encode-value kw) (nat-kw s))
          (str "keyword :" s " native == bl")))))

;; ── bools ───────────────────────────────────────────────────────────

(deftest bools-encode-identically
  (is (= (codec/encode-value true) (nat-bool true)) "true native == bl")
  (is (= (codec/encode-value false) (nat-bool false)) "false native == bl"))

;; ── out-of-lane declines (returns nil, caller falls back) ───────────

(deftest out-of-lane-values-decline
  ;; a bignum past 2^53 uses the tie-break lane the native path does NOT cover;
  ;; it must return nil so the caller routes to the bl codec.
  (is (= nil (nat-int 9007199254740993))
      "an int past 2^53 declines (nil) rather than encode wrong bytes"))
