(ns datom.cache-empty-read-stamp-test
 (:require [datom :as d] [datom.cache-validity :as validity] [datom.attr-basis :as marks]
  [datom.derived :as derived] [datom.query.relation :as relation] [datom.store-fjall :as fjall]))
(def schema [{:db/ident :empty/value :db/valueType :db.type/string}
             {:db/ident :empty/other :db/valueType :db.type/long}
             {:db/ident :empty/computed :db/valueType :db.type/string}])
(defn proved [database] (validity/read-stamp database [:empty/value] {:prove-empty? true}))
(deftest exhausted-native-empty-proof-survives-unrelated-writes-and-refuses-first-insertion
 (let [c (d/connect schema)]
  (try
   (let [before (d/db c) stamp (proved before) legacy (validity/read-stamp before [:empty/value])]
    (is (some? stamp)) (is (not= stamp legacy))
    (d/transact! c [{:db/id -1 :empty/other 1}])
    (is (= stamp (proved (d/db c))))
    (is (not= legacy (validity/read-stamp (d/db c) [:empty/value])))
    (let [basis (d/basis-t (d/db c))]
     (proved (d/db c)) (is (= basis (d/basis-t (d/db c))) "negative evidence is a pure read"))
    (d/transact! c [{:db/id -2 :empty/value "present"}])
    (is (not= stamp (proved (d/db c))))
    (is (nil? (proved before)) "future attribute marks cannot certify an older reader"))
   (finally (d/close! c)))))
(deftest unknown-nonempty-legacy-attribute-and-incomplete-empty-page-stay-conservative
 (let [c (d/connect schema)]
  (try
   (d/transact! c [{:db/id 1 :empty/value "retired"} {:db/id 2 :empty/value "still present"}])
   (d/transact! c [[:db/retract 1 :empty/value "retired"]])
   ;; Simulate a legacy store with native facts but no attribute marker records.
   (derived/put-record! (:store c) marks/MARK-IDENT {})
   (derived/put-record! (:store c) marks/BUILD-IDENT {}) (marks/forget!)
   (let [before (proved (d/db c))]
    (is (not= {:empty? true} (first (get before 1))))
    (d/transact! c [{:db/id -3 :empty/other 2}])
    (is (not= before (proved (d/db c))) "zero visible rows with more groups is not absence")
    (is (= #{[2 "still present"]} (d/q '[:find ?e ?v :where [?e :empty/value ?v]] (d/db c)))))
   (finally (d/close! c)))))
(deftest unmarked-retracted-history-is-not-pristine-negative-evidence
 (let [c (d/connect schema)]
  (try
   (d/transact! c [{:db/id 1 :empty/value "removed"}])
   (d/transact! c [[:db/retract 1 :empty/value "removed"]])
   (derived/put-record! (:store c) marks/MARK-IDENT {})
   (derived/put-record! (:store c) marks/BUILD-IDENT {}) (marks/forget!)
   (is (not= {:empty? true} (first (get (proved (d/db c)) 1))))
   (finally (d/close! c)))))
(deftest retraction-unknown-schema-and-provider-registration-keep-their-authority
 (let [c (d/connect schema)]
  (try
   (d/transact! c [{:db/id 1 :empty/value "value"}])
   (let [before (proved (d/db c))]
    (d/transact! c [[:db/retract 1 :empty/value "value"]])
    (is (not= before (proved (d/db c)))))
   (is (some? (validity/read-stamp (d/db c) [:not/declared] {:prove-empty? true})))
   (relation/register-relation! :empty/computed {:arity 2 :modes #{:ff :bf :fb :bb}
      :provider (fn [_ _ _ _] [[900 "computed"]])})
   (is (nil? (validity/read-stamp (d/db c) [:empty/computed] {:prove-empty? true})) "native emptiness cannot override a computed provider")
   (finally (d/close! c)))))
(deftest durable-unwritten-attribute-proof-survives-marker-cache-eviction
 (let [path (str "/tmp/datom-empty-stamp-" (Base/encode16 (crypto/strong_rand_bytes 8)) ".fjall")
       raw (fjall/open path) c (d/connect-with raw schema)]
  (try
   (d/transact! c [{:db/id -1 :empty/other 7}])
   (let [stamp (proved (d/db c))]
    (marks/forget!)
    (is (= stamp (proved (d/db c))))
    (d/transact! c [{:db/id -2 :empty/other 8}])
    (is (= stamp (proved (d/db c)))))
   (finally (d/close! c) (File/rm_rf! path) (File/rm_rf! (str path ".blobs"))))))
