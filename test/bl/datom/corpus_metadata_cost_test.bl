(ns datom.corpus-metadata-cost-test
 (:require [datom :as d] [datom.query.corpus :as corpus] [datom.vector :as v]))
(def S [{:db/ident :vec :db/valueType :db.type/vector}])
(defn call-corpus [name args]
 (BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch! "datom.query.corpus" name) args))
(defn serialized-bytes [value] (erlang/byte_size (erlang/term_to_binary value)))

(deftest actual-emitted-metadata-and-resident-reads-exclude-unrequested-payloads
 (corpus/forget!)
 (corpus/set-budget! corpus/DEFAULT-BUDGET)
 (let [c (d/connect S)]
  (try
   (d/transact! c (mapv (fn [n] {:db/id (- -1 n) :vec (v/embedding (vec (repeat 64 1.0)))}) (range 256)))
   (let [db (d/db c)]
    (corpus/resident db :vec)
    (let [full (filterv (fn [r] (= 9 (erlang/tuple_size r))) (ets/tab2list corpus/TABLE))
          metadata (call-corpus "entry-rows" (list))
          resident (call-corpus "slot" (list db :vec :resident))
          old-bytes (serialized-bytes full) metadata-bytes (serialized-bytes metadata)]
     (is (= 256 (:rows (corpus/stats))))
     (is (= 1 (count metadata)))
     (is (nil? (elem (first metadata) 4)))
     (is (nil? (elem (first metadata) 5)))
     (is (nil? (elem (first metadata) 6)))
     (is (nil? (elem resident 4)))
     (is (nil? (elem resident 5)))
     (is (= 256 (v/resident-count (elem resident 6))))
     (is (< metadata-bytes (quot old-bytes 10)))
     (println "corpus-projection-metrics"
      {:entities 256 :dimensions 64 :whole-slot-bytes old-bytes
       :metadata-bytes metadata-bytes :resident-slot-bytes (serialized-bytes resident)})))
   (finally (d/close! c)))))

(deftest mixed-dimensional-row-columns-cannot-be-priced-from-the-small-first-row
 (corpus/forget!)
 (let [c (d/connect S)]
  (try
   (d/transact! c [{:db/id 1 :vec (v/embedding [1.0])}
                  {:db/id 2 :vec (v/embedding (vec (repeat 4096 1.0)))}])
   (is (= 2 (count (corpus/column (d/db c) :vec))))
   (is (>= (:bytes (corpus/stats)) (+ corpus/SLOT-BYTES (* 2 96) (* 4 (+ 1 4096)))))
   (finally (d/close! c)))))
