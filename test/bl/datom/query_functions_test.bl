(ns datom.query-functions-test
 (:require [datom] [datom.query.functions :as functions]
           [datom.query.relation :as relation]))

(def effects (atom 0))
(defn dangerous [value] (swap! effects inc) value)
(defn kind [f] (try (f) nil (catch e (:kind (ex-data e)))))
(defn database []
 (let [conn (datom/connect [{:db/ident :person/name :db/valueType :db.type/string}])]
  (datom/transact! conn [{:db/id -1 :person/name "Ada"}])
  (datom/db conn)))

(deftest unknown-external-keywords-do-not-allocate-permanent-atoms
 (is (= :find (functions/keyword-token "find")))
 (kind (fn [] (functions/keyword-token "__warm_unknown_query_keyword__")))
 (let [before (erlang/system_info :atom_count)]
  (doseq [index (range 50)]
   (is (= :query-keyword-refused
        (kind (fn [] (functions/keyword-token
                      (str "__unknown_query_keyword_" index "_" (erlang/unique_integer))))))))
  (is (= before (erlang/system_info :atom_count)))))

(deftest trusted-lexical-queries-and-closed-external-queries-have-distinct-authority
 (let [db (database)
       query '[:find ?n :where [?e :person/name ?n] [(dangerous ?n)]]]
  (reset! effects 0)
  (is (= #{["Ada"]} (datom/q query db)))
  (is (= 1 @effects))
  (is (= :query-function-refused
       (kind (fn [] (functions/with-only (fn [] (datom/q query db)))))))
  (is (= 1 @effects))
  (is (= #{["Ada"]}
       (functions/with-only
        (fn [] (datom/q '[:find ?n :where [?e :person/name ?n]
                          [(String/starts_with? ?n "A")] [(> (count ?n) 2)]] db)))))))

(deftest qualified-nested-and-empty-input-calls-refuse-before-effects
 (let [db (database)]
  (reset! effects 0)
  (doseq [query ['[:find ?n :where [?e :person/name ?n] [(File/read! "unused")]]
                '[:find ?n :where [?e :person/name ?n] [(str (dangerous ?n))]]
                '[:find ?n :where [?e :person/name "Nobody"] [?e :person/name ?n] [(dangerous ?n)]]]]
   (is (= :query-function-refused
        (kind (fn [] (functions/with-only (fn [] (datom/q query db))))))))
  (is (= 0 @effects))))

(deftest quote-is-inert-but-unused-rule-bodies-are-checked
 (let [db (database)]
  (is (= #{["Ada"]}
       (functions/with-only
        (fn [] (datom/q '[:find ?n :where [?e :person/name ?n]
                          [(= (quote (File/read! "unused")) (quote (File/read! "unused")))]] db)))))
  (is (= :query-function-refused
       (kind (fn [] (functions/with-only
                     (fn [] (datom/q '[:find ?n :in $ % :where [?e :person/name ?n]] db
                                '[[(unused ?n) [(dangerous ?n)]]])))))))))

(deftest nested-scopes-cannot-expand-and-failures-restore-the-caller
 (is (not (functions/restricted?)))
 (is (= :query-function-refused
      (kind (fn [] (functions/with-only
                    (fn [] (functions/with-only {"dangerous" dangerous}
                             (fn [] (functions/resolve-op 'dangerous (fn [] dangerous))))))))))
 (is (not (functions/restricted?)))
 (is (= :synthetic
      (kind (fn [] (functions/with-only (fn [] (throw (ex-info "synthetic" {:kind :synthetic}))))))))
 (is (not (functions/restricted?))))

(deftest computed-application-providers-cannot-bypass-closed-function-resolution
 (let [db (database) calls (atom 0)]
  (relation/register-relation! :closed/test-pairs
    {:arity 2 :modes #{:ff :bf :fb :bb}
     :provider (fn [_db _mode _bounds _args] (swap! calls inc) [[1 "Ada"]])})
  (is (= :query-function-refused
       (kind (fn [] (functions/with-only
                     (fn [] (datom/q '[:find ?n :where [?e :closed/test-pairs ?n]] db)))))))
  (is (= 0 @calls))))

(deftest foreign-enumerables-and-runtime-handles-refuse-before-protocol-dispatch
 (let [db (database)]
  (doseq [value [{:__struct__ :Elixir.File.Stream :path "unused" :modes []}
                (tuple :$transient :map :synthetic-secret)]]
   (let [query (conj '[:find ?n :where [?e :person/name ?n]]
                     [(list 'count value)])]
    (is (= :unsafe-first-order-data
         (kind (fn [] (functions/with-only (fn [] (datom/q query db)))))))))
  ;; The same check applies to values from a trusted database, not just literals.
  (is (= :unsafe-first-order-data
       (kind (fn [] (functions/with-only
                     (fn [] ((functions/resolve-op 'count (fn [] count))
                               {:__struct__ :Elixir.File.Stream :path "unused"})))))))))
