(ns datom.schema-noop-test
 (:require [datom :as d] [datom.conn :as dc] [datom.store-map :as sm]
           [datom.index-coverage :as coverage]))
(def definitions
 [{:db/ident :test/id :db/valueType :db.type/string :db/unique :db.unique/identity}
  {:db/ident :test/value :db/valueType :db.type/long :db/index true}])
(deftest identical-covered-schema-installation-does-not-invalidate-the-basis
 (let [c (dc/connect-with (sm/open) definitions)]
  (d/transact! c [{:db/id -1 :test/id "one" :test/value 7}])
  (let [before (d/db c) eid (:db/id (d/entity before [:test/id "one"]))]
   (d/install-schema! c definitions)
   (is (= (d/basis-t before) (d/basis-t (d/db c))))
   (is (= eid (:db/id (d/entity (d/db c) [:test/id "one"]))))
   (is (= #{[7]} (d/q '[:find ?v :where [_ :test/value ?v]] (d/db c))))
   (is (= (count (d/datoms (d/history before) :aevt :db/ident))
          (count (d/datoms (d/history (d/db c)) :aevt :db/ident)))))))
(deftest identical-schema-still-repairs-missing-index-coverage
 (let [c (dc/connect-with (sm/open) definitions)]
  (d/transact! c [{:db/id -1 :test/id "one" :test/value 7}])
  (coverage/invalidate! (:store c) :test/value)
  (is (not (coverage/complete? (:store c) (d/schema c) :test/value (d/basis-t (d/db c)))))
  (d/install-schema! c definitions)
  (is (coverage/complete? (:store c) (d/schema c) :test/value (d/basis-t (d/db c))))
  (is (= [7] (mapv d/datom-v (d/datoms (d/db c) :avet :test/value 7))))))
(deftest an-interrupted-schema-publication-is-not-skipped-as-a-noop
 (let [c (dc/connect-with (sm/open) definitions)]
  (reset! (:schema-publication c) (d/schema c))
  (d/install-schema! c definitions)
  (is (nil? @(:schema-publication c)))
  (d/transact! c [{:db/id -1 :test/id "after-repair" :test/value 9}])
  (is (= #{[9]} (d/q '[:find ?v :where [_ :test/value ?v]] (d/db c))))))
