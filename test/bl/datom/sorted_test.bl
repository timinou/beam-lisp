; test/bl/datom/sorted_test.bl — ordered collections, tested in-language.
; Run: mix beam_lisp.test test/bl/datom/sorted_test.bl
;
; The Elixir suite (test/beam_lisp/sorted_test.exs) pins the SUBSTRATE:
; encoding order, gb_trees behaviour, RT clause ordering. This suite pins
; the LANGUAGE SURFACE: that a beam-lisp author writing `(sorted-map …)`
; gets Clojure's semantics, and that ordered collections compose with the
; rest of core — map, filter, reduce, into, destructuring — rather than
; being a special case you must remember to handle.
;
; The distinction matters because a collection type can pass every
; substrate test and still be unusable: if `map` over it silently walks
; the struct's fields, the type is broken in exactly the way that is
; hardest to notice.

(ns datom.sorted.test)

;; ── ordering is the contract ────────────────────────────────────────────────

(deftest sorted-map-iterates-in-key-order
  (let [m (sorted-map :c 3 :a 1 :b 2)]
    (is (= '(:a :b :c) (keys m)))
    (is (= '(1 2 3) (vals m)))))

(deftest sorted-set-iterates-in-member-order
  ; Construction order must not leak into iteration order — that is the
  ; entire difference from a hashed set.
  (is (= '(1 2 3) (seq (sorted-set 3 1 2))))
  (is (= '(1 2 3) (seq (sorted-set 1 2 3))))
  (is (= (seq (sorted-set 3 1 2)) (seq (sorted-set 2 3 1)))))

(deftest ordering-is-numeric-across-int-and-float
  ; A rank that separated ints from floats would sort 1 2 1.5 — plausible
  ; looking, and wrong for any range predicate over mixed numbers.
  (is (= '(1 1.5 2 2.5 3) (seq (sorted-set 3 1.5 2 1 2.5)))))

(deftest ordering-puts-nil-first
  (is (= nil (first (sorted-set :kw nil 5)))))

;; ── the range scan: why these types exist ───────────────────────────────────

(deftest range-of-is-inclusive-on-both-bounds
  (let [s (into-sorted-set (range 1 21))]
    (is (= '(5 6 7 8) (range-of s 5 8)))))

(deftest range-of-treats-nil-as-unbounded
  (let [s (into-sorted-set [1 2 3 4 5])]
    (is (= '(1 2 3) (range-of s nil 3)))
    (is (= '(4 5) (range-of s 4 nil)))
    (is (= '(1 2 3 4 5) (range-of s nil nil)))))

(deftest range-of-brackets-bounds-that-fall-between-keys
  ; The bound need not be a member: this is what makes a range predicate
  ; like `(< 15 ?age 35)` work without knowing which ages exist.
  (let [s (into-sorted-set [10 20 30 40])]
    (is (= '(20 30) (range-of s 15 35)))))

(deftest range-of-empty-window-is-empty-not-an-error
  (let [s (into-sorted-set [1 2 3])]
    (is (= '() (range-of s 10 20)))
    ; inverted bounds yield nothing rather than raising
    (is (= '() (range-of s 3 1)))))

(deftest reverse-range-of-keeps-ascending-bounds
  ; Bounds stay [start stop] in ascending terms, so swapping range-of for
  ; reverse-range-of changes ORDER only, never WHICH elements return.
  (let [s (into-sorted-set [1 2 3 4 5])]
    (is (= '(4 3 2) (reverse-range-of s 2 4)))
    (is (= (reverse (range-of s 2 4)) (reverse-range-of s 2 4)))))

(deftest range-over-a-sorted-map-yields-entries
  (let [m (sorted-map 1 :a 2 :b 3 :c)]
    (is (= [[1 :a] [2 :b]] (into [] (range-of m 1 2))))))

;; ── map semantics ───────────────────────────────────────────────────────────

(deftest sorted-map-answers-map-operations
  (let [m (sorted-map :a 1 :b 2)]
    (is (= 1 (get m :a)))
    (is (= :missing (get m :zz :missing)))
    (is (= 2 (count m)))
    (is (contains? m :a))
    (is (not (contains? m 1)))
    (is (map? m))
    (is (sorted? m))))

(deftest sorted-map-find-distinguishes-absence-from-nil
  ; The bug this guards: a struct-shadowing clause made find return nil
  ; for keys that exist, which is indistinguishable from a nil VALUE.
  (let [m (into-sorted-map [[:present 1] [:nil-valued nil]])]
    (is (= [:present 1] (find m :present)))
    (is (= [:nil-valued nil] (find m :nil-valued)))
    (is (nil? (find m :absent)))))

(deftest assoc-maintains-order-for-a-key-inserted-in-the-middle
  (let [m (assoc (sorted-map :a 1 :c 3) :b 2)]
    (is (= '(:a :b :c) (keys m)))))

(deftest sorted-map-get-does-not-expose-the-backing-field
  ; :tree is the struct's internal field. If it is reachable, the clause
  ; order is wrong and every other guarantee here is suspect.
  (is (= :missing (get (sorted-map :a 1) :tree :missing))))

;; ── set semantics ───────────────────────────────────────────────────────────

(deftest sorted-set-answers-set-operations
  (let [s (sorted-set 1 2 3)]
    (is (contains? s 2))
    (is (not (contains? s 99)))
    (is (= 3 (count s)))
    (is (set? s))
    (is (sorted? s))
    (is (not (map? s)))))

(deftest conj-and-disj-are-idempotent
  (let [s (sorted-set 1 2 3)]
    (is (= 3 (count (conj s 2))))
    (is (= 4 (count (conj s 0))))
    (is (= 0 (first (conj s 0))) "conj keeps order, not insertion position")
    (is (= 2 (count (disj s 1))))
    (is (= 3 (count (disj s 99))))))

;; ── endpoints ───────────────────────────────────────────────────────────────

(deftest first-is-smallest-and-last-key-is-largest
  (let [s (sorted-set 5 1 3)]
    (is (= 1 (first s)))
    (is (= 5 (last-key s)))))

(deftest endpoints-of-an-empty-collection-are-nil
  (is (nil? (first (sorted-set))))
  (is (nil? (last-key (sorted-set))))
  (is (nil? (seq (sorted-set))))
  (is (nil? (seq (sorted-map)))))

(deftest empty-sorted-collection-is-falsy-through-seq
  ; `(when (seq coll) …)` must treat an empty ordered collection like
  ; every other empty collection.
  (is (= :empty (if (seq (sorted-set)) :nonempty :empty))))

;; ── composition with core ───────────────────────────────────────────────────
;;
;; A collection type earns its place by working with the vocabulary that
;; already exists, not by having its own parallel one.

(deftest map-and-filter-preserve-order
  (let [s (sorted-set 3 1 2)]
    (is (= '(10 20 30) (map (fn [x] (* x 10)) s)))
    (is (= '(2) (filter even? s)))))

(deftest reduce-walks-in-order
  ; Order-dependent reduction is the sharpest test: a hashed set would
  ; give a different (and unstable) answer.
  (is (= "123" (reduce (fn [acc x] (str acc x)) "" (sorted-set 3 1 2)))))

(deftest sorted-map-entries-destructure-like-plain-map-entries
  (let [m (sorted-map :a 1 :b 2)]
    (is (= '([:a 1] [:b 2]) (map (fn [e] [(get e 0) (get e 1)]) m)))))

(deftest into-collects-a-sorted-collection
  (is (= [1 2 3] (into [] (sorted-set 3 1 2)))))

(deftest sorted-collections-print-in-order
  (is (= "#{1 2 3}" (pr-str (sorted-set 3 1 2))))
  (is (= "{:a 1, :b 2}" (pr-str (sorted-map :b 2 :a 1)))))

;; ── type predicates ─────────────────────────────────────────────────────────

(deftest sorted-predicates-are-precise
  (let [m (sorted-map :a 1)
        s (sorted-set 1)]
    (is (sorted-map? m))
    (is (not (sorted-map? s)))
    (is (sorted-set? s))
    (is (not (sorted-set? m)))
    (is (not (sorted? {})))
    (is (not (sorted? #{})))
    (is (not (sorted? [])))))

;; ── review-gate regressions (wave 1 swarm) ──────────────────────────────────
;;
;; Every test below pins a bug the reviewers found and the original suite
;; missed. They share a shape: the operation returned a PLAUSIBLE answer,
;; so nothing looked broken until someone compared it against the
;; language's own contract.

(deftest ordering-agrees-with-the-language-comparator
  ; `RT.compare/2` is the authoritative total order. The encoder must
  ; PROJECT it, not invent a second one. It disagreed in three places:
  ; false sorted after 0, keywords before strings, true after 1.
  (is (= '(false 0) (seq (sorted-set 0 false))))
  (is (= '("s" :s) (seq (sorted-set :s "s"))))
  (is (= '(true 1) (seq (sorted-set 1 true))))
  (is (= '(nil false) (seq (sorted-set false nil)))))

(deftest ordering-matches-sort-for-mixed-values
  ; The strongest statement of the same property: a sorted set and
  ; `(sort …)` must agree for ANY value set, because both claim to
  ; implement Clojure's order.
  (let [vs [:kw "str" 5 nil true false 1.5]]
    (is (= (sort vs) (seq (into-sorted-set vs))))))

(deftest a-legal-keyword-is-not-an-unbounded-sentinel
  ; `:unbounded` was the internal marker for "no bound", so scanning for
  ; the KEYWORD :unbounded silently returned the whole collection.
  (let [s (sorted-set :a :unbounded :z)]
    (is (= '(:unbounded) (range-of s :unbounded :unbounded)))
    (is (= '(:a :unbounded) (range-of s :a :unbounded)))))

(deftest equality-follows-clojure-not-representation
  ; Sortedness is an index property, not part of a value's identity.
  ; Comparing the backing gb_trees against a MapSet answered false for
  ; values the language considers equal.
  (is (= (sorted-map :a 1) {:a 1}))
  (is (= {:a 1} (sorted-map :a 1)))
  (is (= (sorted-set 1 2) (set [1 2])))
  (is (= (sorted-set 1 2) (sorted-set 2 1)))
  (is (not= (sorted-map :a 1) {:a 2}))
  (is (not= (sorted-map :a 1) {:a 1 :b 2})))

(deftest dissoc-actually-removes-from-a-sorted-map
  ; dissoc reached for Map/delete, which edits the STRUCT: the key stayed.
  (let [m (dissoc (sorted-map :a 1 :b 2) :a)]
    (is (not (contains? m :a)))
    (is (= 1 (count m)))
    (is (sorted? m) "dissoc must not degrade the type")))

(deftest merge-preserves-the-sorted-type
  ; merge folded into a literal {}, silently discarding ordering.
  (let [m (merge (sorted-map :b 2) {:a 1})]
    (is (sorted? m))
    (is (= '(:a :b) (keys m)) "and the result is actually ordered")))

(deftest peek-and-pop-reject-ordered-collections
  ; Clojure's peek/pop are stack operations, defined on list/queue/vector.
  ; The generic fallback answered first/rest, which looks like a feature
  ; and is a different operation wearing the same name. pop was worse: it
  ; returned a plain list, changing the type too.
  (is (= :raised (try (peek (sorted-set 1 2)) (catch e :raised))))
  (is (= :raised (try (pop (sorted-set 1 2)) (catch e :raised))))
  (is (= :raised (try (peek (sorted-map :a 1)) (catch e :raised))))
  (is (= :raised (try (pop (sorted-map :a 1)) (catch e :raised)))))
