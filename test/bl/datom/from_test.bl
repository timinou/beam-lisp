(ns datom.from.test
  (:require [datom] [datom.store-ets]))

(deftest build-from-query-shape
  ; the builder produces the expected datalog query vector
  (let [q (datom/build-from-query :spend/model
            [[:gather [:spend/model :spend/cost]]
             [:group-by :spend/model]
             [:agg {:total (list 'sum :spend/cost)}]])]
    (is (vector? q))
    (is (= :find (get q 0)))))

(deftest from-runs-a-real-query
  (let [store (datom.store-ets/open)
        conn (datom/connect-with store
               [{:db/ident :spend/model :db/valueType :db.type/string}
                {:db/ident :spend/cost :db/valueType :db.type/long}])
        _ (datom/transact! conn [{:db/id 1 :spend/model "gpt-4o" :spend/cost 10}
                                 {:db/id 2 :spend/model "gpt-4o" :spend/cost 20}
                                 {:db/id 3 :spend/model "claude" :spend/cost 5}])
        db (datom/db conn)
        res (datom/from db :spend/model
              (gather [:spend/model :spend/cost])
              (group-by :spend/model)
              (agg {:total (sum :spend/cost)}))]
    (is (= #{["gpt-4o" 30] ["claude" 5]} res))))

(deftest from-with-where-filter
  (let [store (datom.store-ets/open)
        conn (datom/connect-with store
               [{:db/ident :spend/model :db/valueType :db.type/string}
                {:db/ident :spend/provider :db/valueType :db.type/string}
                {:db/ident :spend/cost :db/valueType :db.type/long}])
        _ (datom/transact! conn [{:db/id 1 :spend/model "gpt-4o" :spend/provider "openai" :spend/cost 10}
                                 {:db/id 2 :spend/model "claude" :spend/provider "anthropic" :spend/cost 20}
                                 {:db/id 3 :spend/model "haiku" :spend/provider "anthropic" :spend/cost 5}])
        db (datom/db conn)
        res (datom/from db :spend/model
              (gather [:spend/model :spend/provider :spend/cost])
              (where [= :spend/provider "anthropic"])
              (agg {:total (sum :spend/cost)}))]
    ; only anthropic rows counted
    (is (= #{[25]} res))))
