(ns datom.txfn-bounds-test (:require [datom] [datom.tx :as tx] [datom.db :as db] [datom.conn :as conn]))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn- recur-by-name [_] [[:db/fn :bounds/recursive]])
(defn- overloaded
 ([database] [[:db/add 1 :test/value 10]])
 ([database value] [[:db/add 1 :test/value value]]))

(deftest recursive-named-composition-refuses-atomically
 (tx/register-fn! :bounds/recursive recur-by-name)
 (let [c (datom/connect [{:db/ident :test/value :db/valueType :db.type/long}])]
  (try
   (datom/transact! c [[:db/add 1 :test/value 7]])
   (is (= :tx-function-expansion-limit
          (kind #(datom/transact! c [[:db/add 1 :test/value 8] [:db/fn :bounds/recursive]]))))
   (is (= 7 (db/attr-value (datom/db c) 1 :test/value)))
   (finally (conn/release! c)))))

(deftest direct-multi-arity-language-functions-are-valid-transaction-functions
 (let [c (datom/connect [{:db/ident :test/value :db/valueType :db.type/long}])]
  (try
   (datom/transact! c [[:db/fn overloaded]])
   (is (= 10 (db/attr-value (datom/db c) 1 :test/value)))
   (datom/transact! c [[:db/fn overloaded 20]])
   (is (= 20 (db/attr-value (datom/db c) 1 :test/value)))
   (finally (conn/release! c)))))

(deftest invalid-function-output-refuses-atomically
 (let [c (datom/connect [{:db/ident :test/value :db/valueType :db.type/long}])]
  (try
   (datom/transact! c [[:db/add 1 :test/value 7]])
   (is (= :invalid-tx-function-result
          (kind #(datom/transact! c [[:db/add 1 :test/value 8] [:db/fn (fn [_] "invalid")]]))))
   (is (= 7 (db/attr-value (datom/db c) 1 :test/value)))
   (finally (conn/release! c)))))
