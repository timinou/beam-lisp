(ns datom.text-net-transitions-test
  (:require [datom] [datom.text :as text]))
(deftest intermediate-values-and-normalization-only-edits-never-create-ghost-candidates
  (do
    (let [c (datom/connect [{:db/ident :note/text :db/valueType :db.type/string :db/fulltext true}])
          r (datom/transact! c [{:db/id -1 :note/text "old freedom"}]) e (get (:tempids r) -1)]
      (try
        (datom/transact! c [[:db/add e :note/text "intermediate zephyr"] [:db/add e :note/text "final liberty"]])
        (is (empty? (:eids (text/candidates (datom/db c) :note/text "zephyr" {}))))
        (is (= #{e} (:eids (text/candidates (datom/db c) :note/text "liberty" {}))))
        (datom/transact! c [[:db/add e :note/text "FINAL LIBERTY"]])
        (is (= #{e} (:eids (text/candidates (datom/db c) :note/text "liberty" {}))))
        (datom/transact! c [[:db/retractEntity e]])
        (is (empty? (:eids (text/candidates (datom/db c) :note/text "liberty" {}))))
        (finally (datom/close! c))))))
