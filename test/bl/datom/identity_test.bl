(ns datom.identity-test (:require [datom.identity :as identity]))
(deftest native-identity-ignores-storage-order-and-metadata
 (let [vector (vec (range 70)) dense (maps/put :items (erlang/list_to_tuple (BeamLisp.Vector/to_list vector)) vector)
       m (into {} (map (fn [n] [(str n) n]) (range 45)))
       reversed (into {} (reverse (vec m)))]
  (is (= vector dense))
  (is (not= (erlang/term_to_binary vector) (erlang/term_to_binary dense)))
  (is (= (identity/digest vector) (identity/digest dense)))
  (is (= (identity/digest vector) (identity/digest (with-meta vector {:source "ignored"}))))
  (is (= (identity/digest m) (identity/digest reversed)))
  (is (= (identity/digest #{:one :two}) (identity/digest (conj #{:two} :one))))
  (is (= (identity/digest {:b 2 :a 1}) (identity/digest (sorted-map :a 1 :b 2))))
  (is (= (identity/digest #{:one :two}) (identity/digest (sorted-set :two :one))))
  (is (= (identity/digest 1) (identity/digest 1.0)))
  (is (= 64 (count (identity/digest {:definition ["bytes" :keyword true nil 100000000000000000000000]}))))))
(deftest native-identity-retains-type-and-content
 (doseq [[a b] [["one" :one] [[] ()] [false nil] [[1 2] [2 1]] [{:a 1} {:a 2}] [1 2]]]
  (is (not= (identity/digest a) (identity/digest b)))))
(deftest opaque-execution-and-lazy-computation-have-no-durable-definition-identity
 (doseq [value [(erlang/self) (erlang/make_ref) (fn [] 1) (map (fn [x] x) [1 2]) {:nested (fn [] 3)}]]
  (is (= :invalid-identity (try (identity/digest value) nil (catch e (:kind (ex-data e))))))))
(deftest validated-schema-identity-is-order-independent-but-detects-definition-change
 (let [one {:db/ident :identity/name :db/valueType :db.type/string}
       two {:db/ident :identity/count :db/valueType :db.type/long}]
  (is (= (identity/schema-digest [one two]) (identity/schema-digest [two one one])))
  (is (not= (identity/schema-digest [one]) (identity/schema-digest [(assoc one :db/index true)])))
  (is (= :invalid-identity (try (identity/schema-digest [one (assoc one :db/index true)]) nil (catch e (:kind (ex-data e))))))
  (is (= :invalid-identity (try (identity/schema-digest [{:db/ident :identity/bad :db/valueType :unknown}]) nil (catch e (:kind (ex-data e))))))))
