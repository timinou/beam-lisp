(ns datom.index-publication-test
  (:require [datom] [datom.conn :as conn] [datom.db :as db]
            [datom.schema :as schema] [datom.time :as time]
            [datom.store :as store] [datom.store-ets :as ets-store]
            [datom.store-fjall :as fjall]))

(defrecord ObservedStore [inner observe]
  store/Store
  (-get [s k] (store/-get (:inner s) k))
  (-range [s lo hi] (store/-range (:inner s) lo hi))
  (-put [s k v] (store/-put (:inner s) k v))
  (-delete [s k] (store/-delete (:inner s) k))
  (-update [s k f] (store/-update (:inner s) k f))
  (-commit [s ops]
    (when-let [f (deref (:observe s))] (f ops))
    (store/-commit (:inner s) ops)))

(def before [{:db/ident :i/value :db/valueType :db.type/long}])
(def after [{:db/ident :i/value :db/valueType :db.type/long :db/index true}])

(deftest newly-indexed-history-preserves-assertions-and-retractions
  (doseq [s [(ets-store/open) (fjall/open-fresh)]]
   (let [c (conn/connect-with s before)
        r1 (datom/transact! c [{:db/id -1 :i/value 7}])
        e (get (:tempids r1) -1)]
    (datom/transact! c [[:db/add e :i/value 9]])
    (datom/transact! c [[:db/retract e :i/value 9]])
    (conn/install-schema! c after)
    (let [now (conn/db c) old (time/as-of now (:tx r1)) h (time/history now)]
      (is (= [] (db/datoms now :avet :i/value)))
      (is (= (db/datoms old :aevt :i/value) (db/datoms old :avet :i/value)))
      (is (= (set (db/datoms h :aevt :i/value)) (set (db/datoms h :avet :i/value))))))))

(deftest index-publication-follows-successful-backfill
  (doseq [publish [conn/install-schema! conn/sync-schema!]]
    (let [observe (atom nil)
          c (conn/connect-with (->ObservedStore (ets-store/open) observe) before)
          _ (datom/transact! c [{:db/id -1 :i/value 7}])
          seen (atom [])]
      (reset! observe (fn [_]
                        (swap! seen conj (schema/indexed? (conn/schema c) :i/value))
                        (throw (ex-info "injected backfill failure" {}))))
      (is (= :failed (try (publish c after) :unexpected (catch _ :failed))))
      (is (= [false] (deref seen)))
      (is (= false (schema/indexed? (conn/schema c) :i/value)))
      (reset! observe nil)
      (publish c after)
      (is (= true (schema/indexed? (conn/schema c) :i/value)))
      (is (= 1 (count (db/datoms (conn/db c) :avet :i/value)))))))

(deftest multi-index-failure-keeps-old-schema-and-retry-is-complete
  (let [observe (atom nil)
        a [{:db/ident :i/a :db/valueType :db.type/long}
           {:db/ident :i/b :db/valueType :db.type/long}]
        b (mapv (fn [d] (assoc d :db/index true)) a)
        c (conn/connect-with (->ObservedStore (ets-store/open) observe) a)
        attempts (atom 0)]
    (datom/transact! c [{:db/id -1 :i/a 1 :i/b 2}])
    (reset! observe (fn [_]
                      (when (= 2 (swap! attempts inc))
                        (throw (ex-info "second index failed" {})))))
    (is (= :failed (try (conn/install-schema! c b) :unexpected (catch _ :failed))))
    (is (= false (schema/indexed? (conn/schema c) :i/a)))
    (is (= false (schema/indexed? (conn/schema c) :i/b)))
    (reset! observe nil)
    (conn/install-schema! c b)
    (is (= 1 (count (db/datoms (conn/db c) :avet :i/a))))
    (is (= 1 (count (db/datoms (conn/db c) :avet :i/b))))))
