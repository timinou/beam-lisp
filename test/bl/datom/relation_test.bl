; test/bl/datom/relation_test.bl — relations as first-class citizens.
; Run: mix beam_lisp.test test/bl/datom/relation_test.bl
;
; Locks in the seven-axis abstraction: a COMPUTED relation is registered,
; usable in both spellings, honours access modes, recurses through the native
; fixpoint, is relation-polymorphic, and describes itself as data.

(ns datom.relation.test
  (:require [datom] [datom.vector :as v]
            [datom.query.relation :as rel] [datom.query.relations :as rels]
            [datom.query.fixpoint :as fp]))

(defn- emb [& xs] (v/embedding (into [] xs)))

(defn- world
  "A tiny embedded corpus: two tight pairs (1~2, 3~4) and an outlier (5)."
  []
  (let [conn (datom/connect
               [{:db/ident :w/text :db/valueType :db.type/string}
                {:db/ident :w/vec :db/valueType :db.type/vector}
                {:db/ident :w/topic :db/valueType :db.type/keyword}])]
    (datom/transact! conn
      [{:db/id 1 :w/text "a" :w/topic :x :w/vec (emb 1.0 0.0 0.0)}
       {:db/id 2 :w/text "b" :w/topic :x :w/vec (emb 0.95 0.05 0.0)}
       {:db/id 3 :w/text "c" :w/topic :y :w/vec (emb 0.0 1.0 0.0)}
       {:db/id 4 :w/text "d" :w/topic :y :w/vec (emb 0.0 0.95 0.05)}
       {:db/id 5 :w/text "e" :w/topic :z :w/vec (emb 0.0 0.0 1.0)}])
    (datom/db conn)))

;; register a fresh :~sim each test (idempotent; replace by ident)
(defn- register-sim! [k threshold]
  (rel/register-relation! :~sim
    {:arity 2 :modes #{:bf :bb :fb} :tags #{:semantic} :args []
     :provider (rels/knn-adjacency :w/vec {:k k :threshold threshold})}))

;; ── 1. registration + introspection ─────────────────────────────────

(deftest register-and-introspect
  (register-sim! 1 0.5)
  (is (rel/computed? :~sim) "a registered relation is computed?")
  (is (not (rel/computed? :w/text)) "a stored attribute is not computed?")
  (is (contains? (set (rel/idents)) :~sim) "it appears in the catalog idents")
  (is (= 2 (get (rel/relation :~sim) :arity)) "its declared arity is readable"))

;; ── 2. both spellings yield the same relation ───────────────────────

(deftest attribute-and-call-spellings-agree
  (register-sim! 1 0.5)
  (let [db (world)
        via-attr (set (into [] (datom/q '[:find ?a ?b :where [?a :~sim ?b]] db)))
        via-call (set (into [] (datom/q '[:find ?a ?b :where [(:~sim) [?a ?b]]] db)))]
    (is (= via-attr via-call) "attribute [?a :~sim ?b] = call [(:~sim) [?a ?b]]")
    (is (contains? via-attr [1 2]) "the tight pair 1~2 is an edge")))

;; ── 3. the three access modes ───────────────────────────────────────

(deftest access-modes-bf-bb-fb
  (register-sim! 1 0.5)
  (let [db (world)
        ;; :bf generate — neighbours of 1
        bf (set (mapv (fn [r] (get r 0))
                      (into [] (datom/q '[:find ?b :in $ ?a :where [?a :~sim ?b]] db 1))))
        ;; :bb probe — is 1~2 an edge? is 1~5?
        probe (fn [a b] (not (empty? (into [] (datom/q '[:find ?b :in $ ?a ?b :where [?a :~sim ?b]] db a b)))))
        ;; :fb reverse — who has 2 as a neighbour?
        fb (set (mapv (fn [r] (get r 0))
                      (into [] (datom/q '[:find ?a :in $ ?b :where [?a :~sim ?b]] db 2))))]
    (is (contains? bf 2) ":bf — 1's neighbour is 2")
    (is (probe 1 2) ":bb — 1~2 holds")
    (is (not (probe 1 5)) ":bb — 1~5 does not hold (outlier below threshold)")
    (is (contains? fb 1) ":fb — 1 has 2 as a neighbour (reverse)")))

;; ── 4. computed relation joins with stored facts ────────────────────

(deftest computed-joins-with-stored
  (register-sim! 1 0.5)
  (let [db (world)
        ;; semantic neighbours that share the SAME stored topic
        r (set (into [] (datom/q '[:find ?a ?b
                                   :where [?a :~sim ?b]
                                          [?a :w/topic ?t] [?b :w/topic ?t]]
                                 db)))]
    (is (contains? r [1 2]) "1~2 are similar AND same topic :x")
    (is (not (some (fn [p] (= (get p 0) 5)) (into [] r))) "the outlier joins nothing")))

;; ── 5. THE UNLOCK: recursion over a computed relation is native ─────

(deftest semantic-recursion-is-native
  (register-sim! 2 0.3)
  (let [db (world)
        RULES '[[(reaches ?a ?b) [?a :~sim ?b]]
                [(reaches ?a ?b) [?a :~sim ?x] (reaches ?x ?b)]]
        ep (fn [d b clause]
             ((BeamLisp.Env/fetch! "datom.query.engine" "eval-clause")
              d b clause (fn [op] (try (BeamLisp.Env/fetch! "core" (name op)) (catch e nil))) {}))]
    (is (fp/compatible? RULES)
        "a recursive rule over a computed relation is native-compatible")
    (let [closure (get (fp/materialise db RULES ep) 'reaches)]
      (is (contains? closure [1 2]) "native fixpoint over computed edges: 1 reaches 2")
      (is (> (count closure) 0) "the native driver materialises computed edges as a base relation"))))

;; ── 6. relation-polymorphism: a variable attribute ─────────────────

(deftest relation-polymorphism
  (register-sim! 1 0.5)
  (let [db (world)
        ;; [?a ?rel ?b] with ?rel bound via :in to the relation ident
        r (set (into [] (datom/q '[:find ?a ?b :in $ ?rel :where [?a ?rel ?b]] db :~sim)))]
    (is (contains? r [1 2]) "[?a ?rel ?b] traverses whatever ?rel names")))

;; ── 7. catalog as data ──────────────────────────────────────────────

(deftest catalog-describes-itself
  (register-sim! 1 0.5)
  (let [datoms (rel/catalog-datoms)
        sim-datoms (filterv (fn [d] (= (get d 0) :~sim)) datoms)]
    (is (some (fn [d] (and (= (get d 1) :relation/extension) (= (get d 2) :computed))) sim-datoms)
        "the catalog records :~sim as :computed")
    (is (some (fn [d] (and (= (get d 1) :relation/tag) (= (get d 2) :semantic))) sim-datoms)
        "the catalog records its :semantic tag")
    (is (some (fn [d] (and (= (get d 1) :relation/mode) (= (get d 2) :fb))) sim-datoms)
        "the catalog records its reverse (:fb) mode")))
