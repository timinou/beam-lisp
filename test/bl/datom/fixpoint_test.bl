; test/bl/datom/rules_native_test.bl — the native fixpoint vs the SPEC.
; Run: mix beam_lisp.test test/bl/datom/rules_native_test.bl
;
; The one-truth driver (datom.query.fixpoint) runs the WHOLE fixpoint in
; the native kernel; bl only supplies base relations + decode. To trust it we
; check it against the CLOSED-FORM answer of each classic recursion \u2014 not
; against a second bl implementation (that would be the two-truths trap). If a
; property holds against math, the kernel is correct; a bl twin proves nothing
; math doesn't.
;
; Specs used:
;   transitive closure of a chain 1..n  = all (i,j) with i<j  \u2192 n(n-1)/2 pairs
;   reachable-from-1 in that chain       = exactly {(1,2)\u2026(1,n)} \u2192 n-1 pairs
;   cycle 1..n\u21921                          = all ordered pairs incl self \u2192 n\u00b2
;   same-generation                       = pairs at equal depth (hand-computed)
;   shortest path                         = Dijkstra answer (hand-computed)

(ns datom.fixpoint.test
  (:require [datom] [datom.query.fixpoint :as fp] [datom.query.rules :as blr]
            [datom.query.engine :as eng]))

(def eval-plain
  (fn [d b c]
    (eng/eval-clause d b c
                     (fn [op] (try (BeamLisp.Env/fetch! "core" (name op)) (catch e nil)))
                     {})))

;; integer-valued edge store (values are ints so arithmetic is real)
(defn- edge-db [triples attrs]
  (let [conn (datom/connect attrs)]
    (datom/transact! conn
      (into [] (map-indexed (fn [i t] (assoc t :db/id (- (+ i 1)))) triples)))
    (datom/db conn)))

(def EDGE-ATTRS
  [{:db/ident :e/from :db/valueType :db.type/long}
   {:db/ident :e/to :db/valueType :db.type/long}
   {:db/ident :e/w :db/valueType :db.type/long}])

(def REACH
  '[[(reachable ?a ?b) [?e :e/from ?a] [?e :e/to ?b]]
    [(reachable ?a ?b) [?e :e/from ?a] [?e :e/to ?x] (reachable ?x ?b)]])

(defn- chain-edges [n]
  (mapv (fn [i] {:e/from i :e/to (+ i 1)}) (range 1 n)))

;; ── 1. transitive closure = n(n-1)/2 pairs ──────────────────────────

(deftest transitive-closure-matches-closed-form
  (let [n 8
        db (edge-db (chain-edges n) EDGE-ATTRS)
        result (get (fp/materialise db REACH eval-plain) 'reachable)
        expected (set (reduce (fn [acc i]
                                (into acc (mapv (fn [j] [i j]) (range (+ i 1) (+ n 1)))))
                              []
                              (range 1 (+ n 1))))]
    ;; chain 1..n: reachable = all (i,j), 1<=i<j<=n  =>  n(n-1)/2 pairs
    (is (= (erlang/div (* n (- n 1)) 2) (count result))
        "chain of n has n(n-1)/2 reachable pairs")
    (is (= expected (set (into [] result)))
        "every (i,j) with i<j is present, and only those")))

;; ── 2. reachable-from-1 = exactly n-1 pairs ─────────────────────────

(deftest reachable-from-source-is-the-suffix
  (let [n 6
        db (edge-db (chain-edges n) EDGE-ATTRS)
        result (get (fp/materialise db REACH eval-plain) 'reachable)
        from-1 (set (filterv (fn [t] (= (get t 0) 1)) (into [] result)))]
    (is (= (set (mapv (fn [j] [1 j]) (range 2 (+ n 1))))
           (set (mapv (fn [t] t) (filterv (fn [t] (= (get t 0) 1)) (into [] result)))))
        "node 1 reaches exactly 2..n")))

;; ── 3. cycle terminates; closure = all ordered pairs ────────────────

(deftest cycle-terminates-with-full-closure
  ;; 1->2->3->1 : every node reaches every node (including itself)
  (let [db (edge-db [{:e/from 1 :e/to 2} {:e/from 2 :e/to 3} {:e/from 3 :e/to 1}] EDGE-ATTRS)
        result (get (fp/materialise db REACH eval-plain) 'reachable)]
    (is (= 9 (count result)) "3-cycle: 3x3 = 9 ordered pairs, and it TERMINATES")
    (is (contains? (set (into [] result)) [1 1]) "self-reachability via the cycle")))

;; ── 4. shortest path = Dijkstra answer ──────────────────────────────

(deftest shortest-path-matches-dijkstra
  ;; 1->2 (1), 2->3 (2), 1->3 (10), 3->4 (1). Shortest from 1: 2:1 3:3 4:4.
  (let [db (edge-db [{:e/from 1 :e/to 2 :e/w 1} {:e/from 2 :e/to 3 :e/w 2}
                     {:e/from 1 :e/to 3 :e/w 10} {:e/from 3 :e/to 4 :e/w 1}]
                    EDGE-ATTRS)
        rules '[[(path ?y ?d) [?e :e/from 1] [?e :e/to ?y] [?e :e/w ?d]]
                [(path ?y ?d) (path ?x ?dx) [?e :e/from ?x] [?e :e/to ?y] [?e :e/w ?w]
                 [(+ ?dx ?w) ?d]]]
        paths (get (fp/materialise db rules eval-plain) 'path)
        best (reduce (fn [m t]
                       (let [y (get t 0) d (get t 1)]
                         (if (or (nil? (get m y)) (< d (get m y))) (assoc m y d) m)))
                     {} (into [] paths))]
    (is (= 1 (get best 2)))
    (is (= 3 (get best 3)) "1->2->3 (cost 3) beats direct 1->3 (cost 10)")
    (is (= 4 (get best 4)))))

;; ── 5. same-generation (non-linear) ─────────────────────────────────

(deftest same-generation-non-linear
  ;; gp -> {a,b}; a -> {c,d}; b -> {e}. c,d,e are all generation-2 (cousins).
  (let [db (edge-db [{:e/from 100 :e/to 1} {:e/from 100 :e/to 2}   ; gp(100) -> a(1),b(2)
                     {:e/from 1 :e/to 10} {:e/from 1 :e/to 11}      ; a -> c(10),d(11)
                     {:e/from 2 :e/to 12}]                          ; b -> e(12)
                    EDGE-ATTRS)
        ;; sg(x,y): siblings share a parent (base), or their parents are
        ;; same-generation (recursive). parent(p,c) = edge from=p to=c.

        sgrules '[[(sg ?x ?y) [?e1 :e/from ?p] [?e1 :e/to ?x] [?e2 :e/from ?p] [?e2 :e/to ?y]]
                  [(sg ?x ?y) [?e1 :e/to ?x] [?e1 :e/from ?px]
                              [?e2 :e/to ?y] [?e2 :e/from ?py] (sg ?px ?py)]]
        result (get (fp/materialise db sgrules eval-plain) 'sg)
        rset (set (into [] result))]
    ;; c(10) and e(12) are same-generation (both grandchildren of gp)
    (is (contains? rset [10 12]) "cousin c~e via the recursive case")
    (is (contains? rset [10 11]) "siblings c~d via the base case")))

;; ── 5b. FULL SPEC: non-integer values recurse natively (interning) ───
;; The native kernel joins i64 tuples; the driver interns arbitrary values to
;; ids and decodes back. A keyword-labelled graph must produce the SAME
;; closure as integer ids would, with keywords restored on the way out.

(def KW-ATTRS
  [{:db/ident :k/from :db/valueType :db.type/keyword}
   {:db/ident :k/to :db/valueType :db.type/keyword}])

(def KREACH
  '[[(kreach ?a ?b) [?e :k/from ?a] [?e :k/to ?b]]
    [(kreach ?a ?b) [?e :k/from ?a] [?e :k/to ?x] (kreach ?x ?b)]])

(deftest non-integer-values-recurse-via-interning
  ;; a->b->c->d : keyword chain, closure = all (i,j) with i before j
  (let [db (edge-db [{:k/from :a :k/to :b} {:k/from :b :k/to :c} {:k/from :c :k/to :d}]
                    KW-ATTRS)
        result (get (fp/materialise db KREACH eval-plain) 'kreach)
        rset (set (into [] result))]
    (is (= 6 (count result)) "keyword chain of 4 has 4*3/2 = 6 reachable pairs")
    (is (contains? rset [:a :d]) "transitive keyword pair a~>d, decoded to keywords")
    (is (contains? rset [:b :c]) "direct keyword pair, decoded to keywords")
    (is (not (contains? rset [:d :a])) "the chain is acyclic: no d~>a")))

(deftest interned-native-equals-bl-fallback
  ;; the native path (interning) and the bl fallback must agree bit-for-bit
  ;; on a non-integer program — same spec, two disjoint mechanisms.
  (let [db (edge-db [{:k/from :a :k/to :b} {:k/from :b :k/to :c}
                     {:k/from :c :k/to :a}]                          ; a cycle
                    KW-ATTRS)
        nv (get (fp/materialise db KREACH eval-plain) 'kreach)
        bl (get (blr/derive-semi-naive db KREACH eval-plain) 0)]
    (is (= nv (get bl 'kreach))
        "native (interned) closure = bl-fallback closure, keywords and all")))

;; ── 6. the BOUNDARY: compatible? classifies correctly ────────

(deftest boundary-classification
  ;; pure relational + arithmetic → native-compatible
  (is (fp/compatible?
        '[[(reachable ?a ?b) [?e :e/from ?a] [?e :e/to ?b]]
          [(reachable ?a ?b) [?e :e/from ?a] [?e :e/to ?x] (reachable ?x ?b)]]))
  (is (fp/compatible?
        '[[(path ?y ?d) [?e :e/from 1] [?e :e/to ?y] [?e :e/w ?d]]
          [(path ?y ?d) (path ?x ?dx) [?e :e/from ?x] [?e :e/to ?y] [?e :e/w ?w]
           [(+ ?dx ?w) ?d]]]))
  ;; a pattern consuming a recursive var is STILL native (it becomes a base
  ;; relation the kernel joins against) — the join is the kernel's job.
  (is (fp/compatible?
        '[[(anc ?a ?b) [?e :e/from ?a] [?e :e/to ?b]]
          [(anc ?a ?b) (anc ?a ?x) [?e :e/from ?x] [?e :e/to ?b]]])
      "a pattern joining on a recursive variable stays native")
  ;; an arbitrary bl PREDICATE (not +/-/</etc) must fall back to the all-bl
  ;; fixpoint — it is not independently evaluable into a base relation.
  (is (not (fp/compatible?
             '[[(bad ?a ?b) (bad ?a ?x) [(similar-to ?x ?b)]]]))
      "a generator predicate consuming a recursive variable falls back to bl")
  ;; REGRESSION: a FILTER predicate `[(even? ?b)]` is NOT native even though
  ;; ?b is pattern-bound (not recursive). A filter needs the in-body join
  ;; bindings, so it cannot be pre-baked into a base relation — the earlier
  ;; 'only-if-recursive-var' rule wrongly called it native and the kernel
  ;; errored. It must fall to bl.
  (is (not (fp/compatible?
             '[[(reach ?a ?b) [?e :e/from ?a] [?e :e/to ?b] [(even? ?b)]]]))
      "a filter predicate on a non-recursive var STILL falls back to bl")
  ;; but a native COMPARISON guard `[(> ?b 3)]` stays native (kernel handles it)
  (is (fp/compatible?
        '[[(reach ?a ?b) [?e :e/from ?a] [?e :e/to ?b] [(> ?b 3)]]])
      "a native comparison guard stays native"))

(deftest filter-predicate-falls-back-and-is-correct
  ;; end-to-end: a rule with a non-native filter runs on bl via materialise
  ;; and yields the filtered relation (regression for the boundary bug).
  (let [db (edge-db (chain-edges 6) EDGE-ATTRS)
        rules '[[(reach ?a ?b) [?e :e/from ?a] [?e :e/to ?b] [(even? ?b)]]]
        r (get (blr/materialise db rules eval-plain) 'reach)]
    (is (= #{[1 2] [3 4] [5 6]} (set (into [] r)))
        "even?-filtered edges, via the bl fallback the dispatcher selects")))

(deftest float-in-arithmetic-falls-back-gracefully
  ;; A shortest-path program is STRUCTURALLY native, but float weights are
  ;; beyond the i64 kernel. The driver raises a TAGGED fallback signal;
  ;; `materialise` catches exactly it and re-runs on bl — the program is valid
  ;; and must produce the right answer, not crash. (Regression: previously
  ;; the kernel raised a raw 'argument error'.)
  (let [attrs [{:db/ident :e/from :db/valueType :db.type/long}
               {:db/ident :e/to :db/valueType :db.type/long}
               {:db/ident :e/w :db/valueType :db.type/term}]   ; term holds a float
        conn (datom/connect attrs)
        _tx (datom/transact! conn
              [{:db/id -1 :e/from 1 :e/to 2 :e/w 1.5}
               {:db/id -2 :e/from 2 :e/to 3 :e/w 2.5}
               {:db/id -3 :e/from 1 :e/to 3 :e/w 10.0}])
        db (datom/db conn)
        rules '[[(path ?y ?d) [?e :e/from 1] [?e :e/to ?y] [?e :e/w ?d]]
                [(path ?y ?d) (path ?x ?dx) [?e :e/from ?x] [?e :e/to ?y] [?e :e/w ?w]
                 [(+ ?dx ?w) ?d]]]
        paths (get (blr/materialise db rules eval-plain) 'path)
        best (reduce (fn [m t]
                       (let [y (get t 0) d (get t 1)]
                         (if (or (nil? (get m y)) (< d (get m y))) (assoc m y d) m)))
                     {} (into [] paths))]
    (is (= 1.5 (get best 2)))
    (is (= 4.0 (get best 3)) "1->2->3 float cost 4.0 beats direct 10.0, via bl fallback")))
