; test/bl/datom/recur_collision_test.bl — the questions a set can be asked.
; Run: bl test test/bl/datom/recur_collision_test.bl
;
; These are R4: `collides?` and `fits?`, decided exactly over a bounded window by
; enumerating both rules and intersecting the sets. The tests are chosen for what
; they would catch if the model were wrong — the difference between INTERVAL
; overlap and instant equality, and the difference between a bounded proof and an
; unbounded promise.

; The refer list is the DSL's visibility, as in the conformance corpus: the words
; are what make a rule read as the sentence.
(ns datom.recur.collision.test
  (:require [datom.recur :as recur
             :refer [rule on at in day every times until starting lasting]]
            [datom.time :as time]))

(def ^:private T0 1767225600)          ; 2026-01-01T00:00:00Z
(def ^:private WEEK (* 7 86400))

(defn- span [from to]
  ; Two instants, one interval. NOT `interval`: that constructor takes COMPONENTS
  ; (`(interval :year 2026 :month 6)`), and passing it numbers silently produced a
  ; year-0 interval — which made this whole file's windows look like the year 0 and
  ; every `fits?` answer false. The engine builds its occurrences with `->Interval`
  ; for the same reason.
  (time/->Interval from to :second :gregorian))

(defn- hhmm [secs]
  ; Just the clock part, so a witness can be read as a time of day.
  (let [s (mod secs 86400)]
    [(quot s 3600) (mod (quot s 60) 60)]))

;; ── overlap is INTERVAL overlap, not equal starts ──────────────────

(deftest two-runs-that-touch-do-not-collide
  ; [02:00, 03:00) and [03:00, 04:00) share no instant. This is the test that
  ; fails if anyone ever rewrites `collides?` as a comparison of START times —
  ; which is what a recurrence engine built on instants would do, and why this
  ; one is built on intervals.
  (let [a (rule :day (at 2 0) (lasting 3600) (starting T0))
        b (rule :day (at 3 0) (lasting 3600) (starting T0))]
    (is (nil? (recur/collides? a b T0 (+ T0 WEEK))))))

(deftest a-long-run-overlaps-a-short-one-and-says-where
  ; Two hours at 02:00 and one hour at 03:00 overlap for exactly [03:00, 04:00).
  ; The answer is a SPAN — a witness to go and look at — not a yes.
  (let [backup (rule :day (at 2 0) (lasting 7200) (starting T0))
        report (rule :day (at 3 0) (lasting 3600) (starting T0))
        w (recur/collides? backup report T0 (+ T0 WEEK))]
    (is (some? w) "they DO overlap")
    (is (= [3 0] (hhmm (time/from w))) "…from 03:00")
    (is (= 3600 (time/width w)) "…for the hour the short one runs")))

(deftest rules-on-different-tracks-never-meet
  ; The last Friday and the last Tuesday of a month are never the same day, so
  ; the answer is nil over a year — and that nil is a proof, not a sample.
  (let [fri (rule :month (on :friday :last) (at 6 0) (lasting 60))
        tue (rule :month (on :tuesday :last) (at 6 0) (lasting 60))]
    (is (nil? (recur/collides? fri tue T0 (+ T0 (* 400 86400)))))))

(deftest the-same-rule-collides-with-itself
  ; Sanity on the machinery, and the shape of a self-collision: every occurrence
  ; overlaps itself, so the first witness is the FIRST occurrence in the window.
  (let [r (rule :day (at 6 0) (lasting 1800) (starting T0))
        w (recur/collides? r r T0 (+ T0 WEEK))]
    (is (some? w))
    (is (= [6 0] (hhmm (time/from w))))))

;; ── the window is part of the answer, and it says so ───────────────

(deftest the-window-bounds-the-answer
  ; `collides?` answers about a WINDOW, and this is what that means: the same two
  ; rules that overlap every night answer nil for a window that ends before either
  ; fires, and produce a witness for a window that reaches them. The boundedness is
  ; the caller's, and it is stated rather than implied.
  (let [a (rule :day (at 2 0) (lasting 3600) (starting T0))
        b (rule :day (at 2 30) (lasting 3600) (starting T0))]
    (is (nil? (recur/collides? a b T0 (+ T0 60))) "a minute of window sees nothing")
    (is (some? (recur/collides? a b T0 (+ T0 WEEK))) "…and a week sees the witness")))

;; ── does every run fit inside the window I am allowed? ─────────────

(deftest every-occurrence-must-fit-not-some
  ; The maintenance-window question, with the window RECURRING — which is the case
  ; that matters and the reason `fits?` takes a set: a job that must land inside
  ; three hours every night is a job in a window that is itself a rule.
  (let [job (rule :day (at 4 0) (lasting 1800) (starting T0))
        too-early (rule :day (at 2 0) (lasting 1800) (starting T0))
        ; every night, 03:00 for two hours
        window (recur/occurrences-set (rule :day (at 3 0) (lasting 7200) (starting T0))
                                      T0 (+ T0 WEEK))]
    (is (= true (recur/fits? window job T0 (+ T0 WEEK))))
    (is (= false (recur/fits? window too-early T0 (+ T0 WEEK))))))

(deftest a-single-interval-window-works-too
  ; The single-window form is the same question asked once — a migration that must
  ; happen inside one quiet afternoon.
  (let [afternoon (span (+ T0 (* 15 3600)) (+ T0 (* 17 3600)))
        job (rule :day (at 16 0) (lasting 1800) (starting T0))]
    (is (= true (recur/fits? afternoon job T0 (+ T0 86400))))))

(deftest a-run-straddling-the-window-edge-does-not-fit
  ; Half a run is not a run inside the window. This is the case a careless
  ; implementation (does the START fit?) gets wrong, and it is why `fits?` is a
  ; set difference rather than a comparison of starts.
  (let [window (span (+ T0 (* 3 3600) 1800) (+ T0 (* 4 3600) 1800))
        straddles (rule :day (at 4 0) (lasting 3600) (starting T0))]
    (is (= false (recur/fits? window straddles T0 (+ T0 86400))))))

(deftest the-answer-is-deterministic-and-composeable
  ; Same rules, same window, same answer — twice — and the rule's own result is a
  ; real set, which is what lets any other set operation apply to it.
  (let [a (rule :day (at 6 0) (lasting 900) (starting T0))
        b (rule :day (at 6 10) (lasting 900) (starting T0))
        s (recur/occurrences-set a T0 (+ T0 WEEK))]
    (is (= 7 (time/set-count s)) "a week of daily runs is seven spans")
    (is (= (* 7 900) (time/set-measure s)) "…totalling their widths, not the week")
    (is (= (recur/collides? a b T0 (+ T0 WEEK)) (recur/collides? a b T0 (+ T0 WEEK))))
    (is (some? (recur/collides? a b T0 (+ T0 WEEK))) "06:00-06:15 and 06:10-06:25 overlap")))
