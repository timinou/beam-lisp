; test/bl/datom/store_test.bl — the Store CONFORMANCE suite.
; Run: mix beam_lisp.test test/bl/datom/store_test.bl
;
; ── This file is the actual protocol contract ─────────────────────────
;
; `priv/datom/store.bl` states the Store protocol in prose and
; docstrings; this suite states it executably. Every substrate must pass
; it unchanged — that is what makes the Hobbes swap (PLAN-033 wave 6) a
; wave rather than a rewrite.
;
; Consequently: NOTHING here may mention ETS. The suite takes a store
; through the protocol only, so when `store-hobbes` arrives, the same
; assertions run against it by changing one constructor. If a test needs
; substrate-specific knowledge, that knowledge belongs in the substrate's
; own test file, not here.
;
; The `open-store` indirection below is deliberately the ONLY place a
; substrate is named.

(ns datom.store.test
  (:require [datom.store] [datom.store-ets]))

(defn open-store
  "The substrate under test.

   Wave 6 adds a second binding here (and a way to select), so this suite
   runs against Hobbes and ETS both. Until then it names the development
   substrate exactly once."
  []
  (datom.store-ets/open))

;; ── point access ────────────────────────────────────────────────────────────

(deftest get-returns-the-stored-value
  (let [s (open-store)]
    (datom.store/-put s "k" 42)
    (is (= 42 (datom.store/-get s "k")))))

(deftest get-returns-nil-for-an-absent-key
  ; The protocol promises nil is unambiguous: the layers above never
  ; store nil, so absence is the only meaning nil can carry.
  (let [s (open-store)]
    (is (nil? (datom.store/-get s "never-written")))))

(deftest put-replaces-rather-than-duplicates
  (let [s (open-store)]
    (datom.store/-put s "k" 1)
    (datom.store/-put s "k" 2)
    (is (= 2 (datom.store/-get s "k")))
    (is (= 1 (datom.store/range-count s nil nil)))))

(deftest delete-removes-and-is-idempotent
  (let [s (open-store)]
    (datom.store/-put s "k" 1)
    (datom.store/-delete s "k")
    (is (nil? (datom.store/-get s "k")))
    (datom.store/-delete s "k")
    (is (nil? (datom.store/-get s "k")))))

;; ── ordered range scans: the load-bearing method ────────────────────────────

(deftest range-returns-entries-in-ascending-key-order
  (let [s (open-store)]
    (datom.store/-put s "c" 3)
    (datom.store/-put s "a" 1)
    (datom.store/-put s "b" 2)
    (is (= [["a" 1] ["b" 2] ["c" 3]] (into [] (datom.store/-range s nil nil))))))

(deftest range-bounds-are-inclusive
  (let [s (open-store)]
    (doseq [k ["a" "b" "c" "d"]] (datom.store/-put s k k))
    (is (= ["a" "b" "c"] (datom.store/range-keys s "a" "c")))))

(deftest range-nil-bounds-are-unbounded
  (let [s (open-store)]
    (doseq [k ["a" "b" "c"]] (datom.store/-put s k k))
    (is (= ["a" "b"] (datom.store/range-keys s nil "b")))
    (is (= ["b" "c"] (datom.store/range-keys s "b" nil)))
    (is (= ["a" "b" "c"] (datom.store/range-keys s nil nil)))))

(deftest range-bounds-need-not-be-present-keys
  ; This is what makes an index range predicate work: the query supplies
  ; a bound, not a key that happens to exist.
  (let [s (open-store)]
    (doseq [k ["a" "c" "e"]] (datom.store/-put s k k))
    (is (= ["c"] (datom.store/range-keys s "b" "d")))))

(deftest range-of-an-empty-store-is-empty
  ; Regression: the ETS cursor returns an exhaustion sentinel for an
  ; empty table, which crashed when handed straight to the next step.
  ; Any cursor-based substrate has an equivalent edge.
  (let [s (open-store)]
    (is (= [] (into [] (datom.store/-range s nil nil))))
    (is (= [] (into [] (datom.store/-range s "a" "z"))))))

(deftest range-past-the-last-key-is-empty
  (let [s (open-store)]
    (datom.store/-put s "a" 1)
    (is (= [] (into [] (datom.store/-range s "z" nil))))))

(deftest range-with-inverted-bounds-is-empty
  (let [s (open-store)]
    (doseq [k ["a" "b" "c"]] (datom.store/-put s k k))
    (is (= [] (into [] (datom.store/-range s "c" "a"))))))

;; ── tuple keys: the shape indexes actually use ──────────────────────────────

(deftest range-scans-tuple-keys-element-wise
  ; Index keys are tuples — {index, e, a, v, tx}. A prefix scan works
  ; only if the substrate orders tuples element-wise, so this is the
  ; single most load-bearing ordering property for the layers above.
  (let [s (open-store)]
    (doseq [k [[:eavt 2 :name] [:eavt 1 :age] [:eavt 1 :name] [:aevt 1 :age]]]
      (datom.store/-put s k :marker))
    (is (= [[:aevt 1 :age] [:eavt 1 :age] [:eavt 1 :name] [:eavt 2 :name]]
           (datom.store/range-keys s nil nil)))))

; NOTE (BUG-005): the prefix-scan test that BELONGS here is deliberately
; absent until wave 2 lands the key codec.
;
; The obvious spelling — bound a scan with `[:eavt] .. [:eavt 999]` and
; expect only :eavt keys — FAILS, because Erlang orders tuples by ARITY
; first: the 1-element bound `[:eavt]` sorts before every 3-element key,
; including `[:aevt …]`. beam-lisp vectors are structs wrapping tuples, so
; they are compared as maps and fare no better.
;
; The scan therefore returns a SUPERSET. Results stay correct (the query
; layer filters) while performance silently degrades to a full scan — the
; exact failure no result-level test would catch.
;
; Writing a weakened assertion here would encode the broken behaviour as
; the contract. Instead the requirement lives in BUG-005 and returns as a
; real test once index keys are an order-preserving flat encoding.

; Pins the CURRENT, known-wrong behaviour so wave 2 must consciously change
; it — and so nobody builds an index on tuple keys believing prefix bounds
; work. (A docstring would read better here; deftest does not take one yet
; — FEAT-003.)
(deftest raw-tuple-keys-do-not-support-prefix-bounds
  (let [s (open-store)]
    (doseq [k [[:aevt 1 :age] [:eavt 1 :age] [:eavt 2 :name]]]
      (datom.store/-put s k :marker))
    ; A prefix bound leaks a neighbouring partition: :aevt appears in an
    ; :eavt-bounded scan. This assertion documents the trap.
    (is (contains? (set (datom.store/range-keys s [:eavt] [:eavt 999]))
                   [:aevt 1 :age])
        "tuple/vector keys sort by arity, so prefix bounds do not bracket")))

;; ── batch commit ────────────────────────────────────────────────────────────

(deftest commit-applies-puts-and-deletes
  (let [s (open-store)]
    (datom.store/-put s "old" 1)
    (datom.store/-commit s [[:put "x" 10] [:put "y" 20] [:delete "old"]])
    (is (= 10 (datom.store/-get s "x")))
    (is (= 20 (datom.store/-get s "y")))
    (is (nil? (datom.store/-get s "old")))))

(deftest commit-of-an-empty-batch-is-a-no-op
  (let [s (open-store)]
    (datom.store/-put s "k" 1)
    (datom.store/-commit s [])
    (is (= 1 (datom.store/-get s "k")))))

(deftest commit-writes-are-visible-to-range
  ; A transaction that writes several index entries for one datom must
  ; leave all of them findable by scan, not merely by point lookup.
  (let [s (open-store)]
    (datom.store/-commit s [[:put [:eavt 1 :name] "Ada"]
                            [:put [:aevt :name 1] "Ada"]])
    (is (= 2 (datom.store/range-count s nil nil)))))

(deftest put-all-is-commit-in-disguise
  (let [s (open-store)]
    (datom.store/put-all s [["a" 1] ["b" 2]])
    (is (= ["a" "b"] (datom.store/range-keys s nil nil)))))

;; ── values are opaque to the substrate ──────────────────────────────────────

(deftest values-of-any-shape-round-trip
  ; The substrate stores terms, never interprets them. If a value shape
  ; is mangled, the datom layer above corrupts silently.
  (let [s (open-store)]
    (datom.store/-put s "vec" [1 2 3])
    (datom.store/-put s "map" {:a 1})
    (datom.store/-put s "kw" :keyword)
    (datom.store/-put s "str" "text")
    (datom.store/-put s "num" 42)
    (is (= [1 2 3] (datom.store/-get s "vec")))
    (is (= {:a 1} (datom.store/-get s "map")))
    (is (= :keyword (datom.store/-get s "kw")))
    (is (= "text" (datom.store/-get s "str")))
    (is (= 42 (datom.store/-get s "num")))))

(deftest stores-are-independent
  ; Two stores must not share state — the suite itself depends on this
  ; for isolation between tests.
  (let [a (open-store)
        b (open-store)]
    (datom.store/-put a "k" :from-a)
    (is (nil? (datom.store/-get b "k")))))
