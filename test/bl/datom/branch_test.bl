; test/bl/datom/branch_test.bl — named copy-on-write branches (PLAN-115 B6/W5).
; Run: bl test test/bl/datom/branch_test.bl
;
; A BRANCH is a long-lived, named copy-on-write overlay over a store: a
; speculative what-if database that sees the base's data plus its own writes,
; while the base — the shared template — is never touched. It is what makes
; per-test isolation off one seeded database O(1): branch a fresh book per test
; instead of re-seeding. datahike's `branch!` projects onto this; kontor uses it
; for exactly that (create-test-db). Branches are never merged back.

(ns datom.branch.test
  (:require [datom.conn] [datom.query.engine]))

(def schema
  [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}])

(defn- names [c]
  (set (datom.query.engine/q '[:find ?n :where [?e :name ?n]] (datom.conn/db c))))

(deftest a-branch-sees-the-base-plus-its-own-writes
  (let [c (datom.conn/connect schema)]
    (datom.conn/transact! c [{:db/id -1 :name "seed"}])
    (datom.conn/branch! c :br-1)
    (let [bc (datom.conn/connect-branch :br-1 schema)]
      (is (= #{["seed"]} (names bc)) "the branch starts with the base's data")
      (datom.conn/transact! bc [{:db/id -2 :name "branch-only"}])
      (is (= #{["seed"] ["branch-only"]} (names bc)) "the branch sees its own write")
      (is (= #{["seed"]} (names c)) "the base is untouched by the branch's write"))))

(deftest two-branches-are-isolated-from-each-other
  (let [c (datom.conn/connect schema)]
    (datom.conn/transact! c [{:db/id -1 :name "seed"}])
    (datom.conn/branch! c :iso-a)
    (datom.conn/branch! c :iso-b)
    (let [a (datom.conn/connect-branch :iso-a schema)
          b (datom.conn/connect-branch :iso-b schema)]
      (datom.conn/transact! a [{:db/id -2 :name "in-a"}])
      (datom.conn/transact! b [{:db/id -3 :name "in-b"}])
      (is (= #{["seed"] ["in-a"]} (names a)) "branch a has only its own change")
      (is (= #{["seed"] ["in-b"]} (names b)) "branch b has only its own change")
      (is (= #{["seed"]} (names c)) "the base has neither"))))

(deftest connecting-an-unknown-branch-fails-loudly
  (is (= true
         (try (datom.conn/connect-branch :never-created schema) false
              (catch e true)))
      "connecting a branch that was never created is an error, not a silent empty db"))
