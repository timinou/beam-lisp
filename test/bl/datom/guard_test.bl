; test/bl/datom/guard_test.bl — writer-run transaction guards (PLAN-115 B3).
; Run: bl test test/bl/datom/guard_test.bl
;
; A guard is a predicate over the fully-resolved report, run in the writer
; AFTER a transaction realizes and BEFORE it commits. A non-nil result aborts
; the commit and nothing is written. This is the seam datahike's
; `register-tx-pred!` projects onto, and the mechanism kontor's whole
; integrity story ("every committed write is validated in the writer") needs.
; The properties a guard must have:
;   1. it SEES the resolved report (:db-after, :tx-datoms), not raw tx-data,
;   2. a refusal leaves the store BYTE-for-byte as it was (atomic abort), and
;   3. a passing transaction is untouched by the guard's presence.

(ns datom.guard.test
  (:require [datom.conn] [datom.db] [datom.index] [datom.query.engine]))

(defn- fresh []
  (datom.conn/connect
    [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
     {:db/ident :amt  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}]))

(defn- names [c]
  (set (datom.query.engine/q '[:find ?n :where [?e :name ?n]] (datom.conn/db c))))

(deftest a-guard-refuses-a-transaction-and-leaves-no-trace
  (let [c (fresh)]
    (datom.conn/guard! c :no-negative
      (fn [report]
        (if (empty? (filter (fn [d] (and (= :amt (datom.index/-a d))
                                         (< (datom.index/-v d) 0)))
                            (:tx-datoms report)))
          nil {:negative true})))
    (datom.conn/transact! c [{:db/id -1 :name "ok" :amt 5}])
    (is (= #{["ok"]} (names c)) "a passing transaction commits normally")
    (let [refused (try (datom.conn/transact! c [{:db/id -2 :name "bad" :amt -3}])
                       false
                       (catch e true))]
      (is (= true refused) "a guard's non-nil result aborts the commit")
      (is (= #{["ok"]} (names c))
          "the refused transaction left the store exactly as it was"))))

(deftest a-guard-sees-the-speculative-db-after
  (let [c (fresh)
        seen (atom nil)]
    ; the guard reads :db-after — the database AS IF committed — and can query it
    (datom.conn/guard! c :count-cap
      (fn [report]
        (let [n (count (datom.query.engine/q '[:find ?e :where [?e :name _]]
                                             (:db-after report)))]
          (reset! seen n)
          (if (> n 2) {:too-many n} nil))))
    (datom.conn/transact! c [{:db/id -1 :name "a"} {:db/id -2 :name "b"}])
    (is (= 2 (deref seen)) "the guard queried the speculative db-after (2 entities)")
    (let [refused (try (datom.conn/transact! c [{:db/id -3 :name "c"}]) false (catch e true))]
      (is (= true refused) "a third entity trips the cap of 2")
      (is (= 3 (deref seen)) "the guard saw db-after WOULD hold 3 before refusing"))))

(deftest unguard-removes-the-predicate
  (let [c (fresh)]
    (datom.conn/guard! c :block-all (fn [_] {:blocked true}))
    (is (= true (try (datom.conn/transact! c [{:db/id -1 :name "x"}]) false (catch e true)))
        "while guarded, every transaction is refused")
    (datom.conn/unguard! c :block-all)
    (datom.conn/transact! c [{:db/id -1 :name "x"}])
    (is (= #{["x"]} (names c)) "after unguard, transactions commit again")))
