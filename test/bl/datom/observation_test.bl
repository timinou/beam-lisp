(ns datom.observation-test (:require [datom :as d] [datom.conn :as conn]))
(defn refused [f] (try (f) nil (catch e (:kind (ex-data e)))))
(deftest observations-refuse-writes-before-admission-and-preserve-live-owner
 (let [c (d/connect [{:db/ident :record/name :db/valueType :db.type/string}])]
  (try
   (d/transact! c [{:db/id -1 :record/name "before"}])
   (let [basis (d/basis-t (d/db c))]
    (conn/observing
     (fn []
      (is (= 1 (count (d/q '[:find ?e :where [?e :record/name _]] (d/db c)))))
      (is (= :read-only-observation (refused #(d/transact! c [{:db/id -2 :record/name "bad"}]))))
      (is (= :read-only-observation (refused #(d/install-schema! c [{:db/ident :record/extra}]))))
      (is (= :read-only-observation (refused #(conn/serialized! c (fn [] :bad)))))
      (is (= :read-only-observation (refused #(d/close! c))))
      (conn/observing (fn [] (is (= :read-only-observation
                         (refused #(d/transact! c [{:db/id -2 :record/name "nested"}]))))))))
    (is (= basis (d/basis-t (d/db c))))
    (is (d/alive? c)))
   (is (= :sentinel (refused #(conn/observing (fn [] (throw (ex-info "test" {:kind :sentinel})))))))
   (d/transact! c [{:db/id -2 :record/name "after"}])
   (is (= 2 (count (d/q '[:find ?e :where [?e :record/name _]] (d/db c)))))
   (finally (d/close! c)))))
