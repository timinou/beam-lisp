; test/bl/datom/store_ets_test.bl — the DEVELOPMENT substrate's own semantics.
; Run: bl test test/bl/datom/store_ets_test.bl
;
; ── Why this file exists, and why not in store_test.bl ────────────────
;
; `store_test.bl` is the PORT's contract and says so in its own header:
; nothing in it may mention ETS, because the same assertions must run
; against the next substrate. `conformance_test.bl` goes further and runs
; them twice.
;
; Lifetime is the one thing that must NOT be shared that way, because the
; two substrates answer it differently by design: an ETS table is OWNED by
; the process that opened it and dies with that process, while a sorted map
; in an atom has no owner to outlive. So the substrate whose handles can
; die is the substrate that gets tested for it, here.
;
; This is not an edge case. The daemon runs commands in one long-lived
; worker while memoized state — the mounted codebase conn — is held in a
; VM-global atom that is older than any worker. When the worker was
; restarted, the memo pointed at a table that no longer existed, and every
; request that touched it died inside `:ets.lookup` with "the table
; identifier does not refer to an existing ETS table" — a message that
; reads like a corrupt database rather than a memo outliving its owner.
; `datom.store/alive?` is what lets a holder ask before it uses one.

(ns datom.store.test.ets
  (:require [datom] [datom.store] [datom.store-ets]))

(defn- until
  "Poll `pred` every 10 ms for up to 5 s. Waits for a process to die without
   assuming how long that takes — a sleep long enough to be reliable is a
   sleep that makes the suite slow, and a short one makes it flaky."
  [pred]
  (loop [n 0]
    (cond
      (pred) true
      (> n 500) false
      :else (do (Process/sleep 10) (recur (inc n))))))

(defn- store-owned-by-a-process-that-then-exits
  "Open a store in a process, hand it out, and let the process exit."
  [out]
  (let [p (erlang/spawn (fn []
                          (reset! out (datom.store-ets/open))
                          (Process/sleep 30000)))]
    (is (until (fn [] (some? @out))) "the owner opened it")
    p))

(deftest a-live-store-is-alive
  (let [s (datom.store-ets/open)]
    (is (datom.store/alive? s))))

(deftest a-closed-store-is-dead
  (let [s (datom.store-ets/open)]
    (datom.store-ets/close s)
    (is (not (datom.store/alive? s)))))

(deftest a-store-dies-with-the-process-that-opened-it
  ; The whole point: the handle survives the owner, the thing it names does
  ; not, and nothing in the handle says so.
  (let [store (atom nil)
        p (store-owned-by-a-process-that-then-exits store)]
    (is (datom.store/alive? @store) "alive while its owner lives")
    (Process/exit p :kill)
    (is (until (fn [] (not (Process/alive? p)))) "the owner is gone")
    (is (not (datom.store/alive? @store)) "and so is what it names")))

(deftest a-dead-store-fails-loudly-on-use
  ; Why the holder must ask BEFORE use rather than rescue after: every method
  ; that touches the table raises once it is gone — `-get` and a range scan
  ; alike, since `:ets.lookup` and `:ets.first` are equally unhappy about a
  ; table that does not exist. The objection is the MESSAGE: it names ETS
  ; internals ("the table identifier does not refer to an existing ETS
  ; table") rather than the memo that outlived its owner, which is why the
  ; daemon's failure read as a corrupt database.
  ;
  ; (Measured, not assumed: the first draft of this test asserted that a range
  ; scan comes back EMPTY on a dead table. It does not.)
  (let [store (atom nil)
        p (store-owned-by-a-process-that-then-exits store)]
    (datom.store/-put @store "k" 1)
    (is (= 1 (datom.store/-get @store "k")))
    (Process/exit p :kill)
    (is (until (fn [] (not (Process/alive? p)))) "the owner is gone")
    (is (= :raised
           (try (datom.store/-get @store "k") :ok (catch _e :raised)))
        "a keyed read raises")
    (is (= :raised
           (try (datom.store/range-keys @store nil nil) :ok
                (catch _e :raised)))
        "and so does a range scan — nothing is safe to call")))

(deftest a-connection-is-alive-while-its-substrate-is
  (let [c (datom/connect)]
    (is (datom/alive? c))
    (datom/close! c)
    (is (not (datom/alive? c)))))

(deftest a-resource-that-cannot-die-by-itself-is-alive
  ; The protocol is OPTIONAL (like `Closeable` and `Scan`): a substrate with
  ; no owner to lose simply does not implement it, and the honest answer for
  ; a handle like that is `true` rather than an error.
  (is (datom.store/alive? "a store this substrate knows nothing about")))
