(ns datom.blob-import-test
  (:require [datom] [datom.blob-fs :as fs] [datom.file]))
(defn check [label value] (assert value label) (println (str "✓ " label)))
(let [dir (str (System/tmp_dir!) "/blob-import-" (erlang/unique_integer) "-" (Base/encode16 (crypto/strong_rand_bytes 8)))
      _ (File/mkdir_p! dir)
      input (str dir "/input.bin")
      bytes (str "Multilingual original: été العربية\n" (String/duplicate "x" 200000))
      _ (File/write! input bytes)
      conn (datom/connect [] {:blobs (fs/open (str dir "/blobs"))})]
  (try
    (let [f (datom/put-file-path! conn input {:media-type "application/octet-stream"})]
      (check "streamed import hashes the same bytes as binary import" (= (datom.file/sha256 bytes) (:sha f)))
      (check "streamed import returns an at-rest descriptor" (and (datom.file/file? f) (not (datom.file/staged? f))))
      (check "streamed import retains size and MIME" (and (= (erlang/byte_size bytes) (:size f)) (= "application/octet-stream" (:media-type f))))
      (check "readback is exact" (= bytes (datom/file-bytes (datom/db conn) f)))
      (check "retry is idempotent" (= f (datom/put-file-path! conn input {:media-type "application/octet-stream"})))
      (check "stream returns bounded chunks" (every? (fn [b] (<= (erlang/byte_size b) 65536)) (datom/file-stream (datom/db conn) f)))
      (let [before (count (File/ls! "/proc/self/fd"))]
        (doseq [i (range 100)] (first (datom/file-stream (datom/db conn) f)))
        (check "stopping a lazy stream early leaks no descriptors" (<= (count (File/ls! "/proc/self/fd")) (+ before 2))))
      (check "stream yields the complete original" (= bytes (erlang/iolist_to_binary (to-list (datom/file-stream (datom/db conn) f))))))
    (let [memory (datom/connect)]
      (try
        (check "unsupported tiers refuse streaming import" (try (datom/put-file-path! memory input) false (catch _e true)))
        (finally (datom/close! memory))))
    (finally (datom/close! conn) (File/rm_rf! dir))))
