(ns datom.query-page-test
  (:require [datom] [datom.db :as db] [datom.query.page :as page]
            [datom.query.engine :as engine] [auth.rls :as rls]
            [datom.profile :as profile] [data.bounded-cache :as cache]))

(def schema [{:db/ident :p/order :db/valueType :db.type/long :db/index true}
             {:db/ident :p/name :db/valueType :db.type/string}
             {:db/ident :p/owner :db/valueType :db.type/string}])
(def query '[:find ?e ?n ?at :where [?e :p/order ?at] [?e :p/name ?n]])
(defn fixture []
  (let [c (datom/connect schema)]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :p/order (quot i 2)
                                     :p/name (str i) :p/owner (if (= 0 (mod i 7)) "alice" "bob")}) (range 80)))
    c))

(defn walk [q d direction limit budget]
  (loop [after nil rows [] rounds 0 incomplete 0]
    (when (> rounds 200) (throw (ex-info "paging failed to progress" {})))
    (let [p (page/page q d {:order-by ['?at direction] :limit limit :after after :budget budget} [])]
      (is (contains? #{:exact :incomplete} (:status p)))
      (if (:more? p)
        (recur (:after p) (into rows (:rows p)) (inc rounds)
               (+ incomplete (if (= :incomplete (:status p)) 1 0)))
        {:rows (into rows (:rows p)) :incomplete incomplete}))))

(deftest authorized-pages-match-oracle-under-sparse-rights
  (let [c (fixture) d (datom/db c)
        q (rls/guarded query [(rls/owner-filter '?e :p/owner "alice")])
        oracle (sort-by (fn [r] [(nth r 2) (nth r 0)]) (engine/q-uncached q d))]
    (doseq [direction [:asc :desc] limit [1 3 8]]
      (let [got (walk q d direction limit {:rows 4096 :seeks 4096})]
        (is (= (if (= direction :desc) (vec (reverse oracle)) (vec oracle)) (:rows got)))))))

(deftest retries-preserve-accepted-results-and-order
  (let [d (datom/db (fixture)) q (rls/guarded query [(rls/owner-filter '?e :p/owner "alice")])
        got (walk q d :desc 5 {:rows 50 :seeks 50})
        oracle (vec (reverse (sort-by (fn [r] [(nth r 2) (nth r 0)]) (engine/q-uncached q d))))]
    (is (> (:incomplete got) 0))
    (is (= oracle (:rows got)))))

(deftest cursor-provenance-and-unsupported-plans-refuse
  (let [c (fixture) d (datom/db c) opts {:order-by ['?at :desc] :limit 3}
        p (page/page query d opts []) token (:after p)]
    (is (= :exact (:status p)))
    (is (= :invalid-cursor (:reason (page/page query d (assoc opts :after "forged") []))))
    (is (= :invalid-cursor (:reason (page/page query d (assoc opts :after token :limit 4) []))))
    (datom/transact! c [{:db/id -1 :p/order 100 :p/name "new"}])
    (is (= :invalid-cursor (:reason (page/page query (datom/db c) (assoc opts :after token) []))))
    (is (= :unsupported-plan (:reason (page/page query (datom/history d) opts []))))
    (is (= :expired-authorization (:reason (page/page query d (assoc opts :authorization {:expires-at 1}) []))))))

(deftest retractions-and-order-updates-never-resurrect
  (let [c (fixture) old (datom/db c) first-id (first (first (engine/q-uncached '[:find ?e :where [?e :p/name "0"]] old)))]
    (datom/transact! c [[:db/add first-id :p/order 100] [:db/retract first-id :p/name "0"]])
    (let [d (datom/db c) got (:rows (walk query d :desc 10 {:rows 4096 :seeks 4096}))]
      (is (= 79 (count got)))
      (is (= (set got) (engine/q-uncached query d)))
      (is (= 80 (count (:rows (walk query old :desc 10 {:rows 4096 :seeks 4096}))))))))

(deftest bound-order-input-is-a-physical-index-bound
  (let [d (datom/db (fixture)) p (profile/watch (db/store-of d))
        q '[:find ?e ?n :in $ ?at :where [?e :p/order ?at]
            [?e :p/name ?n] [?e :p/owner "alice"]]
        result (page/page q (assoc d :store p) {:order-by ['?at :desc] :limit 5} [7])]
    (is (= :exact (:status result)))
    (is (= (set (:rows result)) (engine/q-uncached q d 7)))
    (is (< (:rows (profile/counters p)) 10))))

(deftest cursor-evidence-declines-replaced-query-code
  (let [d (datom/db (fixture)) opts {:order-by ['?at :desc] :limit 3}
        first-page (page/page query d opts [])]
    (is (= :exact (:status first-page)))
    (BeamLisp.Env/intern "datom.query.page" "__generation_test" :changed)
    (is (= :invalid-cursor
           (:reason (page/page query d (assoc opts :after (:after first-page)) []))))))

(deftest oversized-cursor-provenance-declines-before-serialization
  (let [d (datom/db (fixture))
        p (page/page query d {:order-by ['?at :asc] :limit 3
                              :authorization {:external (String/duplicate "x" 1048576)}} [])]
    (is (= :refused (:status p)))
    (is (= :opaque-context (:reason p)))))

(deftest cursors-retain-compact-evidence-instead-of-definition-graphs
  (cache/clear! :datom.query.cursors)
  (let [d (datom/db (fixture)) p (page/page query d {:order-by ['?at :desc] :limit 3} [])]
    (is (= :exact (:status p)))
    (is (some? (:after p)))
    (is (= 1 (:size (cache/stats :datom.query.cursors))))
    (is (< (:bytes (cache/stats :datom.query.cursors)) 5000))))
