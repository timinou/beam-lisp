; test/bl/datom/txmeta_test.bl — the transaction is an entity too.
;
; ── Why reify a transaction ───────────────────────────────────────────
;
; A transaction id is an opaque increasing integer. `as-of db 1000042`
; is answerable but not askable: nobody chose 1000042, and nobody can
; say what it means. History navigable only by counter is history nobody
; navigates.
;
; So the transaction records a fact about ITSELF — `:db/txInstant`, the
; moment it happened — as an ordinary datom on an ordinary entity. From
; there:
;
;   [?tx :db/txInstant ?t]        when did anything happen?
;   [?e :p/name ?n ?tx]           which change made this true?
;   [?tx :audit/by ?who]          and who made it?
;
; The third line is the one that matters. Because a transaction is an
; entity, a CALLER can annotate it — who, from which request, under what
; authority — and because those annotations are datoms, they are
; queryable, pullable and time-travellable like everything else. An
; audit log is not a feature here; it is what the data model already is.

(ns datom.txmeta.test
  (:require [datom.conn] [datom.db] [datom.index] [datom.pull]
            [datom.query.engine] [datom.time]))

(defn- fixture
  []
  (datom.conn/connect
    [{:db/ident :p/name :db/valueType :db.type/string}
     {:db/ident :p/age :db/valueType :db.type/long}
     {:db/ident :audit/by :db/valueType :db.type/string}
     {:db/ident :audit/reason :db/valueType :db.type/string}]))

;; ── every transaction records when it happened ──────────────────────

(deftest a-transaction-records-its-own-instant
  (let [c (fixture)
        r (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}])
        db (datom.conn/db c)]
    (is (some? (:db/txInstant (datom.db/entity db (:tx r))))
        "the transaction is an entity, and it knows when it ran")
    (is (int? (:db/txInstant (datom.db/entity db (:tx r)))))))

(deftest transaction-instants-do-not-go-backwards
  (let [c (fixture)
        r1 (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}])
        r2 (datom.conn/transact! c [{:db/id -2 :p/name "Grace"}])
        db (datom.conn/db c)]
    (is (<= (:db/txInstant (datom.db/entity db (:tx r1)))
            (:db/txInstant (datom.db/entity db (:tx r2))))
        "a later transaction never claims an earlier moment")))

(deftest the-instant-is-an-ordinary-datom
  ; Nothing special reads it. It is queryable, pullable and it lives in
  ; history like any other fact — which is the whole reason to record it
  ; as a datom rather than as a field on some transaction record.
  (let [c (fixture)
        r (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}])
        db (datom.conn/db c)]
    (is (= 1 (count (datom.query.engine/q '[:find ?tx :where [?tx :db/txInstant ?t]] db)))
        "queryable")
    (is (some? (:db/txInstant (datom.pull/pull db [:db/txInstant] (:tx r))))
        "pullable")))

(deftest every-transaction-is-listed-in-the-log
  (let [c (fixture)]
    (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}])
    (datom.conn/transact! c [{:db/id -2 :p/name "Grace"}])
    (datom.conn/transact! c [{:db/id -3 :p/name "Alan"}])
    (is (= 3 (count (datom.query.engine/q '[:find ?tx :where [?tx :db/txInstant ?t]]
                                          (datom.conn/db c))))
        "asking what happened, without knowing any transaction id")))

;; ── the caller may annotate the change ──────────────────────────────

(deftest a-caller-can-say-who-made-the-change
  ; `:db/current-tx` in an entity position means THIS transaction. It is
  ; a keyword rather than a tempid because it is not allocated: it
  ; resolves to an id the transaction already has.
  (let [c (fixture)
        r (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}
                                   {:db/id :db/current-tx :audit/by "alice"}])
        db (datom.conn/db c)]
    (is (= "alice" (:audit/by (datom.db/entity db (:tx r)))))
    (is (some? (:db/txInstant (datom.db/entity db (:tx r))))
        "annotation does not displace the instant")))

(deftest a-fact-can-be-traced-to-the-person-who-asserted-it
  ; THE query this whole design exists for. A four-term pattern binds the
  ; transaction that recorded a datom; the transaction carries who made
  ; it. Fact -> change -> author, in one query, with no audit table and
  ; no triggers.
  (let [c (fixture)
        _ (datom.conn/transact! c [{:db/id -1 :p/name "Ada" :p/age 36}
                                   {:db/id :db/current-tx :audit/by "alice"
                                    :audit/reason "initial import"}])
        db (datom.conn/db c)]
    (is (= (set [["alice"]])
           (datom.query.engine/q
             '[:find ?who
               :where [?e :p/name "Ada"]
                      [?e :p/age ?a ?tx]
                      [?tx :audit/by ?who]]
             db)))
    (is (= (set [["initial import"]])
           (datom.query.engine/q
             '[:find ?why
               :where [?e :p/name "Ada"] [?e :p/age ?a ?tx] [?tx :audit/reason ?why]]
             db)))))

(deftest two-changes-by-two-people-stay-distinguishable
  (let [c (fixture)
        r1 (datom.conn/transact! c [{:db/id -1 :p/name "Ada" :p/age 36}
                                    {:db/id :db/current-tx :audit/by "alice"}])
        e (get (:tempids r1) -1)]
    (datom.conn/transact! c [[:db/add e :p/age 37]
                             {:db/id :db/current-tx :audit/by "bob"}])
    (let [db (datom.conn/db c)]
      ; the CURRENT age was set by bob
      (is (= (set [["bob"]])
             (datom.query.engine/q
               '[:find ?who :where [?e :p/age 37 ?tx] [?tx :audit/by ?who]] db)))
      ; and history still knows alice set the original
      (is (= (set [["alice"] ["bob"]])
             (datom.query.engine/q
               '[:find ?who :where [?e :p/age ?a ?tx] [?tx :audit/by ?who]]
               (datom.time/history db)))))))

;; ── four-term patterns ──────────────────────────────────────────────

(deftest a-fourth-pattern-term-binds-the-transaction
  (let [c (fixture)
        r (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}])
        db (datom.conn/db c)]
    (is (= (set [[(:tx r)]])
           (datom.query.engine/q '[:find ?tx :where [?e :p/name "Ada" ?tx]] db)))))

(deftest a-fifth-term-is-still-rejected
  ; A datom has four addressable positions. A fifth is meaningless, and
  ; used to be silently IGNORED — the pattern matched as though the extra
  ; term had not been written.
  (let [db (datom.conn/db (fixture))]
    (is (= :rejected
           (try (do (datom.query.engine/q
                      '[:find ?e :where [?e :p/name ?n ?tx :extra]] db)
                    :accepted)
                (catch x :rejected))))))

(deftest the-transaction-of-a-fact-matches-the-report
  (let [c (fixture)
        r1 (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}])
        r2 (datom.conn/transact! c [{:db/id -2 :p/name "Grace"}])
        db (datom.conn/db c)]
    (is (= (set [[(:tx r1)]])
           (datom.query.engine/q '[:find ?tx :where [?e :p/name "Ada" ?tx]] db)))
    (is (= (set [[(:tx r2)]])
           (datom.query.engine/q '[:find ?tx :where [?e :p/name "Grace" ?tx]] db)))))

;; ── time travel over transaction metadata ───────────────────────────

(deftest transaction-metadata-time-travels-like-everything-else
  ; The annotations are datoms, so a historical view sees the
  ; annotations that existed then — not today's.
  (let [c (fixture)
        r1 (datom.conn/transact! c [{:db/id -1 :p/name "Ada"}
                                    {:db/id :db/current-tx :audit/by "alice"}])
        db1 (datom.conn/db c)]
    (datom.conn/transact! c [{:db/id -2 :p/name "Grace"}
                             {:db/id :db/current-tx :audit/by "bob"}])
    (let [db2 (datom.conn/db c)]
      (is (= 2 (count (datom.query.engine/q '[:find ?who :where [?tx :audit/by ?who]] db2))))
      (is (= 1 (count (datom.query.engine/q '[:find ?who :where [?tx :audit/by ?who]]
                                            (datom.time/as-of db2 (:tx r1)))))
          "at t1 only alice had made a change"))))
