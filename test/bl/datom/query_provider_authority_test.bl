(ns datom.query-provider-authority-test
 (:require [datom :as d] [datom.query.engine :as engine]
           [datom.query.relation :as relation] [datom.cache-validity :as validity]
           [data.bounded-cache :as cache] [test.bl.sdk-query-race :as race]))
(def LOOKUP-BARRIER (atom nil))
(defn lookup-barrier [name key revision]
 (let [state @LOOKUP-BARRIER
       hit (erlang/apply (:body state) (:fname state) (list name key revision))]
  (when (and @(:armed state) (= name (:name state)))
   (reset! (:armed state) false) (reset! (:observed state) (:hit? hit))
   (relation/register-relation! :provider/cache-name
    {:arity 2 :modes #{:ff :bf :fb :bb}
     :provider (fn [_ _ _ _] [[999 "computed"]])}))
  hit))
(deftest provider-registration-during-cache-lookup-refuses-the-retained-answer
 (race/with-engine (fn [private]
 (let [query-fn (:query private) c (d/connect [{:db/ident :provider/cache-name :db/valueType :db.type/string}])
       query '[:find ?e ?n :where [?e :provider/cache-name ?n]]
       armed (atom false) observed (atom false)
       original (get (BeamLisp.Env/ns_defs (:cache private)) "lookup")
       entry (first original)]
  (try
   (d/transact! c (mapv (fn [i] {:db/id i :provider/cache-name (str i)}) (range 1 65)))
   (let [database (d/db c)]
    (is (some? (validity/read-stamp database [:provider/cache-name])))
    ;; Replace actual emitted code so a previously compiled static caller
    ;; cannot bypass this registration race. Keep the old physical body.
    (reset! LOOKUP-BARRIER {:body (elem entry 4) :fname (elem entry 2)
                            :armed armed :observed observed :name (:name private)})
    (BeamLisp.Compiler/eval_string
     (str "(ns " (:cache private) ") (defn lookup [name key revision] (datom.query-provider-authority-test/lookup-barrier name key revision))"))
    (doseq [_ (range 8)] (query-fn query database))
    (reset! armed true)
    (is (= #{[999 "computed"]} (query-fn query database)))
    (is @observed "control confirms a previously retained model answer existed")
    (is (nil? (validity/read-stamp database [:provider/cache-name])))
    (is (= (engine/q-uncached query database) (query-fn query database))))
   (finally
    (BeamLisp.Link/defvar (:cache private) "lookup"
     (apply list (map (fn [e] (tuple (elem e 0) (elem e 1) (elem e 2) (elem e 3))) original)))
    (reset! LOOKUP-BARRIER nil)
    (d/close! c)))))))
