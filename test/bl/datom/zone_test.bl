(ns datom.zone-test (:require [datom.zone :as zone] [datom.time :as time] [bl.json :as json]))

(defn read-zone [name]
  (let [result (zone/decode (File/read! (str "test/fixtures/time-zones/" name)))]
    (when (:error result) (throw (ex-info "Fixture did not decode" result)))
    (:ok result)))
(defn instant [text] (time/from (time/read-iso8601 text)))

(deftest fixed-utc-and-the-time-scale-agree
  (let [utc (read-zone "UTC")]
    (is (= 0 zone/UNIX-EPOCH))
    (doseq [text ["1900-01-01T00:00" "2026-09-07T08:30" "2500-02-28T23:59"]]
      (let [result (zone/resolve-local utc text)]
        (is (= :unique (:status result)))
        (is (= (instant text) (:instant result)))
        (is (= 0 (:offset result)))))))

(deftest morocco-transitions-are-data-not-a-fixed-plus-one-hour-assumption
  (let [casa (read-zone "Africa_Casablanca")]
    (is (= :unique (:status (zone/resolve-local casa "2026-01-10T08:30"))))
    (is (= 3600 (:offset (zone/resolve-local casa "2026-01-10T08:30"))))
    (is (= 0 (:offset (zone/resolve-local casa "2026-03-01T08:30"))))
    (is (= :nonexistent (:status (zone/resolve-local casa "2026-03-22T02:30"))))
    (let [fold (zone/resolve-local casa "2026-02-15T02:30")]
      (is (= :ambiguous (:status fold)))
      (is (= [0 3600] (sort (mapv :offset (:choices fold)))))
      (is (= 3600 (- (:instant (second (:choices fold))) (:instant (first (:choices fold)))))))
    (let [point (zone/resolve-local casa "2026-09-07T08:30")
          projection (zone/local-parts casa (:instant point))]
      (is (= 8 (get-in projection [:parts :hour])))
      (is (= 30 (get-in projection [:parts :minute])))
      (is (= 3600 (:offset projection))))))

(deftest transition-boundaries-use-half-open-intervals
  (let [ny (read-zone "America_New_York") at (instant "2026-03-08T07:00")]
    (is (= -18000 (:offset (zone/offset-at ny (dec at)))))
    (is (= -14400 (:offset (zone/offset-at ny at))))
    (is (= :nonexistent (:status (zone/resolve-local ny "2026-03-08T02:30"))))
    (is (= :ambiguous (:status (zone/resolve-local ny "2026-11-01T01:30"))))
    (is (= :unknown (:status (zone/offset-at ny (:at (last (:transitions ny)))))))
    (is (= :unknown (:status (zone/resolve-local ny "2500-06-15T12:00"))))))

(deftest civil-input-is-exact-and-does-not-strip-a-zone-or-normalize-an-invalid-date
  (let [utc (read-zone "UTC")]
    (doseq [text ["2026-02-29T08:00" "2026-09-31T08:00" "2026-09-07T24:01"
                 "2026-09-07T08:60" "2026-09-07T08:30Z" "2026-09-07T08:30[Africa/Casablanca]"
                 "2026-09-07T08:30/2026-09-08" "" nil]]
      (is (= :invalid (:status (zone/resolve-local utc text)))))
    (is (= :unique (:status (zone/resolve-local utc "2028-02-29T08:30:17"))))))

(deftest malformed-or-unavailable-data-refuses-as-data
  (doseq [data [nil "" "TZif" (str "TZif" (apply str (repeat 50 "x")))]]
    (is (= :invalid-tzif (get-in (zone/decode data) [:error :code]))))
  (let [data (File/read! "test/fixtures/time-zones/UTC")]
    (doseq [length [4 43 44 48 51 53 80 (dec (erlang/byte_size data))]]
      (is (= :invalid-tzif (get-in (zone/decode (erlang/binary_part data 0 length)) [:error :code])))))
  (let [utc (read-zone "UTC") missing (assoc utc :types [{:offset 0 :dst? false :designation "-00"}]
                                            :fixed nil :future :initial)]
    (is (= :unknown (:status (zone/offset-at missing (instant "2026-01-01T00:00")))))))

(deftest transition-offsets-agree-with-an-independent-zoneinfo-reference
  (let [zones (into {} (mapv (fn [id] [id (read-zone id)]) ["UTC" "Africa_Casablanca" "America_New_York"]))
        references (json/decode (File/read! "test/fixtures/time-zones/offset-reference.json"))]
    (doseq [reference references]
      (is (= (get reference "offset")
             (:offset (zone/offset-at (get zones (get reference "zone")) (get reference "instant"))))))))
