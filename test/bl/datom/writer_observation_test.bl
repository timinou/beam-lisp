(ns datom.writer-observation-test (:require [datom :as d] [datom.conn :as conn]))
(deftest observations-follow-a-replacement-writer-and-refuse-released-handles
 (let [c (d/connect [{:db/ident :observation/value :db/valueType :db.type/long}])]
  (try
   (is (= {:state :ready :queued 0} (conn/writer-observation c)))
   (Process/exit (:writer c) :kill)
   (loop [left 100]
    (when (and (pos? left) (Process/alive? (:writer c)))
      (Process/sleep 1) (recur (dec left))))
   (is (= :unavailable (:state (conn/writer-observation c))))
   (d/transact! c [{:db/id -1 :observation/value 1}])
   (is (= {:state :ready :queued 0} (conn/writer-observation c)))
   (conn/release! c)
   (is (= :unavailable (:state (conn/writer-observation c))))
   (finally (d/close! c)))))
