(ns datom.binary-codec-test
  (:require [datom.value-codec :as codec]))
(def values [nil true false 0 1 -1 127 128 255 256 9007199254740991
             9223372036854775807 -9223372036854775808 9223372036854775808
             0.0 -0.0 1.23456789 "" "a\u0000b" "Liberté الحرية 合同"
             :qualified/name [1 2 3] {:anything ["nested" #{1 2}]}])
(deftest binary-first-codec-is-byte-identical-for-all-lanes-and-fallbacks
  (doseq [value (into values (mapv (fn [v] [42 :note/text v 123456789 true]) values))]
    (let [baseline (if (codec/datom-shaped? value) (codec/encode-datom-original value) (codec/encode-original value))]
      (is (= baseline (codec/encode-slot value)))
      (is (= value (codec/decode-slot (codec/encode-slot value))))))
)
(deftest datom-out-of-lane-fallbacks-and-attribute-byte-limit-remain-total
  (doseq [d [[9223372036854775808 :note/text "text" 4 true]
             [1 :note/text "text" -9223372036854775809 false]
             [1 (keyword (String/duplicate "é" 130)) "text" 4 true]
             [1 (keyword (String/duplicate "a" 255)) "text" 4 true]]]
    (let [baseline (codec/encode-datom-original d)]
      (is (= baseline (codec/encode-slot d)))
      (is (= d (codec/decode-slot baseline)))))
)
