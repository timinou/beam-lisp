(ns datom.text-backfill-fence-test (:require [datom] [datom.text :as text]))
(def indexed [{:db/ident :note/text :db/valueType :db.type/string :db/fulltext true}])
(def disabled [{:db/ident :note/text :db/valueType :db.type/string :db/fulltext false}])
(deftest historical-cursor-cannot-certify-later-unindexed-writes
  (let [c (datom/connect disabled)
        r (datom/transact! c [{:db/id -1 :note/text "zzzz legacy"} {:db/id -2 :note/text "later legacy"}])
        e (get (:tempids r) -1)]
    (try
      (datom/install-schema! c indexed)
      (let [first-page (text/reindex-page! (datom/db c) :note/text {:limit 1})]
        (is (= :incomplete (:status first-page)))
        (datom/install-schema! c disabled)
        (datom/transact! c [[:db/add e :note/text "aaa zephyr"]])
        (datom/install-schema! c indexed)
        (text/reindex-page! (datom/db c) :note/text {:limit 128 :after (:after first-page)})
        (is (not (text/ready? (datom/db c) :note/text)))
        (is (= :unindexed (:reason (text/candidates (datom/db c) :note/text "zephyr" {}))))
        (text/reindex-page! (datom/db c) :note/text {:limit 128})
        (is (= #{e} (:eids (text/candidates (datom/db c) :note/text "zephyr" {})))))
      (finally (datom/close! c)))))
