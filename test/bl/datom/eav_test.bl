; test/bl/datom/eav_test.bl — datoms, indexes, schema, transactions.
; Run: mix beam_lisp.test test/bl/datom/eav_test.bl
;
; The EAV core's semantics, pinned in-language. These assertions are
; Datomic's contract, not this implementation's incidental behaviour —
; where the two could differ, the test states what DATOMIC promises, so
; a change that drifts from it fails here rather than surprising someone
; later.

(ns datom.eav.test
  (:require [datom.conn] [datom.db] [datom.index] [datom.schema] [datom.store-ets] [datom.tx]))

(defn- fresh
  "A connection with a small people schema \u2014 one of each interesting kind
   of attribute, so cardinality/uniqueness/ref behaviour is reachable."
  []
  (datom.conn/connect
    [{:db/ident :person/name :db/valueType :db.type/string}
     {:db/ident :person/age :db/valueType :db.type/long}
     {:db/ident :person/email :db/valueType :db.type/string :db/unique :db.unique/identity}
     {:db/ident :person/tag :db/valueType :db.type/keyword :db/cardinality :db.cardinality/many}
     {:db/ident :person/friend :db/valueType :db.type/ref :db/cardinality :db.cardinality/many}]))

(defn- new-entity
  "Transact `m` as a new entity and return its real id."
  [conn m]
  (let [r (datom.conn/transact! conn [(assoc m :db/id -1)])]
    (get (:tempids r) -1)))

;; ── datoms ──────────────────────────────────────────────────────────

(deftest a-datom-is-a-plain-vector
  ; Deliberate: a datom needs no wrapper type, and every layer above
  ; reads as ordinary data code because of it.
  (let [d (datom.index/datom 1 :person/name "Ada" 100 true)]
    (is (vector? d))
    (is (= [1 :person/name "Ada" 100 true] d))
    (is (= 1 (datom.index/-e d)))
    (is (= :person/name (datom.index/-a d)))
    (is (= "Ada" (datom.index/-v d)))
    (is (= 100 (datom.index/-tx d)))
    (is (datom.index/assertion? d))))

;; ── indexes ─────────────────────────────────────────────────────────

(deftest a-prefix-scan-brackets-exactly-its-partition
  ; THE property BUG-005 denied to tuple keys. With binary keys, an
  ; index-tagged prefix selects that index and nothing else.
  (let [s (datom.store-ets/open)
        schema (datom.schema/install (datom.schema/empty-schema)
                                     {:db/ident :person/name :db/valueType :db.type/string})]
    (datom.index/write-datoms s schema
                              [(datom.index/datom 1 :person/name "Ada" 100 true)
                               (datom.index/datom 2 :person/name "Grace" 100 true)])
    ; a plain attribute lands in the two base indexes only
    (is (= 2 (count (datom.index/scan s :eavt))))
    (is (= 2 (count (datom.index/scan s :aevt))))
    (is (= 0 (count (datom.index/scan s :avet))) "not indexed by value")
    (is (= 4 (datom.store/range-count s nil nil)))))

(deftest index-maintenance-follows-the-schema
  ; AVET and VAET are selective: each is another write per datom, so they
  ; are maintained only where the schema says they earn it.
  (let [schema (datom.schema/install-all (datom.schema/empty-schema)
                 [{:db/ident :plain :db/valueType :db.type/string}
                  {:db/ident :indexed :db/valueType :db.type/string :db/index true}
                  {:db/ident :uniq :db/valueType :db.type/string :db/unique :db.unique/identity}
                  {:db/ident :r :db/valueType :db.type/ref}])]
    (is (= [:eavt :aevt] (datom.index/indexes-for schema :plain)))
    (is (= [:eavt :aevt :avet] (datom.index/indexes-for schema :indexed)))
    (is (= [:eavt :aevt :avet] (datom.index/indexes-for schema :uniq))
        "uniqueness REQUIRES value lookup, so it implies AVET")
    (is (= [:eavt :aevt :avet :vaet] (datom.index/indexes-for schema :r))
        "a ref is indexed both ways: forward by value, reverse by VAET")))

(deftest eavt-answers-everything-about-one-entity
  (let [s (datom.store-ets/open)]
    (datom.index/write-datoms s (datom.schema/empty-schema)
                              [(datom.index/datom 1 :person/name "Ada" 100 true)
                               (datom.index/datom 1 :person/age 36 100 true)
                               (datom.index/datom 2 :person/name "Grace" 100 true)])
    (is (= 2 (count (datom.index/scan s :eavt 1))))
    (is (= 1 (count (datom.index/scan s :eavt 2))))
    (is (= 0 (count (datom.index/scan s :eavt 99))))))

(deftest eavt-narrows-to-one-attribute
  (let [s (datom.store-ets/open)]
    (datom.index/write-datoms s (datom.schema/empty-schema)
                              [(datom.index/datom 1 :person/name "Ada" 100 true)
                               (datom.index/datom 1 :person/age 36 100 true)])
    (is (= "Ada" (datom.index/-v (first (datom.index/scan s :eavt 1 :person/name)))))))

(deftest aevt-answers-every-value-of-one-attribute
  ; The column scan. EAVT cannot serve this without reading every entity.
  (let [s (datom.store-ets/open)]
    (datom.index/write-datoms s (datom.schema/empty-schema)
                              [(datom.index/datom 1 :person/name "Ada" 100 true)
                               (datom.index/datom 2 :person/name "Grace" 100 true)
                               (datom.index/datom 1 :person/age 36 100 true)])
    (is (= 2 (count (datom.index/scan s :aevt :person/name))))
    (is (= 1 (count (datom.index/scan s :aevt :person/age))))))

;; ── schema ──────────────────────────────────────────────────────────

(deftest cardinality-defaults-to-one
  ; The safer default: replacing a value is recoverable through history,
  ; silently accumulating duplicates is not.
  (let [s (datom.schema/install (datom.schema/empty-schema)
                                {:db/ident :a :db/valueType :db.type/string})]
    (is (= :db.cardinality/one (datom.schema/cardinality s :a)))
    (is (not (datom.schema/many? s :a)))))

(deftest uniqueness-and-refs-imply-indexing
  ; Enforcing uniqueness requires looking a value UP, which is what AVET
  ; is; requiring both flags would let them disagree.
  (let [s (datom.schema/install-all (datom.schema/empty-schema)
            [{:db/ident :plain :db/valueType :db.type/string}
             {:db/ident :uniq :db/valueType :db.type/string :db/unique :db.unique/identity}
             {:db/ident :r :db/valueType :db.type/ref}])]
    (is (not (datom.schema/indexed? s :plain)))
    (is (datom.schema/indexed? s :uniq))
    (is (datom.schema/indexed? s :r))))

(deftest invalid-schema-is-rejected-at-install
  ; Bad schema silently changes what every future transaction MEANS, so
  ; it must fail loudly at install rather than at first use.
  (are [definition] (= :raised
                       (try (datom.schema/install (datom.schema/empty-schema) definition)
                            :no-raise
                            (catch e :raised)))
    {:db/valueType :db.type/string}
    {:db/ident :a :db/valueType :bogus}
    {:db/ident :a :db/cardinality :bogus}
    {:db/ident :a :db/unique :db.unique/value}))

(deftest a-transaction-reports-every-schema-problem-at-once
  ; Four bad fields should cost one round trip, not four.
  (let [s (datom.schema/install-all (datom.schema/empty-schema)
            [{:db/ident :n :db/valueType :db.type/long}])
        problems (datom.tx/validate (datom.store-ets/open) s
                                    [[:db/add 1 :n "no"] [:db/add 1 :n "also no"]])]
    (is (= 2 (count problems)))
    (is (= :wrong-type (get (first problems) :error)))))

;; ── transactions ────────────────────────────────────────────────────

(deftest tempids-resolve-to-real-entity-ids
  (let [c (fresh)
        r (datom.conn/transact! c [{:db/id -1 :person/name "Ada"}])
        e (get (:tempids r) -1)]
    (is (int? e))
    (is (> e 0) "a real id is positive; a tempid is negative")
    (is (= "Ada" (:person/name (datom.db/entity (datom.conn/db c) e))))))

(deftest one-transaction-can-build-a-graph
  ; The same tempid twice means the same new entity, which is how a
  ; transaction creates entities that point at each other.
  (let [c (fresh)
        r (datom.conn/transact! c [{:db/id -1 :person/name "Ada"}
                                   {:db/id -2 :person/name "Grace" :person/friend [-1]}])
        ada (get (:tempids r) -1)
        grace (get (:tempids r) -2)]
    (is (not (= ada grace)))
    (is (= [ada] (:person/friend (datom.db/entity (datom.conn/db c) grace)))
        "the ref value resolved to Ada's REAL id")))

(deftest cardinality-one-assertion-supersedes-the-previous-value
  (let [c (fresh)
        e (new-entity c {:person/age 36})]
    (datom.conn/transact! c [[:db/add e :person/age 37]])
    (is (= 37 (:person/age (datom.db/entity (datom.conn/db c) e))))
    (is (= 1 (count (datom.db/datoms (datom.conn/db c) :eavt e :person/age)))
        "exactly one value is current")))

(deftest cardinality-many-accumulates-instead-of-superseding
  (let [c (fresh)
        e (new-entity c {:person/tag :a})]
    (datom.conn/transact! c [[:db/add e :person/tag :b]])
    (is (= 2 (count (datom.db/datoms (datom.conn/db c) :eavt e :person/tag))))
    (is (= [:a :b] (:person/tag (datom.db/entity (datom.conn/db c) e))))))

(deftest asserting-a-fact-that-already-holds-is-a-no-op
  ; A datom is a FACT; asserting it twice does not make it twice true.
  ; Without this, re-running an import doubled every many-valued
  ; attribute in the database (found by probe, not by reading).
  (let [c (fresh)
        e (new-entity c {:person/tag :a :person/age 36})
        datoms-before (count (datom.index/scan (:store c) :eavt e))]
    (datom.conn/transact! c [[:db/add e :person/tag :a]])
    (datom.conn/transact! c [[:db/add e :person/age 36]])
    (is (= datoms-before (count (datom.index/scan (:store c) :eavt e)))
        "no new datoms were written, not even retractions")
    (is (= [:a] (:person/tag (datom.db/entity (datom.conn/db c) e))))))

(deftest retraction-removes-a-fact-from-the-present
  (let [c (fresh)
        e (new-entity c {:person/name "Ada"})]
    (datom.conn/transact! c [[:db/retract e :person/name "Ada"]])
    (is (nil? (:person/name (datom.db/entity (datom.conn/db c) e))))))

(deftest a-unique-identity-value-upserts-onto-the-existing-entity
  ; What makes a transaction idempotent: the second transact updates the
  ; SAME person rather than creating a second one with a duplicate email.
  (let [c (fresh)
        first-id (new-entity c {:person/email "ada@example.com" :person/name "Ada"})
        r (datom.conn/transact! c [{:db/id -1
                                    :person/email "ada@example.com"
                                    :person/age 36}])
        second-id (get (:tempids r) -1)]
    (is (= first-id second-id) "the tempid resolved onto the existing entity")
    (let [e (datom.db/entity (datom.conn/db c) first-id)]
      (is (= "Ada" (:person/name e)) "the earlier fact survived")
      (is (= 36 (:person/age e)) "and the new one was added"))))

(deftest a-rejected-transaction-writes-nothing
  ; Partial application would be worse than rejection: the caller would
  ; have to discover which half landed.
  (let [c (fresh)
        e (new-entity c {:person/name "Ada"})
        before (count (datom.index/scan (:store c) :eavt e))]
    (is (= :raised (try (datom.conn/transact! c [[:db/add e :person/age "not a number"]])
                        :no-raise
                        (catch err :raised))))
    (is (= before (count (datom.index/scan (:store c) :eavt e))))))

(deftest a-transaction-report-carries-what-a-caller-needs
  (let [c (fresh)
        r (datom.conn/transact! c [{:db/id -1 :person/name "Ada"}])]
    (is (some? (:db-before r)))
    (is (some? (:db-after r)))
    (is (int? (:tx r)))
    (is (contains? (:tempids r) -1))
    (is (= 1 (count (:tx-datoms r))))))

;; ── the database as a value ─────────────────────────────────────────

(deftest a-db-value-does-not-change-when-the-connection-does
  ; The property everything else rests on. A held db value is a snapshot
  ; that stays true regardless of later transactions.
  (let [c (fresh)
        e (new-entity c {:person/age 36})
        snapshot (datom.conn/db c)]
    (datom.conn/transact! c [[:db/add e :person/age 99]])
    (is (= 36 (:person/age (datom.db/entity snapshot e))) "the snapshot is unmoved")
    (is (= 99 (:person/age (datom.db/entity (datom.conn/db c) e))) "the connection moved on")))

(deftest the-basis-advances-with-each-transaction
  (let [c (fresh)
        t0 (datom.db/basis-t (datom.conn/db c))]
    (datom.conn/transact! c [{:db/id -1 :person/name "Ada"}])
    (is (> (datom.db/basis-t (datom.conn/db c)) t0))))

(deftest superseded-values-remain-in-the-log
  ; Nothing is ever deleted \u2014 which is what makes wave 5's time travel
  ; possible at all. The old value is invisible to `entity`, but the
  ; datom is still there.
  (let [c (fresh)
        e (new-entity c {:person/age 36})]
    (datom.conn/transact! c [[:db/add e :person/age 37]])
    (let [current (count (datom.db/datoms (datom.conn/db c) :eavt e :person/age))
          all (count (datom.index/scan (:store c) :eavt e :person/age))]
      (is (= 1 current) "one value is true now")
      (is (= 3 all) "assert 36, retract 36, assert 37 \u2014 all still recorded"))))

(deftest entity-returns-nil-for-an-unknown-id
  (is (nil? (datom.db/entity (datom.conn/db (fresh)) 99999))))

(deftest entity-includes-its-own-id-so-it-round-trips
  (let [c (fresh)
        e (new-entity c {:person/name "Ada"})]
    (is (= e (:db/id (datom.db/entity (datom.conn/db c) e))))))

;; ── review-gate regressions (wave 2 swarm) ──────────────────────────────────
;;
;; Six defects, one root cause: `tx.bl` realized operations against RAW index
;; scans and against the pre-transaction store. Raw scans see history as if it
;; were current, and a pre-transaction view cannot see the transaction's own
;; earlier operations. Every failure below was silent — a database that
;; violated its own rules with no error raised.

(deftest two-assertions-of-one-attribute-in-one-transaction
  ; Both ops read the pre-transaction store, so both asserted: the entity
  ; ended with TWO current values for a cardinality-one attribute.
  (let [c (fresh)
        e (new-entity c {:person/age 36})]
    (datom.conn/transact! c [[:db/add e :person/age 37]
                             [:db/add e :person/age 38]])
    (is (= 1 (count (datom.db/datoms (datom.conn/db c) :eavt e :person/age))))
    (is (= 38 (:person/age (datom.db/entity (datom.conn/db c) e)))
        "the LAST assertion in the transaction wins")))

(deftest a-superseded-value-can-be-restored
  ; `already-true?` consulted history rather than current state, so
  ; re-asserting a previously-superseded value looked like a no-op and
  ; silently did nothing.
  (let [c (fresh)
        e (new-entity c {:person/age 36})]
    (datom.conn/transact! c [[:db/add e :person/age 37]])
    (datom.conn/transact! c [[:db/add e :person/age 36]])
    (is (= 36 (:person/age (datom.db/entity (datom.conn/db c) e))))))

(deftest upsert-ignores-a-retracted-identity
  ; A raw AVET scan matched the retracted email, so new data was attached
  ; to the entity that used to own it instead of creating a new one.
  (let [c (fresh)
        old (new-entity c {:person/email "ada@example.com"})]
    (datom.conn/transact! c [[:db/retract old :person/email "ada@example.com"]])
    (let [r (datom.conn/transact! c [{:db/id -1 :person/email "ada@example.com"}])]
      (is (not (= old (get (:tempids r) -1)))
          "a retracted identity belongs to nobody"))))

(deftest two-tempids-claiming-one-identity-become-one-entity
  ; Neither tempid existed yet, so each got a fresh id — creating two
  ; entities sharing a value declared unique.
  (let [c (fresh)
        r (datom.conn/transact! c [{:db/id -1 :person/email "same@example.com"}
                                   {:db/id -2 :person/email "same@example.com"
                                    :person/age 5}])]
    (is (= (get (:tempids r) -1) (get (:tempids r) -2)))
    (is (= 5 (:person/age (datom.db/entity (datom.conn/db c) (get (:tempids r) -1))))
        "and both maps' facts landed on that one entity")))

(deftest unique-value-rejects-a-duplicate
  ; The schema distinguished :db.unique/value (error) from
  ; :db.unique/identity (upsert) from the start, but nothing enforced it.
  (let [c (datom.conn/connect
            [{:db/ident :item/sn :db/valueType :db.type/string
              :db/unique :db.unique/value}])]
    (datom.conn/transact! c [{:db/id -1 :item/sn "SN-1"}])
    (is (= :raised (try (datom.conn/transact! c [{:db/id -2 :item/sn "SN-1"}])
                        :allowed
                        (catch e :raised))))))

(deftest unique-value-permits-re-asserting-your-own-value
  ; The conflict is with ANOTHER entity; re-asserting your own is a no-op.
  (let [c (datom.conn/connect
            [{:db/ident :item/sn :db/valueType :db.type/string
              :db/unique :db.unique/value}])
        e (get (:tempids (datom.conn/transact! c [{:db/id -1 :item/sn "SN-1"}])) -1)]
    (is (= :ok (try (do (datom.conn/transact! c [[:db/add e :item/sn "SN-1"]]) :ok)
                    (catch err :raised))))))

(deftest retracting-a-value-the-entity-does-not-hold-is-a-no-op
  ; It recorded a retraction datom for a fact that never existed,
  ; polluting both history and the transaction report.
  (let [c (fresh)
        e (new-entity c {:person/age 1})
        r (datom.conn/transact! c [[:db/retract e :person/age 999]])]
    (is (= 0 (count (:tx-datoms r))))
    (is (= 1 (:person/age (datom.db/entity (datom.conn/db c) e)))
        "and the real value is untouched")))

(deftest one-tempid-cannot-claim-two-different-entities
  ; No correct outcome exists for this transaction; silently picking the
  ; first target would MERGE two people.
  (let [c (datom.conn/connect
            [{:db/ident :p/email :db/valueType :db.type/string
              :db/unique :db.unique/identity}
             {:db/ident :p/nick :db/valueType :db.type/string
              :db/unique :db.unique/identity}])]
    (datom.conn/transact! c [{:db/id -1 :p/email "a@x"}])
    (datom.conn/transact! c [{:db/id -1 :p/nick "bee"}])
    (is (= :raised (try (datom.conn/transact! c [{:db/id -1 :p/email "a@x" :p/nick "bee"}])
                        :merged
                        (catch e :raised))))))

;; ── visibility filter: correctness and cost ─────────────────────────────────

(deftest every-scan-shape-agrees-about-what-is-current
  ; The filter builds its retraction index from the SCAN RESULT rather
  ; than from a per-datom store lookup. That is only correct because a
  ; retraction shares [e a v] with the assertion it cancels, so it lands
  ; in the same prefix — whichever index is scanned. These assertions pin
  ; that invariant across every scan shape a query might use.
  (let [c (fresh)
        e (new-entity c {:person/name "a" :person/tag :x})]
    (datom.conn/transact! c [[:db/add e :person/name "b"]])
    (datom.conn/transact! c [[:db/retract e :person/tag :x]])
    (let [db (datom.conn/db c)]
      (is (= 1 (count (datom.db/datoms db :eavt e))) "one attribute survives")
      (is (= "b" (:person/name (datom.db/entity db e))))
      (is (= 0 (count (datom.db/datoms db :eavt e :person/tag))))
      (is (= 1 (count (datom.db/datoms db :aevt :person/name))))
      (is (= 0 (count (datom.db/datoms db :aevt :person/tag))))
      (is (= 1 (count (filterv (fn [d] (datom.db/keep-datom? db d))
                               (datom.index/scan (:store c) :eavt e))))
          "the single-datom path agrees with the bulk path"))))

(deftest filtering-is-linear-not-quadratic
  ; `retracted-later?` ran a store scan PER DATOM, so reading N datoms
  ; cost N scans. A reviewer measured 45 SECONDS for 1000 values. Wave 3's
  ; join engine calls `datoms` in a loop, so a quadratic read path would
  ; have made every join quadratic too.
  ;
  ; Asserting a RATIO rather than a duration: absolute timings vary by
  ; machine, but the shape of the curve is the contract.
  (let [c (fresh)
        n 200]
    (datom.conn/transact! c (mapv (fn [i] {:db/id (- 0 (inc i))
                                           :person/name (str "n" i)})
                                  (range n)))
    (let [t0 (erlang/monotonic_time :millisecond)
          raw (count (datom.index/scan (:store c) :aevt :person/name))
          t1 (erlang/monotonic_time :millisecond)
          filtered (count (datom.db/datoms (datom.conn/db c) :aevt :person/name))
          t2 (erlang/monotonic_time :millisecond)
          raw-ms (max 1 (- t1 t0))
          filtered-ms (- t2 t1)]
      (is (= n raw))
      (is (= n filtered) "the filter keeps every current datom")
      (is (< filtered-ms (* 25 raw-ms))
          (str "filtering cost " filtered-ms "ms against a raw scan of "
               raw-ms "ms — a quadratic filter blows past this bound")))))
