; test/bl/datom/projection_test.bl — generated owed/stale/proposed, and a model
; that says the generator is right for every order of events (gate G1).

(ns datom.projection-test
  (:require [datom] [datom.projection :as pj] [veritas.model :as vm]))

(def schema
  (into [{:db/ident :k           :db/valueType :db.type/term :db/unique :db.unique/identity}
         {:db/ident :parent      :db/valueType :db.type/ref}
         {:db/ident :folder?     :db/valueType :db.type/boolean}
         {:db/ident :trashed     :db/valueType :db.type/boolean}
         {:db/ident :rev         :db/valueType :db.type/long}
         {:db/ident :mount/root  :db/valueType :db.type/ref}
         {:db/ident :mount/state :db/valueType :db.type/keyword}]
        pj/schema))

(def UNDER '[[(under ?f ?r) [?f :parent ?r]]
             [(under ?f ?r) [?f :parent ?x] (under ?x ?r)]])

(def DOC
  (pj/projection :test/doc
    {:active   '[[?scope :mount/state :active]]
     :member   '[[?scope :mount/root ?r] (under ?src ?r)
                 [:not [?src :folder? true]] [:not [?src :trashed true]]]
     :revision '[[?src :rev ?rev]]}))

(defn- eid [c k] (first (first (into [] (datom/q '[:find ?e :in $ ?k :where [?e :k ?k]] (datom/db c) k)))))
(defn- key-of [c e] (first (first (into [] (datom/q '[:find ?k :in $ ?e :where [?e :k ?k]] (datom/db c) e)))))

(defn- world []
  (let [c (datom/connect schema)]
    (datom/transact! c [{:db/id -1 :k :root :folder? true}
                        {:db/id -2 :k :out :folder? true}
                        {:db/id -3 :k :sub :folder? true :parent -1}
                        {:db/id -9 :k :m1 :mount/root -1 :mount/state :active}])
    c))

(defn- add! [c k parent rev]
  (datom/transact! c [{:db/id -1 :k k :parent (eid c parent) :rev rev}]))

(defn- owed-keys [c]
  (into #{} (map (fn [[_ s r]] [(key-of c s) r]) (pj/owed DOC (datom/db c) UNDER (eid c :m1)))))
(defn- stale-keys [c]
  (into #{} (map (fn [[_ s]] (key-of c s)) (pj/stale DOC (datom/db c) UNDER (eid c :m1)))))

(defn- answer! [c k rev state]
  (let [m (eid c :m1)]
    (datom/transact! c (pj/record-tx DOC {:scope m :scope-key :m1 :src (eid c k) :src-key k :rev rev}
                                     (if (= state :applied) {:state :applied :target [:lib k rev]}
                                         {:state :skipped :reason "unsupported"})))))

(defn- retire-all! [c]
  (doseq [[rec _] (pj/stale DOC (datom/db c) UNDER (eid c :m1))]
    (datom/transact! c (pj/retire-tx rec))))

;; ── declaration refusals ────────────────────────────────────────────────────

(deftest a-declaration-is-validated-by-name
  (is (thrown? (pj/projection :x {:member '[[?scope :a ?src]]})))
  (is (thrown? (pj/projection :x {:member '[[?a :b ?c]] :revision '[[?src :rev ?rev]]})))
  (is (thrown? (pj/projection :x {:member '[[?scope :a ?src] [?p :b ?src]] :revision '[[?src :rev ?rev]]}))))

;; ── the prototype's scenarios ───────────────────────────────────────────────

(deftest owed-is-members-at-their-revision
  (let [c (world)]
    (add! c :a :root 1) (add! c :b :sub 1) (add! c :o :out 1)
    (is (= #{[:a 1] [:b 1]} (owed-keys c)))
    (is (= #{:a :b} (into #{} (map (fn [[_ s]] (key-of c s))
                                   (pj/proposed DOC (datom/db c) UNDER (eid c :m1))))))))

(deftest an-answer-drains-and-a-new-revision-re-owes
  (let [c (world)]
    (add! c :a :root 1)
    (answer! c :a 1 :applied)
    (is (empty? (owed-keys c)))
    (datom/transact! c [[:db/add (eid c :a) :rev 2]])
    (is (= #{[:a 2]} (owed-keys c)))))

(deftest leaving-makes-stale-and-a-retired-record-answers-nothing
  (let [c (world)]
    (add! c :a :root 1)
    (answer! c :a 1 :applied)
    (datom/transact! c [[:db/add (eid c :a) :parent (eid c :out)]])
    (is (= #{:a} (stale-keys c)))
    (retire-all! c)
    (is (empty? (stale-keys c)))
    ;; back at the SAME revision: owed again (retired does not answer)
    (datom/transact! c [[:db/add (eid c :a) :parent (eid c :root)]])
    (is (= #{[:a 1]} (owed-keys c)))))

(deftest skipped-keeps-its-target-so-leaving-is-still-stale
  (let [c (world)]
    (add! c :a :root 1)
    (answer! c :a 1 :applied)
    (datom/transact! c [[:db/add (eid c :a) :rev 2]])
    (answer! c :a 2 :skipped)
    (is (= [:lib :a 1] (:proj/target (pj/record DOC (datom/db c) :m1 :a))))
    (datom/transact! c [[:db/add (eid c :a) :trashed true]])
    (is (= #{:a} (stale-keys c)))))

(deftest paused-owes-nothing-but-stale-still-tells-the-truth
  (let [c (world)]
    (add! c :a :root 1) (add! c :b :root 1)
    (answer! c :a 1 :applied)
    (datom/transact! c [[:db/add (eid c :m1) :mount/state :paused]])
    (datom/transact! c [[:db/add (eid c :a) :parent (eid c :out)]])
    (is (empty? (owed-keys c)))
    (is (= #{:a} (stale-keys c)))))

;; ── the model: every order of events ────────────────────────────────────────
;; Model state: {:files {k {:parent p :rev r :trashed bool}} :answered {k rev|:retired-at-rev}
;;               :held #{k …} (records holding a target) :paused bool}.
;; The generator is right iff owed = {members whose rev is not answered} (when
;; active) and stale = {held records whose source is not a member}.

(defn- member? [s k]
  (let [f (get-in s [:files k])]
    (and (some? f) (not (:trashed f))
         (loop [p (:parent f)] (cond (= p :root) true (= p :sub) true :else false)))))

(defn- expected-owed [s]
  (if (:paused s) #{}
    (into #{} (keep (fn [[k f]] (if (and (member? s k) (not= (get-in s [:answered k]) (:rev f)))
                                  [k (:rev f)] nil))
                    (into [] (:files s))))))

(defn- expected-stale [s]
  (into #{} (filter (fn [k] (not (member? s k))) (:held s))))

(def KEYS [:f0 :f1 :f2 :f3])

(def projection-model
  (vm/model "projection"
    {:state {:files {} :answered {} :held #{} :paused false}
     :init world
     :commands
     {:add     {:args (vm/tuple (vm/fresh "f" (fn [s] (keys (:files s)))) (vm/one-of [:root :sub :out]))
                :pre  (fn [s _] (< (count (:files s)) 6))
                :next (fn [s [k p]] (assoc-in s [:files k] {:parent p :rev 1 :trashed false}))
                :run  (fn [c [k p]] (add! c k p 1))}
      :move    {:args (vm/tuple (vm/pick (fn [s] (sort (keys (:files s))))) (vm/one-of [:root :sub :out]))
                :next (fn [s [k p]] (assoc-in s [:files k :parent] p))
                :run  (fn [c [k p]] (datom/transact! c [[:db/add (eid c k) :parent (eid c p)]]))}
      :bump    {:args (vm/pick (fn [s] (sort (keys (:files s)))))
                :next (fn [s k] (update-in s [:files k :rev] inc))
                :run  (fn [c k] (datom/transact! c [[:db/add (eid c k) :rev (+ 1 (:rev (datom/pull (datom/db c) [:rev] (eid c k))))]]))}
      :trash   {:args (vm/pick (fn [s] (sort (keys (:files s)))))
                :next (fn [s k] (assoc-in s [:files k :trashed] true))
                :run  (fn [c k] (datom/transact! c [[:db/add (eid c k) :trashed true]]))}
      :pause   {:args (vm/one-of [true false])
                :next (fn [s b] (assoc s :paused b))
                :run  (fn [c b] (datom/transact! c [[:db/add (eid c :m1) :mount/state (if b :paused :active)]]))}
      ;; the executor's two moves, as the model sees them
      :apply   {:args (vm/one-of [:applied :skipped])
                :next (fn [s st]
                        (reduce (fn [s [k r]]
                                  (-> s (assoc-in [:answered k] r)
                                        ;; :skipped keeps an existing target, adds none
                                  (update :held (fn [h] (if (= st :applied) (conj h k) h)))))
                                s (sort (expected-owed s))))
                :run  (fn [c st]
                        (doseq [[_ src rev] (sort-by (fn [r] (key-of c (second r)))
                                                     (pj/owed DOC (datom/db c) UNDER (eid c :m1)))]
                          (answer! c (key-of c src) rev st)))}
      :retire  {:next (fn [s _]
                        (let [gone (expected-stale s)]
                          (-> s (update :held (fn [h] (into #{} (remove gone h))))
                                (update :answered (fn [a] (reduce dissoc a gone))))))
                :run  (fn [c _] (retire-all! c))}}
     :invariants
     {:owed-matches  (fn [s c] (= (expected-owed s) (owed-keys c)))
      :stale-matches (fn [s c] (= (expected-stale s) (stale-keys c)))}}))

(deftest the-generator-agrees-with-the-model-over-every-generated-history
  (let [r (vm/check projection-model {:seed 7 :histories 300 :max-len 25 :budget-ms 90000})]
    (when (= :refuted (:modality r))
      (println "shrunk:" (pr-str (:shrunk r)) "broke:" (:broke r)))
    (println (str "  model: " (:why r)))
    (is (= :witnessed (:modality r)))
    (is (= [] (:unexercised r)))))
