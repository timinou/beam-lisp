(ns datom.rank-plan-test (:require [datom.query.rank-plan :as rank]))
(def S {:item/scope {:db/ident :item/scope :db/valueType :db.type/ref}
        :item/order {:db/ident :item/order :db/valueType :db.type/long}
        :item/name {:db/ident :item/name :db/valueType :db.type/string}})
(def Q '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(deftest ordinary-scoped-query-admission
 (let [d (rank/descriptor Q S [7] ['?at :desc])]
  (is (some? d)) (is (= :item/scope (:scope-attr d)))
  (is (= :item/order (:order-attr d)))
  (is (= [nil :item/order :item/name] (:columns d)))
  (is (= [:item/name :item/order :item/scope] (:required d)))
  (is (not= (:scope d) (:scope (rank/descriptor Q S [8] ['?at :desc]))))
  (is (= (:schema d) (:schema (rank/descriptor Q S [8] ['?at :desc])))))
 (is (= :count (:kind (rank/descriptor
   '[:find (count ?e) . :in $ ?scope :where [?e :item/scope ?scope]
     [?e :item/order ?at] [?e :item/name ?name]] S [7] nil)))))
(deftest uncertain-shapes-decline
 (doseq [q ['[:find ?at :in $ ?scope :where [?e :item/scope ?scope] [?e :item/order ?at]]
            '[:find ?e ?v :in $ ?scope :where [?e :item/scope ?scope] [?e :item/order ?v] [?e :item/name ?v]]
            '[:find ?e ?at :in $ ?scope :where [?e :item/scope ?scope] [?e :item/order ?at ?tx]]
            '[:find ?e ?at :in $ [?scope ...] :where [?e :item/scope ?scope] [?e :item/order ?at]]
            '[:find ?e ?at :in $ ?scope :where [?e :item/scope ?scope] [?e :item/order ?at] [(> ?at 0)]]
            '[:find ?e ?at :in $ ?scope :where [?e :item/scope ?scope] [?other :item/order ?at]]]]
  (is (nil? (rank/descriptor q S [7] ['?at :desc]))))
 (is (nil? (rank/descriptor Q (assoc-in S [:item/order :db/cardinality] :db.cardinality/many) [7] ['?at :desc])))
 (is (nil? (rank/descriptor Q (dissoc S :item/name) [7] ['?at :desc])))
 (is (nil? (rank/descriptor Q S [7] ['?missing :desc])))
 (is (nil? (rank/descriptor Q S [] ['?at :desc]))))
(deftest opaque-or-oversized-schema-evidence-declines
 (is (nil? (rank/descriptor Q (assoc-in S [:item/name :custom-validator] (fn [v] v)) [7] ['?at :desc])))
 (is (nil? (rank/descriptor Q (assoc-in S [:item/name :db/doc] (String/duplicate "x" 65536)) [7] ['?at :desc]))))
