(ns datom.attr-basis-concurrency-test
  (:require [datom.attr-basis :as marks] [datom.derived :as derived]
            [datom.store :as store] [datom.store-map :as memory]))

;; Delays one read AFTER capturing its old value. Commit is allowed to finish
;; before that old reader resumes. This is a repeatable durable lost-update race.
(defrecord DelayedRead [inner armed parent]
  store/Store
  (-get [s k]
    (let [value (store/-get (:inner s) k)]
      (when @(:armed s)
        (reset! (:armed s) false)
        (erlang/send (:parent s) [:old-mark-read (erlang/self)])
        (receive :resume :ok (after 5000 (assert false "resume timed out"))))
      value))
  (-range [s lo hi] (store/-range (:inner s) lo hi))
  (-put [s k v] (store/-put (:inner s) k v))
  (-delete [s k] (store/-delete (:inner s) k))
  (-update [s k f] (store/-update (:inner s) k f))
  (-commit [s ops] (store/-commit (:inner s) ops)))

(deftest a-reader-build-note-cannot-overwrite-a-concurrent-commit
  (let [armed (atom false)
        s (->DelayedRead (memory/open) armed (erlang/self))]
    (store/-commit s (marks/record-ops s [:vec :tag] 1))
    (reset! armed true)
    (spawn (fn [] (marks/note! s :vec 5)
                 (erlang/send (:parent s) :note-done)))
    (let [reader (receive [:old-mark-read pid] pid
                   (after 5000 (throw "marker read timed out")))]
      (store/-commit s (marks/record-ops s [:vec] 10))
      (erlang/send reader :resume)
      (is (receive :note-done true (after 5000 false)))
      (is (= 10 (:vec (marks/durable-marks-of s))))
      (is (= 1 (:tag (marks/durable-marks-of s))))
      (is (= 10 (marks/basis-t-for s :vec 0)))
      ;; Dropping the in-memory tier must not conceal an overwritten record.
      (marks/forget!)
      (is (= 10 (marks/basis-t-for s :vec 0)))
      (is (= 1 (marks/basis-t-for s :tag 0))))))

(deftest independent-writers-preserve-every-attribute-and-never-lower-one
  (let [s (memory/open) parent (erlang/self)]
    (marks/record-ops s [:fixed] 10)
    (marks/record-ops s [:fixed] 1)
    (is (= 10 (marks/basis-t-for s :fixed 0)))
    (doseq [worker (range 8)]
      (spawn (fn []
               (doseq [n (range 50)]
                 (marks/record-ops s [(keyword (str "writer-" worker "-" n))] (+ n 1)))
               (erlang/send parent :writer-done))))
    (doseq [_ (range 8)]
      (is (receive :writer-done true (after 5000 false))))
    (doseq [worker (range 8) n (range 50)]
      (is (= (+ n 1) (marks/basis-t-for s (keyword (str "writer-" worker "-" n)) 0))))))
