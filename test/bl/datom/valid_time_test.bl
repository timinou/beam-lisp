; test/bl/datom/valid_time_test.bl — valid time, the second axis (PLAN-115 B2).
; Run: bl test test/bl/datom/valid_time_test.bl
;
; datom has two time axes. TRANSACTION time (as-of/since) filters by WHEN a fact
; was recorded. VALID time (valid-at/valid-between) filters by WHEN a fact is
; true in the world — carried on each transaction's :db.valid/from/:db.valid/to.
; The two are independent and compose: `(valid-at (as-of db tx) vt)` is "what did
; we believe AT tx was true AT vt".
;
; The property that makes this bitemporal rather than just a second timestamp:
; a fact superseded by a LATER transaction whose valid window does not cover the
; asked point is STILL current at that point. Valid-time filters BEFORE
; transaction-time supersession, so the old price is visible on the old date.
; The filter lives in db/datoms, so q, pull and entity all honour it.

(ns datom.valid-time.test
  (:require [datom.conn] [datom.db] [datom.time] [datom.pull] [datom.query.engine]))

(defn- priced []
  (let [c (datom.conn/connect
            [{:db/ident :sku :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
             {:db/ident :amt :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}])]
    ; the SKU identity is always-valid (an unbounded tx: no :db.valid/*)
    (datom.conn/transact! c [{:db/id -1 :sku "A"}])
    (let [eid (:db/id (datom.db/entity (datom.conn/db c) [:sku "A"]))]
      ; price 100, valid [1000, 1500)
      (datom.conn/transact! c [{:db/id eid :amt 100}
                               {:db/id :db/current-tx :db.valid/from 1000 :db.valid/to 1500}])
      ; price 120, valid [1500, forever)
      (datom.conn/transact! c [{:db/id eid :amt 120}
                               {:db/id :db/current-tx :db.valid/from 1500}]))
    c))

(defn- amt-at [c t]
  (datom.query.engine/q '[:find ?a . :where [?e :amt ?a]] (datom.time/valid-at (datom.conn/db c) t)))

(deftest valid-at-reads-the-fact-true-at-that-point
  (let [c (priced)]
    (is (= 100 (amt-at c 1200)) "at 1200 the price was 100 (first window [1000,1500))")
    (is (= 120 (amt-at c 1600)) "at 1600 the price is 120 (second window [1500,forever))")
    (is (= 100 (amt-at c 1000)) "the from bound is inclusive")
    (is (= 120 (amt-at c 1500)) "the to bound is exclusive — 1500 belongs to the next window")
    (is (nil? (amt-at c 900)) "before any valid window, nothing is true")))

(deftest a-superseded-fact-is-still-current-at-its-valid-time
  (let [c (priced)]
    ; the CURRENT view (no valid filter) shows only the latest price
    (is (= #{[120]} (datom.query.engine/q '[:find ?a :where [?e :amt ?a]] (datom.conn/db c)))
        "transaction-time-current sees only 120")
    ; but valid-at 1200 still sees 100 — superseded in tx time, current in valid time
    (is (= 100 (amt-at c 1200))
        "the old price is still current AT the old date — the bitemporal property")))

(deftest valid-time-flows-through-pull-and-entity
  (let [c (priced)
        db-at-1200 (datom.time/valid-at (datom.conn/db c) 1200)
        db-at-1600 (datom.time/valid-at (datom.conn/db c) 1600)]
    (is (= 100 (:amt (datom.pull/pull db-at-1200 [:amt] [:sku "A"])))
        "pull honours valid-at (the filter is in db/datoms, not the query engine)")
    (is (= 120 (:amt (datom.pull/pull db-at-1600 [:amt] [:sku "A"])))
        "pull at the later valid time sees the later price")
    (is (= 100 (:amt (datom.db/entity db-at-1200 [:sku "A"])))
        "entity honours valid-at too")))

(deftest valid-between-overlaps-a-range
  (let [c (priced)
        ; a range that touches both windows sees both prices
        both (datom.query.engine/q '[:find ?a :where [?e :amt ?a]]
                                   (datom.time/valid-between (datom.conn/db c) 1200 1700))]
    (is (= #{[100] [120]} both)
        "valid-between [1200,1700] overlaps both windows, so both prices are true somewhere in it")))
