(ns datom.rank-demand-test
  (:require [datom.query.rank-demand :as demand] [data.bounded-cache :as cache]))
(deftest isolated-requests-do-not-buy-an-index
  (let [one (demand/decision nil 1000)
        two (demand/decision one 1001)
        three (demand/decision two 1002)]
    (is (not (:build? one))) (is (not (:build? two))) (is (:build? three))
    (is (= (:expires-at one) (:expires-at three)))
    (is (= demand/MIN-REQUESTS (:requests (demand/decision three 1003))))
    (is (not (:build? (demand/decision three (:expires-at three)))))
    (is (= 1 (:requests (demand/decision three (:expires-at three)))))))
(deftest definitions-and-stores-do-not-share-demand
  (let [key [:demand-test (erlang/unique_integer (list :positive))]]
    (is (not (demand/observe! key :a)))
    (is (not (demand/observe! key :a)))
    (is (not (demand/observe! key :b)))
    (is (not (demand/observe! [key :other-store] :a)))
    (is (demand/observe! key :a))
    (is (not (demand/observe! nil :a)))))
