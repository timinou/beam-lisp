(ns datom.rank-demand-test
 (:require [datom.query.rank-demand :as demand] [data.bounded-cache :as cache]))
(def expensive {:elapsed-us 1000000 :rows 1000 :basis 1})
(defn observations [n sample]
 (reduce (fn [state i] (demand/decision state (+ 1000 i) (sample i))) nil (range n)))
(deftest repeated-requests-without-measured-cost-never-buy-an-index
 (is (not (:build? (observations 1000 (fn [_] nil)))))
 (is (not (:build? (observations 1000 (fn [_] (assoc expensive :elapsed-us 1000))))))
 (is (not (:build? (observations 3 (fn [_] expensive))))))
(deftest measured-expense-and-writes-decide-construction
 (let [paid (observations 120 (fn [_] expensive))
       writes (observations 120 (fn [i] (assoc expensive :basis (* (inc i) 1000))))]
  (is (:build? paid))
  (is (>= (:paid-us paid) (* 2 (:forecast-us paid))))
  (is (not (:build? writes)))
  (let [expired (demand/decision paid (:expires-at paid) expensive)]
   (is (= 1 (:requests expired))) (is (not (:build? expired))))))
(deftest malformed-cost-and-empty-results-decline
 (doseq [sample [nil {:elapsed-us -1 :rows 1 :basis 1}
                 {:elapsed-us 1000000 :rows 0 :basis 1}
                 {:elapsed-us 1000000 :rows 1000000 :basis 1}
                 {:elapsed-us 1000000 :rows 1 :basis -1}]]
  (is (not (:build? (observations 120 (fn [_] sample)))))))
(deftest definitions-and-stores-do-not-share-observed-work
 (let [key [:demand-test (erlang/unique_integer (list :positive))]
       query '[:find ?e :where [?e :x/name ?n]]]
  (demand/watch! key query [] :a)
  (doseq [_ (range 120)] (demand/record-scan! key query [] expensive))
  (is (demand/observe! key :a))
  (is (not (demand/observe! key :b)))
  (is (not (demand/observe! [key :other-store] :a)))
  (is (not (demand/observe! nil :a)))))

(deftest completed-construction-calibrates-future-admission
 (is (= 4 (demand/build-rate 10 3)))
 (is (nil? (demand/build-rate 100 0)))
 (let [sample (assoc expensive :build-us-per-row 1000)
       measured (observations 8 (fn [_] sample))
       forecast (observations 8 (fn [_] expensive))]
  (is (:build? measured))
  (is (not (:build? forecast)))
  (is (= 1000000 (:forecast-us measured)))))
