; test/bl/datom/avet_guard_test.bl — an AVET read must not fail silently.
;
; `datom/datoms db :avet attr v` on an attribute WITHOUT an AVET index used to
; answer an empty seq: the same answer as "no entity has this value". A
; consumer (Backdesk's store layer) shipped a lookup that therefore never
; matched. The public read now raises for an unindexed schema attribute, and
; keeps answering for indexed, unique and ref attributes.

(ns datom.avet-guard.test
  (:require [datom]))

(defn- conn []
  (let [c (datom/connect [{:db/ident :person/name :db/valueType :db.type/string}
                          {:db/ident :person/email :db/valueType :db.type/string :db/unique :db.unique/identity}
                          {:db/ident :person/city :db/valueType :db.type/string :db/index true}])]
    (datom/transact! c [{:db/id -1 :person/name "Ada" :person/email "ada@x" :person/city "Porto"}])
    c))

(deftest an-unindexed-avet-read-raises-naming-the-attribute
  (let [db (datom/db (conn))
        msg (try (datom/datoms db :avet :person/name "Ada") nil
                 (catch e (str e)))]
    (is (some? msg))
    (is (String/contains? (str msg) "person/name"))))

(deftest indexed-and-unique-attributes-still-read
  (let [db (datom/db (conn))]
    (is (= 1 (count (into [] (datom/datoms db :avet :person/email "ada@x")))))
    (is (= 1 (count (into [] (datom/datoms db :avet :person/city "Porto")))))
    (is (= 1 (count (into [] (datom/datoms db :aevt :person/name)))))))

(deftest a-bare-avet-scan-is-unchanged
  ;; no attribute bound: the whole index, as before
  (is (some? (into [] (datom/datoms (datom/db (conn)) :avet)))))
