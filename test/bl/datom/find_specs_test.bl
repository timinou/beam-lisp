; test/bl/datom/find_specs_test.bl — Datomic find specs + :with (PLAN-115 B4).
; Run: bl test test/bl/datom/find_specs_test.bl
;
; A query's `:find` shapes its result. The engine runs the same join for all
; four spellings; only the final projection differs:
;   [?x ?y]     :relation    a SET of tuples (the default)
;   [?x .]      :scalar      one value
;   [[?x ...]]  :collection  a vector of one column
;   [[?x ?y]]   :tuple       one row as a vector
; And `:with` keeps rows an aggregate would otherwise collapse: datalog answers
; are sets, so `(sum ?amt)` over three equal amounts is ONE row (5), while
; `:with ?e` widens the tuple to keep all three (15) — the ADR-162 behaviour and
; a real datom bug fixed here (`:with` was parsed then silently dropped).
; Answers cross-checked against datahike 0.8.1861.

(ns datom.find-specs.test
  (:require [datom.conn] [datom.query.engine]))

(defn- db []
  (let [c (datom.conn/connect
            [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
             {:db/ident :amt  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}])]
    (datom.conn/transact! c [{:db/id -1 :name "a" :amt 5}
                             {:db/id -2 :name "a" :amt 5}
                             {:db/id -3 :name "b" :amt 5}])
    (datom.conn/db c)))

(defn- q [query] (datom.query.engine/q query (db)))

(deftest scalar-find-returns-one-value
  (is (= 5 (q '[:find ?a . :where [?e :name "a"] [?e :amt ?a]]))
      "[?a .] returns the value itself, not a set of one-tuples")
  (is (nil? (q '[:find ?a . :where [?e :name "nope"] [?e :amt ?a]]))
      "an empty scalar result is nil"))

(deftest collection-find-returns-a-vector
  (is (= ["a" "b"] (vec (sort (q '[:find [?n ...] :where [?e :name ?n]]))))
      "[[?n ...]] returns a de-duplicated vector of the column")
  (is (vector? (q '[:find [?n ...] :where [?e :name ?n]]))
      "the collection result is a vector"))

(deftest tuple-find-returns-one-row
  (is (= ["a" 5] (q '[:find [?n ?a] :where [?e :name ?n] [?e :name "a"] [?e :amt ?a]]))
      "[[?n ?a]] returns a single row as a vector"))

(deftest relation-find-returns-a-set
  (is (= #{["a" 5] ["b" 5]} (q '[:find ?n ?a :where [?e :name ?n] [?e :amt ?a]]))
      "the default returns a SET of tuples"))

(deftest with-keeps-duplicate-rows-for-aggregation
  ; set semantics: [?amt] over three 5s is ONE distinct row
  (is (= 5 (q '[:find (sum ?amt) . :where [?e :amt ?amt]]))
      "without :with, (sum ?amt) sums the DISTINCT amounts — one 5")
  ; :with ?e widens the tuple to [?amt ?e], keeping all three rows
  (is (= 15 (q '[:find (sum ?amt) . :with ?e :where [?e :amt ?amt]]))
      "with :with ?e, all three rows survive and the sum is 15"))

(deftest count-groups-correctly-with-a-grouping-variable
  (is (= #{["a" 2] ["b" 1]}
         (q '[:find ?n (count ?e) :where [?e :name ?n]]))
      "(count ?e) groups by ?n: two a's, one b"))
