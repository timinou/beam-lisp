(ns datom.rank-index-test
 (:require [datom :as d] [datom.db :as db] [datom.store :as store]
           [datom.store-ets :as ets-store] [datom.store-fjall :as fjall]
           [datom.query.rank-plan :as plan] [datom.query.rank-index :as rank]))
(def S [{:db/ident :item/scope :db/valueType :db.type/ref}
        {:db/ident :item/order :db/valueType :db.type/long}
        {:db/ident :item/name :db/valueType :db.type/string}])
(def Q '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(def C '[:find (count ?e) . :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(defn prepare [database ident p generation]
 (let [s (db/store-of database)
       initial (rank/fresh ident p (db/basis-t database) generation)]
  (store/-commit s [[:put (rank/header-key ident) initial]])
  (doseq [eid (range 1 97)]
   (let [h (rank/header s ident) ctx (rank/context s h)
         fields (rank/read-fields database eid (:required p))
         next (rank/replace-member s ctx h eid fields)]
    (store/-commit s (rank/publication-ops ctx (:header next) (:ops next)))))
  (let [h (assoc (rank/header s ident) :status :complete)]
   (store/-commit s [[:put (rank/header-key ident) h]]) h)))
(defn exercise [s]
 (let [conn (d/connect-with s S)]
  (try
   (d/transact! conn (mapv (fn [eid] {:db/id eid :item/scope (if (<= eid 80) 7 8)
                                     :item/order (quot eid 5) :item/name (str "item-" eid)}) (range 1 97)))
   (let [database (d/db conn) p (plan/descriptor Q (db/schema-of database) [7] ['?at :asc])
         count-plan (plan/descriptor C (db/schema-of database) [7] nil)
         h (prepare database :rank-fixture p :generation-1)
         expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q database 7))))]
    (is (= 80 (:members h)))
    (is (= (subvec expected 65 75) (:rows (rank/read-page database :rank-fixture p 65 10))))
    (is (= {:status :exact :value 80} (rank/read-count database :rank-fixture count-plan)))
    (is (nil? (rank/read-page (d/as-of database (dec (db/basis-t database))) :rank-fixture p 0 10)))
    ;; An unchanged member must not churn tree nodes or membership records.
    (let [ctx (rank/context s h)
          unchanged (rank/replace-member s ctx h 3 (rank/read-fields database 3 (:required p)))
          delta (data.ranked-tree/changes ctx)]
     (is (= [] (:ops unchanged)))
     (is (empty? (:new delta)))
     (is (empty? (:delete delta)))
     (is (= (:root h) (:root (:header unchanged)))))
    ;; Projection-only writes preserve the key and copy at most one AVL path.
    (d/transact! conn [{:db/id 3 :item/name "projection-updated"}])
    (let [current (d/db conn) old (rank/header s :rank-fixture)
          ctx (rank/context s old)
          height (:height (data.ranked-tree/node ctx (:root old)))
          next (rank/replace-member s ctx old 3 (rank/read-fields current 3 (:required p)))
          delta (data.ranked-tree/changes ctx)
          next-header (assoc (:header next) :through (db/basis-t current))
          expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q current 7))))]
     (is (<= (count (:new delta)) height))
     (is (= 80 (:members next-header)))
     (store/-commit s (rank/publication-ops ctx next-header (:ops next)))
     (is (= (subvec expected 0 10) (:rows (rank/read-page current :rank-fixture p 0 10)))))
    ;; Missing name changes membership even though scope/order still exist.
    (d/transact! conn [[:db/retract 2 :item/name "item-2"]])
    (let [current (d/db conn)]
     (is (nil? (rank/read-page current :rank-fixture p 0 10)))
     (is (nil? (rank/read-count current :rank-fixture count-plan)))
     (let [old (rank/header s :rank-fixture) ctx (rank/context s old)
           next (rank/replace-member s ctx old 2 (rank/read-fields current 2 (:required p)))
           h (assoc (:header next) :through (db/basis-t current))]
      (store/-commit s (rank/publication-ops ctx h (:ops next)))
      (is (= 79 (:value (rank/read-count current :rank-fixture count-plan))))))
    ;; Two replacements in one prepared batch cannot double-count an entity.
    (let [old (rank/header s :rank-fixture) ctx (rank/context s old)
          a (rank/replace-member s ctx old 3 {:item/scope 7 :item/order 0 :item/name "A"})
          b (rank/replace-member s ctx (:header a) 3 {:item/scope 7 :item/order 0 :item/name "B"})]
     (is (= (:members old) (:members (:header b))))
     (is (= (:members old) (data.ranked-tree/size ctx (:root (:header b))))))
    ;; Schema changes cannot certify membership under a different cardinality.
    (is (nil? (rank/read-page (assoc database :schema
                               (assoc-in (db/schema-of database) [:item/name :db/cardinality] :db.cardinality/many))
                              :rank-fixture p 0 10))))
   (finally (d/release! conn)))))
(deftest exact-membership-and-frontier-contract-on-real-storage-ports
 (let [s (ets-store/open)] (try (exercise s) (finally (ets-store/close s))))
 (exercise (fjall/open (store/fresh-path ".rank-index-test"))))
