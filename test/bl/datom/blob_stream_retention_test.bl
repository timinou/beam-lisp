(ns datom.blob-stream-retention-test
 (:require [datom.blob :as blob] [datom.blob-ets :as memory] [datom.file :as file] [datom.store :as store]))
(deftest memory-stream-is-bounded-and-preserves-empty-and-large-content
 (let [bs (memory/open) bytes (String/duplicate "x" 150000) sha (file/sha256 bytes)
       empty (file/sha256 "")]
  (try
   (blob/-blob-put bs sha bytes) (blob/-blob-put bs empty "")
   (is (= bytes (erlang/iolist_to_binary (to-list (blob/stream bs sha)))))
   (is (= [65536 65536 18928] (mapv erlang/byte_size (blob/stream bs sha))))
   (is (= "" (erlang/iolist_to_binary (to-list (blob/stream bs empty)))))
   (is (nil? (blob/stream bs (file/sha256 "absent"))))
   (finally (store/close bs)))))
