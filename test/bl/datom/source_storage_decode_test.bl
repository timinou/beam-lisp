; Exercise actual SDK reads under admitted Source, not a caller-selected mode.
; The owned native runner puts every fresh store below HOME TMPDIR and removes
; its disposable tree after VM exit, when the native resource handles are gone.
(ns datom.source-storage-decode-test
 (:require [reload.generation :as g] [datom.store :as store]
           [datom.store-fjall :as fjall] [datom.value-codec :as codec]))

(defn- prepared []
 (g/prepare!
  {:sources {"storage.source"
    "(ns storage.source (:require [datom.store :as store]))
     (defn read-row [s key kind]
      (case kind
       :point (store/-get s key)
       :range (mapv second (store/-range s key key))
       :scan (store/scan-datoms s key key)
       :prefixes (store/scan-prefixes s [[key key]])
       :page (:datoms (store/page-datoms s key nil key 10))
       :asc (:datoms (store/ordered-page s key nil key 10 :asc))
       :desc (:datoms (store/ordered-page s key nil key 10 :desc))))
     (defn call-raw [f args] (apply f args))"}
   :stable-namespaces #{"datom.store"}}))

(defn- refused? [action]
 (try (action) false (catch _ true)))

(deftest sdk-reads-automatically-admit-packed-and-legacy-plain-data
 (let [generation (prepared) key "source-row"
       row [41 :storage/check {:answer [7 8 9]} 1 true]]
  (try
   (doseq [bytes [(codec/encode-slot row) (erlang/term_to_binary row)]]
    (let [s (fjall/open-fresh)]
     (fjall/fjall-put (:handle s) key bytes)
     (doseq [kind [:point :range :scan :prefixes :page :asc :desc]]
      (is (= (if (= :point kind) row [row])
             (g/invoke! generation "storage.source/read-row" [s key kind]))))))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))

(deftest native-batch-decoders-admit-bounded-compression-without-rewriting-storage
 (let [generation (prepared) key "source-compressed"
       row [42 :storage/check {:payload (binary/copy "x" 4096)} 1 true]
       bytes (erlang/term_to_binary row (list :compressed)) s (fjall/open-fresh)]
  (try
   (is (= 80 (binary/at bytes 1)))
   (fjall/fjall-put (:handle s) key bytes)
   (doseq [kind [:range :scan :prefixes :page :asc :desc]]
    (is (= [row] (g/invoke! generation "storage.source/read-row" [s key kind]))))
   (is (= bytes (fjall/fjall-get (:handle s) key)))
   ;; The separate public BL decoder intentionally refuses compression.
   (is (refused? #(g/invoke! generation "storage.source/read-row" [s key :point])))
   (finally (g/retire! generation)))))

(deftest runtime-capabilities-refuse-before-source-read-results-are-created
 (let [generation (prepared) key "source-opaque"]
  (try
   (doseq [value [(fn [] :native-only) (erlang/make_ref) (erlang/self)]
           encoding [:packed :legacy :compressed]]
    (let [row [43 :storage/check value 1 true]
          bytes (case encoding :packed (codec/encode-slot row)
                               :legacy (erlang/term_to_binary row)
                               :compressed (erlang/term_to_binary row (list :compressed)))
          s (fjall/open-fresh)]
     (fjall/fjall-put (:handle s) key bytes)
     ;; Genuine native readers preserve the established any-term ABI.
     (is (= row (store/-get s key)))
     (is (= [row] (store/scan-datoms s key key)))
     (doseq [kind [:point :range :scan :prefixes :page :asc :desc]]
      (is (refused? #(g/invoke! generation "storage.source/read-row" [s key kind]))))
     (is (= bytes (fjall/fjall-get (:handle s) key)))))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))

(deftest caller-cannot-select-trusted-native-decode-mode-under-source
 (let [generation (prepared) s (fjall/open-fresh)
       raw (erlang/make_fun :Elixir.BeamLisp.Native.Datom.StoreFjall :fjall-resolve-chunk 6)]
  (try
   (is (refused? #(g/invoke! generation "storage.source/call-raw"
       [raw [(:handle s) nil nil nil 1 :datoms]])))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))
