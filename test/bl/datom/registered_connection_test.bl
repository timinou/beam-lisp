(ns datom.registered-connection-test
 (:require [datom :as d] [datom.conn :as conn] [datom.store :as store] [datom.store-fjall :as fjall]
           [datom.profile :as profile] [datom.store-overlay :as overlay]))
(deftest borrowing-never-opens-missing-stores-and-shares-lifetime
 (let [path (str (System/tmp_dir!) "/registered-store-" (System/unique_integer (list :positive)))]
  (is (try (conn/registered-at path) false (catch e (= :store-not-ready (:kind (ex-data e))))))
  (is (not (File/exists? path)))
  (let [c (d/connect-with (fjall/open path)) borrowed (conn/registered-at path)]
   (try
    (is (= (:store c) (:store borrowed)))
    (is (= (:basis c) (:basis borrowed)))
    (is (= (:writer c) (:writer borrowed)))
    (is (= (:lifetime c) (:lifetime borrowed)))
    (is (store/durable? (:store borrowed)))
    (is (= (:store borrowed) (store/sync! (:store borrowed))))
    (let [observed (profile/watch (:store borrowed)) dry-run (overlay/open (:store borrowed))]
     (is (store/durable? observed))
     (is (= observed (store/sync! observed)))
     (is (not (store/durable? dry-run))))
    (d/close! c)
    (is (not (d/alive? borrowed)))
    (is (try (conn/registered-at path) false (catch _ true)))
    (finally (when (d/alive? c) (d/close! c)) (File/rm_rf! path))))))
(deftest volatile-stores-cannot-claim-durable-decisions
 (let [c (d/connect [])]
  (try
   (is (not (store/durable? (:store c))))
   (is (try (store/sync! (:store c)) false (catch e (= :durability-unavailable (:kind (ex-data e))))))
   (finally (d/close! c)))))
