(ns datom.ordered-page-test
  (:require [datom] [datom.conn :as conn] [datom.db :as db]
            [datom.index :as index] [datom.store :as store]
            [datom.store-ets :as ets-store] [datom.store-fjall :as fjall]))

(def schema [{:db/ident :p/order :db/valueType :db.type/long :db/index true}])

(defn check-pages [s]
  (let [c (conn/connect-with s schema)]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :p/order i}) (range 17)))
    (let [lo (index/key-prefix :avet :p/order) hi (index/prefix-end lo)
          full (store/scan-datoms s lo hi)]
      (doseq [direction [:asc :desc] size [1 3 8 17 32]]
        (let [got (loop [after nil out [] rounds 0]
                    (when (> rounds 30) (throw (ex-info "cursor stalled" {})))
                    (let [p (store/ordered-page s lo after hi size direction)]
                      (is (<= (count (:datoms p)) size))
                      (if (:end? p) (into out (:datoms p))
                        (recur (:last p) (into out (:datoms p)) (inc rounds)))))]
          (is (= (if (= direction :desc) (vec (reverse full)) full) got)))))))

(deftest ets-ordered-pages-are-bounded-and-resumable
  (check-pages (ets-store/open)))

(deftest fjall-ordered-pages-are-bounded-and-resumable
  (is (fjall/available?))
  (when (fjall/available?) (check-pages (fjall/open-fresh))))

(deftest byte-admission-precedes-page-publication
  (doseq [s [(ets-store/open) (fjall/open-fresh)]]
    (let [c (conn/connect-with s schema)
          _ (datom/transact! c [{:db/id -1 :p/order 7}])
          lo (index/key-prefix :avet :p/order) hi (index/prefix-end lo)
          p (store/ordered-page s lo nil hi 10 :asc 1)]
      (is (= [] (:datoms p)))
      (is (= true (:byte-limited? p)))
      (is (= false (:end? p)))
      (is (= nil (:last p)))
      (is (<= (:bytes p) 1)))))
