(ns datom.ordered-page-test
  (:require [datom] [datom.conn :as conn] [datom.db :as db]
            [datom.index :as index] [datom.store :as store]
            [datom.value-codec :as value-codec]
            [datom.store-ets :as ets-store] [datom.store-fjall :as fjall]))

(def schema [{:db/ident :p/order :db/valueType :db.type/long :db/index true}])

(defn check-pages [s]
  (let [c (conn/connect-with s schema)]
    (datom/transact! c (mapv (fn [i] {:db/id (- -1 i) :p/order i}) (range 17)))
    (let [lo (index/key-prefix :avet :p/order) hi (index/prefix-end lo)
          full (store/scan-datoms s lo hi)]
      (doseq [direction [:asc :desc] size [1 3 8 17 32]]
        (let [got (loop [after nil out [] rounds 0]
                    (when (> rounds 30) (throw (ex-info "cursor stalled" {})))
                    (let [p (store/ordered-page s lo after hi size direction)]
                      (is (<= (count (:datoms p)) size))
                      (if (:end? p) (into out (:datoms p))
                        (recur (:last p) (into out (:datoms p)) (inc rounds)))))]
          (is (= (if (= direction :desc) (vec (reverse full)) full) got)))))))

(deftest ets-ordered-pages-are-bounded-and-resumable
  (check-pages (ets-store/open)))

(deftest fjall-ordered-pages-are-bounded-and-resumable
  (is (fjall/available?))
  (when (fjall/available?) (check-pages (fjall/open-fresh))))

(deftest byte-admission-precedes-page-publication
  (doseq [s [(ets-store/open) (fjall/open-fresh)]]
    (let [c (conn/connect-with s schema)
          _ (datom/transact! c [{:db/id -1 :p/order 7}])
          lo (index/key-prefix :avet :p/order) hi (index/prefix-end lo)
          p (store/ordered-page s lo nil hi 10 :asc 1)]
      (is (= [] (:datoms p)))
      (is (= true (:byte-limited? p)))
      (is (= false (:end? p)))
      (is (= nil (:last p)))
      (is (<= (:bytes p) 1)))))

(deftest finite-legacy-fjall-rows-page-without-an-application-migration
  (let [s (fjall/open-fresh) d [41 :p/order 7 1 true]
        key (index/key-for :avet d) encoded (erlang/term_to_binary d)
        lo (index/key-prefix :avet :p/order) hi (index/prefix-end lo)]
    (fjall/fjall-put (:handle s) key encoded)
    (let [small (store/ordered-page s lo nil hi 10 :asc 1)
          page (store/ordered-page s lo nil hi 10 :asc)
          reverse (store/ordered-page s lo nil hi 10 :desc)]
      (is (= true (:byte-limited? small)))
      (is (= [] (:datoms small)))
      (is (= [d] (:datoms page)))
      (is (= [d] (:datoms reverse)))
      (is (= true (:end? page)))
      (is (>= (:bytes page) (* 64 (erlang/byte_size encoded))))
      (is (= encoded (fjall/fjall-get (:handle s) key))))
    ;; Charge advertised expansion before inflation, then admit only finite
    ;; decoded shapes. Persisted bytes remain unchanged.
    (let [compressed [41 :p/order (binary/copy "x" 8192) 1 true]
          bytes (erlang/term_to_binary compressed (list :compressed))]
      (is (= 80 (binary/at bytes 1)))
      (fjall/fjall-delete (:handle s) key)
      (fjall/fjall-put (:handle s) (index/key-for :avet compressed) bytes)
      (let [page (store/ordered-page s lo nil hi 10 :asc)
            reverse (store/ordered-page s lo nil hi 10 :desc)
            small (store/ordered-page s lo nil hi 10 :asc 8192)
            plain (erlang/term_to_binary compressed)]
        (is (= [compressed] (:datoms page)))
        (is (= [compressed] (:datoms reverse)))
        (is (= true (:byte-limited? small)))
        (is (= [] (:datoms small)))
        (is (= nil (:last small)))
        (is (>= (:bytes page) (* 64 (erlang/byte_size plain))))
        (is (= bytes (fjall/fjall-get (:handle s) (index/key-for :avet compressed)))))
      (is (= [compressed] (store/scan-datoms s lo hi))))))

(deftest compressed-slot-and-value-escape-lanes-normalize-once
  (let [d [42 :p/order {:blob (binary/copy "z" 8192)} 1 true]
        lo (index/key-prefix :avet :p/order) hi (index/prefix-end lo)
        key (index/key-for :avet d)
        whole (erlang/term_to_binary d (list :compressed))
        packed (value-codec/encode-datom d)
        prefix (+ 20 (binary/at packed 18))
        value (erlang/term_to_binary (nth d 2) (list :compressed))
        slot (erlang/iolist_to_binary (list (erlang/list_to_binary (list 255)) whole))
        escaped (erlang/iolist_to_binary (list (binary/part packed 0 prefix) value))]
    (is (= 255 (binary/at packed (dec prefix))))
    (doseq [bytes [slot escaped]]
      (let [s (fjall/open-fresh)]
        (fjall/fjall-put (:handle s) key bytes)
        (is (= [d] (:datoms (store/ordered-page s lo nil hi 10 :asc))))
        (is (= [d] (:datoms (store/ordered-page s lo nil hi 10 :desc))))
        (is (= [] (:datoms (store/ordered-page s lo nil hi 10 :asc 8192))))
        (is (= bytes (fjall/fjall-get (:handle s) key)))))))
