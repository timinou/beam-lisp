(ns datom.rank-build-test
 (:require [datom :as d] [datom.conn :as conn] [datom.db :as db]
           [datom.store :as store] [datom.store-ets :as ets-store]
           [datom.store-fjall :as fjall] [datom.query.rank-plan :as plan]
           [datom.query.rank-index :as rank] [datom.query.rank-build :as build]))
(def S [{:db/ident :item/scope :db/valueType :db.type/ref}
        {:db/ident :item/order :db/valueType :db.type/long}
        {:db/ident :item/name :db/valueType :db.type/string}])
(def Q '[:find ?e ?at ?name :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(def C '[:find (count ?e) . :in $ ?scope :where [?e :item/scope ?scope]
         [?e :item/order ?at] [?e :item/name ?name]])
(defn finish [c id]
 (loop [n 0]
  (when (>= n 200) (throw {:refused :test-builder-did-not-finish}))
  (let [h (conn/advance-query-rank! c id)]
   (if (= :building (:status h)) (recur (inc n)) h))))
(defn exercise [s]
 (let [c (d/connect-with s S)]
  (try
   (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope (if (<= eid 80) 7 8)
                                  :item/order (quot eid 5) :item/name (str "item-" eid)}) (range 1 97)))
   (let [database (d/db c) p (plan/descriptor Q (db/schema-of database) [7] ['?at :asc])
         cp (plan/descriptor C (db/schema-of database) [7] nil)
         _ (d/q Q database 7)
         id (conn/ensure-query-rank! c p)]
    (is (some? id))
    (is (= :building (:status (rank/header s id))))
    (is (nil? (rank/read-page database id p 65 10)))
    (conn/advance-query-rank! c id)
    ;; Both old and previously absent roots enter the same atomic dirty journal.
    (d/transact! c [[:db/retract 2 :item/name "item-2"]
                    {:db/id 90 :item/scope 7 :item/name "transferred"}
                    {:db/id 100 :item/scope 7 :item/order 19 :item/name "new"}])
    (is (contains? (:dirty (rank/header s id)) 100))
    (is (= :complete (:status (finish c id))))
    (let [current (d/db c)
          expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q current 7))))]
     (is (= 81 (count expected)))
     (is (= (subvec expected 65 75) (:rows (rank/read-page current id p 65 10))))
     (is (= 81 (:value (rank/read-count current id cp)))))
    ;; Completed membership follows the normal source writer automatically.
    (d/transact! c [{:db/id 3 :item/order 99} {:db/id 4 :item/scope 8}])
    (let [current (d/db c)
          expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q current 7))))]
     (is (= 80 (:value (rank/read-count current id cp))))
     (is (= (subvec expected 65 75) (:rows (rank/read-page current id p 65 10)))))
    ;; Bulk loading lacks the expanded normal transaction proof and must refuse.
    (d/load-facts! c [{:db/id 101 :item/scope 7 :item/order 20 :item/name "bulk"}])
    (is (= :aborted (:status (rank/header s id))))
    (is (nil? (rank/read-count (d/db c) id cp)))
    (loop [n 0]
     (when (and (< n 200) (rank/header s id))
      (conn/advance-query-rank! c id) (recur (inc n))))
    (is (nil? (rank/header s id)))
    (is (= [] (build/registry s))))
   (finally (d/release! c)))))
(deftest automatic-membership-stage-and-dirty-replay-on-both-storage-ports
 (let [s (ets-store/open)] (try (exercise s) (finally (ets-store/close s))))
 (exercise (fjall/open (store/fresh-path ".rank-build-test"))))

(deftest dirty-journal-overflow-declines-the-index-and-keeps-the-source-write
 (let [s (ets-store/open) c (d/connect-with s S)]
  (try
   (d/transact! c [{:db/id 1 :item/scope 7 :item/order 1 :item/name "one"}])
   (let [database (d/db c) _ (d/q Q database 7)
         p (plan/descriptor Q (db/schema-of database) [7] ['?at :asc])
         id (conn/ensure-query-rank! c p)
         tx (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope 7 :item/order eid :item/name (str eid)})
                                (range 2 302)))]
    (is (some? (:tx tx)))
    (is (= :aborted (:status (rank/header s id))))
    (is (= :rank-journal-limit (:reason (rank/header s id))))
    (is (= 301 (d/q C (d/db c) 7)))
    (is (= "301" (:item/name (d/entity (d/db c) 301)))))
   (finally (d/release! c) (ets-store/close s)))))


(deftest completed-batched-membership-maintenance-matches-authoritative-query
 (let [s (fjall/open (store/fresh-path ".rank-batch-test")) c (d/connect-with s S)]
  (try
   (d/transact! c (mapv (fn [eid] {:db/id eid :item/scope 7 :item/order eid :item/name (str eid)})
                        (range 1 129)))
   (let [_ (d/q Q (d/db c) 7)
         p (plan/descriptor Q (db/schema-of (d/db c)) [7] ['?at :asc])
         id (conn/ensure-query-rank! c p)]
    (is (= :complete (:status (finish c id))))
    (d/transact! c (mapv (fn [eid] {:db/id eid :item/order (- 1000 eid) :item/name (str "updated-" eid)})
                         (range 1 49)))
    (let [database (d/db c)
          expected (vec (sort-by (fn [r] [(second r) (first r)]) (into [] (d/q Q database 7))))]
     (is (= :complete (:status (rank/header s id))))
     (is (= 128 (count expected)))
     (is (= (subvec expected 90 110) (:rows (rank/read-page database id p 90 20))))))
   (finally (d/close! c)))))

(deftest unrelated-code-publication-keeps-build-evidence
 (build/prepare!)
 (let [before (build/code-stamp)]
  (is (some? before))
  (BeamLisp.Env/intern "unrelated.rank.fixture" "v" 42)
  (is (= before (build/code-stamp)))))

(deftest batch-economics-have-a-finite-row-bound
 (is (= 16 (build/batch-rows {:required [:a :b :c]})))
 (is (= 16 (build/batch-rows {:required (vec (range 64))}))))
