(ns datom.attr-marks-test (:require [datom.attr-marks :as marks]))

(deftest stale-and-malformed-observations-cannot-lower-evidence
  (is (= {:a 5 :b 7} (marks/merge-marks {:a 5 :b 7} {:a 2})))
  (doseq [bad [nil :unknown -1 1.0 "1"]]
    (is (= {:a 5} (marks/merge-marks {:a 5} {:a bad}))))
  (is (= {:a 8 :b 7} (marks/merge-marks {:a 5 :b 7} {:a 8}))))

(deftest generated-joins-are-commutative-associative-and-idempotent
  (doseq [n (range 500)]
    (let [a {:a (mod (* n 3) 11) :b (mod n 7)}
          b {:a (mod n 13) :c n}
          c {:b n :c (mod n 19)}]
      (is (= (marks/merge-marks a b) (marks/merge-marks b a)))
      (is (= (marks/merge-marks (marks/merge-marks a b) c)
             (marks/merge-marks a (marks/merge-marks b c))))
      (is (= a (marks/merge-marks a a))))))
