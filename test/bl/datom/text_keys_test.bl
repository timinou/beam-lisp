(ns datom.text-keys-test
  (:require [datom.index :as index] [datom.text-keys :as native] [vm.native :as capability]))
(def prefix (erlang/list_to_binary (to-list [0 120])))
(defn oracle [ds]
  (mapv (fn [d] [:put (erlang/iolist_to_binary (list prefix (index/key-for :avet d))) d]) ds))
(deftest native-postings-have-byte-identical-keys-and-values
  (doseq [ds [[[1 :note/text "g:abc" 11 true]]
             [[2 :note/text "w:حرية" 12 false] [3 :note/text "g:合同条" 12 true]]
             [[-1 :unicode/属性 "g:a\u0000b" 9007199254740991 true]]
             [[9007199254740992 :note/text "w:large-id" 9007199254740992 false]]]]
    (is (= (oracle ds) (native/ops ds {})))
    (is (= (oracle ds) (native/cached-ops ds)))))
(deftest fallback-and-chunk-boundaries-preserve-every-posting
  (let [ds (mapv (fn [i] [i :note/text (str "w:term" i) 42 (= 0 (mod i 2))]) (range 600))]
    (is (= (oracle ds) (native/ops ds {:force-floor? true})))
    (is (= (oracle ds) (native/ops ds {:chunk-size 17})))
    (is (= [] (native/ops [] {})))))
