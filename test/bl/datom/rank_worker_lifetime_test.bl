(ns datom.rank-worker-lifetime-test
 (:require [datom.query.rank-query :as rank] [reload.generation :as generation]))

(defn- down! [pid]
 (let [monitor (Process/monitor pid)]
  (try (receive [:DOWN seen :process dead _] :when (and (= seen monitor) (= dead pid)) true
         (after 5000 false))
   (finally (Process/demonitor monitor (list :flush))))))
(defn- retired? [graph]
 (loop [left 100]
  (let [status (:status (generation/retire! graph))]
   (if (contains? #{:retired :already-retired} status) true
    (if (zero? left) false (do (Process/sleep 5) (recur (dec left))))))))

(deftest an-unpublished-rank-worker-retains-code-and-requires-its-exact-ticket
 (let [graph (generation/prepare! {:sources {"rank.retention" "(ns rank.retention) (defn answer [] 42)"}})
       jobs (BeamLisp.Env/fetch_exact! "datom.query.rank-query" "jobs")
       worker (BeamLisp.Env/fetch_exact! "datom.query.rank-query" "run-worker")
       ticket (erlang/make_ref)
       _ (jobs)
       pid (generation/with! graph (fn [] (spawn #(worker :lifetime-fixture nil nil ticket))))]
  (try
   (is (every? (fn [module]
                (seq (ets/match_object :beam_lisp_code_leases
                       (tuple (tuple module pid :_) true)))) (:modules graph)))
   (is (= :waiting (:status (generation/retire! graph))))
   (erlang/send pid [:rank-start (erlang/make_ref)])
   (Process/sleep 20)
   (is (Process/alive? pid))
   ;; Invalid build input is caught only AFTER the actual scheduler ticket is
   ;; published. Before it, no database operation is admitted at all.
   (erlang/send pid [:rank-start ticket])
   (is (down! pid))
   (is (retired? graph))
   (is (empty? (ets/lookup rank/JOBS :lifetime-fixture)))
   (finally (erlang/exit pid :kill) (generation/retire! graph)))))
