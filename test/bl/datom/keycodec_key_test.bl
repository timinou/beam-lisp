; test/bl/datom/keycodec_key_test.bl — the native WHOLE-key build is identical.
; Run: mix beam_lisp.test test/bl/datom/keycodec_key_test.bl
;
; keycodec-key builds a full index key (idx-tag ++ concat of encoded components)
; in Rust, one BEAM crossing per key. It must be byte-identical to
; datom.index/key-for across all four indexes and every datom shape a codebase
; fact produces — a key that differs sorts wrong and corrupts the index. This is
; that oracle check on real datom components (int e/tx, keyword a, str/int/bool v,
; bool op).

(ns datom.keycodec-key.test
  (:require [datom.store-fjall :as fj] [datom.index :as idx]))

;; Classify a datom component into the NIF's {lane ival sval bval} tuple.
(defn- classify [x]
  (cond
    (erlang/is_integer x) (erlang/list_to_tuple (to-list [:int x "" false]))
    (erlang/is_binary x)  (erlang/list_to_tuple (to-list [:str 0 x false]))
    (or (= x true) (= x false))
                 (erlang/list_to_tuple (to-list [:boolean 0 "" x]))
    (erlang/is_atom x)    (erlang/list_to_tuple
                   (to-list [:kw 0 (erlang/atom_to_binary x :utf8) false]))
    :else        (erlang/list_to_tuple (to-list [:other 0 "" false]))))

(def IDX-TAG {:eavt 1 :aevt 2 :avet 3 :vaet 4})

(defn- native-key [index d]
  (let [comps (mapv classify (idx/index-components index d))]
    (fj/keycodec-key (get IDX-TAG index) (to-list comps))))

;; Real codebase-shaped datoms: [e a v tx op].
(def datoms
  [[1000 :fn/name "ast-node" 7000 true]
   [1000 :fn/arity 2 7000 true]
   [1000 :fn/variadic false 7000 true]
   [100000 :call/caller "<top>" 7001 true]
   [100000 :call/callee "erlang/binary_to_atom" 7001 true]
   [100000 :call/arity 1 7001 true]
   [500 :fn/name "x" 7002 false]          ; a retraction (op false)
   [42 :fn/line 44 7000 true]])

(deftest native-key-equals-key-for-across-all-indexes
  (doseq [d datoms]
    (doseq [index [:eavt :aevt :avet :vaet]]
      (is (= (idx/key-for index d) (native-key index d))
          (str index " key for " (pr-str d) " native == key-for")))))

;; The value slot in these datoms spans int, string, keyword, bool — every one
;; a native lane — so no key should decline. If one returns nil the native path
;; silently disagreed about lane coverage.
(deftest no-codebase-datom-declines
  (doseq [d datoms]
    (doseq [index [:eavt :aevt :avet :vaet]]
      (is (some? (native-key index d))
          (str index " key for " (pr-str d) " is fully native (not nil)")))))
