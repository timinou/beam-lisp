(ns datom.observer-lifetime-test
 (:require [datom] [datom.conn :as conn] [datom.store-ets :as store] [proc.callback :as callback]))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))
(defn- closing! [connection]
 (loop [left 1000]
  (if (= :closing @(:lifetime connection)) :closing
   (if (zero? left) (throw "observer fixture did not enter closing")
    (do (Process/sleep 1) (recur (dec left)))))))

(deftest canceled-drain-ticket-is-not-completion-until-exact-observer-exits
 (let [s (store/open) c (datom/connect-with s) parent (erlang/self) calls (atom 0)
       observer (spawn
                 (fn []
                  (let [stop (callback/register! (fn [_] (swap! calls inc) :not-complete))
                        ticket (conn/register-observer! c stop)]
                   (try
                    (callback/unregister! stop)
                    (erlang/send parent [:observer-canceled (erlang/self)])
                    (receive :finish nil)
                    (finally (conn/unregister-observer! c ticket) (callback/unregister! stop))))))]
  (try
   (receive [:observer-canceled seen] :when (= seen observer) :ready
     (after 5000 (throw "observer cancellation did not arm")))
   (let [closer (spawn (fn []
                         (try (datom/release! c) (erlang/send parent [:closed (erlang/self)])
                          (catch e (erlang/send parent [:close-failed (erlang/self) e])))))]
    (try
     (is (= :closing (closing! c)))
     (is (Process/alive? closer))
     (is (Process/alive? (:writer c)))
     (is (zero? @calls))
     (erlang/send observer :finish)
     (receive
      [:closed seen] :when (= seen closer) (is true)
      [:close-failed seen error] :when (= seen closer) (throw error)
      (after 5000 (throw "observer close did not acknowledge exact DOWN")))
     (is (= :closed @(:lifetime c)))
     (is (not (Process/alive? observer)))
     (finally (when (Process/alive? observer) (erlang/send observer :finish)))))
   (finally
    (when (Process/alive? observer) (erlang/send observer :finish))
    (datom/release! c) (store/close s)))))

(deftest failed-observer-drain-preserves-closing-resource-for-explicit-retry
 (let [s (store/open) c (datom/connect-with s) parent (erlang/self)
       observer (spawn
                 (fn []
                  (let [stop (callback/register! (fn [_] (throw (ex-info "synthetic uncertain stop" {:kind :synthetic-drain}))))
                        ticket (conn/register-observer! c stop)]
                   (try
                    (erlang/send parent [:observer-ready (erlang/self)])
                    (receive :finish nil)
                    (finally (conn/unregister-observer! c ticket) (callback/unregister! stop))))))]
  (try
   (receive [:observer-ready seen] :when (= seen observer) :ready
     (after 5000 (throw "observer did not arm")))
   (let [registry (erlang/whereis conn/REGISTRY)]
    (is (= :connection-observers-draining (kind #(datom/release! c))))
    (is (= :closing @(:lifetime c)))
    (is (Process/alive? (:writer c)))
    (is (= registry (erlang/whereis conn/REGISTRY)))
    (is (thrown? (datom/transact! c [{:db/id 1 :db/doc "cannot enter closing source"}]))))
   (let [watch (Process/monitor observer)]
    (erlang/send observer :finish)
    (receive [:DOWN seen :process pid _] :when (and (= seen watch) (= pid observer)) :done
     (after 5000 (throw "observer did not finish")))
    (Process/demonitor watch (list :flush)))
   (is (= :ok (datom/release! c)))
   (is (= :closed @(:lifetime c)))
   (finally
    (when (Process/alive? observer) (erlang/send observer :finish))
    (datom/release! c) (store/close s)))))
