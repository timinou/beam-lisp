(ns datom.cache-ownership-test
 (:require [datom :as d] [datom.store :as store] [datom.store-map :as memory]
           [datom.store-fjall :as fjall] [datom.store-overlay :as overlay]
           [datom.attr-basis :as marks] [datom.query.corpus :as corpus]
           [datom.vector :as vector] [data.bounded-cache :as cache] [env] [diagnostics :as diag]))

(defrecord OpaqueStore [inner owner]
 store/Store
 (-get [s k] (store/-get (:inner s) k))
 (-range [s lo hi] (store/-range (:inner s) lo hi))
 (-put [s k v] (store/-put (:inner s) k v) s)
 (-delete [s k] (store/-delete (:inner s) k) s)
 (-update [s k f] (let [[_ value] (store/-update (:inner s) k f)] [s value]))
 (-commit [s ops] (store/-commit (:inner s) ops) s))

(deftest typed-store-keys-share-wrappers-and-decline-opaque-identities
 (let [a (memory/open) b (memory/open)]
  (is (= (store/cache-key a) (store/cache-key (overlay/open a))))
  (is (not= (store/cache-key a) (store/cache-key b)))
  (is (some? (cache/footprint (store/cache-key a))))
  (is (nil? (store/cache-key {:opaque (erlang/self)})))
  (is (nil? (store/cache-key {:opaque (fn [] :opaque)})))))

(deftest releasing-one-store-preserves-another-stores-durable-hydration
 (let [a (memory/open) b (memory/open)]
  (store/-commit a (marks/record-ops a [:owned] 11))
  (store/-commit b (marks/record-ops b [:owned] 22))
  (is (= 11 (marks/basis-t-for a :owned 0)))
  (is (= 22 (marks/basis-t-for b :owned 0)))
  (marks/release-store! a)
  (is (= 11 (marks/basis-t-for a :owned 0)))
  (is (= 22 (marks/basis-t-for b :owned 0)))
  (is (every? (fn [row] (some? (cache/footprint (elem row 0))))
               (ets/tab2list :datom_attr_basis)))))

(def SCHEMA [{:db/ident :vec :db/valueType :db.type/vector}])
(defn populate [c]
 (d/transact! c [{:db/id -1 :vec (vector/embedding [1.0 0.0])}])
 (corpus/column (d/db c) :vec))

(deftest unsupported-identities-read-durable-marks-and-never-share-corpus-rows
 (corpus/forget!)
 (let [a (->OpaqueStore (memory/open) (erlang/self))
       b (->OpaqueStore (memory/open) (erlang/self))
       ca (d/connect-with a SCHEMA) cb (d/connect-with b SCHEMA)]
  (try
   (is (nil? (store/cache-key a)))
   (store/-commit a (marks/record-ops a [:owned] 11))
   (store/-commit b (marks/record-ops b [:owned] 22))
   (is (= 11 (marks/basis-t-for a :owned 0)))
   (is (= 22 (marks/basis-t-for b :owned 0)))
   (populate ca)
   (d/transact! cb [{:db/id -1 :vec (vector/embedding [0.0 1.0])}
                   {:db/id -2 :vec (vector/embedding [0.5 0.5])}])
   (is (= 1 (count (corpus/column (d/db ca) :vec))))
   (is (= 2 (count (corpus/column (d/db cb) :vec))))
   (is (= 0 (:columns (corpus/stats))))
   (finally (d/release! ca) (d/release! cb)))))

(defn os-lock-available? [path]
 ;; Fjall shares weak claims inside one OS process. Another process must
 ;; probe the actual directory flock; same-VM open is not a release oracle.
 (let [script (str "import os,sys,fcntl\n"
                   "fd=os.open(sys.argv[1],os.O_RDONLY)\n"
                   "try:\n fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)\n"
                   "except BlockingIOError:\n sys.exit(73)\n")
       result (System/cmd "python3" (to-list ["-c" script path])
                          (list (tuple :stderr_to_stdout true)))
       status (elem result 1)]
  (when (not (contains? #{0 73} status)) (throw {:probe-failed result}))
  (= 0 status)))

(defn await-unlocked [path attempts]
 (erlang/garbage_collect)
 (if (os-lock-available? path) true
  (if (zero? attempts) false
   (do (Process/sleep 50) (await-unlocked path (dec attempts))))))

(defn reopen [path attempts]
 (try (let [s (fjall/open path) marker (:vec (marks/durable-marks-of s))]
        (store/close s) (some? marker))
      (catch e (if (zero? attempts) (do (println "native-cache-reopen-refused" e) false)
                  (do (erlang/garbage_collect) (Process/sleep 50)
                      (reopen path (dec attempts)))))))

(deftest global-derived-caches-do-not-pin-a-released-native-database
 ;; The parent owns both named tables and remains alive. A dead writer cannot
 ;; make this pass by deleting the global cache table and its leaked key.
 (let [_ (marks/hydrate! (memory/open))
       sentinel (d/connect SCHEMA) path (store/fresh-path ".cache-ownership")
       parent (erlang/self) token (env/capture)]
  (try
   (marks/hydrate! (:store sentinel))
   (populate sentinel)
   (let [child (erlang/spawn
                (fn []
                 (env/bind token)
                 (try
                  (let [s (fjall/open path) c (d/connect-with s SCHEMA) released (atom false)]
                   (try
                    ;; This sink captures a native store. Reusable registry
                    ;; actions must restore their context, not retain the sink.
                    (diag/with-options {:sink (fn [_] (store/identity-of s))}
                     (populate c)
                     (d/release! c)
                     (reset! released true))
                    (finally (when (not @released) (d/release! c)) (store/close s))))
                  (erlang/send parent [:cache-child :populated])
                  (catch e (println "native-cache-child-failed" e)
                           (erlang/send parent [:cache-child :failed])))))
         monitor (erlang/monitor :process child)]
    (try
     (is (= :populated (receive [:cache-child status] status (after 10000 :timeout))))
     (is (= :normal (receive [:DOWN ref :process pid why] why (after 10000 :timeout))))
     (is (Process/alive? (ets/info :datom_corpus_cache :owner)))
     (is (Process/alive? (ets/info :datom_attr_basis :owner)))
     (is (every? (fn [row] (some? (cache/footprint (elem row 0))))
                  (ets/tab2list :datom_corpus_cache)))
     (is (await-unlocked path 40) "another OS process can acquire the directory lock")
     (is (reopen path 40) "a released database is reopenable while both caches survive")
     (finally
      (when (Process/alive? child) (Process/exit child :kill))
      (erlang/demonitor monitor (list :flush)))))
   (finally (d/close! sentinel) (File/rm_rf! path) (File/rm_rf! (str path ".blobs"))))))
