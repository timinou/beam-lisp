(ns datom.text-mixed-format-test
  (:require [datom] [datom.db :as db] [datom.index :as index] [datom.store :as store]
            [datom.store-fjall :as fjall] [datom.text :as text]))
(def schema [{:db/ident :note/text :db/valueType :db.type/string :db/fulltext true}])
(deftest legacy-full-values-and-compact-deltas-coexist-across-reopen
  (let [raw (fjall/open-fresh) path (:path raw) c (datom/connect-with raw schema)
        tx (datom/transact! c [{:db/id -1 :note/text "Liberté freedom"}])
        e (get (:tempids tx) -1) old (datom/db c) t (db/basis-t old)
        prefix (erlang/list_to_binary (list 0 120))]
    (try
      ;; Recreate the exact legacy private payload, while retaining its unchanged key.
      (store/-commit raw
        (mapv (fn [term] (let [d [e :note/text term t true]]
                          [:put (erlang/iolist_to_binary (list prefix (index/key-for :avet d))) d]))
              (text/index-terms-original "Liberté freedom")))
      (is (= #{e} (:eids (text/candidates (datom/db c) :note/text "liberte" {}))))
      (datom/transact! c [[:db/add e :note/text "LIBERTE freedom"]])
      (datom/transact! c [[:db/add e :note/text "freedom contract"]])
      (is (empty? (:eids (text/candidates (datom/db c) :note/text "liberte" {}))))
      (is (= #{e} (:eids (text/candidates old :note/text "liberte" {}))))
      (datom/close! c)
      (let [reopened (datom/connect-with (fjall/open path) schema)]
        (try
          (is (= #{e} (:eids (text/candidates (datom/db reopened) :note/text "freedom" {}))))
          (datom/transact! reopened [[:db/retractEntity e]])
          (is (empty? (:eids (text/candidates (datom/db reopened) :note/text "freedom" {}))))
          (finally (datom/close! reopened))))
      (finally (datom/close! c) (File/rm_rf! path)))))
