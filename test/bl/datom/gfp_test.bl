; test/bl/datom/gfp_test.bl — the greatest-fixpoint engine primitive (P23).
;
; derive-semi-naive computes a LEAST fixpoint (grow from empty). derive-gfp is
; its dual — seed full, shrink to the largest stable subset, with the same
; semi-naive delta (a tuple newly falls only if a dependency fell last round).
; The greatest fixpoint now lives IN the engine, beside the least.

(ns datom.gfp-test
  (:require [datom.query.rules :as rules]))

; ── the driver shrinks to the largest stable set ─────────────────────────

(deftest gfp-keeps-the-stable-subset
  (let [r (rules/materialise-gfp #{1 2 3 4 5 6} (fn [t s] (= 0 (mod t 2))) (fn [t fell] true))]
    (is (= #{2 4 6} r) "keeps the evens; the odds fall")))

(deftest gfp-empty-and-full-extremes
  (is (= #{} (rules/materialise-gfp #{1 2 3} (fn [t s] false))) "all fall → empty")
  (is (= #{1 2 3} (rules/materialise-gfp #{1 2 3} (fn [t s] true))) "none fall → seed"))

; mutual dependence: 1 needs 2, 2 needs 1, 3 needs missing 9 → {1 2}
(deftest gfp-mutual-support
  (let [needs {1 2, 2 1, 3 9}
        r (rules/materialise-gfp #{1 2 3} (fn [t s] (contains? s (get needs t))))]
    (is (= #{1 2} r) "3 falls (needs 9); 1 and 2 mutually support")))

; ── the semi-naive delta does provably less work ─────────────────────────

(deftest gfp-delta-fewer-checks-same-answer
  (let [succ {0 [1] 1 [2] 2 [3] 3 [] 4 [3]}
        surv? (fn [s S] (and (not (= s 3)) (every? (fn [n] (contains? S n)) (get succ s []))))
        naive (rules/derive-gfp #{0 1 2 3 4} surv? (fn [t fell] true))
        delta (rules/derive-gfp #{0 1 2 3 4} surv?
                (fn [t fell] (some (fn [n] (contains? fell n)) (get succ t []))))]
    (is (= (:relation naive) (:relation delta)) "delta reaches the same fixpoint as full re-scan")
    (is (<= (:checks delta) (:checks naive)) "and does no more work (typically less)")))

; ── it IS the dual of the least fixpoint: safe-region over a graph ───────

(deftest gfp-computes-ctl-safe-region
  (let [succ {0 [1] 1 [2] 2 [3] 3 [0] 4 [2 5] 5 []}
        safe (rules/materialise-gfp #{0 1 2 3 4 5}
               (fn [s S] (and (not (= s 5)) (every? (fn [n] (contains? S n)) (get succ s []))))
               (fn [t fell] (some (fn [n] (contains? fell n)) (get succ t []))))]
    (is (= #{0 1 2 3} safe) "the 0-3 cycle is safe; 4 reaches the fault 5; 5 is bad")))
