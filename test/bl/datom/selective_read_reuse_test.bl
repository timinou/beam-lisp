(ns datom.selective-read-reuse.test
  (:require [datom :as d] [datom.db] [datom.store :as store]
            [datom.store-fjall :as fjall] [datom.profile :as profile]
            [datom.query.corpus :as corpus] [datom.attr-basis :as marks]
            [datom.vector :as v] [datom.derived :as derived]))

(defn- fixture []
  (let [s (profile/watch (fjall/open-fresh))]
    [(d/connect-with s [{:db/ident :vec :db/valueType :db.type/vector}
                       {:db/ident :tag :db/valueType :db.type/string}]) s]))

(defn- restart! [] (corpus/forget!) (marks/forget!))
(defn- rows-read [s] (get (profile/counters s) :rows 0))
(def QUERY '[:find ?e ?score :in $ ?q :where [(similar-to :vec ?q 2 0) [?e ?score]]])

(deftest ordinary-query-reuses-the-column-after-an-unrelated-write
  (restart!)
  (let [[c s] (fixture)
        q (v/embedding [1.0 0.0])]
    (d/transact! c [{:db/id -1 :vec q} {:db/id -2 :vec (v/embedding [0.0 1.0])}])
    (let [before (d/q QUERY (d/db c) q)]
      (d/transact! c [{:db/id -3 :tag "unrelated"}])
      (profile/reset! s)
      (is (= before (d/q QUERY (d/db c) q)))
      (is (= 0 (rows-read s)) "an ordinary query rebuilds no embedding rows")
      (println "selective-query-reuse" {:rows (rows-read s) :hits (count before)}))))

(deftest durable-artifacts-never-answer-from-a-future-basis
  (doseq [read [corpus/packed corpus/resident]]
    (restart!)
    (let [[c s] (fixture)]
      (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0])}])
      (let [old (d/db c)]
        (d/transact! c [{:db/id -2 :vec (v/embedding [0.0 1.0])}])
        (is (= 2 (:n (read (d/db c) :vec))))
        (restart!)
        (profile/reset! s)
        (is (= 1 (:n (read old :vec))))
        (is (> (rows-read s) 0) "a newer durable pointer is refused, not stamped as history")))))

(deftest restricted-views-do-not-publish-a-complete-column-artifact
  (restart!)
  (let [[c s] (fixture)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0])}])
    (let [cut (d/basis-t (d/db c))]
      (d/transact! c [{:db/id -2 :vec (v/embedding [0.0 1.0])}])
      (let [db (d/db c)
            full (corpus/packed db :vec)
            ident [:datom.corpus :vec :packed]
            pointer (:pointer (derived/load db ident))]
        (is (= 2 (:n full)))
        (is (= 1 (:n (corpus/packed (d/since db cut) :vec))))
        (is (= pointer (:pointer (derived/load db ident)))
            "a since-view cannot replace a complete durable projection")
        (profile/reset! s)
        (is (= 2 (:n (corpus/packed db :vec))))
        (is (= 0 (rows-read s)) "a restricted read leaves the ordinary warm slot intact")
        (restart!)
        (profile/reset! s)
        (is (= 2 (:n (corpus/packed db :vec))))
        (is (= 0 (rows-read s)) "the intact full artifact restores without a column scan")))))

(deftest legacy-unscoped-pointer-is-a-cache-miss
  (restart!)
  (let [[c s] (fixture)]
    (d/transact! c [{:db/id -1 :vec (v/embedding [1.0 0.0])}])
    (let [db (d/db c) ident [:datom.corpus :vec :packed]]
      (corpus/packed db :vec)
      (let [hit (derived/load db ident)]
        (derived/save! db ident (:parts hit)
          {:basis (:basis-t (:pointer hit)) :meta (dissoc (:meta (:pointer hit)) :view)}))
      (restart!)
      (profile/reset! s)
      (is (= 1 (:n (corpus/packed db :vec))))
      (is (> (rows-read s) 0) "missing view authority causes a rebuild")
      (is (contains? (:meta (:pointer (derived/load db ident))) :view)))))

(deftest valid-time-corpus-reads-use-the-requested-world
  (restart!)
  (let [[c _] (fixture)]
    (d/transact! c [{:db/id -1 :tag "entity"}])
    (let [eid (get (first (d/q '[:find ?e :where [?e :tag "entity"]] (d/db c))) 0)]
      (d/transact! c [{:db/id eid :vec (v/embedding [1.0 0.0])}
                      {:db/id :db/current-tx :db.valid/from 1000 :db.valid/to 1500}])
      (d/transact! c [{:db/id eid :vec (v/embedding [0.0 1.0])}
                      {:db/id :db/current-tx :db.valid/from 1500}])
      (let [db (d/db c)
            at-old (d/valid-at db 1200) at-new (d/valid-at db 1600)
            old (corpus/column at-old :vec)
            new (corpus/column at-new :vec)]
        (is (= 1 (count old)))
        (is (= 1 (count new)))
        (is (not= (get (first old) 1) (get (first new) 1)))
        (is (= old (corpus/column at-old :vec)) "warm reads do not substitute a different valid-time slice")))))
