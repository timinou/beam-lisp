(ns datom.corpus-cold-table-test
  (:require [datom :as d] [datom.db] [datom.store] [datom.store-fjall]
            [datom.profile :as profile] [datom.query.corpus :as corpus]
            [datom.vector :as v] [datom.attr-basis :as marks]))

(deftest the-first-read-in-a-vm-restores-durable-evidence
  (let [store (profile/watch (datom.store-fjall/open-fresh))
        c (d/connect-with store [{:db/ident :vec :db/valueType :db.type/vector}])]
    (d/transact! c [{:db/id -1 :vec (v/embedding [0.0 0.0 1.0])}])
    (let [db (d/db c) basis (datom.db/basis-t db)]
      (corpus/resident db :vec)
      (corpus/forget!)
      ;; Emptying the table misses this bug: a real restart has no ETS table.
      (ets/delete :datom_attr_basis)
      (is (= :undefined (ets/info :datom_attr_basis)))
      (profile/reset! store)
      (is (= basis (marks/basis-t-for store :vec 0)))
      (is (= 1 (v/resident-count (corpus/resident db :vec))))
      (is (= 0 (:rows (profile/counters store)))
          "first restoration scans no vector rows"))))
