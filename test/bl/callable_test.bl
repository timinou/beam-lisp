; callable_test.bl — what happens when you call something that is not a function.
; Run: mix beam_lisp.test test/bl/callable_test.bl
;
; ── The mistake this suite is about ─────────────────────────────────────────
;
; `(count (code.semantic/sigs))` is a typo a person makes: one paren too many,
; so the map is CALLED instead of passed. In Clojure a map is a function of its
; keys, which is why the extra paren is invisible on the page — the shape looks
; like every other call.
;
; What the caller got for it was:
;
;   ** (FunctionClauseError) no function clause matching in BeamLisp.RT.invoke/2
;
; which names the runtime function, not the map; says nothing about the arity;
; and points at a file the author has never heard of. Worse, the failure
; travelled as a bare struct, so a `catch` around it died printing it, and the
; error a reader finally saw was about `Enumerable`.
;
; ── The contract ────────────────────────────────────────────────────────────
;
; A call that cannot work says so, in a sentence, with the value and the arity
; in it:
;
;   a map called with 0 arguments — a map is a function of its keys: ({:a 1} :a)
;
; Three properties make that sentence worth its keep, and each is pinned below:
;
;   1. it NAMES the value (`{:a 1}`) and the arity — the two things the author
;      has to change;
;   2. it is CATCHABLE and PRINTABLE — `(str e)` in a handler gives the
;      sentence, so a program can report its own mistake;
;   3. it is the SAME SENTENCE wherever it is caught. `invoke/2` raises it at
;      runtime and the compiler raises it at compile time, because a reader who
;      meets the error twice should not have to learn it twice.

(ns callable.test)

; Bindings, not literals: a literal head is rejected at COMPILE time (see the
; last test), so these reach the runtime path on purpose.

(def a-number 7)
(def a-float 2.5)
(def a-string "abc")
(def nothing nil)
(def a-boolean true)
(def a-keyword :a)
(def a-map {:a 1})
(def a-vector [10 20])
(def a-set (set [1 2]))
(def a-fn (fn [x] x))

; ── not callable at all ─────────────────────────────────────────────────────

(deftest a-number-is-not-callable
  (is (thrown-with-msg? "cannot call 7" (a-number 1)))
  (is (thrown-with-msg? "a number is not a function" (a-number 1)))
  (is (thrown-with-msg? "cannot call 2.5" (a-float 1))))

(deftest a-string-is-not-callable
  (is (thrown-with-msg? "a string is not a function" (a-string 0))))

(deftest nil-is-not-callable
  ; The most common call mistake in any Lisp: a name that was never bound.
  (is (thrown-with-msg? "cannot call nil" (nothing 1)))
  (is (thrown-with-msg? "is not a function" (nothing 1))))

(deftest a-boolean-is-not-callable
  (is (thrown-with-msg? "a boolean is not a function" (a-boolean 1))))

; ── callable, with the wrong number of arguments ────────────────────────────

(deftest a-map-takes-one-or-two-arguments
  (is (thrown-with-msg? "a map called with 0 arguments" (a-map)))
  (is (thrown-with-msg? "a map called with 3 arguments" (a-map :a 1 2)))
  (is (= 1 (a-map :a)))
  (is (= :none (a-map :b :none))))

(deftest a-vector-takes-exactly-its-index
  (is (thrown-with-msg? "a vector called with 2 arguments" (a-vector 0 1)))
  (is (= 10 (a-vector 0))))

(deftest a-set-takes-one-or-two-arguments
  (is (thrown-with-msg? "a set called with 0 arguments" (a-set)))
  (is (thrown-with-msg? "a set called with 3 arguments" (a-set 1 2 3))))

(deftest a-keyword-takes-one-or-two-arguments
  ; Through a BINDING on purpose: `(:a)` in source is refused by the compiler
  ; (see the literal-head tests), so this reaches the runtime path.
  (is (thrown-with-msg? "a keyword called with 0 arguments" (a-keyword)))
  (is (thrown-with-msg? "a keyword called with 3 arguments" (a-keyword a-map 1 2)))
  (is (= 1 (:a a-map))))

(def a-multi (fn ([] 0) ([a] a) ([a b] 1)))
(def a-variadic (fn [a & more] a))

(deftest a-single-arity-fn-is-the-beams-own-error
  ; A plain fn's wrong arity is the ONE call mistake that needs no help: the
  ; BEAM names both arities and the arguments that were passed. `invoke/2`
  ; keeps its fast path here rather than checking the arity on every call to
  ; replace a message that is already right — so this test pins the BEAM's
  ; wording deliberately, as the contract being RELIED on.
  (is (thrown-with-msg? "with arity 1 called with 2 arguments" (a-fn 1 2)))
  (is (= 5 (a-fn 5))))

(deftest a-multi-arity-fn-says-which-arities-it-takes
  ; An arity-dispatched fn is ONE value to the BEAM, so only the language
  ; knows which arities it answers. `wrong number of args (3)` named neither
  ; the fn nor what it wanted.
  (is (thrown-with-msg? "a fn of 0/1/2 arguments" (a-multi 1 2 3)))
  (is (thrown-with-msg? "taking 1 or more arguments" (a-variadic)))
  (is (= 0 (a-multi)))
  (is (= 7 (a-variadic 7))))

; ── the message is a value a program can use ───────────────────────────────

(deftest the-message-is-catchable-and-printable
  ; The whole point: a program that makes this mistake can still REPORT it.
  ; Before the printer fix, this `catch` died rendering the error it caught.
  (let [reported (try
                   (a-map)
                   (catch e (str e)))]
    (is (string? reported))
    (is (includes? reported "a map called with 0 arguments"))
    (is (includes? reported "{:a 1}") "the message shows WHICH map")))

(deftest a-caught-call-error-keeps-the-map-in-the-sentence
  (is (includes? (try (a-vector 0 1) (catch e (str e))) "[10 20]")))

; ── callability is ONE question, asked in one place ────────────────────────
;
; The compiler decides between invoking a LOCAL binding and calling a linked
; global of the same name by asking `invocable?` whether the local's value can
; take this many arguments. That predicate and `invoke/2`'s clause list are two
; descriptions of one question, and they DISAGREE today: `invoke/2` calls a
; map, a set, a vector and a sorted collection, while `invocable?` answers
; false for all four.
;
; The disagreement is not cosmetic. Making the predicate agree — which is the
; obvious fix — changes the dispatch at every call site in the language where a
; local shadows a linked global, and 17 suites came apart when it was tried:
; a local map named after a `core` fn stops being a global call and becomes a
; lookup, in code that was written against the current answer. It is a cutover
; with call sites to audit, not a one-line correction, so it is recorded as
; FUP-032 with the evidence rather than smuggled in beside an error message.
;
; What the tests below pin is the part that is safe: a value that cannot be
; called AT ALL now says so, and the sentence is the same one at both layers.

; ── the same sentence, one layer earlier ───────────────────────────────────

(def f a-fn)
(def nothing-here nil)

(defn- eval-error
  "Evaluate `src` and report WHICH LAYER refused it: `:compile` for a reader
   or compiler rejection, `:runtime` for one that only a running program can
   see, `:none` for a program that ran. The layer is the property under test —
   an error that arrives at runtime when a literal head made it knowable at
   compile time is a compiler that did not do its job."
  [src]
  (try
    (do (BeamLisp/eval src) {:layer :none})
    (catch BeamLisp.CompileError e {:layer :compile :message (ex-message e)})
    (catch e {:layer :runtime :message (ex-message e)})))

(deftest a-literal-head-is-rejected-at-compile-time
  ; A head the compiler can READ needs no runtime at all: `(7 1)` is wrong
  ; before the program runs, and saying so then is what a compiler is for.
  ; The wording is the runtime's wording — one story about one mistake.
  (let [r (eval-error "(ns callable.bad1)\n(7 1)")]
    (is (= :compile (:layer r)) "a scalar head is a COMPILE error")
    (is (includes? (:message r) "cannot call 7")))
  (is (= :compile (:layer (eval-error "(ns callable.bad2)\n(\"s\" 0)"))))
  (is (= :compile (:layer (eval-error "(ns callable.bad3)\n(nil 1)")))))

(deftest a-literal-callable-head-is-arity-checked-at-compile-time
  ; `({:a 1})` is as wrong as `(7 1)` and as readable.
  (let [r (eval-error "(ns callable.bad4)\n({:a 1})")]
    (is (= :compile (:layer r)))
    (is (includes? (:message r) "a map called with 0 arguments")))
  (is (= :compile (:layer (eval-error "(ns callable.bad5)\n([1 2] 0 1)"))))
  (is (= :compile (:layer (eval-error "(ns callable.bad7)\n(:a)")))))

(deftest a-computed-head-that-is-not-callable-is-a-runtime-error
  ; The compiler cannot know what a variable holds, so this one correctly
  ; waits for the value — and still says the same sentence.
  (let [r (eval-error "(ns callable.bad6)\n(def n 7)\n(n 1)")]
    (is (= :runtime (:layer r)))
    (is (includes? (:message r) "cannot call 7"))))

(deftest a-legitimate-literal-head-still-runs
  ; The compile-time check must not cost the reader the forms that WORK:
  ; a literal map, vector, set and keyword are all callable.
  (is (= 1 (BeamLisp/eval "(ns callable.ok1)\n({:a 1} :a)")))
  (is (= 10 (BeamLisp/eval "(ns callable.ok2)\n([10 20] 0)")))
  (is (= 1 (BeamLisp/eval "(ns callable.ok3)\n(#{1 2} 1)")))
  (is (= 1 (BeamLisp/eval "(ns callable.ok4)\n(:a {:a 1})"))))
