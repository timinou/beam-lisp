; test/bl/reload/upgrade_test.bl — every test run can prove an upgrade is safe.
;
; verify-upgrade rides the checker: the NEW version's declared invariant must
; hold under every transition. A test built on it proves a property no finite set
; of example inputs can — that the upgrade preserves the invariant for EVERY
; reachable state, or names the guard that would.

(ns reload.upgrade-test
  (:require [reload.upgrade :as up] [smt :as smtlib]))

;; the two versions used throughout: a guarded (safe) and an unguarded (unsafe)
;; withdraw handler over the same balance≥0 invariant. Checker-string shape (no
;; init clause) so the checker models it fully (see FUP-013 for the init gap).

(def guarded
  (str "(defserver ^{:invariant (>= balance 0)} acct\n"
       "  (handle-call [:withdraw amt] [_ balance] :when (>= balance amt)\n"
       "    (reply :ok (- balance amt))))"))

(def unguarded
  (str "(defserver ^{:invariant (>= balance 0)} acct\n"
       "  (handle-call [:withdraw amt] [_ balance]\n"
       "    (reply :ok (- balance amt))))"))

; ── verify-upgrade: the three honest verdicts ──────────────────────────

(deftest safe-upgrade-verifies
  ; adding the guard (unguarded → guarded) is a safe upgrade
  (let [v (up/verify-upgrade unguarded guarded)]
    (is (= :safe (:verdict v)))
    (is (:holds (:new v)))))

(deftest unsafe-upgrade-carries-repair
  ; removing the guard (guarded → unguarded) is unsafe, and the verdict carries
  ; the synthesized guard that would restore safety — the fix in the failure
  (let [v (up/verify-upgrade guarded unguarded)]
    (is (= :unsafe (:verdict v)))
    (let [rep (first (:repairs v))]
      (is (= :withdraw (:label rep)))
      (is (= "(<= amt balance)" (smtlib/emit (:guard rep)))))))

(deftest non-process-is-unknown
  ; a plain function pair is not a process → honest :unknown, never a false pass
  (let [v (up/verify-upgrade "(ns x)\n(defn f [] 1)" "(ns x)\n(defn f [] 2)")]
    (is (= :unknown (:verdict v)))
    (is (= :not-a-process (:reason v)))))

; ── the test verb: assert-safe-upgrade records through the suite ───────

(deftest verb-passes-on-safe
  ; a safe upgrade recorded as a PASS by the verb
  (up/assert-safe-upgrade unguarded guarded))

(deftest safe-upgrade-predicate
  (is (up/safe-upgrade? unguarded guarded))
  (is (not (up/safe-upgrade? guarded unguarded))))
