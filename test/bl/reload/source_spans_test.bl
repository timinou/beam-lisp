; Installed SDK acceptance: actual Reader AST, physical spans and exact rewriting.
(ns reload.source-spans-test (:require [reader] [reload.generation]))
(def NEW-READER reader/read-source-spans)
(def NEW-STRING reader/read-string)
(def NEW-REWRITE (BeamLisp.Env/fetch_exact! "reload.generation" "rewrite-source"))
(def MAPPING {"rewrite.a" "sealed.fixed.rewrite.a" "rewrite.b" "sealed.fixed.rewrite.b"})
(defn- failure [f] (try (f) nil (catch e (:kind (ex-data e)))))
(defn- source [body]
 (str "(ns rewrite.a (:require [rewrite.b :as b]))\n" body))
(defn- wanted-source [body]
 (str "(ns sealed.fixed.rewrite.a (:require [sealed.fixed.rewrite.b :as b]))\n" body))
(defn- text [source span]
 (unicode/characters_to_binary
  (lists/sublist (lists/nthtail (:start span) (unicode/characters_to_list source))
                (- (:end span) (:start span)))))

(deftest actual-parser-ast-default-entry-and-physical-offset-equivalence
 (doseq [payload ["é" "👩‍💻" "שלום" "👨‍👩‍👧‍👦" "é"]
         [body wanted-body]
         [[(str "; " payload "\n(defn f [] [\"" payload "\" (rewrite.b/x)])")
           (str "; " payload "\n(defn f [] [\"" payload "\" (sealed.fixed.rewrite.b/x)])")]
          ["(defn f [] [#(rewrite.b/x %) @rewrite.b/state `(~rewrite.b/x ~@xs) #{rewrite.b/x}])"
           "(defn f [] [#(sealed.fixed.rewrite.b/x %) @sealed.fixed.rewrite.b/state `(~sealed.fixed.rewrite.b/x ~@xs) #{sealed.fixed.rewrite.b/x}])"]
          ["(defn f [] [#_ #_ rewrite.b/skip rewrite.b/skip2 (quote rewrite.b/x) '(rewrite.b/x) #\"rewrite.b/x\"])"
           "(defn f [] [#_ #_ rewrite.b/skip rewrite.b/skip2 (quote rewrite.b/x) '(rewrite.b/x) #\"rewrite.b/x\"])" ]
          ["(defn f [] [(quote #?(:clj rewrite.b/x :cljs other/y)) '(#'rewrite.b/x)])"
           "(defn f [] [(quote #?(:clj rewrite.b/x :cljs other/y)) '(#'rewrite.b/x)])"]]]
  (let [input (source body) facts (NEW-READER input "same.bl")
        spans (:source-spans facts) size (erlang/length (unicode/characters_to_list input))]
   (is (= (reader/read-string input "same.bl") (:forms facts)))
   (is (= (reader/read-string input "same.bl") (NEW-STRING input "same.bl")))
   (is (every? #(and (<= 0 (:start %) (:end %) size) (< (:start %) (:end %))) spans))
   (is (= size (:source-length facts) (:end-offset facts)))
   (is (= (wanted-source wanted-body) (NEW-REWRITE input nil MAPPING))))))

(deftest every-ascii-prefix-and-collection-retains-adjacent-combining-codepoint
 (doseq [form ["@́state" "`́state" "~́state" "~@́state" "(́helper (rewrite.b/x))"
               "[́state (rewrite.b/x)]" "{́state (rewrite.b/x)}"
               "#{́state (rewrite.b/x)}" "#(́helper (rewrite.b/x) %)"]]
  (let [body (str "(defn f [́state] " form ")") input (source body)
        wanted (wanted-source (String/replace body "(rewrite.b/x)" "(sealed.fixed.rewrite.b/x)"))]
   (is (= wanted (NEW-REWRITE input nil MAPPING))))))

(deftest physical-anonymous-nodes-have-no-synthetic-parameters-or-call
 (let [input "#(rewrite.b/x % %&)" events (:source-spans (NEW-READER input nil))]
  (is (= 4 (count events)))
  (is (= #{"rewrite.b/x" "%" "%&"} (set (keep :name events))))
  (is (= #{"#(rewrite.b/x % %&)" "rewrite.b/x" "%" "%&"} (set (map #(text input %) events))))
  (is (= :anonymous (:kind (first events))))))

(deftest quotes-discards-and-metadata-specs-are-inert-and-do-not-shift-require-slots
 (let [input "(ns rewrite.a (:require #_ignored [rewrite.b :as b]))\n(defn f [] [^rewrite.b/Type rewrite.b/x ^{:tag rewrite.b/Type} rewrite.b/x '(rewrite.b/x) #_rewrite.b/x rewrite.b/x])"
       wanted "(ns sealed.fixed.rewrite.a (:require #_ignored [sealed.fixed.rewrite.b :as b]))\n(defn f [] [^rewrite.b/Type sealed.fixed.rewrite.b/x ^{:tag rewrite.b/Type} sealed.fixed.rewrite.b/x '(rewrite.b/x) #_rewrite.b/x sealed.fixed.rewrite.b/x])"]
  (is (= wanted (NEW-REWRITE input nil MAPPING)))
  (is (= (reader/read-string input nil) (:forms (NEW-READER input nil))))))

(deftest unsupported-physical-expansions-are-refused-only-when-executable
 (is (= :unsupported-reader-expansion
        (failure #(NEW-REWRITE (source "(defn f [] #?(:clj rewrite.b/x))") nil MAPPING))))
 (is (= :unsupported-reader-expansion
        (failure #(NEW-REWRITE (source "(defn f [] #'rewrite.b/x)") nil MAPPING))))
 (let [body "(defn f [] '(#?(:clj rewrite.b/x) #'rewrite.b/x))" input (source body)]
  (is (= (wanted-source body) (NEW-REWRITE input nil MAPPING)))))

(deftest malformed-source-uses-the-same-reader-diagnostic
 (doseq [input ["(x" "[x)" "\"open" "#(nested #(%))" "#_" "^:tag"]]
  (let [old (try (reader/read-string input "errors.bl") nil (catch e (or (:original e) (ex-data e))))
        new (try (NEW-READER input "errors.bl") nil (catch e (or (:original e) (ex-data e))))]
   (is (map? old))
   (is (= old new)))))

(deftest every-physical-scalar-and-collection-has-one-exact-span
 (let [input "(foo :bar \"é\" 1 [x] {:k y} #{z})"
       events (:source-spans (NEW-READER input nil))]
  (is (= 12 (count events)))
  (is (= #{input "foo" ":bar" "\"é\"" "1" "[x]" "x" "{:k y}" ":k" "y" "#{z}" "z"}
         (set (map #(text input %) events))))))

(deftest quoted-and-discarded-tagged-data-retains-exact-following-executable-spans
 (doseq [form ["#time\"2026-10-14\"" "#d[:find ?e :where [?e :x 1]]" "#Point{:x \"é👩‍💻\"}"]
         prefix ["'" "#_"]]
  (let [body (str "(defn f [] [" prefix form " (rewrite.b/x)])")
        input (source body)
        wanted (str "(ns sealed.fixed.rewrite.a (:require [sealed.fixed.rewrite.b :as b]))\n"
                    "(defn f [] [" prefix form " (sealed.fixed.rewrite.b/x)])")
        facts (NEW-READER input "same.bl")]
   (is (= wanted (NEW-REWRITE input nil MAPPING)))
   (is (= (NEW-STRING input "same.bl") (:forms facts)))
   (is (= (erlang/length (unicode/characters_to_list input)) (:end-offset facts))))))
