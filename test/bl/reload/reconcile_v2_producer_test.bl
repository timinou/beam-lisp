; Genuine ordinary declaration producer controls, Native UNRUN.
; No fabricated graph/recipe/private custody, Source overlays or original app API.
(ns reload.reconcile-v2-producer-test
 (:require [reload.generation :as g] [env] [proc.reconcile-runtime :as runtime]
           [reload.reconcile-snapshot :as snapshot]))
(defn- graph [variant marker]
 (g/prepare!
  {:application-id (str "typed-producer-" (erlang/unique_integer (list :positive)))
   :stable-namespaces #{"proc.server" "proc.reconcile" "proc.queue" "proc.queue-family" "proc.tick" "reload.state"}
   :native-modules #{"File"}
   :sources {"typed.producer"
    (str "(ns typed.producer (:require [proc.server :as server] [reload.state :as state])) "
         "(def PROJECTION {:ident :typed/projection}) "
         "(defn config-for [srv policy opts] "
         (when (= variant :effect) (str "(File/write! " (pr-str marker) " \"factory\") "))
         "(let [root (state/get :runtime) connection (:connection root) tenant (:tenant root)] "
         "{:projection PROJECTION :level nil :watch? false "
         ":conn-fn (fn [_] connection) "
         ":scope-fn (fn [_ _] "
         (case variant :whole "[(:tenant root)]" :dynamic "[(get root (:field opts))]" "[tenant]")
         ") :apply (fn [_ _] nil) "
         (when (= variant :escape) ":rules connection ") "})) "
         "(server/defserver worker (reconcile {:server (:queue (state/get :runtime)) :config-fn config-for :level nil})) "
         "(defn start! [opts] (start worker opts))")}}))
(defn- recipe [graph] (get-in graph [:declarations :reconcile "typed.producer/worker" :data :canonical]))
(defn- original-class [graph]
 (env/with-env (:scope graph)
  #(BeamLisp.Env/fetch_exact! (get (:mapping graph) "typed.producer") "worker")))
(defn- reason [action] (try (action) nil (catch error (or (:reason (ex-data error)) (:kind (ex-data error))))))
(deftest actual-original-declaration-path-emits-one-shared-v2-schema-and-closed-entries
 (let [graph (graph :proved nil) actual (recipe graph)]
  (try
   (is (= 2 (:version actual)))
   (is (= :selected-versioned (:snapshot-scope actual)))
   (is (= [:runtime] (:cell-keys actual)))
   (is (= {[:connection] :connection [:tenant] :data [:queue] :data}
          (into {} (map (fn [slot] [(:path slot) (:kind slot)]) (:snapshot-slots actual)))))
   (is (= (original-class graph) (:original-class actual)))
   (is (= 3 (count (:callback-constructors actual))))
   (is (= [0 1 1] (sort (map #(count (:capture-kinds %)) (vals (:callback-constructors actual))))))
   (is (= [[:connection] [:data] []] (sort-by pr-str (map :capture-kinds (vals (:callback-constructors actual))))))
   (is (erlang/is_function (get (:callables graph) (:instance actual)) 2))
   (is (erlang/is_function (get (:callables graph) (:reifier actual)) 4))
   (finally (g/retire! graph)))))
(deftest real-emitted-callback-references-are-in-the-exact-native-graph
 (let [graph (graph :proved nil) actual (recipe graph)]
  (try
   (doseq [[_ spec] (:callback-constructors actual)]
    (let [callable (get (:callables graph) (:reference spec))
          arity (+ (:arity spec) (count (:capture-kinds spec)))]
     (is (erlang/is_function callable arity))
     (is (every? (set (:modules graph)) (BeamLisp.Env/callback_modules callable)))))
   (is (= false (snapshot/consumer-enabled?)))
   (is (= :native-boundary-unaccepted
          (reason #(g/with! graph
                     (fn [] (runtime/start-declared! (original-class graph) {} {}
                              {:version 2 :declaration "typed.producer/worker"} :start))))))
   (finally (g/retire! graph)))))
(deftest unknown-whole-dynamic-and-data-escaping-paths-keep-original-classes
 (doseq [variant [:whole :dynamic :escape]]
  (let [graph (graph variant nil)]
   (try
    (is (nil? (recipe graph)))
    (is (contains? (:server-classes graph) (original-class graph)))
    (finally (g/retire! graph))))))
(deftest ordinary-producer-never-executes-effectful-original-factory
 (let [marker (str (System/get_env "HOME") "/tmp/typed-producer-marker-" (erlang/unique_integer (list :positive)))
       graph (graph :effect marker)]
  (try
   (is (nil? (recipe graph)))
   (is (not (File/exists? marker)))
   (finally (g/retire! graph) (when (File/exists? marker) (File/rm! marker))))))
