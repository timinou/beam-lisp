; ISOLATED PRIVILEGED FAULT COMPONENT, RUN LAST IN ITS OWN VM. Native UNRUN.
; Returns the actual native SDK owner's exact existing lease, never fabricates
; a grant/graph or production API. Re-establishes only from genuine native root
; for final test cleanup. No application constructor/provider is replayed.
(ns reload.automatic-sdk-retention-fault-test
 (:require [reload.generation :as g]))
(defn error-value [action]
 (try (action) nil
  (catch error
   (if (and (erlang/is_map error) (maps/is_key :original error))
    (maps/get :original error) error))))
(deftest actual-source-cannot-clear-origin-or-repair-a-returned-sdk-lifetime
 (let [a (g/prepare!
          {:application-id "automatic-sdk-fault" :native-modules #{"Process"}
           :stable-namespaces #{"reload.generation"}
           :sources {"automatic.sdk.fault"
            "(ns automatic.sdk.fault (:require [reload.generation :as g]))
             (defn clear! [] (Process/delete :bl_generation) (g/prepare! {}))
             (defn prepare! [] (g/prepare! {}))
             (defn marker [] :old)"}})
       initial (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
       row (erlang/hd initial) proof (erlang/element 2 row)
       owner (:owner proof) lease (:lease proof)]
  (try
   (is (= 1 (erlang/length initial)))
   (is (erlang/is_pid owner))
   (is (Process/alive? owner))
   (is (BeamLisp.Env/code_lease_active? lease))
   (is (= :execution_origin_context_mismatch
          (error-value #(g/invoke! a "automatic.sdk.fault/clear!" []))))
   (is (erlang/== initial (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
   (is (= :old (g/invoke! a "automatic.sdk.fault/marker" [])))
   ;; Exact native owner returns its actual lease in this disposable test VM.
   ;; Deleting just a public row would not prove the physical lifetime missing.
   (Agent/get owner
    (fn [_]
     (when-not (erlang/== (list row) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease))
      (throw :fixture-sdk-owner-changed))
     (BeamLisp.Env/release_code! lease)
     (ets/delete_object :beam_lisp_vars row)
     :returned) 30000)
   (is (not (BeamLisp.Env/code_lease_active? lease)))
   (is (erlang/== (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
   (is (= :unretained_sdk_runtime_before_source
          (error-value #(g/invoke! a "automatic.sdk.fault/prepare!" []))))
   (is (erlang/== (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
   (is (= :old (g/invoke! a "automatic.sdk.fault/marker" [])))
   (finally
    ;; This is genuinely unmanaged after invoke!'s finally restores its origin.
    ;; Only the fixed native issuer can restore the disposable VM for cleanup.
    (BeamLisp.Env/ensure_sdk_runtime!)
    (g/retire! a)))))
