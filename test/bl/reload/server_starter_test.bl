; Actual generated actors and native start receipts. No ancestry or caller map
; is admission authority. Root executes serially on the coherent native floor.
(ns reload.server-starter-test
 (:require [reload.generation :as g] [reload.execution :as execution] [env]
           [live.lifecycle :as lifecycle] [datom :as d] [datom.conn :as conn]))
(defn- fixture-observer! []
 ;; An explicit external native fixture, with no callable in runtime bindings.
 ;; Source can observe the real mailbox/ancestry without an unmanaged primitive.
 (let [module :Elixir.StarterObserverFixture]
  (when-not (erlang/function_exported module :observe 3)
   (Code/compile_string
    "defmodule StarterObserverFixture do
      def observe(:message, target, message), do: send(target, message)
      def observe(:ancestor, target, _), do: Process.put(:\"$ancestors\", [target])
     end"))
  module))
(defn- graph []
 (let [root (str (System/get_env "HOME") "/tmp/server-starter-" (erlang/unique_integer (list :positive)))
       file (str root "/starter/fixture.bl")
       observer (fixture-observer!)
       native (String/replace_prefix (Atom/to_string observer) "Elixir." "")
       target "StarterObserverFixture/observe"]
  (File/mkdir_p! (Path/dirname file))
  (File/write! file (String/replace
   "(ns starter.fixture (:require [proc.server :as server] [reload.execution :as execution]
                                 [datom :as d]))
    (server/defserver owner
     (init [opts]
       (when (:pretend-parent opts) (FIXTURE-OBSERVE :ancestor (:pretend-parent opts) nil))
       (when (:observer opts) (FIXTURE-OBSERVE :message (:observer opts) [:user-init (:ticket opts) (erlang/self)]))
       (when (:held opts) (receive :release :released))
       (ok {:owned (execution/owned?) :connection (when (:create-store opts) (d/connect))}))
     (handle-call :read [_ state] (reply state state))
     (handle-call :allocate [_ state]
      (let [next (assoc state :connection (d/connect))] (reply next next)))
     (terminate [_ state] (when (:connection state) (d/close! (:connection state)))))
    (server/defserver default-owner
     (handle-call :read [_ state] (reply state state)))
    (defn default-start [] (start default-owner nil))
    (defn actor-class [] owner)
    (defn start-owner [opts] (start owner opts))
    (defn linked-owner [opts] (start-link owner opts))
    (defn peer-constructor [opts]
     (let [ticket (:ticket opts)]
      (FIXTURE-OBSERVE :message (:peer opts) [:create ticket (erlang/self)])
      (receive [:constructed seen pid] :when (= seen ticket) {:pid pid}
       (after 10000 (throw :peer-construction-lost)))))
    (defn peer-background []
     (peer-constructor {:peer (execution/runtime-resource :starter/peer)
                        :ticket (execution/runtime-resource :starter/ticket)}))" "FIXTURE-OBSERVE" target))
  (try
   (BeamLisp.Loader/with_load_path root
    #(g/prepare! (g/project-plan {:application-id "server-starter-test"
       :entrypoint "starter.fixture/start-owner" :fixed-runtime true
       :native-modules #{"erlang" "Process" native}})))
   (finally (File/rm_rf! root)))))
(defn- stop! [pid]
 (when (and pid (Process/alive? pid)) (try (GenServer/stop pid :normal 5000) (catch _ nil))))
(defn- await-down! [pid]
 (let [ref (Process/monitor pid)]
  (try (receive [:DOWN seen :process dead _] :when (and (= seen ref) (= dead pid)) :down
         (after 5000 :missing))
   (finally (Process/demonitor ref (list :flush))))))
(defn- pending [capability]
 (BeamLisp.Env/server_start_observation (elem capability 2)))

(deftest genuine-start-retains-immutable-starter-before-init-and-handler-store-creation
 (let [graph (graph)
       pid (g/invoke! graph "starter.fixture/start-owner" [{:create-store true}])]
  (try
   (let [evidence (g/owner-evidence pid) receipt (:starter evidence)
         initial (call pid :read)
         created (conn/creation-evidence! (:connection initial))]
    (is (= (erlang/self) (:creator receipt))) (is (= pid (:child receipt)))
    (is (= (:module evidence) (:module receipt)))
    (is (erlang/is_reference (:attempt receipt))) (is (erlang/is_reference (:ticket receipt)))
    (is (= true (:owned initial)))
    (is (= (select-keys graph [:application-id :scope :digest]) (:creator created)))
    (d/close! (:connection initial))
    (let [next (call pid :allocate)
          created (conn/creation-evidence! (:connection next))]
     (is (= (select-keys graph [:application-id :scope :digest]) (:creator created))))
    (is (nil? (pending (tuple :bl_server_start (erlang/self) (:ticket receipt))))))
   (finally (stop! pid) (g/retire! graph)))))

(deftest generated-default-init-also-has-an-authenticated-starter
 (let [graph (graph) pid (g/invoke! graph "starter.fixture/default-start" [])]
  (try
   (is (= {} (call pid :read)))
   (is (= (erlang/self) (get-in (g/owner-evidence pid) [:starter :creator])))
   (is (= pid (get-in (g/owner-evidence pid) [:starter :child])))
   (finally (stop! pid) (g/retire! graph)))))

(deftest copied-env-and-real-class-cannot-bootstrap-a-managed-native-owner
 (let [graph (graph) token (g/with! graph env/capture)
       class (g/invoke! graph "starter.fixture/actor-class" [])
       warm (g/invoke! graph "starter.fixture/start-owner" [{}]) ticket (erlang/make_ref)]
  (try
   (is (not (execution/owned?)))
   (is (= :private (try (ets/tab2list :beam_lisp_server_starts) :public (catch _ :private))))
   (doseq [argument [{:observer (erlang/self) :ticket ticket}
                    (tuple :"$bl_conveyed_env" (assoc token :generation nil)
                      {:observer (erlang/self) :ticket ticket})
                    (tuple :"$bl_conveyed_generation" token class {:observer (erlang/self) :ticket ticket})
                    (tuple :"$bl_conveyed_generation" token class {:observer (erlang/self) :ticket ticket}
                      (tuple :bl_server_start (erlang/self) (erlang/make_ref)))]]
    (let [result (erlang/apply :gen_server :start (list class argument (list)))]
     (when (= :ok (elem result 0)) (stop! (elem result 1)))
     (is (= :error (elem result 0)))))
   ;; Even a real sealed init called outside OTP has no authenticated native
   ;; init boundary. Reflection failure is not unmanaged compatibility.
   (is (= :refused (try
          (erlang/apply class :init (list {:observer (erlang/self) :ticket ticket}))
          :entered (catch _ :refused))))
   (is (= :no-user-init (receive [:user-init seen _] :when (= seen ticket) :entered
                            (after 0 :no-user-init))))
   ;; The consumed native attempt cannot be reconstructed from its read-only
   ;; owner receipt, and the receipt is absent from captured Env context.
   (is (not (contains? token :bl_server_start_receipt)))
   (is (not (contains? token :server-start)))
   (finally (stop! warm) (g/retire! graph)))))

(deftest copied-bound-context-and-retention-only-do-not-authorize-start
 (let [graph (graph) token (g/with! graph env/capture)
       class (g/invoke! graph "starter.fixture/actor-class" [])]
  (try
   (let [before (env/capture) lease (BeamLisp.Env/retain_code! (to-list (:modules graph)))]
    (try
     (env/bind token)
     (is (= :refused (try (BeamLisp.Server/start class {}) :accepted (catch _ :refused))))
     (finally (env/bind before) (BeamLisp.Env/release_code! lease))))
   (finally (g/retire! graph)))))

(deftest an-exact-native-start-capability-is-consumed-once
 (let [graph (graph) ticket (erlang/make_ref) parent (erlang/self) child (atom nil)]
  (try
   (g/with! graph (fn []
    (let [class (g/invoke! graph "starter.fixture/actor-class" [])
          admission (BeamLisp.Env/begin_server_start! class)
          argument (tuple :"$bl_conveyed_generation" (env/capture) class
                     {:observer parent :ticket ticket} admission)]
     (BeamLisp.Env/launch_server_start! admission)
     (let [first (erlang/apply :gen_server :start (list class argument (list)))]
      (when (= :ok (elem first 0)) (reset! child (elem first 1)))
      (is (= :ok (elem first 0))))
     (is (= @child (receive [:user-init seen pid] :when (= seen ticket) pid (after 5000 nil))))
     (let [second (erlang/apply :gen_server :start (list class argument (list)))]
      (when (= :ok (elem second 0)) (stop! (elem second 1)))
      (is (= :error (elem second 0))))
     (is (= :no-second-init (receive [:user-init seen _] :when (= seen ticket) :entered
                             (after 0 :no-second-init)))))))
   (finally (stop! @child) (g/retire! graph)))))

(deftest a-subset-executing-ticket-does-not-authorize-full-graph-start
 (let [graph (graph) token (g/with! graph env/capture)
       class (g/invoke! graph "starter.fixture/actor-class" [])
       lease (BeamLisp.Env/retain_code! (list class)) before (env/capture)]
  (try
   (is (> (count (:modules graph)) 1))
   (env/bind token)
   (is (= :refused
          (BeamLisp.Env/with_owned_code_execution lease
           #(BeamLisp.Env/with_owned_generation_execution
             (fn [] (try (BeamLisp.Server/start class {}) :accepted (catch _ :refused)))))))
   (finally (env/bind before) (BeamLisp.Env/release_code! lease) (g/retire! graph)))))

(deftest native-start-link-keeps-the-actual-starter-link
 (let [graph (graph) pid (g/invoke! graph "starter.fixture/linked-owner" [{}])]
  (try
   (is (some #(= pid %) (elem (Process/info (erlang/self) :links) 1)))
   (is (some #(= (erlang/self) %) (elem (Process/info pid :links) 1)))
   (is (= (erlang/self) (get-in (g/owner-evidence pid) [:starter :creator])))
   (finally (stop! pid) (g/retire! graph)))))

(deftest mutable-ancestors-cannot-attribute-a-peer-created-actor-to-the-observer
 (let [graph (graph) ticket (erlang/make_ref) observer (erlang/self) created (atom nil)
       peer (spawn (fn []
        (receive [:create seen victim] :when (= seen ticket)
         (let [pid (g/invoke! graph "starter.fixture/start-owner" [{:pretend-parent victim}])]
          (reset! created pid) (erlang/send victim [:constructed ticket pid]))
         (after 10000 nil))))]
  (try
   (let [result (lifecycle/capture-invocation! graph "starter.fixture/peer-constructor"
                  [{:ticket ticket :peer peer}]) receipt (:starter (g/owner-evidence @created))]
    (is (= :uncertain (:status result))) (is (empty? (:owners result)))
    (is (= peer (:creator receipt))) (is (not= observer (:creator receipt)))
    (is (= @created (:child receipt))))
   (finally (stop! @created) (g/retire! graph)))))

(deftest background-readiness-does-not-ignore-a-peer-owned-fresh-actor
 (let [graph (graph) ticket (erlang/make_ref) created (atom nil)
       peer (spawn (fn []
        (receive [:create seen victim] :when (= seen ticket)
         (let [pid (g/invoke! graph "starter.fixture/start-owner" [{}])]
          (reset! created pid) (erlang/send victim [:constructed ticket pid]))
         (after 10000 nil))))]
  (try
   (g/with! graph #(g/bind-runtime! {:starter/peer peer :starter/ticket ticket}))
   (let [result (lifecycle/start-background! graph "starter.fixture/peer-background")]
    (is (= :uncertain (:status result))) (is (= :unavailable (:ownership result)))
    (is (empty? (:owners result))) (is (Process/alive? @created))
    (is (= peer (get-in (g/owner-evidence @created) [:starter :creator]))))
   (finally (stop! @created) (g/retire! graph)))))

(deftest creator-death-after-accepted-user-init-keeps-the-actual-child-and-code
 (let [graph (graph) observer (erlang/self) ticket (erlang/make_ref)
       creator (spawn (fn [] (g/invoke! graph "starter.fixture/start-owner"
                           [{:observer observer :ticket ticket :held true}])))
       child (receive [:user-init seen pid] :when (= seen ticket) pid (after 5000 nil))]
  (try
   (is (erlang/is_pid child)) (Process/exit creator :kill) (is (= :down (await-down! creator)))
   (is (Process/alive? child)) (is (= creator (get-in (g/owner-evidence child) [:starter :creator])))
   (is (= :waiting (:status (g/retire! graph))))
   (erlang/send child :release) (is (= true (:owned (call child :read))))
   (finally (when child (erlang/send child :release)) (stop! child) (g/retire! graph)))))

(deftest unknown-launch-and-guardian-death-retain-env-custody
 ;; This control executes the real native admission protocol but deliberately
 ;; never invokes OTP: once marked launching, death is NOT completion evidence.
 ;; Held rows intentionally survive to this test VM's end, without fake unlock.
 (let [graph (graph) observer (erlang/self) notice (erlang/make_ref)
       creator (spawn (fn []
        (g/with! graph (fn []
         (let [class (g/invoke! graph "starter.fixture/actor-class" [])
               admission (BeamLisp.Env/begin_server_start! class)]
          (BeamLisp.Env/launch_server_start! admission)
          (erlang/send observer [:pending-start notice admission])
          (receive :finish nil))))))
       admission (receive [:pending-start seen value] :when (= seen notice) value (after 5000 nil))]
  (is admission)
  (let [guardian (elem admission 1) row (pending admission)]
   (is (not= guardian (:custody-owner row)))
   (is (= (Process/whereis :Elixir.BeamLisp.Env) (:custody-owner row)))
   (is (= :refused (try (BeamLisp.Env/server_start_departed! (elem admission 2) creator)
                          :released (catch _ :refused))))
   (is (= true (:retained (pending admission))))
   (Process/exit guardian :kill) (is (= :down (await-down! guardian)))
   (Process/exit creator :kill) (is (= :down (await-down! creator)))
   (is (= true (:retained (pending admission)))) (is (some? (pending admission)))
   (is (= :waiting (:status (g/retire! graph)))))))

(deftest checked-source-cannot-call-or-borrow-the-internal-context-unwrapper
 (doseq [body ["(BeamLisp.Server/bind_init nil)"
               "(let [unwrap BeamLisp.Server/bind_init] (unwrap nil))"]]
  (is (= :unmanaged-generation-producer
         (try (g/prepare! {:application-id "source-server-unwrapper-refusal"
                 :native-modules #{"BeamLisp.Server"}
                 :sources {"internal.server" (str "(ns internal.server) (defn invoke [] " body ")")}})
              :accepted (catch error (:kind (ex-data error)))))))
 (is (= :unmanaged-generation-producer
        (try (g/prepare! {:application-id "source-server-nested-unwrapper-refusal"
                :native-modules #{"BeamLisp.Server"}
                :sources {"internal.actor" "(ns internal.actor)
                 (defserver owner (init [x] (ok x))
                  (handle-call :clear [_ state] (BeamLisp.Server/bind_init nil) (reply state state)))"}})
             :accepted (catch error (:kind (ex-data error)))))))


(defserver ordinary-origin-dev-owner
 (init [opts]
  (erlang/send (:observer opts) [:ordinary-dev-init (:ticket opts)])
  (ok opts)))
(deftest ordinary-nonsealed-dev-native-start-keeps-raw-and-nil-generation-compatibility
 (let [ticket (erlang/make_ref) opts {:observer (erlang/self) :ticket ticket}
       token (assoc (env/capture) :generation nil)]
  (doseq [argument [opts (tuple :"$bl_conveyed_env" token opts)]]
   (let [result (erlang/apply :gen_server :start (list ordinary-origin-dev-owner argument (list)))
         pid (when (= :ok (elem result 0)) (elem result 1))]
    (try
     (is (= :ok (elem result 0)))
     (is (= :entered (receive [:ordinary-dev-init seen] :when (= seen ticket) :entered
                       (after 5000 :missing))))
     (is (nil? (g/owner-evidence pid)))
     (finally (stop! pid)))))))
