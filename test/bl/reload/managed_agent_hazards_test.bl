; Source planning refusal controls; actual callback/actor APIs are never mocked.
(ns reload.managed-agent-hazards-test
 (:require [reload.generation :as generation]))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn- proposal [call]
 {:application-id "agent-hazard-controls" :native-modules #{"Agent" "Elixir.Agent" "erlang"}
  :sources {"agent.native-refusal"
   (str "(ns agent.native-refusal) (defn run [target] " call ")")}})
(deftest raw-agent-callback-entrypoints-refuse-before-target-enqueue
 (let [effects (atom 0) target (Agent/start (fn [] 0))
       pid (elem target 1)]
  (try
   ;; Pure planning compiles no candidate body and sends no Agent message.
   (is (= :unmanaged-generation-producer (kind #(generation/plan
      (proposal "(Agent/get target (fn [x] (erlang/send target :must-not-run) x))")))))
   (is (= :unmanaged-generation-producer (kind #(generation/plan
      (proposal "(Agent/update target (fn [x] (erlang/send target :must-not-run) x))")))))
   (is (= :unmanaged-generation-producer (kind #(generation/plan
      (proposal "(Agent/get_and_update target (fn [x] (erlang/send target :must-not-run) (tuple x x)))")))))
   (is (= :unmanaged-generation-producer (kind #(generation/plan
      (proposal "(Agent/cast target (fn [x] (erlang/send target :must-not-run) x))")))))
   (is (= :unmanaged-generation-producer (kind #(generation/plan (proposal "(Agent/stop target)")))))
   (is (= 0 (Agent/get pid (fn [x] x))))
   (is (= 0 (elem (Process/info pid :message_queue_len) 1)))
   (is (Process/alive? pid))
   (finally (Agent/stop pid :normal 5000)))))
(deftest literal-native-apply-cannot-hide-raw-agent-callback-admission
 ;; A literal apply is intentionally admitted by structural planning. The
 ;; actual compiler-resolved native callee must then hit the SAME policy before
 ;; any emitted Source callback can execute or be enqueued.
 (is (= :dynamic-code-dependency
        (kind #(generation/prepare! (proposal "(erlang/apply :Elixir.Agent :get (list target (fn [x] x)))")))))
 (is (= :unmanaged-generation-producer
        (kind #(generation/plan (proposal "(Elixir.Agent/get target (fn [x] x))"))))))
(deftest quoted-agent-syntax-and-lexical-get-do-not-grant-or-trigger-native-admission
 (let [input (proposal "'(Agent/get target callback)")]
  (is (= input (:input (generation/plan input)))))
 (let [input (proposal "(let [get (fn [x] x)] (get target))")]
  (is (= input (:input (generation/plan input))))))
