; Pure structural tests;actual compiler/provider integration has its own fixture.
(ns reload.registration-test (:require [reload.registration :as registration]))
(defn- kind [f] (try (f) nil (catch error (:kind (ex-data error)))))
(def CONTRACT {:kind :sample :arity 2 :id-position 0 :callback-position 1})
(def TARGETS {[:sample.sdk :register! 2] CONTRACT})
(def GLOBALS {["sample.sdk" "register!"] CONTRACT})
(def CALL {:op :remote :mod :sample.sdk :fun :register! :ann {:line 17}
           :args (list {:op :lit :val :sample/id :ann {}}
                       {:op :global :ns "owned.sample" :name "callback" :ann {}})})

(deftest exact-registration-becomes-data-without-candidate-execution
 (let [declared (atom [])
       result (registration/specialize CALL TARGETS GLOBALS
                (fn [contract ident owner callback]
                 (swap! declared conj [(:kind contract) ident owner callback])))]
  (is (= [[:sample :sample/id "owned.sample" "callback"]] @declared))
  (is (= {:op :lit :val :sample/id :ann {:line 17}} (:expression result)))
  (is (= [{:kind :sample :ident :sample/id :owner "owned.sample" :callback "callback"}]
         (:registrations result)))))

(deftest quoted-data-and-annotations-never-register
 (let [calls (atom 0) literal {:op :lit :val CALL :ann {:fixture CALL}}
       result (registration/specialize literal TARGETS GLOBALS (fn [& _] (swap! calls inc)))
       ordinary {:op :remote :mod :other.sdk :fun :register! :args (:args CALL) :ann {:fixture CALL}}]
  (is (= literal (:expression result)))
  (is (= ordinary (:expression (registration/specialize ordinary TARGETS GLOBALS (fn [& _] (swap! calls inc))))))
  (is (zero? @calls))))

(deftest definition-carriers-expose-only-compiler-owned-code
 (let [calls (atom 0) clause {:op :defn-clause :fname :run :params (list) :guard nil :body CALL :ann {}}
       carrier {:op :remote :mod :Elixir.BeamLisp.Link :fun :defvar :ann {}
                :args (list {:op :lit :val "owned.sample"} {:op :lit :val "run"}
                            {:op :lit :val (list (tuple :fixed 0 :run clause))} {:op :lit :val nil})}
       result (:expression (registration/specialize carrier TARGETS GLOBALS (fn [& _] (swap! calls inc))))]
  (is (= 1 @calls))
  (is (= :sample/id (:val (:body (elem (first (:val (nth (:args result) 2))) 3)))))
  (is (erlang/is_list (:val (nth (:args result) 2))))
  (is (= :invalid-compiled-definition
         (kind #(registration/specialize (assoc carrier :args (list {} {} {:op :lit :val [clause]} {}))
                                          TARGETS GLOBALS (fn [& _] nil)))))))

(deftest dynamic-registration-is-refused-before-declaration
 (let [calls (atom 0) callback (fn [& _] (swap! calls inc))]
  (is (= :dynamic-executable-registration
         (kind #(registration/specialize (assoc CALL :args (list {:op :var :name "id"} (second (:args CALL))))
                                          TARGETS GLOBALS callback))))
  (is (= :dynamic-executable-registration
         (kind #(registration/specialize (assoc CALL :args (list (first (:args CALL)) {:op :var :name "f"}))
                                          TARGETS GLOBALS callback))))
  (is (= :dynamic-executable-registration
         (kind #(registration/specialize {:op :global :ns "sample.sdk" :name "register!" :ann {}}
                                          TARGETS GLOBALS callback))))
  (is (zero? @calls))))

(deftest actor-carrier-and-analysis-depth-are-bounded
 (let [calls (atom 0)
       module {:op :module :name :owned.actor
               :clauses (list {:op :defn-clause :fname :init :params (list) :guard nil :body CALL})}
       carrier {:op :remote :mod :Elixir.BeamLisp.Ns.Lower :fun :reload-descriptor!
                :args (list {:op :lit :val module})}
       _ (registration/specialize carrier TARGETS GLOBALS (fn [& _] (swap! calls inc)))
       deep (reduce (fn [node _] {:op :do :stmts (list node)}) {:op :lit :val nil} (range 300))]
  (is (= 1 @calls))
  (is (= :registration-analysis-budget
         (kind #(registration/specialize deep TARGETS GLOBALS (fn [& _] nil)))))))


(deftest actual-canonical-global-invocation-becomes-data
 (let [calls (atom [])
       invoke {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :invoke :ann {:line 23}
               :args (list {:op :global :ns "sample.sdk" :name "register!" :lookup :exact :ann {}}
                           {:op :cons :head (first (:args CALL))
                            :tail {:op :cons :head (second (:args CALL)) :tail {:op :enil}}})}
       result (registration/specialize invoke TARGETS GLOBALS
                (fn [contract ident owner callback] (swap! calls conj [ident owner callback])))]
  (is (= [[:sample/id "owned.sample" "callback"]] @calls))
  (is (= {:op :lit :val :sample/id :ann {:line 23}} (:expression result)))
  (is (= :dynamic-executable-registration
         (kind #(registration/specialize
                  (assoc invoke :args (list (first (:args invoke)) {:op :var :name "args"}))
                  TARGETS GLOBALS (fn [& _] (throw "must not declare"))))))))
