(ns reload.state-test (:require [reload.generation :as gen] [reload.state :as state]))

(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest sealed-runtime-state-cells-never-use-legacy-fallback
 (let [key :generation-state-test value (atom {:version 1})
       old (gen/prepare! {:application-id "state-test"
                         :stable-namespaces #{"reload.state"}
                         :sources {"state.application" "(ns state.application (:require [reload.state :as state])) (defn init [cells] (state/bind! cells)) (defn read [key] (state/get key :fallback)) (defn write [key value] (state/put! key value))"}})]
  (try
   (state/put! key :legacy)
   (is (= :legacy (state/get key)))
   (is (= :bound (gen/invoke! old "state.application/init" [{key value}])))
   (is (= {:version 1} (gen/invoke! old "state.application/read" [key])))
   (is (= {:version 2} (gen/invoke! old "state.application/write" [key {:version 2}])))
   (is (= {:version 2} @value))
   (is (= :legacy (state/get key)))
   (is (= :missing-runtime-resource (kind #(gen/invoke! old "state.application/read" [:absent]))))
   (is (= :invalid-runtime-state (kind #(gen/invoke! old "state.application/write" [key {:callback (fn [] :unsafe)}]))))
   (is (= {:version 2} @value))
   (finally (gen/retire! old) (persistent_term/erase key)))))

(deftest explicit-shared-cells-retain-one-legacy-identity-and-isolate-managed-state
 (let [key :generation-state-cell-test legacy (state/cell! key {:legacy true})
       a (gen/prepare! {:application-id "state-cells" :sources {"state.cell" "(ns state.cell) (defn id [] 1)"}})
       b (gen/prepare! {:application-id "state-cells" :sources {"state.cell" "(ns state.cell) (defn id [] 2)"}})
       managed (atom {:managed true})]
  (try
   (is (= legacy (state/cell! key :ignored)))
   (is (= {:legacy true} @legacy))
   (gen/with! a #(state/bind! {key managed}))
   (is (= managed (gen/with! a #(state/cell! key :ignored))))
   (is (= {:managed true} @(gen/with! a #(state/cell! key :ignored))))
   (is (= :missing-runtime-resource (kind (fn [] (gen/with! b (fn [] (state/cell! key :ignored)))))))
   (is (= legacy (state/cell! key :ignored)))
   (persistent_term/put :generation-state-cell-invalid :different)
   (is (= :invalid-runtime-cell (kind #(state/cell! :generation-state-cell-invalid {}))))
   (finally (gen/retire! a) (gen/retire! b)
    (persistent_term/erase key) (persistent_term/erase :generation-state-cell-invalid)))))
