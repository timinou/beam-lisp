(ns reload.state-test (:require [reload.generation :as gen] [reload.state :as state] [env]))

(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest development-scopes-do-not-share-cells-or-plain-runtime-values
 (let [key :state-scope-isolation value-key :state-value-isolation
       a (env/fork) b (env/fork)]
  (try
   (let [left (env/with-env a #(state/cell! key {:tenant :a}))
         right (env/with-env b #(state/cell! key {:tenant :b}))]
    (is (not= left right))
    (is (= {:tenant :a} @left))
    (is (= {:tenant :b} @right))
    (is (= left (env/with-env a #(state/cell! key :ignored)))))
   (env/with-env a #(state/put! value-key :a))
   (env/with-env b #(state/put! value-key :b))
   (is (= :a (env/with-env a #(state/get value-key))))
   (is (= :b (env/with-env b #(state/get value-key))))
   (is (= :absent (state/get value-key :absent)))
   (finally (env/destroy a) (env/destroy b)
    (persistent_term/erase key) (persistent_term/erase value-key)))))

(deftest destroyed-development-scope-refuses-new-state-publication
 (let [scope (env/fork)]
  (env/destroy scope)
  (is (= :retired-runtime-state
       (kind #(env/with-env scope (fn [] (state/cell! :retired-cell {}))))))
  (is (= :retired-runtime-state
       (kind #(env/with-env scope (fn [] (state/put! :retired-value :bad))))))))

(deftest pending-one-use-records-survive-publication-with-one-consumer
 (let [key :state-pending-record
       old (gen/prepare! {:application-id "state-consumption" :sources {"state.pending" "(ns state.pending) (defn version [] 1)"}})
       next (gen/prepare! {:application-id "state-consumption" :sources {"state.pending" "(ns state.pending) (defn version [] 2)"}})
       cell (atom {"code" {:principal "principal-a" :expires-at 999}})
       consume (fn [] (state/get-and-update! key {} (fn [m] (tuple (get m "code") (dissoc m "code")))))]
  (try
   (gen/with! old #(state/bind! {key cell}))
   (is (= :inherited (gen/inherit-runtime! next old)))
   (is (= {:principal "principal-a" :expires-at 999} (gen/with! next consume)))
   (is (nil? (gen/with! old consume)))
   (is (= {} @cell))
   (finally (gen/retire! old) (gen/retire! next)))))

(deftest atomic-consumption-returns-one-winner-and-refuses-invalid-values
 (let [key :generation-state-consumption cell (state/cell! key {:code :pending})
       parent (erlang/self)
       consume (fn [] (state/get-and-update! key {} (fn [m] (tuple (:code m) (dissoc m :code)))))
       token (env/capture)
       workers (mapv (fn [_] (erlang/spawn (fn []
                              (env/bind token)
                              (erlang/send parent [:consumed (consume)])))) (range 16))]
  (try
   (let [answers (mapv (fn [_] (receive [:consumed value] value (after 2000 :timeout))) workers)]
    (is (= 1 (count (filter #{:pending} answers))))
    (is (= 15 (count (filter nil? answers))))
    (is (= {} @cell)))
   (is (= :invalid-runtime-update (kind #(state/get-and-update! key {} (fn [_] :bad)))))
   (is (= :invalid-runtime-state (kind #(state/get-and-update! key {} (fn [_] (tuple :bad {:callback (fn [] :unsafe)}))))))
   (is (= {} @cell))
   (finally
    (doseq [worker workers] (when (Process/alive? worker) (Process/exit worker :kill)))
    (persistent_term/erase key)))))

(deftest sealed-runtime-state-cells-never-use-legacy-fallback
 (let [key :generation-state-test value (atom {:version 1})
       old (gen/prepare! {:application-id "state-test"
                         :stable-namespaces #{"reload.state"}
                         :sources {"state.application" "(ns state.application (:require [reload.state :as state])) (defn init [cells] (state/bind! cells)) (defn read [key] (state/get key :fallback)) (defn write [key value] (state/put! key value)) (defn invalid-write [key] (state/put! key {:callback (fn [] :unsafe)}))"}})]
  (try
   (state/put! key :legacy)
   (is (= :legacy (state/get key)))
   (is (= :bound (gen/invoke! old "state.application/init" [{key value}])))
   (is (= {:version 1} (gen/invoke! old "state.application/read" [key])))
   (is (= {:version 2} (gen/invoke! old "state.application/write" [key {:version 2}])))
   (is (= {:version 2} @value))
   (is (= :legacy (state/get key)))
   (is (= :missing-runtime-resource (kind #(gen/invoke! old "state.application/read" [:absent]))))
   (is (= :invalid-runtime-state (kind #(gen/invoke! old "state.application/invalid-write" [key]))))
   (is (= {:version 2} @value))
   (finally (gen/retire! old) (persistent_term/erase key)))))

(deftest explicit-shared-cells-retain-one-legacy-identity-and-isolate-managed-state
 (let [key :generation-state-cell-test legacy (state/cell! key {:legacy true})
       a (gen/prepare! {:application-id "state-cells" :sources {"state.cell" "(ns state.cell) (defn id [] 1)"}})
       b (gen/prepare! {:application-id "state-cells" :sources {"state.cell" "(ns state.cell) (defn id [] 2)"}})
       managed (atom {:managed true})]
  (try
   (is (= legacy (state/cell! key :ignored)))
   (is (= {:legacy true} @legacy))
   (gen/with! a #(state/bind! {key managed}))
   (is (= managed (gen/with! a #(state/cell! key :ignored))))
   (is (= {:managed true} @(gen/with! a #(state/cell! key :ignored))))
   (is (= :missing-runtime-resource (kind (fn [] (gen/with! b (fn [] (state/cell! key :ignored)))))))
   (is (= legacy (state/cell! key :ignored)))
   (state/put! :generation-state-cell-invalid :different)
   (is (= :invalid-runtime-cell (kind #(state/cell! :generation-state-cell-invalid {}))))
   (finally (gen/retire! a) (gen/retire! b)
    (persistent_term/erase key) (persistent_term/erase :generation-state-cell-invalid)))))
