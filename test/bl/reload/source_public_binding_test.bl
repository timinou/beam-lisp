; Public binding regressions; coupled native acceptance pending.
(ns reload.source-public-binding-test
 (:require [reload.generation :as g] [reload.public-binding-fixture :as sdk] [reload.public-binding-counter :as counter]))
(defn- reason [action]
 (try (action) nil (catch error
  (if (and (erlang/is_map error) (maps/is_key :original error))
   (maps/get :original error) (:kind (ex-data error))))))
(defn- prepared []
 (g/prepare!
  {:sources {"binding.app"
    "(ns binding.app (:require [reload.public-binding-fixture :as sdk :refer [public-step]] [datom :as d]))
     (defn- own-step [x] (+ x 3))
     (defn lookup [namespace binding x] (let [found (sdk/fetch-member namespace binding)] ((second found) x)))
     (defn query [op x] (d/q {:find '[?out] :in '[$ ?x] :where [[(list op '?x) '?out]]} [] x))"}
   :stable-namespaces #{"reload.public-binding-fixture" "datom"}}))
(deftest actual-provider-reflection-permits-public-and-own-sealed-functions
 (let [generation (prepared) physical (get (:mapping generation) "binding.app")]
  (try
   (is (= 6 (g/invoke! generation "binding.app/lookup" ["reload.public-binding-fixture" "public-step" 4])))
   (is (= 7 (g/invoke! generation "binding.app/lookup" [physical "own-step" 4])))
   (is (= 6 (g/invoke! generation "binding.app/lookup" [physical "public-step" 4])))
   (is (= :source_public_binding_refused
     (reason #(g/invoke! generation "binding.app/lookup" [physical "sdk/private-step" 4]))))
   (is (= :source_public_binding_refused
     (reason #(g/invoke! generation "binding.app/lookup" ["reload.public-binding-fixture" "private-per-env" 4]))))
   (is (= 0 (sdk/count-initializers)))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))
(deftest actual-query-resolver-cannot-mint-private-sdk-callbacks
 (let [generation (prepared)]
  (try
   (is (= #{[6]} (g/invoke! generation "binding.app/query" [(symbol "reload.public-binding-fixture/public-step") 4])))
   (is (= :source_public_binding_refused
     (reason #(g/invoke! generation "binding.app/query" [(symbol "reload.public-binding-fixture/private-step") 4]))))
   (is (= :source_public_binding_refused
     (reason #(g/invoke! generation "binding.app/query" [(symbol "reload.public-binding-fixture/private-per-env") 4]))))
   (is (= 0 (sdk/count-initializers)))
   (finally (g/retire! generation)))))
(deftest native-generic-lookup-keeps-private-binding-abi
 (let [native (BeamLisp.Env/source_public_fetch "reload.public-binding-fixture" "private-step")]
  (is (= :ok (first native)))
  (is (= 104 ((second native) 4)))
  (is (= false (BeamLisp.Env/source_execution_active?)))))

(deftest uninitialized-referred-provider-cannot-fall-through-to-core-map
 (let [generation (prepared) physical (get (:mapping generation) "binding.app")
       private "reload.unready-private-map" public "reload.unready-public-map"]
  (try
   ;; Actual SDK artifacts are derived by normal automatic closure staging.
   ;; The test declares native aliases/references only; it creates no SDK receipt,
   ;; cache entry, metadata descriptor, lease or loaded/ready flag.
   (is (BeamLisp.AOT/sdk_unit_compiled? private))
   (is (BeamLisp.AOT/sdk_unit_compiled? public))
   (is (= false (BeamLisp.Env/loaded_ns? private)))
   (is (= false (BeamLisp.Env/loaded_ns? public)))
   (BeamLisp.Env/with_env (:scope generation)
    (fn []
     (BeamLisp.Loader/declare_require private nil (list "map"))
     (BeamLisp.Env/add_refer physical "map" private)))
   (is (= :source_public_binding_refused
     (reason #(g/invoke! generation "binding.app/lookup" [physical "map" 4]))))
   (BeamLisp.Env/with_env (:scope generation)
    (fn []
     (BeamLisp.Loader/declare_require public nil (list "map"))
     (BeamLisp.Env/add_refer physical "map" public)))
   (is (= :source_public_binding_unavailable
     (reason #(g/invoke! generation "binding.app/lookup" [physical "map" 4]))))
   (is (= 0 (counter/value)))
   (is (= false (BeamLisp.Env/loaded_ns? private)))
   (is (= false (BeamLisp.Env/loaded_ns? public)))
   (finally (g/retire! generation)))))
