(ns reload.registry-test
 (:require [reload.generation :as g] [reload.registry :as registry] [reload.registry-data :as data] [env]))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest development-registries-are-scope-owned-and-load-reference-only-providers
 (let [root (str (System/tmp_dir!) "/registry-unloaded-" (erlang/unique_integer (list :positive)))
       a (env/fork) b (env/fork)]
  (try
   (File/mkdir_p! (str root "/registry"))
   (File/write! (str root "/registry/unloaded-provider.bl")
                 "(ns registry.unloaded-provider) (defn value [] :loaded)")
   (env/with-env a
    (fn []
     (BeamLisp.Env/add_search_path root)
     (registry/register! "registry.scope-owned" {:id :probe :callbacks {:run "registry.unloaded-provider/value"}})
     (is (= :loaded ((:run (registry/lookup "registry.scope-owned" :probe)))))))
   (is (nil? (env/with-env b #(registry/lookup "registry.scope-owned" :probe))))
   (is (nil? (registry/lookup "registry.scope-owned" :probe)))
   (finally (env/destroy a) (env/destroy b) (File/rm_rf! root)))))
(defn- options [value]
 {:application-id "registry-test" :roots ["registry.caller"]
  :stable-namespaces #{"reload.registry"}
  :resources {:configuration {:registries {"registry.test" {:probe {:label "Probe" :callbacks {:run "registry.handlers/value"}}}}}}
  :sources {"registry.handlers" (str "(ns registry.handlers) (defn value [x] (+ x " value ")) (def not-callable 7)")
            "registry.caller" "(ns registry.caller (:require [reload.registry :as registry])) (defn provider [id] (registry/lookup \"registry.test\" id)) (defn mutate [entry] (registry/register! \"registry.test\" entry))"}})

(deftest registry-callbacks-are-exact-generation-references-with-no-global-fallback
 (let [old (g/prepare! (options 1)) next (g/prepare! (options 2))
       a (g/invoke! old "registry.caller/provider" [:probe])
       b (g/invoke! next "registry.caller/provider" [:probe])
       hold (g/with! old #(g/capture!))]
  (try
   (is (= 11 ((:run a) 10)))
   (is (= 12 ((:run b) 10)))
   (is (= :probe (:id a)))
   (is (= "Probe" (:label a)))
   (is (g/runtime-value? (:registries old)))
   (is (contains? (:mapping old) "registry.handlers"))
   (is (= :immutable-registry-required
        (kind #(g/invoke! old "registry.caller/mutate" [{:id :probe :label "Changed"}]))))
   (is (= "Probe" (:label (g/invoke! next "registry.caller/provider" [:probe]))))
   (is (nil? (g/invoke! next "registry.caller/provider" [:missing])))
   (is (= :waiting (:status (g/retire! old))))
   (is (= 11 ((:run a) 10)))
   (g/release! hold)
   (is (= :retired (:status (g/retire! old))))
   (is (= :retired-generation (kind #((:run a) 10))))
   (is (= 12 ((:run b) 10)))
   (finally (g/release! hold) (g/retire! old) (g/retire! next)))))

(deftest invalid-registry-references-refuse-before-candidate-publication
 (doseq [[reference expected] [["absent.handlers/value" :unsealed-registry-reference]
                               ["registry.handlers/missing" :invalid-registry-reference]
                               ["registry.handlers/not-callable" :invalid-registry-reference]]]
  (is (= expected (kind #(g/prepare! (assoc-in (options 1)
                 [:resources :configuration :registries "registry.test" :probe :callbacks :run] reference))))))
 (is (= :invalid-generation
      (kind #(g/prepare! (assoc-in (options 1)
               [:resources :configuration :registries "registry.test" :probe :callbacks :run] (fn [] :unsafe))))))
 (is (= :invalid-registry-declaration
      (kind #(data/registries {:configuration {:registries {"duplicate" {:probe {} "probe" {}}}}})))))

(deftest development-registration-stores-only-data-and-does-not-cross-into-managed-code
 (let [name "registry.test" key (tuple :reload.registry name)
       p {:id :development :label "Development"}
       graph (g/prepare! (options 3))]
  (try
   (is (= p (registry/register! name p)))
   (is (= "Development" (:label (registry/lookup name :development))))
   (is (nil? (g/invoke! graph "registry.caller/provider" [:development])))
   (is (= :invalid-registry-declaration
        (kind #(registry/register! name {:id :unsafe :run (fn [] :unsafe)}))))
   (is (nil? (registry/lookup name :unsafe)))
   (finally (g/retire! graph) (persistent_term/erase key)))))
