(ns reload.module-inventory-cache-test
 (:require [reload.generation :as g] [env]))

(defn- inventory [planned namespace]
 ((BeamLisp.Env/fetch_exact! "reload.generation" "analyzed-namespace-modules") planned namespace))

(deftest stable-inventory-cache-invalidates-on-actual-namespace-publication
 (let [scope (env/fork) cache (atom {:entries {} :hits 0 :scans 0})
       planned {:mapping {} :module-inventory-cache cache} namespace "inventory.cache.provider"]
  (try
   (env/with-env scope
    (fn []
     (env/eval "(ns inventory.cache.provider) (defn first-value [] 1)")
     (let [first-modules (set (inventory planned namespace))]
      (is (seq first-modules))
      (is (= first-modules (set (inventory planned namespace))))
      (is (= {:hits 1 :scans 1} (select-keys @cache [:hits :scans])))
      ;; Publication changes both binding evidence and the actual emitted body.
      (env/eval "(ns inventory.cache.provider) (defn later-value [] 2)")
      (let [body (elem (first (BeamLisp.Env/ns_definition namespace "later-value")) 4)
            modules (set (inventory planned namespace))]
       (is (contains? modules body))
       (is (not (contains? first-modules body)))
       (is (= 2 (:scans @cache)))))))
   (finally (env/destroy scope)))))

(deftest owned-inventories-never-borrow-the-stable-cache
 (let [scope (env/fork) namespace "inventory.cache.owned"
       cache (atom {:entries {} :hits 0 :scans 0})
       planned {:mapping {"logical.owned" namespace} :module-inventory-cache cache}]
  (try
   (env/with-env scope
    (fn []
     (env/eval "(ns inventory.cache.owned) (defn first-value [] 1)")
     (let [first-modules (set (inventory planned namespace))]
      (env/eval "(ns inventory.cache.owned) (defn later-value [] 2)")
      (let [body (elem (first (BeamLisp.Env/ns_definition namespace "later-value")) 4)]
       (is (not (contains? first-modules body)))
       (is (contains? (set (inventory planned namespace)) body))
       (is (= {:hits 0 :scans 0} (select-keys @cache [:hits :scans])))))))
   (finally (env/destroy scope)))))

(deftest whole-graph-checks-reuse-stable-inventory-without-retaining-phantom-code
 (let [start (erlang/monotonic_time :microsecond)
       graph (g/prepare! {:sources {"inventory.cache.graph"
                  "(ns inventory.cache.graph) (defn early [] 41) (defn later [] (+ 1 (early))) (def answer (later))"}})]
  (try
   (is (= 42 (g/invoke! graph "inventory.cache.graph/later" [])))
   (is (pos? (:hits (:preparation-metrics graph))))
   (println "module-inventory-cache-metrics"
            (assoc (:preparation-metrics graph) :microseconds (- (erlang/monotonic_time :microsecond) start)))
   (finally (g/retire! graph)))))
