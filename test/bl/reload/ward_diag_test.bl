; ward_diag_test.bl — BUG-041, the observability half: a contaminated run is
; NAMED, and a clean one says nothing.
;
; The ledger is only worth having if it is TRUE in both directions, so each test
; below drives a real boundary (ward's own run, or the two public boundary
; calls) and asserts on what the ledger made of it:
;
;   * a message the runner did not send        → a warning naming the message
;   * a memo key with no env-id in it          → a warning naming surface + key
;   * a clean run                              → warnings empty, report nil
;
; The surfaces are registered through the public `register!` because that is how
; the analyzer's memos are watched too — a test registers one of its own rather
; than reaching into lsp.

(ns reload.ward-diag-test
  (:require [reload.ward-diag :as wd] [reload.ward :as ward]))

;; ── the mailbox surface ────────────────────────────────────────────────────

(def ^:private noisy-source
  "A file that sends the runner a message it did not send itself — the shape
   BUG-041's mailbox pollution had, made deliberate. It reaches the runner
   through the ledger's own `runner`, which is the process the observer ran in."
  "(ns ward.diag.noisy)\n
   (let [r (reload.ward-diag/runner)]\n
     (when (some? r) (erlang/send r [:ward-diag-probe 1])))\n
   (deftest ok (is true))\n")

(def ^:private quiet-source
  "A file that minds its own business."
  "(ns ward.diag.quiet)\n(deftest ok (is true))\n")

(deftest a-message-the-runner-did-not-send-is-named
  (wd/clear!)
  (let [r (ward/run (list noisy-source) (wd/observer))
        mail (filter (fn [f] (= :mailbox (:surface f))) (wd/warnings))]
    (is (= 1 (count (:files r))))
    (is (= 1 (count mail)) "the runner's foreign message is one warning")
    (is (= [:ward-diag-probe] (vec (map (fn [f] (:tag f)) mail)))
        "the warning names the message's tag")
    (is (= 1 (count (filter (fn [f] (includes? (:message f) "ward-diag-probe")) mail)))
        "the warning prints the message itself")))

(deftest a-clean-run-says-nothing
  (wd/clear!)
  (let [r (ward/run (list quiet-source) (wd/observer))]
    (is (= 0 (count (wd/warnings))) "nothing crossed a boundary")
    (is (nil? (wd/report)) "and the clean path prints NOTHING")))

;; ── the memo surface ───────────────────────────────────────────────────────

(deftest an-unscoped-memo-key-is-named
  ; A surface whose keys carry no env-id is readable from EVERY fork: this is
  ; the pre-BUG-041 shape of lsp's caches ([sha], not [env-id sha]), kept here
  ; as a fixture so the ledger's warning has something true to fire on.
  (wd/clear!)
  (let [memo (atom [])]
    (wd/register! "demo/memo"
                  (fn [] (map (fn [p] {:key (get p 0) :owner nil}) (deref memo))))
    (wd/watch! {})
    (wd/file-start! "demo.unscoped")
    (swap! memo conj [["demo/sha"] {:diagnostics 6}])
    (wd/file-done! "demo.unscoped")
    (let [memo-ws (filter (fn [f] (= "demo/memo" (:surface f))) (wd/warnings))]
      (is (= 1 (count memo-ws)) "an env-less key is one warning")
      (is (= [["demo/sha"]] (vec (map (fn [f] (:key f)) memo-ws)))
          "the warning names the key a reader would hit"))
    (wd/clear!)))

(deftest a-scoped-memo-write-is-recorded-not-warned
  ; With the env-id in the key — what lsp does after BUG-041 — a write is the
  ; file's OWN state: recorded so a reader can see it moved, never a warning,
  ; because the scope is what keeps it out of every other fork.
  (wd/clear!)
  (let [memo (atom [])]
    (wd/register! "demo/scoped"
                  (fn [] (map (fn [p] {:key (get p 0) :owner (get p 1)}) (deref memo))))
    (wd/watch! {})
    (wd/file-start! "demo.scoped")
    (swap! memo conj [[:global "demo/sha"] :global])
    (wd/file-done! "demo.scoped")
    (let [ws (wd/warnings)
          writes (filter (fn [f] (= :write (:kind f))) (wd/findings))]
      (is (= 0 (count ws)) "an env-scoped key is not a leak")
      (is (= 1 (count writes)) "the write is recorded")
      (is (= [[:global "demo/sha"]] (vec (map (fn [f] (:key f)) writes)))
          "and named by its key"))
    (wd/clear!)))

;; ── the ledger is off unless asked for ─────────────────────────────────────

(deftest the-clean-path-costs-nothing
  ; No observer installed ⇒ nothing is inspected. A plain `ward/run` (what
  ; every other test file and `bl test` without --diagnose does) must leave the
  ; ledger empty and silent.
  (wd/clear!)
  (let [r (ward/run (list quiet-source))]
    (is (= 1 (:passed r)))
    (is (= 0 (count (wd/findings))) "no boundaries were observed")
    (is (nil? (wd/report)))))
