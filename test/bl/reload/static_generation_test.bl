(ns reload.static-generation-test
 (:require [reload.generation :as generation] [env]))

(defn- refused [f]
 (try (f) nil (catch error (:kind (ex-data error)))))
(defn- opts [body native]
 {:sources {"static.integration" (str "(ns static.integration) " body)}
  :native-modules native})

(deftest literal-native-apply-is-sealed-with-original-identity
 (let [input (opts "(defn run [a b] (erlang/apply :erlang :tuple_size (list (erlang/list_to_tuple (list a b)))))" #{"erlang"})
       plan (generation/plan input) graph (generation/prepare! plan)]
  (try
   (is (= input (:input plan)))
   (is (= (:digest plan) (:digest graph)))
   (is (= 2 (generation/invoke! graph "static.integration/run" [10 20])))
   ;; Planning keeps source intact; exact native proof happens after expansion.
   (is (String/contains? (first (vals (:sources plan))) "erlang/apply"))
   (finally (generation/retire! graph)))))

(deftest literal-native-arguments-execute-once-in-order
 (let [graph (generation/prepare!
              (opts "(defn run [] (erlang/apply :erlang :list_to_tuple (list (list (do (Process/put :static-order [1]) 1) (do (Process/put :static-order (conj (Process/get :static-order) 2)) 2)))))" #{"erlang" "Process"}))]
  (try
   (is (= {:tuple [1 2]} {:tuple (vec (erlang/tuple_to_list (generation/invoke! graph "static.integration/run" [])))}))
   (is (= [1 2] (Process/get :static-order)))
   (finally (Process/delete :static-order) (generation/retire! graph)))))

(deftest static-specialization-does-not-grant-native-authority
 (is (= :undeclared-native-target
      (refused #(generation/plan (opts "(defn run [] (erlang/apply :crypto :hash (list :sha256 \"x\")))" #{"erlang"})))))
 (doseq [[module function] [["persistent_term" "get"] ["code" "purge"] ["erlang" "spawn"] ["Elixir.BeamLisp.Env" "fetch!"]]]
  (is (= :dynamic-code-dependency
       (refused #(generation/plan
          (opts (str "(defn run [] (erlang/apply :" module " :" function " (list :x)))")
                #{"persistent_term" "code" "erlang" "BeamLisp.Env"}))))))
 (doseq [body ["(defn run [m] (erlang/apply m :hash (list :sha256 \"x\")))"
              "(defn run [f] (erlang/apply :crypto f (list :sha256 \"x\")))"
              "(defn run [args] (erlang/apply :crypto :hash args))"]]
  (is (= :dynamic-code-dependency (refused #(generation/plan (opts body #{"erlang" "crypto"})))))))

(deftest effectful-native-initializer-is-refused-before-io
 (let [path (str (System/get_env "HOME") "/tmp/static-must-not-write-" (erlang/unique_integer (list :positive)))]
  (is (= :effectful-generation
       (refused #(generation/prepare!
          (opts (str "(def value (erlang/apply :Elixir.File :write! (list " (pr-str path) " \"unsafe\")))") #{"File"})))))
  (is (not (File/exists? path)))))

(deftest loaded-bl-native-spelling-cannot-be-substituted
 (env/eval "(ns statictarget) (defn hash [x] :application-code)")
 (is (= :ambiguous-native-target
      (refused #(generation/plan (opts "(defn run [] (erlang/apply :statictarget :hash (list 1)))" #{"statictarget"}))))))

(deftest otp-process-and-timer-producers-remain-owned-only
 (doseq [[module function] [["gen_server" "start"] ["gen_server" "start_link"]
                            ["gen_statem" "start_monitor"] ["gen_event" "start"]
                            ["supervisor" "start_child"] ["timer" "apply_after"]
                            ["timer" "apply_interval"] ["timer" "send_after"]
                            ["timer" "send_interval"] ["timer" "exit_after"] ["timer" "kill_after"]]]
  (let [native #{module} direct (str "(defn run [] (" module "/" function " :unsafe))")
        literal (str "(defn run [] (erlang/apply :" module " :" function " (list :unsafe)))")]
   (is (= :unmanaged-generation-producer (refused #(generation/plan (opts direct native)))))
   (is (= :dynamic-code-dependency (refused #(generation/plan (opts literal native)))))))
 (let [g (generation/prepare! (opts "(defn run [] (erlang/apply :timer :sleep (list 0)))" #{"timer"}))]
  (try (is (= :ok (generation/invoke! g "static.integration/run" [])))
   (finally (generation/retire! g)))))
