(ns reload.managed-spawn-test
 (:require [reload.generation :as generation] [test.support.source-fixtures :as fixtures]))
(fixtures/effects!)

(defn- wait-dead [pid]
 (let [ref (erlang/monitor :process pid)]
  (receive [:DOWN observed :process _ _] :when (= ref observed) true
   (after 10000 (do (erlang/demonitor ref (list :flush)) false)))))

(defn- prepare [kind]
 (generation/prepare!
  {:application-id (str "managed-owned-" kind)
   :native-modules #{"erlang" "SourceEffectObserverFixture"}
   :sources
   {"owned.dependency"
    "(ns owned.dependency) (defn value [] :old-dependency) (defn physical [] (fn [] nil))"
    "owned.entry"
    (str "(ns owned.entry (:require [owned.dependency :as dependency])) "
         "(defn start [parent] "
         (if (= kind :future) "(future (do " "(spawn (fn [] ")
         "(SourceEffectObserverFixture/notify parent [:entered (erlang/self)]) "
         "(receive :finish (SourceEffectObserverFixture/notify parent [:value (dependency/value)])))))")}}))

(defn- prove-retention [kind cancel?]
 (let [g (prepare kind) execution (atom nil)]
  (try
   (let [work (generation/invoke! g "owned.entry/start" [(erlang/self)])
         worker (receive [:entered pid] pid (after 10000 nil))
         _ (reset! execution [work worker])
         dependency (generation/invoke! g "owned.dependency/physical" [])]
    (is (erlang/is_pid worker))
    ;; The dependency has never executed. The request lease has ended, and
    ;; the worker's thunk lives in a different module from this dependency.
    (is (= false (BeamLisp.Env/retire_modules!
                   (BeamLisp.Env/callback_modules dependency))))
    (is (= :waiting (:status (generation/retire! g))))
    (if cancel?
     (is (BeamLisp.Refs/future_cancel work))
     (do
      (erlang/send worker :finish)
      (is (= :old-dependency
           (receive [:value value] value (after 10000 :timeout))))
      (when (= :future kind) @work)))
    (is (wait-dead worker))
    (is (= :retired (:status (generation/retire! g)))))
   (finally
    (when @execution
     (let [[work worker] @execution]
      (when (and worker (Process/alive? worker))
       (if (= :future kind) (BeamLisp.Refs/future_cancel work)
        (erlang/exit worker :kill)))))
    (generation/retire! g)))))

(deftest managed-spawn-pins-transitive-dependencies (prove-retention :spawn false))
(deftest managed-future-pins-transitive-dependencies (prove-retention :future false))
(deftest cancelled-managed-future-releases-whole-graph (prove-retention :future true))
