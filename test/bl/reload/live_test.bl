(ns reload.live-test (:require [reload] [proc.evolve :as ev] [env]))
(defn initial-spec []
 {:version 1 :digest "live-one" :accept? (fn [m] (= :inc m))
  :check-state (fn [s] (erlang/is_integer s))
  :handler (fn [_ s] {:reply (inc s) :state (inc s)})})
(defn unique-ns [] (str "live.generation.g" (erlang/unique_integer (list :positive))))
(defn candidate [n]
 {:digest (str "live-two-" n)
  :sources {n (str "(ns " n ") (defn handle [msg state] {:reply (+ state msg) :state (+ state msg)})")}
  :resolve (fn [] {:version 2 :digest (str "live-two-" n)
                   :handler (BeamLisp.Env/fetch! n "handle")
                   :accept? (fn [m] (erlang/is_integer m))
                   :check-state (fn [s] (erlang/is_integer s))
                   :migrate-state identity :upcast (fn [m] (if (= :inc m) 1 m))})})

(deftest production-generation-switch-keeps-owner-and-old-message-contract
 (let [p (ev/start! (initial-spec) 0) n (unique-ns) c (candidate n)]
  (try
   (reload/set-enabled! true)
   (is (= 1 (ev/call! p 1 :inc)))
   (is (= :applied (:status (reload/activate! p 1 c))))
   (is (= p (:pid (ev/status p))))
   (is (= 2 (ev/call! p 1 :inc)))
   (is (= 5 (ev/call! p 2 3)))
   (is (= :already-applied (:status (reload/activate! p 1 c))))
   ;; The ordinary mutable gate cannot overwrite an active immutable generation.
   (reload/stage (str "(ns " n ") (defn handle [msg state] {:reply 0 :state 0})"))
   (is (= :held (:status (reload/commit))))
   (is (some (fn [e] (= :immutable-generation (:kind e))) (:errors (reload/status))))
   (is (= 6 (ev/call! p 1 :inc)))
   (finally (reload/abort) (reload/set-enabled! nil) (GenServer/stop p)))))

(deftest unsafe-candidates-and-disabled-policy-preserve-serving-generation
 (let [p (ev/start! (initial-spec) 0) n (unique-ns) c (candidate n)]
  (try
   (reload/set-enabled! false)
   (is (= :held (:status (reload/activate! p 1 c))))
   (reload/set-enabled! true)
   (let [effect (assoc c :sources {n (str "(ns " n ") (throw (ex-info \"must not execute\" {}))")})]
    (is (= :blocked (:status (reload/activate! p 1 effect))))
    (is (not (BeamLisp.Env/loaded_ns? n))))
   (is (= 1 (ev/call! p 1 :inc)))
   (is (= :stale (:status (reload/activate! p 9 c))))
   (is (= 1 (:version (ev/status p))))
   (finally (reload/set-enabled! nil) (GenServer/stop p)))))

(deftest attached-preview-cannot-silently-authorize-message-publication
 (try
  (reload/set-enabled! true)
  (reload/abort)
  (reload/stage (str "(ns " (unique-ns) ") (defn answer [] 1)"))
  (reload/attach {:strategy :quiesce :modules ["busy"] :mailbox-count (fn [_] 10)})
  (is (= :held (:status (reload/commit))))
  (is (some (fn [e] (= :message-migration (:kind e))) (:errors (reload/status))))
  (finally (reload/abort) (reload/set-enabled! nil))))

(deftest prepared-generations-stay-immutable-when-state-migration-refuses
 (let [p (ev/start! (initial-spec) 0) n (unique-ns) c (candidate n)
       bad (assoc c :resolve (fn [] (assoc ((:resolve c)) :check-state (fn [_] false))))]
  (try
   (reload/set-enabled! true)
   (is (= :refused (:status (reload/activate! p 1 bad))))
   (is (= 1 (:version (ev/status p))))
   (is (= 1 (ev/call! p 1 :inc)))
   (reload/stage (str "(ns " n ") (defn handle [msg state] {:reply 0 :state 0})"))
   (is (= :held (:status (reload/commit))))
   (is (some (fn [e] (= :immutable-generation (:kind e))) (:errors (reload/status))))
   (finally (reload/abort) (reload/set-enabled! nil) (GenServer/stop p)))))
