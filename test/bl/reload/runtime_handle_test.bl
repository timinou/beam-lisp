(ns reload.runtime-handle-test
 (:require [reload.generation :as generation] [datom]))

(deftest raw-struct-inventory-does-not-dispatch-domain-sequences
 ;; Datom Conn is a native map AND Seqable over datoms, not key/value pairs.
 ;; Validating ownership handles must inspect raw fields without querying data.
 (let [conn (datom/connect [{:db/ident :sample/value :db/valueType :db.type/string}])]
  (try
   (is (generation/runtime-value? {:store conn}))
   (datom/transact! conn [{:db/id -1 :sample/value "present"}])
   (is (generation/runtime-value? {:store conn}))
   (is (generation/runtime-value? (atom {:store conn})))
   (is (generation/runtime-value? (Range/new 1 3)))
   (is (not (generation/runtime-value? (maps/put :hidden (fn [] :unsafe) {:__struct__ :Elixir.Range}))))
   (is (not (generation/runtime-value? (atom {:store conn :callback (fn [] :unsafe)}))))
   (finally (datom/close! conn)))))
