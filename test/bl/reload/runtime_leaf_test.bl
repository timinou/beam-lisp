(ns reload.runtime-leaf-test
 (:require [reload.execution :as execution] [reload.generation :as generation]
           [reload.state :as state] [env]))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn- graph [app version]
 (generation/prepare! {:application-id app
   :sources {"runtime.leaf.sample" (str "(ns runtime.leaf.sample) (defn value [] " version ")")}}))

(deftest one-runtime-identity-survives-api-mixing-inheritance-and-old-code-retirement
 (let [old (graph "runtime-leaf" 1) fresh (graph "runtime-leaf" 2)
       cell (atom {:value 1})]
  (try
   (is (= :bound (generation/with! old #(execution/bind-runtime! {:leaf/cell cell}))))
   (is (generation/runtime-bound? old))
   (is (execution/runtime-bound? old))
   (is (= :already-bound (execution/with! old #(generation/bind-runtime! {:leaf/cell cell}))))
   (is (= :inherited (execution/inherit-runtime! fresh old)))
   (is (= :already-bound (generation/inherit-runtime! fresh old)))
   (is (= cell (generation/with! fresh #(generation/runtime-resource :leaf/cell))))
   (is (= cell (execution/with! old #(execution/runtime-resource :leaf/cell))))
   (is (= {:value 2} (generation/with! fresh #(state/put! :leaf/cell {:value 2}))))
   (is (= {:value 2} (execution/with! old #(state/get :leaf/cell))))
   (is (= :retired (:status (generation/retire! old))))
   (is (not (execution/runtime-bound? old)))
   (is (= :retired-generation (kind #(execution/with! old (fn [] :unexpected)))))
   (is (= {:value 2} (execution/with! fresh #(state/get :leaf/cell))))
   (finally (generation/retire! old) (generation/retire! fresh)))))

(deftest owner-death-cross-application-and-executable-bindings-still-refuse
 (let [old (graph "runtime-leaf-owner" 1) wrong (graph "runtime-leaf-other" 2)
       parent (erlang/self) ticket (erlang/make_ref) cell (atom {})]
  (try
   (is (= :invalid-runtime-bindings
          (kind #(generation/with! old
                   (fn [] (execution/bind-runtime! {:callback (fn [] :unsafe)}))))))
   (let [owner (spawn
                (fn []
                 (generation/with! old #(execution/bind-runtime! {:leaf/cell cell}))
                 (erlang/send parent [:bound-runtime ticket])
                 (receive :finish :ok)))
         monitor (erlang/monitor :process owner)]
    (receive [:bound-runtime seen] :when (= seen ticket) :ok (after 5000 :test-timeout))
    (is (execution/runtime-bound? old))
    (is (= :runtime-inheritance-refused (kind #(execution/inherit-runtime! wrong old))))
    (erlang/send owner :finish)
    (receive [:DOWN seen :process pid _] :when (and (= seen monitor) (= pid owner)) :ok
     (after 5000 :test-timeout))
    (is (not (generation/runtime-bound? old)))
    (is (= :missing-runtime-resource
           (kind #(generation/with! old (fn [] (execution/runtime-resource :leaf/cell)))))))
   (finally (generation/retire! old) (generation/retire! wrong)))))

(deftest lightweight-capability-name-resolution-preserves-existing-atom-policy
 (is (= :Elixir.String (env/module-atom "Elixir.String")))
 (is (= :erlang (env/module-atom "erlang")))
 (let [unknown (str "never-an-environment-module-" (erlang/unique_integer (list :positive)))]
  (is (nil? (env/module-atom unknown)))
  (is (= :absent (try (erlang/binary_to_existing_atom unknown :utf8) :unexpected (catch _ :absent)))))
 (is (nil? (env/module-atom 17))))
