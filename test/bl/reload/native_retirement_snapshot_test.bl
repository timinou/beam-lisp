; Production candidate only. Real native module leases, no fault injection.
(ns reload.native-retirement-snapshot-test
 (:require [reload.generation :as g]))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(deftest genuine-native-batch-lease-reservation-retries-unchanged-code
 (let [a (g/prepare! {:application-id "retirement-snapshot-lease"
                    :sources {"retirement.snapshot" "(ns retirement.snapshot) (defn value [] 27)"}})
       lease (BeamLisp.Env/retain_code! (to-list (:modules a)))
       released (atom false)]
  (try
   (is (= {:status :waiting :reason :executing-code} (g/retire! a)))
   (is (nil? (g/native-retirement-outcome a)))
   (is (every? erlang/module_loaded (:modules a)))
   (is (= :unattested-retirement-outcome
          (kind #(g/retire! (assoc a :state (atom @(:state a)))))))
   (is (nil? (g/native-retirement-outcome a)))
   (is (= {:status :waiting :reason :executing-code} (g/retire! a)))
   (BeamLisp.Env/release_code! lease) (reset! released true)
   (is (= :retired (:status (g/retire! a))))
   (is (= :complete (:phase (g/native-retirement-outcome a))))
   (is (every? #(not (erlang/module_loaded %)) (:modules a)))
   (finally
    (when-not @released (BeamLisp.Env/release_code! lease))
    (g/retire! a)))))
