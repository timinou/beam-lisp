; image_test.bl — who may mutate the image, and how that is decided.
;
; The reload policy gates MUTATING reloads (commit → apply-bundle!): reading is
; always safe, writing is not. What decides used to be "is Mix loaded?", and that
; question stops having an answer the day Mix is deleted — leaving every
; development image looking like production and refusing every mutating reload.
;
; So the kind of image decides, and whoever built the image declares it:
;
;   BL_BIN set            a drop  (the Rust launcher names its own compound)
;   BEAM_LISP_IMAGE set   a release (the shell launcher states its kind)
;   neither               development (a plain VM: mix bl, bl test, CI)
;
; plus two ways to overrule it — `BEAM_LISP_DEV=1` (a tree declaring itself, which
; is what beam-lisp's own env.bl does) and `BEAM_LISP_RELOAD=1` (an operator
; opting in on a packaged node).
;
; Every case here sets and then clears the environment, and `bl test` runs each
; FILE isolated, so nothing leaks into another file's VM.
(ns test.reload.image
  (:require [reload :as r]))

(defn- clear! []
  (System/delete_env "BL_BIN")
  (System/delete_env "BEAM_LISP_IMAGE")
  (System/delete_env "BEAM_LISP_DEV")
  (System/delete_env "BEAM_LISP_RELOAD")
  (r/set-enabled! nil))

(deftest the-kind-of-image-decides
  (clear!)
  (is (= "dev" (r/image-kind)))
  (is (r/reload-enabled?) "an unpackaged VM is the developer's own")

  (System/put_env "BEAM_LISP_IMAGE" "release")
  (is (= "release" (r/image-kind)))
  (is (not (r/reload-enabled?)) "an assembled release refuses to mutate itself")

  (System/put_env "BL_BIN" "/somewhere/app")
  (is (= "drop" (r/image-kind)) "a drop's launcher states what it is")
  (is (not (r/reload-enabled?)) "and a drop refuses too: BL_BIN wins over the rest")

  (System/put_env "BEAM_LISP_RELOAD" "1")
  (is (r/reload-enabled?) "an operator may opt in, per node, with a bounded window")

  (System/put_env "BEAM_LISP_DEV" "1")
  (is (r/reload-enabled?) "and a tree may declare itself development")
  (clear!))

(deftest an-override-beats-every-signal
  (clear!)
  (System/put_env "BL_BIN" "/somewhere/app")
  (r/set-enabled! true)
  (is (r/reload-enabled?) "forcing it on wins over a packaged image")
  (r/set-enabled! false)
  (is (not (r/reload-enabled?)) "and forcing it off wins over a development one")
  (r/set-enabled! nil)
  (is (not (r/reload-enabled?)) "nil restores the environment's answer: still packaged")
  (clear!))

(deftest a-development-image-is-not-defined-by-mix
  (clear!)
  ;; The point of the change: this is `mix bl test`, a VM WITH Mix loaded, and the
  ;; answer does not consult it either way. Deleting Mix cannot flip the answer.
  (is (= "dev" (r/image-kind)))
  (is (r/reload-enabled?))
  (System/put_env "BL_BIN" "/x")
  (is (not (r/reload-enabled?)) "a packaged VM with Mix present still refuses")
  (clear!))
