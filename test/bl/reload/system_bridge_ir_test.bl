(ns reload.system-bridge-ir-test (:require [reload.system-bridge :as bridge]))

(defn- literal [value] {:op :lit :val value :ann {}})
(defn- remote [module function arguments]
 {:op :remote :mod module :fun function :args arguments :ann {}})
(defn- guard-node []
 (let [arguments (list {:op :var :name "already_evaluated" :ann {}})]
  {:op :if :ann {}
   :test (remote :erlang :function_exported
           (list (literal :Elixir.BeamLisp.Env) (literal :os_get_env) (literal 1)))
   :then (remote :Elixir.BeamLisp.Env :os_get_env arguments)
   :else {:op :if :ann {}
          :test (remote :erlang :==
                  (list (remote :erlang :get (list (literal :bl-osenv-overlay))) (literal :undefined)))
          :then (remote :Elixir.System :get_env arguments)
          :else (remote :erlang :error (list (literal :command_environment_host_unavailable)))}}))

(deftest the-exact-command-abi-retains-its-original-system-target-and-bound-arguments
 (let [node (guard-node) result (bridge/original-call node #{"System"})]
  (is (= :Elixir.System (:mod result)))
  (is (= :get_env (:fun result)))
  (is (= (:args (:then node)) (:args result)))
  (is (nil? (bridge/original-call node #{})))))

(deftest availability-and-fallback-lookalikes-are-never-normalized
 (let [node (guard-node)]
  (doseq [other [(assoc-in node [:test :mod] :Elixir.File)
                (assoc-in node [:then :fun] :os_put_env)
                (assoc-in node [:else :then :mod] :Elixir.File)
                (assoc-in node [:else :then :args] (list (literal "different")))
                (assoc-in node [:else :test :args] (list (literal :undefined) (literal :undefined)))
                (assoc-in node [:else :else :args] (list (literal :different_error)))]]
   (is (nil? (bridge/original-call other #{"System"}))))))
