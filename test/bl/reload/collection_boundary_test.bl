(ns reload.collection-boundary-test (:require [reload.generation :as generation]))
(defn source [body]
 (str "(ns collection.boundary) (defn run [quote] " body ")"))
(defn refusal [body]
 (try
  (let [g (generation/prepare! {:sources {"collection.boundary" (source body)}})]
   (generation/retire! g) :accepted)
  (catch e (:kind (ex-data e)))))
(def bodies
 ["[quote (String/upcase \"synthetic\")]"
  "#{quote (String/upcase \"synthetic\")}"
  "{quote (String/upcase \"synthetic\")}"
  "{:nested [quote (String/upcase \"synthetic\")]}" ])
(deftest every-executable-collection-requires-its-native-authority
 (doseq [body bodies] (is (= :undeclared-dependency (refusal body)))))
(deftest explicitly-granted-native-calls-still-work-in-collections
 (doseq [[body expected] (map (fn [body expected] [body expected]) bodies
                          [[:local "SYNTHETIC"] #{:local "SYNTHETIC"}
                           {:local "SYNTHETIC"} {:nested [:local "SYNTHETIC"]}])]
  (let [g (generation/prepare! {:native-modules #{"String"}
                                :sources {"collection.boundary" (source body)}})]
   (try (is (= expected (generation/invoke! g "collection.boundary/run" [:local])))
    (finally (generation/retire! g))))))
(deftest a-collection-cannot-hide-a-runtime-handle-to-a-parent-binding
 (is (= :dynamic-code-dependency
      (refusal "[quote (let [fetch (BeamLisp.Ns.Rt/remote-fun :Elixir.BeamLisp.Env :fetch_exact!) f (fetch \"collection.synthetic\" \"sentinel\")] (f))]"))))
(deftest actual-quoted-data-is-inert
 (let [g (generation/prepare! {:sources {"collection.boundary"
                                     (source "'(String/upcase \"synthetic\")")}})]
  (try (is (= (list (symbol "String/upcase") "synthetic")
              (generation/invoke! g "collection.boundary/run" [:local])))
   (finally (generation/retire! g)))))
(deftest unsupported-reader-nodes-refuse-before-compilation
 (is (= :unsupported-source-form (refusal "#Synthetic{:value (String/upcase \"synthetic\")}"))))
