(ns reload.syntax-constructor-boundary-test
 (:require [reload.generation :as g] [reload.syntax-constructor :as constructor]))

(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest native-descriptor-tuples-are-not-first-order-source-data
 (doseq [value [(tuple :$transient :map :synthetic-key)
                (tuple :$remote :Elixir.File :read!)
                (tuple :$blfn {} nil) (tuple :$macro nil)
                (tuple :ok 1)]]
  (is (= :unproved-syntax-constructor (kind #(constructor/data-shape! value))))
  (is (= :unproved-syntax-constructor
       (kind #(constructor/shape! {:op :lit :val value :ann {}} {})))))
 (is (= :data (constructor/data-shape! 'ordinary-symbol))))

(deftest metadata-cannot-hide-callables-or-resource-values
 (let [calls (atom 0)
       value (with-meta [1] {:hidden (fn [] (swap! calls inc))})]
  (is (= :unproved-syntax-constructor (kind #(constructor/data-shape! value))))
  (is (= 0 @calls))))

(deftest compiler-construction-cannot-create-a-foreign-struct-or-opaque-map-key
 (doseq [body ["{:__struct__ :Elixir.File.Stream :path \"synthetic-unused\"}"
               "{key :Elixir.File.Stream}"]]
  (is (= :unproved-syntax-constructor
       (kind #(g/prepare! {:sources {"constructor.struct"
                (str "(ns constructor.struct) (defmacro construct [key] " body ") (defn run [] (construct :__struct__))")}}))))))

(deftest compiler-owned-vector-storage-remains-a-data-constructor
 (let [graph (g/prepare! {:sources {"constructor.vector"
              "(ns constructor.vector) (defmacro box [value] [value]) (defn run [] (box 42))"}})]
  (try (is (= [42] (g/invoke! graph "constructor.vector/run" [])))
   (finally (g/retire! graph)))))
