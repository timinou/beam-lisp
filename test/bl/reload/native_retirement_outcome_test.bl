; Actual native graph retirement tests. Require genuine ordinary SDK readiness.
; No fake lease/owner/receipt and no replacement of Env.retire_modules!.
(ns reload.native-retirement-outcome-test
 (:require [reload.generation :as g] [env]))
(defn- kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn- graph [app]
 (g/prepare! {:application-id app :native-modules #{"erlang"}
  :sources {"retirement.native"
   "(ns retirement.native) (defn value [] 7)
    (defn start [owner]
     (spawn (fn [] (erlang/send owner [:retirement-child (erlang/self)])
                   (receive :finish :done))))"}}))
(defn- await-down! [pid watch]
 (receive [:DOWN seen :process stopped _] :when (and (= seen watch) (= stopped pid)) :down
  (after 5000 (throw (ex-info "Retirement fixture did not drain" {:kind :fixture-timeout})))))

(deftest reachable-retired-flag-never-issues-a-native-outcome
 (let [a (graph "retirement-outcome-flag")]
  (try
   (is (nil? (g/native-retirement-outcome a)))
   (swap! (:state a) assoc :retired true)
   (is (nil? (g/native-retirement-outcome a)))
   (is (every? erlang/module_loaded (:modules a)))
   (is (= :retired (:status (g/retire! a))))
   (is (= :native-retired (:status (g/native-retirement-outcome a))))
   (is (= :complete (:phase (g/native-retirement-outcome a))))
   (is (= :already-retired (:status (g/retire! a))))
   (finally (g/retire! a)))))

(deftest accepted-plain-child-keeps-conn-retirement-proof-unissued-until-native-drain
 (let [a (graph "retirement-outcome-child")
       child (g/invoke! a "retirement.native/start" [(erlang/self)])
       watch (Process/monitor child) completed (atom false)]
  (try
   (receive [:retirement-child seen] :when (= seen child) :ready
    (after 5000 (throw (ex-info "Managed child did not enter" {:kind :fixture-timeout}))))
   (is (Process/alive? child))
   (let [r (g/retire! a)]
    (is (= :waiting (:status r)))
    (is (= :executing-code (:reason r))))
   (is (nil? (g/native-retirement-outcome a)))
   (erlang/send child :finish)
   (await-down! child watch) (reset! completed true)
   (is (= :retired (:status (g/retire! a))))
   (is (= :native-retired (:status (g/native-retirement-outcome a))))
   (is (= [] (:pending (g/native-retirement-outcome a))))
   (finally
    (when-not @completed (erlang/send child :finish) (await-down! child watch))
    (Process/demonitor watch (list :flush)) (g/retire! a)))))

(deftest completed-private-outcome-is-bound-to-original-scope-and-native-module-set
 (let [a (graph "retirement-outcome-identity")]
  (try
   (is (= :retired (:status (g/retire! a))))
   (is (= :unattested-retirement-outcome
          (kind #(g/native-retirement-outcome (assoc a :scope (erlang/make_ref))))))
   (is (= :unattested-retirement-outcome
          (kind #(g/native-retirement-outcome (assoc a :modules [])))))
   (is (= :unattested-retirement-outcome
          (kind #(g/native-retirement-outcome (assoc a :application-id "foreign")))))
   (is (= :native-retired (:status (g/native-retirement-outcome a))))
   (finally (g/retire! a)))))

(deftest native-outcome-completes-even-if-the-private-scope-was-already-destroyed
 (let [a (graph "retirement-outcome-destroyed-scope")]
  (try
   (env/destroy (:scope a))
   (is (nil? (g/native-retirement-outcome a)))
   (is (= :retired (:status (g/retire! a))))
   (is (= :complete (:phase (g/native-retirement-outcome a))))
   (is (= :already-retired (:status (g/retire! a))))
   (finally (g/retire! a)))))

(deftest concurrent-repeated-retire-calls-observe-one-native-completion-and-exact-private-outcome
 (let [a (graph "retirement-outcome-concurrent") sink (erlang/self)
       workers (mapv (fn [_]
                  (spawn-monitor
                   (fn []
                    (receive :retire
                     (erlang/send sink [:retire-result (erlang/self) (g/retire! a)])))))
                 (range 8))]
  (try
   (doseq [w workers] (erlang/send (elem w 0) :retire))
   (let [answers (mapv
         (fn [_]
          (receive [:retire-result pid result] [pid result]
           (after 5000 (throw (ex-info "Concurrent retirement did not finish" {:kind :fixture-timeout})))))
         (range 8))]
    (is (= (set (map #(elem % 0) workers)) (set (map first answers))))
    (is (= 1 (count (filter #(= :retired (:status (second %))) answers))))
    (is (= 7 (count (filter #(= :already-retired (:status (second %))) answers))))
    (is (= :native-retired (:status (g/native-retirement-outcome a))))
    (is (= :complete (:phase (g/native-retirement-outcome a))))
    (is (= [] (:pending (g/native-retirement-outcome a))))
    (is (every? #(not (erlang/module_loaded %)) (:modules a)))
    (is (= :already-retired (:status (g/retire! a)))))
   (finally
    (doseq [w workers] (await-down! (elem w 0) (elem w 1))
                     (Process/demonitor (elem w 1) (list :flush)))
    (g/retire! a)))))

(deftest completed-outcome-does-not-collide-with-a-new-instance-of-the-same-plan
 (let [proposal {:application-id "retirement-outcome-reprepare"
                 :sources {"retirement.reprepare" "(ns retirement.reprepare) (defn value [] 41)"}}
       old (g/prepare! proposal) fresh (atom nil)]
  (try
   (is (= :retired (:status (g/retire! old))))
   (reset! fresh (g/prepare! proposal))
   (is (= (:cache-key old) (:cache-key @fresh)))
   (is (not= (:scope old) (:scope @fresh)))
   (is (not= (:modules old) (:modules @fresh)))
   (is (= :native-retired (:status (g/native-retirement-outcome old))))
   (is (nil? (g/native-retirement-outcome @fresh)))
   (is (= :already-retired (:status (g/retire! old))))
   (is (erlang/== @fresh (g/prepare! proposal)))
   (is (= 41 (g/invoke! @fresh "retirement.reprepare/value" [])))
   (is (= :retired (:status (g/retire! @fresh))))
   (is (= :complete (:phase (g/native-retirement-outcome old))))
   (is (= :complete (:phase (g/native-retirement-outcome @fresh))))
   (finally (g/retire! old) (when @fresh (g/retire! @fresh))))))
