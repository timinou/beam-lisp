; Structural IR controls, NOT observations of private KN ANF. Native UNRUN.
(ns reload.reconcile-residual-structural-test
 (:require [reload.reconcile-recipe :as recipe] [reload.reconcile-values :as values]))
(defn- lit [v] {:op :lit :val v :ann {}})
(defn- variable [n] {:op :var :name n :ann {}})
(defn- callback [names body]
 {:op :fn :ann {} :clauses [{:pats (mapv #(hash-map :pop :pvar :name %) names) :guard nil :body body}]})
(defn- config [apply-body]
 {:op :map :ann {} :pairs
  [[(lit :projection) (lit {:ident :fixture})]
   [(lit :conn-fn) (callback ["srv"] (lit nil))]
   [(lit :scope-fn) (callback ["srv" "job"] (lit []))]
   [(lit :apply) apply-body]]})
(defn- remote [m f args] {:op :remote :mod m :fun f :args args :ann {}})
(defn- reason [action] (try (action) nil (catch error (:reason (ex-data error)))))
(deftest callback-captures-only-actual-free-lexicals
 (let [expression {:op :let :name "unused" :init (lit {:large :root})
                   :body {:op :let :name "selected" :init (lit 7)
                          :body (config (callback ["srv" "job"] (variable "selected")))}}
       result (recipe/residualize! expression {})]
  (is (= 3 (:callback-count result)))
  (is (= 1 (:max-captures result)))
  (is (= #{} (:cell-keys result)))
  (is (= :snapshot-reification (:constructor result)))))
(deftest clause-pattern-shadowing-does-not-capture-the-outer-value
 (let [expression {:op :let :name "job" :init (lit 7)
                   :body (config (callback ["srv" "job"] (variable "job")))}
       result (recipe/residualize! expression {})]
  (is (= 0 (:max-captures result)))
  (is (= 3 (:callback-count result)))))
(deftest selected-terminal-branch-remains-in-residual-and-returning-branch-proves
 (let [raise (remote :Elixir.Fixture.ExInfo :raise [(lit :missing)])
       body {:op :if :test (lit true) :then (config (callback ["s" "j"] (lit nil))) :else raise}
       result (recipe/residualize! body {:sdk {[:Elixir.Fixture.ExInfo :raise 1] :raise}})]
  (is (= :if (:op (:body result))))
  (is (= :raise (:fun (:else (:body result)))))
  (is (= :missing (:val (first (:args (:else (:body result)))))))
  (is (= :map (:op (:then (:body result)))))))
(deftest terminal-initializer-never-analyzes-or-enables-unreachable-opaque-code
 (let [raise (remote :Elixir.Fixture.ExInfo :raise [(lit :missing)])
       body {:op :let :name "never" :init raise :body {:op :unsupported-private-route}}
       result (recipe/residualize!
                {:op :if :test (lit true) :then (lit :okay) :else body}
                {:result-kind :data :sdk {[:Elixir.Fixture.ExInfo :raise 1] :raise}})]
  (is (= :if (:op (:body result))))
  (is (= :raise (:fun (:else (:body result)))))
  (is (= :missing (:val (first (:args (:else (:body result)))))))))
(deftest an-unknown-eager-route-never-inherits-another-route-proof
 (is (= :unknown-eager-call
       (reason #(recipe/residualize! (remote :Elixir.Unknown :open [(lit nil)]) {:result-kind :data}))))
 (is (= :unsupported-eager-node
       (reason #(recipe/residualize! {:op :unsupported-private-route} {:result-kind :data})))))
(deftest a-refusal-payload-cannot-escape-as-a-config-value-or-delayed-capture
 (let [ex (remote :Elixir.Fixture.ExInfo :create [(lit "failure") (lit {})])
       ctx {:sdk {[:Elixir.Fixture.ExInfo :create 2] :exception}}]
  (is (= :non-data-eager-operand (reason #(recipe/residualize! ex (assoc ctx :result-kind :data)))))
  (is (= :unproved-callback-capture
        (reason #(recipe/residualize!
                  {:op :let :name "exception" :init ex :body (config (callback ["s" "j"] (variable "exception")))} ctx))))))
(deftest finite-runtime-guard-runs-before-any-predicate
 ;; Explicit SDK component control: predicate counter is test instrumentation,
 ;; not a forged Source/Conn/G credential or a recipe purity proof.
 (let [calls (atom 0) predicate (fn [_] (swap! calls inc) true)
       opaque {:__struct__ :Elixir.Foreign.Collection :items (tuple 1 2)}]
  (is (try (values/every-first-order! predicate opaque) false (catch _ true)))
  (is (= 0 @calls))
  (is (= true (values/every-first-order! predicate [1 2 3])))
  (is (= 3 @calls))
  (is (= true (values/every-first-order! predicate nil)))
  (is (= 3 @calls))))
(deftest finite-runtime-predicate-short-circuit-preserves-ordinary-semantics
 (let [seen (atom [])]
  (is (= false (values/every-first-order! (fn [x] (swap! seen conj x) (< x 2)) [1 2 3])))
  (is (= [1 2] @seen))))

(defn- typed-context []
 ;; Structural fixtures supply abstract shapes only. They mint NO native Conn,
 ;; graph/SDK lease/custody receipt or successful application consumer.
 {:callback-mode :sealed-bindings :callback-prefix "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  :sdk {[:Elixir.Fixture.State :cell 2] :managed-cell
        [:Elixir.Fixture.State :read 1] :managed-deref
        [:Elixir.Fixture.Map :get 2] :get}
  :snapshot-schema {:root {[:runtime :conn] {:id :control-conn :kind :connection}}}})
(defn- typed-body [path capture-whole?]
 {:op :let :name "cell" :init (remote :Elixir.Fixture.State :cell [(lit :root) (lit nil)])
  :body {:op :let :name "root" :init (remote :Elixir.Fixture.State :read [(variable "cell")])
   :body {:op :let :name "runtime" :init (remote :Elixir.Fixture.Map :get [(variable "root") (lit :runtime)])
    :body {:op :let :name "connection" :init (remote :Elixir.Fixture.Map :get [(variable "runtime") (lit path)])
     :body (config (callback ["s" "j"] (variable (if capture-whole? "runtime" "connection"))))}}}})
(deftest structural-typed-leaf-emits-only-selected-closed-capture-bindings
 (let [proof (recipe/residualize! (typed-body :conn false) (typed-context))
       selected (filter #(= [:connection] (:capture-kinds %)) (:callback-entries proof))]
  (is (= #{:root} (:cell-keys proof)))
  (is (= 3 (count (:callback-entries proof))))
  (is (= 1 (count selected)))
  (is (= 1 (:max-captures proof)))
  (is (every? #(seq (:entries %)) (:callback-entries proof)))))
(deftest a-typed-container-cannot-escape-through-a-delayed-callback
 (is (= :unproved-typed-callback-capture
       (reason #(recipe/residualize! (typed-body :conn true) (typed-context))))))
(deftest an-unknown-typed-path-remains-unsupported
 (is (= :unsealed-typed-snapshot-path
       (reason #(recipe/residualize! (typed-body :other false) (typed-context))))))

(deftest unselected-invalid-snapshot-leaf-remains-inert-until-the-residual-reaches-it
 (let [snapshot {:selected {:state :value :value 7}
                 :missing {:state :missing}
                 :invalid {:state :invalid}}]
  (is (= 7 (values/operand! snapshot :selected)))
  (is (nil? (values/operand! snapshot :missing)))
  (is (= :unsupported-snapshot-container (reason #(values/operand! snapshot :invalid))))
  (is (= :unsealed-snapshot-operand (reason #(values/operand! snapshot :unknown))))))

(deftest recursive-finite-predicate-cannot-reset-active-factory-or-depth-budgets
 (let [target [:Elixir.Fixture.Predicate :recursive 1]
       body (remote :Elixir.Fixture.Every :every [{:op :global :ns "fixture" :name "recursive"} (variable "value")])
       ctx {:result-kind :data
            :sdk {[:Elixir.Fixture.Every :every 2] :every}
            :globals {["fixture" "recursive"] {1 target}}
            :factories {target [{:params [{:pop :pvar :name "value"}] :guard nil :body body}]}}]
  (is (= :recursive-eager-factory
        (reason #(recipe/residualize!
                  (remote :Elixir.Fixture.Every :every [{:op :global :ns "fixture" :name "recursive"} (lit [])]) ctx))))))

(deftest compiler-key-normalization-keeps-literal-evidence-and-refuses-dynamic-keys
 (let [ctx {:result-kind :data :sdk {[:Elixir.BeamLisp.Ns.Rt :hash_key 1] :identity}}
       normalized (fn [key] (remote :Elixir.BeamLisp.Ns.Rt :hash_key [key]))
       body (fn [key] {:op :map :ann {} :pairs [[(normalized key) (lit 7)]]})]
  (is (= :map (:op (:body (recipe/residualize! (body (lit :value)) ctx)))))
  (is (= :dynamic-or-struct-key
       (reason #(recipe/residualize! (body (variable "key"))
                 (assoc ctx :parameters {"key" {:kind :data :node (variable "key")}})))))
  (is (= :dynamic-or-struct-key
       (reason #(recipe/residualize! (body (lit :__struct__)) ctx))))))
