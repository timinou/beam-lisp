; Do not require reload.binding here: the graph's SDK dependency is genuinely
; cold in its caller. Source declaration must be enough for exact compilation.
(ns reload.binding-cold-graph-test (:require [reload.generation :as g]))

(deftest candidate-compilation-loads-its-declared-fixed-late-call-surface
 (let [graph (g/prepare! {:stable-namespaces #{"reload.binding"}
                         :roots ["cold.caller"]
                         :sources {"cold.caller" "(ns cold.caller (:require [reload.binding :as binding])) (defn run [x] (binding/call! \"cold.target/value\" [x]))"
                                   "cold.target" "(ns cold.target) (defn value [x] [:exact x])"}})]
  (try
   (is (contains? (:mapping graph) "cold.target"))
   (is (= [:exact :argument] (g/invoke! graph "cold.caller/run" [:argument])))
   (finally (g/retire! graph)))))
