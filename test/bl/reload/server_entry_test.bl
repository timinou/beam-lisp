(ns reload.server-entry-test (:require [reload.server-entry :as entry]))
(defn- wrapper [module fname body]
 {:op :remote :mod :Elixir.BeamLisp.Env :fun :with_server_execution!
  :args (list {:op :lit :val module} {:op :lit :val fname}
              {:op :fn :clauses (list {:pats (list) :guard nil :body body})})})
(defn- refused? [module clause]
 (try (entry/body module clause) false
  (catch error (= :invalid-server-execution-descriptor (:kind (ex-data error))))))
(deftest only-exact-outer-canonical-callback-entry-is-unwrapped
 (let [m :Elixir.ActorFixture value {:op :lit :val 42}]
  (doseq [fname [:init :handle_call :handle_cast :handle_info :handle_continue :terminate]]
   (is (= value (entry/body m {:fname fname :body (wrapper m fname value)}))))
  (doseq [fname [:__invariant__ :__bl_accept_call__ :__bl_contract__ :start :code_change]]
   (let [w (wrapper m fname value)]
    (is (= w (entry/body m {:fname fname :body w})))))
  (let [w (wrapper m :handle_call value)]
   (is (= w (entry/body m {:fname :handle_call :body (wrapper m :handle_call w)})))
   (is (refused? :Elixir.OtherActor {:fname :handle_call :body w}))
   (is (refused? m {:fname :handle_call :body (wrapper m :terminate value)}))
   (is (refused? m {:fname :handle_call :body (assoc w :args
    (list {:op :lit :val m} {:op :lit :val :handle_call} {:op :var :name "borrowed"}))}))
   (is (refused? m {:fname :handle_call :body (assoc w :args
    (list {:op :lit :val m} {:op :lit :val :handle_call}
     {:op :fn :clauses (list {:pats (list {:pop :pvar :name "arg"}) :guard nil :body value})}))}))))
)
(deftest init-bind-is-preserved-before-the-user-entry
 (let [m :Elixir.ActorFixture v {:op :lit :val :ok} w (wrapper m :init v)
       bind {:op :remote :mod :Elixir.BeamLisp.Server :fun :bind_init :args (list {:op :var :name "arg"})}
       l {:op :let :var "arg" :init bind :body w}
       d {:op :do :stmts (list bind w)}]
  (is (= (assoc l :body v) (entry/body m {:fname :init :body l})))
  (is (= (assoc d :stmts (list bind v)) (entry/body m {:fname :init :body d})))
  (is (= l (entry/body m {:fname :handle_call :body l})))
  (is (= d (entry/body m {:fname :handle_info :body d})))
  (is (= (assoc l :init v) (entry/body m {:fname :init :body (assoc l :init v)})))))

(deftest validation-projection-exempts-only-the-real-incoming-init-parameter
 (let [m :Elixir.ActorFixture v {:op :lit :val :ok}
       bind {:op :remote :mod :Elixir.BeamLisp.Server :fun :bind_init
             :args (list {:op :var :name "incoming"})}
       clause {:fname :init :params (list {:pop :pvar :name "incoming"}) :guard nil
               :body {:op :let :name "opts" :init bind :body (wrapper m :init v)}}
       projected (entry/validation-body m clause)]
  (is (= :lit (:op (:init projected)))) (is (= v (:body projected)))
  ;; Ordinary body/descriptor behavior is unchanged; this is only a checker view.
  (is (= bind (:init (entry/body m clause))))
  (let [nested (assoc-in clause [:body :body] (wrapper m :init bind))]
   (is (= bind (:body (entry/validation-body m nested)))))
  (doseq [changed [(assoc clause :fname :handle_call)
                  (assoc clause :guard {:op :lit :val true})
                  (assoc clause :params (list {:pop :pvar :name "other"}))
                  (assoc clause :params (list {:pop :pvar :name "incoming"} {:pop :pvar :name "extra"}))
                  (assoc-in clause [:body :init :args] (list {:op :lit :val nil}))]]
   (is (= (get-in changed [:body :init]) (:init (entry/validation-body m changed)))
       "Unproved init prelude must remain visible to the ordinary native checker"))))

(defn- input-hook [module clause]
 (let [names (entry/input-names clause)]
  {:op :if
   :test {:op :remote :mod :erlang :fun :==
          :args (list {:op :remote :mod :Elixir.Process :fun :get
                       :args (list {:op :lit :val :bl_generation :ann {}}) :ann {}}
                      {:op :lit :val nil :ann {}}) :ann {}}
   :then {:op :lit :val :ok :ann {}}
   :else {:op :remote :mod :Elixir.BeamLisp.Ns.Proc.Contract :fun :check-entry!
          :args (list {:op :lit :val module :ann {}}
                      {:op :lit :val (entry/input-key clause) :ann {}}
                      {:op :map :pairs (to-list (mapv (fn [name]
                         (list {:op :lit :val name :ann {}}
                               {:op :var :name name :ann {}})) names)) :ann {}})
          :ann {}}
   :ann {}}))
(deftest input-projection-exempts-only-exact-outer-native-generated-check
 (let [module :Elixir.ActorInputProjection
       value {:op :lit :val :user-body :ann {}}
       clause {:fname :handle_call :params (list {:pop :pvar :name "message"}
                   {:pop :pvar :name "from"} {:pop :pvar :name "state"}) :guard nil}
       hook (input-hook module clause)
       body {:op :do :stmts (list hook value) :ann {}}
       wrapped (assoc clause :body (wrapper module :handle_call body))]
  (is (= true (:enforced (entry/input-body module wrapped))))
  (is (= value (:body (entry/input-body module wrapped))))
  (doseq [changed [(assoc hook :else (assoc (:else hook) :mod :Elixir.Borrowed.Contract))
                  (assoc hook :else (assoc (:else hook) :fun :borrowed_check!))
                  (assoc hook :else (assoc (:else hook) :args
                    (list {:op :lit :val :Elixir.OtherActor :ann {}}
                          (second (:args (:else hook))) (nth (:args (:else hook)) 2))))
                  (assoc hook :else (assoc (:else hook) :args
                    (list (first (:args (:else hook))) {:op :lit :val :borrowed-key :ann {}}
                          (nth (:args (:else hook)) 2))))
                  (assoc hook :else (assoc (:else hook) :args
                    (list (first (:args (:else hook))) (second (:args (:else hook)))
                          {:op :map :pairs (list) :ann {}})))
                  (assoc hook :then {:op :lit :val :borrowed-result :ann {}})
                  {:op :do :stmts (list hook value) :ann {}}
                  (assoc hook :test {:op :lit :val false :ann {}})]]
   (let [changed-body (assoc body :stmts (list changed value))
         result (entry/input-body module (assoc clause :body (wrapper module :handle_call changed-body)))]
    (is (= false (:enforced result)))
    (is (= changed-body (:body result)))))))
