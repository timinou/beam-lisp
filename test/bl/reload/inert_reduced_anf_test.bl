; Pure IR candidate controls only. No fake SDK entry/lease/owner/module exists.
(ns reload.inert-reduced-anf-test)
(defn- variable [name] {:op :var :name name})
(defn- literal [value] {:op :lit :val value})
(defn- remote [module function args] {:op :remote :mod module :fun function :args args})
(defn- clause [name body] {:op :defn-clause :params (list {:pop :pvar :name name}) :guard nil :body body})
(def ^:private MODULE :Elixir.BeamLisp.Ns.Rt)
(defn- wrapper [name] (clause name (remote MODULE :reduce-reduced? (list (variable name)))))
(defn- helper [name temporary]
 (clause name
  {:op :let :name temporary :init (remote :erlang :is_map (list (variable name)))
   :body {:op :if :test (variable temporary) :else (variable temporary)
          :then (remote :erlang :==
                  (list (remote :maps :get (list (literal :__struct__) (variable name) (literal nil)))
                        (literal :Elixir.BeamLisp.Reduced)))}}))
(defn- proved? [w h]
 (BeamLisp.AOT/sdk_inert_reduced_anf? w h MODULE :reduce-reduced?))

(deftest exact-pure-predicate-schema-is-alpha-insensitive
 (is (= true (proved? (wrapper "x") (helper "x" "and_tmp_1"))))
 (is (= true (proved? (wrapper "a_99") (helper "fresh_42" "and_tmp_2"))))
 (is (= true (proved? (wrapper "x")
               (assoc-in (helper "x" "b") [:body :body :else] (literal false)))))
 (is (= true (proved?
               (clause "x" {:op :let :name "alias" :init (variable "x")
                             :body (remote MODULE :reduce-reduced? (list (variable "alias")))})
               (helper "x" "b")))))

(deftest effectful-unknown-and-different-result-candidates-have-no-contract
 (let [w (wrapper "x") h (helper "x" "b")
       bad [[(assoc w :body (variable "x")) h]
            [(assoc w :body (remote :erlang :apply (list (literal MODULE) (literal :reduce-reduced?) (variable "x")))) h]
            [(assoc w :body (remote :other_kernel :reduce-reduced? (list (variable "x")))) h]
            [w (assoc h :body (variable "x"))]
            [w (assoc h :body (literal true))]
            [w (assoc h :body (literal false))]
            [w (assoc-in h [:body :body :then :args] (list (literal :wrong) (literal :Elixir.BeamLisp.Reduced)))]
            [w (assoc-in h [:body :init :fun] :is_function)]
            [w (assoc-in h [:body :body :else] (variable "x"))]
            [w (assoc-in h [:body :body :then :args] (list (literal :wrong) (literal nil)))]
            [w (assoc h :body {:op :do :stmts (list (remote :erlang :put (list (literal :marker) (literal true))) (:body h))})]
            [w (assoc h :body {:op :apply :fn (variable "x") :args (list)})]
            [w (assoc h :body {:op :fn :clauses (list)})]
            [w (assoc h :body (reduce (fn [body n] {:op :let :name (str "n" n) :init (literal nil) :body body}) (:body h) (range 40)))]]]
  (doseq [[candidate-wrapper candidate-helper] bad]
   (is (= false (proved? candidate-wrapper candidate-helper))))))

(deftest missing-malformed-and-guarded-declarations-have-no-contract
 (let [w (wrapper "x") h (helper "x" "b")]
  (doseq [[candidate-wrapper candidate-helper]
          [[nil h] [w nil] [(assoc w :params (list)) h]
           [w (assoc h :params (list {:pop :plit :val 0}))]
           [w (assoc h :guard (literal true))]
           [(assoc w :params (list {:pop :pvar :name "x"} {:pop :pvar :name "y"})) h]]]
   (is (= false (proved? candidate-wrapper candidate-helper))))))
