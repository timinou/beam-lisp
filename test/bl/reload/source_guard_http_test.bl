; HOME component controls, UNRUN. No network request/service, graph or actor
; effect is fabricated. These validate raw transport data only, not integration.
(ns reload.source-guard-http-test (:require [reload.source-guard :as guard]))
(defn refused? [action]
 (try (action) false (catch _ true)))
(deftest fixed-transport-data-does-not-require-source-callbacks
 (is (= :valid (guard/validate-http! (list "http://127.0.0.1/"))))
 (is (= :valid (guard/validate-http! (list (String/to_charlist "http://127.0.0.1/") :default))))
 (is (= :valid (guard/validate-http!
       (list :get (tuple "http://127.0.0.1/" (list)) (list) (list)))))
 (is (= :valid (guard/validate-http!
       (list :post (tuple "http://127.0.0.1/" (list) "application/json" "{}")
             (list (tuple :timeout 10)) (list (tuple :sync true)) :default))))
 (is (= :valid (guard/validate-http!
       (list :get (tuple "http://127.0.0.1/" (list)) (list)
             (list (tuple :sync false) (tuple :receiver (erlang/self)))))))
 (is (= :valid (guard/validate-http! (list {:ordinary ["data" 1 true] :set #{1 2}})))))
(deftest callback-and-native-capability-leaves-refuse-without-invoking-them
 (let [effects (atom 0) callback (fn [& _] (swap! effects inc))
       request (tuple "http://127.0.0.1/" (list))]
  (doseq [receiver (list callback (tuple :sample :handler (list)) (erlang/make_ref) :self)]
   (is (refused? #(guard/validate-http!
                    (list :get request (list) (list (tuple :receiver receiver)))))))
  (is (refused? #(guard/validate-http!
          (list :post (tuple "http://127.0.0.1/" (list) "text/plain" (tuple callback nil))
                (list) (list)))))
  (is (refused? #(guard/validate-http! (list (tuple :"$blfn" :sample :handler)))))
  (is (refused? #(guard/validate-http! (list {:__struct__ :foreign :lookup callback}))))
  (is (refused? #(guard/validate-http! (list (lazy-seq (callback))))))
  (is (refused? #(guard/validate-http! (list (atom :native-resource)))))
  (is (= 0 @effects))))
(deftest one-bounded-request-never-traverses-an-unchecked-arity-or-independent-quota
 (is (refused? #(guard/validate-http! :not-a-list)))
 (is (refused? #(guard/validate-http! (list))))
 (is (refused? #(guard/validate-http! (list 1 2 3))))
 (is (refused? #(guard/validate-http! (list 1 2 3 4 5 6))))
 (is (refused? #(guard/validate-http! (erlang/++ (list "url") :improper))))
 (is (refused? #(guard/validate-http! (list (to-list (range 32769))))))
 ;; One binary object repeated twice must still spend its byte quota twice.
 (let [chunk (binary/copy "x" 35000000)]
  (is (refused? #(guard/validate-http! (list chunk chunk)))))
 (is (refused? #(guard/validate-http!
        (list :get (tuple "url" (list)) (list)
              (to-list (repeat 129 (tuple :sync true))))))))
