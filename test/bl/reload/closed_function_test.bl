(ns reload.closed-function-test (:require [reload.closed-function :as closed]))
(defn- kind [f] (try (f) nil (catch error (:kind (ex-data error)))))
(def FN {:op :fn :clauses (list {:pats (list {:pop :pvar :name "db"})
                                :guard nil :body {:op :var :name "db"}}) :ann {}})
(defn- scaffold [inner]
 {:op :let :name "outer"
  :init {:op :fn :clauses (list {:pats (list {:pop :pvar :name "self"}) :guard nil :body inner})}
  :body {:op :apply :fn {:op :var :name "outer"} :args (list {:op :var :name "outer"})}})

(deftest closed-constructor-produces-compiled-named-clauses-without-invocation
 (let [built (closed/declaration "checked" (scaffold FN)) entry (first (:entries built))]
  (is (= {:arities #{1}} (:signature built)))
  (is (= :fixed (elem entry 0)))
  (is (= 1 (elem entry 1)))
  (is (= :checked (elem entry 2)))
  (is (= :apply (:op (:body (elem entry 3)))))))

(deftest captured-values-and-computed-constructors-refuse
 (is (= :dynamic-executable-registration
        (kind #(closed/declaration "unsafe" (assoc FN :clauses
                         (list {:pats (list {:pop :pvar :name "db"}) :guard nil
                                :body {:op :var :name "borrowed"}}))))))
 (is (= :dynamic-executable-registration
        (kind #(closed/declaration "unsafe" {:op :do :stmts (list {:op :remote :mod :System :fun :put_env :args []} FN)}))))
 (is (= :dynamic-executable-registration
        (kind #(closed/declaration "unsafe" (assoc (scaffold FN) :body
                         {:op :apply :fn {:op :var :name "outer"} :args (list {:op :lit :val 99})}))))))

(deftest body-effects-remain-delayed-but-opaque-literals-never-capture-resources
 (let [effects (atom 0)
       delayed (assoc FN :clauses (list {:pats (list {:pop :pvar :name "db"}) :guard nil
                                         :body {:op :remote :mod :System :fun :put_env
                                                :args (list {:op :lit :val "SENTINEL"} {:op :lit :val "changed"})}}))
       opaque (assoc FN :clauses (list {:pats (list {:pop :pvar :name "db"}) :guard nil
                                        :body {:op :lit :val (fn [] (swap! effects inc))}}))]
  (is (= {:arities #{1}} (:signature (closed/declaration "delayed" delayed))))
  (is (= :dynamic-executable-registration (kind #(closed/declaration "unsafe" opaque))))
  (is (zero? @effects))))
