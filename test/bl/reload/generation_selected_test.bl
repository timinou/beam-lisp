(ns reload.generation-selected-test
 (:require [reload.generation :as generation] [reload]))
(defn- graph [value]
 (generation/prepare! {:application-id "selected-action"
  :sources {"selected.sample" (str "(ns selected.sample) (defn value [] " value ")")}}))
(deftest selected-factory-and-handler-keep-one-graph-through-concurrent-publication
 (let [old (graph 1) fresh (graph 2) slot (generation/slot)
       parent (erlang/self) worker (atom nil)]
  (try
   (reload/set-enabled! true) (generation/publish! slot nil old)
   (reset! worker (erlang/spawn
    (fn [] (generation/with-selected! slot
     (fn []
      (let [first (generation/invoke! (generation/current) "selected.sample/value" [])]
       (erlang/send parent :selected-entered)
       (receive :finish nil)
       (erlang/send parent [:selected-result first
         (generation/invoke! (generation/current) "selected.sample/value" [])])))))))
   (is (= :selected-entered (receive :selected-entered :selected-entered (after 5000 :missing))))
   (is (= :applied (:status (generation/publish! slot (:digest old) fresh))))
   (is (= 2 (generation/call! slot "selected.sample/value" [])))
   (is (= :waiting (:status (generation/retire! old))))
   (erlang/send @worker :finish)
   (is (= [1 1] (receive [:selected-result a b] [a b] (after 5000 :missing))))
   (finally
    (when @worker (erlang/send @worker :finish))
    (generation/close! slot (:digest fresh)) (generation/retire! old)
    (generation/retire! fresh) (reload/set-enabled! nil)))))
(deftest selected-action-exception-releases-the-request-lease
 (let [graph (graph 3) slot (generation/slot)]
  (try
   (reload/set-enabled! true) (generation/publish! slot nil graph)
   (is (= :caught (try (generation/with-selected! slot #(throw :deliberate))
                   (catch _ :caught))))
   (generation/close! slot (:digest graph))
   (is (contains? #{:retired :already-retired} (:status (generation/retire! graph))))
   (finally (generation/close! slot (generation/selected slot))
    (generation/retire! graph) (reload/set-enabled! nil)))))
