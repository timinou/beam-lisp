(ns reload.source-producer-test (:require [reload.source-producer :as producer] [reload.server-entry]))

(deftest persistent-ir-vectors-remain-sequences-and-literal-payloads-remain-inert
 (let [key {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :hash_key
            :args (list {:op :lit :val :value :ann {}}) :ann {}}
       literal {:op :lit :val {:op :remote :mod :httpc :fun :request :args []} :ann {}}
       body {:op :map :pairs [[key literal]] :ann {}}
       input {:op :fn :clauses [{:pats [] :guard nil :body body}] :ann {}}
       result (producer/specialize input {:source-ingress true :native-modules #{}})
       outer (first (:clauses (:expression result)))
       guarded (:body outer)
       action (first (:args guarded))
       actual (:body (first (:clauses action)))]
  (is (= 0 (:changes result)))
  (is (= :with_source_execution! (:fun guarded)))
  (is (= body actual))
  (is (vector? (:pairs actual)))
  (is (= literal (second (first (:pairs actual)))))))

(defn- fixed-point [inner]
 {:op :let :name "self" :ann {}
  :init {:op :fn :ann {} :clauses
         (list {:pats (list {:pop :pvar :name "self"}) :guard nil :body inner})}
  :body {:op :apply :fn {:op :var :name "self"} :args (list {:op :var :name "self"}) :ann {}}})

(deftest constructing-a-source-function-does-not-enter-its-delayed-body
 (let [body {:op :lit :val :callback :ann {}}
       inner {:op :fn :clauses (list {:pats (list) :guard nil :body body}) :ann {}}
       input (fixed-point inner)
       output (:expression (producer/specialize input {:source-ingress true :native-modules #{}}))
       outer-clause (first (:clauses (:init output)))
       callback (:body outer-clause)]
  (is (= :fn (:op callback)))
  (is (= :with_source_execution! (:fun (:body (first (:clauses callback))))))
  (is (= (:body input) (:body output)))
  (is (= inner (:inner (BeamLisp.CompilerData/self_application_parts input))))
  (doseq [malformed [(assoc-in input [:body :fn :name] "other")
                    (assoc-in input [:init :clauses] (list (assoc (first (:clauses (:init input))) :guard {:op :lit :val true})))
                    (assoc-in input [:init :clauses] (list (assoc (first (:clauses (:init input))) :body body)))]]
   (is (nil? (BeamLisp.CompilerData/self_application_parts malformed))))))

(deftest compiler-body-module-carriers-protect-real-bodies-and-preserve-literal-data
 (let [body {:op :remote :mod :httpc :fun :request
             :args (list {:op :lit :val :request :ann {}}) :ann {}}
       method {:op :defn-clause :params [] :body body :ann {}}
       descriptor {:op :module :defs [method] :ann {}}
       carrier {:op :remote :mod :Elixir.BeamLisp.Ns.Body.Lower :fun :reload-descriptor!
                :args (list {:op :lit :val descriptor :ann {}}) :ann {}}
       result (producer/specialize carrier {:source-ingress true :native-modules #{"httpc"}
                                            :guard-module :guard :guard-function :request})
       actual (first (:defs (:val (first (:args (:expression result))))))]
  (is (= 1 (:changes result)))
  (is (= :with_source_execution! (:fun (:body actual))))
  (is (= :guard (:mod (:body (first (:clauses (first (:args (:body actual)))))))))
  (is (= {:op :lit :val descriptor}
         (:expression (producer/specialize {:op :lit :val descriptor}
                        {:source-ingress true :native-modules #{"httpc"}}))))))

(deftest generated-actor-native-entry-precedes-source-and-keeps-input-proofs
 (let [form (first (BeamLisp.Reader/read_string
             "(defserver worker (init [x] (ok x)) (handle-call :read [_ state] (reply state state)))"))
       compiled (BeamLisp.Compiler/compile form (BeamLisp.Compiler/new_env "producer.actor"))
       output (:expression (producer/specialize compiled {:source-ingress true :native-modules #{}}))
       original (:val (first (:args (first (:stmts compiled)))))
       descriptor (:val (first (:args (first (:stmts output)))))
       init (first (filter #(= :init (:fname %)) (:clauses descriptor)))
       original-init (first (filter #(= :init (:fname %)) (:clauses original)))
       handler (first (filter #(= :handle_call (:fname %)) (:clauses descriptor)))]
  (is (= :let (:op (:body init))))
  (is (= (:init (:body original-init)) (:init (:body init))))
  (is (= :with_server_execution! (:fun (:body (:body init)))))
  (is (= true (:enforced (reload.server-entry/input-body (:name descriptor) handler))))))
