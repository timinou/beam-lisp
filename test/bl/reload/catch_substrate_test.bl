(ns reload.catch-substrate-test (:require [reload.generation :as g]))

(deftest normalized-catch-uses-compiler-substrate-without-an-exception-grant
 (let [graph (g/prepare! {:native-modules #{"erlang"}
              :sources {"catch.application"
               "(ns catch.application) (defn run [] (try (erlang/error :fixture-error) (catch error [:caught (:original error)])))"}})]
  (try
   (is (= [:caught :fixture-error] (g/invoke! graph "catch.application/run" [])))
   (finally (g/retire! graph)))))

(deftest an-explicit-native-spelling-still-requires-its-declared-grant
 (is (= :undeclared-dependency
        (try
         (g/prepare! {:sources {"catch.explicit"
          "(ns catch.explicit) (defn run [] (Exception/normalize :error :fixture-error []))"}})
         :unexpected-success
         (catch error (:kind (ex-data error)))))))
