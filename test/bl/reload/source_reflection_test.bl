; Evaluator/reflection entry regressions; coupled native acceptance pending.
(ns reload.source-reflection-test
 (:require [reload.generation :as g] [reload.native-target-fixture :as sdk]
           [env] [clojure.core-more]))
(defn- reason [action]
 (try (action) nil (catch error
  (if (and (erlang/is_map error) (maps/is_key :original error))
   (maps/get :original error) (:kind (ex-data error))))))
(defn- prepared []
 (g/prepare!
  {:sources {"reflection.app"
    "(ns reflection.app (:require [reload.native-target-fixture :as sdk] [env]))
     (defn invoke [f args] (apply f args))
     (defn eval-through-sdk [source] (sdk/reflective-eval source))
     (defn prepare-through-sdk [proposal] (sdk/reflective-prepare proposal))
     (defn read-data-only [] (let [form (read-data \"(+ 1 2)\")] [(symbol? (first form)) (count form)]))
     (defn scope [] (env/current))"}
   :stable-namespaces #{"reload.native-target-fixture" "env" "clojure.core-more"}}))
(deftest shared-evaluator-and-prepare-entries-refuse-before-side-effects
 (let [generation (prepared) before (BeamLisp.Env/ns_exists? "reflection.never-created")
       source "(ns reflection.never-created) (def value 1)"
       proposal {:sources {"reflection.never-prepared" "(ns reflection.never-prepared) (defn run [] :bad)"}}]
  (try
   (is (= false before))
   (is (= :native_framework_execution_required
     (reason #(g/invoke! generation "reflection.app/eval-through-sdk" [source]))))
   (is (= :native_framework_execution_required
     (reason #(g/invoke! generation "reflection.app/prepare-through-sdk" [proposal]))))
   (is (= false (BeamLisp.Env/ns_exists? "reflection.never-created")))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))
(deftest actual-public-reflection-targets-refuse-while-data-reader-remains-usable
 (let [generation (prepared)
       eval (BeamLisp.Env/fetch_exact! "env" "eval")
       resolve (BeamLisp.Env/fetch_exact! "clojure.core-more" "resolve")
       prepare (BeamLisp.Env/fetch_exact! "reload.generation" "prepare!")]
  (try
   (is (= :source_native_target_refused
     (reason #(g/invoke! generation "reflection.app/invoke" [eval ["(+ 1 2)"]]))))
   (is (= :source_native_target_refused
     (reason #(g/invoke! generation "reflection.app/invoke" [resolve [(symbol "reload.native-target-fixture/private-step")]]))))
   (is (= :source_native_target_refused
     (reason #(g/invoke! generation "reflection.app/invoke" [prepare [{}]]))))
   (is (= [true 3] (g/invoke! generation "reflection.app/read-data-only" [])))
   (is (= (:scope generation) (g/invoke! generation "reflection.app/scope" [])))
   (finally (g/retire! generation)))))
