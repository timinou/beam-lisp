(ns reload.application-macro-test
 (:require [reload.generation :as g] [reload.syntax-constructor :as constructor]
           [env]))

(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest application-template-macros-seal-their-own-helpers-and-variadic-bodies
 (let [graph (g/prepare!
              {:sources {"macro.flow" "(ns macro.flow) (defn with-flow-fn [event f] [event (f)]) (defmacro with-flow [event & body] `(macro.flow/with-flow-fn ~event (fn [] ~@body)))"
                         "macro.page" "(ns macro.page (:require [macro.flow :as flow])) (defn run [value] (flow/with-flow :page value))"}})]
  (try
   (is (= [:page 42] (g/invoke! graph "macro.page/run" [42])))
   (is (String/contains? (first (vals (:sources (g/plan {:sources {"macro.flow" "(ns macro.flow) (defmacro with-flow [event & body] `(macro.flow/helper ~event ~@body))"}}))))
                        ".macro.flow/helper"))
   (finally (g/retire! graph)))))

(deftest diagnostic-operation-shape-preserves-arguments-and-lexical-locals
 (let [graph (g/prepare!
              {:sources {"macro.operation" "(ns macro.operation) (defn with-operation-fn [sink context f] [sink context (f)]) (defmacro with-operation [sink context & body] `(macro.operation/with-operation-fn ~sink ~context (fn [] ~@body))) (defn run [sink context x] (with-operation sink context (let [resolve x] resolve)))"}})]
  (try (is (= [:sink {:operation :read} 7]
              (g/invoke! graph "macro.operation/run" [:sink {:operation :read} 7])))
   (finally (g/retire! graph)))))

(deftest generation-specific-macros-retain-old-expansion-semantics
 (let [sources (fn [value]
                 {"macro.version" (str "(ns macro.version) (defmacro value [] " value ") (defn run [] (value))")})
       old (g/prepare! {:sources (sources 1)}) newer (g/prepare! {:sources (sources 2)})]
  (try
   (is (= 1 (g/invoke! old "macro.version/run" [])))
   (is (= 2 (g/invoke! newer "macro.version/run" [])))
   (is (= 1 (g/invoke! old "macro.version/run" [])))
   (finally (g/retire! newer) (g/retire! old)))))

(deftest effects-and-latent-effects-refuse-before-the-macro-runs
 (let [before (System/get_env "BL_UNPROVED_MACRO_EFFECT")]
  (doseq [body ["(System/put_env \"BL_UNPROVED_MACRO_EFFECT\" \"unsafe\")"
               "(lazy-seq (System/put_env \"BL_UNPROVED_MACRO_EFFECT\" \"unsafe\") nil)"
               "(fn [] (System/put_env \"BL_UNPROVED_MACRO_EFFECT\" \"unsafe\"))"
               "(loop [] (recur))"
               "(helper)"
               "((fn [] :hidden))"]]
   (is (= :unproved-syntax-constructor
        (kind #(g/prepare! {:native-modules #{"System"}
                           :sources {"macro.unsafe" (str "(ns macro.unsafe) (defn helper [] :unknown) (defmacro unsafe [] " body ") (defn run [] (unsafe))")}}))))
   (is (= before (System/get_env "BL_UNPROVED_MACRO_EFFECT"))))))

(deftest emitted-native-apply-is-authorized-from-actual-expanded-bindings
 (let [source "(ns macro.native) (defmacro part [text] `(erlang/apply :binary :part (list ~text 1 2))) (defn run [text] (part text))"
       graph (g/prepare! {:native-modules #{"binary"} :sources {"macro.native" source}})]
  (try (is (= "bc" (g/invoke! graph "macro.native/run" ["abcd"])))
   (finally (g/retire! graph)))
  (is (= :undeclared-native-target
       (kind #(g/prepare! {:sources {"macro.native" source}}))))))

(deftest generated-reflection-and-producers-remain-refused
 (doseq [body ["`(core/resolve 'unknown)" "`(erlang/spawn (fn [] nil))"
              "`(BeamLisp.Env/fetch! \"unsealed\" \"run\")"]]
  (is (contains? #{:dynamic-code-dependency :unmanaged-compiled-producer :unsealed-compiled-dependency}
        (kind #(g/prepare! {:native-modules #{"erlang"}
                           :sources {"macro.escape" (str "(ns macro.escape) (defmacro escape [] " body ") (defn run [] (escape))")}}))))))

(deftest source-quotes-are-inert-and-unquoted-effects-are-not-hidden
 (let [graph (g/prepare! {:sources {"macro.quote" "(ns macro.quote) (defmacro quoted [] '(quote macro.quote/missing)) (defn run [] (quoted))"}})]
  (try (is (= 'macro.quote/missing (g/invoke! graph "macro.quote/run" [])))
   (finally (g/retire! graph))))
 (is (= :unproved-syntax-constructor
      (kind #(g/prepare! {:native-modules #{"System"}
                         :sources {"macro.unquote" "(ns macro.unquote) (defmacro unsafe [] `(identity ~(System/get_env \"HOME\"))) (defn run [] (unsafe))"}})))))

(deftest opaque-splices-and-runtime-values-do-not-cross-the-eager-boundary
 (is (= :unproved-syntax-constructor
      (kind #(g/prepare! {:sources {"macro.splice" "(ns macro.splice) (defmacro spread [value] `(list ~@value)) (defn run [] (spread [1 2]))"}}))))
 (is (= :list (constructor/data-shape! (list 'symbol {:key [1 2]}))))
 (is (= :unproved-syntax-constructor (kind #(constructor/data-shape! {:nested (fn [] nil)}))))
 (is (= :unproved-syntax-constructor (kind #(constructor/data-shape! {:nested {:__struct__ :Elixir.File.Stream :path "unused"}}))))
 (is (= :unproved-syntax-constructor (kind #(constructor/data-shape! (erlang/self))))))

(deftest pure-macro-expansion-cycles-and-duplicating-constructors-have-bounds
 (is (= :unproved-syntax-constructor
      (kind #(g/prepare! {:sources {"macro.cycle" "(ns macro.cycle) (defmacro forever [] '(forever)) (defn run [] (forever))"}}))))
 (let [v {:op :var :name "input"}
       double (fn [n] {:op :remote :mod :Elixir.BeamLisp.Ns.Rt :fun :splice :args (list n n) :ann {}})
       expression (double (double (double (double v))))]
  (is (= :unproved-syntax-constructor
       (kind #(constructor/shape! expression {"input" :list}))))))
