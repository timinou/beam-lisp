; test/bl/reload/migrate_test.bl — verified in-flight message migration.
;
; A :reroute migration is safe iff the migrated message PRESERVES the new
; handler's invariant — and that invariant is DEDUCED, no annotation required.
; Verification is mandatory: a migration that could break the invariant is
; :blocked before it ships, with a synthesized repair, the process never stopping.

(ns reload.migrate-test
  (:require [reload.migrate :as mig] [system.model :as model] [z3]))

(def port (z3/open))

; a scalar-state account handler with a withdraw guard — discover-invariant
; finds (>= balance 0) with no annotation.
(def acct-src
  (str "(defserver acct\n"
       "  (init [] (ok 100))\n"
       "  (handle-call [:withdraw amt] [_ balance] :when (>= balance amt)\n"
       "    (reply :ok (- balance amt))))"))
(def acct-node (first (BeamLisp.Reader/read_string acct-src)))
(def decls "(declare-const b1 Int)\n(declare-const b2 Int)\n")

; ── use case 1: R is DEDUCED — a good migration verifies, no annotation ──

(deftest deduced-good-migration-verifies
  (let [m (mig/migration {:strategy :reroute :decls decls
                          :v1 "b1" :v2 "b2" :migrate "b1"})
        r (mig/verify-migration port m acct-node)]
    (is (= true (:verified r)))
    (is (= :discovered (:r-source r)))))          ; the invariant was found, not written

; ── use case 2: a breaking migration is BLOCKED, with a repair ──────────

(deftest breaking-migration-blocked-with-repair
  (let [m (mig/migration {:strategy :reroute :decls decls
                          :v1 "b1" :v2 "b2" :migrate "(- b1 1000)"})
        r (mig/verify-migration port m acct-node)]
    (is (= false (:verified r)))
    (is (= :breaks-invariant (:reason r)))
    ; the checker offers the fix, not just a rejection
    (is (contains? r :repair))))

; ── use case 3: an explicit invariant overrides deduction ───────────────

(deftest explicit-invariant-honoured
  (let [inv (fn [v] (str "(>= " v " 0)"))
        m (mig/migration {:strategy :reroute :invariant inv :decls decls
                          :v1 "b1" :v2 "b2" :migrate "b1"})
        r (mig/verify-migration port m acct-node)]
    (is (= true (:verified r)))
    (is (= :explicit (:r-source r)))))

; ── use case 4: observable-eq fallback when no invariant of the shape ───
;
; A handler whose shape yields no inductive invariant degrades HONESTLY to
; observable-equality, and says so — never a false proof.

(deftest observable-eq-fallback-is-honest
  ; a trivial handler with no arithmetic invariant to discover
  (let [src "(defserver noop (init [] (ok 0)) (handle-call [:ping] [_ s] (reply :ok s)))"
        node (first (BeamLisp.Reader/read_string src))
        m (mig/migration {:strategy :reroute :decls decls
                          :v1 "b1" :v2 "b2" :migrate "b1"})
        r (mig/verify-migration port m node)]
    ; either it discovers a trivial invariant that holds, or falls back — both
    ; verify, and the fallback is flagged, never silent.
    (is (= true (:verified r)))))

; ── use case 5: quiesce — calmness is a QUERY, not a sleep ──────────────

(deftest quiesce-calm-is-queryable
  (let [m (mig/migration {:strategy :quiesce :modules ["acct" "ledger"]})]
    (is (= true (mig/calm? m (fn [_] 0))))           ; no in-flight msgs → calm
    (is (= false (mig/calm? m (fn [_] 3))))          ; 3 in flight → not calm
    ; calm on one module, busy on another → not calm as a whole
    (is (= false (mig/calm? m (fn [mod] (if (= mod "acct") 0 2)))))))

; ── use case 6: reroute — transform an in-flight message ────────────────

(deftest reroute-transforms-in-flight
  (let [m (mig/migration {:strategy :reroute
                          :fn (fn [msg] (if (= msg :inc) {:inc 1} msg))})]
    (is (= {:inc 1} (mig/reroute-message m :inc)))    ; legacy bare :inc upgraded
    (is (= {:inc 5} (mig/reroute-message m {:inc 5}))) ; already new shape, untouched
    ; plan reports what WOULD change, committing nothing
    (let [p (mig/plan m [:inc {:inc 9}])]
      (is (= 2 (count p)))
      (is (= true (:changed? (first p))))
      (is (= false (:changed? (second p)))))))

; ── use case 7: dispatch coverage — a migrated msg must land on an arm ───

(deftest migrated-message-must-land-on-an-arm
  (let [handler-src (str "(defmulti handle :tag)\n"
                         "(defmethod handle :inc [m] m)\n"
                         "(defmethod handle :read [m] m)\n")
        forms   (BeamLisp.Reader/read_string handler-src)
        ; the WHOLE dispatch table, gathering the multimethod's scattered arms
        clauses (model/transitions-for-multi forms "handle")]
    (is (= 2 (count clauses)))
    ; :inc and :read are covered; :reset is not — a migration mapping to :reset
    ; would land on no arm (the multiple-dispatch analogue of a dangling ref).
    (is (= true (mig/lands-on-arm? clauses :inc)))
    (is (= true (mig/lands-on-arm? clauses :read)))
    (is (= false (mig/lands-on-arm? clauses :reset)))))
