(ns reload.binding-test (:require [reload.binding :as binding] [reload.binding-data :as data]
                                [reload.generation :as g] [env]))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))
(defn- options [value]
 {:roots ["late.caller"] :stable-namespaces #{"reload.binding"}
  :sources {"late.caller" "(ns late.caller (:require [reload.binding :as late])) (defn run [x] (late/call! \"late.target/value\" [x]))"
            "late.target" (str "(ns late.target (:require [reload.binding :as late])) (defn value [x] (if x " value " (late/call! \"late.caller/run\" [true])))")}})

(deftest exact-graph-late-cycles-discover-their-targets-and-preserve-old-callers
 (let [old (g/prepare! (options 1)) next (g/prepare! (options 2))]
  (try
   (is (contains? (:mapping old) "late.target"))
   (is (= 1 (g/invoke! old "late.caller/run" [false])))
   (is (= 2 (g/invoke! next "late.caller/run" [false])))
   (is (= 1 (g/invoke! old "late.caller/run" [false])))
   (is (= :unsealed-entrypoint
        (kind #(g/with! old (fn [] (binding/call! "late.ambient/value" []))))))
   (finally (g/retire! old) (g/retire! next)))))

(deftest static-reference-contract-refuses-dynamic-and-missing-targets
 (is (= ["late.target/value"] (data/references (get-in (options 1) [:sources "late.caller"]))))
 (is (= [] (data/references "(ns late.data) (def quoted '(reload.binding/call! not-a-reference))")))
 (doseq [source ["(ns late.bad (:require [reload.binding :as late])) (defn run [target] (late/call! target []))"
                 "(ns late.bad (:require [reload.binding :as late])) (defn run [] late/call!)"
                 "(ns late.bad (:require [reload.binding :as late])) (defn run [] (late/call! \"bad\" []))"]]
  (is (= :invalid-late-binding (kind #(data/references source)))))
 (is (= :unsealed-late-binding
      (kind #(g/prepare! (update (options 1) :sources dissoc "late.target")))))
 (is (= :invalid-late-binding
      (kind #(g/prepare! (assoc-in (options 1) [:sources "late.target"] "(ns late.target) (def value 9)"))))))

(deftest resolved-refers-cannot-borrow-or-dynamically-select-a-late-call
 (doseq [body ["(defn run [target] (call! target []))" "(defn run [] call!)"]]
  (is (= :invalid-late-binding
       (kind #(g/prepare! {:stable-namespaces #{"reload.binding"}
                           :sources {"late.referred" (str "(ns late.referred (:require [reload.binding :refer [call!]])) " body)}}))))))

(deftest trusted-macro-expansion-cannot-hide-a-dynamic-target
 (let [context (env/capture)]
  (try
   (env/eval "(ns late.trusted-macro) (defmacro hidden [name] (list 'defn name ['target] (list 'reload.binding/call! 'target [])))")
   (env/bind context)
   (is (= :invalid-late-binding
        (kind #(g/prepare! {:stable-namespaces #{"reload.binding" "late.trusted-macro"}
                           :sources {"late.expanded" "(ns late.expanded (:require [reload.binding] [late.trusted-macro :as macros])) (macros/hidden run)"}}))))
   (finally (env/bind context)))))
