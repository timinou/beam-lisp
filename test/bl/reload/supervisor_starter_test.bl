; Actual source trees, real OTP supervisor initialization/restarts, and immutable
; native starter receipts. Root runs only on the coherent Env/Supervisor floor.
(ns reload.supervisor-starter-test
 (:require [reload.generation :as g] [env] [proc.super :as super]))
(defn- graph []
 (let [root (str (System/get_env "HOME") "/tmp/supervisor-starter-" (erlang/unique_integer (list :positive)))
       file (str root "/supervisor/starter.bl")]
  (File/mkdir_p! (Path/dirname file))
  (File/write! file
   "(ns supervisor.starter (:require [proc.super :as super] [reload.execution :as execution]))
    (defserver child
     (init [value] (ok {:value value :owned (execution/owned?)}))
     (handle-call :read [_ state] (reply state state)))
    (defserver ignored
     (init [_]
      (erlang/send (execution/runtime-resource :ignored/observer) [:managed-ignored (erlang/self)])
      (ignore)))
    (super/defsupervisor ignored-tree (child :ignored ignored nil {}))
    (super/defsupervisor tree (child :worker child {:tree true} {}))
    (super/defsupervisor pooled (child :workers (pool child 2)))
    (defn start-tree [] (start-link tree))
    (defn start-ignored [] (start-link ignored-tree))
    (defn start-pool [] (start-link pooled))
    (defn tree-spec [] tree)
    (defn child-class [] child)")
  (try
   (BeamLisp.Loader/with_load_path root
    #(g/prepare! (g/project-plan {:application-id "supervisor-starter-test"
       :entrypoint "supervisor.starter/start-tree" :fixed-runtime true :native-modules #{"erlang"}})))
   (finally (File/rm_rf! root)))))
(defn- stop! [pid] (when (and pid (Process/alive? pid)) (try (Supervisor/stop pid :normal 5000) (catch _ nil))))
(defn- child [pid] (let [rows (Supervisor/which_children pid)]
                    (some (fn [row] (when (erlang/is_pid (elem row 1)) (elem row 1))) rows)))
(defn- replacement [sup before]
 ;; Probe only native OTP child inventory, never replay construction. Repeated
 ;; yield allows OTP to finish its actual restart; timeout is a test failure.
 (let [deadline (+ (erlang/monotonic_time :millisecond) 5000)]
  (loop []
   (let [after (child sup)]
    (cond (and after (not= before after)) after
          (> (erlang/monotonic_time :millisecond) deadline) nil
          :else (do (Process/sleep 1) (recur)))))))

(deftest managed-supervisor-owns-its-full-graph-before-initial-children-and-restarts
 (let [graph (graph) parent (erlang/self) tree (g/invoke! graph "supervisor.starter/start-tree" [])]
  (try
   (let [owner (g/owner-evidence tree) first (child tree) initial (g/owner-evidence first)]
    (is (= :supervisor (:kind owner)))
    (is (= parent (get-in owner [:starter :creator])))
    (is (= tree (get-in owner [:starter :child])))
    (is (= :supervisor (get-in owner [:starter :kind])))
    (is (= tree (get-in initial [:starter :creator])))
    (is (= (:digest graph) (:generation initial)))
    (is (= {:value {:tree true} :owned true} (call first :read)))
    (is (some #(= parent %) (elem (Process/info tree :links) 1)))
    (is (= :waiting (:status (g/retire! graph))))
    (Process/exit first :kill)
    (let [next (replacement tree first) evidence (g/owner-evidence next)]
     (is (erlang/is_pid next)) (is (not= first next))
     (is (= tree (get-in evidence [:starter :creator])))
     (is (not= (get-in initial [:starter :attempt]) (get-in evidence [:starter :attempt])))
     (is (= {:value {:tree true} :owned true} (call next :read)))))
   (finally (stop! tree) (g/retire! graph)))))

(deftest fixed-native-pool-subtree-gets-its-own-authenticated-custody
 (let [graph (graph) tree (g/invoke! graph "supervisor.starter/start-pool" [])]
  (try
   (let [sub (child tree) rows (Supervisor/which_children sub) owner (g/owner-evidence sub)]
    (is (= :supervisor (:kind owner)))
    (is (= tree (get-in owner [:starter :creator])))
    (is (= 3 (count rows)))
    (doseq [row rows]
     (let [pid (elem row 1) evidence (g/owner-evidence pid)]
      (is (erlang/is_pid pid))
      (is (= sub (get-in evidence [:starter :creator])))
      (is (= (:digest graph) (:generation evidence))))))
   (finally (stop! tree) (g/retire! graph)))))

(defserver unmanaged-ignored
 (init [observer] (erlang/send observer [:unmanaged-ignored (erlang/self)]) (ignore)))
(defn- down! [pid]
 (let [ref (Process/monitor pid)]
  (try (receive [:DOWN seen :process dead _] :when (and (= ref seen) (= pid dead)) :down
         (after 5000 :missing))
   (finally (Process/demonitor ref (list :flush))))))
(deftest ignored-unmanaged-child-preserves-the-real-otp-ignore-protocol
 (let [spec {:strategy :one-for-one
             :children [(BeamLisp.Supervisor/server :ignored unmanaged-ignored (erlang/self))]}
       tree (BeamLisp.Supervisor/start_link spec)]
  (try
   (let [pid (receive [:unmanaged-ignored child] child (after 5000 nil))
         rows (Supervisor/which_children tree)]
    (is (erlang/is_pid pid)) (is (= :down (down! pid)))
    (is (= 1 (count rows))) (is (= :ignored (elem (first rows) 0)))
    (is (= :undefined (elem (first rows) 1))))
   (finally (stop! tree)))))
(deftest ignored-managed-child-hands-custody-to-the-native-child-until-down
 (let [graph (graph)
       _ (g/with! graph #(g/bind-runtime! {:ignored/observer (erlang/self)}))
       tree (g/invoke! graph "supervisor.starter/start-ignored" [])]
  (try
   (let [pid (receive [:managed-ignored child] child (after 5000 nil))
         rows (Supervisor/which_children tree)]
    (is (erlang/is_pid pid)) (is (= :down (down! pid)))
    (is (= :supervisor (:kind (g/owner-evidence tree))))
    (is (= 1 (count rows))) (is (= :undefined (elem (first rows) 1)))
    (is (nil? (g/owner-evidence pid)))
    (is (= :waiting (:status (g/retire! graph)))))
   (finally (stop! tree) (g/retire! graph)))))

(deftest copied-supervised-context-cannot-authorize-an-unregistered-starter
 (let [graph (graph) token (g/with! graph env/capture)
       class (g/invoke! graph "supervisor.starter/child-class" [])
       spec (g/invoke! graph "supervisor.starter/tree-spec" []) before (env/capture)]
  (try
   (env/bind token)
   (is (= :refused (try (BeamLisp.Supervisor/start_link spec) :accepted (catch _ :refused))))
   (is (= :refused
          (try (BeamLisp.Supervisor/start_server class nil (tuple :"$bl_supervised_context" token nil))
            :accepted (catch _ :refused))))
   (is (= :refused (try (BeamLisp.Env/with_supervisor_execution! (fn [] :forged)) :accepted (catch _ :refused))))
   ;; Calling the init endpoint as ordinary code does not create its OTP frame.
   (is (= :refused
          (try (BeamLisp.Supervisor/init
                 (tuple :bl_managed_supervisor (tuple :bl_server_start (erlang/self) (erlang/make_ref))
                        token (list) (list (tuple :strategy :one_for_one))))
            :accepted (catch _ :refused))))
   (finally (env/bind before) (g/retire! graph)))))

(deftest checked-source-refuses-internal-native-tree-entries-before-execution
 (doseq [entry ["init" "start_server" "start_named_sup" "start_managed_tree" "managed_children"]]
  (is (= :unmanaged-compiled-producer
         (try (g/prepare! {:application-id "source-supervisor-internal-refusal"
                 :native-modules #{"BeamLisp.Supervisor"}
                 :sources {"internal.tree" (str "(ns internal.tree) (defn invoke [] (BeamLisp.Supervisor/" entry " nil))")}})
              :accepted (catch error (:kind (ex-data error))))))))
