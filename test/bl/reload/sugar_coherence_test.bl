(ns reload.sugar-coherence-test
 (:require [reload] [reload.generation :as generation] [env] [deferred] [codebase]))
(def source "(ns sugar.fixture) (defn value [] (cond-> {:base 1} true (assoc :added 2)))")
(deftest implicit-sugar-resolves-in-analysis-exactly-as-it-does-in-the-runtime
 (is (BeamLisp.Env/bound? "sugar.fixture" "cond->"))
 (is (contains? (env/implicit-names) "cond->"))
 (is (contains? (codebase/core-callee-names "sugar.fixture") "cond->"))
 (is (= [] (deferred/collect-unknown-calls (BeamLisp.Reader/read_string source) "sugar.fixture")))
 (is (= [] (reload/coherence [["sugar.fixture" source]]))))
(deftest sealed-generation-accepts-real-sugar-without-exempting-application-source
 (let [g (generation/prepare! {:sources {"sugar.fixture" source}})]
  (try
   (is (= {:base 1 :added 2} (generation/invoke! g "sugar.fixture/value" [])))
   (finally (is (= :retired (:status (generation/retire! g))))))))
(deftest local-shadowing-and-genuinely-missing-calls-keep-their-native-meaning
 (let [g (generation/prepare! {:sources {"sugar.shadow" "(ns sugar.shadow) (defn cond-> [n] (+ n 1)) (defn value [] (cond-> 7))"}})]
  (try (is (= 8 (generation/invoke! g "sugar.shadow/value" [])))
   (finally (generation/retire! g))))
 (let [errors (reload/coherence [["sugar.missing" "(ns sugar.missing) (defn value [] (truly-missing 7))"]])]
  (is (= :dangling (:kind (first errors))))))
