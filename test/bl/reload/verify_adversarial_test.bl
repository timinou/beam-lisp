; test/bl/reload/verify_adversarial_test.bl — the migration verifier's teeth.
;
; Every test here is a subtly-WRONG migration that MUST be caught at verify time,
; never reaching a live process — plus the soundness-floor cases: a SAFE
; migration must be accepted (a verifier that rejects everything is useless), and
; the honest fallback must be flagged, never a false proof.
;
; The suite invariant: verify-migration is sound — it accepts a migration only
; when the deduced invariant is provably preserved, and rejects (or falls back,
; flagged) otherwise.

(ns reload.verify-adversarial-test
  (:require [reload.migrate :as mig] [system.model :as model] [z3]))

(def port (z3/open))

(def acct-src
  (str "(defserver acct\n"
       "  (init [] (ok 100))\n"
       "  (handle-call [:withdraw amt] [_ balance] :when (>= balance amt)\n"
       "    (reply :ok (- balance amt))))"))
(def acct (first (BeamLisp.Reader/read_string acct-src)))
(def decls "(declare-const b1 Int)\n(declare-const b2 Int)\n")

(defn- migrate-of [expr]
  (mig/migration {:strategy :reroute :decls decls :v1 "b1" :v2 "b2" :migrate expr}))

; ── SOUNDNESS FLOOR: a safe migration MUST be accepted ──────────────────

(deftest safe-migration-accepted
  ; identity migration trivially preserves balance ≥ 0
  (is (= true (:verified (mig/verify-migration port (migrate-of "b1") acct))))
  ; adding a non-negative constant also preserves it
  (is (= true (:verified (mig/verify-migration port (migrate-of "(+ b1 10)") acct)))))

; ── ADVERSARIAL 1: a migration that can go negative is REJECTED ─────────

(deftest subtract-breaks-invariant
  (let [r (mig/verify-migration port (migrate-of "(- b1 1000)") acct)]
    (is (= false (:verified r)))
    (is (= :breaks-invariant (:reason r)))))

; ── ADVERSARIAL 2: a sign flip is REJECTED ──────────────────────────────

(deftest sign-flip-rejected
  ; negating a positive balance breaks (>= balance 0) for any b1 > 0
  (let [r (mig/verify-migration port (migrate-of "(- 0 b1)") acct)]
    (is (= false (:verified r)))))

; ── ADVERSARIAL 3: a blocked migration comes WITH a repair ──────────────

(deftest blocked-carries-repair
  (let [r (mig/verify-migration port (migrate-of "(- b1 1000)") acct)]
    (is (= false (:verified r)))
    (is (contains? r :repair))))

; ── ADVERSARIAL 4: a dropped dispatch arm is caught (no-target) ─────────

(deftest migrated-message-landing-on-no-arm-is-caught
  (let [handler-src (str "(defmulti handle :tag)\n"
                         "(defmethod handle :inc [m] m)\n"
                         "(defmethod handle :read [m] m)\n")
        clauses (model/transitions-for-multi (BeamLisp.Reader/read_string handler-src) "handle")]
    ; a migration that rewrites :inc → :reset would land on NO arm — the
    ; multiple-dispatch analogue of a dangling reference.
    (is (= false (mig/lands-on-arm? clauses :reset)))
    (is (= true (mig/lands-on-arm? clauses :inc)))))

; ── SOUNDNESS FLOOR 2: the honest fallback is FLAGGED, never a false proof ─

(deftest no-invariant-shape-falls-back-flagged
  ; a handler whose shape yields no arithmetic invariant to discover
  (let [src "(defserver noop (init [] (ok 0)) (handle-call [:ping] [_ s] (reply :ok s)))"
        node (first (BeamLisp.Reader/read_string src))
        r (mig/verify-migration port (migrate-of "b1") node)]
    ; it still verifies (the migration is observation-preserving), and the
    ; source of R is honest — either a discovered trivial invariant or the
    ; observable-eq fallback, never silently claimed as proven arithmetic.
    (is (= true (:verified r)))
    (is (contains? #{:discovered :observable-eq :explicit} (:r-source r)))))

; ── ADVERSARIAL 5: an explicit wrong invariant is still checked, not trusted ─

(deftest explicit-invariant-is-checked-not-trusted
  ; claim (>= v 0) but migrate to a negative — the CHECK still catches it, the
  ; explicit relation does not get a free pass.
  (let [inv (fn [v] (str "(>= " v " 0)"))
        m (mig/migration {:strategy :reroute :invariant inv :decls decls
                          :v1 "b1" :v2 "b2" :migrate "(- b1 1000)"})
        r (mig/verify-migration port m acct)]
    (is (= false (:verified r)))))
