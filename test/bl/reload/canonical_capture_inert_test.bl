; Actual unmanaged SDK hook calls, no invented preparation/private tables.
; Lazy/callable operands must remain untouched outside a managed Source owner.
(ns reload.canonical-capture-inert-test (:require [reload.declaration :as declaration]))
(deftest nonmanaged-canonical-capture-never-reads-or-forces-its-operands
 (let [effects (atom 0)
       action (fn [] (swap! effects inc) (throw :inert-hook-must-not-invoke))
       delayed (lazy-seq (action))]
  (is (= false (declaration/preparing?)))
  ;; A real callable is an invalid class/name if name is inspected; lazy clause
  ;; and vocabulary values fail if seq/lookup is attempted. None is touched.
  (is (nil? (declaration/capture-canonical-reconcile! action delayed delayed)))
  (is (nil? (declaration/capture-canonical-reconcile! delayed action action)))
  (is (nil? (declaration/capture-canonical-reconcile! {:callback action} delayed {:reconcile action})))
  (is (= 0 @effects))
  (is (= false (declaration/preparing?)))))
