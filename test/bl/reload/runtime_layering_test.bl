; Actual ordinary SDK integration controls. Native execution is UNRUN.
(ns reload.runtime-layering-test
 (:require [reload :as public] [reload.runtime :as runtime] [reload.generation :as g]
           [vm.image :as image]))
(defn- refusal [f] (try (f) nil (catch error (ex-data error))))
(defn- restore-environment! [prior]
 (doseq [[key value] prior]
  (if (nil? value) (System/delete_env key) (System/put_env key value))))

(deftest public-cells-are-the-exact-leaf-cells-and-mutations-are-shared
 (let [key (str "runtime-cell-control-" (erlang/unique_integer (list :positive)))
       prior @runtime/policy-override]
  (try
   (is (erlang/== public/live-generations runtime/live-generations))
   (is (erlang/== public/policy-override runtime/policy-override))
   (swap! public/live-generations assoc key :from-public)
   (is (= :from-public (get @runtime/live-generations key)))
   (swap! runtime/live-generations assoc key :from-leaf)
   (is (= :from-leaf (get @public/live-generations key)))
   (is (= false (public/set-enabled! false)))
   (is (= false @runtime/policy-override))
   (is (= false (runtime/reload-enabled?)))
   (is (= true (runtime/set-enabled! true)))
   (is (= true @public/policy-override))
   (is (= true (public/reload-enabled?)))
   ;; Public mutable-cell compatibility remains exactly the original contract.
   (reset! public/policy-override false)
   (is (= false (runtime/reload-enabled?)))
   (is (= false (public/reload-enabled?)))
   (finally (swap! runtime/live-generations dissoc key)
            (runtime/set-enabled! prior)))))

(deftest environment-policy-and-public-image-kind-preserve-original-semantics
 (let [keys ["BL_BIN" "BEAM_LISP_IMAGE" "BEAM_LISP_DEV" "BEAM_LISP_RELOAD"]
       prior-env (into {} (map (fn [key] [key (System/get_env key)]) keys))
       prior @runtime/policy-override]
  (try
   (doseq [key keys] (System/delete_env key)) (runtime/set-enabled! nil)
   (is (= "dev" (public/image-kind)))
   (is (= true (runtime/reload-enabled?)))
   (is (= (public/reload-enabled?) (runtime/reload-enabled?)))
   (System/put_env "BEAM_LISP_IMAGE" "release")
   (is (= "release" (public/image-kind)))
   (is (= false (runtime/reload-enabled?)))
   (is (= (public/reload-enabled?) (runtime/reload-enabled?)))
   (System/put_env "BL_BIN" "/fixture/compound")
   (is (= "drop" (public/image-kind)))
   (is (= false (runtime/reload-enabled?)))
   (System/put_env "BEAM_LISP_RELOAD" "1")
   (is (= true (runtime/reload-enabled?)))
   (is (= "drop" (public/image-kind)))
   (System/put_env "BEAM_LISP_DEV" "true")
   (is (= "dev" (public/image-kind)))
   (is (= true (runtime/reload-enabled?)))
   (is (= (image/kind) (public/image-kind)))
   (finally (runtime/set-enabled! prior) (restore-environment! prior-env)))))

(deftest actual-generation-publication-observes-both-public-and-leaf-policy
 (let [a (g/prepare! {:application-id "runtime-leaf-publication"
                     :sources {"runtime.leaf.fixture" "(ns runtime.leaf.fixture) (defn value [] 23)"}})
       slot (g/slot) prior @runtime/policy-override]
  (try
   (public/set-enabled! false)
   (is (= {:status :held :reason :reload-disabled} (g/publish! slot nil a)))
   (is (nil? (g/selected slot)))
   (is (= false (runtime/reload-enabled?)))
   (runtime/set-enabled! true)
   (is (= :applied (:status (g/publish! slot nil a))))
   (is (= (:digest a) (g/selected slot)))
   (is (= 23 (g/call! slot "runtime.leaf.fixture/value" [])))
   (let [fresh (get (:mapping a) "runtime.leaf.fixture")]
    (is (= :sealed (get @runtime/live-generations fresh)))
    (is (= :sealed (get @public/live-generations fresh))))
   (finally (g/close! slot (g/selected slot)) (g/retire! a)
            (runtime/set-enabled! prior)))))

(deftest legacy-coherence-and-generation-errors-still-refuse-before-publication
 (let [slot (g/slot)
       missing "(ns runtime.coherence.missing) (defn value [] (missing-runtime-name))"
       promise "(ns runtime.coherence.promise) (declare later) (defn value [] (later))"
       typed "(ns runtime.coherence.typed) (defn value [] (inc \"not numeric\"))"]
  (is (some #(= :dangling (:kind %)) (public/coherence [["runtime.coherence.missing" missing]])))
  (is (some #(= :promise (:kind %)) (public/coherence [["runtime.coherence.promise" promise]])))
  (is (some #(= :type (:kind %)) (public/coherence [["runtime.coherence.typed" typed]])))
  (let [bad (refusal #(g/prepare! {:sources {"runtime.coherence.missing" missing}}))]
   (is (= :incoherent-generation (:kind bad)))
   (is (some #(= :dangling (:kind %)) (:errors bad))))
  (is (= :unresolved-declaration
         (:kind (refusal #(g/prepare! {:sources {"runtime.coherence.promise" promise}})))))
  (let [bad (refusal #(g/prepare! {:sources {"runtime.coherence.typed" typed}}))]
   (is (= :incoherent-generation (:kind bad)))
   (is (some #(= :type (:kind %)) (:errors bad))))
  (is (nil? (g/selected slot)))))

(deftest actual-generation-sdk-unit-imports-do-not-recreate-the-eager-reload-edge
 ;; Source SDK receipt only; no manual marking, fake inventory or injected BEAM.
 (let [mod (BeamLisp.Emit/module_for "reload.generation")
       receipts (BeamLisp.AOT/source_sdk_receipts)
       unit (get receipts mod) source (:source unit)
       rows (filter #(= source (:source (second %))) receipts)
       targets (concat (mapcat #(:imports (second %)) rows)
                       (mapcat #(:unit-references (second %)) rows))
       high-level-source (:source (get receipts (BeamLisp.Emit/module_for "reload")))]
  (is (BeamLisp.AOT/sdk_unit_compiled? "reload.generation"))
  (is (some? unit))
  (is (some? high-level-source))
  (is (> (count rows) 1))
  (is (not= source high-level-source))
  (is (not-any? #(= high-level-source (:source (get receipts %))) targets))))
