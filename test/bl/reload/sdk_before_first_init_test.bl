;; The launcher retains and initializes SDK code before Ward starts. Use the
;; artifact's bare native bootstrap so these checks actually precede first init.
(ns reload.sdk-before-first-init-test
 (:require [test.support.source-fixtures :as fixtures]))
(deftest actual-cold-sdk-first-load-and-refusal-boundaries
 (let [[output status] (fixtures/cold! "test/fixtures/sdk_before_first_init.bl")]
  (is (= 0 status) output)
  (is (String/contains? output "SDK_FIRST_INIT_READY") output)))
