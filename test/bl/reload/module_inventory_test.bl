(ns reload.module-inventory-test (:require [reload.generation :as g] [env]))

(deftest actor-only-namespaces-retain-the-actor-without-inventing-a-function-bridge
 (let [graph (g/prepare! {:sources {"inventory.actor" "(ns inventory.actor) (defserver owner (init [_] (ok nil)))"}})
       physical (get (:mapping graph) "inventory.actor")
       actor (BeamLisp.Server/module_for physical "owner")
       shim (BeamLisp.Emit/module_for physical)]
  (try
   (is (contains? (set (:modules graph)) actor))
   (is (not (contains? (set (:modules graph)) shim)))
   (is (= false (code/is_loaded shim)))
   (is (= :retained (g/with! graph (fn [] :retained))))
   (finally (g/retire! graph)))))

(deftest missing-real-callback-code-still-refuses-a-lease
 (let [graph (g/prepare! {:sources {"inventory.callback" "(ns inventory.callback) (def callback (fn [] :available))"}})
       module (first (filter #(String/starts_with? (erlang/atom_to_binary % :utf8) "Elixir.BeamLisp.Eval.") (:modules graph)))]
  (try
   (is (some? module))
   (is (= :available (g/invoke! graph "inventory.callback/callback" [])))
   (is (= true (code/delete module)))
   (is (= false (code/is_loaded module)))
   (is (= :refused (try (g/invoke! graph "inventory.callback/callback" []) :accepted (catch _ :refused))))
   (is (empty? (:tickets @(:state graph))))
   ;; This deliberately destroyed unit cannot issue a fresh native retirement
   ;; proof. The isolated process owns the remaining negative-fixture lifetime.
   (is (= :missing-native-retirement-module
          (try (g/retire! graph) :accepted (catch error (:kind (ex-data error))))))
   (is (nil? (g/native-retirement-outcome graph)))
   (finally
    (try (g/retire! graph)
     (catch error
      (when-not (= :missing-native-retirement-module (:kind (ex-data error))) (throw error))))))))
