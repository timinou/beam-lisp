; Native UNRUN. Negative integration gate; never fabricate an attested v2 graph,
; successful private Source producer, Conn custody or SDK lease for a test.
(ns reload.reconcile-snapshot-gate-test
 (:require [reload.reconcile-snapshot :as snapshot] [reload.generation :as g]))
(defn- reason [action] (try (action) nil (catch e (:reason (ex-data e)))))
(deftest a-genuine-v1-graph-cannot-enable-v2-with-a-source-shaped-recipe
 (let [graph (g/prepare! {:application-id (str "typed-v2-negative-" (erlang/unique_integer (list :positive)))
                         :sources {"typed.v2.negative" "(ns typed.v2.negative) (defn value [] :original)"}})
       ;; Explicit negative Source-shaped metadata; not an issued private proof.
       proposed {:version 2 :declaration "typed.v2.negative/fake"
                 :snapshot-scope :selected-versioned :reifier "typed.v2.negative/value"
                 :snapshot-slots [] :callback-constructors {}}]
  (try
   (is (erlang/function_exported :Elixir.BeamLisp.Env :assert_native_framework_execution! 0))
   (is (= :missing-sealed-typed-recipe
         (reason #(g/with! graph (fn [] (snapshot/reify! graph proposed []))))))
   (is (= :original (g/invoke! graph "typed.v2.negative/value" [])))
   (is (nil? (g/native-retirement-outcome graph)))
   (finally (g/retire! graph)))))
