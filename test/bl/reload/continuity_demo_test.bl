(ns reload.continuity-demo-test
 (:require [continuity.desk :as desk] [proc.evolve :as evolve] [reload.generation :as generation]
           [datom :as d] [datom.schema :as schema] [datom.conn :as conn]))

(deftest conference-demo-exercises-native-refusal-publication-recovery-and-retirement
 (let [root (str (System/get_env "HOME") "/tmp/continuity-test-" (System/system_time :nanosecond))
       h (desk/open! {:root root :source-root (Path/expand "examples/continuity") :pace-ms 0})
       initial (desk/snapshot h)]
  (try
   (is (= 1 (:version initial)))
   (is (= :refused (:status (desk/scenario! h "bad-message"))))
   (is (= :refused (:status (desk/scenario! h "bad-state"))))
   (is (= :duplicate-data (:kind (desk/scenario! h "bad-data"))))
   (is (not (schema/unique? (conn/schema (:store h)) :receipt/reference)))
   (is (= 1 (:version (desk/snapshot h))))
   (is (:accepted (desk/submit! h "before")))
   (is (:accepted (desk/submit! h "before")))
   (is (= 1 (:orders (desk/snapshot h))))
   (let [result (desk/scenario! h "upgrade")]
    (when-not (= :applied (:status result)) (println {:upgrade-refusal result :observation (select-keys (desk/snapshot h) [:phase :label])}))
    (is (= :applied (:status result))))
   (is (= 2 (:version (desk/snapshot h))))
   (is (:accepted (desk/submit! h "after")))
   (is (= 2 (:reply (desk/submit! h "after"))))
   (is (= 1 (:client-version (desk/snapshot h))))
   ;; Actual work runs while the fault candidate and recovery are active.
   (let [parent (erlang/self)
         [traffic monitor] (spawn-monitor (fn []
                    (doseq [n (range 30)] (desk/submit! h (str "during-" n)) (Process/sleep 35))
                    (erlang/send parent :traffic-done)))]
    (is (= :recovered (:status (desk/scenario! h "recover"))))
    (is (= :traffic-done (receive :traffic-done :traffic-done (after 10000 :timeout))))
    (is (= :normal (receive [:DOWN tag :process _ reason] :when (= monitor tag) reason (after 10000 :timeout)))))
   (let [s (desk/snapshot h)]
    (is (= 4 (:version s)))
    (is (= 32 (:orders s)))
    (is (= (* 1599 32) (:cents s)))
    (is (= 0 (:errors s)))
    (is (= (:actor initial) (:actor s)))
    (is (= (:vm initial) (:vm s)))
    (is (:recovered s)))
   (is (= :retired (:status (desk/scenario! h "drain"))))
   (is (= {:state :done :version 1 :origin 1} (:job (desk/snapshot h))))
   (is (= [] (:legacy-versions (desk/snapshot h))))
   (is (every? :retired (filter #(< (:version %) 4) (:graphs (desk/snapshot h)))))
   (is (:accepted (desk/submit! h "current")))
   (is (= {:orders 33 :gross-cents (* 1599 33)} (:reply (desk/submit! h "current"))))
   (finally (desk/close! h) (File/rm_rf! root)))))
