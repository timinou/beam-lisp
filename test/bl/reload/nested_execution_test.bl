(ns reload.nested-execution-test
 (:require [reload.generation :as g] [diagnostics :as diag] [env]))

(defn graph []
 (g/prepare! {:stable-namespaces #{"reload.generation" "diagnostics"}
              :sources {"nested.target" "(ns nested.target (:require [reload.generation :as g] [diagnostics :as diag])) (defn observe [] {:registrations (:registrations (g/evidence (g/current))) :operation (:diagnostics/operation-id (diag/context))})"}}))

(deftest another-graph-and-thrown-actions-restore-the-outer-execution
 (let [make (fn [seed] (g/prepare! {:resources {:seed seed} :stable-namespaces #{"reload.generation"}
                                  :sources {"nested.value" "(ns nested.value (:require [reload.generation :as g])) (defn value [] (g/resource :seed))"}}))
       a (make 1) b (make 2)]
  (try
   (g/with! a (fn []
     (is (= 1 (g/invoke! a "nested.value/value" [])))
     (is (= 2 (g/invoke! b "nested.value/value" [])))
     (is (= 1 (g/invoke! a "nested.value/value" [])))
     (is (= :caught (try (g/with! a (fn [] (throw :expected))) (catch _ :caught))))))
   (is (= 0 (:registrations (g/evidence a))))
   (is (= 0 (:registrations (g/evidence b))))
   (is (= 1 (g/invoke! a "nested.value/value" [])))
   (finally (g/retire! a) (g/retire! b)))))

(deftest nested-entry-retains-the-request-context-and-one-registration
 (let [generation (graph)]
  (try
   (g/with! generation
    (fn []
     (diag/with-context-fn {:diagnostics/operation-id "nested-operation"}
      (fn []
       (is (= "nested-operation" (:diagnostics/operation-id (diag/context))))
       (let [observed (g/invoke! generation "nested.target/observe" [])]
        (is (= "nested-operation" (:operation observed)))
        (is (= 1 (:registrations observed))))))))
   (is (= 0 (:registrations (g/evidence generation))))
   (finally (g/retire! generation)))))

(deftest explicit-framework-context-boundaries-still-rebind
 (let [generation (graph)]
  (try
   (g/with! generation
    (fn []
     (diag/with-context-fn {:diagnostics/operation-id "local-override"}
      (fn []
       (is (= "local-override" (:operation (g/invoke! generation "nested.target/observe" []))))
       (let [explicit (g/with! generation #(g/invoke! generation "nested.target/observe" []))]
        (is (nil? (:operation explicit)))
        (is (= 2 (:registrations explicit))))
       (is (= "local-override" (:diagnostics/operation-id (diag/context))))))))
   (finally (g/retire! generation)))))

(deftest execution-ownership-does-not-cross-an-env-token
 (let [generation (graph) token (g/with! generation #(env/capture))
       parent (erlang/self)]
  (is (= :retired (:status (g/retire! generation))))
  (let [worker (erlang/spawn (fn []
                 (env/bind token)
                 (erlang/send parent [:nested-result
                   (try (g/invoke! generation "nested.target/observe" []) :unsafe
                        (catch e (:kind (ex-data e))))])))]
   (try
    (is (= :retired-generation
         (receive [:nested-result result] result (after 2000 :timeout))))
    (finally (when (Process/alive? worker) (Process/exit worker :kill)))))))
