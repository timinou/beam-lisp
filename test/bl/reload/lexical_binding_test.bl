(ns reload.lexical-binding-test (:require [reload.generation :as g] [env]))
(defn kind [f] (try (let [graph (f)] (g/retire! graph) :accepted) (catch e (:kind (ex-data e)))))
(deftest legitimate-lexical-resolve-is-not-runtime-reflection
 (let [graph (g/prepare! {:sources {"lexical.parameter" "(ns lexical.parameter) (defn run [resolve x] (resolve x))"}})]
  (try (is (= [:local :x] (g/invoke! graph "lexical.parameter/run" [(fn [x] [:local x]) :x])))
   (finally (g/retire! graph)))))
(deftest let-and-destructured-eval-bindings-are-local-values
 (let [graph (g/prepare! {:sources {"lexical.let" "(ns lexical.let) (defn run [value] (let [{:keys [eval]} value resolve (fn [x] [:local x])] (resolve eval)))"}})]
  (try (is (= [:local :value] (g/invoke! graph "lexical.let/run" [{:eval :value}])))
   (finally (g/retire! graph)))))
(deftest reflective-spellings-can-be-ordinary-lexical-data-and-callees
 (let [graph (g/prepare! {:sources {"lexical.data"
               "(ns lexical.data) (defn value [var] var) (defn run [intern alter-var-root] (intern alter-var-root))"}})]
  (try
   (is (= :data (g/invoke! graph "lexical.data/value" [:data])))
   (is (= [:local :data] (g/invoke! graph "lexical.data/run" [(fn [x] [:local x]) :data])))
   (finally (g/retire! graph)))))
(deftest actual-var-quotation-and-reflective-values-still-refuse
 (doseq [body ["(var value)" "intern" "alter-var-root" "load-file" "load-string"]]
  (is (= :dynamic-code-dependency
       (kind #(g/prepare! {:sources {"lexical.actual"
               (str "(ns lexical.actual) (defn reflect [] " body ")")}}))))))
(deftest a-shadow-in-another-function-does-not-authorize-core-reflection
 (doseq [borrowed ["resolve" "intern" "alter-var-root"]]
  (is (= :dynamic-code-dependency (kind #(g/prepare! {:sources {"lexical.unrelated"
       (str "(ns lexical.unrelated) (defn local [" borrowed "] " borrowed ") (defn reflect [] " borrowed ")")}}))))))
(deftest trusted-macros-cannot-export-an-ambient-core-function-value
 (let [context (env/capture)]
  (try
   (doseq [borrowed ["resolve" "intern" "alter-var-root" "load-file" "load-string"]]
    (env/eval (str "(ns lexical.trusted) (defmacro capture [name] (list 'defn name [] '" borrowed "))"))
    (env/bind context)
    (is (= :dynamic-code-dependency
         (kind #(g/prepare! {:stable-namespaces #{"lexical.trusted"}
          :sources {"lexical.escape" "(ns lexical.escape (:require [lexical.trusted :as macro])) (macro/capture reflected)"}})))))
   (finally (env/bind context)))))
