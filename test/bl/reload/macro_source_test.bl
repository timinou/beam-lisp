(ns reload.macro-source-test
 (:require [reader] [reader-node :as rn] [reload.macro-source :as source]
           [reload.generation :as generation]))

(defn- proper-tree? [node]
 (let [node (rn/node-form node) tag (rn/node-tag node)]
  (if (contains? #{:list :vector :set :map} tag)
   (let [items (rn/node-items node)]
    ;; length refuses improper lists; it must not realize a hidden lazy tail.
    (and (erlang/is_list items) (erlang/is_integer (erlang/length items))
         (every? proper-tree?
          (if (= :map tag)
           (Enum/flat_map items (fn [pair] (list (elem pair 0) (elem pair 1)))) items))))
   true)))

(deftest macro-projections-produce-proper-finite-reader-trees
 (doseq [body ["`(identity ~value)"
              "`(do ~value ~@value)"
              "`[{:quoted ignored/name :unquoted ~value}]"
              "`(outer `(inner ~value ~~value))"
              "'(quoted data/name)"]]
  (let [forms (reader/read-string
               (str "(ns projection.sample) (defmacro sample [value] " body ")") nil)]
   (is (proper-tree? (source/executable-form (second forms)))))))

(deftest projection-does-not-run-unquoted-effects-and-preparation-refuses-them
 (let [name "BL_MACRO_PROJECTION_MUST_NOT_RUN" before (System/get_env name)
       text (str "(ns projection.effect) (defmacro sample [] "
                 "`(identity ~(System/put_env \"" name "\" \"unsafe\"))) "
                 "(defn run [] (sample))")
       forms (reader/read-string text nil)]
  (is (proper-tree? (source/executable-form (second forms))))
  (is (= before (System/get_env name)))
  (is (= :unproved-syntax-constructor
         (try (generation/prepare! {:sources {"projection.effect" text}
                                    :native-modules #{"System"}})
          nil (catch error (:kind (ex-data error))))))
  (is (= before (System/get_env name)))))
