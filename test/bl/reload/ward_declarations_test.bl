(ns reload.ward-declarations-test (:require [reload.ward :as ward] [env]))
(def SOURCE
 "(ns ward.once.fixture) (def executions (atom 0))
  (deftest one-execution (swap! executions inc) (is (= 1 @executions)))
  (run-tests)")

(deftest suite-loading-declares-tests-without-running-an-inline-runner-twice
 (let [result (ward/run (list SOURCE))]
  (is (:ok? result))
  (is (= 1 (get-in (first (:files result)) [:totals :tests])))
  (is (= 1 (get-in (first (:files result)) [:totals :pass])))))

(deftest standalone-evaluation-still-runs-an-inline-test-runner
 (env/isolated (env/current)
  (fn []
   (let [result (env/eval SOURCE)]
    (is (= 1 (:tests result)))
    (is (= 1 (:pass result)))
    (is (= 0 (:fail result)))))))

(deftest declaration-scopes-restore-after-errors-and-nesting
 (is (not (BeamLisp.TestRT/declaring?)))
 (try
  (BeamLisp.TestRT/declarations
   (fn []
    (is (BeamLisp.TestRT/declaring?))
    (BeamLisp.TestRT/declarations (fn [] (is (BeamLisp.TestRT/declaring?))))
    (is (BeamLisp.TestRT/declaring?))
    (throw "declaration fixture")))
  (catch _ nil))
 (is (not (BeamLisp.TestRT/declaring?))))

(deftest native-suite-shared-and-async-runners-execute-inline-fixtures-once
 (let [path (str (System/tmp_dir!) "/declaration-suite-"
                 (erlang/unique_integer (list :positive)) ".bl")]
  (try
   (File/write! path SOURCE)
   (doseq [async? [false true]]
    (let [result (BeamLisp.TestRT/run_suite (list path) (list (tuple :async async?)))]
     (is (= 1 (:tests result)))
     (is (= 1 (:pass result)))
     (is (= 0 (:fail result)))
     (is (= 0 (:error result)))))
   (finally (File/rm path)))))
