(ns reload.sequencer-handoff-test
 (:require [reload] [vm.exec :as exec] [env]))

(deftest stage-and-commit-wait-for-the-sequencer-and-preserve-the-target
 (let [source (str (BeamLisp/cwd) "/priv/host/reload_watcher.bl")
       dir (str (System/tmp_dir!) "/watcher-handoff-" (erlang/unique_integer (list :positive)))
       probe :Elixir.BeamLisp.WatcherHandoffProbe
       _ (File/mkdir_p! dir)
       compiled (BeamLisp.AOT/compile_host_file source
         (list (tuple :module probe) (tuple :output_dir dir) (tuple :file source)
               (tuple :source_hash (crypto/hash :sha256 (File/read! source)))
               (tuple :behaviour :"Elixir.GenServer") (tuple :load? false)))
       _ (code/load_binary probe (erlang/binary_to_list (elem compiled 1)) (File/read! (elem compiled 1)))
       baseline-target (reload/commit-target)
       p (exec/start) parent (erlang/self) target (env/fork)
       blocker (spawn (fn [] (exec/run-reload (fn [] (erlang/send parent :blocked)
                                     (receive :release :ok (after 10000 :timeout))))))]
  (try
   (reload/abort)
   (is (= :blocked (receive :blocked :blocked (after 3000 nil))))
   (let [caller (spawn (fn []
                 (reload/with-target target
                   (fn [] (erlang/send parent [:result
                     (erlang/apply probe :apply_change
                       (list "(ns sequenced.target.fixture) (defn answer [] 42)" "handoff fixture" true))])))))]
    (is (= :waiting (receive [:result _] :premature (after 100 :waiting))))
    (is (= :empty (:status (reload/status))))
    (erlang/send p :release)
    (is (= :applied (:status (receive [:result value] value (after 10000 nil)))))
    (is (= 42 (env/with-env target (fn []
                   (erlang/apply (BeamLisp.Env/fetch! "sequenced.target.fixture" "answer") (list)))))))
   (let [bad (erlang/apply probe :apply_change (list "(" "invalid fixture" true))]
    (is (tuple? bad))
    (is (= :error (elem bad 0))))
   (is (= baseline-target (reload/commit-target)))
   (finally (erlang/send p :release) (reload/abort)
            (GenServer/stop p :normal 30000) (env/destroy target)
            (code/soft_purge probe) (code/delete probe) (File/rm_rf! dir)))))
