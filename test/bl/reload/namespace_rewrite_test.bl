; Exercise the installed SDK; HOME-local prototype loading belongs only in the
; explicitly bounded research benchmark.
(ns reload.namespace-rewrite-test
 (:require [reload.generation :as generation] [reader]))
(defn- helper [name] (BeamLisp.Env/fetch_exact! "reload.generation" name))
(defn- rewritten [source mapping] ((helper "rewrite-source") source nil mapping))
(defn- failure [f] (try (f) nil (catch e (:kind (ex-data e)))))
(def MAPPING {"rewrite.a" "sealed.fixed.rewrite.a" "rewrite.b" "sealed.fixed.rewrite.b"})
(defn- example [self dep call prefix body]
 (str prefix "(ns " self " (:require [" dep " :as b]))\n"
      (String/replace body "__CALL__" call)))
(defn- input [prefix body]
 (example "rewrite.a" "rewrite.b" "(rewrite.b/x)" prefix body))
(defn- expected [prefix body]
 (example "sealed.fixed.rewrite.a" "sealed.fixed.rewrite.b"
          "(sealed.fixed.rewrite.b/x)" prefix body))

(deftest unicode-trivia-and-inert-data-remain-exact
 (doseq [payload ["é" "👩‍💻" "שלום" "👨‍👩‍👧‍👦" "é"]]
  (let [prefix (str "; " payload " rewrite.b/x is a comment\n")
        body (str "(defn f [] [\"" payload "\" 'rewrite.a/f #\"rewrite.b/x\" __CALL__])\n")
        actual (rewritten (input prefix body) MAPPING)]
   (is (= (expected prefix body) actual))
   (is (= (reader/read-all (expected prefix body)) (reader/read-all actual))))))

(deftest every-ascii-reader-prefix-preserves-an-adjacent-combining-mark
 (doseq [form ["@́state" "`́state" "~́state" "~@́state"
               "(́helper __CALL__)" "[́state __CALL__]"
               "{́state __CALL__}" "#{́state __CALL__}" "#(́helper __CALL__)"]]
  (let [body (str "(defn f [́state] " form ")\n")]
   (is (= (expected "" body) (rewritten (input "" body) MAPPING))))))

(deftest nested-rewrites-preserve-quoted-self-and-native-apply
 (let [body "(defn f [] (let [xs [{:x [__CALL__]} #{rewrite.b/x}]] [xs '(rewrite.a/f rewrite.b/x) (erlang/apply :erlang :tuple_size (list (tuple 1 2)))]))\n"
       actual (rewritten (input "" body) MAPPING)
       wanted (String/replace (expected "" body) "#{rewrite.b/x}" "#{sealed.fixed.rewrite.b/x}")]
  (is (= wanted actual))
  (is (= (reader/read-all wanted) (reader/read-all actual)))))

(deftest source-splicing-is-codepoint-based-and-rejects-overlap
 (let [splice (helper "rewrite-edits") source "é👩‍💻"]
  (is (= source (splice source [])))
  (is (= "éשלום" (splice source [{:start 2 :end 5 :text "שלום"}])))
  (is (= (str "<" source ">") (splice source [{:start 0 :end 0 :text "<"} {:start 5 :end 5 :text ">"}])))
  (is (= "שלום" (splice source [{:start 0 :end 5 :text "שלום"}])))
  (is (= :invalid-rewrite-span
         (failure #(splice "abcdef" [{:start 1 :end 5 :text "x"} {:start 2 :end 3 :text "y"}]))))
  (is (= :invalid-rewrite-span
         (failure #(splice "abcdef" [{:start 2 :end 3 :text "x"} {:start 0 :end 1 :text "y"}]))))
  (is (= :invalid-rewrite-span (failure #(splice source [{:start -1 :end 0 :text "x"}]))))
  (is (= :invalid-rewrite-span (failure #(splice source [{:start 5 :end 6 :text "x"}]))))))

(deftest reader-current-tail-slices-first-last-and-discarded-forms-exactly
 (let [stream (BeamLisp.Env/fetch_exact! "reader" "stream")
       next (BeamLisp.Env/fetch_exact! "reader" "read-next-string")
       prefix ";é👩‍💻שלום\n" source (str prefix "(one) #_discarded (two)")
       a (next (stream source "positions.bl")) b (next (nth a 3))]
  (is (= "(one)" (nth a 2))) (is (= "(two)" (nth b 2)))
  (is (= 2 (elem (:pos (nth a 3)) 0)))
  (is (= (+ (erlang/length (unicode/characters_to_list prefix)) 5) (elem (:pos (nth a 3)) 3)))
  (is (= (erlang/length (unicode/characters_to_list source)) (elem (:pos (nth b 3)) 3)))
  (is (= :eof (first (next (nth b 3)))))))

(deftest source-admission-still-refuses-reflection-effects-and-undeclared-dependencies
 (let [opts (fn [body native]
              {:sources {"rewrite.a" (str "(ns rewrite.a) " body)} :native-modules native})]
  (is (= :effectful-generation
         (failure #(generation/plan (opts "(def state (atom {}))" #{})))))
  (is (= :dynamic-code-dependency
         (failure #(generation/plan (opts "(defn f [] (BeamLisp.Env/fetch_exact! \"x\" \"y\"))" #{})))))
  (is (= :undeclared-dependency
         (failure #(generation/plan (opts "(defn f [] (outside.runtime/f))" #{})))))
  (is (= :undeclared-native-target
         (failure #(generation/plan (opts "(defn f [] (erlang/apply :erlang :tuple_size (list (tuple 1 2))))" #{})))))
  (is (map? (generation/plan (opts "(defn f [] (erlang/apply :erlang :tuple_size (list (tuple 1 2))))" #{"erlang"}))))))

(deftest exact-ascii-control-and-old-unicode-offset-regression
 (let [body "(defn f [] [__CALL__ 'rewrite.a/f #\"rewrite.b/x\"])\n"
       source (input "; untouched ASCII comment\n" body)]
  (is (= (expected "; untouched ASCII comment\n" body) (rewritten source MAPPING)))
  (let [body "(defn text [] \"é\")\n(defn f [] __CALL__)\n"
        source (input "" body)
        next (reader/read-next-string (reader/stream source nil))
        after (nth next 3) text (nth next 2)
        old-start (- (String/length source) (erlang/length (:chars after)) (String/length text))]
   ;; The former formula mixes graphemes and codepoints:even the first form
   ;; starts negative when a later string contains a decomposed grapheme.
   (is (neg? old-start))
   (is (= (expected "" body) (rewritten source MAPPING))))))
