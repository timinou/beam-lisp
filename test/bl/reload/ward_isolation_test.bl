; ward_isolation_test.bl — BUG-041: ward forks must isolate mailbox + memos.
;
; Two contamination surfaces:
;
; 1. MAILBOX: ward forks ran in the executor GenServer process, so test `receive`
;    could catch daemon protocol messages ({:"$gen_call", ...}, {:run, port, ...}).
;    Fixed: each test now runs in its own erlang/spawn'd worker with clean mailbox.
;
; 2. MEMOS: lsp.bl's `analyzed-cache` and `diagnostics-cache` were VM-global
;    atoms keyed by [sha] or [ns sha], so one fork could read another's entries.
;    Fixed: caches now keyed by [env-id sha] / [env-id ns sha], fork-scoped.

(ns reload.ward.isolation.test
  (:require [env]))

;; ── mailbox isolation test ─────────────────────────────────

(deftest mailbox-is-clean-in-ward-fork
  ; A test's mailbox must contain ONLY messages the test itself sent — never
  ; daemon protocol traffic. Before the fix, datom.broadcast.test's `receive`
  ; caught {:"$gen_call", {pid, [:alias | ref]}, :queue_depth} and
  ; {:run, #Port, ...} — daemon messages meant for the executor GenServer.
  ;
  ; After the fix: test runs in spawned worker with clean mailbox, so daemon
  ; messages cannot route there (they go to executor's registered name).
  (let [me (erlang/self)]
    ; send ourselves a known marker
    (erlang/send me [:test-marker 42])
    ; drain mailbox with short timeout
    (let [msgs (loop [acc []]
                 (receive
                   m (recur (conj acc m))
                   (after 100 acc)))]
      ; we should see ONLY our marker
      (is (= [[:test-marker 42]] msgs)
          "ward fork mailbox contains only test's own messages")
      ; explicitly check for daemon protocol pollution
      (is (not (some (fn [m]
                       (and (vector? m)
                            (>= (count m) 3)
                            (= :"$gen_call" (get m 0))))
                     msgs))
          "no $gen_call daemon protocol messages in mailbox")
      (is (not (some (fn [m]
                       (and (vector? m)
                            (>= (count m) 3)
                            (= :run (get m 0))))
                     msgs))
          "no :run daemon protocol messages in mailbox"))))

;; ── env id isolation test ───────────────────────────────────

(deftest each-fork-has-distinct-env-id
  ; Each env fork gets a distinct env_id, which is how memo scoping works.
  ; Without distinct ids, caches would leak across forks.
  (let [parent-id (env/id)
        fork1-id (env/isolated (fn [] (env/id)))
        fork2-id (env/isolated (fn [] (env/id)))]
    ; parent is :global or a prior fork
    (is (some? parent-id) "parent has an env id")
    ; each fork gets its own id
    (is (some? fork1-id) "fork 1 has an env id")
    (is (some? fork2-id) "fork 2 has an env id")
    ; forks are distinct from parent
    (is (not (= parent-id fork1-id)) "fork 1 id differs from parent")
    (is (not (= parent-id fork2-id)) "fork 2 id differs from parent")
    ; forks are distinct from each other
    (is (not (= fork1-id fork2-id)) "fork 1 and fork 2 have different ids")))

;; ── process spawn isolation ─────────────────────────────────────

(deftest spawned-worker-has-clean-mailbox
  ; Verify the ward pattern: spawn a worker, do work, send result back.
  ; Worker's mailbox should be clean (no parent messages leak in).
  (let [me (erlang/self)
        ; send a message to ourselves (parent process)
        _ (erlang/send me [:parent-noise])
        ; spawn worker that checks its mailbox
        worker (erlang/spawn
                 (fn []
                   (let [msgs (loop [acc []]
                                (receive
                                  m (recur (conj acc m))
                                  (after 50 acc)))]
                     ; worker should see NOTHING (fresh mailbox)
                     (erlang/send me [:worker-result msgs]))))]
    ; receive worker's result
    (receive
      [:worker-result msgs]
        (is (= [] msgs) "spawned worker has empty mailbox")
      (after 1000
        (is false "worker timed out")))))
