; Bounded history evidence over the SAME pure SDK admission/claim/publication
; decisions. Symbolic model rows are data only, never native authority receipts.
(ns reload.store-opening-model-test
 (:require [veritas.model :as model] [datom.store-opening :as opening]))
(def APP "opening-model")
(def ROOT "/opening-model")
(def RAW {:path "/opening-model/store" :model-store true})
(def CREATOR {:application-id APP :scope :symbolic-model :digest "model"})
(def ROW {:ticket :symbolic-ticket :owner :symbolic-owner :creator CREATOR
          :producer :ets :argument :symbolic-table :path "/opening-model/store" :phase :pending})
(defn- initial [] {:cells {} :allocated false :preflight false :captured #{} :legacy false})
(defn- attempt [f state] (try (f state) (catch _ state)))
(defn- step [state command]
 (case command
  :begin
   (attempt (fn [s]
    (if (:legacy s) (assoc s :preflight true)
     (assoc s :cells (opening/admit (:cells s) ROW)))) state)
  :return
   (cond
    (and (:legacy state) (:preflight state)) (assoc state :allocated true)
    (= :pending (get-in state [:cells :datom.conn/store-openings :symbolic-ticket :phase]))
     (-> state (assoc :allocated true)
         (assoc-in [:cells :datom.conn/store-openings :symbolic-ticket :phase] :returned)
         (assoc-in [:cells :datom.conn/store-openings :symbolic-ticket :store] RAW))
    ;; Unknown owner outcomes stay indexed; later completion is NOT a new right.
    (= :uncertain (get-in state [:cells :datom.conn/store-openings :symbolic-ticket :phase]))
     (assoc state :allocated true)
    :else state)
  :claim
   (if (:allocated state)
    (attempt (fn [s]
     (let [decision (opening/claim (:cells s) RAW CREATOR)]
      (assoc s :cells (assoc (:cells decision) RAW {:model-registered true})))) state) state)
  :gate
   (attempt (fn [s]
    (opening/check-publication! (:cells s) APP ROOT)
    (-> s (assoc-in [:cells :datom.conn/guard-admissions APP] {:application-id APP :root ROOT})
        (assoc :captured (if (get (:cells s) RAW) #{RAW} #{})))) state)
  :owner-down (assoc state :cells (opening/lose-owner (:cells state) :symbolic-ticket))
  :known-finish
   ;; A known source publication finish may release the gate. It NEVER removes
   ;; pending/unknown raw opening evidence; that requires actual Conn claim.
   (update state :cells dissoc :datom.conn/guard-admissions)
  state))
(defn- safe? [s]
 (let [gate (get-in s [:cells :datom.conn/guard-admissions APP])
       row (get-in s [:cells :datom.conn/store-openings :symbolic-ticket])]
  (and
   ;; An opener admitted before a gate must be in that gate's captured Conn
   ;; set, never a newly returning raw handle outside inventory.
   (not (and gate (:allocated s) (not (contains? (:captured s) RAW))))
   ;; Unknown/dead-owner opening is not silently treated as completed.
   (not (and gate row)))))
(defn- machine [legacy?]
 (model/model (if legacy? "preflight-only-opening-race" "indexed-native-opening")
  {:state nil :init (fn [] (atom (assoc (initial) :legacy legacy?)))
   :commands (into {} (map (fn [command]
                    [command {:run (fn [system _] (swap! system #(step % command)))}])
                    [:begin :return :claim :gate :owner-down :known-finish]))
   :invariants {:no-uncaptured-native-open (fn [_ system] (safe? @system))}}))

(deftest old-preflight-only-design-has-the-specific-admit-publish-return-counterexample
 (let [story [[:begin nil] [:gate nil] [:return nil]]
       r (model/replay (machine true) story)]
  (is (= false (:ok r))) (is (= :no-uncaptured-native-open (:broke r)))))

(deftest indexed-protocol-rejects-that-counterexample-and-owner-death-is-not-completion
 (doseq [story [[[:begin nil] [:gate nil] [:return nil]]
                [[:gate nil] [:begin nil] [:return nil]]
                [[:begin nil] [:owner-down nil] [:gate nil] [:return nil]]
                [[:begin nil] [:return nil] [:claim nil] [:gate nil]]]]
  (is (= true (:ok (model/replay (machine false) story)))))
 (let [s (reduce step (initial) [:begin :owner-down :return :gate])]
  (is (= :uncertain (get-in s [:cells :datom.conn/store-openings :symbolic-ticket :phase])))
  (is (nil? (get-in s [:cells :datom.conn/guard-admissions APP])))))

(deftest bounded-interleaving-histories-exercise-real-pure-sdk-decisions
 (let [r (model/check (machine false) {:seed 14 :histories 500 :max-len 12})]
  (is (= :witnessed (:modality r))) (is (= 500 (:tried r)))
  (is (empty? (:unexercised r)))))
