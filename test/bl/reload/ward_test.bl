; test/bl/reload/ward_test.bl — the warm, isolated, coherence-guarded runner.
;
; Each deftest proves one structural property that dissolves the "application
; shutdown" contamination — not by careful teardown, but by construction:
; isolation, a coherence gate, crash-containment, and always-latest source.
;
; NB ward runs test-file SOURCES (strings), so these tests build little suites
; inline and assert on the aggregate result map — a runner testing a runner.

(ns reload.ward-test
  (:require [reload.ward :as ward] [env]))

; ── property 1: a coherent file runs and passes in its own fork ─────────

(deftest coherent-file-passes
  (let [src "(ns w.ok)\n(deftest t (is (= 2 (+ 1 1))))\n"
        r (ward/run (list src))]
    (is (= 1 (:passed r)))
    (is (= 0 (:failed r)))
    (is (= 0 (:incoherent r)))
    (is (:ok? r))))

; ── property 2: a bad file is CONTAINED, never crashes the run ─────────
;
; A file referencing an undefined var is contained: coherence flags it as a
; heads-up warning, and when it runs the undefined call fails inside the fork's
; try (a test error), not the runner. Either way the file is NOT green and the
; sibling still passes — one bad file never fails the others.

(deftest bad-file-is-contained
  (let [bad  "(ns w.bad)\n(deftest t (is (= 1 (no-such-fn))))\n"
        good "(ns w.good)\n(deftest t (is true))\n"
        r (ward/run (list bad good))]
    ; the bad file is not green (failed or incoherent), the good one passed
    (is (= 1 (:passed r)))
    (is (not (:ok? r)))
    (let [good-res (some (fn [x] (if (= "w.good" (:ns x)) x nil)) (:files r))
          bad-res  (some (fn [x] (if (= "w.bad" (:ns x)) x nil)) (:files r))]
      (is (= :passed (:status good-res)))
      (is (not (= :passed (:status bad-res)))))))

; ── property 3: a file that CRASHES at load can't take down siblings ────
;
; A top-level throw at load time is caught inside the fork; the file becomes an
; :incoherent (:load-crash) result and the runner moves on. The strongest form
; of contamination immunity: an explosive file is contained like any other.

(deftest load-crash-is-contained
  (let [crash "(ns w.crash)\n(throw \"boom\")\n(deftest t (is true))\n"
        after "(ns w.after)\n(deftest t (is (= 4 (* 2 2))))\n"
        r (ward/run (list crash after))]
    (is (= 1 (:incoherent r)))
    (is (= 1 (:passed r)))
    (let [crash-res (some (fn [x] (if (= "w.crash" (:ns x)) x nil)) (:files r))]
      (is (= :load-crash (:kind (first (:errors crash-res))))))))

; ── property 4: ISOLATION — one file's defs never leak into the next ────
;
; Each file runs in its own env fork, destroyed on exit. A var defined in one
; file is invisible to another: the fork's registry is the boundary. This is
; why no shared mutable ground exists for one file to pull from another.

(deftest files-are-isolated
  (let [a "(ns w.a)\n(def secret 99)\n(deftest defines (is (= 99 w.a/secret)))\n"
        b (str "(ns w.b)\n"
               "(deftest cannot-see-a (is (= :gone (try (env/eval \"w.a/secret\")"
               " (catch _ :gone)))))\n")
        r (ward/run (list a b))]
    ; both pass: a sees its own secret, b proves it CANNOT see a's
    (is (= 2 (:passed r)))
    (is (:ok? r))))

; ── property 5: a failing assertion is a :failed file, distinct from a ──
;                coherence failure — a real test failure is still surfaced.

(deftest real-failure-is-failed-not-incoherent
  (let [src "(ns w.fails)\n(deftest t (is (= 1 2)))\n"
        r (ward/run (list src))]
    (is (= 0 (:incoherent r)))
    (is (= 1 (:failed r)))
    (is (not (:ok? r)))))

; ── property 6: run-sandboxed is SOUND UNDER CONCURRENCY ────────────────
;
; The env fork isolates the var registry but not the global body module a defn
; compiles (named from the ns string). So concurrent runs of files declaring the
; SAME namespace with DIFFERENT bodies race on one shim — `run` is sequential-
; only. `run-sandboxed` prefixes each run's namespace uniquely, so parallel runs
; compile distinct modules and never collide. We prove it: N processes each run
; a file declaring `shared` with a body unique to its id; every runner must see
; its own value and go green.

(deftest sandboxed-is-concurrency-sound
  (let [me (erlang/self)
        n 16]
    (doseq [i (range n)]
      (erlang/spawn
        (fn []
          (let [src (str "(ns shared)\n(defn tag [] " i ")\n"
                         "(deftest t (is (= " i " (shared/tag))))\n")
                r (ward/run-sandboxed (list src))]
            (erlang/send me [:done i (:ok? r)])))))
    ; collect all N results; every one must be green
    (let [oks (map (fn [_]
                     (receive [:done _i ok] ok (after 8000 :timeout)))
                   (range n))]
      (is (= n (count (filter (fn [ok] (= true ok)) oks))))
      (is (not (some (fn [ok] (= :timeout ok)) oks))))))

; ── property 7: TIER A — a failing file carries structured reports ──────
;
; The suite reports WHY, not just red: each failing assertion rides in the
; result as {:type :test :form :expected :actual}, so a renderer (and a caller)
; sees expected-vs-actual. A passing file carries no reports.

(deftest tier-a-structured-reports
  (let [src "(ns w.why)\n(deftest arith (is (= 5 (+ 2 2))))\n"
        r (ward/run (list src))
        f (first (:files r))
        reps (:reports f)]
    (is (= :failed (:status f)))
    (is (= 1 (count reps)))
    (let [rep (first reps)]
      (is (= :fail (:type rep)))
      (is (= "arith" (:test rep)))
      (is (= 5 (:expected rep)))
      (is (= 4 (:actual rep)))))
  ; a passing file carries no failure reports
  (let [r2 (ward/run (list "(ns w.clean2)\n(deftest ok (is true))\n"))
        f2 (first (:files r2))]
    (is (= :passed (:status f2)))
    (is (empty? (:reports f2)))))

; ── property 8: TIER B — a failing STATEFUL PROCESS is diagnosed ────────
;
; When a failing file defines an annotated `defserver`, ward runs the checker's
; repair (`repair-process`) and attaches it. This is best-effort and honest: it
; fires only for a process with z3 present, and reports `:checked` with the
; per-transition verdict. (A synthesized guard for a defserver that ALSO carries
; an init clause is blocked by FUP-013 — the checker takes the init param as the
; state var; here we assert the MECHANISM fires and reports honestly, not a
; particular guard.) A non-process failure carries no :repair.

(deftest tier-b-process-diagnosis
  ; a plain unit failure → no process, so :repair is nil
  (let [r (ward/run (list "(ns w.unit)\n(deftest t (is (= 1 2)))\n"))
        f (first (:files r))]
    (is (= :failed (:status f)))
    (is (nil? (:repair f))))
  ; a failing file that defines an annotated process → Tier B fires
  (let [src (str "(ns w.proc)\n"
                 "(defserver ^{:invariant (>= balance 0)} acct\n"
                 "  (init [bal] (ok bal))\n"
                 "  (handle-call [:withdraw amt] [_ balance] (reply :ok (- balance amt))))\n"
                 "(deftest overdraw (is (= 1 2)))\n")
        r (ward/run (list src))
        f (first (:files r))]
    (is (= :failed (:status f)))
    ; the checker ran on the process and returned a verdict (may be a guard or,
    ; per FUP-013, an honest 'unrepairable') — the point is Tier B FIRED.
    (when (some? (:repair f))
      (is (contains? (:repair f) :checked))
      (is (contains? (:repair f) :repairs)))))

; ── property 9: the on-event hook fires per file (the dashboard backbone) ──
;
; `run`/`run-sandboxed` take an optional callback fired as each file finishes —
; how a live dashboard fills tile by tile. Default (no callback) is unchanged
; behaviour (proven by every other property calling the 1-arity form).

(deftest on-event-hook-fires
  (let [seen (atom [])
        srcs (list "(ns h.a)\n(deftest t (is true))\n"
                   "(ns h.b)\n(deftest t (is (= 1 2)))\n")
        r (ward/run srcs
                    (fn [ev] (swap! seen (fn [s] (conj s ev)))))
        events (deref seen)
        starts (filter (fn [e] (= :file-start (:phase e))) events)
        dones  (filter (fn [e] (= :file-done (:phase e))) events)]
    ; each file emits BOTH a :file-start (ns only) and a :file-done (ns+status)
    (is (= 2 (count starts)))
    (is (= 2 (count dones)))
    (is (some (fn [e] (= "h.a" (:ns e))) starts))
    (is (some (fn [e] (and (= "h.a" (:ns e)) (= :passed (:status e)))) dones))
    (is (some (fn [e] (and (= "h.b" (:ns e)) (= :failed (:status e)))) dones))
    ; a start always precedes its done (progress ordering)
    (is (= :file-start (:phase (first events))))
    (is (= 1 (:passed r)))
    (is (= 1 (:failed r)))))

; ── property 10: a GLOBAL-MUTATING reload test is ward-valid ─────────────
;
; reload/commit lands a bundle in an env. Ward binds reload's commit-target to
; the test's own fork (reload/with-target), so a test that drives reload/commit
; lands its edits in the fork — isolated (destroyed on exit, no :global leak) AND
; correct (reload's own coherence reads the same env it writes). A cross-ns
; removal, which was falsely :applied under naive isolation, is correctly :held.

(deftest global-mutating-test-is-ward-valid
  ; drive the exact cross-ns-removal shape THROUGH ward, in one file
  (let [src (str "(ns wv.t (:require [reload]))\n"
                 "(deftest crossns\n"
                 "  (reload/abort)\n"
                 "  (reload/stage \"(ns wvx.lib)\\n(defn thing [] :orig)\\n\")\n"
                 "  (reload/stage \"(ns wvx.app)\\n(defn run [] (wvx.lib/thing))\\n\")\n"
                 "  (reload/commit)\n"
                 "  (reload/stage \"(ns wvx.lib)\\n(defn thing2 [] :new)\\n\")\n"
                 "  (is (= :held (:status (reload/commit)))))\n")
        r (ward/run (list src))]
    ; the test passes UNDER WARD (it would falsely fail without target binding)
    (is (:ok? r))
    (is (= 1 (:passed r))))
  ; and nothing leaked into the real :global image
  (is (= 0 (count (filter (fn [n] (some? (index-of n "wvx.")))
                          (BeamLisp.Env/namespaces))))))
