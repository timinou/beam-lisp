(ns reload.system-bridge-test (:require [reload.generation :as g] [vm.osenv :as osenv]))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest compiler-owned-system-environment-bridges-have-the-native-system-authority
 (osenv/with-env {"BL_GRAPH_SYSTEM_FIXTURE" "scoped-value"}
  (fn []
   (let [graph (g/prepare! {:native-modules #{"System"}
                           :sources {"system.bridge" "(ns system.bridge) (defn value [] (System/get_env \"BL_GRAPH_SYSTEM_FIXTURE\")) (defn change [] (System/put_env \"BL_GRAPH_SYSTEM_FIXTURE\" \"local\") [(System/fetch_env! \"BL_GRAPH_SYSTEM_FIXTURE\") (System/fetch_env \"BL_GRAPH_SYSTEM_FIXTURE\")]) (defn clear [] (System/delete_env \"BL_GRAPH_SYSTEM_FIXTURE\") (System/get_env \"BL_GRAPH_SYSTEM_FIXTURE\" \"absent\")) (defn present [] (contains? (System/get_env) \"BL_GRAPH_SYSTEM_FIXTURE\"))"}})]
    (try
     (is (= "scoped-value" (g/invoke! graph "system.bridge/value" [])))
     (is (= ["local" (tuple :ok "local")] (g/invoke! graph "system.bridge/change" [])))
     (is (= "absent" (g/invoke! graph "system.bridge/clear" [])))
     (is (= true (g/invoke! graph "system.bridge/present" [])))
     (is (= "scoped-value" (System/get_env "BL_GRAPH_SYSTEM_FIXTURE")))
     (finally (g/retire! graph)))))))

(deftest system-authority-does-not-grant-reflective-host-access-or-initializers
 (is (= :undeclared-dependency
      (kind #(g/prepare! {:sources {"system.ungranted" "(ns system.ungranted) (defn value [] (System/get_env \"BL_GRAPH_SYSTEM_FIXTURE\"))"}}))))
 (is (= :dynamic-code-dependency
      (kind #(g/prepare! {:native-modules #{"System"}
                          :sources {"system.reflective" "(ns system.reflective) (defn value [] (BeamLisp.Env/os_get_env \"BL_GRAPH_SYSTEM_FIXTURE\"))"}}))))
 (is (= :effectful-generation
      (kind #(g/prepare! {:native-modules #{"System"}
                          :sources {"system.initializer" "(ns system.initializer) (def value (System/get_env \"BL_GRAPH_SYSTEM_FIXTURE\"))"}})))))
