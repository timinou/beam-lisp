(ns reload.native-grant-loading-test (:require [reload.generation :as g]))

(deftest an-explicit-native-grant-loads-and-freezes-its-cold-module
 (let [suffix (str (erlang/unique_integer (list :positive)))
       name (str "NativeGrantFixture" suffix) module (String/to_atom (str "Elixir." name))
       directory (Path/join (System/tmp_dir!) (str "bl-native-grant-" suffix))
       path (Path/join directory (str (Atom/to_string module) ".beam"))
       pair (BeamLisp.Emit/compile_descriptor (BeamLisp.Emit/descriptor_for module
              (list (BeamLisp.Emit/function_clause :answer (BeamLisp.Emit/lit 42)))))
       graph (atom nil)]
  (try
   (File/mkdir_p! directory) (File/write! path (elem pair 1))
   (code/add_patha (String/to_charlist directory))
   (is (= false (code/is_loaded module)))
   (reset! graph (g/prepare! {:native-modules #{name}
                  :sources {"native.grant.application"
                    (str "(ns native.grant.application) (defn run [] (" name "/answer))")}}))
   (is (= 42 (g/invoke! @graph "native.grant.application/run" [])))
   (finally
    (when @graph (g/retire! @graph))
    (code/del_path (String/to_charlist directory))
    (code/purge module) (code/delete module) (File/rm_rf! directory)))))
