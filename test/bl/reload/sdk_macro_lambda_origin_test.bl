(ns reload.sdk-macro-lambda-origin-test
 (:require [reload.generation :as g] [reload.preinit-counter :as counter]))
(defn- reason [action]
 (try (action) nil (catch error
  (if (and (erlang/is_map error) (maps/is_key :original error))
   (maps/get :original error) (or (:kind (ex-data error)) error)))))
(defn- binding [name] (BeamLisp.Env/fetch_exact! "reload.macro-origin-fixture" name))

(deftest canonical-initializer-values-are-callable-while-macro-origins-stay-private
 (let [namespace "reload.macro-origin-fixture"]
  (is (= false (BeamLisp.Env/loaded_ns? namespace)))
  (is (= 0 (counter/value :lambda-origin-init)))
  (BeamLisp.Loader/ensure_loaded namespace)
  (let [public (binding "public-local") private ((binding "callback"))
        macro (second (binding "saved-macro"))]
   (is (= :local (elem (erlang/fun_info public :type) 1)))
   (is (= (BeamLisp.AOT/init_module_for namespace) (elem (erlang/fun_info public :module) 1)))
   (is (= (BeamLisp.AOT/init_module_for namespace) (elem (erlang/fun_info private :module) 1)))
   (is (= (BeamLisp.AOT/macro_value_module_for namespace) (elem (erlang/fun_info macro :module) 1)))
   (is (= 7 (public 4)))
   (is (= 8 (private 4)))
   (is (= 1 ((binding "init-count"))))
   (is (= :unattested_sdk_callback (reason #(BeamLisp.AOT/sdk_callable_evidence! macro))))
   (is (BeamLisp.AOT/sdk_callable_evidence! public))
   (let [generation (g/prepare!
     {:sources {"macro.origin.app"
       "(ns macro.origin.app (:require [reload.macro-origin-fixture :as sdk]))
        (defn public [x] (sdk/public-local x))
        (defn private [x] ((sdk/callback) x))
        (defn compiled [x] (sdk/pass x))
        (defn macro-direct [x] ((erlang/element 2 sdk/privileged) nil {} x))
        (defn macro-alias [x] ((erlang/element 2 sdk/saved-macro) nil {} x))
        (defn macro-nested [x] ((erlang/element 2 (first (:saved sdk/nested-macro))) nil {} x))
        (defn macro-result [x] ((erlang/element 2 (first (:saved (sdk/macro-value)))) nil {} x))
        (defn macro-capture [x] ((sdk/captured) x))"}
      :stable-namespaces #{namespace} :native-modules #{"erlang"}})]
    (try
     (is (= 12 (g/invoke! generation "macro.origin.app/public" [9])))
     (is (= 13 (g/invoke! generation "macro.origin.app/private" [9])))
     (is (= 9 (g/invoke! generation "macro.origin.app/compiled" [9])))
     ;; Each route extracts the actual native macro closure before invoking it;
     ;; a carrier tag/argument check alone cannot satisfy these target checks.
     (doseq [name ["macro-direct" "macro-alias" "macro-nested" "macro-result" "macro-capture"]]
      (is (= :source_native_target_refused
            (reason #(g/invoke! generation (str "macro.origin.app/" name) [9])))))
     (is (= 0 ((binding "macro-count"))))
     (is (= 1 ((binding "init-count"))))
     (is (identical? public (binding "public-local")))
     (is (identical? private ((binding "callback"))))
     (is (= false (BeamLisp.Env/source_execution_active?)))
     (finally (g/retire! generation)))))))

(deftest actual-early-native-macro-partition-keeps-authority-and-bindings-unchanged
 (let [definitions (BeamLisp.Env/ns_defs "core")
       lease (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)
       result (BeamLisp.AOT/assert_bootstrap_macro_partition!)]
  (is (= 11 (:checks result)))
  (is (= 1 (:captured-arguments result)))
  (is (= 0 (:factory-executions result)))
  (is (= 0 (:initializers result)))
  (is (= false (:sdk-authority result)))
  (is (= definitions (BeamLisp.Env/ns_defs "core")))
  (is (= lease (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))))
