; test/bl/reload/ward_load_crash_location_test.bl
;
;   ./bin/bl test test/bl/reload/ward_load_crash_location_test.bl
;
; A test file that raises while it LOADS is reported `INCOHERENT`, and the
; report says where: the file and line of the top-level form that raised, then
; the `.bl` frames inside the code that form called. Without that, `bl test`
; printed only the error text ("2nd argument: not a tuple") while `bl run` on
; the same file showed the line.

(ns reload.ward-load-crash-location-test
  (:require [bl.test :refer [deftest is testing]]
            [reload.ward :as ward]))

(defn- has? [s part]
  (and (string? s) (not= :nomatch (binary/match s part))))

(defn- fixture!
  "Write `src` as `name` in a fresh temp dir. → its path."
  [name src]
  (let [dir (str (System/tmp_dir!) "/ward-load-crash-" (erlang/unique_integer (list :positive)))
        path (str dir "/" name)]
    (File/mkdir_p! dir)
    (File/write! path src)
    path))

(defn- run-one [path]
  (ward/run [{:path path :src (File/read! path)}]))

(def ^:private top-level-crash
  (str "(ns ward-fixture-top (:require [bl.test :refer [deftest is]]))\n"
       "\n"
       "(deftest ok (is (= 1 1)))\n"
       "\n"
       "(elem 5 0)\n"))

(def ^:private nested-crash
  ;; non-tail calls: a call in tail position leaves no frame on the BEAM, so
  ;; only the caller that is still waiting can be shown (as in `bl run`)
  (str "(ns ward-fixture-nested (:require [bl.test :refer [deftest is]]))\n"
       "\n"
       "(defn- boom []\n"
       "  (inc (elem 5 0)))\n"
       "\n"
       "(defn- outer [] (inc (boom)))\n"
       "\n"
       "(outer)\n"))

(deftest a-top-level-raise-names-its-file-and-line
  (let [path (fixture! "top_test.bl" top-level-crash)
        result (run-one path)
        err (first (:errors (first (:files result))))
        text (ward/report result)]
    (is (= :incoherent (:status (first (:files result)))))
    (is (= (str path ":5") (:at err)) (pr-str err))
    (is (has? text (str "INCOHERENT — " path ":5: crashed while loading")) text)))

(deftest a-raise-inside-a-called-function-shows-its-frames
  (let [path (fixture! "nested_test.bl" nested-crash)
        result (run-one path)
        err (first (:errors (first (:files result))))
        text (ward/report result)]
    (testing "the location is the top-level form that started it"
      (is (= (str path ":8") (:at err)) (pr-str err)))
    (testing "the frames name the functions and their lines, innermost first"
      (is (has? (first (:frames err)) (str "boom  " path ":4")) (pr-str (:frames err)))
      (is (has? (second (:frames err)) (str "outer  " path ":6")) (pr-str (:frames err)))
      (is (has? text (str "boom  " path ":4")) text))))

(deftest a-source-string-without-a-path-still-reports
  ;; the older entry shape, a bare source string, has no file to name
  (let [result (ward/run [top-level-crash])
        err (first (:errors (first (:files result))))]
    (is (= :incoherent (:status (first (:files result)))))
    (is (has? (:msg err) "crashed while loading"))
    (is (nil? (:at err)))))

(deftest a-loading-file-still-passes
  (let [path (fixture! "fine_test.bl"
                       (str "(ns ward-fixture-fine (:require [bl.test :refer [deftest is]]))\n"
                            "(defn- two [] 2)\n"
                            "(deftest fine (is (= 2 (two))))\n"))
        result (run-one path)]
    (is (= :passed (:status (first (:files result)))) (pr-str result))))
