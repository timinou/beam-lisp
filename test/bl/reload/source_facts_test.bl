; Behavioral installed-SDK controls; no HOME prototype loader or trusted caller AST.
(ns reload.source-facts-test
 (:require [env] [reader] [source-graph :as graph] [reload.binding-data :as binding] [reload.generation :as g]))
(defn- failure [f] (try (f) nil (catch e (:kind (or (ex-data e) (:original e))))))

(deftest positioned-header-normalizes-nested-author-metadata
 (let [source "(ns ^:private facts.a (:require ^:private [^:private facts.b :as ^:private b :refer [^:private value]] [facts.c :refer :all]))"
       header (graph/header*-nodes (reader/read-string source nil))]
  (is (= "facts.a" (first header)))
  (is (= ["facts.b" "facts.c"] (vec (second header))))
  (is (= {"facts.b" "facts.b" "b" "facts.b" "facts.c" "facts.c"} (nth header 2)))
  (is (= {"value" "facts.b"} (nth header 3)))
  (is (= ["facts.c"] (vec (nth header 4))))))

(deftest per-plan-facts-preserve-identity-sealed-source-and-inert-data
 (let [a "(ns facts.a (:require [facts.b :as b]))\n(defn run [] [\"é👩‍💻שלום\" (facts.b/value) '(facts.a/run facts.b/value)])"
       b "(ns facts.b) (defn value [] 1)"
       opts {:sources {"facts.a" a "facts.b" b} :roots ["facts.a"]
             :application-id "facts-project" :resources {:immutable 1}}
       planned (g/plan opts) mapping (:mapping planned) sa (get mapping "facts.a") sb (get mapping "facts.b")]
  (is (= ["facts.b" "facts.a"] (:order planned)))
  (is (String/starts_with? sa "sealed.g"))
  (is (= (str "(ns " sa " (:require [" sb " :as b]))\n(defn run [] [\"é👩‍💻שלום\" (" sb "/value) '(facts.a/run facts.b/value)])")
         (get (:sources planned) sa)))
  (is (= (str "(ns " sb ") (defn value [] 1)") (get (:sources planned) sb)))
  (is (= (dissoc planned :input) (dissoc (g/plan (assoc opts :parsed-facts {:forged true})) :input)))
  (is (not= (:digest planned) (:digest (g/plan (assoc opts :application-id "facts-second")))))
  (is (not= (:digest planned) (:digest (g/plan (assoc opts :resources {:immutable 2})))))))

(deftest late-reference-facts-retain-data-and-expand-only-executable-roots
 (let [source "(ns facts.a (:require [reload.binding :as binding])) (defn run [] [(binding/call! \"facts.b/value\" []) '(binding/call! \"facts.quoted/value\" [])])"
       forms (reader/read-string source nil)
       planned (g/plan {:sources {"facts.a" source "facts.b" "(ns facts.b) (defn value [] 3)"}
                        :roots ["facts.a"] :stable-namespaces #{"reload.binding"}})]
  (is (= ["facts.b/value"] (binding/references-forms forms (graph/header*-nodes forms))))
  (is (contains? (:mapping planned) "facts.b"))
  (is (not (contains? (:mapping planned) "facts.quoted")))))

(deftest structural-facts-never-cache-native-env-ambiguity
 (let [scope (env/fork)
       opts {:sources {"facts.a" "(ns facts.a) (defn f [] (erlang/apply :factscollision :value (list)))"}
             :native-modules #{"factscollision"}}]
  (try
   (env/with-env scope
    (fn []
     (is (map? (g/plan opts)))
     (let [previous (env/capture)]
      (try (env/eval "(ns factscollision) (defn value [] :application)") (finally (env/bind previous))))
     (is (= :ambiguous-native-target (failure #(g/plan opts))))))
   (finally (env/destroy scope)))))

(deftest cached-header-and-binding-facts-preserve-specific-refusals
 (doseq [[kind opts]
         [[:require-cycle {:sources {"facts.a" "(ns facts.a (:require [facts.b])) (defn f [] :a)"
                                    "facts.b" "(ns facts.b (:require [facts.a])) (defn f [] :b)"}}]
          [:unsealed-late-binding {:sources {"facts.a" "(ns facts.a (:require [reload.binding :as b])) (defn f [] (b/call! \"missing.namespace/f\" []))"}
                                   :stable-namespaces #{"reload.binding"}}]
          [:invalid-late-binding {:sources {"facts.a" "(ns facts.a (:require [reload.binding :refer [call!]])) (defn f [] :a)"}
                                  :stable-namespaces #{"reload.binding"}}]]]
  (is (= kind (failure #(g/plan opts))))))

(deftest project-discovery-does-not-reuse-facts-across-file-edits
 (let [scope (env/fork)
       root (str (System/get_env "HOME") "/tmp/facts-project-" (erlang/unique_integer (list :positive)))
       opts {:entrypoint "factsprobe.entry/run"}]
  (File/mkdir_p! (str root "/factsprobe"))
  (File/write! (str root "/factsprobe/entry.bl")
               "(ns factsprobe.entry (:require [factsprobe.value :as v])) (defn run [] (v/value))")
  (File/write! (str root "/factsprobe/value.bl") "(ns factsprobe.value) (defn value [] 1)")
  (try
   (env/with-env scope
    (fn []
     (BeamLisp.Env/push_load_path root)
     (let [first (g/project-plan opts)]
      (is (= ["factsprobe.value" "factsprobe.entry"] (:order first)))
      (File/write! (str root "/factsprobe/value.bl") "(ns factsprobe.value) (defn value [] 2)")
      (let [second (g/project-plan opts)]
       (is (not= (:digest first) (:digest second)))
       (is (= "(ns factsprobe.value) (defn value [] 2)" (get-in second [:input :sources "factsprobe.value"])))))))
   (finally (env/destroy scope) (File/rm_rf! root)))))

(deftest source-budgets-refuse-before-invalid-source-is-parsed
 (let [oversized (binary/copy "[" 16777217)
       limit-sized (binary/copy "[" 1048576)
       aggregate (into {} (map (fn [index] [(str "budget.n" index) limit-sized]) (range 17)))
       too-many (into {} (map (fn [index] [(str "budget.n" index) "["]) (range 1025)))]
  (is (= :generation-source-budget (failure #(g/plan {:sources {"budget.single" oversized}}))))
  (is (= :generation-source-budget (failure #(g/plan {:sources aggregate}))))
  (is (= :invalid-generation (failure #(g/plan {:sources too-many}))))
  (is (= :invalid-source (failure #(g/plan {:sources {"budget.single" (binary/copy "[" 1048577)}}))))))
