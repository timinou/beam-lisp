; Actual managed Source and genuine SDK component controls. Native UNRUN.
(ns reload.prepared-callback-arguments-test
 (:require [reload.generation :as g] [reload.prepared-callback-fixture :as sdk]))
(defn- refusal [action]
 (try (action) nil
  (catch error
   (if (and (erlang/is_map error) (maps/is_key :original error))
    (maps/get :original error) (or (:kind (ex-data error)) error)))))
(defn- prepare-arm [f arity]
 (erlang/apply :Elixir.BeamLisp.Ns.Rt :"call-prepare-callback" (list f arity)))
(defn- fixture []
 (g/prepare!
  {:application-id (str "prepared-args-" (erlang/unique_integer (list :positive)))
   :sources {"prepared.arguments.app"
    "(ns prepared.arguments.app (:require [reload.prepared-callback-fixture :as sdk]))
     (defn late [kind module function]
       (if (= kind :remote) (tuple :$remote module function) (sdk/late-private-carrier)))
     (defn items [kind module function]
       (map (fn [_] (late kind module function)) [1 2]))
     (defn mapped [f kind module function]
       (into [] (map f (items kind module function))))
     (defn folded [f kind module function]
       (reduce f 0 (items kind module function)))
     (defn sorted [f kind module function]
       (sort f (items kind module function)))
     (defn through1 [prepared kind module function]
       (sdk/invoke-prepared1 prepared (fn [] (late kind module function))))
     (defn through2 [prepared kind module function]
       (sdk/invoke-prepared2 prepared (fn [] (late kind module function))))
     (defn harmless1 [prepared] (sdk/invoke-prepared1 prepared (fn [] 4)))
     (defn harmless2 [prepared] (sdk/invoke-prepared2 prepared (fn [] 4)))
     (defn own-arguments [module function]
       ((fn [value] :owned) (tuple :$remote module function)))
     (defn bench [prepared arity repeats] (sdk/benchmark-prepared prepared arity repeats))"}
   :stable-namespaces #{"reload.prepared-callback-fixture"}}))
(defn- private-target []
 (let [value (sdk/late-private-carrier)]
  [(elem (erlang/fun_info value :module) 1) (elem (erlang/fun_info value :name) 1)]))

(deftest late-computed-private-arguments-never-reach-map-reduce-or-sort-sdk-callbacks
 (let [graph (fixture) calls (atom 0) [module function] (private-target)
       callbacks [["mapped" (partial sdk/observe1 calls)]
                  ["folded" (partial sdk/observe2 calls)]
                  ["sorted" (partial sdk/compare-observed calls)]]]
  (try
   (doseq [kind [:remote :private-function] [operation callback] callbacks]
    (reset! calls 0)
    (is (= :source_native_target_refused
           (refusal #(g/invoke! graph (str "prepared.arguments.app/" operation)
                               [callback kind module function]))))
    (is (= 0 @calls))
    (is (= false (BeamLisp.Env/source_execution_active?))))
   (finally (g/retire! graph)))))

(deftest native-prepared-unary-and-binary-arms-are-checked-at-later-source-invocation
 (let [graph (fixture) calls (atom 0) [module function] (private-target)
       ;; Preparation runs OUTSIDE Source. No preparation-time mode is cached.
       one (prepare-arm (partial sdk/observe1 calls) 1)
       two (prepare-arm (partial sdk/observe2 calls) 2)]
  (try
   (doseq [[operation prepared] [["through1" one] ["through2" two]]
           kind [:remote :private-function]]
    (reset! calls 0)
    (is (= :source_native_target_refused
           (refusal #(g/invoke! graph (str "prepared.arguments.app/" operation)
                               [prepared kind module function]))))
    (is (= 0 @calls)))
   (is (= :observed (g/invoke! graph "prepared.arguments.app/harmless1" [one])))
   (is (= :observed (g/invoke! graph "prepared.arguments.app/harmless2" [two])))
   (is (= 2 @calls))
   (finally (g/retire! graph)))))

(deftest fixed-and-variadic-descriptors-check-original-arguments-before-rest-packing
 (let [graph (fixture) calls (atom 0) [module function] (private-target)
       unary (partial sdk/observe1 calls) binary (partial sdk/observe2 calls)
       ternary (partial sdk/observe3 calls)
       shapes [[1 (tuple :$blfn {1 unary} nil)]
               [2 (tuple :$blfn {2 binary} nil)]
               [1 (tuple :$blfn {} (tuple 0 unary))]
               [1 (tuple :$blfn {} (tuple 1 binary))]
               [2 (tuple :$blfn {} (tuple 0 unary))]
               [2 (tuple :$blfn {} (tuple 1 binary))]
               [2 (tuple :$blfn {} (tuple 2 ternary))]]]
  (try
   (doseq [[arity original] shapes kind [:remote :private-function]]
    (reset! calls 0)
    (let [prepared (prepare-arm original arity)]
     (is (= :source_native_target_refused
            (refusal #(g/invoke! graph (str "prepared.arguments.app/through" arity)
                                [prepared kind module function]))))
     (is (= 0 @calls))))
   (finally (g/retire! graph)))))

(deftest native-and-source-positive-callbacks-preserve-fixed-and-variadic-abi
 (let [graph (fixture)
       cases [[1 sdk/add-one 5]
              [2 sdk/add-two 4]
              [1 (tuple :$blfn {1 sdk/add-one} nil) 5]
              [2 (tuple :$blfn {2 sdk/add-two} nil) 4]
              [1 (tuple :$blfn {} (tuple 0 sdk/rest0)) 1]
              [2 (tuple :$blfn {} (tuple 0 sdk/rest0)) 2]
              [1 (tuple :$blfn {} (tuple 1 sdk/rest1)) [4 0]]
              [2 (tuple :$blfn {} (tuple 1 sdk/rest1)) [0 1]]
              [2 (tuple :$blfn {} (tuple 2 sdk/rest2)) [0 4 0]]]]
  (try
   (doseq [[arity original expected] cases]
    (let [prepared (prepare-arm original arity)]
     (is (= expected (if (= arity 1) (prepared 4) (prepared 0 4))))
     (is (= expected (g/invoke! graph (str "prepared.arguments.app/harmless" arity) [prepared])))))
   (is (= [2 3] (g/with! graph #(into [] (map sdk/add-one [1 2])))))
   (is (= 6 (g/with! graph #(reduce sdk/add-two 0 [1 2 3]))))
   (is (= [1 2 3] (g/with! graph #(sort < [3 1 2]))))
   ;; Ordinary Native callbacks keep accepting opaque values. The same actual
   ;; private carriers are restricted only when a later Source invocation runs.
   (let [calls (atom 0) hidden (sdk/late-private-carrier)
         [module function] (private-target)
         unary (prepare-arm (partial sdk/observe1 calls) 1)
         binary (prepare-arm (partial sdk/observe2 calls) 2)]
    (is (= :observed (unary hidden)))
    (is (= 1 @calls))
    (is (= :observed (binary 0 (tuple :$remote module function))))
    (is (= 2 @calls)))
   (finally (g/retire! graph)))))

(deftest source-owned-callee-keeps-existing-source-argument-policy
 (let [graph (fixture) [module function] (private-target)]
  (try
   ;; A Source-owned callee may receive its own computed value. The boundary
   ;; restricts the later SDK callback, not ordinary Source-to-Source arguments.
   (is (= :owned (g/invoke! graph "prepared.arguments.app/own-arguments" [module function])))
   (finally (g/retire! graph)))))

(deftest malformed-callables-still-fail-only-at-the-first-invocation
 (doseq [value [7 nil (tuple :$blfn {1 7} nil) (tuple :$blfn {} (tuple 1 7))]]
  (let [prepared (prepare-arm value 1)]
   (is (erlang/is_function prepared 1))
   (is (some? (refusal #(prepared 1))))))
 (is (= :untouched (BeamLisp.Ns.Rt/k-reduce nil :untouched [] :kernel :normalized))))
