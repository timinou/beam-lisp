; Independently authored public fixtures. All actual native/Source UNRUN.
(ns reload.source-http-integration-test
 (:require [reload.generation :as g] [reload.source-guard :as guard]
           [reload.source-producer :as producer] [reload.native-call :as native]
           [system.ir :as ir]))
(defn- kind [action] (try (action) nil (catch e (:kind (ex-data e)))))
(defn- target []
 (let [f (BeamLisp.AOT/sdk_named_constructor! "reload.source-guard" "http-request!" 1)]
  (BeamLisp.AOT/sdk_callable_evidence! f)
  {:module (elem (erlang/fun_info f :module) 1) :function (elem (erlang/fun_info f :name) 1)}))
(defn- specialize [source]
 (let [form (first (BeamLisp.Reader/read_string source))
       actual (BeamLisp.Compiler/compile form (BeamLisp.Compiler/new_env "http.guard-compiler-fixture"))
       expanded (native/specialize actual (fn [_] nil))
       sdk (target)]
  (producer/specialize (:expression expanded)
    {:native-modules #{"httpc"} :guard-module (:module sdk) :guard-function (:function sdk)})))
(deftest actual-compiler-calls-and-literal-apply-route-through-exact-native-sdk-body
 (let [direct (specialize "(fn [u] (httpc/request u))")
       apply (specialize "(fn [u] (erlang/apply :httpc :request (list u)))")
       quoted (specialize "'(httpc/request \"inert\")")]
  (is (= 1 (:changes direct)))
  (is (= 1 (:changes apply)))
  (is (= 0 (:changes quoted)))
  (is (= :lit (:op (:expression quoted))))))
(defn- graph [source native]
 (g/prepare! {:application-id (str "http-guard-" (erlang/unique_integer (list :positive)))
              :sources {"http.guard-fixture" source} :native-modules native}))
(defn- listener []
 (let [opened (gen_tcp/listen 0 (list :binary (tuple :active false)
                             (tuple :ip (tuple 127 0 0 1)) (tuple :reuseaddr true)))]
  (when-not (= :ok (elem opened 0)) (throw :fixture-listener-failed))
  (let [socket (elem opened 1)]
   {:socket socket :url (str "http://127.0.0.1:" (elem (inet/port socket) 1) "/fixture")})))
(deftest actual-fixed-data-http-succeeds-and-source-body-generator-refuses-before-network
 (Application/ensure_all_started :inets)
 (let [positive (listener) negative (listener) parent (erlang/self)
       worker (spawn (fn []
                 (let [accepted (gen_tcp/accept (:socket positive) 5000)]
                  (when (= :ok (elem accepted 0))
                   (let [socket (elem accepted 1)]
                    (try
                     (gen_tcp/recv socket 0 2000)
                     (gen_tcp/send socket "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
                     (erlang/send parent :http-fixture-accepted)
                     (finally (gen_tcp/close socket))))))))
       graph (graph (str "(ns http.guard-fixture) "
                 "(defn get [url] (httpc/request :get (tuple (String/to_charlist url) (list)) "
                 "(list (tuple :timeout 1000)) (list (tuple :body_format :binary)))) "
                 "(defn bad [url marker] (httpc/request :post "
                 "(tuple (String/to_charlist url) (list) \"text/plain\" "
                 "(tuple (fn [_] (File/write! marker \"must-not-run\")) nil)) "
                 "(list (tuple :timeout 1000)) (list)))") #{"httpc" "String" "File"})
       marker (str (System/get_env "HOME") "/tmp/http-guard-" (erlang/unique_integer (list :positive)))]
  (try
   (let [response (g/with! graph #(g/invoke! graph "http.guard-fixture/get" [(:url positive)]))]
    (is (= :ok (elem response 0)))
    (is (= 200 (elem (elem (elem response 1) 0) 1)))
    (is (= "ok" (elem (elem response 1) 2))))
   (is (= :accepted (receive :http-fixture-accepted :accepted (after 5000 :missing))))
   (is (= :unowned-managed-native-capability
          (kind (fn [] (g/with! graph (fn [] (g/invoke! graph "http.guard-fixture/bad" [(:url negative) marker])))))))
   (is (= (tuple :error :timeout) (gen_tcp/accept (:socket negative) 100)))
   (is (not (File/exists? marker)))
   (finally
    (gen_tcp/close (:socket positive)) (gen_tcp/close (:socket negative))
    (g/retire! graph)))))
(deftest importing-guard-cannot-manufacture-original-native-permission
 (let [graph (graph "(ns http.guard-fixture) (defn value [] :ready)" #{})]
  (try
   (let [result (kind (fn []
                       (g/with! graph
                         (fn [] (guard/http-request! (list "http://127.0.0.1:1/"))))))]
    (is (= :undeclared-native-target result)))
   (finally (g/retire! graph)))))
