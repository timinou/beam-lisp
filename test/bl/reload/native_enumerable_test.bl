(ns reload.native-enumerable-test (:require [reload.generation :as g]))

(deftest sdk-collection-construction-needs-no-native-enum-grant
 (let [graph (g/prepare! {:sources {"enumerable.sdk"
              "(ns enumerable.sdk) (defn run [] (set (concat [1 2] [2 3])))"}})]
  (try
   (is (= #{1 2 3} (g/invoke! graph "enumerable.sdk/run" [])))
   (finally (g/retire! graph)))))

(deftest native-enum-reducers-work-over-source-cursors-without-extra-grants
 (let [graph (g/prepare! {:native-modules #{"Enum"}
              :sources {"enumerable.application"
               "(ns enumerable.application) (defn run [] [(Enum/uniq (concat [1 2] [2 3])) (Enum/frequencies (concat [1 2] [2 3]))])"}})]
  (try
   (is (= ['(1 2 3) {1 1 2 2 3 1}] (g/invoke! graph "enumerable.application/run" [])))
   (finally (g/retire! graph)))))
