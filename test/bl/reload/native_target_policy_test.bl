; HOME review candidate; supported managed Source boundary, native UNRUN.
(ns reload.native-target-policy-test
 (:require [reload.generation :as g] [reload.native-target-fixture :as sdk]))
(defn- refusal [action]
 (try (action) nil
  (catch error
   (if (and (erlang/is_map error) (maps/is_key :original error))
    (maps/get :original error) (or (:kind (ex-data error)) error)))))
(defn- prepared []
 (g/prepare!
  {:sources {"native.target.app"
    "(ns native.target.app (:require [reload.native-target-fixture :as sdk]))
     (defn public [x] (sdk/public-step x))
     (defn local [x] ((sdk/local-callback) x))
     (defn named [x] ((sdk/named-callback) x))
     (defn internal [xs] (sdk/internal-private-map xs))
     (defn invoke [f args] (apply f args))
     (defn constructors [] [(sdk/->PublicRecord 4) (sdk/map->PublicRecord {:value 5}) (sdk/->PublicType 6)])
     (defn dependency [] [(String/upcase \"ok\") (Enum/sum (list 1 2 3)) (Jason/encode! {:ok true})])"}
   :stable-namespaces #{"reload.native-target-fixture"}
   :native-modules #{"String" "Enum" "Jason"}}))
(defn- private-external []
 (let [definitions (BeamLisp.Env/ns_defs "reload.native-target-fixture")
       arm (first (Map/fetch! definitions "private-step"))]
  (erlang/make_fun (elem arm 4) (elem arm 2) (erlang/length (:params (elem arm 3))))))

(deftest public-sdk-and-authenticated-factory-local-callbacks-remain-usable
 (let [generation (prepared)]
  (try
   (is (= 6 (g/invoke! generation "native.target.app/public" [4])))
   (is (= 6 (g/invoke! generation "native.target.app/local" [4])))
   (is (= 6 (g/invoke! generation "native.target.app/named" [4])))
   ;; A named private callback used wholly inside genuine compiled SDK code
   ;; uses the same local value bridge; Source ancestor does not mask it.
   (is (= [3 4] (g/invoke! generation "native.target.app/internal" [[1 2]])))
   (is (= ["OK" 6 "{\"ok\":true}"] (g/invoke! generation "native.target.app/dependency" [])))
   (let [values (g/invoke! generation "native.target.app/constructors" [])]
    (is (= 4 (:value (first values))))
    (is (= 5 (:value (second values))))
    (is (= :bl_deftype (elem (nth values 2) 0))))
   (finally (g/retire! generation)))))

(deftest private-unknown-and-critical-callable-carriers-refuse-before-callback
 (let [generation (prepared) hidden (private-external)
       factory (BeamLisp.Env/fetch_exact! "reload.native-target-fixture" "captured-callback")
       critical (factory (erlang/make_fun :Elixir.BeamLisp.Env :env_id 0))
       unknown (erlang/make_fun (elem (erlang/fun_info hidden :module) 1) :__bl_callable_values__ 0)]
  (try
   (doseq [value [hidden (tuple :$remote (elem (erlang/fun_info hidden :module) 1)
                                            (elem (erlang/fun_info hidden :name) 1))
                  (tuple :$blfn {1 hidden} nil) critical unknown]]
    (is (= :source_native_target_refused
      (refusal #(g/invoke! generation "native.target.app/invoke" [value [1]])))))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))

(deftest direct-private-and-reflective-source-cannot-prepare
 (doseq [body ["(sdk/private-step 1)"
              "(erlang/apply :Elixir.BeamLisp.Env :fetch_exact! (list \"reload.native-target-fixture\" \"private-step\"))"
              "(erlang/binary_to_term data)"
              "(erlang/fun_info callback)"
              "(BeamLisp/eval_string data)"
              "(BeamLisp.Ns.Body.Core/__bl_callable_values__)"]]
  (is (some? (refusal #(g/prepare!
    {:sources {"native.target.rejected"
      (str "(ns native.target.rejected (:require [reload.native-target-fixture :as sdk])) (defn run [data callback] " body ")")}
     :stable-namespaces #{"reload.native-target-fixture"}
     :native-modules #{"erlang" "BeamLisp.Env" "BeamLisp" "BeamLisp.Ns.Body.Core"}}))))))

(deftest inherited-all-does-not-authorize-an-unplanned-external-dependency
 (let [generation (g/prepare!
                   {:sources {"native.target.unplanned" "(ns native.target.unplanned) (defn run [f] (f \"x\"))"}})]
  (try
   (is (= :source_native_target_refused
    (refusal #(g/invoke! generation "native.target.unplanned/run"
              [(erlang/make_fun :Elixir.String :upcase 1)]))))
   (finally (g/retire! generation)))))

(deftest actual-private-generated-class-constructor-is-not-a-public-sdk-route
 (let [generation (prepared)
       private (BeamLisp.Env/fetch_exact! "reload.native-target-fixture" "->PrivateRecord")]
  (try
   (is (= :source_native_target_refused
    (refusal #(g/invoke! generation "native.target.app/invoke" [private [4]]))))
   (finally (g/retire! generation)))))
