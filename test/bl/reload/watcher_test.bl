; test/bl/reload/watcher_test.bl — the reload watcher's integration contract,
; ported from test/beam_lisp/reload_watcher_test.exs to a pure-bl suite.
;
; ── Why this lives here, not in ExUnit ──────────────────────────────────
;
; The ExUnit watcher test drives the REAL filesystem watcher (inotify): it
; writes a .bl file and waits for the OS event to ripple through stage+commit.
; That test fails in the FULL `mix test` run — not on its own merit, but because
; a sibling ExUnit suite stops the `:beam_lisp` application mid-run, killing the
; Refs Agent behind reload's state atom (the cross-suite "application shutdown"
; contamination). It passes in isolation; the failure is environmental.
;
; The cure is structural: run the watcher's RELOAD CONTRACT where that
; contamination cannot reach it — a `mix beam_lisp.test` suite, which has no
; cross-suite app shutdown. To make it deterministic we drive the watcher's own
; seam, `ReloadWatcher/apply_change` (the exact stage→commit a file save runs),
; WITHOUT inotify's timing. The one thing this does not cover — that an inotify
; event actually reaches apply_change — stays as a single ExUnit integration
; test, where ExUnit's process setup makes the filesystem backend reliable.
;
; So: the reload semantics the watcher guarantees are proven here, deterministic
; and contamination-proof; only the OS-plumbing remains an integration test.

(ns reload.watcher-test
  (:require [reload]))

(defn- change
  "Drive one source change through the watcher's reload seam and return the
   commit status keyword (:applied | :held | …). auto-commit is on."
  [src]
  (:status (BeamLisp.ReloadWatcher/apply_change src "test" true)))

(defn- call
  "Eval a qualified reference in the live image — a fresh compile so a
   just-reloaded namespace resolves as a bl var, not stale interop."
  [expr]
  (BeamLisp/eval expr))

; ── contract 1: a change updates the running image (no restart) ─────────
;
; ExUnit "a saved .bl file updates the running image", minus the filesystem.

(deftest change-updates-the-image
  (reload/abort)
  (is (= :applied (change "(ns wt.one)\n(defn v [] :first)\n")))
  (is (= :first (call "(wt.one/v)")))
  ; a second change swaps the running fn in place
  (is (= :applied (change "(ns wt.one)\n(defn v [] :second)\n")))
  (is (= :second (call "(wt.one/v)"))))

; ── contract 2: an incoherent change is HELD; old code serves ───────────
;
; ExUnit "an incoherent save is held; the old code keeps serving".

(deftest incoherent-change-is-held
  (reload/abort)
  (is (= :applied (change "(ns wt.two)\n(defn f [] :ok)\n")))
  (is (= :ok (call "(wt.two/f)")))
  ; a dangling edit: the commit HOLDS, the image is untouched
  (is (= :held (change "(ns wt.two)\n(defn f [] (nope-not-defined))\n")))
  (is (= :ok (call "(wt.two/f)"))))       ; old code still serves through the hold

; ── contract 3: successive changes each land deterministically ──────────
;
; ExUnit "sync is deterministic": each edit is reflected before the next, no
; sleep-and-hope. Here it is deterministic by construction — apply_change is
; synchronous, so the image reflects each change on return.

(deftest successive-changes-land-in-order
  (reload/abort)
  (doseq [i (range 1 4)]
    (is (= :applied (change (str "(ns wt.three)\n(defn n [] " i ")\n"))))
    (is (= i (call "(wt.three/n)")))))

; ── contract 4: staging without commit holds the bundle open ────────────
;
; The watcher's :auto_commit false mode stages but does not commit — a caller
; drives reload/commit. apply_change with commit? false must leave the bundle
; STAGED, the image untouched, until an explicit commit applies it.

(deftest staging-without-commit-defers
  (reload/abort)
  (is (= :applied (change "(ns wt.four)\n(defn g [] :v1)\n")))
  (is (= :v1 (call "(wt.four/g)")))
  ; stage a new version WITHOUT committing
  (BeamLisp.ReloadWatcher/apply_change "(ns wt.four)\n(defn g [] :v2)\n" "test" false)
  (is (= :staged (:status (reload/status))))
  (is (= :v1 (call "(wt.four/g)")))       ; not yet live
  ; the explicit commit applies it
  (is (= :applied (:status (reload/commit))))
  (is (= :v2 (call "(wt.four/g)"))))
