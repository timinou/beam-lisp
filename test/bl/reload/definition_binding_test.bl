(ns reload.definition-binding-test (:require [reload.generation :as g] [env]))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))

(deftest forward-declarations-are-not-duplicate-definitions
 (let [graph (g/prepare! {:sources {"binding.forward"
        "(ns binding.forward) (declare odd-value even-value) (defn odd-value [n] (if (zero? n) false (even-value (dec n)))) (defn even-value [n] (if (zero? n) true (odd-value (dec n)))) (defn run [n] (odd-value n))"}})]
  (try
   (is (= true (g/invoke! graph "binding.forward/run" [7])))
   (is (= false (g/invoke! graph "binding.forward/run" [8])))
   (finally (g/retire! graph)))))

(deftest domain-resolve-and-forward-shadowing-do-not-invoke-core-reflection
 (let [graph (g/prepare! {:sources {"binding.domain"
        "(ns binding.domain) (defn run [x] (resolve x)) (defn resolve [x] [:domain x])"}})]
  (try (is (= [:domain :value] (g/invoke! graph "binding.domain/run" [:value])))
   (finally (g/retire! graph)))))

(deftest incomplete-declarations-and-real-duplicates-still-refuse
 (is (= :unresolved-declaration
      (kind #(g/prepare! {:sources {"binding.missing" "(ns binding.missing) (declare absent) (defn run [] :ready)"}}))))
 (is (= :duplicate-definition
      (kind #(g/prepare! {:sources {"binding.duplicate" "(ns binding.duplicate) (defn run [] 1) (defn run [] 2)"}})))))

(deftest trusted-macros-cannot-hide-a-reflective-compiler-binding
 (let [context (env/capture)]
  (try
   (env/eval "(ns binding.macros) (defmacro hidden [name] (list 'defn name ['x] (list 'core/resolve 'x)))")
   (env/bind context)
   (is (= :dynamic-code-dependency
        (kind #(g/prepare! {:stable-namespaces #{"binding.macros"}
                           :sources {"binding.hidden" "(ns binding.hidden (:require [binding.macros :as macros])) (macros/hidden run)"}}))))
   (finally (env/bind context)))))
