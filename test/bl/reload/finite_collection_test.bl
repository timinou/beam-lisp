(ns reload.finite-collection-test
 (:require [reload.generation :as generation] [reload.collection-constructor :as constructor]))
(defn- refused [source]
 (try (let [graph (generation/prepare! {:application-id "finite-constructor-reject"
                                      :native-modules #{"System"} :sources {"finite.collection" source}})]
        (generation/retire! graph) :unexpected-success)
  (catch error (:kind (ex-data error)))))

(deftest actual-source-constants-use-bounded-factories-and-closed-callbacks
 (let [graph (generation/prepare!
              {:application-id "finite-constructor-values"
               :sources {"finite.collection"
                "(ns finite.collection)
                 (def SCRIPTS {:arabic [\"ara\"] :latin [\"eng\"]})
                 (def HINTS (into [] (keys SCRIPTS)))
                 (def LEGACY [\"v1\" \"v2\"])
                 (def VERSIONS (into [\"modern\"] LEGACY))
                 (def ALLOWED (into #{} LEGACY))
                 (def ROWS [[:wf/matter :db.type/string] [:wf/number :db.type/long]])
                 (def SCHEMA (mapv (fn [[id type]] {:db/ident id :db/valueType type}) ROWS))
                 (def TOOLS [[\"one\" \"first\" {:type :object}] [\"two\" \"second\" {:type :object}]])
                 (defn tools [] (to-list (map (fn [row] {:name (first row) :schema (nth row 2)}) TOOLS)))
                 (def TOOL-NAMES (mapv :name (tools)))
                 (def CAPTURED (let [label :prefix] (mapv (fn [x] {:label label :item x}) LEGACY)))
                 (defn values [] {:hints HINTS :versions VERSIONS :allowed ALLOWED :schema SCHEMA
                                  :names TOOL-NAMES :captured CAPTURED})"}})]
  (try
   (let [values (generation/invoke! graph "finite.collection/values" [])]
    (is (= #{:arabic :latin} (set (:hints values))))
    (is (= ["modern" "v1" "v2"] (:versions values)))
    (is (= #{"v1" "v2"} (:allowed values)))
    (is (= [{:db/ident :wf/matter :db/valueType :db.type/string}
            {:db/ident :wf/number :db/valueType :db.type/long}] (:schema values)))
    (is (= ["one" "two"] (:names values)))
    (is (= [{:label :prefix :item "v1"} {:label :prefix :item "v2"}] (:captured values))))
   (finally (generation/retire! graph)))))

(deftest wrong-and-opaque-callbacks-refuse-before-initializer-effects
 (let [marker "BL_FINITE_COLLECTION_MUST_NOT_RUN" before (System/get_env marker)]
  (doseq [tail
          ["(def BAD (mapv (fn [x] (System/put_env \"BL_FINITE_COLLECTION_MUST_NOT_RUN\" \"bad\") x) INPUT))"
           "(def BAD (mapv (fn [x y] (System/put_env \"BL_FINITE_COLLECTION_MUST_NOT_RUN\" \"bad\") x) INPUT))"
           "(defn recur-value [x] (recur-value x)) (def BAD (recur-value INPUT))"
           "(def BAD (mapv :name (lazy-seq (System/put_env \"BL_FINITE_COLLECTION_MUST_NOT_RUN\" \"bad\") nil)))"
           "(def BAD (if true (keys {:a 1}) nil))"
           "(def BAD (mapv (fn [x] (if x (fn [] x) {:value x})) INPUT))"
           "(def BAD (into [] {:__struct__ :Elixir.UntrustedEnumerable :producer (fn [] (System/put_env \"BL_FINITE_COLLECTION_MUST_NOT_RUN\" \"bad\"))}))"
           "(def BAD (into [] {:__struct__ :Elixir.BeamLisp.Vector :meta nil :items (fn [] (System/put_env \"BL_FINITE_COLLECTION_MUST_NOT_RUN\" \"bad\"))}))"
           "(defn mapv [f xs] (System/put_env \"BL_FINITE_COLLECTION_MUST_NOT_RUN\" \"bad\") xs) (def BAD (mapv :name INPUT))"]]
   (is (= :effectful-generation
          (refused (str "(ns finite.collection) (def INPUT [{:name :one} {:name :two}]) " tail)))))
  (is (= before (System/get_env marker)))))

(deftest finite-shape-output-and-literal-budgets-refuse-without-materializing-results
 (let [sdk (constructor/sdk-targets)
       target (first (keep (fn [[route operation]] (when (= :mapv operation) route)) sdk))
       callback {:op :fn :clauses [{:pats [{:pop :pvar :name "item"}] :guard nil
                                   :body {:op :lit :val (String/duplicate "x" 4096)}}]}
       expression {:op :remote :mod (first target) :fun (second target)
                   :args [callback {:op :lit :val (vec (range 4000))}]}
       context {:sdk sdk :allowed-globals #{} :factories {} :factory-globals {}}]
  (is (some? target))
  (is (= false (constructor/proved? expression context)))
  (is (= false (constructor/proved? {:op :lit :val (String/duplicate "x" 1048577)} context)))
  (is (= false (constructor/proved? {:op :global :ns "core" :name "opaque"} context)))
  (is (= false (constructor/proved? {:op :map :pairs [[{:op :lit :val :__struct__}
                                                       {:op :lit :val :Elixir.UntrustedEnumerable}]]} context)))))
