(ns reload.inert-reduced-test
 (:require [reload.generation :as g] [reload.inert-reduced-fixture :as sdk]
           [reload.prepared-callback-fixture :as carrier]))
(defn- refusal [action]
 (try (action) nil
  (catch error
   (if (and (erlang/is_map error) (maps/is_key :original error))
    (maps/get :original error) (or (:kind (ex-data error)) error)))))
(defn- fixture []
 (g/prepare!
  {:application-id (str "inert-reduced-" (erlang/unique_integer (list :positive)))
   :sources {"inert.reduced.app"
    "(ns inert.reduced.app (:require [reload.inert-reduced-fixture :as sdk]
                                      [reload.prepared-callback-fixture :as carrier]))
     (defn reducer [] (fn [acc item] [acc item]))
     (defn grow [n] (sdk/growing (fn [acc item] [acc item]) n))
     (defn late [kind module function]
       (sdk/one-step (fn [acc item]
         (if (= kind :remote) (tuple :$remote module function) (carrier/late-private-carrier)))))
     (defn benchmark [n] (sdk/benchmark-growing (fn [acc item] [acc item]) n))"}
   :stable-namespaces #{"reload.inert-reduced-fixture" "reload.prepared-callback-fixture"}}))
(defn- with-predicate [graph predicate action]
 ;; Native fixture fault control: change only this test G's live core binding.
 ;; Every branch restores it; no SDK inventory, private policy or grant edited.
 (g/with! graph
  (fn []
   (let [original (BeamLisp.Env/fetch! "core" "reduced?")]
    (try
     (BeamLisp.Env/intern "core" "reduced?" predicate)
     (action)
     (finally (BeamLisp.Env/intern "core" "reduced?" original)))))))

(deftest source-owned-growing-fold-uses-the-authenticated-inert-predicate
 (let [graph (fixture)]
  (try
   (doseq [n [4096 32768]]
    (let [summary (sdk/summarize (g/invoke! graph "inert.reduced.app/grow" [n]))]
     (is (= n (:depth summary)))
     (is (= (quot (* n (dec n)) 2) (:sum summary)))
     (is (= true (:empty-leaf summary)))
     (is (= false (BeamLisp.Env/source_execution_active?)))))
   (finally (g/retire! graph)))))

(deftest live-rebound-unknown-predicate-keeps-ordinary-observation-and-restoration
 (let [graph (fixture) calls (atom 0)
       original (g/with! graph #(BeamLisp.Env/fetch! "core" "reduced?"))]
  (try
   (with-predicate graph (partial sdk/observe-predicate calls)
    (fn []
     (let [summary (sdk/summarize (g/invoke! graph "inert.reduced.app/grow" [8]))]
      (is (= 8 (:depth summary)))
      (is (= 28 (:sum summary)))
      (is (= 9 @calls))
      (is (= false (BeamLisp.Env/source_execution_active?))))))
   (is (= original (g/with! graph #(BeamLisp.Env/fetch! "core" "reduced?"))))
   (finally (g/retire! graph)))))

(deftest unknown-rebound-predicate-cannot-observe-late-private-carriers
 (let [graph (fixture) calls (atom 0) hidden (carrier/late-private-carrier)
       module (elem (erlang/fun_info hidden :module) 1)
       function (elem (erlang/fun_info hidden :name) 1)
       original (g/with! graph #(BeamLisp.Env/fetch! "core" "reduced?"))]
  (try
   (doseq [kind [:remote :private-function]]
    (reset! calls 0)
    (with-predicate graph (partial sdk/observe-predicate calls)
     (fn []
      (is (= :source_native_target_refused
             (refusal #(g/invoke! graph "inert.reduced.app/late" [kind module function]))))
      (is (= 0 @calls))
      (is (= false (BeamLisp.Env/source_execution_active?))))))
   (is (= original (g/with! graph #(BeamLisp.Env/fetch! "core" "reduced?"))))
   (finally (g/retire! graph)))))

(deftest genuinely-native-unknown-predicate-retains-opaque-value-compatibility
 (let [graph (fixture) calls (atom 0) hidden (carrier/late-private-carrier)
       original (g/with! graph #(BeamLisp.Env/fetch! "core" "reduced?"))]
  (try
   (with-predicate graph (partial sdk/observe-predicate calls)
    (fn []
     (is (= hidden (sdk/one-step (fn [acc item] hidden))))
     (is (= 2 @calls))))
   (is (= original (g/with! graph #(BeamLisp.Env/fetch! "core" "reduced?"))))
   (finally (g/retire! graph)))))
