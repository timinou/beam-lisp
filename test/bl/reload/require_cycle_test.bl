; test/bl/reload/require_cycle_test.bl — the commit gate's fifth predicate.
;
; A require cycle admitted by reload is BUG-064's cross-process loader deadlock
; shipped into the next cold drop. These scenarios pin that the gate HOLDS such
; a bundle — with the cycle named and the by-name idiom as the fix text — while
; an acyclic bundle over the same image applies. Detection is sg/cycles over
; the merged graph (staged sources over the image's remembered + source-derived
; edges): the one owner, the same answer the build fails on.
(ns reload.require-cycle-test
  (:require [reload] [env]))

(defn- call [expr] (env/eval expr))

; ── a cycle inside the bundle HOLDS, named ──────────────────────────────

(deftest bundle-internal-cycle-holds
  (reload/abort)
  (reload/stage "(ns cyc.a (:require [cyc.b]))\n(defn a [] :a)\n")
  (reload/stage "(ns cyc.b (:require [cyc.a]))\n(defn b [] :b)\n")
  (let [r (reload/commit)]
    (is (= :held (:status r)))
    (let [errs (filter (fn [e] (= :require-cycle (:kind e))) (:errors r))]
      (is (= 1 (count errs)))
      (is (includes? (:msg (first errs)) "require cycle: cyc.a -> cyc.b -> cyc.a"))
      (is (includes? (:msg (first errs)) "Loader/ensure_loaded")
          "the error names the sanctioned escape hatch")))
  ; nothing was applied: neither namespace exists in the image
  (is (thrown? (call "(cyc.a/a)"))))

; ── a self-require is a cycle of one ────────────────────────────────────

(deftest self-require-holds
  (reload/abort)
  (reload/stage "(ns cyc.self (:require [cyc.self]))\n(defn s [] 1)\n")
  (let [r (reload/commit)]
    (is (= :held (:status r)))
    (is (= :require-cycle (:kind (first (:errors r)))))))

; ── a cycle closing through a PREVIOUSLY COMMITTED namespace HOLDS ──────
;
; cyc.y is live and file-less (reload-created): the image's only graph for it
; is what apply-bundle! remembered. Re-staging cyc.x to require it closes
; cyc.x -> cyc.y -> cyc.x — held only because the image REMEMBERS the edges it
; applied, not because any file says so.

(deftest cycle-through-the-live-image-holds
  (reload/abort)
  (reload/stage "(ns cyc.x)\n(defn x [] :x)\n")
  (reload/stage "(ns cyc.y (:require [cyc.x]))\n(defn y [] :y)\n")
  (is (= :applied (:status (reload/commit))))
  (reload/stage "(ns cyc.x (:require [cyc.y]))\n(defn x [] :x2)\n")
  (let [r (reload/commit)]
    (is (= :held (:status r)))
    (is (= :require-cycle (:kind (first (:errors r)))))
    (is (includes? (:msg (first (:errors r))) "cyc.x -> cyc.y -> cyc.x")))
  ; old code still serves
  (is (= :x (call "(cyc.x/x)"))))

; ── the escape hatch: a by-name edge is not a static edge ───────────────

(deftest by-name-resolution-is-not-a-cycle
  (reload/abort)
  ; the dynamic half first, alone: a defn that resolves cyc.m BY NAME at the
  ; point of use — the BUG-064 fix idiom. Never called here; what matters is
  ; that the idiom leaves no STATIC edge for the graph to close.
  (reload/stage "(ns cyc.n)\n(defn n [] (let [_ (BeamLisp.Loader/ensure_loaded \"cyc.m\") h (BeamLisp.Env/fetch! \"cyc.m\" \"m\")] (h)))\n")
  (is (= :applied (:status (reload/commit))))
  ; the static half: cyc.m -> cyc.n is an edge, cyc.n -> cyc.m is not — the
  ; same require SHAPE as the held cases, minus the static back-edge.
  (reload/stage "(ns cyc.m (:require [cyc.n]))\n(defn m [] :m)\n")
  (let [r (reload/commit)]
    (is (= :applied (:status r))
        (str "unexpected hold: " (:errors r)))))

; ── an acyclic bundle over the parsed image applies ─────────────────────
;
; image-requires really does parse the loaded image's sources (env is a live
; namespace with a real file): a bundle reaching into it must not be held.

(deftest acyclic-over-the-image-applies
  (reload/abort)
  (reload/stage "(ns cyc.ok (:require [env]))\n(defn v [] :fine)\n")
  (let [r (reload/commit)]
    (is (= :applied (:status r))
        (str "unexpected hold: " (:errors r))))
  (is (= :fine (call "(cyc.ok/v)"))))
