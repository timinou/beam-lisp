(ns reload.relation-declaration-test
 (:require [reload.generation :as g] [datom.query.relation :as rel]
           [datom :as d] [env]))
(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))
(defn- options [version]
 {:application-id "relation-declaration" :stable-namespaces #{"datom.query.relation" "datom"}
  :sources {"declared.relations"
   (str "(ns declared.relations (:require [datom.query.relation :as rel] [datom :as d])) "
        "(defn version [] " (pr-str version) ") "
        "(rel/defrelation :~release/value {:arity 2 :reads #{:release/value} :provider (fn [db mode bounds args] [[1 (version)]])}) "
        "(defn read [] (rel/eval-relation nil :~release/value [] {})) "
        "(defn provider [] (:provider (rel/relation :~release/value))) "
        "(defn query [db] (d/q '[:find ?e ?v :where [?e :~release/value ?v]] db)) "
        "(defn legacy [] (rel/relation :~release/legacy)) "
        "(defn stamp [attrs] (rel/stored-attributes-stamp attrs)) "
        "(defn builtin [db] (rel/eval-relation db 'components [:edge] {})) "
        "(defn mutate [] (rel/register-relation! :~release/value {:arity 2 :provider (fn [db mode bounds args] [[1 :mutated]])}))")}})

(deftest standard-declarations-are-automatic-and-old-graphs-retain-their-providers
 (let [old (g/prepare! (options :old)) next (g/prepare! (options :new))
       callback (g/invoke! old "declared.relations/provider" [])
       hold (g/with! old #(g/capture!)) db (d/db (d/connect))]
  (try
   (is (= [[1 :old]] (g/invoke! old "declared.relations/read" [])))
   (is (= [[1 :new]] (g/invoke! next "declared.relations/read" [])))
   (is (= [[1 :old]] (g/invoke! old "declared.relations/read" [])))
   (is (= [[1 :old]] (callback nil :bf {} [])))
   (is (= #{[1 :old]} (set (g/invoke! old "declared.relations/query" [db]))))
   (is (= #{[1 :new]} (set (g/invoke! next "declared.relations/query" [db]))))
   (is (g/runtime-value? (:declarations old)))
   (is (= :immutable-declaration-required (kind #(g/invoke! next "declared.relations/mutate" []))))
   (is (= [[1 :old]] (g/invoke! old "declared.relations/read" [])))
   (is (= :waiting (:status (g/retire! old))))
   (g/release! hold)
   (is (= :retired (:status (g/retire! old))))
   (is (= :retired-generation (kind #(callback nil :bf {} []))))
   (is (= [[1 :new]] (g/invoke! next "declared.relations/read" [])))
   (finally (g/release! hold) (g/retire! old) (g/retire! next)))))

(deftest mutable-development-registrations-never-become-managed-declarations
 (rel/register-relation! :~release/legacy {:arity 2 :provider (fn [_ _ _ _] [[1 :legacy]])})
 (let [a (g/prepare! (options :isolated-a))
       b (g/prepare! (assoc (options :isolated-b) :application-id "other-relations"))]
  (try
   (is (nil? (g/invoke! a "declared.relations/legacy" [])))
   (is (nil? (g/invoke! b "declared.relations/legacy" [])))
   (is (= [[1 :isolated-a]] (g/invoke! a "declared.relations/read" [])))
   (is (= [[1 :isolated-b]] (g/invoke! b "declared.relations/read" [])))
   (let [stamp (g/invoke! a "declared.relations/stamp" [[:stored/value]])]
    (is (some? stamp))
    (is (= stamp (g/invoke! a "declared.relations/stamp" [[:stored/value]])))
    (is (not= stamp (g/invoke! b "declared.relations/stamp" [[:stored/value]])))
    (is (nil? (g/invoke! a "declared.relations/stamp" [[:~release/value]]))))
   (finally (g/retire! a) (g/retire! b)))))

(deftest cold-fixed-sdk-builtins-do-not-borrow-a-development-provider
 (let [old-spec (rel/relation 'components)
       conn (d/connect [{:db/ident :edge :db/valueType :db.type/ref}])
       _ (d/transact! conn [{:db/id 1 :edge 2} {:db/id 2 :edge 3}])
       graph (g/prepare! (options :builtins))]
  (try
   (rel/register-relation! 'components {:arity 2 :provider (fn [_ _ _ _] [[9 :wrong]])})
   (is (= #{[1 1] [2 1] [3 1]}
          (set (g/invoke! graph "declared.relations/builtin" [(d/db conn)]))))
   (finally
    (g/retire! graph)
    (when old-spec (rel/register-relation! 'components old-spec))))))

(deftest invalid-or-duplicate-declarations-refuse-before-publication
 (doseq [spec ["{:arity 0 :provider (fn [_ _ _ _] [])}"
               "{:arity 2 :provider 9}"
               "{:arity 2 :provider (fn [_ _ _ _] []) :reads []}"
               "{:arity 2 :provider (fn [_ _ _ _] []) :modes []}"]]
  (is (= :invalid-executable-declaration
       (kind (fn [] (g/prepare!
         {:stable-namespaces #{"datom.query.relation"}
          :sources {"declared.invalid" (str "(ns declared.invalid (:require [datom.query.relation :as rel])) (rel/defrelation :~invalid " spec ")")}}))))))
 (let [source (fn [ns] (str "(ns " ns " (:require [datom.query.relation :as rel])) (rel/defrelation :~duplicate {:arity 2 :provider (fn [_ _ _ _] [])})"))]
  (is (= :duplicate-executable-declaration
       (kind #(g/prepare! {:stable-namespaces #{"datom.query.relation"}
                           :sources {"declared.first" (source "declared.first")
                                     "declared.second" (source "declared.second")}})))))
 (let [key "BL_DECLARATION_EFFECT_PROBE" before (System/get_env key)]
  (try
   (System/delete_env key)
   (is (= :effectful-generation
        (kind #(g/prepare! {:native-modules #{"System"} :stable-namespaces #{"datom.query.relation"}
                            :sources {"declared.effect" "(ns declared.effect (:require [datom.query.relation :as rel])) (defn factory [] (System/put_env \"BL_DECLARATION_EFFECT_PROBE\" \"unsafe\") {:arity 2 :provider (fn [_ _ _ _] [])}) (rel/defrelation :~effect (factory))"}}))))
   (is (nil? (System/get_env key)))
   (finally (if before (System/put_env key before) (System/delete_env key)))))
 ;; A failed compile must not leave preparation capture installed in the caller.
 (is (= :~after-failure
        (env/eval "(ns declared.after-failure (:require [datom.query.relation :as rel])) (rel/defrelation :~after-failure {:arity 2 :provider (fn [_ _ _ _] [])})"))))
