(ns reload.static-call-test (:require [reload.static-call :as static] [reader]))

(defn- source [body] (str "(ns static.fixture) " body))
(defn- specialize [body] (static/specialize (source body)))
(defn- same-program [expected actual]
 (= (reader/read-all (source expected)) (reader/read-all (:compile-source actual))))
(defn- unchanged [body]
 (let [original (source body) result (static/specialize original)]
  (is (= original (:source result)))
  (is (= original (:compile-source result)))
  (is (= [] (:targets result)))
  (is (zero? (:rewrites result)))))

(deftest literal-native-application-keeps-original-and-exact-inventory
 (let [original (source "(defn run [x] (erlang/apply :lists :reverse (list x)))")
       result (static/specialize original)]
  (is (= original (:source result)))
  (is (same-program "(defn run [x] (lists/reverse x))" result))
  (is (= [{:module "lists" :function "reverse" :arity 1}] (:targets result)))
  (is (= 1 (:rewrites result))))
 (let [result (specialize "(defn run [] (erlang/apply :Elixir.String :upcase (list \"value\")))")]
  (is (same-program "(defn run [] (String/upcase \"value\"))" result))
  (is (= [{:module "String" :function "upcase" :arity 1}] (:targets result))))
 (let [result (specialize "(defn run [] (erlang/apply :erlang :node (list)))")]
  (is (same-program "(defn run [] (erlang/node))" result))
  (is (= 0 (:arity (first (:targets result)))))))

(deftest bindings-and-arguments-retain-their-evaluation-order
 (let [result (specialize
               "(defn run [x y] (let [a (erlang/apply :erlang :abs (list x)) b y] (erlang/apply :maps :put (list a b (erlang/apply :maps :new (list))))))")]
  (is (same-program "(defn run [x y] (let [a (erlang/abs x) b y] (maps/put a b (maps/new))))" result))
  (is (= [{:module "erlang" :function "abs" :arity 1}
          {:module "maps" :function "put" :arity 3}
          {:module "maps" :function "new" :arity 0}] (:targets result)))
  (is (= 3 (:rewrites result))))
 (let [result (specialize "(def callback (fn [x] (do (erlang/apply :erlang :abs (list x)) x)))")]
  (is (same-program "(def callback (fn [x] (do (erlang/abs x) x)))" result))))

(deftest comments-quoted-data-and-unicode-are-never-reconstructed
 (let [original (str "; 😀 é — untouched\n(ns static.fixture)\n"
                     "(defn run [x] ['(erlang/apply :lists :reverse (list x)) "
                     "(erlang/apply ; head😀\n :lists ; module é\n :reverse ; target\n (list ; args\n x))]) ; end\n")
       result (static/specialize original) output (:compile-source result)]
  (is (= original (:source result)))
  (is (String/starts_with? output "; 😀 é — untouched\n(ns static.fixture)\n"))
  (is (String/contains? output "'(erlang/apply :lists :reverse (list x))"))
  (doseq [comment ["; head😀\n" "; module é\n" "; target\n" "; args\n" "; end\n"]]
   (is (String/contains? output comment)))
  (is (= 1 (:rewrites result)))
  (is (= 1 (count (:targets result))))))

(deftest dynamic-or-ambiguous-dispatch-is-never-specialized
 (doseq [body ["(defn run [m] (erlang/apply m :reverse (list 1)))"
              "(defn run [f] (erlang/apply :lists f (list 1)))"
              "(defn run [args] (erlang/apply :lists :reverse args))"
              "(defn run [] (erlang/apply :lists :reverse [1 2]))"
              "(defn run [] (erlang/apply :Lists :reverse (list 1)))"
              "(defn run [] (erlang/apply :knowledger.live :serve (list)))"]]
  (unchanged body))
 (let [original (source "(defn run [x] (erlang/apply :lists :reverse (list x)))")]
  (is (= original (:compile-source (static/specialize original {:namespace-prefixes #{"lists"}}))))))

(deftest local-global-and-header-list-shadows-disable-rewriting
 (doseq [body ["(defn run [list] (erlang/apply :lists :reverse (list 1)))"
              "(defn run [{:keys [list]}] (erlang/apply :lists :reverse (list 1)))"
              "(defn run [] (let [list identity] (erlang/apply :lists :reverse (list 1))))"
              "(defn run [] ((fn list [x] (erlang/apply :lists :reverse (list x))) 1))"
              "(def list identity) (defn run [x] (erlang/apply :lists :reverse (list x)))"
              "(defn list [x] x) (defn run [x] (erlang/apply :lists :reverse (list x)))"]]
  (unchanged body))
 (doseq [header ["(ns static.fixture (:require [other :refer [list]]))"
                "(ns static.fixture (:require [other :refer :all]))"
                "(ns static.fixture (:require [other :rename {thing list}]))"
                "(ns static.fixture (:require [other :as list]))"
                "(ns static.fixture (:require [other :as erlang]))"
                "(ns static.fixture (:require [other :as lists]))"
                "(ns static.fixture (:import [java.lang.String]))"]]
  (let [original (str header " (defn run [x] (erlang/apply :lists :reverse (list x)))")]
   (is (= original (:compile-source (static/specialize original)))))))

(deftest unknown-macros-and-reader-expansions-never-see-changed-input
 (doseq [body ["(defn run [] (unknown (erlang/apply :lists :reverse (list 1))))"
              "(unknown (defn run [] (erlang/apply :lists :reverse (list 1))))"
              "(defserver run (init [_] (ok (erlang/apply :lists :reverse (list 1)))))"
              "(def value (unknown)) (defn run [] (erlang/apply :lists :reverse (list 1)))"
              "(defn run [] @(erlang/apply :lists :reverse (list 1)))"
              "(defn run [] #(erlang/apply :lists :reverse (list %)))"
              "(defn run [] `(erlang/apply :lists :reverse (list 1)))"
              "(defn run ([x] (erlang/apply :lists :reverse (list x))) ([x y] y))"]]
  (unchanged body)))

(deftest specialization-does-not-authorize-forbidden-native-effects
 (let [result (specialize "(defn run [x] (erlang/apply :erlang :spawn (list x)))")]
  (is (= [{:module "erlang" :function "spawn" :arity 1}] (:targets result)))
  (is (same-program "(defn run [x] (erlang/spawn x))" result)))
 (let [result (specialize "(defn run [x] (erlang/apply :Elixir.BeamLisp.Env :intern (list x)))")]
  (is (= [{:module "BeamLisp.Env" :function "intern" :arity 1}] (:targets result))))
 ;; Even an effectful unknown eager initializer is only read, never invoked.
 (let [original (source "(def value (throw (ex-info \"MUST NOT EXECUTE\" {})))")]
  (is (= original (:source (static/specialize original))))))

(deftest unsupported-source-context-is-an-explicit-refusal
 ;; Valid in its enclosing list, unsupported by isolated fragment streaming.
 ;; A failure cannot masquerade as a successful zero-rewrite proof.
 (is (= :static-call-rewrite-refused
      (try (specialize "(defn run [] (erlang/apply :lists :reverse (list #?@(:clj [1 2]))))") nil
       (catch error (:kind (ex-data error)))))))

(deftest analysis-is-source-size-depth-and-node-bounded
 (is (= :invalid-source
      (try (static/specialize (binary/copy "x" 1048577)) nil
       (catch error (:kind (ex-data error))))))
 (is (= :static-call-analysis-budget
      (try (static/specialize (source (str "(defn run [] " (apply str (repeat 34 "[")) "1"
                                         (apply str (repeat 34 "]")) ")"))) nil
       (catch error (:kind (ex-data error))))))
 (is (= :static-call-analysis-budget
      (try (static/specialize (source (str "(defn run [] [" (binary/copy "1 " 100001) "])"))) nil
       (catch error (:kind (ex-data error)))))))
