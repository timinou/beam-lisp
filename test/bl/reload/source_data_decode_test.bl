; HOME review candidate; actual managed ingress + SDK codecs, native UNRUN.
(ns reload.source-data-decode-test
 (:require [reload.generation :as g] [reload.native-target-fixture :as sdk]
           [datom.value-codec :as codec] [vm.wire :as wire]))
(defn- unsafe-kind [action]
 (try (action) nil (catch error (:kind (ex-data error)))))
(defn- fixture []
 (g/prepare!
  {:sources {"data.decode.app"
   "(ns data.decode.app (:require [reload.native-target-fixture :as sdk] [datom.value-codec :as codec] [vm.wire :as wire]))
    (defn decode [bytes] (sdk/decode-term bytes))
    (defn slot [bytes] (codec/decode-slot bytes))
    (defn value [bytes] (codec/decode bytes))
    (defn frame [bytes] (wire/decode bytes))"}
   :stable-namespaces #{"reload.native-target-fixture" "datom.value-codec" "vm.wire"}}))

(deftest actual-source-decodes-closed-storage-data-with-tuple-abi-preserved
 (let [generation (fixture)
       data {:tuple (tuple :ok (list 1 2)) :date (Date/from_iso8601! "2026-10-16")
             :plain [1 "two" false nil]}
       bytes (erlang/term_to_binary data)]
  (try
   (is (= data (g/invoke! generation "data.decode.app/decode" [bytes])))
   (is (= data (g/invoke! generation "data.decode.app/slot" [bytes])))
   (is (= data (g/invoke! generation "data.decode.app/value" [(codec/encode data)])))
   (is (= {:ok (tuple :control "id" :status)}
          (g/invoke! generation "data.decode.app/frame" [(erlang/term_to_binary (tuple :bl 1 :control "id" :status))])))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))

(deftest actual-source-refuses-runtime-etf-tags-before-returning-any-value
 (let [generation (fixture) port (first (erlang/ports))
       values [(erlang/self) (erlang/make_ref) (fn [] :function)
               (erlang/make_fun :erlang :abs 1) port]
       compressed (erlang/term_to_binary (String/duplicate "x" 4096) (list :compressed))]
  (try
   (is (erlang/is_port port))
   (doseq [value values]
    (let [bytes (erlang/term_to_binary {:nested (tuple :data (list value))})]
     (is (= :unsafe-external-data
            (unsafe-kind #(g/invoke! generation "data.decode.app/decode" [bytes]))))
     (is (= :unsafe-external-data
            (unsafe-kind #(g/invoke! generation "data.decode.app/slot" [bytes]))))))
   (is (= :unsafe-external-data
          (unsafe-kind #(g/invoke! generation "data.decode.app/decode" [compressed]))))
   (is (= {:error :malformed}
          (g/invoke! generation "data.decode.app/frame" [(erlang/term_to_binary (tuple :bl 1 :heartbeat (erlang/self)))])))
   (is (= false (BeamLisp.Env/source_execution_active?)))
   (finally (g/retire! generation)))))

(deftest trusted-native-decoder-keeps-compression-function-and-options-abi
 (let [value (String/duplicate "x" 4096) compressed (erlang/term_to_binary value (list :compressed))
       f (fn [] :native-function) encoded (erlang/term_to_binary f)]
  (is (= value (BeamLisp.Env/decode_data_term! compressed)))
  (is (= f (BeamLisp.Env/decode_data_term! encoded)))
  (is (= f (BeamLisp.Env/decode_data_term! encoded (list :safe))))
  (is (= :native-function ((BeamLisp.Env/decode_data_term! encoded))))
  (is (= false (BeamLisp.Env/source_execution_active?)))))
