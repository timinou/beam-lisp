(ns reload.ward-worker-test
 (:require [reload.ward :as ward] [env]))

(defn with-short-bound [action]
 (let [old (System/get_env "BL_TEST_TIMEOUT")]
  (try (System/put_env "BL_TEST_TIMEOUT" "2") (action)
       (finally (if old (System/put_env "BL_TEST_TIMEOUT" old) (System/delete_env "BL_TEST_TIMEOUT"))))))

(deftest fatal-worker-exit-is-reported-and-next-file-runs
 (with-short-bound
  (fn []
   (let [parent (erlang/list_to_binary (erlang/pid_to_list (erlang/self)))
         fatal (str "(ns ward.worker.fatal (:require [env])) "
                    "(erlang/send (erlang/list_to_pid (erlang/binary_to_list " (pr-str parent) ")) "
                    "[:ward-worker-scope (env/current) (env/allowed? \"Elixir.File\")]) "
                    "(erlang/exit (erlang/self) :kill)")
         result (ward/run (list
                 fatal
                 "(ns ward.worker.after) (deftest healthy (is true))"))
         dead (first (:files result))]
    (is (= :incoherent (:status dead)))
    (is (= :worker-exit (:kind (first (:errors dead)))))
    (is (includes? (:msg (first (:errors dead))) "killed"))
    (is (= 1 (:passed result)))
    (is (= :passed (:status (second (:files result)))))
    (is (= false (:ok? result)))
    (let [[scope allowed] (receive [:ward-worker-scope id before] [id before] (after 1000 [nil nil]))]
     (is (= true allowed))
     (is (some? scope))
     (is (= false (env/with-env scope #(env/allowed? "Elixir.File")))
         "parent cleanup destroys the fork even when kill bypasses worker finally"))))))

(deftest linked-initializer-exit-is-contained
 (with-short-bound
  (fn []
   (let [result (ward/run (list
                  "(ns ward.worker.linked) (erlang/spawn_link (fn [] (erlang/exit :initializer-failed))) (receive (after 30000 nil))"))
         error (first (:errors (first (:files result))))]
    (is (= :worker-exit (:kind error)))
    (is (includes? (:msg error) "initializer-failed"))))))

(deftest foreign-results-and-monitors-cannot-be-mistaken-for-this-worker
 (let [me (erlang/self) unrelated (erlang/make_ref)
       foreign [:ward-result me {:ns "foreign" :status :passed}]]
  (erlang/send me foreign)
  (erlang/send me (tuple :DOWN unrelated :process me :foreign))
  (let [result (ward/run (list "(ns ward.worker.genuine) (deftest healthy (is true))"))]
   (is (= "ward.worker.genuine" (:ns (first (:files result)))))
   (is (= 1 (:passed result)))
   (is (= foreign (receive [:ward-result pid r] :when (= pid me) [:ward-result pid r] (after 0 nil))))
   (is (= :foreign (receive [:DOWN ref :process pid reason] :when (and (= ref unrelated) (= pid me)) reason (after 0 nil)))))))

(deftest timeout-returns-only-after-worker-termination
 (with-short-bound
  (fn []
   (let [parent (erlang/list_to_binary (erlang/pid_to_list (erlang/self)))
         source (str "(ns ward.worker.timeout) "
                     "(erlang/send (erlang/list_to_pid (erlang/binary_to_list " (pr-str parent) ")) "
                     "[:ward-timeout-worker (erlang/self)]) (receive (after 30000 nil))")
         result (ward/run (list source))
         pid (receive [:ward-timeout-worker observed] observed (after 1000 nil))]
    (is (= :timeout (:kind (first (:errors (first (:files result)))))))
    (is (some? pid))
    (is (= false (Process/alive? pid)))))))

(defn fork-count []
 (Agent/get :Elixir.BeamLisp.Env (fn [state] (erlang/map_size (get state :envs {})))))

(deftest host-handover-stops-only-between-complete-files-and-closes-the-base
 (let [before (fork-count) completed (atom 0)
       result (ward/run ["(ns ward.handover.first) (deftest healthy (is true))"
                         "(ns ward.handover.unrun) (throw :must-not-run)"]
                (fn [event] (when (= :file-done (:phase event)) (swap! completed inc)))
                {:continue? #(zero? @completed)})]
  (is (= true (:stopped? result)))
  (is (= 1 (count (:files result))))
  (is (= 1 (:passed result)))
  (is (= "ward.handover.first" (:ns (first (:files result)))))
  (is (= before (fork-count)))))

(deftest warm-suite-bases-close-on-success-failure-and-empty-runs
 (let [before (fork-count)]
  (is (= true (:ok? (ward/run []))))
  (is (= before (fork-count)))
  (is (= true (:ok? (ward/run-sandboxed []))))
  (is (= before (fork-count)))
  (is (= true (:ok? (ward/run-examples []))))
  (is (= before (fork-count)))
  (ward/run ["(ns ward.base.failure) (deftest broken (is false))"])
  (is (= before (fork-count)))
  (try (ward/run (lazy-seq (throw (ex-info "source iteration failed" {})))) (catch _ nil))
  (is (= before (fork-count)))))
