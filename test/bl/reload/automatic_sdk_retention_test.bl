; Native component controls. FIRST case requires a fresh ordinary SDK VM
; before any framework adoption. Never delete/fabricate a lease to fake coldness.
; Host ensure_sdk_runtime! must be built coherently first. Native UNRUN.
(ns reload.automatic-sdk-retention-test
 (:require [reload.generation :as g]))
(defn proposal [name]
 {:application-id name :sources {"automatic.sdk.fixture"
  "(ns automatic.sdk.fixture) (defn marker [] :original)"}})
(defn error-value [action]
 (try (action) nil
  (catch error
   ;; Native BIF errors may be represented as ErlangError by the test runner.
   (if (and (erlang/is_map error) (maps/is_key :original error))
    (maps/get :original error) error))))
(deftest cold-prepare-establishes-actual-sdk-and-repeat-hits-exact-graph
 (is (erlang/== (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
 (let [p (proposal "automatic-sdk-cold") a (g/prepare! p)]
  (try
   (is (= :sdk-runtime-retained (BeamLisp.Env/ensure_sdk_runtime!)))
   (is (BeamLisp.Env/sdk_runtime_retained_modules? (list :Elixir.BeamLisp.Env)))
   (let [entry (BeamLisp.Env/fetch_exact! "reload.generation" "prepare!")]
    (is (erlang/is_function entry 1))
    (is (BeamLisp.Env/sdk_runtime_retained_modules?
         (list (erlang/element 2 (erlang/fun_info entry :module))))))
   (is (erlang/== a (g/prepare! p)))
   (is (= :original (g/invoke! a "automatic.sdk.fixture/marker" [])))
   (finally (g/retire! a)))))
(deftest real-changed-sdk-publication-refuses-before-native-load-and-serving-change
 (let [a (g/prepare! (proposal "automatic-sdk-replacement"))
       slot (g/slot) module :Elixir.BeamLisp.Env
       before (erlang/apply module :module_info (list :md5))
       forms (list
        (tuple :attribute 1 :module module)
        (tuple :attribute 1 :export (list (tuple :fixture 0)))
        (tuple :function 2 :fixture 0
          (list (tuple :clause 2 (list) (list)
                        (list (tuple :atom 2 :changed))))))
       built (compile/forms forms (list :binary :return_errors :return_warnings))]
  (try
   (is (= :ok (elem built 0)))
   (is (= :applied (:status (g/publish! slot nil a))))
   (is (= :sdk_runtime_replacement_requires_handover
        (error-value #(BeamLisp.Env/publish_binaries!
                        (list (tuple (tuple module (elem built 2))
                                     "<controlled-sdk-replacement>"))))))
   (is (= before (erlang/apply module :module_info (list :md5))))
   (is (= a @(:current slot)))
   (is (= :original (g/invoke! a "automatic.sdk.fixture/marker" [])))
   (is (erlang/== a (g/prepare! (proposal "automatic-sdk-replacement"))))
   (finally (g/close! slot (:digest a)) (g/retire! a)))))
