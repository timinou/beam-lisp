(ns reload.inert-lookup-test (:require [reload.generation :as g]))

(defn- reason [action]
 (try (action) nil (catch error (:original error))))

(deftest data-lookups-and-improper-captures-do-not-invoke-hidden-callables
 (let [graph (g/prepare! {:sources {"lookup.application"
              "(ns lookup.application)
               (defn lookup [data] (:value data))
               (defn invoke [data] ((:internal data)))
               (defn carry [data] (let [callbacks [(fn [] data)]] ((first callbacks))))"}})
       hidden (erlang/make_fun :Elixir.BeamLisp.Env :env_id 0)
       data {:value 42 :internal hidden}
       inert (BeamLisp.Ns.Rt/raw-cons :head :tail)
       guarded (BeamLisp.Ns.Rt/raw-cons :head hidden)]
  (try
   (is (= 42 (g/invoke! graph "lookup.application/lookup" [data])))
   (is (= :source_native_target_refused
          (reason #(g/invoke! graph "lookup.application/invoke" [data]))))
   (is (= inert (g/invoke! graph "lookup.application/carry" [inert])))
   (is (= :source_native_target_refused
          (reason #(g/invoke! graph "lookup.application/carry" [guarded]))))
   (finally (g/retire! graph)))))
