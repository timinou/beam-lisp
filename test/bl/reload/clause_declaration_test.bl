; Compiler-phase isolation: candidate transforms must never run as a purity test.
(ns reload.clause-declaration-test
 (:require [reload.declaration :as declaration] [reload.generation :as g]
           [proc.server :as ps] [proc.reg] [proc.tick] [reader-node :as rn] [env]))

(defn- kind [f] (try (f) nil (catch e (:kind (ex-data e)))))
(defn- expand-managed [form]
 (env/isolated (env/current)
  (fn []
   (env/eval "(ns managed.clause.fixture (:require [proc.server :as ps]))")
   (declaration/with-preparation! {"managed.clause.fixture" "managed.clause.fixture"}
    #(BeamLisp.Compiler/macroexpand_1 (rn/node-form (first (BeamLisp.Reader/read_string form)))
                                    "managed.clause.fixture")))))

(deftest preparation-signals-are-scope-bound-and-restored
 (is (not (declaration/preparing?)))
 (declaration/with-preparation! {}
  (fn []
   (is (declaration/preparing?))
   (is (not (declaration/managed-source?)))
   (env/isolated (env/current) #(is (not (declaration/preparing?))))))
 (is (not (declaration/preparing?)))
 (try (declaration/with-preparation! {} #(throw "preparation fixture"))
      (catch _ nil))
 (is (not (declaration/preparing?))))

(deftest development-transforms-are-not-executed-by-managed-compilation
 (let [before @ps/registry effects (atom [])]
  (try
   (ps/register-clause! :unadmitted (fn [_ _] (swap! effects conj :custom) {}))
   (is (= :unadmitted-clause-transform
          (kind #(expand-managed "(ps/defserver owner (unadmitted))"))))
   (is (= [] @effects))
   ;; An SDK spelling in the development Atom is no more authoritative.
   (ps/register-clause! :registry (fn [_ _] (swap! effects conj :poisoned-sdk) {}))
   (is (some? (expand-managed "(ps/defserver owner (registry (keys :account)))")))
   (is (= [] @effects))
   ;; Existing ordinary source/AOT registration and explicit pure models remain.
   (is (= [] (:unknown (ps/clause-plan
                       {:name 'ordinary :clauses '((unadmitted))
                        :vocabulary @ps/registry :native-heads #{}}))))
   (is (= [:custom] @effects))
   (finally (reset! ps/registry before)))))

(deftest managed-custom-registration-refuses-before-emitting-an-initializer
 (let [before @ps/registry]
  (is (= :unadmitted-clause-transform
         (kind #(expand-managed "(ps/extend-clause! :custom (fn [_ _] {}))"))))
  (is (= before @ps/registry))))

(deftest runtime-clause-registration-cannot-change-serving-vocabulary
 (let [before @ps/registry
       graph (g/prepare!
              {:stable-namespaces #{"proc.server"}
               :sources {"managed.clause.runtime"
                "(ns managed.clause.runtime (:require [proc.server :as ps]))
                 (defn mutate [] (ps/register-clause! :managed-mutation (fn [_ _] {})))"}})]
  (try
   (is (= :immutable-declaration-required
          (kind #(g/invoke! graph "managed.clause.runtime/mutate" []))))
   (is (= before @ps/registry))
   (finally (g/retire! graph)))))

(defn- custom-options [version]
 {:application-id "owned-clause"
  :stable-namespaces #{"proc.server" "reload.declaration"}
  :sources {"owned.clause"
   (str "(ns owned.clause (:require [proc.server :as ps] [reload.declaration :as decl])) "
        "(defn transform [clause ctx] {:init {:release " (pr-str version) "}}) "
        "(ps/extend-clause! :release transform) "
        "(defn callback [] (:provider (decl/lookup :clause :release))) "
        "(defn read [] ((:provider (decl/lookup :clause :release)) '(release) {}))")}})

(deftest eager-named-custom-clauses-are-owned-by-the-exact-graph
 (let [old (g/prepare! (custom-options :old)) next (g/prepare! (custom-options :new))
       callback (g/invoke! old "owned.clause/callback" [])
       hold (g/with! old #(g/capture!))]
  (try
   (is (= {:init {:release :old}} (g/invoke! old "owned.clause/read" [])))
   (is (= {:init {:release :new}} (g/invoke! next "owned.clause/read" [])))
   (is (= {:init {:release :old}} (callback '(release) {})))
   (is (= :clause (get-in old [:declarations :clause :release :data :kind])))
   (is (g/runtime-value? (:declarations old)))
   (is (= :waiting (:status (g/retire! old))))
   (g/release! hold)
   (is (= :retired (:status (g/retire! old))))
   (is (= :retired-generation (kind #(callback '(release) {}))))
   (is (= {:init {:release :new}} (g/invoke! next "owned.clause/read" [])))
   (finally (g/release! hold) (g/retire! old) (g/retire! next)))))

(deftest actual-managed-server-compilation-uses-the-admitted-custom-transform
 (let [options (custom-options :compiled)
       options (assoc-in options [:sources "owned.server"]
                "(ns owned.server (:require [owned.clause] [proc.server :as ps]))
                 (ps/defserver owner (release))")
       graph (g/prepare! options)]
  (try
   (is (contains? (:mapping graph) "owned.server"))
   (is (= {:init {:release :compiled}} (g/invoke! graph "owned.clause/read" [])))
   (finally (g/retire! graph)))))

(deftest unsafe-named-clause-transforms-refuse-without-running
 (let [key "BL_UNADMITTED_CLAUSE_EFFECT" before (System/get_env key)]
  (try
   (System/delete_env key)
   (doseq [body ["(System/put_env \"BL_UNADMITTED_CLAUSE_EFFECT\" \"bad\") {}"
                "{:clauses (lazy-seq (System/put_env \"BL_UNADMITTED_CLAUSE_EFFECT\" \"bad\") nil)}"
                "(transform clause ctx)"
                "(clause ctx)"]]
    (is (= :unadmitted-clause-transform
           (kind #(g/prepare!
                    {:native-modules #{"System"} :stable-namespaces #{"proc.server"}
                     :sources {"unsafe.clause"
                      (str "(ns unsafe.clause (:require [proc.server :as ps])) "
                           "(defn transform [clause ctx] " body ") "
                           "(ps/extend-clause! :unsafe transform)")}}))))
    (is (nil? (System/get_env key))))
   (finally (if before (System/put_env key before) (System/delete_env key))))))
