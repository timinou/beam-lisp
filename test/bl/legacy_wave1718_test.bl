; legacy_wave1718_test.bl — two ExUnit suites, ported whole:
;
;   * test/beam_lisp/wave17_transient_test.exs — Clojure transients (wave 17):
;     a mutable-inside-a-scope view of a persistent collection. The transient
;     wrapper lives in BeamLisp.Transient; `persistent!` is a one-way door —
;     using a transient after persisting raises. Vectors get a real bulk-build
;     win (accumulate + rebuild trie once); maps are an API-compat layer over
;     Elixir's already-persistent maps. The last group loads five vendored jank
;     fixtures VERBATIM and calls them — the fidelity harness pattern.
;   * test/beam_lisp/wave18_destructure_test.exs — sequential `:as`
;     destructuring: whole-collection binding, `:as` with `& rest`, lists vs
;     lazy seqs, nesting, fn/defn/loop params, and the two compile-time
;     refusals (a nameless `:as`, `:as` not in the final position).
;
; Every describe/test case is carried here, one `deftest` each, named by
; kebab-casing the ExUnit title and grouped by the same `describe` blocks so
; the mapping is structural: each group comment below names its source describe
; and the deftest names appear in source order.
;
; Coverage (assertion parity — no case dropped, no assertion dropped):
;   wave17_transient_test.exs   15 tests / 27 assertions → 15 deftests / 27 `is`
;   wave18_destructure_test.exs 13 tests / 17 assertions → 13 deftests / 17 `is`
;   total                       28 tests / 44 assertions → 28 deftests / 44 `is`
;
; Fidelity notes
;   · `eval_in/1` and `eval/1`. The ExUnit helpers were
;     `BeamLisp.Compiler.eval_string(src, new_env("wave17"))` (wave17) and
;     `BeamLisp.eval/1` (wave18); both are spelled the same here, so every
;     source under test is the ORIGINAL string, compiled by the same compiler.
;   · `load_fixture/2`. The ExUnit helper stripped the vendored header
;     comments, wrapped the slice in its own `(ns …)`, and evaluated it into a
;     throwaway env. The `(ns …)` form rebinds the PROCESS's current namespace,
;     so it is restored on exit — the rest of this file must still resolve in
;     `legacy.wave1718.test`. The slice text itself is untouched.
;   · assert_raise → a TYPED catch. `ArgumentError` / `RuntimeError` are caught
;     by class (compared to the struct tag) and the message is checked with
;     `includes?` on the same substring the ExUnit `~r/…/` matched — the port
;     idiom `legacy_wave678_test.bl` established.
;   · The wave17 benchmark reported a ratio with `IO.puts`; it is carried as-is
;     through `println`, and its correctness assertions are the real check.
;
; Run: bin/bl test test/bl/legacy_wave1718_test.bl

(ns legacy.wave1718.test)

; ── helpers ────────────────────────────────────────────────────────────────

(defn- read-fixture-code
  "Read the upstream bytes verbatim. The language reader already accepts the
   vendored comment header; a second text-filtering pass adds no coverage."
  [fixture]
  (File/read! (Path/join (BeamLisp/cwd) (str "test/fixtures/jank/" fixture))))

(defn- load-fixture
  "Load a jank fixture verbatim into a throwaway ns and leave it callable at
   `ns/…`. Restores the current namespace after evaluating `(ns ns)`."
  [fixture ns]
  (BeamLisp.Env/with_ns ns
    (fn []
      (BeamLisp.Compiler/eval_string
        (str "(ns " ns ")\n" (read-fixture-code fixture))
        (BeamLisp.Compiler/new_env ns)))))

(defn- eval-in
  "The ExUnit `eval_in/1`: evaluate `src` in a fresh `wave17` env."
  [src]
  (BeamLisp.Compiler/eval_string src (BeamLisp.Compiler/new_env "wave17")))

(defn- ev
  "The ExUnit wave18 `eval/1`: evaluate `src` in the running runtime."
  [src]
  (BeamLisp/eval src))

(defn- raises-with?
  "The port of `assert_raise cls, ~r/…/, fn -> … end`: true only when `(f)`
   raises `cls-kw` whose message contains `needle`. The ExUnit patterns here are
   plain substrings, so `includes?` matches exactly what `~r/…/` did."
  [cls-kw needle f]
  (try
    (do (f) false)
    (catch e (and (= cls-kw (:__struct__ e))
                  (includes? (str (ex-message e)) needle)))))

; ══ wave17_transient_test.exs ══════════════════════════════════════════════

; ── describe "transient vectors" ────────────────────────────────────────────

(deftest transient-vector-build-then-persist-equals-persistent-build
  (is (= (eval-in "(persistent! (conj! (conj! (conj! (transient []) 1) 2) 3))")
         (eval-in "[1 2 3]")))
  (is (= true (eval-in "(= (persistent! (conj! (transient []) 1)) [1])"))))

(deftest transient-vector-bulk-build-past-the-trie-boundary
  ; 1000 conj!s crosses the raw-tuple → trie transition several times.
  (is (= 1000
         (eval-in "(count (persistent! (reduce (fn [acc i] (conj! acc i)) (transient []) (range 1000))))"))))

(deftest transient-of-a-non-empty-vector-seeds-its-elements
  (is (= (eval-in "[1 2 3]") (eval-in "(persistent! (conj! (transient [1 2]) 3))"))))

(deftest transient-vector-use-after-persistent-raises
  (is (raises-with? :Elixir.ArgumentError "already-persisted"
        (fn [] (eval-in "(let [t (transient [])] (persistent! (conj! t 1)) (conj! t 2))"))))
  ; the original matched ~r/already-persisted|expected a transient/; a double
  ; persist hits the second arm of that alternation.
  (is (raises-with? :Elixir.ArgumentError "expected a transient"
        (fn [] (eval-in "(persistent! (persistent! (transient [])))")))))

; ── describe "transient maps" ───────────────────────────────────────────────

(deftest transient-map-build-then-persist-equals-persistent-build
  (is (= (eval-in "{:a 1 :b 2}")
         (eval-in "(persistent! (assoc! (assoc! (transient {}) :a 1) :b 2))")))
  (is (= true (eval-in "(= (persistent! (assoc! (transient {}) :a 1)) {:a 1})"))))

(deftest transient-map-get-reads-through-to-live-state
  (is (= (eval-in "{:a 2 :b 5}")
         (eval-in "(persistent! (assoc! (assoc! (transient {}) :a (inc (get (transient {:a 1}) :a 0))) :b 5))"))))

(deftest transient-map-dissoc-removes-entries
  (is (= (eval-in "{:b 2}") (eval-in "(persistent! (dissoc! (transient {:a 1 :b 2}) :a))"))))

(deftest transient-map-use-after-persistent-raises-on-assoc
  (is (raises-with? :Elixir.ArgumentError "already-persisted"
        (fn [] (eval-in "(let [t (transient {})] (persistent! (assoc! t :a 1)) (assoc! t :b 2))")))))

; ── describe "hash-map" ─────────────────────────────────────────────────────

(deftest hash-map-zero-arity-is-empty-even-arity-builds
  (is (= {} (eval-in "(hash-map)")))
  (is (= (eval-in "{:a 1}") (eval-in "(hash-map :a 1)")))
  (is (= (eval-in "{:a 1 :b 2}") (eval-in "(hash-map :a 1 :b 2)")))
  (is (= {} (eval-in "(persistent! (transient (hash-map)))"))))

; ── describe "verbatim jank fixtures unlocked by transients" ────────────────

(deftest verbatim-jank-keys
  (load-fixture "slice_26_keys.bl" "w17.keys")
  ; keys returns the map's keys in seq order (implementation-defined, like
  ; Clojure); the fixture must match the order reduce sees.
  (is (= (eval-in "(w17.keys/keys {:a 1 :b 2 :c 3})")
         (eval-in "(reduce (fn [acc kv] (conj acc (first kv))) [] {:a 1 :b 2 :c 3})")))
  (is (= [:a :b :c] (vec (sort (eval-in "(w17.keys/keys {:a 1 :b 2 :c 3})"))))))

(deftest verbatim-jank-vals
  (load-fixture "slice_27_vals.bl" "w17.vals")
  (is (= (eval-in "(w17.vals/vals {:a 1 :b 2 :c 3})")
         (eval-in "(reduce (fn [acc kv] (conj acc (second kv))) [] {:a 1 :b 2 :c 3})")))
  (is (= [1 2 3] (vec (sort (eval-in "(w17.vals/vals {:a 1 :b 2 :c 3})"))))))

(deftest verbatim-jank-zipmap
  (load-fixture "slice_29_zipmap.bl" "w17.zipmap")
  (is (= (eval-in "{:a 1 :b 2 :c 3}") (eval-in "(w17.zipmap/zipmap [:a :b :c] [1 2 3])")))
  (is (= (eval-in "{:a 1 :b 2}") (eval-in "(w17.zipmap/zipmap [:a :b] [1 2 3])"))))

(deftest verbatim-jank-frequencies
  (load-fixture "slice_42_frequencies.bl" "w17.frequencies")
  (is (= (eval-in "{:a 3 :b 2 :c 1}")
         (eval-in "(w17.frequencies/frequencies [:a :b :a :c :a :b])"))))

(deftest verbatim-jank-group-by
  (load-fixture "slice_43_group_by.bl" "w17.groupby")
  (is (= (eval-in "{false [1 3 5], true [2 4]}")
         (eval-in "(w17.groupby/group-by even? [1 2 3 4 5])"))))

; ── describe "bulk-build benchmark (evidence, not assertion)" ───────────────
; Real numbers, honestly reported: the process-dictionary indirection per conj!
; costs more than the persistent vector's already-amortized tail-buffer
; savings, so the transient is an API-compat layer, not a speedup. The
; correctness check is the real assertion.

(deftest transient-vector-100k-build-timing-and-correctness
  (let [[t-persist v]
        (erlang/apply :timer :tc
          (list (fn []
                  (eval-in "(persistent! (reduce (fn [acc i] (conj! acc i)) (transient []) (range 100000)))"))))
        [t-plain pv]
        (erlang/apply :timer :tc
          (list (fn []
                  (eval-in "(reduce (fn [acc i] (conj acc i)) [] (range 100000))"))))]
    (println
      (str "bench: 100k conj! transient=" t-persist "µs plain conj=" t-plain "µs "
           "ratio=" (/ t-persist (max t-plain 1)) "x "
           "(transient is API-compat, not a speedup on BEAM)"))
    (is (= 100000 (BeamLisp.Vector/count v)))
    (is (= 0 (BeamLisp.Vector/first v)))
    (is (= 100000 (BeamLisp.Vector/count pv)))
    (is (= v pv))))

; ══ wave18_destructure_test.exs ════════════════════════════════════════════

; ── describe "sequential :as destructuring" ─────────────────────────────────

(deftest as-binds-the-entire-original-collection-in-let
  (is (= true (ev "(let [[a :as whole] [1 2]] (= whole [1 2]))")))
  (is (= 3 (ev "(let [[a b :as whole] [1 2 3]] (count whole))"))))

(deftest as-binds-the-whole-collection-not-the-remainder
  ; a gets the first element; whole is the full vector, not [2].
  (is (= [1 2] (ev "(let [[a :as whole] [1 2]] whole)")))
  (is (= [1 2 3] (ev "(let [[a b :as whole] [1 2 3]] whole)"))))

(deftest as-combines-with-rest
  (is (= true
         (ev "(let [[a & more :as all] [1 2 3]] (and (= all [1 2 3]) (= more (list 2 3))))"))))

(deftest as-still-binds-the-whole-when-rest-is-exhausted-to-nil
  (is (= true (ev "(let [[a & rest :as all] [1]] (and (= all [1]) (nil? rest)))"))))

(deftest as-keeps-a-list-a-list
  (is (= true
         (ev "(let [[a :as all] '(1 2)] (and (= a 1) (= all '(1 2)) (list? all)))"))))

(deftest as-binds-a-lazy-seq-without-realizing-it
  ; Binding `:as` alone forces nothing: the counter stays 0 until `first`
  ; actually walks the seq (which forces one cell → 1).
  (is (= [0 1 1]
         (ev "(let [n (atom 0) s (lazy-seq (swap! n inc) (list 1 2 3)) [:as all] s] [@n (first all) @n])"))))

(deftest nested-as-binds-inner-and-outer-wholes
  (is (= true
         (ev "(let [[[a :as inner] :as outer] [[1] 2]] (and (= inner [1]) (= outer [[1] 2])))"))))

(deftest as-in-fn-params
  (is (= [1 3] (ev "((fn [[a :as whole]] [a (count whole)]) [1 2 3])")))
  (is (= [9 3 8] (ev "((fn [[a & more :as all]] [a (count all) (first more)]) [9 8 7])"))))

(deftest as-in-defn-params
  (is (= [1 3] (ev "(defn f [[a :as whole]] [a (count whole)]) (f [1 2 3])"))))

(deftest as-in-loop-bindings-rebinds-each-iteration
  ; `[x :as xs]` destructures a list (and a nil rest) across re-curs; the
  ; recursion only terminates when x is nil, so :as must not interfere with the
  ; exhausted-rest nil semantics.
  (is (= "done with 0"
         (ev "(loop [[x :as xs] (list 1 2 3)] (if (nil? x) (str \"done with \" (count xs)) (recur (rest xs))))"))))

(deftest as-with-a-name-is-required
  (is (raises-with? :Elixir.RuntimeError "followed by a name"
        (fn [] (ev "(let [[a :as] [1]] a)")))))

(deftest as-in-a-non-final-position-raises
  (is (raises-with? :Elixir.RuntimeError "last two elements"
        (fn [] (ev "(let [[a :as x b] [1 2]] a)")))))

(deftest lenient-too-few-elements-binds-nil
  (is (= true (ev "(let [[a b c] [1]] (and (= a 1) (nil? b) (nil? c)))")))
  (is (= true (ev "(let [[a b :as all] [1]] (and (= a 1) (nil? b) (= all [1])))"))))
