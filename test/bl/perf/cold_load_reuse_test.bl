; cold_load_reuse_test.bl — a cold VM must not re-parse what it already knows.
;
; A first library load used to re-read every source it touched two to three
; times: once to walk its (ns …) requires, once to classify it as replayable,
; once more for its freshness parts. The verdicts are pure in the source bytes,
; so they are remembered by content hash. These check the cached answers are the
; SAME answers, and that the header read stops at the header.
;
; Run: bl test test/bl/perf/cold_load_reuse_test.bl

(ns cold-load-reuse-test)

(def src "(ns cold.reuse.probe (:require [data.bounded-cache]))\n(defn f [x] (inc x))\n(def y 1)\n")

(deftest read-first-reads-only-the-header
  (let [header (BeamLisp.Reader/read_first src "probe.bl")]
    (is (some? header))
    (is (= (first (BeamLisp.Reader/read_string src "probe.bl")) header)))
  (is (nil? (BeamLisp.Reader/read_first "" "empty.bl")))
  ;; a body that does not parse is not read at all
  (is (some? (BeamLisp.Reader/read_first "(ns ok)\n(defn broken [" "broken.bl"))))

(deftest replayable-verdict-is-stable-across-the-memo
  (let [effects (str "(ns cold.reuse.effects)\n(println :side-effect) ;" (erlang/unique_integer))
        plain (str src ";" (erlang/unique_integer))]
    (is (true? (BeamLisp.Loader/replayable_source? plain)))
    (is (true? (BeamLisp.Loader/replayable_source? plain)) "memo hit answers the same")
    (is (false? (BeamLisp.Loader/replayable_source? effects)))
    (is (false? (BeamLisp.Loader/replayable_source? effects)) "memo hit answers the same")))
