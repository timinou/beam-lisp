(ns reader-eager-projection-test (:require [reader-node :as rn]))

(defn- isolated [action]
 (let [scope (BeamLisp.Env/fork :global) previous (BeamLisp.Env/capture)]
  (try (BeamLisp.Env/with_env scope action)
   (finally (BeamLisp.Env/bind previous) (BeamLisp.Env/destroy scope)))))

(deftest syntax-projection-does-not-invoke-shadowed-core-collection-functions
 (let [sources ["(f [1 (g 2)] {:k 3})" "#{1 [2 x]}" "#Point{:x [1 2]}"
                "'(a b)" "#(+ %1 %2 %&)" "^{:tag syntax} [x y]" "(def x 1) (+ x 2)"]
       expected (Enum/map sources #(erlang/term_to_binary (BeamLisp.Reader/read_all %)))
       marker (str (System/get_env "HOME") "/tmp/reader-projection-never-run-"
                   (System/unique_integer (list :positive)))
       shadow (fn [& _] (File/write! marker "called") (throw :unexpected-parser-callback))]
  (try
   (isolated
    (fn []
     (BeamLisp.Env/intern "core" "list" shadow)
     (BeamLisp.Env/intern "core" "count" shadow)
     (Enum/each (Enum/zip sources expected)
      (fn [pair]
       (is (= (elem pair 1)
              (erlang/term_to_binary (BeamLisp.Reader/read_all (elem pair 0)))))))))
   (is (= false (File/exists? marker)))
   (finally (File/rm marker)))))

(deftest node-to-form-projection-uses-fixed-reader-helpers-and-exact-containers
 (let [node (BeamLisp.Reader/read_one "(f [1 x])")
       expected (list 'f [1 'x])]
  (is (erlang/=:= expected (rn/form node)))
  (isolated
   (fn []
    (BeamLisp.Env/intern "core" "list" nil)
    (BeamLisp.Env/intern "reader-node" "form" nil)
    (let [actual (rn/form node)]
     (is (erlang/=:= expected actual))
     (is (erlang/is_list actual))
     (is (vector? (second actual))))))))
