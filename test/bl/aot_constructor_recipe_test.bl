(ns aot-constructor-recipe-test)

(defn- literal [value] {:op :lit :val value})
(defn- remote [module function arguments]
 {:op :remote :mod module :fun function :args arguments})
(defn- thunk [body]
 {:op :fn :clauses (list {:pats (list) :guard nil :body body})})
(defn- recipe [body]
 (remote :Elixir.BeamLisp.LazySeq :new (list (thunk body))))
(defn- consume [expression]
 (remote :Elixir.BeamLisp.Ns.Core :to-list (list expression)))
(defn- run [expression] (BeamLisp.AOT/interpret_constructor! expression {} {}))
(defn- refusal [expression]
 (try (run expression) nil (catch error (ex-data error))))

(deftest interpreted-recipes-consume-finite-sequences-without-native-resources
 (doseq [value [nil (list) (list 1 2) [1 2] #{1 2} "é🙂"]]
  (is (= (to-list value) (run (consume (recipe (literal value)))))))
 (is (= 32 (run (remote :Elixir.BeamLisp.LazySeq :chunk_size (list)))))
 (is (= (list 1 2)
        (run (remote :Elixir.BeamLisp.LazySeq :cell (list (recipe (literal (list 1 2)))))))))

(deftest recipe-thunks-memoize-before-a-second-sequence-consumption
 (let [symbol (remote :Elixir.BeamLisp.Ns.Rt :gensym (list (literal "once")))
       make-list (remote :Elixir.BeamLisp.Ns.Core :list__bl_v
                   (list {:op :cons :head symbol :tail {:op :enil}}))
       first-read (remote :Elixir.BeamLisp.Ns.Core :first (list {:op :var :name "r"}))
       expression {:op :let :name "r" :init (recipe make-list)
                   :body (remote :erlang :=:= (list first-read first-read))}]
  ;; Re-executing the thunk would obtain two different VM-wide fresh symbols.
  (is (= true (run expression)))))

(deftest private-recipe-shape-and-field-observations-refuse
 (doseq [function [:list? :seq? :get]]
  (let [arguments (if (= :get function)
                    (list (recipe (literal (list 1))) (literal :__struct__))
                    (list (recipe (literal (list 1)))))]
   (is (= :opaque-finite-recipe-observation
          (:detail (refusal (remote :Elixir.BeamLisp.Ns.Core function arguments)))))))
 (is (= :opaque-finite-recipe-observation
        (:detail (refusal
          {:op :apply :fn (literal :constructor-frame)
           :args (list (recipe (literal (list 1))))}))))
 (is (= :finite-recipe-escape (:detail (refusal (recipe (literal (list 1))))))))

(deftest recipe-forgery-and-native-callbacks-never-gain-execution-authority
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-recipe-never-run-"
                   (System/unique_integer (list :positive)))
       effect (fn [] (File/write! marker "ran") (list 1))
       forged {:op :map :pairs
               (list (list (literal :__struct__) (literal :Elixir.BeamLisp.LazySeq))
                     (list (literal :constructor-frame) (literal :forged))
                     (list (literal :constructor-id) (literal 1)))}]
  (try
   (is (= :foreign-struct
          (:reason (refusal (consume forged)))))
   (is (= :unsafe-first-order-data
          (:kind (refusal (consume (remote :Elixir.BeamLisp.LazySeq :new (list (literal effect))))))))
   (is (= false (File/exists? marker)))
   (is (= :constructor-machine-refused
          (:kind (refusal (consume (recipe (remote :Elixir.File :write!
                                            (list (literal marker) (literal "bad")))))))))
   (is (= false (File/exists? marker)))
   (finally (File/rm marker)))))

(deftest finite-chain-and-cursor-materialization-never-invent-physical-cell-shapes
 (let [chain (remote :Elixir.BeamLisp.LazySeq :chain
               (list (literal (list 1 2)) (thunk (literal (list 3 4)))))
       input (remote :Elixir.BeamLisp.LazySeq :input (list (literal (vec (range 40)))))]
  (is (= (list 1 2 3 4) (run (consume chain))))
  (is (= (to-list (range 40)) (run (consume input))))
  (is (= :opaque-finite-recipe-cell-observation
         (:detail (refusal (remote :Elixir.BeamLisp.LazySeq :cell (list chain))))))
  (is (= :opaque-finite-recipe-cell-observation
         (:detail (refusal (remote :Elixir.BeamLisp.LazySeq :cell (list input))))))))

(deftest nested-recipes-and-large-realized-prefixes-have-explicit-bounds
 (let [deep (reduce (fn [tail _] (recipe tail)) (literal (list 1)) (range 66))]
  (is (= :finite-recipe-depth (:detail (refusal (consume deep))))))
 (is (= :collection-budget
        (:detail (refusal (consume (recipe (literal (String/duplicate "x" 16385)))))))))

(deftest finite-runtime-stack-guards-keep-the-selected-sorted-predicate-semantics
 (doseq [value [nil (list) [1] #{1} {} 'item]]
  (is (= (BeamLisp.Ns.Rt/sorted? value)
         (run (remote :Elixir.BeamLisp.Ns.Rt :sorted? (list (literal value))))))))


(deftest finite-recipes-cannot-be-reinterpreted-as-ordinary-cons-tails
 (is (= :opaque-finite-recipe-observation
        (:detail (refusal {:op :cons :head (literal :head)
                           :tail (recipe (literal (list 1 2)))}))))
 (is (= :finite-chain-prefix
        (:detail (refusal (consume
                   (remote :Elixir.BeamLisp.LazySeq :chain
                    (list (literal [1 2]) (thunk (literal (list 3)))))))))))


(deftest opaque-observation-diagnostics-expose-only-fixed-native-target
 (let [error (refusal (remote :Elixir.BeamLisp.Ns.Core :list?
                       (list (recipe (literal (list 1))))))]
  (is (= {:kind :constructor-machine-refused :detail :opaque-finite-recipe-observation
          :operation [:Elixir.BeamLisp.Ns.Core :list? 1]} error))))


(defn- append-step []
 {:op :fn :clauses
  (list {:pats (list {:pop :pvar :name "prior"} {:pop :pvar :name "item"})
         :guard nil :body (remote :Elixir.BeamLisp.Ns.Core :conj
                           (list {:op :var :name "prior"} {:op :var :name "item"}))})})

(defn- source-core [binding arguments]
 (BeamLisp.AOT/interpret_constructor!
  {:op :apply :fn {:op :global :ns "core" :name binding} :args arguments} {}
  (BeamLisp.AOT/constructor_metadata {"core" (BeamLisp.Env/ns_defs "core")}
   {["core" "TRANSIENT-THRESHOLD"]
    (literal (BeamLisp.Env/fetch_exact! "core" "TRANSIENT-THRESHOLD"))})))

(deftest modeled-lazy-identity-matches-only-real-lazy-nodes
 (is (= true (run (remote :Elixir.BeamLisp.LazySeq :lazy?
                    (list (recipe (literal (list 1))))))))
 (is (= true (run (remote :Elixir.BeamLisp.LazySeq :lazy?
                    (list (recipe (literal nil)))))))
 (is (= false (run (remote :Elixir.BeamLisp.LazySeq :lazy?
                     (list (remote :Elixir.BeamLisp.LazySeq :chain
                             (list (literal (list 1)) (thunk (literal (list 2))))))))))
 (is (= false (run (remote :Elixir.BeamLisp.LazySeq :lazy?
                     (list (remote :Elixir.BeamLisp.LazySeq :input
                             (list (literal (vec (range 40))))))))))
 (doseq [value [nil (list) [1] #{1} {}]]
  (is (= (BeamLisp.LazySeq/lazy? value)
         (run (remote :Elixir.BeamLisp.LazySeq :lazy? (list (literal value))))))))

(deftest source-core-reduce-uses-actual-compiled-wrapper-clauses
 ;; Global declaration metadata chooses actual Source reduce, not our closed
 ;; direct Core adapter. This catches native helper calls inside the wrapper.
 (is (= [1 2 3]
        (source-core "reduce" (list (append-step) (literal [])
                                    (recipe (literal (list 1 2 3)))))))
 (is (= [1 2]
        (source-core "reduce" (list (append-step) (literal []) (literal [1 2])))))
 (is (= []
        (source-core "reduce" (list (append-step) (literal []) (literal [])))))
 (is (= (list 1 2)
        (source-core "to-list" (list (literal (list 1 2))))))
 (is (= (list 1 2)
        (run (remote :Elixir.BeamLisp.Ns.Rt :k-to-list
                (list (recipe (literal (list 1 2)))))))))

(deftest native-fold-policy-is-closed-and-callback-output-remains-first-order
 (doseq [arguments [(list (append-step) (literal []) (literal [1 2]))
                   (list (append-step) (literal []) (literal [1 2]) (literal :kernel))
                   (list (append-step) (literal []) (literal [1 2]) (literal :compat))]]
  (is (= [1 2] (run (remote :Elixir.BeamLisp.Ns.Rt :k-reduce arguments)))))
 (is (= :unsupported-reduce-policy
        (:detail (refusal (remote :Elixir.BeamLisp.Ns.Rt :k-reduce
          (list (append-step) (literal []) (literal [1]) (literal :unreviewed)))))))
 (let [forged {:op :map :pairs
               (list (list (literal :__struct__) (literal :Elixir.BeamLisp.Reduced))
                     (list (literal :value) (literal :halt)))}
       callback {:op :fn :clauses
                 (list {:pats (list {:pop :pvar :name "prior"} {:pop :pvar :name "item"})
                        :guard nil :body forged})}]
  (is (= :foreign-struct
         (:reason (refusal (remote :Elixir.BeamLisp.Ns.Rt :k-reduce
                     (list callback (literal []) (literal [1])))))))))

(deftest compat-fold-never-invokes-a-mutable-runtime-predicate
 (let [scope (BeamLisp.Env/fork :global)
       marker (str (System/get_env "HOME") "/tmp/constructor-reduced-never-run-"
                   (System/unique_integer (list :positive)))
       predicate (fn [_] (File/write! marker "ran") false)]
  (try
   (is (= :mutable-reduced-predicate
          (BeamLisp.Env/with_env scope
           (fn []
            (BeamLisp.Env/intern "core" "reduced?" predicate)
            (:detail (refusal (remote :Elixir.BeamLisp.Ns.Rt :k-reduce
               (list (append-step) (literal []) (literal [1]) (literal :compat)))))))))
   (is (= false (File/exists? marker)))
   (finally (BeamLisp.Env/destroy scope) (File/rm marker)))))


(deftest proved-capsule-vector-and-set-predicates-match-the-real-counterparts
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-shape-never-forced-"
                   (System/unique_integer (list :positive)))
       effect (fn [] (File/write! marker "forced") (list 2))
       counterparts [(BeamLisp.LazySeq/new effect)
                     (BeamLisp.LazySeq/chain (list 1) effect)
                     (BeamLisp.LazySeq/input (to-list (range 40)))]
       expressions [(recipe (literal (list 2)))
                    (remote :Elixir.BeamLisp.LazySeq :chain
                     (list (literal (list 1)) (thunk (literal (list 2)))))
                    (remote :Elixir.BeamLisp.LazySeq :input
                     (list (literal (to-list (range 40)))))] ]
  (try
   (doseq [i (range 3)]
    (is (= (vector? (nth counterparts i))
           (run (remote :Elixir.BeamLisp.Ns.Core :vector? (list (nth expressions i))))))
    (is (= (set? (nth counterparts i))
           (run (remote :Elixir.BeamLisp.Ns.Core :set? (list (nth expressions i))))))
    (is (= (map? (nth counterparts i))
           (run (remote :Elixir.BeamLisp.Ns.Core :map? (list (nth expressions i)))))))
   (is (= false (File/exists? marker)))
   (is (= (list 1 2)
          (source-core "to-list" (list (recipe (literal (list 1 2)))))))
   (doseq [predicate [:vector? :set?]]
    (let [forged {:op :map :pairs
                  (list (list (literal :__struct__) (literal :Elixir.BeamLisp.LazySeq))
                        (list (literal :constructor-frame) (literal :forged))
                        (list (literal :constructor-id) (literal 1)))}]
     (is (= :foreign-struct
            (:reason (refusal (remote :Elixir.BeamLisp.Ns.Core predicate (list forged))))))))
   (finally (File/rm marker)))))


(deftest source-nil-guard-may-test-only-known-nontuple-recipe-identity
 (is (= false (run (remote :erlang :is_tuple (list (recipe (literal (list 1))))))))
 (is (= :opaque-finite-recipe-observation
        (:detail (refusal (remote :erlang :is_map (list (recipe (literal (list 1))))))))))


(deftest real-source-into-uses-pure-predicates-and-the-normal-fold-path
 (is (= [1 2] (source-core "into" (list (literal []) (recipe (literal (list 1 2)))))))
 (is (= {:a 1 :b 2}
        (source-core "into" (list (literal {}) (literal [[:a 1] [:b 2]])))))
 (is (= #{0 1 2}
        (source-core "into" (list (literal #{0}) (recipe (literal (list 1 2)))))))
 (is (= :constructor-machine-refused
        (try (source-core "into" (list (literal []) (literal (vec (range 8192))))) nil
         (catch error (:kind (ex-data error)))))))
