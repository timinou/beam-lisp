(ns aot-constructor-recipe-test)

(defn- literal [value] {:op :lit :val value})
(defn- remote [module function arguments]
 {:op :remote :mod module :fun function :args arguments})
(defn- thunk [body]
 {:op :fn :clauses (list {:pats (list) :guard nil :body body})})
(defn- recipe [body]
 (remote :Elixir.BeamLisp.LazySeq :new (list (thunk body))))
(defn- consume [expression]
 (remote :Elixir.BeamLisp.Ns.Core :to-list (list expression)))
(defn- run [expression] (BeamLisp.AOT/interpret_constructor! expression {} {}))
(defn- refusal [expression]
 (try (run expression) nil (catch error (ex-data error))))

(deftest interpreted-recipes-consume-finite-sequences-without-native-resources
 (doseq [value [nil (list) (list 1 2) [1 2] #{1 2} "é🙂"]]
  (is (= (to-list value) (run (consume (recipe (literal value)))))))
 (is (= 32 (run (remote :Elixir.BeamLisp.LazySeq :chunk_size (list)))))
 (is (= (list 1 2)
        (run (remote :Elixir.BeamLisp.LazySeq :cell (list (recipe (literal (list 1 2)))))))))

(deftest recipe-thunks-memoize-before-a-second-sequence-consumption
 (let [symbol (remote :Elixir.BeamLisp.Ns.Rt :gensym (list (literal "once")))
       make-list (remote :Elixir.BeamLisp.Ns.Core :list__bl_v
                   (list {:op :cons :head symbol :tail {:op :enil}}))
       first-read (remote :Elixir.BeamLisp.Ns.Core :first (list {:op :var :name "r"}))
       expression {:op :let :name "r" :init (recipe make-list)
                   :body (remote :erlang :=:= (list first-read first-read))}]
  ;; Re-executing the thunk would obtain two different VM-wide fresh symbols.
  (is (= true (run expression)))))

(deftest private-recipe-shape-and-field-observations-refuse
 (doseq [function [:list? :seq? :vector? :map? :get]]
  (let [arguments (if (= :get function)
                    (list (recipe (literal (list 1))) (literal :__struct__))
                    (list (recipe (literal (list 1)))))]
   (is (= :opaque-finite-recipe-observation
          (:detail (refusal (remote :Elixir.BeamLisp.Ns.Core function arguments)))))))
 (is (= :opaque-finite-recipe-observation
        (:detail (refusal
          {:op :apply :fn (literal :constructor-frame)
           :args (list (recipe (literal (list 1))))}))))
 (is (= :finite-recipe-escape (:detail (refusal (recipe (literal (list 1))))))))

(deftest recipe-forgery-and-native-callbacks-never-gain-execution-authority
 (let [marker (str (System/get_env "HOME") "/tmp/constructor-recipe-never-run-"
                   (System/unique_integer (list :positive)))
       effect (fn [] (File/write! marker "ran") (list 1))
       forged {:op :map :pairs
               (list (list (literal :__struct__) (literal :Elixir.BeamLisp.LazySeq))
                     (list (literal :constructor-frame) (literal :forged))
                     (list (literal :constructor-id) (literal 1)))}]
  (try
   (is (= :foreign-struct
          (:reason (refusal (consume forged)))))
   (is (= :unsafe-first-order-data
          (:kind (refusal (consume (remote :Elixir.BeamLisp.LazySeq :new (list (literal effect))))))))
   (is (= false (File/exists? marker)))
   (is (= :constructor-machine-refused
          (:kind (refusal (consume (recipe (remote :Elixir.File :write!
                                            (list (literal marker) (literal "bad")))))))))
   (is (= false (File/exists? marker)))
   (finally (File/rm marker)))))

(deftest finite-chain-and-cursor-materialization-never-invent-physical-cell-shapes
 (let [chain (remote :Elixir.BeamLisp.LazySeq :chain
               (list (literal (list 1 2)) (thunk (literal (list 3 4)))))
       input (remote :Elixir.BeamLisp.LazySeq :input (list (literal (vec (range 40)))))]
  (is (= (list 1 2 3 4) (run (consume chain))))
  (is (= (to-list (range 40)) (run (consume input))))
  (is (= :opaque-finite-recipe-cell-observation
         (:detail (refusal (remote :Elixir.BeamLisp.LazySeq :cell (list chain))))))
  (is (= :opaque-finite-recipe-cell-observation
         (:detail (refusal (remote :Elixir.BeamLisp.LazySeq :cell (list input))))))))

(deftest nested-recipes-and-large-realized-prefixes-have-explicit-bounds
 (let [deep (reduce (fn [tail _] (recipe tail)) (literal (list 1)) (range 66))]
  (is (= :finite-recipe-depth (:detail (refusal (consume deep))))))
 (is (= :collection-budget
        (:detail (refusal (consume (recipe (literal (String/duplicate "x" 16385)))))))))

(deftest finite-runtime-stack-guards-keep-the-selected-sorted-predicate-semantics
 (doseq [value [nil (list) [1] #{1} {} 'item]]
  (is (= (BeamLisp.Ns.Rt/sorted? value)
         (run (remote :Elixir.BeamLisp.Ns.Rt :sorted? (list (literal value))))))))


(deftest finite-recipes-cannot-be-reinterpreted-as-ordinary-cons-tails
 (is (= :opaque-finite-recipe-observation
        (:detail (refusal {:op :cons :head (literal :head)
                           :tail (recipe (literal (list 1 2)))}))))
 (is (= :finite-chain-prefix
        (:detail (refusal (consume
                   (remote :Elixir.BeamLisp.LazySeq :chain
                    (list (literal [1 2]) (thunk (literal (list 3)))))))))))
