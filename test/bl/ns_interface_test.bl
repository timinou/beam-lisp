; ns_interface_test.bl — what a dependent can observe of a namespace, pinned.
;
; The interface hash is the freshness key's answer to "did anything a caller
; can SEE change?". These tests pin, on hand-made sources and on the real
; prelude, the two properties the build depends on:
;
;   invariance     editing a fn body, a def value, a docstring, a comment or
;                  whitespace does NOT move the hash
;   sensitivity    adding/removing a name, changing an arity, making a var
;                  private, editing a MACRO (its body is inlined at callers),
;                  changing a protocol method, a defnative signature — DOES
;
; plus the coverage contract (`names`) and the reference scan
; (`source-graph/references`) the plan uses to decide, per edge, whether the
; interface may stand in for the content.
(ns ns-interface.test
  (:require [ns-interface :as ni] [source-graph :as sg] [build-plan :as bp]))

(def base
  "(ns x (:require [y]))
   ;; a comment
   (defn f \"doc\" [a b] (+ a b))
   (defn- g ([a] a) ([a & r] r))
   (defmacro m [q] `(inc ~q))
   (def v 1)
   (defrecord P [x y])
   (defprotocol Store (-get [s k] \"doc\") (-put [s k v]))
   (defnative \"crate\" (nat-a 1) (nat-b 2))
   (comment (defn hidden [] 1))")

(defn- with [& edits] (reduce (fn [s [from to]] (String/replace s from to)) base (partition 2 edits)))
(defn- same? [s] (= (ni/hash base) (ni/hash s)))

(deftest invariant-under-unobservable-edits
  (is (same? (with "(+ a b)" "(* a b 2)")) "fn body")
  (is (same? (with "(def v 1)" "(def v 99)")) "def value")
  (is (same? (with "\"doc\"" "\"other doc\"")) "docstring")
  (is (same? (with ";; a comment" ";; edited comment")) "comment")
  (is (same? (with "   " " ")) "whitespace")
  (is (same? (with "(comment (defn hidden [] 1))" "")) "a form inside (comment …)"))

(deftest sensitive-to-observable-edits
  (is (not (same? (with "[a b] (+ a b)" "[a b c] (+ a b)"))) "arity")
  (is (not (same? (with "(defn f" "(defn- f"))) "privacy")
  (is (not (same? (with "(def v 1)" ""))) "a name removed")
  (is (not (same? (str base "\n(defn extra [] 1)"))) "a name added")
  (is (not (same? (with "`(inc ~q)" "`(dec ~q)"))) "a macro body")
  (is (not (same? (with "(-put [s k v])" "(-put [s k])"))) "a protocol method arity")
  (is (not (same? (with "(nat-b 2)" "(nat-b 3)"))) "a defnative signature")
  (is (not (same? (with "(defrecord P [x y])" "(deftype P [x y])"))) "a kind"))

(deftest names-cover-every-observable-definition
  (is (= ["-get" "-put" "P" "Store" "f" "g" "m" "nat-a" "nat-b" "v"] (vec (ni/names base)))))

(deftest references-attribute-qualified-names
  (let [src "(ns d (:require [x :as xx] [y] [z :refer [za]] [w :refer :all]))
             ; xx/in-comment
             (defn h [] (xx/f 1) (x/g 2) (y/k 3) (za 4) (str \"xx/in-string\") {:k (xx/m 5)})"
        refs (sg/references src)]
    (is (= ["f" "g" "m"] (vec (get refs "x"))) "alias and full name both attribute to x")
    (is (= ["k"] (vec (get refs "y"))))
    (is (= ["za"] (vec (get refs "z"))) "an explicit :refer is a reference")
    (is (= [:all] (vec (get refs "w"))) ":refer :all is unattributable")))

(defn- node [path ns reqs src]
  (let [fs (sg/forms src)]
    {:path path :ns ns :reqs reqs :hash (sha256-hex src)
     :iface (ni/hash-forms fs) :inames (ni/names-forms fs) :refs (sg/references-forms fs)}))

(deftest plan-keys-on-interface-when-covered
  (let [x1 "(ns x)\n(defn f [a] a)\n(defmacro m [q] `(inc ~q))"
        x2 "(ns x)\n(defn f [a] (* a 2))\n(defmacro m [q] `(inc ~q))"
        x3 "(ns x)\n(defn f [a b] a)\n(defmacro m [q] `(inc ~q))"
        d "(ns d (:require [x :as xx]))\n(defn g [] (xx/f 1))"
        t "(ns t (:require [d]))\n(defn h [] (d/g))"
        u "(ns u (:require [x :refer :all]))\n(defn k [] (f 1))"
        keys-for (fn [xs] (:key (bp/plan (list (node "x" "x" [] xs) (node "d" "d" ["x"] d) (node "t" "t" ["d"] t) (node "u" "u" ["x"] u)))))
        k1 (keys-for x1) k2 (keys-for x2) k3 (keys-for x3)]
    (is (not= (get k1 "x") (get k2 "x")) "x's own key moves on any edit")
    (is (= (get k1 "d") (get k2 "d")) "body edit in x: direct dependent keeps its key")
    (is (= (get k1 "t") (get k2 "t")) "body edit in x: transitive dependent keeps its key")
    (is (not= (get k1 "u") (get k2 "u")) ":refer :all edge is uncovered → content key → rebuilds")
    (is (not= (get k1 "d") (get k3 "d")) "arity edit in x: dependent rebuilds")
    (is (not= (get k1 "t") (get k3 "t")) "arity edit in x: transitive dependent rebuilds")))

(deftest plan-without-interface-fields-is-the-closure-hash
  (let [x "(ns x)\n(defn f [a] a)" d "(ns d (:require [x]))\n(defn g [] (x/f 1))"
        plain (fn [p ns reqs src] {:path p :ns ns :reqs reqs :hash (sha256-hex src)})
        kp (:key (bp/plan (list (plain "x" "x" [] x) (plain "d" "d" ["x"] d))))]
    (is (= (get kp "d") (sg/closure-hash "d" (fn [n] (get {"x" (sha256-hex x) "d" (sha256-hex d)} n)) (fn [n] (get {"d" ["x"]} n []))))
        "no interface fields → byte-identical to the closure hash the runtime gate computes")))

(deftest real-prelude-body-edit-rebuilds-one
  (let [files (Enum/to_list (sort (Path/wildcard "priv/**/*.bl")))
        node-of (fn [p c] (let [fs (sg/forms c) [ns reqs] (sg/header-forms fs)]
                            {:path p :ns ns :reqs reqs :hash (sha256-hex c)
                             :iface (ni/hash-forms fs) :inames (ni/names-forms fs) :refs (sg/references-forms fs)}))
        nodes (Enum/to_list (map (fn [p] (node-of p (File/read! p))) files))
        k0 (:key (bp/plan nodes))
        rebuilds (fn [path edit]
                   (let [nodes2 (Enum/to_list (map (fn [n] (if (= (:path n) path) (node-of path (edit (File/read! path))) n)) nodes))
                         k1 (:key (bp/plan nodes2))]
                     (count (filter (fn [p] (not= (get k0 p) (get k1 p))) (keys k0)))))]
    (is (= 1 (rebuilds "priv/lib/datom/store.bl" (fn [s] (str s "\n;; touched\n")))) "datom.store body edit → 1 (was 35)")
    (is (= 1 (rebuilds "priv/lib/datom/vector.bl" (fn [s] (str s "\n;; touched\n")))) "datom.vector body edit → 1 (was 24)")
    (is (> (rebuilds "priv/lib/datom/store.bl" (fn [s] (str s "\n(defn zz [a] a)\n"))) 20) "datom.store interface edit → its dependents")))
