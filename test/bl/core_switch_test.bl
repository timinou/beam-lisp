; core_switch_test.bl — the backend switch routes defvar through Core (S-D).
;
; S-D part 1 proved core-defvar-anf builds defns directly. This proves the
; SWITCH end-to-end: with the process backend key = :core, an ordinary defn
; compiled through the normal pipeline (eval_string → eval_form → Link.defvar)
; is built by the Core Erlang backend and returns a working fn; with the key
; unset it uses the Elixir path. eval_string uses a throwaway env, so we call
; the RETURNED fn value rather than the namespace module.

(ns core-switch.test)

(defn- ev [src] (BeamLisp.Compiler/eval_string src))

(deftest switch-routes-through-core
  (testing "with :bl_backend = :core, a defn built via the normal pipeline works"
    (Process/put :bl_backend :core)
    (try
      (let [f (ev "(defn csw-triple [n] (* n 3))")
            g (ev "(defn csw-sum ([xs] (reduce + 0 xs)))")]
        (is (= 30 (f 10)))
        (is (= 15 (g [1 2 3 4 5]))))
      (finally (Process/put :bl_backend :elixir)))))

(deftest default-is-elixir
  (testing "with the key unset, defvar uses the Elixir path and returns a working fn"
    (Process/put :bl_backend :elixir)
    (let [f (ev "(defn csw-dbl [n] (* n 2))")]
      (is (= 14 (f 7))))))

(run-tests)
