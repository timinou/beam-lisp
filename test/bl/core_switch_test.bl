; core_switch_test.bl — canonical backend readiness and no-fallback gates.

(ns core-switch.test (:require [compiler :as c] [lower :as sc]))
(def kenv (assoc (c/new-env "user") :ns "user"))
(def ctr (atom 0))
(defn- compile-anf [src] (c/compile (BeamLisp.Reader/read_one src) kenv))
(defn- eval-direct [src]
  (sc/eval-anf (erlang/binary_to_atom (str "bl_csw_" (swap! ctr inc)))
               (compile-anf src)))

(deftest backend-is-ready
  (testing "public compile returns ANF accepted directly by the Core backend"
    (let [n (compile-anf "(let [x 10] (* x 3))")]
      (is (map? n)) (is (keyword? (:op n)))
      (is (= 30 (sc/eval-anf :bl_csw_ready n))))))

(deftest direct-backend-has-no-fallback
  (testing "canonical lowering and eval_core execute without backend process flags"
    (is (= 15 (eval-direct "(reduce + 0 [1 2 3 4 5])")))
    (is (= :timeout (eval-direct "(receive [:never x] x (after 1 :timeout))")))))

(deftest closure-behavior-through-direct-backend
  (testing "a directly lowered canonical closure captures its environment"
    (let [f (eval-direct "(let [k :kept] (fn [x] [k x]))")]
      (is (= [:kept 7] (f 7)))
      (is (= [:kept 9] (f 9))))))

(run-tests)
