; drop_format_test.bl — the drop COMPOUND codec: `launcher ⊕ payload ⊕ trailer`,
; read and re-emitted by the language.
;
; Ported from the ExUnit `test/beam_lisp/build_drop_test.exs`, which ran through
; the Elixir façade `BeamLisp.Drop`. The calls go straight to
; `priv/build/drop.bl` — `d/parse-trailer`, `d/encode-trailer`, `d/compound`,
; `d/verify`, `d/target`, `d/sha256-hex-of` — with no interop boundary in the
; path, so the bl shapes are read directly: the trailer is a map with keyword
; keys, the compound a map of maps.
;
; The oracle is the Rust tool's own output. `golden-trailer` is the last 56
; bytes of a real `drop pack` compound; the suite pins that we parse those
; fields and that re-encoding them gives the SAME 56 bytes. A golden vector
; copied by hand into the codec's own format would only prove we are
; self-consistent; bytes the packer produced prove we are compatible.
;
; Everything else here is the failure half: a file that is not a drop, a
; truncated one, and a corrupted payload must be told apart, because a launcher
; has to decide whether to run, re-fetch, or complain.
;
; The last test uses a real drop when one happens to be on this machine — the
; repo's root `bl`, or wherever BL_COMPOUND points — and DISCLOSES the skip
; otherwise: the golden vectors above need no file, so the absence of one is
; never silent.
;
; Run: bin/bl test test/bl/drop_format_test.bl

(ns drop-format.test
  (:require [drop :as d]))

; The trailer of a `drop pack` output (payload 1801b898…):
;   offset 810104, len 103013141, os 0 (linux), arch 0 (x86_64), version 1
(def golden-trailer "785c0c000000000015db230600000000cbe87a0933e34c2a20ad25e83765a0f6964347d9b6d96d7a25ae7a27d0220c870000010044525031")
(def golden-sha "cbe87a0933e34c2a20ad25e83765a0f6964347d9b6d96d7a25ae7a27d0220c87")
(def golden-offset 810104)
(def golden-len 103013141)

; A scratch tree unique per file load: two files (or two runs) never share it,
; and a leftover from a killed run cannot be adopted.
(def fixture-root
  (str (System/tmp_dir!) "/bl_drop_format_test_"
       (erlang/unique_integer (list :positive))))

; Where a real drop lives, when one happens to be on this machine: a worktree
; has no `bl` of its own, so BL_COMPOUND wins when it is set.
(def real
  (or (System/get_env "BL_COMPOUND")
      (Path/join (File/cwd!) "bl")))

; ── helpers ──────────────────────────────────────────────────────────────────

(defn- fresh! []
  (File/rm_rf! fixture-root)
  (File/mkdir_p! fixture-root))

(defn- fixture [name] (Path/join fixture-root name))

; `Base.decode16!/1` is uppercase by default; the golden vectors are written
; lowercase, so upcase rather than pass an option list through the interop call.
(defn- hex->bytes [hex] (Base/decode16! (String/upcase hex)))

(defn- write-temp [text]
  (let [p (fixture (str "slice-" (erlang/byte_size text)))]
    (File/write! p text)
    p))

(defn- beam-lisp-sha
  "The streaming hasher's answer, the same path `verify` hashes the payload by."
  [text]
  (d/sha256-hex-of (write-temp text) 0 (erlang/byte_size text)))

(defn- trailer-for [offset len sha-hex]
  (d/encode-trailer {:offset offset :len len
                     :sha (hex->bytes sha-hex) :os 0 :arch 0}))

; ── the trailer ──────────────────────────────────────────────────────────────

(deftest a-real-trailer-decodes-to-its-fields-and-re-encodes-to-the-same-bytes
  (let [golden (hex->bytes golden-trailer)]
    (is (= 56 (erlang/byte_size golden)))

    (let [t (d/parse-trailer golden)]
      (is (= golden-offset (:offset t)))
      (is (= golden-len (:len t)))
      (is (= 0 (:os t)))
      (is (= 0 (:arch t)))
      (is (= 1 (:version t)))
      (is (= golden-sha (String/downcase (Base/encode16 (:sha t)))))
      (is (= "linux/x86_64" (d/target t)))

      ; The acceptance in one line: the bytes we would WRITE for these fields
      ; are the bytes the Rust packer wrote.
      (is (= golden (d/encode-trailer t))))))

; ── not a drop ───────────────────────────────────────────────────────────────

(deftest a-file-that-is-not-a-drop-is-nil-not-an-exception
  (fresh!)
  (let [path (fixture "plain")]
    (File/write! path (crypto/strong_rand_bytes 4096))

    (is (nil? (d/compound path)))
    (is (= false (:ok? (d/verify path))))
    (is (includes? (:reason (d/verify path)) "not a v1 drop"))

    ; Too short to hold a trailer at all — the other way to not be a drop.
    (let [short (fixture "short")]
      (File/write! short "too small")
      (is (nil? (d/compound short))))))

; ── truncation vs corruption ─────────────────────────────────────────────────

(deftest verification-tells-truncation-from-corruption
  (fresh!)
  (let [payload "hello payload"
        sha (d/sha256-hex-of "/dev/null" 0 0)]
    (is (erlang/is_binary sha) "hashing an empty slice must work")

    ; A synthesised compound: 3 bytes of launcher, a payload, our own trailer.
    (let [launcher "LCH"
          digest (beam-lisp-sha payload)
          good (fixture "good.bl")
          trailer (trailer-for (erlang/byte_size launcher) (erlang/byte_size payload) digest)]
      (File/write! good (str launcher payload trailer))

      (let [c (d/compound good)]
        (is (= (+ (erlang/byte_size launcher) (erlang/byte_size payload) 56) (:size c)))
        (is (= (erlang/byte_size launcher) (get-in c [:launcher :len])))
        (is (= (erlang/byte_size launcher) (get-in c [:payload :offset]))))

      (let [v (d/verify good)]
        (is (:ok? v) (str "a well-formed compound must verify: " (pr-str v)))
        (is (= digest (:expected v)))
        (is (= digest (:actual v))))

      ; Truncated: the trailer is gone, so the arithmetic is what fails — and
      ; the payload's digest is never even reached. The trailer is re-appended
      ; so the compound still parses and only the arithmetic is wrong.
      (let [cut (fixture "cut.bl")]
        (File/write! cut (str (binary/part (File/read! good) 0
                                           (+ (erlang/byte_size launcher) 4))
                              trailer))
        (let [vcut (d/verify cut)]
          (is (not (:ok? vcut)))
          (is (= false (:arithmetic vcut)))
          (is (includes? (:reason vcut) "does not equal the file size"))))

      ; Corrupted: the length is right, the bytes are not. A verifier that only
      ; checked the arithmetic would run this.
      (let [bad (fixture "bad.bl")]
        (File/write! bad (str launcher "HELLO payload" trailer))
        (let [vbad (d/verify bad)]
          (is (not (:ok? vbad)))
          (is (= true (:arithmetic vbad)))
          (is (includes? (:reason vbad) "digest does not match")))))))

; ── a real drop, when there is one ───────────────────────────────────────────

(deftest a-real-compound-on-this-machine-verifies-end-to-end
  (if (File/exists? real)
    (let [c (d/compound real)]
      (is (not (nil? c)) (str real " exists but does not read as a drop"))
      (is (= (:size c) (+ (get-in c [:payload :offset]) (get-in c [:payload :len]) 56)))

      ; ~100 MB of payload, streamed in 1 MB chunks and compared with the
      ; digest the packer stored.
      (let [v (d/verify real)]
        (is (:ok? v) (str "verify failed: " (pr-str v)))
        (is (= "linux/x86_64" (:target v)))
        (is (= (erlang/byte_size (File/read! real)) (:size v)))))

    ; The golden vectors need no file; failing here would be a false alarm and
    ; passing silently would be a lie, so the suite says which it is.
    (do
      (println (str "drop_format_test: no real compound at " real
                    "; set BL_COMPOUND to check one"))
      (is true))))
