; host_web_socket_test.bl — the pinned `BeamLisp.WebSocket` adapter.
;
; `priv/host/web_socket.bl` replaces `lib/beam_lisp/web_socket.ex` at its exact
; module atom `Elixir.BeamLisp.WebSocket`, FUNCTIONS-ONLY: the five WebSock
; callbacks (`init/1` `handle_in/2` `handle_info/2` `terminate/2`) plus `wrap/2`.
;
; The pinned source is compiled at its OWN probe atom with `:behaviour WebSock`,
; the namespace shim beside it is dropped, and the pinned beam is loaded ALONE —
; so a leftover shim reference would be `undef` here. Every public callback is
; then DIFFED against the live `Elixir.BeamLisp.WebSocket` on the same inputs,
; including the cases a bl handler actually produces: a missing (or `nil`)
; handler, an inbound frame tuple, vector result messages, single-frame vs
; frame-list pushes, `:reply`/string-tagged results, bare and malformed result
; values, `terminate`, normalized handler keys, and wrong types that must raise
; the same exception class the reference raises.
;
; Run: bin/bl test test/bl/host_web_socket_test.bl

(ns host.web-socket.test)

(def ^:private live :Elixir.BeamLisp.WebSocket)
(def ^:private probe-mod :Elixir.BeamLisp.HostWebSocketProbe)
(def ^:private shim :Elixir.BeamLisp.Ns.Host.WebSocket)

(defn- t2 [k v] (erlang/list_to_tuple (list k v)))

(defn- tmp-dir []
  (str (System/tmp_dir!) "/bl_host_ws_" (erlang/unique_integer (list :positive))))

(defn- source [] (Path/join (BeamLisp/cwd) "priv/host/web_socket.bl"))

(defn- pin!
  "Compile the pinned source at `probe-mod` (with the WebSock behaviour recorded)
   and load ONLY the pinned beam: the compile's own load, and the namespace shim
   it built beside it, are dropped first."
  []
  (let [dir (tmp-dir)
        res (BeamLisp.AOT/compile_host_file (source)
              (list (t2 :module probe-mod)
                    (t2 :output_dir dir)
                    (t2 :load? false)
                    (t2 :behaviour :"Elixir.WebSock")))
        path (elem res 1)]
    (do (code/purge probe-mod)
        (code/delete probe-mod)
        (code/purge shim)
        (code/delete shim)
        (code/load_binary probe-mod (erlang/binary_to_list path) (File/read! path))
        probe-mod)))

(defn- drop-ns!
  "Remove EVERY `host.web-socket` definition from this VM's `Env` — the namespace
   the pinned compile INTERNS while it evals the source, which a fresh boot does
   not have. Dropping the shim MODULE (as `pin!` does) is not enough: a helper
   that reached its neighbour through `Env/fetch!(\"host.web-socket\", …)` still
   found the var here and answered, which is exactly how this file passed 88
   assertions while `test/bl/live/web_test.bl` failed on a fresh boot. Delete the
   vars and the mask is gone."
  []
  (doseq [name (maps/keys (BeamLisp.Env/ns_defs "host.web-socket"))]
    (BeamLisp.Env/undefine_var "host.web-socket" name)))

(defn- ns-var-gone?
  "Whether `host.web-socket/normalize-msg` is ABSENT — i.e. the pinned beam can
   no longer reach a helper through its namespace."
  []
  (= (list :raise :Elixir.RuntimeError)
     (obs (fn [] (BeamLisp.Env/fetch! "host.web-socket" "normalize-msg")))))

(defn- ns-snapshot
  "A namespace's whole binding set, so a scoped removal can be undone.
   `undefine_var` drops the value, its LINK and its `ns_defs` row — restoring
   fewer than all three would leave a namespace that looks present and is not."
  [ns]
  (let [defs (BeamLisp.Env/ns_defs ns)]
    (tuple defs
           (Enum/map (maps/keys defs)
                     (fn [name]
                       (tuple name
                              (BeamLisp.Env/fetch! ns name)
                              (BeamLisp.Env/link ns name)))))))

(defn- restore-ns! [ns snap]
  (doseq [e (erlang/element 2 snap)]
    (let [name (erlang/element 1 e)
          value (erlang/element 2 e)
          link (erlang/element 3 e)]
      (BeamLisp.Env/intern ns name value)
      (if (nil? link) :ok (BeamLisp.Env/put_link ns name link))))
  (BeamLisp.Env/put_ns_defs ns (erlang/element 1 snap))
  :ok)

;; a text/binary frame as WebSock delivers it: {payload, [opcode: :text]}
(defn- frame [opcode payload]
  (erlang/list_to_tuple
    (list payload (list (erlang/list_to_tuple (list :opcode opcode))))))

;; A call, normalized so a raise is a value: [:value v] | [:raise Class].
(defn- obs [run]
  (try (list :value (run))
       (catch e (list :raise (:__struct__ e)))))

;; Run the SAME closure against the live module and the pinned probe, and
;; compare the normalized outcomes. The handler map is built once by the caller
;; and handed to both, so the fun references — and thus the wrap maps — are the
;; same term on either side.
(defn- parity [run]
  (= (obs (fn [] (run live))) (obs (fn [] (run probe-mod)))))

(defn- call-init [M h st] (erlang/apply M :init (list (erlang/apply M :wrap (list h st)))))
(defn- call-in [M h st fr] (erlang/apply M :handle_in (list fr (erlang/apply M :wrap (list h st)))))
(defn- call-info [M h st msg] (erlang/apply M :handle_info (list msg (erlang/apply M :wrap (list h st)))))
(defn- call-term [M h st r] (erlang/apply M :terminate (list r (erlang/apply M :wrap (list h st)))))
(defn- call-wrap [M h st] (erlang/apply M :wrap (list h st)))

; ── the pinned module surface ────────────────────────────────────────────

(deftest pinned-module-surface
  (testing "compiled alone at the caller's atom, exporting the WebSock callbacks"
    (pin!)
    (is (= :non_existing (erlang/apply :code :which (list shim)))
        "the namespace shim is gone; the pinned beam answers")
    (is (erlang/function_exported probe-mod :init 1))
    (is (erlang/function_exported probe-mod :handle_in 2))
    (is (erlang/function_exported probe-mod :handle_info 2))
    (is (erlang/function_exported probe-mod :terminate 2))
    (is (erlang/function_exported probe-mod :wrap 2))
    ; the `:behaviour` option rides through to the emitted module: WebSock's
    ; callbacks ARE this module's contract. (The emitter records the bare module
    ; atom where a `defmodule` writes `[Mod]`; the MODULE is what matters.)
    (let [bhv (first (filter (fn [a] (= :behaviour (erlang/element 1 a)))
                             (erlang/apply probe-mod :module_info (list :attributes))))
          mod-of (fn [v] (if (erlang/is_list v) (first v) v))]
      (is (some? bhv) "a -behaviour attribute rides through")
      (is (= :"Elixir.WebSock" (mod-of (erlang/element 2 bhv)))))))

; ── wrap/2: handler-key normalization ────────────────────────────────────

(deftest wrap-normalizes-handler-keys
  (testing "atom, hyphenated, string and integer keys all cross to strings"
    (pin!)
    (let [fi (fn [s] s)
          fh (fn [f s] s)
          h {:init fi :handle-in fh "extra" 3}
          w (call-wrap probe-mod h 42)
          hs (maps/get :handlers w)]
      (is (= (list "extra" "handle-in" "init") (Enum/sort (maps/keys hs))))
      (is (= fi (maps/get "init" hs)))
      (is (= fh (maps/get "handle-in" hs)))
      (is (= 3 (maps/get "extra" hs)))
      (is (= 42 (maps/get :state w)))
      ; a handler map whose key already crossed as a string is untouched
      (let [hs2 (maps/get :handlers (call-wrap probe-mod {"handle-in" fh} 0))]
        (is (= (list "handle-in") (maps/keys hs2)))
        (is (= fh (maps/get "handle-in" hs2))))
      ; and it agrees with the live module key for key, value for value
      (is (parity (fn [M] (call-wrap M h 42))))
      (is (parity (fn [M] (call-wrap M {"handle-in" fh} 0)))))))

; ── init/1 ───────────────────────────────────────────────────────────────

(deftest init-parity
  (testing "missing handler, every result shape, and bare values"
    (pin!)
    (let [h-missing {}
          h-nil {:init nil}
          h-ok {:init (fn [s] [:ok (+ s 1)])}
          h-push {:init (fn [s] [:push [[:text "hi"]] s])}
          h-reply {:init (fn [s] [:reply :ignored [[:text "x"]] s])}
          h-stop {:init (fn [s] [:stop :normal s])}
          h-bare {:init (fn [s] :signalled)}
          h-str {:init (fn [s] ["push" [["text" "hi"]] s])}]
      (is (parity (fn [M] (call-init M h-missing 42))))
      (is (parity (fn [M] (call-init M h-nil 42))))
      (is (parity (fn [M] (call-init M h-ok 0))))
      (is (parity (fn [M] (call-init M h-push nil))))
      (is (parity (fn [M] (call-init M h-reply 3))))
      (is (parity (fn [M] (call-init M h-stop 9))))
      (is (parity (fn [M] (call-init M h-bare 7))))
      (is (parity (fn [M] (call-init M h-str 1))))
      ; pinned answers, not merely probe == live
      (let [r (call-init probe-mod h-push nil)]
        (is (= :push (erlang/element 1 r)))
        (is (= (list (erlang/list_to_tuple (list :text "hi"))) (erlang/element 2 r)))
        (is (= nil (maps/get :state (erlang/element 3 r)))))
      (is (= :stop (erlang/element 1 (call-init probe-mod h-stop 9))))
      (is (= :normal (erlang/element 2 (call-init probe-mod h-stop 9))))
      (is (= :signalled (maps/get :state (erlang/element 2 (call-init probe-mod h-bare 7))))))))

; ── handle_in/2 ──────────────────────────────────────────────────────────

(deftest handle-in-parity
  (testing "missing handler, tuple frames, frame vectors, single vs list pushes"
    (pin!)
    (let [h-echo {:handle-in (fn [fr s] [:push [[:text (str "echo:" (nth fr 1))]] s])}
          h-shape {:handle-in (fn [fr s] [:ok [fr (vector? fr) (nth fr 0) (nth fr 1)]])}
          h-single {:handle-in (fn [fr s] [:push [:text "solo"] s])}
          h-ping {:handle-in (fn [fr s] [:push [[:ping "p"] [:pong "q"]] s])}
          h-nonframe {:handle-in (fn [fr s] [:push [:foo "bar"] s])}]
      (is (parity (fn [M] (call-in M {} nil (frame :text "anything")))))
      (is (parity (fn [M] (call-in M h-echo 0 (frame :text "yo")))))
      (is (parity (fn [M] (call-in M h-echo 0 (frame :binary (erlang/list_to_binary (list 1 2 3)))))))
      (is (parity (fn [M] (call-in M h-shape nil (frame :text "shape")))))
      (is (parity (fn [M] (call-in M h-single nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-ping nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-nonframe nil (frame :text "x")))))
      ; the inbound frame is a beam-lisp VECTOR [opcode payload]
      (let [r (call-in probe-mod h-shape nil (frame :text "shape"))
            st (maps/get :state (erlang/element 2 r))]
        (is (vector? st))
        (is (vector? (nth st 0)))
        (is (= true (nth st 1)))
        (is (= :text (nth st 2)))
        (is (= "shape" (nth st 3))))
      ; and a single frame vector becomes a one-element message list
      (is (= (list (erlang/list_to_tuple (list :text "solo")))
             (erlang/element 2 (call-in probe-mod h-single nil (frame :text "x"))))))))

; ── malformed frames ─────────────────────────────────────────────────────

(deftest handle-in-refuses-a-malformed-frame
  (testing "a frame that is not {payload, [opcode: op]} raises FunctionClauseError"
    (pin!)
    (is (parity (fn [M] (call-in M {} nil :not-a-frame))))
    (is (parity (fn [M] (call-in M {} nil (erlang/list_to_tuple (list "p" (list)))))))
    (is (parity (fn [M] (call-in M {} nil
                    (erlang/list_to_tuple
                      (list "p" (list (erlang/list_to_tuple (list :nope :text)))))))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-in probe-mod {} nil :not-a-frame)))))))

; ── handle_info/2 ────────────────────────────────────────────────────────

(deftest handle-info-parity
  (testing "missing handler keeps the connection; a handler pushes"
    (pin!)
    (let [h {:handle-info (fn [msg s] [:push [[:text (str "info:" msg)]] (+ s 1)])}]
      (is (parity (fn [M] (call-info M {} 5 :anything))))
      (is (parity (fn [M] (call-info M h 5 :hello))))
      (let [r (call-info probe-mod h 5 :hello)]
        (is (= :push (erlang/element 1 r)))
        (is (= (list (erlang/list_to_tuple (list :text "info:hello"))) (erlang/element 2 r)))
        (is (= 6 (maps/get :state (erlang/element 3 r))))))))

; ── terminate/2 ──────────────────────────────────────────────────────────

(deftest terminate-parity
  (testing "no handler is :ok; a handler's value is ignored unless falsy"
    (pin!)
    (is (parity (fn [M] (call-term M {} 1 :shutdown))))
    (is (parity (fn [M] (call-term M {:terminate (fn [r s] :ok)} 1 :shutdown))))
    (is (parity (fn [M] (call-term M {:terminate (fn [r s] 99)} 1 :shutdown))))
    (is (parity (fn [M] (call-term M {:terminate (fn [r s] nil)} 1 :shutdown))))
    (is (parity (fn [M] (call-term M {:terminate (fn [r s] false)} 1 :shutdown))))
    (is (= :ok (call-term probe-mod {} 1 :shutdown)))
    (is (= :ok (call-term probe-mod {:terminate (fn [r s] 99)} 1 :shutdown)))
    (is (nil? (call-term probe-mod {:terminate (fn [r s] nil)} 1 :shutdown)))
    (is (= false (call-term probe-mod {:terminate (fn [r s] false)} 1 :shutdown)))))

; ── result shapes and wrong types ────────────────────────────────────────

(deftest result-shape-and-wrong-type-parity
  (testing "bare, malformed, unknown-tag and wrongly-typed bl results"
    (pin!)
    (let [h-bare {:handle-in (fn [fr s] :just-a-state)}
          h-int {:handle-in (fn [fr s] 7)}
          h-unknown {:handle-in (fn [fr s] [:nope s])}
          h-short {:handle-in (fn [fr s] (BeamLisp.Vector/new (list :ok)))}
          h-str-ok {:handle-in (fn [fr s] ["ok" s])}
          h-str-reply {:handle-in (fn [fr s] ["reply" :t [[:text "y"]] s])}
          h-bad-stop {:handle-in (fn [fr s] [:stop 42 s])}
          h-bad-op {:handle-in (fn [fr s] [:push [[1 "x"]] s])}
          h-bare-msg {:handle-in (fn [fr s] [:push :oops s])}]
      (is (parity (fn [M] (call-in M h-bare nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-int nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-unknown nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-short nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-str-ok nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-str-reply nil (frame :text "x")))))
      ; wrong types raise the SAME class the reference raises
      (is (parity (fn [M] (call-in M h-bad-stop nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-bad-op nil (frame :text "x")))))
      (is (parity (fn [M] (call-in M h-bare-msg nil (frame :text "x")))))
      (is (= [:raise :Elixir.FunctionClauseError]
             (obs (fn [] (call-in probe-mod h-bad-stop nil (frame :text "x"))))))
      (is (= [:raise :Elixir.FunctionClauseError]
             (obs (fn [] (call-in probe-mod h-bad-op nil (frame :text "x"))))))
      ; a bare value IS the new state
      (is (= :just-a-state (maps/get :state (erlang/element 2 (call-in probe-mod h-bare nil (frame :text "x"))))))
      (is (= 7 (maps/get :state (erlang/element 2 (call-in probe-mod h-int nil (frame :text "x")))))))))


; ── callbacks refuse a state that is not the wrap ────────────────────────

(deftest callbacks-refuse-a-non-map-state
  (testing "a state without `%{handlers: …}` raises FunctionClauseError as the head did"
    (pin!)
    (is (parity (fn [M] (erlang/apply M :init (list 42)))))
    (is (parity (fn [M] (erlang/apply M :init (list {:state 1})))))
    (is (parity (fn [M] (erlang/apply M :handle_in (list (frame :text "x") :not-a-map)))))
    (is (parity (fn [M] (erlang/apply M :handle_info (list :msg "nope")))))
    (is (parity (fn [M] (erlang/apply M :terminate (list :shutdown {:no :handlers})))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (erlang/apply probe-mod :init (list 42))))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (erlang/apply probe-mod :handle_info (list :msg "nope"))))))))

; ── wrap/2 wrong types ───────────────────────────────────────────────────

(deftest wrap-refuses-wrong-types
  (testing "a non-map, and a struct, raise FunctionClauseError as the guard did"
    (pin!)
    (is (parity (fn [M] (call-wrap M 42 nil))))
    (is (parity (fn [M] (call-wrap M nil nil))))
    (is (parity (fn [M] (call-wrap M "handlers" nil))))
    (is (parity (fn [M] (call-wrap M (BeamLisp.Vector/new (list :init (fn [s] s))) nil))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-wrap probe-mod 42 nil)))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-wrap probe-mod (BeamLisp.Vector/new (list)) nil)))))))

; ── the pinned beam stands alone: no `host.web-socket` namespace at all ──

(deftest pinned-callbacks-stand-alone-without-the-namespace
  (testing "helper-to-helper calls are MODULE calls, so a bare image still answers"
    (pin!)
    (let [snap (ns-snapshot "host.web-socket")]
     (try
    (drop-ns!)
    ; PRECONDITION: the namespace the compile interned is gone. A helper that
    ; resolved through `host.web-socket/normalize-msg` raises HERE — which is
    ; what a fresh boot did, and why no assertion below may lean on `parity`:
    ; the seeded LIVE beam is that same pre-fix generation until it is reseeded.
    (is (= 0 (erlang/map_size (BeamLisp.Env/ns_defs "host.web-socket"))))
    (is (ns-var-gone?))

    ; THE `Enum/map` MAPPER PATH: a push of TWO messages maps message by
    ; message. This is the reference that was captured as a VALUE, so it is the
    ; one that lived or died on the namespace var.
    (let [h-push {:init (fn [s] [:push [[:text "hi"] [:ping "p"]] s])}
          r (call-init probe-mod h-push nil)]
      (is (= :push (erlang/element 1 r)))
      (is (= (list (t2 :text "hi") (t2 :ping "p")) (erlang/element 2 r)))
      (is (nil? (maps/get :state (erlang/element 3 r)))))

    ; ... and through `handle_in`, with a second frame OP beside the text one.
    (let [h-echo {:handle-in (fn [fr s] [:push [[:text (str "echo:" (nth fr 1))]
                                                [:pong "q"]] s])}
          r (call-in probe-mod h-echo 0 (frame :text "yo"))]
      (is (= :push (erlang/element 1 r)))
      (is (= (list (t2 :text "echo:yo") (t2 :pong "q")) (erlang/element 2 r)))
      (is (= 0 (maps/get :state (erlang/element 3 r)))))

    ; a string operator and a string result tag take the SAME map path.
    (let [r (call-in probe-mod {:handle-in (fn [fr s] ["push" [["text" "y"]] s])}
                     nil (frame :text "x"))]
      (is (= :push (erlang/element 1 r)))
      (is (= (list (t2 :text "y")) (erlang/element 2 r))))

    ; a single 2-element frame vector is ONE frame (`frame-op?`), not two.
    (let [r (call-in probe-mod {:handle-in (fn [fr s] [:push [:text "solo"] s])}
                     nil (frame :text "x"))]
      (is (= (list (t2 :text "solo")) (erlang/element 2 r))))

    ; a 2-element message whose op is not a frame op is the mapper's `other`
    ; clause: `as-list` answered the pair, and each half comes back unchanged.
    (let [r (call-in probe-mod {:handle-in (fn [fr s] [:push [:foo "bar"] s])}
                     nil (frame :text "x"))]
      (is (= :push (erlang/element 1 r)))
      (is (= (list :foo "bar") (erlang/element 2 r))))

    ; WRONG SHAPES, from a bare image: same class, same place.
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-in probe-mod {:handle-in (fn [fr s] [:push [[1 "x"]] s])}
                             nil (frame :text "x"))))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-in probe-mod {:handle-in (fn [fr s] [:stop 42 s])}
                             nil (frame :text "x"))))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-in probe-mod {} nil :not-a-frame)))))
    (is (= [:raise :Elixir.FunctionClauseError]
           (obs (fn [] (call-wrap probe-mod 42 nil)))))

    ; WRAP: the handler-key normalization every callback rests on.
    (let [fi (fn [s] s)
          fh (fn [f s] s)
          w (call-wrap probe-mod {:init fi :handle-in fh "extra" 3} 7)
          hs (maps/get :handlers w)]
      (is (= (list "extra" "handle-in" "init") (Enum/sort (maps/keys hs))))
      (is (= fi (maps/get "init" hs)))
      (is (= fh (maps/get "handle-in" hs)))
      (is (= 3 (maps/get "extra" hs)))
      (is (= 7 (maps/get :state w))))
     ; the removal was SCOPED: the namespace this VM had is back, so a later
     ; file in the same image is not left without it.
     (finally (restore-ns! "host.web-socket" snap))))))
