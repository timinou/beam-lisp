(ns core-native-path.test)

(deftest nested-lookup-crosses-native-record-fields-without-conflating-nil-and-absence
  (let [uri (URI/parse "https://example.test/flow")
        relative (URI/parse "/flow")]
    (is (= "/flow" (get uri :path)))
    (is (= "/flow" (get-in uri [:path] :missing)))
    (is (= "https" (get-in {:response uri} [:response :scheme] :missing)))
    (is (= "/flow" (get-in [uri] [0 :path] :missing)))
    (is (nil? (get-in relative [:scheme] :missing)))
    (is (= :missing (get-in relative [:unknown-field] :missing)))
    (is (= :missing (get-in {:response relative} [:response :scheme :nested] :missing)))
    (is (= uri (get-in uri [] :missing)))
    (is (nil? (get-in {:present nil} [:present] :missing)))
    (is (= :missing (get-in nil [:unknown] :missing)))))
