; test/bl/prelude_test.bl — the prelude, tested in beam-lisp itself.
; Run: mix beam_lisp.test test/bl/prelude_test.bl

(ns prelude.test)

; --- map / filter / reduce / range ---

(deftest map-core
  (is (= (map inc [1 2 3]) '(2 3 4)))
  (is (= (map (fn [x] (* x x)) [1 2 3]) '(1 4 9)))
  (is (= (map str [1 2]) '("1" "2")))
  ; map is lazy; an empty result is an empty lazy seq, which is `()`.
  ; (Structural `=` also says an empty lazy seq equals `[]`, but the value
  ; it realizes to is `()` — the Clojure-model empty seq.)
  (is (= (map inc []) ())))

(deftest filter-core
  (is (= (filter (fn [x] (> x 2)) [1 2 3 4]) '(3 4)))
  (is (= (filter (fn [x] (< x 4)) [1 2 3 4 5 6]) '(1 2 3)))
  ; an empty filter result is an empty lazy seq `()`, not a `[]` vector
  (is (= (filter (fn [_] true) []) ())))

(deftest reduce-core
  (is (= (reduce (fn [acc x] (+ acc x)) 0 [1 2 3 4]) 10))
  (is (= (reduce (fn [acc x] (* acc x)) 1 [1 2 3 4]) 24))
  (is (= (reduce (fn [acc x] (conj acc x)) [] [1 2 3]) [1 2 3])))

(deftest range-core
  (is (= (range 5) '(0 1 2 3 4)))
  (is (= (range 2 6) '(2 3 4 5)))
  (is (= (range 0 0) '()))
  (is (= (count (range 10)) 10)))

; --- conj / assoc ---

(deftest conj-core
  (is (= (conj '(2 3) 1) '(1 2 3)))
  (is (= (conj [1 2] 3) [1 2 3]))
  (is (= (conj nil 1) '(1))))

(deftest assoc-core
  ; assoc has no prelude name yet — the operations are tested through
  ; their interop homes: Map/put for maps, Vector/assoc for vectors.
  (is (= (Map/put {} :a 1) {:a 1}))
  (is (= (Map/put {:a 1} :b 2) {:a 1 :b 2}))
  (is (= (BeamLisp.Vector/assoc [1 2] 1 9) [1 9]))
  (is (= (get (Map/put {:a 1} :a 9) :a nil) 9)))

; --- destructuring ---

(deftest destructuring-core
  (let [[a b c] [1 2 3]]
    (is (= a 1))
    (is (= b 2))
    (is (= c 3)))
  (let [{:keys [x y] :or {x 10 y 20}} {}]
    (is (= x 10))
    (is (= y 20)))
  (let [{:keys [x] :as m} {:x 5}]
    (is (= x 5))
    (is (= (count m) 1))))

; --- control flow ---

(deftest cond-case-core
  (is (= (cond false :a true :b :else :c) :b))
  (is (= (cond false :a :else :c) :c))
  (is (= (cond :else :always) :always))
  (is (= (case 2 1 :one 2 :two :many) :two))
  (is (= (case :x :a 1 :x 2 :other) 2))
  (is (= (case 99 :default) :default)))

(deftest when-and-or-core
  (is (= (when true :yes) :yes))
  (is (= (when false :yes) nil))
  (is (= (and true true) true))
  (is (= (and 1 2 nil 3) nil))
  (is (= (or nil false 42) 42))
  (is (= (or nil nil) nil)))

; --- error handling ---

(deftest try-catch-core
  (is (= (try 41 (catch e nil)) 41))
  (is (= (try (throw (ex-info "boom" {:code 1}))
              (catch e (get (ex-data e) :code nil)))
         1))
  (is (= (try (throw :kaboom)
              (catch e (ex-message e)))
         ":kaboom")))

; --- composition ---

(deftest composition-core
  (is (= (second [1 2 3]) 2))
  (is (= (list 1 2 3) '(1 2 3)))
  (is (= (zipmap [:a :b] [1 2]) {:a 1 :b 2}))
  (is (= (take 3 '(1 2 3 4 5)) '(1 2 3)))
  (is (= (every? (fn [x] (> x 0)) [1 2 3]) true))
  (is (= (every? (fn [x] (> x 1)) [1 2]) false))
  (is (= (count (str "beam" "lisp")) 8)))

; --- distinct / dedupe / interpose (ordering contracts) ---

(deftest distinct-core
  ; first-occurrence order is the contract: dedup must not scramble it
  (is (= (distinct [1 1 2 3 3 2 1]) '(1 2 3)))
  (is (= (distinct [:a :b :a :c :b]) '(:a :b :c)))
  (is (= (distinct []) '()))
  (is (= (distinct identity [1 1 2]) '(1 2)))
  (is (= (distinct count [["a"] ["b"] ["c" "c"]]) '(["a"] ["c" "c"]))))

(deftest dedupe-core
  ; collapses runs only: equal values separated by a different value both survive
  (is (= (dedupe [1 1 2 2 3 1 1]) '(1 2 3 1)))
  (is (= (dedupe []) '()))
  (is (= (dedupe [5]) '(5))))

(deftest interpose-core
  (is (= (interpose :x [1 2 3]) '(1 :x 2 :x 3)))
  (is (= (interpose :x []) '()))
  (is (= (interpose 0 [1]) '(1)))
  (is (= (interpose :x '(a b)) '(a :x b))))

; --- split / flatten ---

(deftest split-at-core
  ; returns a vector of two seqs, preserving each half's own shape
  (is (= (split-at 2 [1 2 3 4]) [(list 1 2) (list 3 4)]))
  (is (= (split-at 5 [1 2]) [(list 1 2) (list)]))
  ; take past the end is empty (a [] vector, the take empty-contract);
  ; take 0 is likewise empty
  (is (= (split-at 0 [1 2]) [[] (list 1 2)])))

(deftest split-with-core
  (is (= (split-with (fn [x] (< x 3)) [1 2 3 1 2]) [(list 1 2) (list 3 1 2)]))
  (is (= (split-with (fn [_] true) [1 2]) [(list 1 2) (list)]))
  (is (= (split-with (fn [_] false) [1 2]) [(list) (list 1 2)])))

(deftest flatten-core
  (is (= (flatten [1 [2 [3]] 4]) '(1 2 3 4)))
  (is (= (flatten [1 [2 3] [[4]]]) '(1 2 3 4)))
  (is (= (flatten []) []))
  ; the root is dropped, as in Clojure
  (is (= (count (flatten 5)) 0)))

; --- repeatedly / max-key / min-key ---

(deftest repeatedly-core
  (is (= (take 3 (repeatedly (fn [] 7))) '(7 7 7)))
  (is (= (count (take 0 (repeatedly (fn [] 1)))) 0)))

(deftest max-min-key-core
  (is (= (max-key count [1] [2 3] [4]) [2 3]))
  (is (= (min-key count [1] [2 3] [4]) [1]))
  ; ties resolve to the first argument
  (is (= (max-key count [1] [2]) [1]))
  (is (= (min-key count [1] [2]) [1])))

; --- map utilities ---

(deftest map-update-keys-vals-core
  (is (= (update-keys {:a 1 :b 2} name) {"a" 1 "b" 2}))
  (is (= (update-vals {:a 1 :b 2} inc) {:a 2 :b 3}))
  (is (= (update-keys {} str) {}))
  (is (= (update-vals {} inc) {})))

(deftest select-keys-core
  (is (= (select-keys {:a 1 :b 2 :c 3} [:a :c]) {:a 1 :c 3}))
  ; missing keys are simply dropped
  (is (= (select-keys {:a 1} [:x]) {}))
  (is (= (select-keys {} [:a]) {})))

(deftest merge-with-core
  (is (= (merge-with + {:a 1} {:a 2 :b 3}) {:a 3 :b 3}))
  (is (= (merge-with + {:a 1} nil) {:a 1}))
  (is (= (merge-with +) {}))
  ; later maps fold into the result left-to-right through f
  (is (= (merge-with (fn [a b] (* a b)) {:a 2} {:a 3} {:a 4}) {:a 24})))

; --- mapcat / keep / partition-by / frequencies ---

(deftest mapcat-core
  (is (= (mapcat (fn [x] [x x]) [1 2]) '(1 1 2 2)))
  (is (= (mapcat (fn [x] [x]) []) '())))

(deftest keep-core
  (is (= (keep (fn [x] (if (> x 1) x nil)) [1 2 3]) '(2 3)))
  (is (= (keep (fn [_] nil) [1 2]) '()))
  (is (= (keep first [[1 2] [] [3]]) '(1 3))))

(deftest keep-indexed-core
  (is (= (keep-indexed (fn [i x] (if (odd? i) x nil)) [:a :b :c :d]) '(:b :d)))
  (is (= (keep-indexed (fn [_ x] x) []) '())))

(deftest partition-by-core
  (is (= (partition-by (fn [x] (> x 2)) [1 2 3 4 2 5]) '((1 2) (3 4) (2) (5))))
  (is (= (partition-by even? []) '())))

(deftest frequencies-core
  (is (= (frequencies [:a :b :a :c :a :b]) {:a 3 :b 2 :c 1}))
  (is (= (frequencies []) {})))

; --- not-empty / peek / pop / subvec ---

(deftest not-empty-core
  (is (= (not-empty [1 2]) [1 2]))
  (is (= (not-empty []) nil))
  (is (= (not-empty nil) nil)))

(deftest peek-pop-core
  (is (= (peek [1 2 3]) 3))
  (is (= (peek '(1 2 3)) 1))
  ; pop keeps the collection shape: vector out, list out
  (is (= (pop [1 2 3]) [1 2]))
  (is (= (pop [5]) []))
  (is (= (pop '(1 2 3)) '(2 3)))
  (is (= (pop '(5)) '()))
  (is (= (try (pop []) (catch e :threw)) :threw)))

(deftest subvec-core
  (is (= (subvec [1 2 3 4 5] 1 3) [2 3]))
  (is (= (subvec [1 2 3] 1) [2 3]))
  (is (= (subvec [1 2 3] 0 0) []))
  (is (= (subvec [1 2 3 4] 0 4) [1 2 3 4])))

; --- rem / mod (negative-operand contract) ---
; rem takes the sign of the dividend, mod the sign of the divisor — they
; agree on same-sign operands and diverge on mixed signs. This is the
; classic silent-wrong-answer bug, so both signs are pinned down.

(deftest rem-mod-sign-core
  (is (= (rem 7 3) 1))
  (is (= (rem -7 3) -1))
  (is (= (rem 7 -3) 1))
  (is (= (rem -7 -3) -1))
  ; mod is defined in terms of rem, then corrected to the divisor's sign
  (is (= (mod 7 3) 1))
  (is (= (mod -7 3) 2))
  (is (= (mod 7 -3) -2))
  (is (= (mod -7 -3) -1))
  (is (= (mod 0 3) 0)))

; --- reduce-kv (map keys, vector indices) ---

(deftest reduce-kv-core
  (is (= (reduce-kv (fn [acc k v] (assoc acc k (inc v))) {} {:a 1 :b 2})
         {:a 2 :b 3}))
  ; a vector's keys are its indices
  (is (= (reduce-kv (fn [acc i x] (+ acc (* i x))) 0 [1 2 3]) 8))
  (is (= (reduce-kv (fn [acc k v] (assoc acc k (* v 10))) {} {:a 1}) {:a 10})))

; --- transientable? (every beam-lisp collection type) ---

(deftest transientable-q-core
  ; vectors, maps, sets can take a transient view; lists, lazy seqs, and
  ; non-collections cannot. This must mirror (transient coll) exactly — a
  ; drift here silently misroutes into's fast path.
  (is (= (transientable? []) true))
  (is (= (transientable? {}) true))
  (is (= (transientable? #{}) true))
  (is (= (transientable? '(1 2)) false))
  (is (= (transientable? (range 3)) false))
  (is (= (transientable? nil) false))
  (is (= (transientable? 5) false))
  (is (= (transientable? "a") false)))

; --- float? (is_float on the BEAM) ---

(deftest float-q-core
  (is (= (float? 1.5) true))
  (is (= (float? -0.0) true))
  (is (= (float? 1) false))
  (is (= (float? "a") false)))

; --- multi-coll map stops at the shortest input ---

(deftest multi-coll-map-core
  (is (= (map + [1 2 3] [10 20]) '(11 22)))
  (is (= (map + [1 2] [10 20 30]) '(11 22)))
  (is (= (map + [1 2 3] [10 20 30] [100 200]) '(111 222)))
  (is (= (map (fn [a b c] [a b c]) [1 2] [:a :b] [:x :y])
         '([1 :a :x] [2 :b :y])))
  ; one exhausted coll ends the map, rest are ignored
  (is (= (map + [1 2 3] []) '())))

; --- into (2-arity conj, 3-arity xform) ---

(deftest into-core
  (is (= (into [] [1 2 3]) [1 2 3]))
  (is (= (into [0] [1 2 3]) [0 1 2 3]))
  ; a list target is not transientable, so conj prepends
  (is (= (into '(9) [1 2 3]) '(3 2 1 9)))
  (is (= (into [] (take 2) [1 2 3 4]) [1 2]))
  (is (= (into [] (take 0) [1 2 3]) []))
  (is (= (into [] nil) [])))

; --- transduce (transducer xform over a reducing fn) ---

(deftest transduce-core
  (is (= (transduce (take 2) conj [] [1 2 3 4]) [1 2]))
  (is (= (transduce (take 0) conj [] [1 2 3]) []))
  (is (= (transduce identity conj [] [1 2 3]) [1 2 3]))
  (is (= (transduce (take 2) conj '(0) [1 2 3 4]) '(2 1 0))))

; --- wave 27 prims: type / instance? / symbol / sequence / keys / vals /
; vec / subs / dissoc / unreduced ---
; Each decision from the wave-27 spec carries a test that fails if someone
; reverses it: type's single vocabulary, instance? semantics, symbol's
; reader-faithful shape, sequence-vs-seq on empty, dissoc-on-record, and
; keys/vals ordering.

(defrecord W27Pt [x y])

(deftest type-core
  (is (= (type 5) :integer))
  (is (= (type 1.5) :float))
  (is (= (type "x") :binary))
  (is (= (type {:a 1}) :map))
  (is (= (type [1]) :vector))
  (is (= (type '(1)) :list))
  (is (= (type :k) :keyword))
  (is (= (type true) :boolean))
  (is (= (type nil) :nil))
  ; a record's type is its module — the identity protocol dispatch keys on
  (is (= (type (->W27Pt 1 2)) W27Pt))
  ; the Specter dynamic-param? shape: contains? over a set of type tags
  (is (= (contains? #{W27Pt} (type (->W27Pt 1 2))) true)))

(deftest instance-q-core
  (is (= (instance? :integer 5) true))
  (is (= (instance? :vector [1]) true))
  (is (= (instance? :map {:a 1}) true))
  (is (= (instance? :binary "x") true))
  ; builtins match by keyword tag, never cross-type
  (is (= (instance? :integer 5.0) false))
  (is (= (instance? :vector 5) false))
  ; user types match by module
  (is (= (instance? W27Pt (->W27Pt 1 2)) true))
  (is (= (instance? W27Pt {:a 1}) false)))

(deftest symbol-core
  ; the shape is the reader's own — a runtime symbol equals a read one
  (is (= (symbol "x") 'x))
  (is (= (symbol :abc) 'abc))
  (is (= (symbol 'foo) 'foo))
  (is (symbol? (symbol "x")))
  ; 2-arity produces the same namespaced datum the reader reads for foo/bar
  (is (= (symbol "foo" "bar") 'foo/bar))
  (is (= (symbol "a" "b") 'a/b))
  ; a nil or empty ns yields the bare name symbol, as in Clojure
  (is (= (symbol nil "x") 'x))
  (is (= (symbol "" "x") 'x)))

(deftest sequence-core
  ; the whole reason sequence exists: () on empty where seq gives nil
  (is (= (sequence nil) ()))
  (is (= (sequence []) ()))
  (is (= (sequence [1 2 3]) '(1 2 3)))
  (is (nil? (seq nil)))
  ; 2-arity applies a transducer and seqs the result
  (is (= (sequence (take 2) [1 2 3 4]) '(1 2)))
  (is (= (sequence (take 0) [1 2 3 4]) ())))

(deftest keys-vals-core
  ; beam-lisp maps iterate in Erlang term order, not insertion order, so
  ; these assert the CONTRACT, never a specific order: keys/vals are the
  ; map's entries projected, and stay consistent with each other and
  ; with seq over the same map.
  (is (= (set (keys {:a 1 :b 2})) #{:a :b}))
  (is (= (set (vals {:a 1 :b 2})) #{1 2}))
  ; keys is exactly the first element of each seq entry
  (is (= (map key (seq {:a 1 :b 2})) (keys {:a 1 :b 2})))
  (is (= (map val (seq {:a 1 :b 2})) (vals {:a 1 :b 2})))
  ; keys and vals are mutually consistent: zipmap round-trips the map
  (is (= (zipmap (keys {:a 1 :b 2}) (vals {:a 1 :b 2})) {:a 1 :b 2}))
  (is (= (zipmap (keys {:x 10 :y 20 :z 30}) (vals {:x 10 :y 20 :z 30}))
         {:x 10 :y 20 :z 30}))
  ; nil punning, Clojure-faithful
  (is (= (keys nil) nil))
  (is (= (vals nil) nil))
  (is (= (keys {}) nil))
  ; a record's keys are its public fields (same order-agreement rule)
  (is (= (set (keys (->W27Pt 1 2))) #{:x :y}))
  (is (= (zipmap (keys (->W27Pt 1 2)) (vals (->W27Pt 1 2))) {:x 1 :y 2})))

(deftest vec-core
  (is (= (vec nil) []))
  (is (= (vec [1 2 3]) [1 2 3]))
  (is (= (vec '(1 2 3)) [1 2 3]))
  ; a lazy seq must be forced
  (is (= (vec (map inc [1 2 3])) [2 3 4]))
  ; a set's members (order is the set's, so compare as a set)
  (is (= (set (vec #{1 2 3})) #{1 2 3}))
  (is (= (count (vec #{1 2 3})) 3))
  ; a map's entries
  (is (= (vec {:a 1}) [[:a 1]])))

(deftest subs-core
  (is (= (subs "hello" 1) "ello"))
  (is (= (subs "hello" 1 3) "el"))
  (is (= (subs "hello" 0 0) ""))
  ; start == length is a valid empty slice (Clojure-faithful)
  (is (= (subs "hello" 5) ""))
  ; char-based, not byte-based: multi-byte chars are not split
  (is (= (subs "héllo" 1 2) "é"))
  ; out-of-range and inverted indices raise
  (is (try (do (subs "hello" 9) false) (catch e true)))
  (is (try (do (subs "hello" 0 9) false) (catch e true)))
  (is (try (do (subs "hello" 3 1) false) (catch e true)))
  (is (try (do (subs "hello" -1) false) (catch e true))))

(deftest unreduced-core
  (is (= (unreduced 5) 5))
  (is (= (unreduced (reduced 42)) 42))
  (is (= (unreduced nil) nil))
  (is (= (unreduced (reduced nil)) nil)))

(deftest dissoc-core
  (is (= (dissoc {:a 1 :b 2} :a) {:b 2}))
  (is (= (dissoc {:a 1 :b 2 :c 3} :a :b) {:c 3}))
  (is (= (dissoc {:a 1}) {:a 1}))
  (is (= (dissoc nil :a) nil))
  ; a record: dissoc'ing a declared field yields a PLAIN map
  (is (= (dissoc (->W27Pt 1 2) :x) {:y 2}))
  (is (= (map? (dissoc (->W27Pt 1 2) :x)) true))
  (is (= (BeamLisp.Record/record? (dissoc (->W27Pt 1 2) :x)) false))
  ; dissoc'ing a non-declared key keeps it a record
  (is (= (BeamLisp.Record/record? (dissoc (->W27Pt 1 2) :zz)) true))
  ; a reference struct raises, like the other collection fns (wave-1)
  (is (= (ref-type? (atom 1)) true))
  (is (= (ref-type? [1 2]) false))
  (is (try (do (dissoc (atom 1) :k) false) (catch e true))))

(deftest into-and-transducers-core
  "`into` is the last jank-sample slice to close, and it closed for two
   reasons at once: a map transient could not accept an entry, and `map`
   had no transducer arity. Both spellings of a map entry are tested,
   because `seq` yields one and a literal source yields the other."
  ; every target kind
  (is (= (into [] [1 2 3]) [1 2 3]))
  (is (= (into [0] [1 2]) [0 1 2]))
  (is (= (into [] '(1 2)) [1 2]))
  (is (= (into {} [[:a 1] [:b 2]]) {:a 1 :b 2}))
  (is (= (into {} '((:a 1))) {:a 1}))
  (is (= (into {} {:a 1}) {:a 1}))
  ; a later duplicate key wins, as assoc would
  (is (= (into {} [[:a 1] [:a 9]]) {:a 9}))
  ; the arities upstream declares beyond to+from
  (is (= (into) []))
  (is (= (into [9]) [9]))
  (is (= (into [] nil) []))
  ; transducer arities: these failed at xform CONSTRUCTION before wave 27
  (is (= (into [] (map inc) [1 2 3]) [2 3 4]))
  (is (= (into [] (filter odd?) [1 2 3]) [1 3]))
  (is (= (into [] (map inc) []) []))
  ; the collection arities still delegate to the chunked-lazy primitives
  (is (= (doall (map inc [1 2])) '(2 3)))
  (is (= (doall (filter odd? [1 2 3])) '(1 3)))
  (is (= (doall (map + [1 2] [10 20])) '(11 22)))
  ; a malformed entry must fail loudly rather than bind the first two fields
  (is (try (do (into {} [[:a 1 :extra]]) false) (catch e true)))
  ; and a reference type is still not a collection
  (is (try (do (into [] (atom 1)) false) (catch e true))))


; --- for: list comprehension (wave 27) ---
; `for` is a prelude macro now (adapted from the vendored jank slice_44
; fixture, itself core.jank@3028594). It is lazy, nests rightmost-fastest,
; supports :let / :when / :while modifiers and destructuring binding forms.
; The laziness and hygiene checks matter most: timing proves speed, only a
; realization count proves laziness.

(deftest for-basic
  (is (= (doall (for [x [1 2 3]] (* x 2))) '(2 4 6)))
  ; a single-element binding is fine; the empty collection is an empty seq
  (is (= (doall (for [x [1]] x)) '(1)))
  (is (= (doall (for [x []] x)) ())))

(deftest for-nested
  ; rightmost binding runs fastest; a later binding expr may refer to an
  ; earlier binding (y (range x) reads x)
  (is (= (doall (for [x [1 2] y (range x)] [x y])) '([1 0] [2 0] [2 1]))))

(deftest for-modifiers
  (is (= (doall (for [x [1 2 3] :let [y (* x 10)]] [x y])) '([1 10] [2 20] [3 30])))
  ; :when skips rejected elements
  (is (= (doall (for [x (range 10) :when (even? x)] x)) '(0 2 4 6 8)))
  ; :when rejecting everything still terminates with an empty seq
  (is (= (doall (for [x [1 2 3] :when false] x)) ()))
  ; :while stops that level — over an INFINITE source it must terminate
  (is (= (doall (for [x (range) :while (< x 5)] x)) '(0 1 2 3 4))))

(deftest for-destructuring
  (is (= (doall (for [[a b] [[1 2] [3 4]]] (+ a b))) '(3 7)))
  (is (= (doall (for [[k v] {:a 1 :b 2}] [k v])) '([:b 2] [:a 1]))))

(deftest for-lazy
  ; The body must not run a million times because the source has a million
  ; elements: (take 5 ...) may realize only what it needs. The counter
  ; proves laziness where a stopwatch only proves speed.
  (is (let [c (atom 0)
            res (doall (take 5 (for [x (range 1000000)]
                                     (do (swap! c inc) (* x 2)))))]
        (and (= res '(0 2 4 6 8)) (= (deref c) 5))))
  ; :when filtering a huge range is lazy the same way
  (is (let [c (atom 0)
            res (doall (take 5 (for [x (range 1000000) :when (even? x)]
                                     (do (swap! c inc) x))))]
        (and (= res '(0 2 4 6 8)) (= (deref c) 5)))))

(deftest for-hygiene
  ; gensym hygiene: the macro's temporaries (iter__/s__/b__/i__) must not
  ; capture a user binding of the same name
  (is (= (let [iter 5] (doall (for [x [1]] iter))) '(5)))
  (is (= (let [s 7] (doall (for [x [1]] s))) '(7)))
  (is (= (let [x 9] (doall (for [y [1]] x))) '(9))))

; --- var metadata: ^ values are DATA, not code ---

(defn ^{:args [int] :ret int} meta-probe-double [x] (* x 2))

(deftest var-metadata-values-are-data
  ; `^{:args [int] :ret int}` must store the SYMBOLS. The compiler used to
  ; EVALUATE attr values — [int] became a fn capture and a fn-type like
  ; (fn [int] bool) would have been CALLED. Type expressions are data to
  ; the checker; Clojure never evaluates metadata either.
  (let [m (second (BeamLisp.Env/meta (BeamLisp.Env/current_ns) "meta-probe-double"))]
    (is (= 'int (:ret m)))
    (is (= '[int] (:args m)))))

; --- vary-meta: variadic (wave 27) ---
; Clojure's vary-meta is (vary-meta obj f & args): the metadata is
; replaced by (apply f (meta obj) args). The 2-arity is unchanged; the
; variadic form is what (vary-meta x assoc :k v) needs.

(deftest vary-meta-core
  ; 2-arity unchanged
  (is (= (meta (vary-meta [1] (fn [m] {:a 1}))) {:a 1}))
  ; variadic: f receives the current meta then the extra args
  (is (= (meta (vary-meta [1] assoc :k 1)) {:k 1}))
  (is (= (meta (vary-meta [1] assoc :k 1 :j 2)) {:k 1 :j 2}))
  ; nil meta flows through as nil, as Clojure does
  (is (= (meta (vary-meta [1] (fn [m] (if (nil? m) {:from-nil true} m))))
         {:from-nil true})))

(deftest merge-core
  "Merging nothing is nil rather than {} — Clojure's contract, and what
   makes (apply merge coll) safe when coll is empty."
  (is (= (merge {:a 1} {:b 2}) {:a 1 :b 2}))
  (is (= (merge {:a 1} {:a 9}) {:a 9}))
  (is (= (merge {:a 1} {:b 2} {:c 3}) {:a 1 :b 2 :c 3}))
  (is (= (merge nil {:a 1}) {:a 1}))
  (is (= (merge {:a 1} nil) {:a 1}))
  (is (= (merge) nil))
  (is (= (apply merge []) nil))
  ; a record merges as the map it is; the result gains a key its type never
  ; declared, so it cannot stay that type
  (is (= (merge (->W27Pt 1 2) {:z 3}) {:x 1 :y 2 :z 3})))


(deftest name-namespace-keyword-core
  "name/namespace/keyword are one feature with three views, and the
   contract that binds them is the roundtrip: a keyword taken apart and
   put back together is the keyword you started with."
  ; name drops the namespace, which it did NOT do before wave 28
  (is (= (name :a) "a"))
  (is (= (name :a/b) "b"))
  (is (= (name 'x/y) "y"))
  (is (= (name "s") "s"))
  ; namespace is the other half; nil, not "", when there is none
  (is (= (namespace :a/b) "a"))
  (is (nil? (namespace :a)))
  (is (nil? (namespace 'x)))
  ; the / var names itself — a lone slash is not a qualification
  (is (= (name '/) "/"))
  (is (nil? (namespace '/)))
  ; keyword is the constructor half
  (is (= (keyword "a") :a))
  (is (= (keyword "ns" "n") :ns/n))
  (is (= (keyword 'foo) :foo))
  ; idempotent, so building from an already-built keyword is stable
  (is (= (keyword (keyword "a")) :a))
  ; the roundtrip, for both a qualified and a bare keyword
  (is (= :a/b (keyword (namespace :a/b) (name :a/b))))
  (is (= :a (keyword (name :a)))))

(deftest satisfies-core
  "satisfies? must agree with the call it guards. A predicate that says
   yes where the call raises is worse than no predicate at all."
  (defprotocol W28Shape (w28-area [x]))
  (extend-type :integer W28Shape (w28-area [x] (* x x)))
  (is (satisfies? W28Shape 3))
  (is (= (w28-area 3) 9))
  ; and false where the call would fail
  (is (not (satisfies? W28Shape "s")))
  ; an unknown protocol answers false rather than raising
  (is (not (satisfies? W28NoSuch 3)))
  ; a reify satisfies the protocol it reifies — the case the Specter
  ; engine actually depends on, since navigators are reify values
  (is (satisfies? W28Shape (reify W28Shape (w28-area [x] 0)))))
