; test/bl/prelude_test.bl — the prelude, tested in beam-lisp itself.
; Run: mix beam_lisp.test test/bl/prelude_test.bl

(ns prelude.test)

; --- map / filter / reduce / range ---

(deftest map-core
  (is (= (map inc [1 2 3]) '(2 3 4)))
  (is (= (map (fn [x] (* x x)) [1 2 3]) '(1 4 9)))
  (is (= (map str [1 2]) '("1" "2")))
  (is (= (map inc []) [])))

(deftest filter-core
  (is (= (filter (fn [x] (> x 2)) [1 2 3 4]) '(3 4)))
  (is (= (filter (fn [x] (< x 4)) [1 2 3 4 5 6]) '(1 2 3)))
  (is (= (filter (fn [_] true) []) [])))

(deftest reduce-core
  (is (= (reduce (fn [acc x] (+ acc x)) 0 [1 2 3 4]) 10))
  (is (= (reduce (fn [acc x] (* acc x)) 1 [1 2 3 4]) 24))
  (is (= (reduce (fn [acc x] (conj acc x)) [] [1 2 3]) [1 2 3])))

(deftest range-core
  (is (= (range 5) '(0 1 2 3 4)))
  (is (= (range 2 6) '(2 3 4 5)))
  (is (= (range 0 0) '()))
  (is (= (count (range 10)) 10)))

; --- conj / assoc ---

(deftest conj-core
  (is (= (conj '(2 3) 1) '(1 2 3)))
  (is (= (conj [1 2] 3) [1 2 3]))
  (is (= (conj nil 1) '(1))))

(deftest assoc-core
  ; assoc has no prelude name yet — the operations are tested through
  ; their interop homes: Map/put for maps, Vector/assoc for vectors.
  (is (= (Map/put {} :a 1) {:a 1}))
  (is (= (Map/put {:a 1} :b 2) {:a 1 :b 2}))
  (is (= (BeamLisp.Vector/assoc [1 2] 1 9) [1 9]))
  (is (= (get (Map/put {:a 1} :a 9) :a nil) 9)))

; --- destructuring ---

(deftest destructuring-core
  (let [[a b c] [1 2 3]]
    (is (= a 1))
    (is (= b 2))
    (is (= c 3)))
  (let [{:keys [x y] :or {x 10 y 20}} {}]
    (is (= x 10))
    (is (= y 20)))
  (let [{:keys [x] :as m} {:x 5}]
    (is (= x 5))
    (is (= (count m) 1))))

; --- control flow ---

(deftest cond-case-core
  (is (= (cond false :a true :b :else :c) :b))
  (is (= (cond false :a :else :c) :c))
  (is (= (cond :else :always) :always))
  (is (= (case 2 1 :one 2 :two :many) :two))
  (is (= (case :x :a 1 :x 2 :other) 2))
  (is (= (case 99 :default) :default)))

(deftest when-and-or-core
  (is (= (when true :yes) :yes))
  (is (= (when false :yes) nil))
  (is (= (and true true) true))
  (is (= (and 1 2 nil 3) nil))
  (is (= (or nil false 42) 42))
  (is (= (or nil nil) nil)))

; --- error handling ---

(deftest try-catch-core
  (is (= (try 41 (catch e nil)) 41))
  (is (= (try (throw (ex-info "boom" {:code 1}))
              (catch e (get (ex-data e) :code nil)))
         1))
  (is (= (try (throw :kaboom)
              (catch e (ex-message e)))
         ":kaboom")))

; --- composition ---

(deftest composition-core
  (is (= (second [1 2 3]) 2))
  (is (= (list 1 2 3) '(1 2 3)))
  (is (= (zipmap [:a :b] [1 2]) {:a 1 :b 2}))
  (is (= (take 3 '(1 2 3 4 5)) '(1 2 3)))
  (is (= (every? (fn [x] (> x 0)) [1 2 3]) true))
  (is (= (every? (fn [x] (> x 1)) [1 2]) false))
  (is (= (count (str "beam" "lisp")) 8)))
