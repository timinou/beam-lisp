;; test/js/perf/perf.bl — the eight core-heavy workloads measured by
;; test/js/perf/run.mjs against the ONE compiled core (out/ns/perf.mjs).
;; The build is test/js/perf/build.bl; there is no hand-written core and no
;; hand/self ratio any more. Keep the answers pinned in run.mjs's EXPECTED.
(ns perf)
(defn p-map-filter [] (reduce + 0 (filter even? (map inc (range 20000)))))
(defn p-assoc [] (count (reduce (fn [m i] (assoc m i (* i i))) {} (range 5000))))
(defn p-vec [] (count (reduce conj [] (range 20000))))
(defn p-str [] (count (apply str (interpose "," (map str (range 3000))))))
(defn p-sort [] (first (sort (map (fn [i] (mod (* i 7919) 10007)) (range 10000)))))
(defn p-get-in [] (let [m {:a {:b {:c 1}}}] (reduce (fn [a _] (+ a (get-in m [:a :b :c]))) 0 (range 20000))))
(defn p-eq [] (count (filter (fn [i] (= [i {:k i}] [i {:k i}])) (range 5000))))
(defn p-freq [] (count (frequencies (map (fn [i] (mod i 97)) (range 20000)))))
