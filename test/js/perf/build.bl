; test/js/perf/build.bl — build the ONE compiled perf core.
;
; Run from the checkout root:
;   ./bin/bl run test/js/perf/build.bl
;   node test/js/perf/run.mjs test/js/perf/out
;
; ONE default compiled build, no modes: `bl.js/build!` compiles the `perf`
; workloads (and the rt/core they call) from priv/boot into out/ns/perf.mjs,
; exactly as a page build does. There is no hand-written core to opt into and
; no --self-host.
;
; The manifest records the source hashes before/after the build and that the
; output copied the runtime bytes the build read (rt/abi/lazy/leaves/env — abi,
; NOT a hand core). A source tree that moved mid-build, or a runtime file that
; did not land identically, is an error, not a usable measurement baseline.
(ns perf.build
  (:require [bl.js :as js]
            [bl.json :as json]))

(def ^:private entry "perf")
(def ^:private source-dir "test/js/perf")
(def ^:private out-dir "test/js/perf/out")

; Runtime files the build copies beside out/ns/. abi.mjs is the host bridge;
; core.mjs is gone (compiled), so it is NOT listed.
(def ^:private runtime-files
  ["rt.mjs" "abi.mjs" "lazy.mjs" "host-leaves.mjs" "leaves.mjs" "env.mjs"])
(def ^:private runtime-dir
  (Path/dirname (BeamLisp.Loader/source_path "js.build")))

; The source tree a build of `perf` reads: the workload plus the compiled
; runtime/core and the roots `bl.js/build!` searches. A hash moved during the
; build is the one thing that makes a recorded baseline unusable.
(def ^:private source-roots
  ["test/js/perf" "priv/boot" "priv/compat" "priv/lib" "priv/std"])

(defn- sha [path] (sha256-hex (File/read! path)))

(defn- source-snapshot []
  (->> (mapcat (fn [root] (Path/wildcard (str root "/**/*.bl"))) source-roots)
       distinct sort
       (mapv (fn [p] {:path p :sha256 (sha p)}))))

(defn- runtime-hashes [dir]
  (into {} (map (fn [f] [f (sha (Path/join dir f))]) runtime-files)))

(defn build!
  "Build the one compiled perf core and write out/manifest.json beside it.
   `:out` defaults to test/js/perf/out."
  ([] (build! {}))
  ([opts]
   (let [out (or (:out opts) out-dir)
         source-before (source-snapshot)
         runtime-before (runtime-hashes runtime-dir)
         r (js/build! entry (assoc (dissoc opts :out) :paths [source-dir] :out out))
         source-after (source-snapshot)
         runtime-out (runtime-hashes out)
         runtime-after (runtime-hashes runtime-dir)
         manifest {:entry entry
                   :paths [source-dir]
                   :built_at (erlang/system_time :millisecond)
                   :source_id (sha256-hex (pr-str [source-before runtime-before]))
                   :source_before source-before :source_after source-after
                   :sources_unchanged (= source-before source-after)
                   :runtime_source runtime-before
                   :runtime_out runtime-out
                   :runtime_identical (and (= runtime-before runtime-after)
                                           (= runtime-before runtime-out))
                   :build {:out out
                           :modules (vec (:modules r))
                           :bytes (:bytes r)
                           :sources (vec (:sources r))
                           :runtime runtime-out}}]
     (File/mkdir_p! out)
     (File/write! (Path/join out "manifest.json") (json/encode manifest {:pretty 2}))
     (when (or (not (:sources_unchanged manifest)) (not (:runtime_identical manifest)))
       (throw (ex-info "perf.build: sources/runtime changed during build" manifest)))
     (println (str "perf.build: " (count (:modules r)) " ns, " (:bytes r) " bytes, "
                   "sources unchanged, runtime identical -> " out "/manifest.json"))
     manifest)))

(build!)
