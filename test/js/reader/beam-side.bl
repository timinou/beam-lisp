; test/js/reader/beam-side.bl — `read-all` of each file on the BEAM, one line
; per file: <path>\t<canonical form> (or #error <message>). The canonical
; printer is test/js/reader/canon.mjs's, written here for Erlang terms.
;   READER_FILES=a.bl:b.bl bl run test/js/reader/beam-side.bl
(ns reader-diff.beam-side)

(defn canon [x]
  (cond
    (nil? x) "nil"
    (erlang/is_tuple x) (str "{" (join " " (map canon (erlang/tuple_to_list x))) "}")
    (erlang/is_list x) (str "(" (join " " (map canon x)) ")")
    (vector? x) (str "[" (join " " (map canon x)) "]")
    (map? x) (str "{" (join ", " (sort (map (fn [[k v]] (str (canon k) " " (canon v))) x))) "}")
    ; strings by their codepoints: pr-str's escaping is a printer choice
    ; (BEAM escapes `#{` as `\#{`), not part of what the reader produced
    (string? x) (str "\"" (join "," (map str (unicode/characters_to_list x))) "\"")
    :else (pr-str x)))

(doseq [p (split (System/get_env "READER_FILES") ":")]
  (println (str p "\t" (try (canon (BeamLisp.Ns.Reader/read_all (File/read! p)))
                            (catch e (str "#error " (ex-message e)))))))
