; Run with BL_SOURCE_ROOT and BL_ACTOR_OBSERVATION_OUT set to absolute paths.
(ns observation.fixture-build (:require [js.actor :as actor]))
(let [source (System/get_env "BL_SOURCE_ROOT")
      output (System/get_env "BL_ACTOR_OBSERVATION_OUT")]
 (when-not (and source output)
  (throw (ex-info "Set BL_SOURCE_ROOT and BL_ACTOR_OBSERVATION_OUT" {})))
 (File/mkdir_p! output)
 (File/cp! (str source "/test/js/fixtures/observation-actor.bl") (str output "/fixture.bl"))
 (actor/build-one output "fixture.bl" "observation.mjs" [] {:prune true})
 (File/cp! (str source "/test/js/fixtures/observation-actor-bench.bl") (str output "/bench.bl"))
 (actor/build-one output "bench.bl" "observation-bench.mjs" [] {:prune true})
 (actor/write-runtime! output (str "file://" source "/priv/lib/js/rt.mjs")))
