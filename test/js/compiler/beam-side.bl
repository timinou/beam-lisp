; test/js/compiler/beam-side.bl — compile each top-level form of a file to
; bl-ANF on the BEAM, one line per form: <index>\t<canonical ANF>.
;   COMPILER_FORMS=path bl run test/js/compiler/beam-side.bl
(ns compiler-diff.beam-side)
(defn canon [x]
  (cond
    (nil? x) "nil"
    (erlang/is_tuple x) (str "{" (join " " (map canon (erlang/tuple_to_list x))) "}")
    (erlang/is_list x) (str "(" (join " " (map canon x)) ")")
    (vector? x) (str "[" (join " " (map canon x)) "]")
    (map? x) (str "{" (join ", " (sort (map (fn [[k v]] (str (canon k) " " (canon v))) x))) "}")
    (string? x) (str "\"" (join "," (map str (unicode/characters_to_list x))) "\"")
    :else (pr-str x)))
(BeamLisp.Compiler/reset_fresh!)
(doseq [[i f] (map-indexed (fn [i f] [i f]) (BeamLisp.Ns.Reader/read_all (File/read! (System/get_env "COMPILER_FORMS"))))]
  (BeamLisp.Compiler/reset_fresh!)
  (println (str i "\t" (try (canon (BeamLisp.Ns.Compiler/compile f (BeamLisp.Ns.Compiler/new_env "user")))
                            (catch e (str "#error " (ex-message e)))))))
