"text"
:kw
[1 :a "s"]
{:a 1 :b [2 3]}
#{1 2}
(+ 1 2)
(fn [x] (* x 2))
(let [a 1] (if (pos? a) :y :n))
(defn f [x] (when (pos? x) (-> x inc (* 2))))
(loop [i 0 acc []] (if (< i 3) (recur (inc i) (conj acc i)) acc))
(let [{:keys [a b]} {:a 1 :b 2}] (+ a b))
(map inc [1 2 3])
(str "a" 1 :b)
(try (/ 1 0) (catch e :caught))
(case 2 1 :one 2 :two :other)
(cond (= 1 2) :a :else :b)
(defmacro twice [x] (list 'do x x))
(fn [& xs] (apply + xs))
(fn ([] 0) ([x] x) ([x y] (+ x y)))
