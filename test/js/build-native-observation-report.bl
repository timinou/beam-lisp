; Private, finite fixture. No manager/world/server is started or modified.
(ns observation.report
 (:require [vm.owner :as owner] [vm.scope :as scope]
           [vm.observation :as observation] [bl.json :as json]))
(defn parked [] (receive :stop :ok))
(defn main []
 (let [realm (str "observation-report-" (System/unique_integer (list :positive)))
       foreign (str realm "-foreign")
       owned (mapv (fn [_] (owner/spawn realm :fixture parked)) (range 256))
       others (mapv (fn [_] (owner/spawn foreign :fixture parked)) (range 512))
       captured (scope/with-vm realm observation/capture)]
  (try
   (let [small (observation/snapshot captured 8)
         large (observation/snapshot captured 128)
         samples (mapv (fn [_] (let [start (erlang/monotonic_time :microsecond)]
                          (observation/snapshot captured 8)
                          (- (erlang/monotonic_time :microsecond) start))) (range 50))
         result {:fixture {:realm-members 256 :foreign-members 512 :reads 50 :units "microseconds"
                           :physical-av "not measured" :query "indexed actual owner registry"}
                 :small small :large large :raw-duration-us samples}]
    (File/write! "docs/proof/runtime-observation/milestone-1/native.json" (json/encode result))
    (println {:small-examined (get-in small [:query :examined]) :large-examined (get-in large [:query :examined])
              :total (:total small) :foreign-visible (some (fn [r] (= foreign (:owner r))) (:resources large))}))
   (finally (doseq [pid (concat owned others)] (erlang/send pid :stop))))))
(main)
