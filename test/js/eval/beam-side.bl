; test/js/eval/beam-side.bl — evaluate each top-level form of the corpus on
; the BEAM, in order (defs feed later forms), one line per form:
;   <index>\t<pr-str of the value> | #error <message> | #fn
;   EVAL_CORPUS=path bl run test/js/eval/beam-side.bl
(ns eval-diff.beam-side)
(defn run []
  (let [forms (BeamLisp.Ns.Reader/read_string (File/read! (System/get_env "EVAL_CORPUS")) "corpus")]
    (doseq [[i f] (map-indexed (fn [i f] [i f]) forms)]
      (println (str i "\t"
                    (try (let [v (BeamLisp.Compiler/eval_form f (BeamLisp.Compiler/new_env "eval-user"))]
                           (cond (fn? v) "#fn"
                                 (and (erlang/is_tuple v) (= :$macro (erlang/element 1 v))) "#macro"
                                 :else (pr-str v)))
                         (catch e (str "#error " (ex-message e)))))))))
(run)
