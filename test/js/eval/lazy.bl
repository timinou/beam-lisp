;; test/js/eval/lazy.bl — lazy NODE semantics (lazy-seq, delay, force,
;; realized?, retry, recursive force, the cyclic-memo guard), measured on the
;; BEAM 2026-10-04. lazy.mjs + today's core must print the same.
;; `(do (def …) nil)`: a def's printed value would FORCE the node on the BEAM.
(do (def tries (atom 0)) nil)
(do (def flaky (lazy-seq (if (< (swap! tries inc) 2) (throw (ex-info "boom" {:n @tries})) (list :ok)))) nil)
(try (first flaky) (catch e [(ex-message e) (ex-data e)]))
(first flaky)
(do (def self-force (lazy-seq (cons 1 (seq self-force)))) nil)
(try (first self-force) (catch e (ex-message e)))
(try (first self-force) (catch e (ex-message e)))
(do (def self-cons (lazy-seq (cons 1 self-cons))) nil)
(try (vec (take 3 self-cons)) (catch e (ex-message e)))
(try (count (reduce (fn [s _] (lazy-seq s)) (list 1) (range 200000))) (catch e (ex-message e)))
(let [s (lazy-seq (list 1))] [(realized? s) (first s) (realized? s)])
[(first (lazy-seq [7 8])) (vec (lazy-seq #{1})) (vec (lazy-seq (lazy-seq (list 1 2))))]
(let [e (lazy-seq nil)] [(list? e) (seq? e) (empty? e) (seq e) (count e) (first e) (rest e) (next e) (pr-str e)])
(do (def d (delay [1 2])) nil)
[(realized? d) @d (force d) (realized? d) (force 7) (realized? 7) (type d) (delay? d)]
(do (def delay-tries (atom 0)) nil)
(do (def flaky-delay (delay (if (< (swap! delay-tries inc) 2) (throw (ex-info "dboom" {})) :fine))) nil)
[(try @flaky-delay (catch e (ex-message e))) @flaky-delay @delay-tries]
[(type (iterate inc 0)) (take 3 (iterate inc 0)) (vec (take 2 (iterate inc 5))) (nth (iterate inc 0) 10)]
[(= (map inc [1 2]) [2 3]) (= (lazy-seq nil) []) (= (lazy-seq nil) nil) (= () (lazy-seq nil))]
[(into [] (map inc [1 2])) (into #{} (lazy-seq [1 1])) (nth (map inc [1 2 3]) 1) (last (map inc [1 2 3]))]
