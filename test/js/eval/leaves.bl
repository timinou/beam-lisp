;; test/js/eval/leaves.bl — host leaves (erlang/lists/maps/String/Vector/Set/Sorted/Num/Decimal/
;; Refs/ExInfo/…) called directly, each answer measured on the BEAM first
;; (2026-10-04). priv/lib/js/host-leaves.mjs + lazy.mjs must print the same.
;; Left out on purpose: forms whose BEAM answer prints a STRUCT's internals
;; (%BeamLisp.Vector{items: …}, %ArgumentError{…}) — a layout JS does not
;; imitate (PLAN-163 contract C1) — and cross-family Sorted keys, whose order
;; is rt.bl compare's (test/js/eval/compare.bl, the gate for
;; compiled core).
(String/split "a b  c")
(String/split "a,b,,c" ",")
(String/split "a,b,,c" "," (list (tuple :parts 2)))
(String/split "a,b,,c" "," (list (tuple :trim true)))
(String/graphemes "e\u0301x")
(String/length "é👍🏽")
(String/slice "héllo" 1 3)
(String/replace "aXbXc" "X" "-")
(String/trim "  a  ")
(String/trim_leading "  a ")
(String/trim_trailing " a  ")
(String/contains? "abc" "b")
(String/starts_with? "abc" "ab")
(String/ends_with? "abc" "bc")
(String/upcase "aé")
(String/downcase "AÉ")
(String/to_atom "x")
(erlang/++ (list 1) (list 2))
(erlang/integer_to_binary 42)
(erlang/iolist_to_binary (list "a" (list 98 "c")))
(erlang/max 1 2.0)
(erlang/make_tuple 3 :x)
(erlang/setelement 2 (tuple 1 2 3) :y)
(erlang/atom_to_binary :abc :utf8)
(erlang/binary_to_atom "abc" :utf8)
(erlang/bnot 0)
(erlang/bnot -1)
(erlang/bnot 2147483647)
(erlang/bnot 2147483648)
(erlang/bnot 4294967295)
(erlang/bnot 4294967296)
(erlang/bnot -4294967296)
(erlang/bnot 9007199254740991)
(erlang/bnot -9007199254740991)
(erlang/bnot 9007199254740992)
(erlang/bnot -9007199254740992)
(erlang/bnot 9007199254740993)
(erlang/bnot -9007199254740993)
;; invalid operands must RAISE on both targets; catch to a stable value, never a
;; host message (JS and BEAM error text differ by design, contract C1)
(try (erlang/bnot 1.0) (catch e :raised))
(try (erlang/bnot 1.5) (catch e :raised))
(try (erlang/bnot 1.5M) (catch e :raised))
(try (erlang/bnot "s") (catch e :raised))
(try (erlang/bnot nil) (catch e :raised))
(try (erlang/bnot true) (catch e :raised))
(try (erlang/bnot false) (catch e :raised))
(erlang/is_boolean nil)
(erlang/is_map_key :a {:a 1})
(lists/duplicate 3 :z)
(lists/nthtail 2 (list 1 2 3 4))
(lists/join :x (list 1 2 3))
(lists/foldl (fn [x acc] (+ x acc)) 0 (list 1 2 3))
(lists/foldr (fn [x acc] (cons x acc)) () (list 1 2 3))
(lists/flatmap (fn [x] (list x x)) (list 1 2))
(lists/any (fn [x] (> x 2)) (list 1 3))
(Enum/join (list "a" "b") ",")
(Enum/to_list (list 1 2))
(Map/delete {:a 1 :b 2} :a)
(maps/map (fn [k v] (+ v 1)) {:a 1})
(Elixir.Kernel/inspect "s")
(Elixir.Kernel/inspect :k)
(BeamLisp.Num/add 1 2)
(BeamLisp.Num/div 1 4)
(BeamLisp.Num/div 4 2)
(BeamLisp.Num/num_eq 1 1.0)
(BeamLisp.Num/neg 5)
(BeamLisp.Num/lt 1 2.5)
(BeamLisp.Decimal/signum -1.5M)
(BeamLisp.Decimal/to_literal 1.50M)
(BeamLisp.Decimal/to_plain_string 1.50M)
(binary/split "a=b=c" "=")
(Float/ratio 0.5)
(BeamLisp.Vector/conj [1] 2)
(BeamLisp.Vector/assoc [1 2] 1 :x)
(BeamLisp.Vector/count [1 2])
(BeamLisp.Vector/first [])
(BeamLisp.Vector/nth [1 2] 5)
(BeamLisp.Set/add #{1} 2)
(BeamLisp.Set/del #{1 2} 1)
(BeamLisp.Set/member? #{1} 1)
(BeamLisp.Set/count #{1 2})
(BeamLisp.Set/new (list 1 1 2))
(BeamLisp.Sorted/map_to_list (BeamLisp.Sorted/map_new (list (tuple 2 :b) (tuple 1 :a))))
(BeamLisp.Sorted/map_get (BeamLisp.Sorted/map_new (list (tuple 1 :a))) 1 :d)
(BeamLisp.Sorted/map_get (BeamLisp.Sorted/map_new (list (tuple 1 :a))) 9 :d)
(BeamLisp.Sorted/last_entry (BeamLisp.Sorted/map_new (list (tuple 2 :b) (tuple 1 :a))))
(BeamLisp.Sorted/last_key (BeamLisp.Sorted/map_new ()))
(BeamLisp.Sorted/set_to_list (BeamLisp.Sorted/set_new (list 3 1 2 1)))
(BeamLisp.Sorted/set_count (BeamLisp.Sorted/set_new (list 3 1)))
(BeamLisp.Sorted/map_count (BeamLisp.Sorted/map_new ()))
(BeamLisp.Sorted/map_has_key? (BeamLisp.Sorted/map_new (list (tuple 1 :a))) 1)
(BeamLisp.Sorted/map_to_list (BeamLisp.Sorted/map_delete (BeamLisp.Sorted/map_new (list (tuple 1 :a) (tuple 2 :b))) 1))
(BeamLisp.Sorted/set_to_list (BeamLisp.Sorted/set_del (BeamLisp.Sorted/set_add (BeamLisp.Sorted/set_new ()) 5) 7))
(BeamLisp.Sorted/set_member? (BeamLisp.Sorted/set_new (list 1)) 1)
(BeamLisp.ExInfo/ex_message (BeamLisp.ExInfo/ex_info "m" {:a 1}))
(BeamLisp.ExInfo/ex_data (BeamLisp.ExInfo/ex_info "m" {:a 1}))
(BeamLisp.ExInfo/ex_message "plain")
(BeamLisp.ExInfo/ex_data 5)
(try (BeamLisp.ExInfo/raise_payload {:k 1}) (catch e [(ex-message e) (ex-data e)]))
(try (BeamLisp.ExInfo/raise_payload "str") (catch e [(ex-message e) (ex-data e)]))
(BeamLisp.Refs/deref (BeamLisp.Refs/atom 5))
(let [a (BeamLisp.Refs/atom 1)] (BeamLisp.Refs/swap! a (fn [x] (+ x 1))) (BeamLisp.Refs/deref a))
(let [v (BeamLisp.Refs/volatile 1)] (BeamLisp.Refs/vreset! v 9))
(BeamLisp.Record/record? {:a 1})
(BeamLisp.Multi/type_of 1)
(BeamLisp.Multi/type_of "s")
(BeamLisp.Multi/type_of [1])
(BeamLisp.Multi/type_of {:a 1})
(BeamLisp.Multi/type_of nil)
(BeamLisp.Multi/type_of :k)
(BeamLisp.Multi/type_of (list 1))
(BeamLisp.Multi/type_of 1.5)
(BeamLisp.Multi/type_of #{1})
(BeamLisp.Multi/type_of (fn [] 1))
(BeamLisp.Transient/get (BeamLisp.Transient/transient {:a 1}) :a nil)
(BeamLisp.Transient/persistent! (BeamLisp.Transient/transient [1 2]))
(ex-message (Elixir.ArgumentError/exception "bad"))
(ex-message (Elixir.FunctionClauseError/exception (list (tuple :module :m) (tuple :function :f) (tuple :arity 1))))
(Elixir.Kernel/inspect 1.0)
(Elixir.Kernel/inspect nil)
(Elixir.Kernel/inspect (list 1 :a))
(Elixir.Kernel/inspect (tuple 1 "x"))
(Elixir.Kernel/inspect {:a 1})
(Elixir.Kernel/inspect 'sym)
(Elixir.Kernel/inspect :"Elixir.Foo")
(Elixir.Kernel/inspect "q\"x")
(BeamLisp.Env/match (tuple (tuple "nope-ns" :"$1") :_))


;; ── lists/reverse/2 — ONE exact reverse onto an arbitrary, UNFORCED tail ──
;; The first list must be proper, and an empty first list returns the tail
;; ITSELF. Print only scalars here: an improper result whose tail is a lazy
;; node/struct does not print the same on both targets (PLAN-163 contract C1).
(lists/reverse (list 1 2 3))
(lists/reverse (list 1 2 3) (list 9 8))
(lists/reverse () (list 7 8))
(lists/reverse () :end)
(lists/reverse () 42)
;; walk the improper result with raw hd/tl, never a seq op (their is_list
;; answer for an improper chain differs from the two targets' own tests)
(let [r (lists/reverse (list 1 2 3) :end)]
  [(erlang/hd r) (erlang/hd (erlang/tl r)) (erlang/hd (erlang/tl (erlang/tl r)))
   (erlang/tl (erlang/tl (erlang/tl r)))])
;; indirect: the one leaf through erlang/apply (statically linked)
(erlang/apply :lists :reverse (list (list 1 2 3) (list 9)))
;; malformed first args raise on both targets, caught to a stable marker; both
;; arities share the one validation, and a valid two-arg call raises nothing
(try (lists/reverse 5 (list 9)) (catch e :raised))
(try (lists/reverse nil (list 9)) (catch e :raised))
(try (lists/reverse "s" (list 9)) (catch e :raised))
(try (lists/reverse (cons 1 2) (list 9)) (catch e :raised))
(try (lists/reverse 5) (catch e :raised))
(try (lists/reverse (cons 1 2)) (catch e :raised))
(lists/reverse (list 1 2) ())
;; a lazy tail is never forced by reverse/2: the prefix, then the force count
(do (def rev-forces (atom 0)) nil)
(do (def rev-tail (lazy-seq (do (swap! rev-forces inc) (list :tail)))) nil)
(let [r (lists/reverse (list 1 2 3) rev-tail)
      t (erlang/tl (erlang/tl (erlang/tl r)))]
  [(erlang/hd r) (erlang/hd (erlang/tl r)) (erlang/hd (erlang/tl (erlang/tl r)))
   (deref rev-forces) (first t) (deref rev-forces)])
;; an empty first list returns the tail exactly, still unforced
(do (def rev-forces2 (atom 0)) nil)
(do (def rev-tail2 (lazy-seq (do (swap! rev-forces2 inc) (list :tail2)))) nil)
(let [t (lists/reverse () rev-tail2)]
  [(deref rev-forces2) (realized? t) (first t) (deref rev-forces2)])
;; Text binaries: byte offsets, non-overlap, earliest/longest pattern selection.
(binary/at "é" 1)
(binary/match "é_a" "_")
(binary/match "abc" "z")
(binary/match "abab" (list "a" "ab"))
(binary/matches "aaaa" "aa")
(binary/matches "" "a")
(binary/part "éa" 0 2)
(binary/part "abcd" 3 -2)
(binary/part "abcd" 4 0)
(try (binary/at "x" 1) (catch e :raised))
(try (binary/part "abc" 2 2) (catch e :raised))
(try (binary/match "abc" "") (catch e :raised))

;; Stable native/JS answers: never compare platform-specific printed ref ids.
(let [a (erlang/make_ref) b (erlang/make_ref)]
 [(erlang/is_reference a) (identical? a a) (identical? a b)
  (get {a nil b false} a :missing) (get {a nil b false} b :missing)
  (get {a nil b false} (erlang/make_ref) :missing)])
[(get-in {:a {:b nil}} [:a :b] :missing)
 (get-in {:a {:b false}} [:a :b] :missing)
 (get-in {:a {}} [:a :b] :missing)
 (get-in {:a nil} [:a :b] :missing)
 (get-in {:a 1} [] :missing)]
