;; test/js/eval/compare.bl — the cross-family order of `compare`/`sort` (rt.bl
;; family-rank: nil < bool < number < text < symbol < keyword < sequential …),
;; measured on the BEAM 2026-10-04. The hand-written core.mjs orders keywords
;; before text; COMPILED core (PLAN-163 U2) gets this from rt.bl by construction.
(compare "b" :a)
(compare :a "b")
(sort [3 "b" :a nil true (quote s) [1]])
(compare 1 "a")
(sort-by identity [:b "a" 2 nil])
