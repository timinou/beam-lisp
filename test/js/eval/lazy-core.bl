;; test/js/eval/lazy-core.bl — lazy PRODUCERS (map/filter/concat/distinct
;; chunking: 32 realised per step, a halted fold publishes nothing, bounded
;; printing, `list?`/`type` of a mapped seq). The hand-written core.mjs is
;; eager; this corpus is the gate for core COMPILED from priv/boot (PLAN-163
;; U2), which gets these from rt.bl by construction.
(do (def calls (atom 0)) nil)
(do (def once (map (fn [x] (swap! calls inc) x) (range 5))) nil)
[(reduce + once) (vec once) (count once) @calls]
(do (def halted-calls (atom 0)) nil)
(do (def halted (map (fn [x] (swap! halted-calls inc) x) (range 100))) nil)
[(reduce (fn [a x] (if (> x 3) (reduced a) (+ a x))) 0 halted) @halted-calls (count halted) @halted-calls]
(let [c (atom 0) s (map (fn [x] (swap! c inc) x) (range 100))] (first s) @c)
(let [x (map inc [1 2])] [(realized? x) (first x) (realized? x)])
(let [s (map inc [1 2])] [(list? s) (seq? s) (sequential? s) (coll? s) (type s)])
(let [s (map inc [1 2])] [(type (rest s)) (type (next s)) (type (cons 0 s)) (type (conj s 0))])
(let [a (atom 0) x (map (fn [v] (swap! a inc) v) (range 3))] [(type (doall x)) @a (dorun (map identity [1]))])
[(str (map inc [1 2])) (print-str (map inc [1]))]
[(type (concat [1] [2])) (take 3 (concat [1] (iterate inc 2)))]
(try (vec (map (fn [x] (if (= x 40) (throw (ex-info "at40" {:x x})) x)) (range 100))) (catch e [(ex-message e) (ex-data e)]))
(take 3 (distinct (cycle [1 2 3])))
(let [s (filter even? (range 10))] [(first s) (count s) (vec (take-while #(< % 5) s))])

; ── input/1 cursorizes ONLY a proper finite list longer than 32; a chain with
;    a lazy tail must walk THROUGH the tail, never truncate at it (PLAN-165 R2).
(let [mk (fn [n] (reduce (fn [a x] (cons x a)) (list) (range n)))]
  [(count (map inc (mk 31))) (count (map inc (mk 32)))
   (count (map inc (mk 33))) (count (map inc (mk 40)))
   (count (map inc (mk 65)))])
(let [mk (fn [n] (reduce (fn [a x] (cons x a)) (lazy-seq (list 99)) (range n)))]
  [(count (map identity (mk 31))) (count (map identity (mk 32)))
   (count (map identity (mk 33))) (count (map identity (mk 40)))
   (count (map identity (mk 65))) (last (map identity (mk 40)))])
(let [mk (fn [n] (reduce (fn [a x] (cons x a)) (lazy-seq (list)) (range n)))]
  [(count (map identity (mk 31))) (count (map identity (mk 33)))
   (count (map identity (mk 65)))])
(let [forced (atom 0)
      s (reduce (fn [a x] (cons x a))
                (lazy-seq (do (swap! forced inc) (list 99)))
                (range 40))]
  [(count (map identity s)) @forced])
(let [forced (atom 0)
      s (reduce (fn [a x] (cons x a))
                (lazy-seq (do (swap! forced inc) (list 7)))
                (range 40))]
  [(count (filter odd? s)) @forced])
(let [forced (atom 0)
      s (reduce (fn [a x] (cons x a))
                (lazy-seq (do (swap! forced inc) (list 99)))
                (range 40))]
  [(count (concat s)) @forced])
[(count (map inc (vec (range 40)))) (count (map inc (vec (range 32))))]

; ── chunk reversal (PLAN-163 R1): the accumulator is reversed ONCE onto the
;    lazy tail, so emitting a continuing chunk copies each element a single
;    time. These pin the boundary sizes, a filter that rejects a whole first
;    chunk, a whole finite input, and one late match in a partial final chunk.
[(vec (map inc (range 0))) (vec (map inc (range 1)))]
[(count (map identity (range 63))) (count (map identity (range 64))) (count (map identity (range 65)))]
[(vec (filter (fn [x] (= x 40)) (range 100)))]
[(vec (filter (fn [_] false) (range 100))) (count (filter (fn [_] false) (range 33)))]
[(vec (filter (fn [x] (= x 64)) (range 65)))]
[(vec (filter even? (range 65)))]
