; test/js/eval/metadata.bl — nil? and metadata wrappers, as ONE top-level form
; per case (no ns needed: the compiled-fn runner wraps each form in a function
; and compares BEAM against the compiled-core JS build).
;
; A `{:meta form m}` reader wrapper is a tuple headed by `:meta`; under `=` it
; IS its `form`, nested wrappers included, and nil? must defer to that equality.
; But `=` is not truthiness: a `{:meta nil m}` wrapper is nil? (and some? says
; no) yet is a truthy VALUE, so `not` / `if` / `boolean` disagree with nil?.
; A `{:meta false m}` wrapper is = to false yet likewise truthy by term.
; Ordinary tuples and the map/vector lookalikes are not wrappers.

;; nil? agrees with `=`/eqv on wrappers, nested wrappers, and near-wrappers
(= (tuple :meta nil {}) nil)
(nil? (tuple :meta nil {}))
(nil? (tuple :meta (tuple :meta nil {}) {}))
(nil? (tuple :meta (tuple :meta (tuple :meta nil {}) {}) {}))
(nil? (tuple :meta nil))
(nil? (tuple :meta :a {}))
(nil? (tuple :meta false {}))
(nil? (tuple :a))
(nil? (tuple :foo nil {}))
(nil? (tuple))
(nil? {:meta nil})
(nil? [:meta nil])
(nil? nil)
(nil? 1)

;; nil? vs eqv, directly — the same oracle the BEAM leaf-cost test pins
(= (nil? (tuple :meta nil {}))
   (BeamLisp.Ns.Rt/eqv (tuple :meta nil {}) nil))
(= (nil? (tuple :meta :a {}))
   (BeamLisp.Ns.Rt/eqv (tuple :meta :a {}) nil))

;; some? complements nil?, and is NOT truthiness
(some? (tuple :meta nil {}))
(some? (tuple :meta false {}))
(some? nil)

;; truthiness: `not` / `if` / `boolean` are TERM tests, so a wrapper is truthy
(not (tuple :meta nil {}))
(if (tuple :meta nil {}) :truthy :falsey)
(boolean (tuple :meta nil {}))
(not (tuple :meta false {}))
(boolean (tuple :meta false {}))
(not false)

;; nil? as a first-class value and as a linked call under map
(let [p nil?] [(p nil) (p (tuple :meta nil {})) (p 1)])
(vec (map nil? [nil (tuple :meta nil {}) 1 false]))

;; keep drops nil? results: a metadata-nil wrapper is dropped, `false` is kept
(vec (keep (fn [x] (if (= x :wrap) (tuple :meta nil {}) (if (= x :false) false x)))
           [:a :wrap :false :z]))
(count (keep (fn [_] (tuple :meta nil {})) [:x :y]))
(vec (keep (fn [_] false) [:x]))

;; ── with-meta on a lazy node: ONE native memo resource per node ──────────
;; `with-meta` is an immutable update of the VALUE that SHARES the struct's
;; `:resource` (priv/host/meta.bl), so realization, retry, the fold claim and
;; the cycle guard are the node's — an alias never re-runs the thunk and is
;; never a different identity to the cycle guard. The counters make the
;; sharing observable; the metadata stays value-owned and independent.

;; alias and original share one realization, one call
(do (def wm-calls (atom 0)) nil)
(do (def wm-s (lazy-seq (do (swap! wm-calls inc) (list :a :b)))) nil)
(do (def wm-alias (with-meta wm-s {:tag :alias})) nil)
[(meta wm-s) (meta wm-alias) (realized? wm-alias) (first wm-alias) @wm-calls
 (first wm-s) (count wm-s) @wm-calls (vec wm-alias)]

;; metadata is value-owned: the original is untouched, each alias its own,
;; nil clears, and every alias walks the SAME realized value
(do (def wm-plain (lazy-seq (list 1 2))) nil)
(do (def wm-a (with-meta wm-plain {:k 1})) nil)
(do (def wm-b (with-meta wm-plain {:k 2})) nil)
[(meta wm-plain) (meta wm-a) (meta wm-b) (meta (vary-meta wm-a assoc :z 9))
 (meta (with-meta wm-plain nil)) (vec wm-a) (vec wm-plain)]

;; a direct self-cycle seen through the alias stays terminal cyclic_memo
(do (def wm-cyc (lazy-seq (cons 1 wm-cyc))) nil)
(do (def wm-cyc-alias (with-meta wm-cyc {:tag :cyc})) nil)
(try (vec (take 3 wm-cyc-alias)) (catch e (ex-message e)))
(try (vec (take 3 wm-cyc)) (catch e (ex-message e)))

;; a recursive force across the alias is terminal recursive_force, and the
;; thunk is never run twice
(do (def wm-rf-calls (atom 0)) nil)
(do (def wm-rf (lazy-seq (do (swap! wm-rf-calls inc) (cons 1 (seq wm-rf))))) nil)
(do (def wm-rf-alias (with-meta wm-rf {:tag :rf})) nil)
[(try (first wm-rf-alias) (catch e (ex-message e))) @wm-rf-calls
 (try (first wm-rf) (catch e (ex-message e))) @wm-rf-calls]

;; the fold protocol shares too: reduce through either value runs the producer
;; once, and the realized value is the node's
(do (def wm-fc (atom 0)) nil)
(do (def wm-map (map (fn [x] (swap! wm-fc inc) x) (range 5))) nil)
(do (def wm-map-alias (with-meta wm-map {:tag :m})) nil)
[(reduce + wm-map-alias) @wm-fc (reduce + wm-map) @wm-fc (vec wm-map) @wm-fc]
