;; test/js/eval/callbacks.bl — the prepared reduce/map/filter CALLBACK path.
;; A native fn, a fixed `$blfn` arm, a variadic adapter at min 0/1/2,
;; fixed-wins precedence, keyword/map selectors, invalid callables on empty vs
;; nonempty sources, the original `+` numeric behaviour, callable capture, and
;; evaluation order.
;;
;; Cross-target protocol: every may-fail case is wrapped to a stable
;; `[:ok v]`/`[:error]` FLAG, so the BEAM oracle and the COMPILED core print
;; the same thing without depending on an error message. Each top-level form is
;; one corpus case; `outcome` is the single fixture, declared first.
(defn- outcome [thunk] (try [:ok (thunk)] (catch e [:error])))

(outcome (fn [] (reduce (fn [a x] (+ a x)) 0 [1 2 3])))
(outcome (fn [] (reduce (fn ([a] a) ([a b] (+ a b))) 0 [1 2 3])))
(outcome (fn [] (reduce (fn [& xs] (count xs)) 0 [1 2 3])))
(outcome (fn [] (reduce (fn [a & xs] (count xs)) 0 [1 2 3])))
(outcome (fn [] (reduce (fn [a b & xs] (count xs)) 0 [1 2 3])))
(outcome (fn [] (reduce (fn ([a b] :fixed) ([a b c & r] :variadic)) 0 [1 2 3])))
(outcome (fn [] (reduce :k {:k 5} [{:k 1}])))
(outcome (fn [] (reduce {:x :y} 0 [[:x]])))
(outcome (fn [] (reduce 5 :init [])))
(outcome (fn [] (reduce 5 :init [1])))
(outcome (fn [] (reduce nil :init [])))
(outcome (fn [] (reduce nil :init [1])))
(outcome (fn [] (reduce + 0 [1.5 2.5])))
(outcome (fn [] (reduce + 0 [9007199254740992 1])))
(outcome (fn [] (reduce + 0 [1 2 3])))
(outcome (fn [] (reduce + 0 ["a" 1])))
(let [c (atom 0) r (reduce (fn [a x] (swap! c inc) (+ a x)) 0 (range 5))] [r @c])
(let [slot (atom (fn [a b] (+ a b)))
      captured @slot
      first (reduce captured 0 [1 2])]
  (reset! slot (fn [a b] (+ a 10)))
  [first (reduce @slot 0 [1 2])])
(vec (map (fn [x] (* 2 x)) [1 2 3]))
(vec (map (fn ([x] (* 3 x)) ([x y] (+ x y))) [1 2 3]))
(vec (map (fn [& xs] (count xs)) [1 2 3]))
(vec (map (fn [a & xs] a) [1 2 3]))
(vec (map :k [{:k 1} {:k 2}]))
(vec (filter (fn [x] (odd? x)) [1 2 3]))
(vec (filter (fn ([x] (odd? x)) ([x y] true)) [1 2 3]))
(vec (filter :k [{:k 1} {} {:k 2}]))

;; A variadic rest is always a proper list, including exactly the minimum.
[(erlang/is_list ((fn [& xs] xs)))
 (erlang/is_list ((fn [x & xs] xs) :x))
 (erlang/is_list ((fn [x y & xs] xs) :x :y))
 (erlang/is_list (apply list []))
 (erlang/is_list (apply list (map identity [])))]
