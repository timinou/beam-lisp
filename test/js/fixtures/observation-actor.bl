(ns ^:js observation.fixture)
(defn check [value message]
 (when-not value (throw (js/Error. message))))
(defn row-for [rows id]
 (if (empty? rows) nil
  (if (= id (:id (first rows))) (first rows) (row-for (rest rows) id))))
(defn child [] (receive :stop :ok))
(defn parent [recipient]
 (let [pid (rt-spawn-owned child [])]
  (rt-send recipient [:child pid])
  (receive :stop :ok)))
(defn main []
 (let [me (rt-self) parent-pid (rt-spawn-owned parent [me])
       independent (rt-spawn child [])]
  (receive [:child c]
   (let [snapshot (rt-observation 128)
         child-row (row-for (:resources snapshot) c)
         ref (rt-monitor c)]
    (check (= parent-pid (:owner child-row)) "owned edge missing")
    (check (= 4 (:total snapshot)) "snapshot changed actor population")
    (check (:truncated (rt-observation 1)) "bounded snapshot missing truncation")
    (rt-send parent-pid :stop)
    (receive [:down _ :process _ reason]
      (check (= :shutdown reason) "owned child must shut down with owner")
      (after 1000 (throw (js/Error. "owned child survived parent"))))
    (check (rt-alive? independent) "ordinary spawn acquired accidental ownership")
    (rt-send independent :stop)))
  (.log js/console "owned actor observation fixture PASS")))
