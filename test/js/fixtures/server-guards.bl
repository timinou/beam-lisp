(ns ^:js server.guard-fixture)
(defn check [value message] (when-not value (throw (js/Error. message))))

(proc/defserver before
 (init [initial] (ok initial))
 (handle-call [:take n] :when (and (int? n) (> n 0) (>= balance n)) [_ balance]
  (reply :accepted (- balance n)))
 (handle-call [:take _] [_ balance] (reply :refused balance))
 (handle-call :read [_ balance] (reply balance balance)))

(proc/defserver after
 (init [initial] (ok initial))
 (handle-call [:take n] [_ balance] :when (and (int? n) (> n 0) (>= balance n))
  (reply :accepted (- balance n)))
 (handle-call [:take _] [_ balance] (reply :refused balance))
 (handle-call :read [_ balance] (reply balance balance))
 (handle-cast [:add n] [balance] :when (and (int? n) (> n 0)) (noreply (+ balance n)))
 (handle-cast _ [balance] (noreply balance))
 (handle-info [:add n] :when (and (int? n) (> n 0)) [balance] (noreply (+ balance n)))
 (handle-info _ [balance] (noreply balance)))

(proc/defserver never
 (init [initial] (ok initial))
 (handle-call :read [_ balance] :when nil (reply :wrong balance))
 (handle-call :read [_ balance] (reply balance balance)))

(defn exercise [entry]
 (let [p (rt-spawn entry [10])]
  (doseq [bad ["wrong" nil 0 -1 11]]
   (check (= :refused (rt-call p [:take bad])) "invalid request entered guarded body"))
  (check (= 10 (rt-call p :read)) "rejected input changed state")
  (check (= :accepted (rt-call p [:take 3])) "valid request refused")
  (check (= 7 (rt-call p :read)) "state guard used wrong binding")
  (rt-stop p)))

(defn main []
 (exercise before)
 (exercise after)
 (let [p (rt-spawn after [10]) n (rt-spawn never [10])]
  (rt-cast p [:add "wrong"])
  (rt-send p [:add "wrong"])
  (check (= 10 (rt-call p :read)) "invalid cast/info changed state")
  (rt-cast p [:add 2])
  (rt-send p [:add 3])
  (check (= 15 (rt-call p :read)) "valid cast/info did not execute")
  (check (= 10 (rt-call n :read)) "nil guard became unguarded")
  (rt-stop p) (rt-stop n))
 (.log js/console "native/JS callback guard contract PASS"))
