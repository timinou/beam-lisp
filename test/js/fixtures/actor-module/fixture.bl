(ns ^:js actor-module.fixture)
(defn values []
 {:first (first "beam") :rest (vec (rest [7 8]))
  :mapped (mapv (fn [x] (+ x 1)) [1 2 3])
  :sorted (vec (sort-by :n [{:n 3} {:n 1}]))
  :lookup (:n {:n 42}) :applied (apply + [1 2 3])})
(defn recursive [n] (if (zero? n) 0 (+ n (recursive (dec n)))))
(defn iterated [n] (loop [i n sum 0] (if (zero? i) sum (recur (dec i) (+ sum i)))))
(defn variadic ([x] x) ([x y & more] (+ x y (apply + more))))
(defn raises [] (try (throw (ex-info "expected" {:n 1})) (catch e (ex-data e))))
(defn callback [] (.map #js [1 2 3] (fn [x] (+ x 1))))
(defn tail-recursive [n] (if (zero? n) 42 (tail-recursive (dec n))))
(defn guarded-return [f] (try (f) (catch e (str "caught " (ex-message e)))))
