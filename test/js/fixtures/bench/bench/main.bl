(ns bench.main
  (:require [clojure.string :as string]))

(defn- line-of [i] (str "line " i " with some text"))

(defn make-doc [n] (loop [i 0 v []] (if (< i n) (recur (inc i) (conj v (line-of i))) v)))

(defn insert-char
  "One keystroke: insert `ch` at column `col` of line `row` in a document of lines."
  [doc row col ch]
  (let [line (nth doc row)]
    (assoc doc row (str (subs line 0 col) ch (subs line col)))))

(defn type-n [doc n]
  (loop [d doc i 0] (if (< i n) (recur (insert-char d 500 5 "x") (inc i)) d)))

(defn count-words [doc]
  (reduce (fn [acc line] (+ acc (count (string/split line " ")))) 0 doc))

(defn case-results
  "Small deterministic document workloads used by the compiled-core differential."
  []
  (let [doc (make-doc 501)
        typed (type-n doc 3)]
    [(count doc) (count-words doc) (nth doc 500) (nth typed 500)
     (= doc (make-doc 501)) (insert-char ["abc"] 0 1 "X") (make-doc 0)]))
