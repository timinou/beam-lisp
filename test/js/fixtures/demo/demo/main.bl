(ns demo.main
  (:require [demo.util :as u]))

(defn fact [n] (if (<= n 1) 1 (* n (fact (dec n)))))

(defn describe
  ([x] (describe x "thing"))
  ([x label] (str label ": " (pr-str x))))

(defn classify [x]
  (cond
    (nil? x) :nothing
    (string? x) :text
    (and (int? x) (neg? x)) :negative
    (int? x) :number
    (vector? x) :many
    :else :other))

(defn tally [words]
  (reduce (fn [m w] (update m w (fnil inc 0))) {} words))

(defn safe-div [a b]
  (try (quot a b) (catch e (str "error: " (ex-message e)))))

(defn pick [{:keys [a b] :or {b 2}} [x & more]]
  [a b x (count more)])

(defn run []
  {:fact (fact 20)
   :big (fact 25)
   :sq (u/sum-squares 10)
   :greet (str u/greeting ", world")
   :desc [(describe 42) (describe [1 2] "pair")]
   :classes (mapv classify [nil "s" -3 7 [1] :k])
   :tally (tally ["a" "b" "a" "c" "a"])
   :div [(safe-div 7 2) (safe-div 1 0)]
   :pick (pick {:a 1} [10 20 30])
   :kw-call (:x {:x 9})
   :set-call (#{:a :b} :a)
   :sorted (sort-by - [3 1 2])
   :float (/ 8 2)
   :eq [(= [1 2] '(1 2)) (= 1 1.0)]})
