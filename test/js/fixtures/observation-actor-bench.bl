(ns ^:js observation.bench)
(defn child [] (receive :stop :ok))
(defn main []
 (loop [left 128]
  (when (> left 0) (rt-spawn-owned child []) (recur (- left 1))))
 (let [samples #js []]
  (loop [left 120]
   (when (> left 0)
    (let [before (.now js/performance) snapshot (rt-observation 128)
          elapsed (- (.now js/performance) before)]
     (.push samples elapsed))
    (recur (- left 1))))
  (.log js/console (.stringify js/JSON #js {:kind "actor-observation" :actors 129 :rows 128 :samples samples}))))
