; test/js/fixtures/seed/seed/peer.bl — one namespace that hands out the raw
; first-class seeded core values, so a SECOND namespace can ask whether it gets
; the same value. `map` and `+` are seed rows (rt.bl seed-rows/seed-closures),
; not defns of `core`, so a reference here is the raw registry value.
(ns seed.peer)

(defn seeded-map
  "The seeded `map` value, as a first-class value (not called)."
  []
  map)

(defn seeded-plus
  "The seeded `+` value, as a first-class value (not called)."
  []
  +)

(defn seeded-fixed
  "A seeded fixed fn (`first` is one fixed arity, no variadic clause), so a
   caller can compare it with a `{:$blfn …}` multi-fn tuple."
  []
  first)
