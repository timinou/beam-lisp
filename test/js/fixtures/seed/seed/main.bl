; test/js/fixtures/seed/seed/main.bl — cross-namespace seed identity, direct and
; first-class invocation, and late binding of a seeded var. `case-results`
; returns one vector of observations that must be EQUAL on the BEAM and on the
; self-hosted JS target; nothing runs at load (no top-level effects), so the
; fixture can be imported without changing the registry.
(ns seed.main
  (:require [seed.peer :as peer]))

(defn case-results
  "One no-argument vector, identical on BEAM and on compiled JS:
     [cross-namespace raw identity, language equality, is_function answer,
      direct fixed call, direct variadic call, first-class fixed call,
      first-class variadic call, keyword call, map call,
      [lookup while temporarily rebound, captured old value still live],
      restored identity].
   The temporary rebind restores the registry in a `finally`, even on
   exception."
  []
  (let [m (peer/seeded-map)             ; raw seeded `map`, captured first
        p (peer/seeded-plus)            ; raw seeded `+`
        fx (peer/seeded-fixed)          ; a seeded fixed fn (first)
        old m]
    [(identical? m map)                 ; cross-namespace raw identity: true
     (= m map)                          ; language equality: true
     (erlang/is_function m)             ; a multi-fn tuple is not a fn: false
     (erlang/is_function fx)            ; a seeded fixed fn is: true
     (identical? fx first)              ; cross-namespace fixed identity: true
     (map inc [1 2 3])                  ; direct fixed call: (2 3 4)
     (+ 1 2 3)                          ; direct variadic call: 6
     (m inc [1 2 3])                    ; first-class fixed call: (2 3 4)
     (p 1 2 3)                          ; first-class variadic call: 6
     (fx [7 8])                         ; first-class fixed seed call: 7
     (:x {:x 9})                        ; keyword callable: 9
     ({:a 1} :a)                        ; map callable: 1
     ; rebind `core/map`: the LOOKUP sees the new value, while the captured `m`
     ; still works; `finally` restores even if the body throws
     (try
       (BeamLisp.Env/intern "core" "map" :rebound)
       [map (m inc [4 5])]              ; [:rebound (5 6)]
       (catch e [:error (ex-message e)])
       (finally (BeamLisp.Env/intern "core" "map" old)))
     (identical? old map)]))            ; the registry is the original again: true
