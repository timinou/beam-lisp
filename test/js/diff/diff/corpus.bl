; test/js/diff/corpus.bl — the differential corpus for the JS sync profile.
;
; Every `(defn case-*)` here is a zero-argument function whose RESULT is
; printed with `pr-str` on BEAM and in the JS sync profile. The two outputs
; must be identical, line for line (test/js/diff.test.mjs runs both). Results
; are vectors so map-ordering never enters the comparison; error MESSAGES are
; not compared (BEAM says "bad argument in arithmetic expression", JS "quot by
; zero") — only the fact that an error happened, via `failed?`.
;
; The corpus exercises what UI code leans on: collections, strings by
; codepoint, numbers (exact ints, floats), destructuring, multi-arity, loops,
; closures, higher-order fns, try/catch, and the `=` vs key-equality split.

(ns diff.corpus)

(defn- failed? [f] (try (do (f) false) (catch e true)))

(defn case-numbers []
  [(+ 1 2) (- 10 3 2) (* 2 3 4) (/ 8 2) (/ 1 4) (quot 17 5) (rem -17 5) (mod -17 5)
   (inc 9007199254740991) (* 9007199254740993 3) (- (* 99999999999 99999999999) 1)
   (+ 1 2.5) (* 1.5 2) (max 1 5 3) (min 4 2 8) (abs -7) (= 1 1.0) (== 1 1.0) (< 1 2 3) (> 3 2 2)
   (zero? 0) (pos? -1) (neg? -1) (even? 4) (odd? 4) (int 3.9)])

(defn case-equality []
  [(= [1 2] '(1 2)) (= {:a [1]} {:a '(1)}) (= #{1 2} #{2 1}) (= nil false) (= "a" "a")
   (get {1 :a} 1.0) (contains? #{1} 1.0) (get {[1 2] :v} '(1 2)) (get {[1 2] :v} [1 2])
   (not= 1 2) (identical? :a :a) (compare 1 2) (compare "b" "a") (compare [1 2] [1 3])])

(defn case-collections []
  (let [v [1 2 3] m {:a 1 :b 2} s #{3 1 2}]
    [(conj v 4) (assoc v 1 :x) (pop v) (peek v) (nth v 2) (get v 9 :none) (count v)
     (assoc m :c 3) (dissoc m :a) (get m :a) (get m :z :dflt) (contains? m :b) (count m)
     (update m :a inc) (assoc-in {} [:x :y] 1) (update-in {:x {:y 1}} [:x :y] + 10) (get-in {:x {:y 1}} [:x :y])
     (merge m {:b 20 :c 30}) (select-keys m [:a]) (into [] (sort (keys m))) (into [] (sort (vals m)))
     (conj s 4) (disj s 1) (contains? s 2) (count s) (sort (into [] s))
     (vec (range 5)) (vec (range 2 7)) (into [] (reverse v)) (subvec [1 2 3 4 5] 1 3)
     (first v) (rest v) (next [1]) (last v) (butlast v) (second v) (empty? []) (seq []) (not-empty [1])]))

(defn case-seqs []
  (let [xs [5 3 8 1 9 2]]
    [(map inc xs) (mapv inc xs) (filter odd? xs) (filterv even? xs) (remove odd? xs)
     (reduce + xs) (reduce + 100 xs) (reduce (fn [a x] (if (> x 7) (reduced a) (+ a x))) 0 xs)
     (take 2 xs) (drop 4 xs) (take-while #(> % 2) xs) (drop-while #(> % 2) xs)
     (sort xs) (sort > xs) (sort-by - xs) (into [] (distinct [1 1 2 1 3])) (frequencies [:a :b :a])
     (into [] (partition 2 xs)) (interpose 0 [1 2 3])
     (mapcat (fn [x] [x x]) [1 2]) (concat [1] '(2) [3]) (some even? xs) (every? pos? xs)
     (keep (fn [x] (when (odd? x) (* x 10))) xs) (map-indexed (fn [i x] [i x]) [:a :b]) (get (zipmap [:a :b] [1 2]) :b)
     (group-by odd? [1 2 3 4]) (count (flatten [1 [2 [3 4]] 5])) (apply + 1 2 [3 4]) (map + [1 2] [10 20])]))

(defn case-strings []
  (let [s "héllo wörld 👍🏽!"]
    [(count s) (subs s 0 5) (subs s 12) (str "a" 1 :b nil 2.5 [1]) (pr-str ["q\"uote" :k 'sym [1 "s"]])
     (upper-case "abc") (lower-case "ÄBC") (trim "  x  ") (split "a,b,,c" ",") (join "-" [1 2 3])
     (join [1 2]) (starts-with? s "hé") (ends-with? s "!") (includes? s "wör") (index-of s "w")
     (blank? "  ") (blank? "x") (replace-str "a-b-c" "-" "+") (name :ns/kw) (namespace :ns/kw)
     (keyword "x") (keyword "a" "b") (str (symbol "s"))]))

(defn- greet
  ([who] (greet who "Hello"))
  ([who word] (str word ", " who))
  ([who word & more] (str word ", " who " +" (count more))))

(defn- classify [x]
  (cond (nil? x) :nil (string? x) :str (keyword? x) :kw (vector? x) :vec (map? x) :map (int? x) :int :else :other))

(defn case-functions []
  (let [add3 (partial + 1 2)
        both (juxt inc dec)
        neg-inc (comp - inc)
        counter (atom 0)]
    (swap! counter + 5)
    (reset! counter (* 2 @counter))
    [(greet "a") (greet "b" "Hi") (greet "c" "Yo" 1 2) (add3 10) (both 5) (neg-inc 1)
     ((complement nil?) 1) ((constantly 7) 1 2) ((fnil inc 0) nil) @counter
     (mapv classify [nil "s" :k [1] {:a 1} 3 2.5]) (:a {:a 1}) ({:b 2} :b) (#{:x} :x) (:z {} :dflt)]))

(defn case-destructuring []
  (let [{:keys [a b] :or {b 22} :as all} {:a 1}
        [x y & zs] [10 20 30 40]
        {[p q] :pair} {:pair [:p :q]}]
    [a b (count all) x y zs p q]))

(defn- fact [n] (if (<= n 1) 1 (* n (fact (dec n)))))
(defn- fib [n] (loop [a 0 b 1 i 0] (if (= i n) a (recur b (+ a b) (inc i)))))
(defn- collatz [n] (loop [n n steps 0] (cond (= n 1) steps (even? n) (recur (quot n 2) (inc steps)) :else (recur (inc (* 3 n)) (inc steps)))))

(defn case-control []
  [(fact 20) (fact 30) (fib 90) (collatz 27)
   (failed? (fn [] (quot 1 0))) (failed? (fn [] (nth [1] 5))) (failed? (fn [] (throw (ex-info "boom" {:k 1}))))
   (try (throw (ex-info "boom" {:k 1})) (catch e [(ex-message e) (ex-data e)]))
   (try 1 (finally nil)) (let [log (atom [])] (try (swap! log conj :body) (finally (swap! log conj :finally))) @log)
   (case 2 1 :one 2 :two :other) (case "z" "a" 1 3) (when false :no) (if-let [x nil] x :none)
   (when-let [x 5] (* x 2)) (some-> {:a {:b 1}} :a :b inc) (cond-> 1 true inc false (* 10))
   (-> 5 (- 1) (* 2)) (->> [1 2 3] (map inc) (reduce +))])
