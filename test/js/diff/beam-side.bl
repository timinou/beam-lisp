; test/js/diff/beam-side.bl — print every corpus case on BEAM, one line each:
;   <case-name>\t<pr-str of the result>
; Run from test/js/diff so `diff.corpus` resolves: bl run beam-side.bl
(ns diff.beam-side (:require [diff.corpus :as c]))

(def cases
  [["numbers" c/case-numbers] ["equality" c/case-equality] ["collections" c/case-collections]
   ["seqs" c/case-seqs] ["strings" c/case-strings] ["functions" c/case-functions]
   ["destructuring" c/case-destructuring] ["control" c/case-control]])

(doseq [[nm f] cases]
  (println (str nm "\t" (try (pr-str (f)) (catch e (str "#error " (ex-message e)))))))
