; gen_fixture.bl — emit the wire fixture the browser test replays.
;
; Run: mix beam_lisp.run --path priv test/browser/gen_fixture.bl > test/browser/fixture.json
;
; The browser test (client.spec.js) loads priv/live/client.js into a real
; Chromium, applies these EXACT ops (the beam-lisp differ's own output), and
; asserts the resulting DOM against `final_html`. So the JS client is proven
; against the real wire, in a real browser — not hand-written ops.

(ns test.browser.gen-fixture
  (:require [live.hiccup :as h] [live.diff :as d] [interop]))

;; a sequence of hiccup trees, as a "session" of edits
(def steps
  [[:ul [:li {:key "a"} "First"]]
   [:ul [:li {:key "a"} "First"] [:li {:key "b"} "Second"]]           ; insert b
   [:ul [:li {:key "b"} "Second"] [:li {:key "a"} "First"]]           ; reorder
   [:ul [:li {:key "b"} "Second (edited)"] [:li {:key "a"} "First"]]  ; text change
   [:ul [:li {:key "a"} "First"]]])                                   ; remove b

;; the fixture: the first mount HTML, then a patch (ops + resulting HTML) per step
(def fixture
  {:mount (h/hiccup->html (first steps))
   :patches
   (into []
     (map (fn [pair]
            (let [prev (first pair) next (second pair)]
              {:ops (d/diff prev next)
               :html (h/hiccup->html next)}))
          (map (fn [i] [(nth steps i) (nth steps (+ i 1))])
               (range (- (count steps) 1)))))})

(println (interop/->json fixture))
