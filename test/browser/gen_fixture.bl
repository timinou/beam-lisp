; gen_fixture.bl — emit the wire fixture the browser test replays.
;
; Run: mix beam_lisp.run --path priv test/browser/gen_fixture.bl > test/browser/fixture.json
;
; The browser test (client.spec.js) loads priv/live/client.js into a real
; Chromium, applies these EXACT ops (the beam-lisp differ's own output), and
; asserts the resulting DOM against `final_html`. So the JS client is proven
; against the real wire, in a real browser — not hand-written ops.

(ns test.browser.gen-fixture
  (:require [live.hiccup :as h] [live.diff :as d] [interop]))

;; a sequence of hiccup trees, as a "session" of edits
(def steps
  [[:ul [:li {:key "a"} "First"]]
   [:ul [:li {:key "a"} "First"] [:li {:key "b"} "Second"]]           ; insert b
   [:ul [:li {:key "b"} "Second"] [:li {:key "a"} "First"]]           ; reorder
   [:ul [:li {:key "b"} "Second (edited)"] [:li {:key "a"} "First"]]  ; text change
   [:ul [:li {:key "a"} "First"]]])                                   ; remove b

;; a SECOND session: parents that INTERLEAVE text + element children. The
;; server differ (diff.bl children-of) indexes children as the flat
;; text+element list, and hiccup->html joins siblings with "" (no whitespace
;; text nodes), so the DOM's childNodes mirror that list exactly. A client that
;; walked ELEMENT-only children (skipping the text siblings) resolved a path
;; segment under such a node to the WRONG node — or off the end — and silently
;; dropped the op. This is the live-nav "the URL changes but the page does not
;; fully update" regression. Every step below changes a node whose index only
;; lines up under text+element indexing, so it fails loudly if the client ever
;; regresses to element-only walking.
(def mixed-steps
  [;; a button that mixes an element (icon) THEN text — patch the trailing text
   [:div [:button [:svg [:path {:d "M1"}]] "Destroy"]]
   [:div [:button [:svg [:path {:d "M1"}]] "Delete"]]          ; text after an element changes
   ;; text BEFORE an element — patch the leading text past no element, and an
   ;; attr on the element that follows it
   [:div [:button "Continue" [:svg [:path {:d "M2"}]]]]         ; kind change (replace) at [0]
   [:div [:button "Proceed" [:svg {:class "hot"} [:path {:d "M2"}]]]] ; text[0] + set-attr on elem[1]
   ;; a heading nested under text+element siblings (the instance-title shape):
   ;; [row [icon] [col [h1 text]]] — the h1 text sits behind an element sibling
   [:div [:span "lead"] [:section [:h1 "Cabinet Atlas"] [:p "sub"]]]
   [:div [:span "lead"] [:section [:h1 "Meridian Law"] [:p "sub"]]]]) ; deep text change past an element sibling

;; build a {:mount :patches} fixture from a session of trees
(defn- session->fixture [trees]
  {:mount (h/hiccup->html (first trees))
   :patches
   (into []
     (map (fn [pair]
            (let [prev (first pair) next (second pair)]
              {:ops (d/diff prev next)
               :html (h/hiccup->html next)}))
          (map (fn [i] [(nth trees i) (nth trees (+ i 1))])
               (range (- (count trees) 1)))))})

;; the fixture: the keyed-list session (as before) PLUS the mixed text+element
;; session that pins the client's text+element path indexing.
(def fixture
  (assoc (session->fixture steps)
         :mixed (session->fixture mixed-steps)))

(println (interop/->json fixture))
