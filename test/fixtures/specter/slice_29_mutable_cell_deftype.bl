#?(:bb
   (defrecord MutableCell [x])
   :cljs
   (deftype MutableCell [^:volatile-mutable q]
     PMutableCell
     (set_cell [this x] (set! q x))))


#?(:bb
   (defn mutable-cell
     ([] (mutable-cell nil))
     ([v] (MutableCell. (volatile! v))))

   :clj
   (defn mutable-cell
     ([] (mutable-cell nil))
     ([v] (MutableCell. v)))

   :cljs
   (defn mutable-cell
     ([] (mutable-cell nil))
     ([init] (MutableCell. init))))


#?(:bb
   (defn set-cell! [^MutableCell c v]
     (vreset! (:x c) v))

   :clj
   (defn set-cell! [^MutableCell c v]
     (.set c v))

   :cljs
   (defn set-cell! [cell val]
     (set_cell cell val)))


#?(:bb
   (defn get-cell [^MutableCell c]
     @(:x c))

   :clj
   (defn get-cell [^MutableCell c]
     (.get c))


   :cljs
   (defn get-cell [cell]
     (.-q cell)))



