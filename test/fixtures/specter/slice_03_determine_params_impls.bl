;   This block is byte-for-byte the upstream definition. The load
;   harness wraps it in (ns specter.slice_XX) at eval time; the slice
;   text itself is never rewritten. The `(ns ...)` header line is
;   excluded because the harness provides its own namespace.
;   If it ever needs a change to load, that is a recorded FAIL, not a
;   fix to vendor.
; ══════════════════════════════════════════════════════════════════
(defn- determine-params-impls [impls]
 (let [grouped (->> impls (map (fn [[n & body]] [n body])) (into {}))]
   (if-not (= #{'select* 'transform*} (-> grouped keys set))
     (throw (ex-info "defnav must implement select* and transform*"
                     {:methods (keys grouped)})))
   grouped))
