; leaker.bl — a deliberately CONTAMINATED test file, for `bl test --diagnose`.
;
; It does the thing BUG-041 was: it puts a message into the runner's mailbox
; that the runner did not send itself. The pollution is made SAFE by arming only
; when a ledger is watching (`reload.ward-diag/runner` is nil otherwise), so a
; suite that discovers this file by directory moves nothing — the fixture is
; inert unless someone asked to be told about contamination.
;
; The lookup is dynamic on purpose: without the ledger in the image the ns is not
; loaded at all, and a bare `reload.ward-diag/runner` would make this file
; INCOHERENT in an ordinary run.
(ns fixtures.ward.leaker)

(let [r (BeamLisp.Env/fetch "reload.ward-diag" "runner")]
  (when (not= :error r)
    (let [runner ((erlang/element 2 r))]
      (when (some? runner)
        (erlang/send runner [:ward-diag-probe 1])))))
