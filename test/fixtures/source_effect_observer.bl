;; Explicit native observation for Source compiler tests. Keys live under one
;; fixture prefix; observations cannot overwrite execution or custody context.
(ns fixture.source-effect-observer)
(defn put [key value] (Process/put (erlang/list_to_tuple (list :source-effects key)) value))
(defn get [key] (Process/get (erlang/list_to_tuple (list :source-effects key))))
(defn delete [key] (Process/delete (erlang/list_to_tuple (list :source-effects key))))

(defn notify [owner message] (erlang/send owner message))
