; Native child fixture compiled at BeamLisp.Test.ConveyChild. It runs before
; language initialization against the exact Env source beam under test.
(ns fixture.convey-child)
(defn- lst [& xs] xs)
(defn- tup [& xs] (erlang/list_to_tuple xs))
(defn- bcat [& xs] (erlang/list_to_binary xs))
(defn zero [] :zero)
(defn one [x] (erlang/list_to_tuple (lst :one x)))
(defn- check [name action]
 (let [value (try (erlang/apply action (lst)) (catch _ false))]
  (IO/puts (bcat "check-" name "=" (if (erlang/== true value) "ok" (bcat "FAIL " (Kernel/inspect value)))))
  (erlang/== true value)))
(defn run []
 (IO/puts (bcat "env-beam=" (erlang/list_to_binary (code/which :Elixir.BeamLisp.Env))))
 (BeamLisp.Env/start_link (lst))
 (let [zero (check "zero-arity-stays-zero"
              (fn [] (let [callback (BeamLisp.Env/convey
                            (erlang/make_fun :Elixir.BeamLisp.Test.ConveyChild :zero 0))]
                       (and (erlang/is_function callback 0) (erlang/== :zero (erlang/apply callback (lst)))))))
       one (check "one-arity-stays-one"
              (fn [] (let [callback (BeamLisp.Env/convey
                            (erlang/make_fun :Elixir.BeamLisp.Test.ConveyChild :one 1))]
                       (and (erlang/is_function callback 1) (erlang/== (tup :one 7) (erlang/apply callback (lst 7)))))))
       context (check "zero-arity-binds-the-callers-env"
                 (fn []
                  (Process/put :bl_env :global)
                  (let [callback (BeamLisp.Env/convey (erlang/make_fun :Elixir.BeamLisp.Env :env_id 0))
                        parent (erlang/self)]
                   (erlang/spawn (fn [] (erlang/send parent (tup :got (erlang/apply callback (lst))))))
                   (receive [:got value] (erlang/== :global value) (after 2000 false)))))]
  (IO/puts (if (and zero one context) "semantics=ok" "semantics=FAIL"))))
