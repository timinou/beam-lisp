(ns fixture.sdk-cold-retention (:require [reload.generation :as g]))
(defn proposal [name]
 {:application-id name :sources {"automatic.sdk.fixture"
  "(ns automatic.sdk.fixture) (defn marker [] :original)"}})
(do
 (assert (erlang/== (list) (ets/lookup :beam_lisp_vars :bl_sdk_runtime_lease)))
 (let [p (proposal "automatic-sdk-cold") a (g/prepare! p)]
  (try
   (assert (= :sdk-runtime-retained (BeamLisp.Env/ensure_sdk_runtime!)))
   (assert (BeamLisp.Env/sdk_runtime_retained_modules? (list :Elixir.BeamLisp.Env)))
   (let [entry (BeamLisp.Env/fetch_exact! "reload.generation" "prepare!")]
    (assert (erlang/is_function entry 1))
    (assert (BeamLisp.Env/sdk_runtime_retained_modules?
         (list (erlang/element 2 (erlang/fun_info entry :module))))))
   (assert (erlang/== a (g/prepare! p)))
   (assert (= :original (g/invoke! a "automatic.sdk.fixture/marker" [])))
   (finally (g/retire! a)))))

(println "SDK_COLD_RETENTION_READY")
