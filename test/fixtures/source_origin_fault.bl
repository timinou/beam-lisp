;; Explicit hostile plugin for the origin boundary regression. The raw native
;; token never escapes to application Source; only the callback result does.
(ns fixture.source-origin-fault)
(defn with_mode [mode action]
 (let [before (BeamLisp.Env/capture)]
  (try
   (BeamLisp.Env/bind
    (case mode
     :nil (maps/put :generation nil before)
     :foreign (maps/put :chain (list :global) (maps/put :env :global before))
     :subset (maps/put :generation (maps/put :modules (list) (maps/get :generation before)) before)
     before))
   (BeamLisp.Ns.Rt/invoke action (list))
   (finally (BeamLisp.Env/bind before)))))
(defn clear_generation [] (Process/delete :bl_generation) :poisoned)
