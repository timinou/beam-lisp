(ns fixture.native-aot-replay (:require [vm.native :as native] [datom.store-fjall]))
  (let [out (str (System/tmp_dir!) "/bl_aot_native_"
                 (erlang/unique_integer (list :positive)))
        mod (BeamLisp.Link/module_for "datom.store-fjall")
        key (tuple :native "datom.store-fjall")]
    (try
      (File/mkdir_p! out)
      (let [mods (BeamLisp.AOT/compile_file (Path/join (BeamLisp.Tiers/priv_root) "lib/datom/store-fjall.bl")
                                            (list (tuple :output_dir out)))]
        (assert (>= (count mods) 1) "the namespace compiles to at least one beam")
        (assert (not (nil? (native/declaration "datom.store-fjall")))
            "the declaration is RECORDED — what __bl_init__ replays")
        (assert (some (fn [p] (= mod (erlang/element 1 p))) mods)
            "the namespace shim is among the emitted {mod, path} pairs")
        (assert (erlang/function_exported mod :__bl_init__ 0)
            "and it carries __bl_init__/0"))
      ; REPLAY: drop the row, run the emitted init, and the row returns.
      (let [row (first (ets/lookup :beam_lisp_native_declarations key))]
        (ets/delete :beam_lisp_native_declarations key)
        (try
          (assert (nil? (native/declaration "datom.store-fjall"))
              "precondition: the registry row is gone")
          (erlang/apply mod :__bl_init__ (list))
          (assert (= row (first (ets/lookup :beam_lisp_native_declarations key)))
              "replaying __bl_init__ RESTORES the declaration — no silent loss of durability")
          (finally
            (ets/delete :beam_lisp_native_declarations key)
            (ets/insert :beam_lisp_native_declarations row)))
        (assert (erlang/function_exported :Elixir.BeamLisp.Native.Datom.StoreFjall :__nif_loaded__ 0)
            "the host module came back with the replay")
        (assert (datom.store-fjall/available?)
            "and the namespace reads AVAILABLE after the replay, not merely declared"))
      (finally (File/rm_rf! out))))
(println "NATIVE_AOT_REPLAY_READY")
