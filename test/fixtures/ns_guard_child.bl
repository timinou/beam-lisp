; Compiled as a native child module so the current Env/Loader source beams
; are selected before initialization. Semantic checks also serve the benchmark.
(ns fixture.ns-guard-child)
(defn- write! [path text]
 (File/mkdir_p! (Path/dirname path)) (File/write! path text) path)
(defn- count-file [path] (String/length (File/read! path)))
(defn- check [results name action]
 (let [value (try (action) (catch error (tuple :raised (ex-message error))))
       good (= true value)]
  (IO/puts (str "check-" name "=" (if good "ok" (str "FAIL " (pr-str value)))))
  (cons good results)))
(defn- timed [label action]
 (let [started (System/monotonic_time :microsecond) result (action)]
  (IO/puts (str label "-us=" (- (System/monotonic_time :microsecond) started))) result))
(defn- ns-ready-loop [namespace n]
 (when (erlang/> n 0)
  (when-not (BeamLisp.Env/ns_ready? namespace) (throw :namespace-not-ready))
  (recur namespace (erlang/- n 1))))
(defn- ensure-loop [namespace n]
 (when (erlang/> n 0)
  (when-not (= :ok (BeamLisp.Loader/ensure_ready namespace)) (throw :namespace-not-ready))
  (recur namespace (erlang/- n 1))))
(defn- restore-chain [chain]
 (if (nil? chain) (Process/delete :bl_env_chain) (Process/put :bl_env_chain chain)))
(defn- setup! []
 (let [suffix (Integer/to_string (erlang/unique_integer (list :positive)))
       dir (Path/join (System/tmp_dir!) (str "bl_ns_guard_" suffix))
       provider (str "guard.prov" suffix) caller (str "guard.call" suffix)
       bencher (str "guard.bench" suffix) count (Path/join dir "init.count")]
  (File/mkdir_p! dir) (File/write! count "")
  (write! (Path/join dir (str "guard/prov" suffix ".bl"))
   (str "(ns " provider ")\n(def init-count (do (File/write! " (pr-str count)
        " (str (File/read! " (pr-str count) ") \"+\")) 1))\n(defn ping [] 7)\n"))
  (write! (Path/join dir (str "guard/call" suffix ".bl"))
   (str "(ns " caller " (:require [" provider " :as p]))\n(defn go [] (p/ping))\n"))
  (write! (Path/join dir (str "guard/bench" suffix ".bl"))
   (str "(ns " bencher " (:require [" provider " :as p]))\n"
        "(defn go [n] (loop [i 0] (if (< i n) (do (p/ping) (recur (inc i))) i)))\n"))
  {:dir dir :provider provider :caller caller :bencher bencher :count count}))
(defn- exercise [ctx]
 (BeamLisp.Loader/ensure_loaded (:caller ctx))
 (BeamLisp.Loader/ensure_loaded (:bencher ctx))
 (let [provider (:provider ctx) count (:count ctx)
       results (check (list) "declared-is-not-ready" #(= false (BeamLisp.Env/ns_ready? provider)))
       results (check results "direct-call-initializes" #(= 7 (BeamLisp/eval (str "(" (:caller ctx) "/go)"))))
       results (check results "init-ran-once" #(= 1 (count-file count)))
       results (check results "ready-after-init" #(= true (BeamLisp.Env/ns_ready? provider)))
       results (check results "guard-is-a-no-op-when-ready"
                 #(and (= :ok (BeamLisp.Loader/ensure_ready provider))
                       (= :ok (BeamLisp.Loader/ensure_ready provider)) (= 1 (count-file count))))
       results (check results "global-flag-set"
                 #(= true (persistent_term/get (tuple :beam_lisp_ns_ready provider) false)))
       saved (Process/get :bl_env_chain)
       results (check results "fast-path-skips-chain"
                 (fn [] (Process/put :bl_env_chain (list))
                  (try (= true (BeamLisp.Env/ns_ready? provider)) (finally (restore-chain saved)))))
       results (check results "unknown-namespace-stays-false"
                 (fn [] (Process/put :bl_env_chain (list))
                  (try (= false (BeamLisp.Env/ns_ready?
                         (str "guard.never" (erlang/unique_integer (list :positive)))))
                   (finally (restore-chain saved)))))
       leaf (str "provchild" (erlang/unique_integer (list :positive)))
       child-provider (str "guard." leaf)
       _ (write! (Path/join (:dir ctx) (str "guard/" leaf ".bl"))
            (str "(ns " child-provider ")\n(defn ping [] 9)\n"))
       child (BeamLisp.Env/fork)]
  (try
   (let [results (check results "child-env-load-is-ready-in-child"
                   (fn []
                    (BeamLisp.Env/with_env child #(BeamLisp.Loader/ensure_loaded child-provider))
                    (= true (BeamLisp.Env/with_env child #(BeamLisp.Env/ns_ready? child-provider)))))
         results (check results "fast-fact-agrees-with-global-mirror"
                   (fn []
                    (let [global (ets/member :beam_lisp_vars (tuple :global :ns_ready child-provider))]
                     (and (= global (BeamLisp.Env/ns_ready? child-provider))
                          (= global (persistent_term/get (tuple :beam_lisp_ns_ready child-provider) false))))))]
    (timed "ns-ready-1m" #(ns-ready-loop provider 1000000))
    (timed "ensure-ready-1m" #(ensure-loop provider 1000000))
    (timed "direct-call-1m" #(BeamLisp/eval (str "(" (:bencher ctx) "/go 1000000)")))
    (let [before (elem (Process/info (erlang/self) :reductions) 1)
          _ (ns-ready-loop provider 100000)
          after (elem (Process/info (erlang/self) :reductions) 1)
          per-call (/ (- after before) 100000)]
     (IO/puts (str "ns-ready-reductions-per-call=" (Float/round per-call 1)))
     (check results "guard-reduction-bound" #(< per-call 100))))
   (finally (BeamLisp.Env/destroy child)))))
(defn main []
 (BeamLisp/init)
 (BeamLisp.Env/attach :global)
 (BeamLisp.Env/clear_search_paths)
 (IO/puts (str "env-beam=" (erlang/list_to_binary (code/which :Elixir.BeamLisp.Env))))
 (IO/puts (str "loader-beam=" (erlang/list_to_binary (code/which :Elixir.BeamLisp.Loader))))
 (let [ctx (setup!)]
  (try
   (let [results (BeamLisp.Loader/with_ambient_dirs (list (:dir ctx)) #(exercise ctx))]
    (IO/puts (str "semantics=" (if (every? identity results) "ok" "fail"))))
   (finally (File/rm_rf! (:dir ctx))))))
