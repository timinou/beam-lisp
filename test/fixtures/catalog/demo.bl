; test/fixtures/catalog/demo.bl — a controlled showcase for catalog_test.bl.
;
; Two catalogued entries in two groups, one carrying tags, plus an
; un-catalogued helper — so the coverage query has something to find.

(ns fixture.catalog.demo
  (:require [loom.ui :as ui] [loom.box :as b]))

(defn ^{:catalog {:group "Alpha" :title "First"
                  :doc "The first demo." :tags [:x :y]}}
  demo-one []
  (ui/button {:variant :primary} "One"))

(defn ^{:catalog {:group "Alpha" :title "Second"
                  :doc "The second demo."}}
  demo-two []
  (b/row {:gap :2} (ui/badge {:tone :success} "ok")))

(defn ^{:catalog {:group "Beta" :title "Third"
                  :doc "In another group." :tags [:x]}}
  demo-three []
  (ui/heading 2 "Three"))

;; NOT catalogued — a plain helper. Must appear in the coverage report.
(defn helper-fn [x] (+ x 1))
