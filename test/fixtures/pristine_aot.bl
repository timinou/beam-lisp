(ns fixture.pristine-aot (:require [pristine :as p] [build :as b]))
;; Compile private namespace copies of the selected SDK helper bodies. The
;; candidate's executing SDK forwarders remain protected during collection.
(let [root (str (System/tmp_dir!) "/pristine-aot-" (erlang/unique_integer (list :positive)))
      source-root (Path/join root "src") a (Path/join root "a") b (Path/join root "b")
      originals (Path/wildcard (Path/join (BeamLisp.Tiers/priv_root) "build/*.bl"))]
 (File/mkdir_p! source-root)
 (try
  (let [srcs (mapv (fn [source]
                (let [text (File/read! source) namespace (BeamLisp.Loader/declared_ns text)
                      header (Regex/compile! (str "(?m)^\\(ns " (Regex/escape namespace) "(?=[\\s\\)])"))
                      private-source (Regex/replace header text (str "(ns pristine.fixture." namespace))
                      target (Path/join source-root (Path/basename source))]
                 (File/write! target private-source) target)) originals)]
   (assert (> (count srcs) 5))
   (doseq [out [a b]]
    (File/mkdir_p! out)
    (let [r (b/run {:sources srcs :out out :force? true :jobs 4 :log nil})]
     (assert (= [] (:errors r)) (pr-str (:errors r)))
     (assert (= (count srcs) (:built r)))))
   (let [diff (p/trees a b ["build.log"])]
    (assert (:same? diff) (p/report diff))
    (assert (= (get-in diff [:trees :files :a]) (get-in diff [:trees :files :b])))
    (assert (>= (get-in diff [:trees :files :a]) (count srcs)))
    (assert (= [] (:changed (:trees diff))))
    (assert (nil? (:same? (:tar diff))))
    (assert (= ["build.log"] (:skipped (:tar diff))))
    (assert (includes? (p/report diff) "NOT COMPARED"))
    (let [raw (p/trees a b)]
     (assert (not (:same? raw)))
     (assert (= ["build.log"] (:changed (:trees raw)))))))
  (finally (File/rm_rf! root))))
(println "PRISTINE_AOT_READY")
