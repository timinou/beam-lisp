;; Native fault injection for stale initializer receipts. Raw gate data stays
;; inside the fixture and never becomes a capability returned to Source.
(ns fixture.source-start-gate-fault)
(defn save []
 (Process/put :fixture_saved_queue_init_gate (Process/get :bl_server_init_gate)) nil)
(defn with_saved [action]
 (let [previous (Process/get :bl_server_init_gate)]
  (try
   (Process/put :bl_server_init_gate (Process/get :fixture_saved_queue_init_gate))
   (BeamLisp.Ns.Rt/invoke action (list))
   (finally
    (if previous (Process/put :bl_server_init_gate previous)
     (Process/delete :bl_server_init_gate))))))
