; widget.bl — a tiny fixture library (two public fns, one private) for the
; explorer's multi-package tests. No thread vocabulary: a package need not
; declare one, and the explorer omits the thread axis when it does not.
(ns fixture.widget)

(defn greet
  "A public primitive: greet a name."
  [name] (str "hello " name))

(defn shout
  "A public primitive: greet, loudly."
  [name] (String/upcase (greet name)))

(defn- whisper
  "A private helper — not part of the public surface."
  [s] (String/downcase s))
