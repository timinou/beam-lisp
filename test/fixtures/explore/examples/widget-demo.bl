; widget-demo.bl — one example. It references a public widget by its fully
; qualified name so the explorer's `uses` join links it, without a :require
; (the fixture lib is not on this run's load path; a real package's lib is).
(ns fixture.widget-demo)

(defn ^{:catalog {:group "Widgets" :title "Greet"
                  :doc "Shows greet; leaves shout undemonstrated (a coverage gap)."}}
  demo-greet []
  ;; a plain marker; the point of the fixture is coverage + graceful threads,
  ;; not a live render, so the body stays require-free.
  [:p {} "hello world"])
