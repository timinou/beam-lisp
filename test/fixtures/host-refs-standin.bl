; Dedicated destructive native ABI control. Ordinary `run` evaluates directly;
; an owned ward worker would itself keep an old Refs execution frame alive.
(ns host.refs.standin-child)
(BeamLisp/eval (str "(ns core)\n"
                   (File/read! (Path/join (BeamLisp/cwd) "priv/std/test.bl"))))
(BeamLisp/run_file (Path/join (BeamLisp/cwd) "test/bl/host_refs_test.bl"))
(BeamLisp.Ns.Rt/invoke (BeamLisp.Env/fetch_exact! "host.refs.test" "production-stand-in!") (list))
(println "REFS_PRODUCTION_ATOM_OK")
