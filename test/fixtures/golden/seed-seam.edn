{:st/imports ["stdlib/macros/data-kind" "stdlib/macros/handle"]
 :st/forms [(data-subscribe :name $error :host $chat-live :assign error)
            (data-subscribe :name $messages :host $chat-live :assign messages)
            (data-subscribe :name $partial :host $chat-live :assign partial)
            (data-subscribe :name $status :host $chat-live :assign status)
            (data-signal :name $send :params [:st/paramlist] :host $chat-live :arms [:st/array [:st/named {"cons" [:st/named {"variant" [:st/named {"ctor" Failed "payload" [:st/expr "$.reply"]}]}] "final" "" "pat" [:st/named {"name" _}]}] [:st/named {"cons" [:st/named {"variant" [:st/named {"ctor" Ok "payload" [:st/expr "$.reply"]}]}] "final" "" "pat" [:st/named {"lit" "ok"}]}]] :ephemeral "" :mode latest :sum SendResult :target "send" :verb emit)
            (data-subscribe :name $vars :host $chat-live :assign vars)
            (data-subscribe :name $vars_count :host $chat-live :assign vars_count)
            (data-signal :name $refresh :params [:st/paramlist] :host $chat-live :arms [:st/array [:st/named {"cons" [:st/named {"variant" [:st/named {"ctor" Ok "payload" [:st/expr "$.reply"]}]}] "final" "" "pat" [:st/named {"lit" "ok"}]}]] :ephemeral "" :mode latest :sum RefreshResult :target "refresh" :verb emit)]}