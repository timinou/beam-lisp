{:st/imports ["stdlib/macros/data-kind" "stdlib/enum/dispatch"]
 :st/forms [(template :name shell :params [:st/paramlist ] :body [:st/component-body])
            (template :name bubble :params [:st/paramlist ["m" :binding false nil nil false]] :body [:st/component-body])
            (template :name thinking :params [:st/paramlist ] :body [:st/component-body])
            (template :name streaming :params [:st/paramlist ] :body [:st/component-body])
            (template :name error :params [:st/paramlist ] :body [:st/component-body])
            (sel ".log" (each :source $messages :key [:st/expr "null"] :item $m :invocations [:st/array [:st/named {"name" "bubble" "args" [:st/array "$m"]}]]))
            (sel ".composer__input" (on-driver-body :driver [:st/named {"member" input "subject" ""}] :body [:st/array [:st/named {"mut" [:st/named {"expr" [:st/expr "$.value"] "target" draft}]}]]))
            (sel ".composer__send" (on-driver-body :driver [:st/named {"member" click "subject" ""}] :body [:st/array [:st/named {"stmt" [:st/named {"args" [:st/array [:st/named {"value" [:st/expr "$draft"]}]] "signal" send}]}] [:st/named {"mut" [:st/named {"expr" [:st/expr "\"\""] "target" draft}]}]]))
            (sel ".composer__input" (on-driver-body :driver [:st/named {"member" keydown "subject" "" "driver_params" [:st/array [:st/named {"name" key "value" "Enter"}]]}] :body [:st/array [:st/named {"stmt" [:st/named {"args" [:st/array [:st/named {"value" [:st/expr "$draft"]}]] "signal" send}]}] [:st/named {"mut" [:st/named {"expr" [:st/expr "\"\""] "target" draft}]}]]))
            (sel ".log" (view :subject $status :arms [:st/array [:st/named {"inv" [:st/named {"args" [:st/array] "name" "thinking"}] "pat" [:st/named {"lit" "thinking"}]}]]))
            (sel ".log" (view :subject $partial :arms [:st/array [:st/named {"inv" [:st/named {"args" [:st/array] "name" "streaming"}] "pat" [:st/named {"wild" _}]}]]))
            (sel ".log" (view :subject $error :arms [:st/array [:st/named {"inv" [:st/named {"args" [:st/array] "name" "error"}] "pat" [:st/named {"wild" _}]}]]))
            (template :name var-row :params [:st/paramlist ["v" :binding false nil nil false]] :body [:st/component-body])
            (template :name state-count :params [:st/paramlist ] :body [:st/component-body])
            (sel ".state__list" (each :source $vars :key [:st/expr "null"] :item $v :invocations [:st/array [:st/named {"name" "var-row" "args" [:st/array "$v"]}]]))
            (sel ".state__count" (view :subject $vars_count :arms [:st/array [:st/named {"inv" [:st/named {"args" [:st/array] "name" "state-count"}] "pat" [:st/named {"wild" _}]}]]))
            (sel ".state__refresh" (on-driver-body :driver [:st/named {"member" click "subject" ""}] :body [:st/array [:st/named {"stmt" [:st/named {"args" [:st/array ] "signal" refresh}]}]]))]
 :st/scopes [{:selector ".chat" :decls {"background" "#0b0d14" "color" "#e8eaf2" "display" "grid" "font-family" "Inter, ui-sans-serif, system-ui, sans-serif" "grid-template-columns" "minmax(0,1fr) 20rem" "height" "100dvh" "margin" "0 auto" "max-width" "72rem"}}
             {:selector ".chat__main" :decls {"display" "grid" "grid-template-rows" "1fr auto" "min-height" "0"}}
             {:selector ".log" :decls {"display" "flex" "flex-direction" "column" "gap" "0.75rem" "overflow-y" "auto" "padding" "1.5rem"}}
             {:selector ".bubble" :decls {"border-radius" "1rem" "line-height" "1.5" "max-width" "80%" "padding" "0.75rem 1rem" "white-space" "pre-wrap"}}
             {:selector ".bubble[data-role='user']" :decls {"align-self" "flex-end" "background" "#2b4c8c"}}
             {:selector ".bubble[data-role='model']" :decls {"align-self" "flex-start" "background" "#1b2030"}}
             {:selector ".composer" :decls {"border-top" "1px solid rgba(255,255,255,0.08)" "display" "flex" "gap" "0.5rem" "padding" "1rem"}}
             {:selector ".composer__input" :decls {"background" "#141824" "border" "1px solid rgba(255,255,255,0.12)" "border-radius" "0.75rem" "color" "#e8eaf2" "flex" "1" "padding" "0.75rem 1rem"}}
             {:selector ".composer__input" :decls {"value" [:st/inject "$draft"]}}
             {:selector ".composer__send" :decls {"background" "#3b6fd4" "border" "0" "border-radius" "0.75rem" "color" "#fff" "cursor" "pointer" "padding" "0.75rem 1.25rem"}}
             {:selector ".thinking" :decls {"align-self" "flex-start" "display" "flex" "gap" "0.25rem" "padding" "0.75rem 1rem"}}
             {:selector ".bubble--streaming" :decls {"background" "transparent" "opacity" "0.75" "padding" "0"}}
             {:selector ".bubble--streaming .bubble__text" :decls {"margin" "0"}}
             {:selector ".bubble--streaming .bubble__text:not(:empty)" :decls {"background" "#141824" "border-radius" "1rem" "padding" "0.75rem 1rem"}}
             {:selector ".notice" :decls {"align-self" "center" "margin" "0"}}
             {:selector ".notice--error:not(:empty)" :decls {"background" "rgba(180,50,60,0.16)" "border" "1px solid rgba(220,90,100,0.35)" "border-radius" "0.75rem" "color" "#ffe9ea" "font-size" "0.85rem" "padding" "0.6rem 0.9rem"}}
             {:selector ".state" :decls {"background" "#0e1119" "border-left" "1px solid rgba(255,255,255,0.08)" "color" "#e8eaf2" "display" "flex" "flex-direction" "column" "min-height" "0"}}
             {:selector ".state__head" :decls {"align-items" "center" "border-bottom" "1px solid rgba(255,255,255,0.08)" "display" "flex" "gap" "0.5rem" "padding" "0.75rem 1rem"}}
             {:selector ".state__title" :decls {"color" "#9aa3b8" "flex" "1" "font-size" "0.8rem" "font-weight" "600" "letter-spacing" "0.08em" "margin" "0" "text-transform" "uppercase"}}
             {:selector ".state__count" :decls {"color" "#9aa3b8" "font-size" "0.75rem"}}
             {:selector ".state__refresh" :decls {"background" "#141824" "border" "1px solid rgba(255,255,255,0.12)" "border-radius" "0.5rem" "color" "#e8eaf2" "cursor" "pointer" "font-size" "0.75rem" "padding" "0.2rem 0.6rem"}}
             {:selector ".state__list" :decls {"flex" "1" "font-family" "ui-monospace, SFMono-Regular, Menlo, monospace" "font-size" "0.75rem" "list-style" "none" "margin" "0" "overflow-y" "auto" "padding" "0.5rem 1rem"}}
             {:selector ".var" :decls {"display" "flex" "gap" "0.5rem" "line-height" "1.4" "padding" "0.15rem 0"}}
             {:selector ".var__name" :decls {"color" "#e8eaf2"}}
             {:selector ".var__ns" :decls {"color" "#6b7280" "overflow" "hidden" "text-overflow" "ellipsis"}}
             {:selector ".var__kind" :decls {"background" "#1b2030" "border-radius" "0.4rem" "color" "#9aa3b8" "font-size" "0.7rem" "margin-left" "auto" "padding" "0 0.4rem"}}]
 :st/constructs [{:kind "template" :selector "@template:shell" :html "<main class='chat'><div class='chat__main'><div class='log' data-log></div><div class='composer'><input class='composer__input' placeholder='Say something…'><button class='composer__send' type='button'>Send</button></div></div><aside class='state'><div class='state__head'><h2 class='state__title'>Live environment</h2><span class='state__count'></span><button class='state__refresh' type='button'>Refresh</button></div><ul class='state__list'></ul></aside></main>" :decls {}}
                 {:kind "template" :selector "@template:bubble" :html "<article class='bubble' data-role=\"`$m.role`\"><p class='bubble__text'>`$m.text`</p></article>" :decls {}}
                 {:kind "template" :selector "@template:thinking" :html "<div class='thinking'><span></span><span></span><span></span></div>" :decls {}}
                 {:kind "template" :selector "@template:streaming" :html "<article class='bubble bubble--streaming' data-role='model'><p class='bubble__text'>`$partial`</p></article>" :decls {}}
                 {:kind "template" :selector "@template:error" :html "<p class='notice notice--error' role='alert'>`$error`</p>" :decls {}}
                 {:kind "template" :selector "@template:var-row" :html "<li class='var'><span class='var__name'>`$v.name`</span><span class='var__ns'>`$v.ns`</span><span class='var__kind'>`$v.kind`</span></li>" :decls {}}
                 {:kind "template" :selector "@template:state-count" :html "<span class='state__count-value'>`$vars_count`</span>" :decls {}}]}