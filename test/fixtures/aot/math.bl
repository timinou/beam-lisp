; math.bl — arithmetic helpers for the AOT fixture set.
; Exercises fixed-, multi- and variadic-arity defn, a value def read
; from a defn body, a macro defined and used in the same file, and
; same-arity clauses separated by a `:when` guard — which the AOT path
; must reproduce because clause selection happens at the module the
; caller enters, so a guard dropped from the generated shim would send
; every call to the first clause.

(ns math)

(defn square [x] (* x x))

(defn add
  ( [a] a)
  ( [a b] (+ a b)))

(defn sum
  ( [a b] (+ a b))
  ( [a b & more] (reduce + (+ a b) more)))

(defn sign                              ; same arity, chosen by guard
  ( [n] :when (pos? n) :positive)
  ( [n] :when (neg? n) :negative)
  ( [_n] :zero))

(def answer (* 6 7))                    ; a value def...
(defn answer-mul [n] (* n answer))      ; ...read from a defn body
(defn describe [] (str "answer=" answer))

(defmacro twice [x] `(+ ~x ~x))         ; macro defined...
(defn double [n] (twice n))             ; ...and used in the same file
