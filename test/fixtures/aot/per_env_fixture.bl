; test fixture for env-scoped (`^:per-env`) defs through the AOT path.
;
; `shared-counter` is an ordinary value def: ONE global instance, shared by
; every env. `tenant-counter` is `^:per-env`: each consuming env materializes
; its OWN instance on first read. `bump-shared` / `bump-tenant` mutate whichever
; instance the calling env resolves, so a test can prove isolation by value.

(ns per-env-fixture)

(def shared-counter (atom 0))

(def ^:per-env tenant-counter (atom 0))

(defn bump-shared []
  (swap! shared-counter inc))

(defn bump-tenant []
  (swap! tenant-counter inc))

(defn tenant-value []
  (deref tenant-counter))

(defn shared-value []
  (deref shared-counter))
