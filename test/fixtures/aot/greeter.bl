; greeter.bl — exercises ns :require ordering: depends on `math` and
; `hello`, so the AOT task compiles those two files first (and the
; loader resolves them by path if greeter is loaded standalone).

(ns greeter (:require [math :as m] [hello :refer [greet shout]]))

(defn report [n] (str (greet "aot") " | " (m/square n) " | " (shout "loud")))
