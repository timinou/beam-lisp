; test/bl/spell/intent_fixture.bl — contracts that ACT, for the host-side tests.
;
; The Elixir suite (`test/beam_lisp/spell/intent_test.exs`) asserts the half a
; beam-lisp test cannot reach: that a registered performer actually runs, in
; the right process, and that its assigns beat the handler's own. It needs
; contracts to drive that with — and they belong HERE, as ordinary beam-lisp
; source, rather than assembled out of Elixir data.
;
; That is not tidiness. A contract built by an Elixir helper is a contract the
; reader has assembled: `[:do, [:do!, :"create-task", %{title: :title}]]` is a
; guess about how the reader spells a symbol, a keyword and a map key, and when
; the guess is wrong the test fails somewhere in the walker with a message
; about the fixture rather than about the feature. Written as source, the
; reader produces the term the way it produces every other one, and the test is
; about `do!`.

(ns spell.intent-fixture
  (:require [spell.contract :refer [parse]]))

;; ── one intent, the ordinary case ───────────────────────────────────────────

(def create-contract
  (parse :intent-test
         {:bundle "/dev/null" :root ".intent"}
         (list
           (quote (assign @status :string))
           (quote (assign @board :list))

           ;; The shape an application's write actually takes: refuse the bad
           ;; input HERE (the handler owns the seam's validation, and a reply
           ;; is how the page learns), then declare the intent and answer.
           (quote (on :create [title]
                    (if (blank? title)
                      (err "A task needs a title")
                      (do (do! :create-task {:title title})
                          (ok "created"))))))))

;; ── the handler writes a STALE copy, then acts ──────────────────────────────
;;
;; The ordering fixture. The body sets `@status` itself and then records an
;; intent; the performer answers with a different `@status`. Whichever value
;; the socket ends up holding says which layer wins — and it must be the
;; performer, because the performer read the database AFTER the write while
;; the handler only knew what the page already had.

(def stale-contract
  (parse :intent-test
         {:bundle "/dev/null" :root ".intent"}
         (list
           (quote (assign @status :string))
           (quote (on :create [title]
                    (do (set! @status "stale-handler-copy")
                        (do! :create-task {:title title})
                        (ok "created")))))))

;; ── two intents, one story ──────────────────────────────────────────────────

(def two-contract
  (parse :intent-test
         {:bundle "/dev/null" :root ".intent"}
         (list
           (quote (assign @status :string))
           (quote (on :create [title]
                    (do (do! :first {:title title})
                        (do! :second {:title title})
                        (ok "done")))))))

;; ── a body that tries to reach the performer registry itself ────────────────
;;
;; The property `do!` must not cost: recording an intent gives a body no way to
;; run one. `Elixir.BeamLisp.Spell.Server/register_performer` is not in the
;; whitelist and there is no interop head in the walker at all, so this is
;; refused exactly as `(System/halt)` is.

(def evil-contract
  (parse :intent-test
         {:bundle "/dev/null" :root ".intent"}
         (list
           (quote (assign @status :string))
           (quote (on :evil []
                    (do (Elixir.BeamLisp.Spell.Server/register_performer "x" "y")
                        (ok "escaped")))))))

;; ── a performer, in beam-lisp ───────────────────────────────────────────
;;
;; `Server.register_performer("create-task", "spell.intent-fixture/perform-probe")`
;; is the registration path an application actually takes, and it is the whole
;; reason `do!` is worth having: the walker stays closed, the host learns
;; nothing about the domain, and the code that ACTS is beam-lisp like the rest
;; of the application.
;;
;; `(op payload)` — two arguments, because one performer may answer to several
;; ops and dispatching on the name inside beam-lisp beats registering the same
;; function under five keys.

(defn perform-probe
  "Answer with assigns proving the performer ran and saw its payload."
  [op payload]
  {"status" (str "performed:" (get payload "title"))})

