;; Check the actual floor before loading a test namespace or SDK library.
(assert (BeamLisp.AOT/sdk_preinit_floor_ready?))
(ns fixture.sdk-before-first-init
 (:require [reload.generation :as g] [reload.preinit-counter :as counter]))
(defn- reason [action]
 (try (action) nil (catch error
  (if (and (erlang/is_map error) (maps/is_key :original error))
   (maps/get :original error) (or (:kind (ex-data error)) error)))))
(defn- fetch! [binding]
 (BeamLisp.Env/fetch_exact! "reload.preinit-state-fixture" binding))

(defn first-normal-sdk-load-constructs-canonical-callables-before-state []
 (let [namespace "reload.preinit-state-fixture"]
  ;; No manual prestage, receipt, lease, header or ready flag. This test must be
  ;; run in a fresh process; its first load is the ordinary Loader boundary.
  (assert (= false (BeamLisp.Env/loaded_ns? namespace)))
  (assert (= 0 (counter/value :state)))
  (BeamLisp.Loader/ensure_loaded namespace)
  (let [saved (fetch! "private-partial") callback ((fetch! "callback"))
        private (fetch! "private-step") public (fetch! "invoke")
        body (BeamLisp.AOT/ns_body_module namespace)]
   (assert (BeamLisp.AOT/sdk_unit_callable_ready? namespace))
   (assert (= 1 ((fetch! "initialization-count"))))
   (assert (= 15 (saved 5)))
   (assert (identical? saved callback))
   (assert (= :local (elem (erlang/fun_info private :type) 1)))
   (assert (= body (elem (erlang/fun_info private :module) 1)))
   (assert (= body (elem (erlang/fun_info public :module) 1)))
   (BeamLisp.Loader/ensure_loaded namespace)
   (assert (identical? saved (fetch! "private-partial")))
   (assert (= 1 (counter/value :state)))
   (let [generation (g/prepare!
         {:sources {"preinit.app"
          "(ns preinit.app (:require [reload.preinit-state-fixture :as sdk]))
           (defn run [x] ((sdk/callback) x))
           (defn direct [x] (sdk/invoke x))
           (defn invoke-callback [f x] (f x))"}
          :stable-namespaces #{namespace}})]
    (try
     (assert (= 17 (g/invoke! generation "preinit.app/run" [7])))
     (assert (= 18 (g/invoke! generation "preinit.app/direct" [8])))
     (assert (= 1 (counter/value :state)))
     (assert (BeamLisp.Env/sdk_runtime_retained_modules? (list body)))
     (assert (= false (BeamLisp.Env/source_execution_active?)))
     ;; A real outside-SDK eval closure is not adopted merely because canonical
     ;; SDK bindings were repaired. No manufactured cache/lease evidence.
     (let [outside (BeamLisp.Compiler/eval_string
                    "(fn [x] (Process/put :preinit-outside-ran true) x)"
                    (BeamLisp.Compiler/new_env "preinit.outside") nil)]
      (Process/delete :preinit-outside-ran)
      (assert (= :unattested_sdk_callback
            (reason #(BeamLisp.AOT/sdk_callable_evidence! outside))))
      (assert (= :source_native_target_refused
            (reason #(g/invoke! generation "preinit.app/invoke-callback" [outside 1]))))
      (assert (= nil (Process/get :preinit-outside-ran))))
     (finally (g/retire! generation)))))))

(defn refused-sdk-stage-does-not-fall-back-or-replay-for-attribution []
 (let [namespace "reload.preinit-refusal-fixture"]
  (assert (= false (BeamLisp.Env/loaded_ns? namespace)))
  (assert (= 0 (counter/value :refusal)))
  (assert (= :unsupported-sdk-stage-namespace-clause
        (reason #(BeamLisp.Loader/ensure_loaded namespace))))
  (assert (= false (BeamLisp.Env/loaded_ns? namespace)))
  (assert (= 0 (counter/value :refusal)))
  (assert (= false (BeamLisp.Env/source_execution_active?)))))

(let [first-check first-normal-sdk-load-constructs-canonical-callables-before-state
      refusal-check refused-sdk-stage-does-not-fall-back-or-replay-for-attribution]
 (first-check) (refusal-check))
(println "SDK_FIRST_INIT_READY")
