(defn nthnext
  "Returns the nth next of coll, (seq coll) when n is 0."
  [coll n]
  ;; TODO add support for IDrop
  (loop [n n xs (seq coll)]
    (if (and xs (pos? n))
      (recur (dec n) (next xs))
      xs)))
