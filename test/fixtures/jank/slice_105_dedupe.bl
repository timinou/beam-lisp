(defn dedupe
  "Returns a lazy sequence removing consecutive duplicates in coll.
   Returns a transducer when no collection is provided."
  ([]
   (fn [rf]
     (let [pv (volatile! ::none)]
       (fn
         ([] (rf))
         ([result] (rf result))
         ([result input]
          (let [prior (deref pv)]
            (vreset! pv input)
            (if (= prior input)
              result
              (rf result input))))))))
  ([coll]
   (let [step (fn step [prior xs]
                (lazy-seq
                  (when-some [[x & more] (seq xs)]
                    (if (= x prior)
                      (step prior more)
                      (cons x (step x more))))))]
     (step ::none coll))))
