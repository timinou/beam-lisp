(defn some
  "Returns the first logical true value of (selector x) for any x in coll,
   else nil.  One common idiom is to use a set as selector, for example
   this will return :fred if :fred is in the sequence, otherwise nil:
   (some #{:fred} coll)"
  [selector coll]
  (let [s (seq coll)]
    (when s
      (or (selector (first s)) (recur selector (next s))))))
