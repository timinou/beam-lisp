(defn keys
  "Returns a sequence of the map's keys, in the same order as (seq map)."
  [m]
  ; TODO: Use a proper key seq instead.
  (seq
   (persistent!
    (reduce (fn [acc kv]
              (conj! acc (first kv)))
            (transient [])
            m))))
