(defn keyword
  "Returns a Keyword with the given namespace and name.  Do not use :
   in the keyword strings, it will be added automatically."
  ([name]
   (cond
     (keyword? name) name
     (symbol? name) (cpp/jank.runtime.keyword nil (str name))
     (string? name) (cpp/jank.runtime.keyword nil name)))
  ([ns name]
   (cpp/jank.runtime.keyword ns name)))
