(defn nthrest
  "Returns the nth rest of coll, coll when n is 0."
  [coll n]
  ;; TODO add support for IDrop
  (if (pos? n)
    (if-let [xs (seq coll)]
      (recur (rest xs) (dec n))
      (or (seq coll) ()))
    coll))
