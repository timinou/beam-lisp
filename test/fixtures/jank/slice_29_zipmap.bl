(defn zipmap
  "Returns a map with the keys mapped to the corresponding vals."
  [keys vals]
  (loop* [map (transient (hash-map))
          ks (seq keys)
          vs (seq vals)]
         (if (and ks vs)
           (recur (assoc! map (first ks) (first vs))
                  (next ks)
                  (next vs))
           (persistent! map))))
