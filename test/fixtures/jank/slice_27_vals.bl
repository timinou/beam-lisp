(defn vals
  "Returns a sequence of the map's values, in the same order as (seq map)."
  [m]
  ; TODO: Use a proper val seq instead.
  (seq
   (persistent!
    (reduce (fn [acc kv]
              (conj! acc (second kv)))
            (transient [])
            m))))
