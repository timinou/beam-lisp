(defmacro assert
  "Evaluates expr and throws an exception if it does not evaluate to
   logical true."
  ([x]
   (when *assert*
     (list `when-not x
           (list 'throw (list `ex-info
                              "assertion failed"
                              {:assertion (pr-str x)})))))
  ([x message]
   (when *assert*
     (list `when-not x
           (list 'throw (list `ex-info
                              "assertion failed"
                              {:assertion (pr-str x)
                               :message message}))))))
