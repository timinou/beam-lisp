{:st/imports ["stdlib/__mcp__"]
 :st/forms [(import :path "stdlib/__mcp__")
            (data-inline :name $mcpPrompt :value [:st/expr "\"\""])
            (mcp-input-refresh :refresh 0)
            (mcp-host)
            (mcp-action :action "kit-confirm" :target "" :value "confirm" :targetAttr "" :valueAttr "" :on "click")
            (mcp-action :action "kit-cancel" :target "" :value "cancel" :targetAttr "" :valueAttr "" :on "click")]
 :st/scopes [{:selector "[data-st-instance]" :decls {}}
             {:selector ".kit-prompt" :decls {"text" "$mcpPrompt"}}
             {:selector ".kit-btn-confirm" :decls {}}
             {:selector ".kit-btn-cancel" :decls {}}
             {:selector ".kit" :decls {"--kit-bg" "#241e19" "--kit-cream" "#f0e6d6" "--kit-taupe" "#b8a98f" "--kit-umber" "#7a6b54" "--kit-ember" "#e0915a" "--kit-ember-hot" "#ed9f6a" "--kit-panel" "rgba(58, 48, 42, 0.34)" "--kit-serif" "\"Fraunces\", \"Source Serif 4\", Georgia, serif" "--kit-sans" "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif" "box-sizing" "border-box" "min-height" "100%" "display" "grid" "align-content" "center" "gap" "28px" "max-width" "520px" "margin" "0 auto" "padding" "56px 32px" "color" "var(--kit-cream)" "font-family" "var(--kit-sans)"}}
             {:selector ".kit *" :decls {"box-sizing" "border-box"}}
             {:selector ".kit-prompt" :decls {"margin" "0" "font-family" "var(--kit-serif)" "font-size" "28px" "font-weight" "600" "line-height" "1.3" "color" "var(--kit-cream)"}}
             {:selector ".kit-actions" :decls {"display" "flex" "gap" "12px" "justify-content" "flex-end"}}
             {:selector ".kit-btn" :decls {"padding" "13px 26px" "border" "0" "border-radius" "14px" "font-family" "var(--kit-sans)" "font-size" "15px" "font-weight" "600" "cursor" "pointer" "transition" "background 200ms ease, transform 200ms ease, color 200ms ease"}}
             {:selector ".kit-btn:hover" :decls {"transform" "translateY(-1px)"}}
             {:selector ".kit-btn-cancel" :decls {"background" "var(--kit-panel)" "color" "var(--kit-taupe)"}}
             {:selector ".kit-btn-cancel:hover" :decls {"color" "var(--kit-cream)"}}
             {:selector ".kit-btn-confirm" :decls {"background" "var(--kit-ember)" "color" "#221a13"}}
             {:selector ".kit-btn-confirm:hover" :decls {"background" "var(--kit-ember-hot)"}}]}
