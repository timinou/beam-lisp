(ns initializer.connection (:require [datom :as d]))

;; This is intentionally an initializer: cold worker dependencies must load
;; while Loader.Server is already initializing this namespace.
(def connection (d/connect [{:db/ident :initializer/value :db/valueType :db.type/string}]))
(def transaction (d/transact! connection [{:db/id 73 :initializer/value "ready"}]))
(def rows (d/q '[:find ?e :where [?e :initializer/value "ready"]] (d/db connection)))
(d/close! connection)

