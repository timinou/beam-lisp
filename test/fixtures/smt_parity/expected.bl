; test/fixtures/smt_parity/expected.bl — the STRING translator's outputs.
;
; Snapshotted from priv/lib/system/smt.bl while it still emitted SMT-LIB
; strings, one entry per corpus source. test/bl/smt_parity_test.bl rebuilds
; every entry as QUOTED FORMS after the data cutover and has z3 prove
; `old-string-term = new-form-term` — the solver certifies the cutover
; faithful, byte-formatting differences and all.
(ns smt-parity.expected)

(def expected
  {
   "cmp"
     "(> a 0)"

   "impl"
     "(=> (> a 0) (> a -1))"

   "ite"
     "(ite (> a 0) (+ a 1) (- a 1))"

   "max-idiom"
     "(= (ite (>= 0 a) 0 a) (ite (>= 0 a) 0 a))"

   "min-max"
     "(>= (ite (<= a b) a b) (ite (>= 0 (- (+ a b) 10)) 0 (- (+ a b) 10)))"

   "pred-desugar"
     "(and (> a 0) (not (= a 0)))"

   "dec-inc"
     "(= (- (+ n 1) 1) n)"

   "arith-mix"
     "(>= (* a b) (+ (mod a 7) (* 2 b)))"

   "real-literals"
     "(and (> r 1.5) (< r 2.0))"

   "real-neg"
     "(>= r -1.5)"

   "strings"
     "(str.contains (str.++ s t) \"hi\")"

   "str-len"
     "(>= (str.len s) 3)"

   "guarded-clauses"
     "(define-fun sign ((a Int)) Int (ite (> a 0) 1 (ite (< a 0) (- 0 1) 0)))"

   "define-fun"
     "(define-fun floor-half ((n Int)) Int (ite (>= n 0) (div n 2) (- 0 (div (- 0 n) 2))))"

  })
