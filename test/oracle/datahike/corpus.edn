;; The datahike↔datom differential corpus — ONE source of truth, two engines.
;;
;; Each scenario is DATA in datahike's spelling: a schema, a sequence of
;; transactions, and a sequence of named reads (queries / pulls / entity /
;; datoms). `run_jvm.clj` evaluates every scenario against published datahike
;; (0.8.1861) and freezes the typed answers into `expected.edn`. The beam-lisp
;; side (`datahike_differential_test.exs` in W0; the real `datahike.api` shim
;; from W1 on) replays the IDENTICAL corpus through datom and asserts equality.
;;
;; The whole point of PLAN-115: datom is the single engine; this corpus is how
;; we PROVE the datahike surface projects onto it, feature by feature, with the
;; JVM as oracle. A scenario carries `:wave` so a wave can run just its slice,
;; and `:status` (`:ready` = expected to pass now, `:pending` = needs a wave's
;; feature). `expected.edn` holds an answer for BOTH so a wave flipping
;; `:pending`→`:ready` needs no re-capture.
;;
;; Answer encoding (engine-neutral, in `expected.edn`):
;;   query result sets  → a SORTED vector of tuples (each tuple a vector)
;;   scalar (`.` find)   → the value
;;   collection (`...`)  → a sorted vector
;;   pull                → the map (ref values normalised to {:db/id N})
;;   entity              → the map, :db/id dropped (ids are not stable across engines)
;;   an expected error   → {:error true}
;; Entity ids are NEVER compared directly (they differ across engines); a read
;; that wants identity resolves through a :db/unique attr.

{:version 1

 :scenarios
 [{:name :rel-basic
   :wave :w0
   :status :ready
   :doc "A relation find over two attributes — the baseline both engines share."
   :schema [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
            {:db/ident :age  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :name "a" :age 10}
           {:db/id -2 :name "b" :age 20}
           {:db/id -3 :name "c" :age 30}]]
   :reads [{:id :names-and-ages
            :kind :q
            :query [:find ?n ?a :where [?e :name ?n] [?e :age ?a]]}
           {:id :over-15
            :kind :q
            :query [:find ?n :where [?e :name ?n] [?e :age ?a] [(> ?a 15)]]}]}

  {:name :pull-basic
   :wave :w1
   :status :ready
   :doc "W0 finding: datom pull adds :db/id unasked (JVM omits it) AND comparison needs lookup-ref-stable eids. W1 shim normalises pull output + resolves the lookup-ref."
   :schema [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
            {:db/ident :age  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :name "a" :age 10}]]
   :reads [{:id :pull-a
            :kind :pull
            :pattern [:name :age]
            :eid [:name "a"]}]}

  {:name :entity-flat
   :wave :w1
   :status :ready
   :doc "W0 finding CONFIRMED LIVE: datom entity with a lookup-ref eid returns {} (raw :eavt scan of a vector). W1 resolves lookup-refs in entity position. (Same gap as :entity-lookup-ref; kept as the kontor-shaped flat read.)"
   :schema [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
            {:db/ident :age  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :name "a" :age 10}]]
   :reads [{:id :entity-a
            :kind :entity
            :eid [:name "a"]}]}

  ;; ── pending scenarios: each pins a wave's feature; expected.edn holds the
  ;;    JVM answer already, so flipping :status to :ready when the feature lands
  ;;    needs no re-capture. ──────────────────────────────────────────────────

  {:name :find-scalar
   :wave :w3
   :status :ready
   :doc "B4: scalar find-spec [?a .] — datom rejects today ('invalid query')."
   :schema [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
            {:db/ident :age  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :name "a" :age 10}]]
   :reads [{:id :age-of-a
            :kind :q
            :query [:find ?a . :where [?e :name "a"] [?e :age ?a]]}]}

  {:name :find-collection
   :wave :w3
   :status :ready
   :doc "B4: collection find-spec [?n ...]."
   :schema [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}]
   :txes [[{:db/id -1 :name "a"} {:db/id -2 :name "b"} {:db/id -3 :name "c"}]]
   :reads [{:id :all-names
            :kind :q
            :query [:find [?n ...] :where [?e :name ?n]]}]}

  {:name :with-aggregate
   :wave :w3
   :status :ready
   :doc "B4: :with keeps duplicate rows for aggregation (ADR-162; datom parses then drops :with today)."
   :schema [{:db/ident :name :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
            {:db/ident :amt  :db/valueType :db.type/long   :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :name "a" :amt 5}
           {:db/id -2 :name "a" :amt 5}
           {:db/id -3 :name "b" :amt 5}]]
   :reads [{:id :sum-with-dupes
            :kind :q
            :query [:find (sum ?amt) . :with ?e :where [?e :amt ?amt]]}]}

  {:name :entity-lookup-ref
   :wave :w1
   :status :ready
   :doc "W0 finding: kontor passes lookup-ref vectors to entity; datom entity raw-scans an eid today."
   :schema [{:db/ident :sym :db/valueType :db.type/string :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
            {:db/ident :active :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :sym "USD" :active true}]]
   :reads [{:id :entity-by-lookup-ref
            :kind :entity
            :eid [:sym "USD"]}]}

  {:name :decimal-roundtrip
   :wave :w2
   :status :ready
   :doc "B1: a :db.type/bigdec value round-trips and orders in AVET (cent-exact)."
   :schema [{:db/ident :acct :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
            {:db/ident :bal  :db/valueType :db.type/bigdec   :db/cardinality :db.cardinality/one}]
   :txes [[{:db/id -1 :acct "cash" :bal 100.05M}
           {:db/id -2 :acct "bank" :bal 100.50M}]]
   :reads [{:id :balances
            :kind :q
            :query [:find ?a ?b :where [?e :acct ?a] [?e :bal ?b]]}]}]}
