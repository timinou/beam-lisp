; Plain cold-VM regression: genuine SDK production plus unrelated code writes.
; Run: bin/bl --cold run test/scripts/sdk-declaration-publication.bl
; No fabricated receipts, compiler attributes, SDK leases or source overlays.
(ns sdk-declaration-publication)

(let [root (str (System/get_env "HOME") "/tmp/sdk-declaration-publication-"
                (erlang/unique_integer (list :positive)) "-" (erlang/system_time :nanosecond))
      source "(ns sdk.publication.consumer (:require [loom.token :as t])) (defn value [] {:fill (t/color :accent)})"
      compile! (fn [text] (BeamLisp.AOT/compile_source text (list (tuple :output_dir root))))]
 (File/mkdir_p! root)
 (try
  (let [path (BeamLisp.Loader/source_path "loom.token")]
   (BeamLisp.AOT/compile_sdk_source! "loom.token" (BeamLisp.Loader/read_source path) path))
  (assert (= true (BeamLisp.AOT/sdk_unit_compiled? "loom.token")))
  (assert (= :public (BeamLisp.AOT/sdk_declaration_kind "loom.token" "color")))
  (compile! source)
  (let [parent (erlang/self)
        pair (erlang/spawn_monitor
               (fn []
                (erlang/send parent :publisher-ready)
                (receive :publish
                 (loop [n 0]
                  (when (< n 20)
                   (compile! (str "(ns sdk.publication.publisher) (defn value [] " n ")"))
                   (recur (inc n))))
                 (after 5000 (erlang/error :publisher-start-timeout)))
                (erlang/send parent :publisher-done)))
        pid (elem pair 0) monitor (elem pair 1)]
   (try
    (receive :publisher-ready nil (after 5000 (erlang/error :publisher-not-ready)))
    (erlang/send pid :publish)
    (let [answers (BeamLisp.Loader/with_declaration_snapshot
                   (fn [] (mapv (fn [_] (BeamLisp.AOT/sdk_declaration_kind "loom.token" "color")) (range 1000))))]
     (println {:phase :concurrent-queries :answers (frequencies answers)})
     (assert (every? #(= :public %) answers)))
    (receive :publisher-done nil (after 10000 (erlang/error :publisher-not-finished)))
    (assert (= true (BeamLisp.AOT/sdk_unit_compiled? "loom.token")))
    (assert (= :public (BeamLisp.AOT/sdk_declaration_kind "loom.token" "color")))
    (compile! source)
    (println {:status :passed :queries 1000 :unrelated-publications 20})
    (finally
     (erlang/exit pid :shutdown)
     (receive (tuple :DOWN monitor :process pid _) nil (after 5000 nil)))))
  (finally (File/rm_rf! root))))
