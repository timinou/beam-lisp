; Release acceptance: run the sealed drop from a neutral cwd with empty XDG
; caches. No source overlays, output manifests or self-build scratch may exist.
; A precompiled index accelerates loading; it cannot replace ownership evidence.
(ns packaged-sdk-retention)

(let [root (BeamLisp.Tiers/priv_root)
      inventory (Path/join root "sdk-code.term")]
 (when-not (File/regular? inventory)
  (throw (ex-info "Packaged SDK must carry its compiler-produced ownership inventory"
                 {:kind :packaged-sdk-ownership-inventory-missing})))
 (assert (BeamLisp.AOT/sdk_unit_compiled? "multi"))
 (BeamLisp.Loader/ensure_loaded "datom")
 (BeamLisp.Loader/ensure_loaded "proc.owner-registry")
 (let [module (BeamLisp.Env/fetch! "proc.owner-registry" "registry")
       proof (BeamLisp.Env/prepare_sdk_class! module)]
  (assert (= module (:module proof)))
  (assert (= true (:image? proof)))
  (assert (= (tuple "proc.owner-registry" "registry") (:declaration-owner (:artifact proof))))
  (println "PACKAGED_SDK_RETENTION_READY")))
