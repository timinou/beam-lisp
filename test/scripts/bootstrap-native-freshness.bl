;; Run through a fresh native bootstrap driver after AOT.boot, before starting
;; beam_lisp's Application. A normal `bl run` already owns SDK/application custody.
;; Uses genuine floor metadata and a genuine SDK lease; no injected custody rows.
(ns bootstrap-native-freshness)

(BeamLisp.Env/initialize_native_commands!)
(BeamLisp.Env/native_start_table_evidence!)
(assert (= :fresh (BeamLisp.Env/assert_fresh_native_recovery!)))
(BeamLisp.AOT/assert_sdk_seed_snapshot! (BeamLisp.Bootstrap/manifest))
(assert (> (ets/info :beam_lisp_source_lease_domains :size) 0))
(assert (= :fresh (BeamLisp.Env/assert_fresh_native_recovery!)))
(assert (= false (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)))

;; Cache warmth must not be confused with lifetime authority. Actual SDK
;; retention must still make fresh recovery impossible, without clearing it.
(BeamLisp.Env/retain_sdk_runtime!)
(assert (= true (ets/member :beam_lisp_vars :bl_sdk_runtime_lease)))
(let [refused (try (BeamLisp.Env/assert_fresh_native_recovery!) :unexpected-success
                  (catch error (BeamLisp.ExInfo/ex_original error)))]
 (assert (= :native_recovery_has_live_custody refused)))
(println {:status :passed :warm-metadata :allowed :live-sdk-custody :refused})
