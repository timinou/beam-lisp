; ./bin/bl --cold run test/scripts/stage_generations.bl
; Exercises the native stage's exact bytes and verify-before-write behavior.
(ns stage-generations)
(defn- check [condition message] (when-not condition (throw (ex-info message {}))))
(defn- hash [bytes] (Base/encode16 (crypto/hash :sha256 bytes) (list (tuple :case :lower))))
(defn- emit [dest module stamp]
 (let [attrs (if (nil? stamp) (list) (list (tuple :attribute 1 :bl_compiler_key stamp)))
       forms (concat (list (tuple :attribute 1 :module module)
                           (tuple :attribute 1 :export (list (tuple :value 0))))
                     attrs (list (tuple :function 1 :value 0
                        (list (tuple :clause 1 (list) (list) (list (tuple :integer 1 1)))))))
       compiled (compile/forms (to-list forms) (list :binary :return_errors))
       _ (check (and (= :ok (elem compiled 0)) (= module (elem compiled 1))) (pr-str compiled))
       bytes (elem compiled 2) name (str (Atom/to_string module) ".beam")]
  (File/write! (Path/join dest name) bytes) [name bytes]))
(defn- stage [repo seed dest]
 (System/cmd (Path/join repo "bin/bl-stage-hosts")
  (list (Path/join seed "manifest.term") seed dest)
  (list (tuple :stderr_to_stdout true) (tuple :env (list (tuple "ERL_FLAGS" "+S 2:2 +SDcpu 1 +SDio 1"))))))
(defn- manifest! [seed data]
 (File/write! (Path/join seed "manifest.term") (io_lib/format (String/to_charlist "~tp.~n") (list data))))
(let [repo (Path/expand ".")
      root (Path/join (System/tmp_dir!) (str "bl-stage-generations-" (erlang/unique_integer (list :positive))))
      seed (Path/join root "seed") dest (Path/join root "build")
      current (String/duplicate "a" 64) build (String/duplicate "b" 64)
      old (String/duplicate "c" 64) sdk (String/duplicate "d" 64)]
 (File/mkdir_p! seed) (File/mkdir_p! dest)
 (try
  (let [delay "Elixir.BeamLisp.Delay.beam"
        bytes (File/read! (Path/join repo (str "priv/bootstrap/seed/" delay)))
        _ (File/write! (Path/join seed delay) bytes)
        [good good-bytes] (emit dest :Elixir.BeamLisp.Ns.GenerationGood current)
        [built _] (emit dest :Elixir.BeamLisp.Ns.GenerationBuild (list build))
        [stale stale-bytes] (emit dest :Elixir.BeamLisp.Ns.GenerationOld (list old))
        [unknown unknown-bytes] (emit dest :Elixir.BeamLisp.Ns.GenerationUnknown nil)
        [owned owned-bytes] (emit dest :Elixir.BeamLisp.Ns.GenerationOwned old)
        bad "Elixir.BeamLisp.Ns.GenerationMalformed.beam"
        _ (File/write! (Path/join dest bad) "unjudged bytes")
        manifest {"compiler_key" current "build_key" build "hosts" (list delay)
                  "modules" {delay (hash bytes) owned (hash owned-bytes)}}]
   (manifest! seed manifest)
   (let [[output code] (stage repo seed dest)]
    (check (= code 0) output)
    (check (String/contains? output "archived 1 obsolete namespace beams") output))
   (check (not (File/exists? (Path/join dest stale))) "obsolete object remains on code path")
   (let [archived (Path/wildcard (Path/join dest (str ".stale-generations/*/" old "/" stale)))]
    (check (= 1 (count archived)) "one exact-byte archive")
    (check (= stale-bytes (File/read! (first archived))) "archive did not preserve original bytes"))
   (doseq [[name want] [[good good-bytes] [unknown unknown-bytes] [owned owned-bytes] [bad "unjudged bytes"]]]
    (check (= want (File/read! (Path/join dest name))) (str "current/owned/unjudged object changed: " name)))
   (check (File/exists? (Path/join dest built)) "current build-tier object was archived")
   (check (= (tuple "" 0) (stage repo seed dest)) "unchanged staging must be quiet")
   (let [sdk-key (hash (IO/iodata_to_binary (list "sdk-declarations-v1" 0 current 0 sdk)))
         [sdk-name _] (emit dest :Elixir.BeamLisp.Ns.GenerationSdk sdk-key)]
    (manifest! seed (assoc manifest "compiler_inputs"
                     {"schema" 1 "base_key" current "shared" (String/duplicate "e" 64) "sdk_declarations" sdk}))
    (check (= (tuple "" 0) (stage repo seed dest)) "current selective SDK generation was archived")
    (check (File/exists? (Path/join dest sdk-name)) "selective SDK object was removed"))
   (File/write! (Path/join dest stale) stale-bytes)
   (File/write! (Path/join seed delay) "corrupt seed")
   (check (not= 0 (elem (stage repo seed dest) 1)) "corrupt floor was accepted")
   (check (= stale-bytes (File/read! (Path/join dest stale))) "corrupt floor caused namespace changes")
   (println "PASS: stale-generation quarantine, exact-byte backup, current/shared/build/SDK retention, unjudged preservation, quiet reuse, verify-before-write"))
  (finally (File/rm_rf! root))))
