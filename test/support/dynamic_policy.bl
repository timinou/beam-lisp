; HOME native fixture draft. Requires ordinary coherent SDK ownership first.
; Opt-in policy/Root custody is deliberately retained; run in an isolated last VM.
(ns test.support.dynamic-policy
 (:require [datom :as d] [datom.conn :as conn] [datom.store-fjall :as fjall]
           [datom.migration-policy :as policy] [datom.migration-admission :as migration]
           [proc.queue-family-root :as root] [reload.generation :as g] [reload :as reload] [reload.runtime :as runtime] [datom.schema]))
(def BEFORE [{:db/ident :tenant/key :db/valueType :db.type/string :db/unique :db.unique/identity}])
(def GROW [{:db/ident :tenant/label :db/valueType :db.type/string}])
(defn schema-map [defs] (datom.schema/install-all (datom.schema/empty-schema) defs))
(defn policy-plan []
 {:version 1 :families [{:family "tenant-data" :schema (schema-map BEFORE) :phase :expand
                        :migration {:migration/id :tenant-label-v1 :migration/digest (apply str (repeat 64 "a"))
                                    :migration/grows GROW}}]})
(defn kind [action] (try (action) nil (catch error (:kind (ex-data error)))))
(defn directory []
 (let [path (str (System/get_env "HOME") "/tmp/dynamic-policy-native-" (erlang/unique_integer (list :positive)))]
  (File/mkdir_p! path) path))
(defn prepared [path app plan]
 (g/prepare! {:application-id app :sources {"phase.fixture"
  (str "(ns phase.fixture (:require [datom.migration-admission :as migration] [datom.store-fjall :as fjall])) "
       "(defn open! [path defs] (migration/open! path defs)) "
       "(defn raw! [path] (fjall/open path)) (defn identity [x] x)")}
  :stable-namespaces #{"datom.migration-admission" "datom.store-fjall"}
  :resources {:data-root path :managed-root-journal "journal.fjall" :managed-root-journal-id "journal"
              :managed-root-store-paths {"journal" "journal.fjall"}
              :deployment-environment "sandbox" :dynamic-store-policy plan}}))
(defn ready! [graph journal]
 (root/enroll! graph journal {"journal" journal}) (root/enter-initializer! graph)
 (g/with! graph #(g/bind-runtime! {})) (root/ready! graph))
(defn install! [graph] (g/with! graph migration/install!))
(defn status [graph] (g/with! graph migration/status))

