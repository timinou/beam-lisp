(ns test.support.source-fixtures)
(defn- fixture! [module filename function arity]
  (when-not (erlang/function_exported module function arity)
   (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (File/cwd!))
         before (BeamLisp.Env/capture)]
    (try
     (BeamLisp.AOT/compile_host_file (Path/join root filename)
      (list (tuple :module module) (tuple :load? true)
            (tuple :output_dir (Path/join (System/tmp_dir!) "bl-source-fixture-beams"))))
     (finally (BeamLisp.Env/bind before)))))
  module)
(defn effects!
 "Load one native observer for compiler effect-order tests. Preparation grants
  the exact external module; application Source gains no Process.put authority."
 []
 (fixture! :Elixir.SourceEffectObserverFixture "test/fixtures/source_effect_observer.bl" :put 2))
(defn start-gate-fault! []
 (fixture! :Elixir.SourceStartGateFaultFixture "test/fixtures/source_start_gate_fault.bl" :save 0))
(defn origin-fault! []
 (fixture! :Elixir.SourceOriginFaultFixture "test/fixtures/source_origin_fault.bl" :with_mode 2))
(defn sdk-fault! []
 (fixture! :Elixir.SourceSdkFaultFixture "test/fixtures/source_sdk_fault.bl" :prepare 0))
(defn cold!
 "Run a component before launcher SDK retention in a genuinely fresh VM,
  using the selected artifact's complete library tree. No lease is removed."
 [filename]
 (let [root (or (System/get_env "BL_TEST_SOURCE_ROOT") (File/cwd!))
       app (Path/dirname (Path/dirname (erlang/list_to_binary (code/which :Elixir.BeamLisp))))
       paths (Path/wildcard (Path/join (Path/dirname app) "*/ebin"))
       args (to-list (concat (mapcat (fn [path] ["-pa" path]) paths)
                     ["-e" (str "Application.load(:beam_lisp)\n"
                           "for app <- Application.spec(:beam_lisp, :applications) || [], do: {:ok, _} = Application.ensure_all_started(app)\n"
                           "BeamLisp.AOT.boot()\nBeamLisp.run_file(hd(System.argv()))\n")
                      "--" (Path/join root filename)]))
       scratch (Path/join (System/tmp_dir!) (str "bl-cold-component-" (erlang/unique_integer (list :positive))))]
  (File/mkdir_p! scratch)
  (try
   (System/cmd "elixir" args (list (tuple :stderr_to_stdout true) (tuple :cd scratch)
       (tuple :env (list (tuple "BL_ROOT" app) (tuple "BL_DAEMON" "off") (tuple "BEAM_LISP_PATH" nil)))))
   (finally (File/rm_rf! scratch)))))
