(ns test.support.workflow)
(defn status!
 "Require a workflow prerequisite before later effects or polling. An unmet
  prerequisite ends this test with the complete reply; enclosing finally
  blocks still clean up. Other tests in the file continue normally."
 [expected reply]
 (when-not (= expected (:status reply))
  (throw (ex-info "Integration prerequisite did not complete"
                  {:kind :workflow-prerequisite :expected expected :reply reply}))) reply)
