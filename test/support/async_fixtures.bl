(ns test.support.async-fixtures)

(defn start!
 "Start a fixture that calls ready with its accepted value. A preflight failure
  is returned immediately, so the parent never mistakes it for a slow barrier."
 [action]
 (let [parent (erlang/self) ticket (erlang/make_ref)
       pid (spawn (fn []
              (try (action (fn [value] (erlang/send parent [ticket :ready value])))
               (catch error (erlang/send parent [ticket :failed error])))))]
  {:pid pid :ticket ticket}))

(defn ready! [started timeout]
 (let [pid (:pid started) ticket (:ticket started) monitor (Process/monitor pid)]
  (try
   (receive
    [seen :ready value] :when (= ticket seen) value
    [seen :failed error] :when (= ticket seen) (throw error)
    [:DOWN seen :process observed reason] :when (and (= monitor seen) (= pid observed))
      (throw (ex-info "Fixture exited before its acceptance barrier" {:kind :fixture-startup-exit :reason reason}))
    (after timeout (throw (ex-info "Fixture acceptance barrier timed out"
                            {:kind :fixture-startup-timeout :worker pid
                             :stack (Process/info pid :current_stacktrace)}))))
   (finally (Process/demonitor monitor (list :flush))))))
